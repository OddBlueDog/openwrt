# MilkFlint's build configuration for the GL.iNet GL-MT6000 (Flint 2):
#   cp milkflint/diffconfig .config && make defconfig
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
# One build, several boards of the MT7986: the GL-MT6000 (Flint 2), and the
# Zyxel EX5601-T0 (also sold as EX5601-T1 and Telenor's T-56) in both of
# OpenWrt's flash layouts, Zyxel's bootloader ("stock") and OpenWrt's U-Boot
# ("ubootmod"), experimental: built, not tested on the hardware here. Each
# board's image has its own root filesystem with its own packages.
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_glinet_gl-mt6000=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_zyxel_ex5601-t0-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_zyxel_ex5601-t0-ubootmod=y

# The firmware is MilkFlint, with its own version number on top of the
# OpenWrt release ("MilkFlint 0.61a (OpenWrt 25.12.6)" in the banner and
# os-release). Images are named
# milkflint-<version>-<revision>-mediatek-filogic-<board>-* (glinet_gl-mt6000,
# zyxel_ex5601-t0-stock, zyxel_ex5601-t0-ubootmod).
# Packages still come from OpenWrt's repository for that release.
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="MilkFlint"
CONFIG_VERSION_NUMBER="0.61a"
CONFIG_VERSION_CODE_FILENAMES=y
CONFIG_VERSION_MANUFACTURER="MilkFlint"
CONFIG_VERSION_MANUFACTURER_URL="https://github.com/OddBlueDog/openwrt"
CONFIG_VERSION_HOME_URL="https://github.com/OddBlueDog/openwrt"
CONFIG_VERSION_BUG_URL="https://github.com/OddBlueDog/openwrt/issues"
CONFIG_VERSION_SUPPORT_URL="https://github.com/OddBlueDog/openwrt/issues"
CONFIG_VERSION_FIRMWARE_URL="https://github.com/OddBlueDog/openwrt/releases"
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="milkflint"
# Kernel modules come from MilkFlint's own feed, since OpenWrt's don't fit
# this kernel: every kmod is built, and each image lists its kernel's folder
# there
CONFIG_ALL_KMODS=y
CONFIG_VERSION_KMODS_REPO="https://milkflint-packages.pages.dev"
# except the MT7921/MT7925 and MT7996 (Wi-Fi 7) cards' drivers: our mt76
# fork's code for them needs a newer mac80211 than ours, and mt76 builds all
# its drivers together, so they'd fail the Flint 2's mt7915e with them
# CONFIG_PACKAGE_kmod-mt7996e is not set
# CONFIG_PACKAGE_kmod-mt7996-firmware is not set
# CONFIG_PACKAGE_kmod-mt7996-233-firmware is not set
# CONFIG_PACKAGE_kmod-mt7996-firmware-common is not set
# CONFIG_PACKAGE_kmod-mt7992-firmware is not set
# CONFIG_PACKAGE_kmod-mt7992-23-firmware is not set
# CONFIG_PACKAGE_kmod-mt7990-firmware is not set
# CONFIG_PACKAGE_kmod-mt792x-common is not set
# CONFIG_PACKAGE_kmod-mt792x-usb is not set
# CONFIG_PACKAGE_kmod-mt7921-common is not set
# CONFIG_PACKAGE_kmod-mt7921-firmware is not set
# CONFIG_PACKAGE_kmod-mt7921e is not set
# CONFIG_PACKAGE_kmod-mt7921s is not set
# CONFIG_PACKAGE_kmod-mt7921u is not set
# CONFIG_PACKAGE_kmod-mt7922-firmware is not set
# CONFIG_PACKAGE_kmod-mt7925-common is not set
# CONFIG_PACKAGE_kmod-mt7925-firmware is not set
# CONFIG_PACKAGE_kmod-mt7925e is not set
# CONFIG_PACKAGE_kmod-mt7925u is not set

CONFIG_PACKAGE_luci=y

# MilkFlint's web interface at the router's address; LuCI stays under
# "Advanced". Smart Queue needs SQM with CAKE.
CONFIG_PACKAGE_milkflint-ui=y
CONFIG_PACKAGE_milkflint-rtprio=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
# Pages that need extra packages: DNS (encrypted DNS through AdGuard's
# dnsproxy), UPnP, Data Statistics
CONFIG_PACKAGE_dnsproxy=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_nlbwmon=y
# The VPN pages (Remote access, VPN client)
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
# Access point mode's faster bridging (Operating Mode page): the bridge
# fast path (source/patches/0037) and bridge conntrack
CONFIG_PACKAGE_kmod-nft-bridge-offload=y
# USB mobile broadband modems in QMI mode (Quectel and most other 4G/5G
# modules): the QMI network driver, the modem's serial ports for AT commands,
# netifd's qmi protocol (uqmi) and LuCI's page for it. Kernel modules can't come
# from OpenWrt's package repository: it only has them for OpenWrt's own kernel.
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y

# On an arm64 build host, OpenWrt's Go (for dnsproxy) can't build its own
# bootstrap: point it at the host's Go instead, e.g.
# CONFIG_GOLANG_EXTERNAL_BOOTSTRAP_ROOT="/usr/lib/go"
