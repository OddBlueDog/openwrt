From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Thu, 22 Oct 2026 01:09:44 +0100
Subject: [PATCH] wifi: mt76: mt7915: per-station debugfs with OpenWrt's
 mac80211

The per-station debugfs files (fixed_rate, hw-queues, ps) were only
built with CONFIG_MAC80211_DEBUGFS, which backports (OpenWrt's mac80211)
calls CPTCFG_MAC80211_DEBUGFS, so OpenWrt builds never had them. Take
either.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mt7915/debugfs.c | 2 +-
 mt7915/main.c    | 2 +-
 mt7915/mt7915.h  | 8 +++++++-
 3 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
index 4592cf47..4a4b7867 100644
--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -1413,7 +1413,7 @@ bool mt7915_debugfs_rx_log(struct mt7915_dev *dev, const void *data, int len)
 	return true;
 }
 
-#ifdef CONFIG_MAC80211_DEBUGFS
+#ifdef MT7915_STA_DEBUGFS
 /** per-station debugfs **/
 
 static ssize_t mt7915_sta_fixed_rate_set(struct file *file,
diff --git a/mt7915/main.c b/mt7915/main.c
index 99ede774..0552bc0b 100644
--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -1980,7 +1980,7 @@ const struct ieee80211_ops mt7915_ops = {
 	.set_frag_threshold = mt7915_set_frag_threshold,
 	CFG80211_TESTMODE_CMD(mt76_testmode_cmd)
 	CFG80211_TESTMODE_DUMP(mt76_testmode_dump)
-#ifdef CONFIG_MAC80211_DEBUGFS
+#ifdef MT7915_STA_DEBUGFS
 	.sta_add_debugfs = mt7915_sta_add_debugfs,
 #endif
 	.set_radar_background = mt7915_set_radar_background,
diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
index ec02c3d5..f8785643 100644
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -696,7 +696,13 @@ int mt7915_mcu_wed_enable_rx_stats(struct mt7915_dev *dev);
 int mt7915_init_debugfs(struct mt7915_phy *phy);
 void mt7915_debugfs_rx_fw_monitor(struct mt7915_dev *dev, const void *data, int len);
 bool mt7915_debugfs_rx_log(struct mt7915_dev *dev, const void *data, int len);
-#ifdef CONFIG_MAC80211_DEBUGFS
+/* mac80211's per-station debugfs; backports (OpenWrt's mac80211) calls the
+ * option CPTCFG_MAC80211_DEBUGFS
+ */
+#if defined(CONFIG_MAC80211_DEBUGFS) || defined(CPTCFG_MAC80211_DEBUGFS)
+#define MT7915_STA_DEBUGFS
+#endif
+#ifdef MT7915_STA_DEBUGFS
 void mt7915_sta_add_debugfs(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 			    struct ieee80211_sta *sta, struct dentry *dir);
 #endif
