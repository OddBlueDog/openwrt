+/* --- a station that stops answering (mt76_tx_silent_*() in tx.c) --- */
+
+/* 5 ms with none of the simulation's own traffic or dozing: the firmware's
+ * events, the air, the probes' work, the tx worker
+ */
+static void psim_silent_tick(struct psim *s)
+{
+	s->step++;
+	mt76_tx_silent_test_now = PSIM_SILENT_T0 +
+				  msecs_to_jiffies(s->step * PSIM_STEP_MS);
+	psim_deliver_events(s);
+	psim_transmit(s);
+	mt76_tx_silent_poll(s->dev);
+	while (psim_worker(s))
+		;
+}
+
+static void psim_silent_ticks(struct psim *s, unsigned int n)
+{
+	while (n--)
+		psim_silent_tick(s);
+}
+
+/* frames of a station waiting in mac80211's queues */
+static unsigned long psim_queued(struct psim_sta *ps)
+{
+	unsigned long n = 0;
+	int tid;
+
+	for (tid = 0; tid < IEEE80211_NUM_TIDS; tid++)
+		n += psim_txq_depth(ps, tid);
+	return n;
+}
+
+/* a frame for the station, handed to the hardware if the driver lets it */
+static void psim_silent_send(struct psim *s, struct psim_sta *ps, int n)
+{
+	while (n--)
+		psim_enqueue(s, ps, 0);
+	while (psim_worker(s))
+		;
+}
+
+/* The hold of a station that stops answering, step by step: when it starts
+ * and when it doesn't, what waits, the probes, and each way out.
+ */
+static void mt76_psim_test_silent(struct kunit *test)
+{
+	static const struct psim_cfg cfg = {
+		.seed = 21, .ps_sync = true, .silent = true,
+		.kinds = { PSIM_PHONE, PSIM_LAPTOP }, .n_sta = 2,
+	};
+	struct psim_sta *phone, *laptop;
+	struct mt76_wcid *wcid, *lw;
+	unsigned long done, probes;
+	struct mt76_dev *dev;
+	struct psim *s;
+	int i, ac;
+
+	skb_queue_head_init(&psim_skbs);
+	s = psim_init(test, &cfg);
+	dev = s->dev;
+	phone = &s->sta[0];
+	laptop = &s->sta[1];
+	wcid = psim_wcid(phone);
+	lw = psim_wcid(laptop);
+
+	/* answering: frames go, nothing is held, however long it was quiet */
+	psim_silent_ticks(s, 40);
+	psim_silent_send(s, phone, 8);
+	psim_silent_ticks(s, 4);
+	KUNIT_EXPECT_EQ(test, phone->acked + phone->failed, 8);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+
+	/* A frame that fails just after another was acked (heard within
+	 * MT76_SILENT_IDLE_MS): chance, not silence. Not held.
+	 */
+	psim_silent_send(s, phone, 1);
+	KUNIT_ASSERT_TRUE(test, psim_fw_pending(phone));
+	psim_air_lost(s, phone, 1);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	KUNIT_EXPECT_EQ(test, wcid->silent_holds, 0);
+	psim_silent_ticks(s, 2);
+
+	/* It dozes, and its notice never arrives. Quiet for a while, then a
+	 * frame for it: handed over as for any awake station, and lost.
+	 */
+	psim_mute(s, phone);
+	psim_silent_ticks(s, 40);
+	psim_silent_send(s, phone, 1);
+	KUNIT_ASSERT_TRUE(test, psim_fw_pending(phone));
+	done = phone->failed;
+	psim_silent_tick(s);
+	KUNIT_EXPECT_EQ(test, phone->failed, done + 1);
+	/* that was the sign: held from here on */
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	KUNIT_EXPECT_TRUE(test, test_bit(wcid->idx, dev->silent_wait));
+	KUNIT_EXPECT_EQ(test, wcid->silent_holds, 1);
+
+	/* what comes for it now waits in its queues: none of it reaches the
+	 * hardware, for two seconds of silence
+	 */
+	done = phone->acked + phone->failed - phone->silent_probes;
+	psim_silent_send(s, phone, 20);
+	KUNIT_EXPECT_EQ(test, psim_queued(phone), 20);
+	for (i = 0; i < 400; i++) {
+		psim_silent_tick(s);
+		if (i == 200)
+			psim_silent_send(s, phone, 5);
+	}
+	KUNIT_EXPECT_EQ(test, psim_queued(phone), 25);
+	KUNIT_EXPECT_EQ(test, s->n_silent_fed, 0);
+	KUNIT_EXPECT_EQ(test, phone->mute_lost, 1);
+	/* probed meanwhile, at growing gaps: after 20, 60, 140, 300, 620 and
+	 * 1260 ms, none answered
+	 */
+	KUNIT_EXPECT_GE(test, phone->silent_probes, 5);
+	KUNIT_EXPECT_LE(test, phone->silent_probes, 7);
+	KUNIT_EXPECT_EQ(test, wcid->silent_probes, phone->silent_probes);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	/* the laptop beside it isn't touched */
+	psim_silent_send(s, laptop, 10);
+	psim_silent_ticks(s, 3);
+	KUNIT_EXPECT_EQ(test, laptop->acked + laptop->failed, 10);
+	KUNIT_EXPECT_EQ(test, lw->silent_holds, 0);
+
+	/* it has something to send: heard, released, and all 25 go out, in
+	 * the order they came
+	 */
+	probes = phone->silent_probes;
+	psim_unmute(s, phone);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	while (psim_worker(s))
+		;
+	psim_silent_ticks(s, 20);
+	KUNIT_EXPECT_EQ(test, psim_queued(phone), 0);
+	KUNIT_EXPECT_EQ(test, phone->backlog, 0);
+	KUNIT_EXPECT_EQ(test, s->n_order, 0);
+	KUNIT_EXPECT_EQ(test, phone->mute_lost, 1);
+	KUNIT_EXPECT_EQ(test, phone->silent_probes, probes);
+	KUNIT_EXPECT_GE(test, wcid->silent_ms, 1900);
+	KUNIT_EXPECT_LE(test, wcid->silent_ms, 2200);
+	kunit_info(test, "silent for 2 s with 26 frames for it: %lu lost, 25 delivered once it was heard, %lu probes\n",
+		   phone->mute_lost, phone->silent_probes);
+
+	/* Held again, and this time the firmware reports it dozing (its next
+	 * notice did arrive): the report ends the hold, and power save takes
+	 * over, a frame per AC at a time.
+	 */
+	psim_mute(s, phone);
+	psim_silent_ticks(s, 40);
+	psim_silent_send(s, phone, 1);
+	psim_silent_tick(s);
+	KUNIT_ASSERT_TRUE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	psim_silent_send(s, phone, 6);
+	phone->mute = false;
+	phone->fw_awake = false;
+	mt76_sta_ps_transition(dev, wcid, true);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_PS, &wcid->flags));
+	while (psim_worker(s))
+		;
+	KUNIT_EXPECT_EQ(test, psim_queued(phone), 5);
+	KUNIT_EXPECT_EQ(test, phone->fw_len[IEEE80211_AC_BE], 1);
+	psim_set_dozing(s, phone, false);
+	psim_silent_ticks(s, 20);
+	KUNIT_EXPECT_EQ(test, phone->backlog, 0);
+	KUNIT_EXPECT_EQ(test, wcid->silent_holds, 2);
+
+	/* A station that listens but had nothing to say, and one frame to
+	 * it failed (a moment's interference): held, probed 20 ms later, and
+	 * the probe's ACK releases it. What waited goes after 30 ms or so.
+	 */
+	psim_silent_ticks(s, 40);
+	psim_silent_send(s, laptop, 1);
+	psim_air_lost(s, laptop, 1);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_SILENT, &lw->flags));
+	psim_silent_send(s, laptop, 12);
+	KUNIT_EXPECT_EQ(test, psim_queued(laptop), 12);
+	psim_silent_ticks(s, 8);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &lw->flags));
+	KUNIT_EXPECT_EQ(test, psim_queued(laptop), 0);
+	KUNIT_EXPECT_EQ(test, laptop->backlog, 0);
+	KUNIT_EXPECT_EQ(test, lw->silent_holds, 1);
+	KUNIT_EXPECT_EQ(test, laptop->silent_probes, 1);
+	KUNIT_EXPECT_LE(test, lw->silent_ms, 45);
+
+	/* just heard from (an ACK a moment ago), then three frames in a row
+	 * come back failed: that is silence too, and it is held at once
+	 */
+	psim_silent_send(s, laptop, 4);
+	psim_silent_ticks(s, 2);
+	KUNIT_ASSERT_EQ(test, laptop->backlog, 0);
+	psim_silent_send(s, laptop, 3);
+	psim_air_lost(s, laptop, 2);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &lw->flags));
+	psim_air_lost(s, laptop, 1);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_SILENT, &lw->flags));
+	psim_silent_ticks(s, 8);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &lw->flags));
+	KUNIT_EXPECT_EQ(test, lw->silent_holds, 2);
+
+	/* while the radio is away on another channel frames fail for that:
+	 * not a station's silence
+	 */
+	psim_silent_ticks(s, 40);
+	psim_silent_send(s, laptop, 1);
+	dev->phy.offchannel = true;
+	psim_air_lost(s, laptop, 1);
+	dev->phy.offchannel = false;
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &lw->flags));
+	psim_silent_ticks(s, 2);
+
+	/* nor is a dozing station's lost frame (the firmware's to buffer) */
+	psim_silent_ticks(s, 40);
+	psim_set_dozing(s, phone, true);
+	psim_silent_tick(s);
+	KUNIT_ASSERT_TRUE(test, test_bit(MT_WCID_FLAG_PS, &wcid->flags));
+	mt76_tx_result(dev, wcid, false);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	psim_set_dozing(s, phone, false);
+	psim_silent_ticks(s, 2);
+
+	/* switched off, as stock: nothing is held, and what is held then
+	 * goes at the work's next look
+	 */
+	psim_mute(s, phone);
+	psim_silent_ticks(s, 40);
+	psim_silent_send(s, phone, 1);
+	psim_silent_tick(s);
+	KUNIT_ASSERT_TRUE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	psim_silent_send(s, phone, 3);
+	KUNIT_EXPECT_EQ(test, psim_queued(phone), 3);
+	silent_hold = false;
+	psim_silent_tick(s);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	KUNIT_EXPECT_EQ(test, psim_queued(phone), 0);
+	psim_silent_ticks(s, 40);
+	psim_silent_send(s, phone, 1);
+	psim_silent_tick(s);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	silent_hold = true;
+	psim_unmute(s, phone);
+	psim_silent_ticks(s, 5);
+
+	/* It leaves while held (its frames go with it) and joins again: a
+	 * new station, not held, not probed.
+	 */
+	psim_mute(s, phone);
+	psim_silent_ticks(s, 40);
+	psim_silent_send(s, phone, 1);
+	psim_silent_tick(s);
+	KUNIT_ASSERT_TRUE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	psim_silent_send(s, phone, 4);
+	psim_sta_leave(s, 0);
+	wcid = psim_wcid(phone);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	probes = phone->silent_probes;
+	psim_silent_ticks(s, 300);
+	KUNIT_EXPECT_EQ(test, phone->silent_probes, probes);
+	KUNIT_EXPECT_TRUE(test, bitmap_empty(dev->silent_wait, MT76_N_WCIDS));
+	psim_silent_send(s, phone, 6);
+	psim_silent_ticks(s, 5);
+	KUNIT_EXPECT_EQ(test, phone->backlog, 0);
+
+	/* nothing left anywhere */
+	psim_print_notes(s);
+	KUNIT_EXPECT_EQ(test, s->n_vanished, 0);
+	KUNIT_EXPECT_EQ(test, s->n_order, 0);
+	KUNIT_EXPECT_EQ(test, s->n_silent_fed, 0);
+	KUNIT_EXPECT_FALSE(test, psim_busy(s));
+	for (i = 0; i < cfg.n_sta; i++) {
+		struct psim_sta *ps = &s->sta[i];
+
+		KUNIT_EXPECT_EQ(test,
+				atomic_read(&psim_wcid(ps)->non_aql_packets), 0);
+		for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
+			KUNIT_EXPECT_EQ(test,
+				atomic_read(&ps->si->airtime[ac].aql_tx_pending), 0);
+	}
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&psim_skbs));
+	skb_queue_purge(&psim_skbs);
+}
+
+/* The same hours of the same clients, phones' doze notices going missing one
+ * time in five, without the hold and then with it: what those phones lose.
+ * (Two cases: a test has one device.)
+ */
+static struct psim_cfg psim_saves_cfg = {
+	.seed = 31, .steps = 20000, .ps_sync = true, .event_delay = 3,
+	.mute = 200, PSIM_ALL_KINDS,
+};
+
+static struct psim_totals psim_saves_off;
+
+static void mt76_psim_test_silent_off(struct kunit *test)
+{
+	psim_saves_cfg.silent = false;
+	psim_run_totals(test, &psim_saves_cfg, &psim_saves_off);
+	kunit_info(test, "without the hold: %lu unannounced dozes, %lu frames lost to them (%lu queued in all)\n",
+		   psim_saves_off.mutes, psim_saves_off.mute_lost,
+		   psim_saves_off.queued);
+	KUNIT_EXPECT_GT(test, psim_saves_off.mutes, 20);
+	KUNIT_EXPECT_GT(test, psim_saves_off.mute_lost,
+			psim_saves_off.mutes * 20);
+}
+
+static void mt76_psim_test_silent_on(struct kunit *test)
+{
+	struct psim_totals *off = &psim_saves_off, on;
+
+	if (!off->mutes)
+		kunit_skip(test, "needs mt76_psim_test_silent_off's run before it");
+
+	psim_saves_cfg.silent = true;
+	psim_run_totals(test, &psim_saves_cfg, &on);
+	kunit_info(test, "with the hold: %lu unannounced dozes, %lu frames lost (without it %lu for %lu), held %lu times, %lu probes\n",
+		   on.mutes, on.mute_lost, off->mute_lost, off->mutes,
+		   on.silent_holds, on.silent_probes);
+	KUNIT_ASSERT_GT(test, on.mutes, 20);
+	/* per silence: what was in the hardware when the first frame came
+	 * back, not what came for the phone until it spoke again
+	 */
+	KUNIT_EXPECT_LT(test, on.mute_lost * off->mutes * 3,
+			off->mute_lost * on.mutes);
+}
+
 static struct kunit_case mt76_psim_test_cases[] = {
 	KUNIT_CASE_PARAM(mt76_psim_test_run, psim_gen_params),
 	KUNIT_CASE_PARAM(mt76_psim_test_run, psim_seed_params),
 	KUNIT_CASE(mt76_psim_test_pace),
+	KUNIT_CASE(mt76_psim_test_silent),
+	KUNIT_CASE(mt76_psim_test_silent_off),
+	KUNIT_CASE(mt76_psim_test_silent_on),
 	{}
 };
 
