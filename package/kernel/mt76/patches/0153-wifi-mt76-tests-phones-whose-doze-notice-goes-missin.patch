+			  s->step, psim_kind_name[ps->kind], f->tid, f->seq);
+
 	ac = psim_tid_to_ac[f->tid];
 	if (s->cfg->queue_fail && !f->poll &&
 	    psim_chance(s, s->cfg->queue_fail)) {
@@ -566,6 +623,8 @@ static void psim_free(void *data)
