 	case PSIM_LAPTOP:
 		break;
 	case PSIM_PHONE:
-		if (!ps->dozing) {
+		if (ps->mute) {
+			/* no TIM bit to wake for: only what it sends itself */
+			if (psim_chance(s, 3))
+				psim_unmute(s, ps);
+		} else if (!ps->dozing) {
 			/* asleep after a few idle steps */
 			if (ps->progress)
 				ps->idle = 0;
-			else if (++ps->idle > psim_range(s, 3, 15))
-				psim_set_dozing(s, ps, true);
+			else if (++ps->idle > psim_range(s, 3, 15)) {
+				if (s->cfg->mute && psim_chance(s, s->cfg->mute))
+					psim_mute(s, ps);
+				else
