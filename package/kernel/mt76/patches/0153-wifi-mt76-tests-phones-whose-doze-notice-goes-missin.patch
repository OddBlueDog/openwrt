+		for (i = 0; i < s->cfg->n_sta; i++)
+			if (s->sta[i].present && psim_wcid(&s->sta[i]) == wcid)
+				break;
+		if (i == s->cfg->n_sta || s->n_frames >= PSIM_MAX_FRAMES) {
+			/* no record left for it: as a tx_queue_skb failure */
+			struct ieee80211_tx_status status = {
+				.sta = sta,
+				.skb = skb,
+				.info = IEEE80211_SKB_CB(skb),
+			};
+
+			spin_lock_bh(&s->dev->rx_lock);
+			ieee80211_tx_status_ext(phy->hw, &status);
+			spin_unlock_bh(&s->dev->rx_lock);
