+/* mt76_check_sta(): a frame from the station reached the driver */
+static void psim_heard(struct psim *s, struct psim_sta *ps)
+{
+	mt76_tx_heard(s->dev, psim_wcid(ps));
+}
+
+/* A phone dozes and its notice never arrives (its closing null frame after
+ * a keepalive its chip sent): the firmware goes on having it awake, and
+ * reports nothing.
+ */
+static void psim_mute(struct psim *s, struct psim_sta *ps)
+{
+	ps->dozing = true;
+	ps->fw_awake = true;
+	ps->mute = true;
+	ps->mutes++;
+}
+
+/* ... and it has something to send again: frames from it, and no report
+ * either, as the firmware had it awake all along
+ */
+static void psim_unmute(struct psim *s, struct psim_sta *ps)
+{
+	ps->dozing = false;
+	ps->fw_awake = false;
+	ps->mute = false;
+	ps->wakes++;
+	psim_heard(s, ps);
+}
+
 /* What a station does this step, by kind. */
 static void psim_behave(struct psim *s, struct psim_sta *ps, bool beacon)
 {
 	bool tim = psim_fw_pending(ps);
 
 	if (s->quiesce) {
+		if (ps->mute)
