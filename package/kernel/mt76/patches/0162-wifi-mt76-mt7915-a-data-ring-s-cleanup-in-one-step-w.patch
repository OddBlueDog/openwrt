 	writel(100, &rx->regs->dma_idx);
 	mt7915_dma_test_log.n_rst = 0;
 
diff --git a/tests/dma-test.c b/tests/dma-test.c
index d5038ce9..fbefb96c 100644
--- a/tests/dma-test.c
+++ b/tests/dma-test.c
@@ -1371,6 +1371,213 @@ static void mt76_dma_test_tx_cleanup_no_free(struct kunit *test)
 	local_bh_enable();
 }
 
+/* --- token-tracked tx queues (MT_QFLAG_TX_NO_ENTRY) ----------------------- */
+
+/* A tx queue of @ndesc descriptors whose frames are the driver's tokens' */
+static struct mt76_queue *
+mt76_dma_test_token_queue(struct mt76_dma_test *t, int ndesc)
+{
+	struct mt76_queue *q = mt76_dma_test_tx_queue(t, 0, ndesc);
+
+	q->flags |= MT_QFLAG_TX_NO_ENTRY;
+	return q;
+}
+
+/* @n frames as the mt7915 queues them: one descriptor each, the txwi in
+ * buf0 and the header the firmware parses in buf1, both left mapped
+ */
+static void mt76_dma_test_token_frames(struct mt76_dma_test *t,
+				       struct mt76_queue *q, int n)
+{
+	static u8 txwi;
+	int i;
+
+	for (i = 0; i < n; i++) {
+		struct mt76_queue_buf buf[2] = {
+			{ .addr = 0x10000 + i * 0x100, .len = 32 },
+			{ .addr = 0x20000 + i * 0x100, .len = 72,
+			  .skip_unmap = true },
+		};
+		int idx;
+
+		spin_lock_bh(&q->lock);
+		idx = mt76_dma_add_buf(t->dev, q, buf, 2, 0, NULL, &txwi);
+		spin_unlock_bh(&q->lock);
+		KUNIT_ASSERT_GE(t->test, idx, 0);
+	}
+	t->dev->queue_ops->kick(t->dev, q);
+}
+
+/* The queue's entries are as allocated: never written */
+static bool mt76_dma_test_entries_clear(struct mt76_queue *q)
+{
+	return !memchr_inv(q->entry, 0, q->ndesc * sizeof(*q->entry));
+}
+
+/* Frames go out as one descriptor each, without touching the entries;
+ * cleanup moves the tail to the DMA index in one step and completes
+ * nothing through the driver (its tokens do that).
+ */
+static void mt76_dma_test_tx_no_entry(struct kunit *test)
+{
+	struct mt76_dma_test *t;
+	struct mt76_queue_regs *regs;
+	struct mt76_queue *q;
+	struct mt76_dev *dev;
+	u32 ctrl;
+
+	t = mt76_dma_test_init(test, &mt76_dma_test_drv_no_free);
+	dev = t->dev;
+	q = mt76_dma_test_token_queue(t, 8);
+	regs = mt76_dma_test_qregs(q);
+	mt76_dma_test_token_frames(t, q, 3);
+
+	KUNIT_EXPECT_EQ(test, q->head, 3);
+	KUNIT_EXPECT_EQ(test, q->queued, 3);
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 3);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[1].buf0), 0x10100);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[1].buf1), 0x20100);
+	ctrl = le32_to_cpu(q->desc[1].ctrl);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_SD_LEN0, ctrl), 32);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_SD_LEN1, ctrl), 72);
+	KUNIT_EXPECT_TRUE(test, ctrl & MT_DMA_CTL_LAST_SEC1);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_entries_clear(q));
+
+	/* nothing done yet */
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, q->queued, 3);
+	KUNIT_EXPECT_EQ(test, q->tail, 0);
+
+	regs->dma_idx = 2;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, q->tail, 2);
+	KUNIT_EXPECT_EQ(test, q->queued, 1);
+
+	regs->dma_idx = 3;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, q->tail, 3);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	/* the tokens' frames: nothing for the ring to complete */
+	KUNIT_EXPECT_EQ(test, t->n_done, 0);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_entries_clear(q));
+}
+
+/* Across the ring's end: the DMA index behind the tail is a wrap, not a
+ * step back.
+ */
+static void mt76_dma_test_tx_no_entry_wrap(struct kunit *test)
+{
+	struct mt76_dma_test *t;
+	struct mt76_queue_regs *regs;
+	struct mt76_queue *q;
+	struct mt76_dev *dev;
+
+	t = mt76_dma_test_init(test, &mt76_dma_test_drv_no_free);
+	dev = t->dev;
+	q = mt76_dma_test_token_queue(t, 8);
+	regs = mt76_dma_test_qregs(q);
+
+	mt76_dma_test_token_frames(t, q, 6);
+	regs->dma_idx = 6;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+
+	/* slots 6, 7, 0, 1, 2 */
+	mt76_dma_test_token_frames(t, q, 5);
+	KUNIT_EXPECT_EQ(test, q->head, 3);
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 3);
+
+	regs->dma_idx = 1;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, q->tail, 1);
+	KUNIT_EXPECT_EQ(test, q->queued, 2);
+
+	regs->dma_idx = 3;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, q->tail, 3);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+
+	/* a full ring (ndesc - 1 frames) drains in one step */
+	mt76_dma_test_token_frames(t, q, 7);
+	KUNIT_EXPECT_EQ(test, q->head, 2);
+	regs->dma_idx = 2;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, q->tail, 2);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_entries_clear(q));
+}
+
+/* A DMA index past the head takes back no more than is queued; one that
+ * can't be read (a dead bus) takes back everything, as the per-entry
+ * cleanup does, and keeps the indices in range.
+ */
+static void mt76_dma_test_tx_no_entry_bad_idx(struct kunit *test)
+{
+	struct mt76_dma_test *t;
+	struct mt76_queue_regs *regs;
+	struct mt76_queue *q;
+	struct mt76_dev *dev;
+
+	t = mt76_dma_test_init(test, &mt76_dma_test_drv_no_free);
+	dev = t->dev;
+	q = mt76_dma_test_token_queue(t, 8);
+	regs = mt76_dma_test_qregs(q);
+
+	mt76_dma_test_token_frames(t, q, 2);
+	regs->dma_idx = 5;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, q->tail, 2);
+	KUNIT_EXPECT_EQ(test, q->tail, q->head);
+
+	/* nothing queued: the index is ignored */
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, q->tail, 2);
+
+	mt76_dma_test_token_frames(t, q, 3);
+	regs->dma_idx = 0xffffffff;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, q->tail, 5);
+	KUNIT_EXPECT_EQ(test, q->tail, q->head);
+	KUNIT_EXPECT_LT(test, (int)q->tail, q->ndesc);
+	regs->dma_idx = 5;
+}
+
+/* A flush takes everything back and resyncs the ring to the hardware, as
+ * on any other queue.
+ */
+static void mt76_dma_test_tx_no_entry_flush(struct kunit *test)
+{
+	struct mt76_dma_test *t;
+	struct mt76_queue_regs *regs;
+	struct mt76_queue *q;
+	struct mt76_dev *dev;
+
+	t = mt76_dma_test_init(test, &mt76_dma_test_drv_no_free);
+	dev = t->dev;
+	q = mt76_dma_test_token_queue(t, 8);
+	regs = mt76_dma_test_qregs(q);
+	mt76_dma_test_token_frames(t, q, 3);
+	regs->dma_idx = 1;
+	regs->ring_size = 0;
+
+	dev->queue_ops->tx_cleanup(dev, q, true);
+
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, q->head, 1);
+	KUNIT_EXPECT_EQ(test, q->tail, 1);
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 1);
+	KUNIT_EXPECT_EQ(test, regs->ring_size, 8);
+	KUNIT_EXPECT_EQ(test, t->n_done, 0);
+
+	/* again on the empty ring: nothing changes */
+	dev->queue_ops->tx_cleanup(dev, q, true);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, q->head, 1);
+	KUNIT_EXPECT_EQ(test, q->tail, 1);
+}
+
 /* Cleaning up a missing or unallocated queue does nothing. */
 static void mt76_dma_test_tx_cleanup_no_queue(struct kunit *test)
 {
@@ -2326,6 +2533,10 @@ static struct kunit_case mt76_dma_test_cases[] = {
 	KUNIT_CASE(mt76_dma_test_tx_cleanup_flush),
 	KUNIT_CASE(mt76_dma_test_tx_cleanup_dead_bus),
 	KUNIT_CASE(mt76_dma_test_tx_cleanup_no_free),
+	KUNIT_CASE(mt76_dma_test_tx_no_entry),
+	KUNIT_CASE(mt76_dma_test_tx_no_entry_wrap),
+	KUNIT_CASE(mt76_dma_test_tx_no_entry_bad_idx),
+	KUNIT_CASE(mt76_dma_test_tx_no_entry_flush),
 	KUNIT_CASE(mt76_dma_test_tx_cleanup_no_queue),
 	{}
 };
diff --git a/tx.c b/tx.c
index 3f097e5c..174068c9 100644
--- a/tx.c
+++ b/tx.c
@@ -364,7 +364,8 @@ __mt76_tx_queue_skb(struct mt76_phy *phy, int qid, struct sk_buff *skb,
 	if (idx < 0 || !sta)
 		return idx;
 
-	q->entry[idx].wcid = wcid->idx;
+	if (!mt76_queue_is_tx_no_entry(q))
+		q->entry[idx].wcid = wcid->idx;
 
 	if (!non_aql)
 		return idx;
