From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Thu, 19 Nov 2026 12:56:48 +0000
Subject: [PATCH] wifi: mt76: mt7915: a data ring's cleanup in one step,
 without its entries

Every frame mt7915 puts on a band's data ring is one descriptor that its tx token owns (mt7915_tx_prepare_skb()): buf0 is the txwi, which stays mapped; buf1 the header the firmware parses, left mapped for the token to unmap; no skb, the token holds it; no txwi to free (MT_DRV_TXWI_NO_FREE). Yet mt76_dma_add_buf() filled each descriptor's queue entry, and mt76_dma_tx_cleanup() walked the ring entry by entry: copied and cleared each one, found nothing to unmap or free, and took q->lock once per descriptor to step the tail, against the tx worker queueing more under the same lock.

A ring whose frames all have that shape is marked MT_QFLAG_TX_NO_ENTRY; mt7915_init_tx_queues() marks the data rings, not the firmware ones. On such a ring add_buf writes only the descriptors, and the cleanup moves the tail up to the DMA index in one step, under q->lock once, reading the index once. A flush, or an index that can't be read (a dead bus), takes everything back, as the loop did; an index past the head takes back no more than is queued. An empty ring (an idle band, on every tx-free event) takes no lock and reads no index, and one the hardware hasn't moved on takes no q->lock, as with the loop. A raw frame, an skb to unmap and free, is refused on such a ring, and add_buf warns if a frame isn't of that shape. q->entry stays allocated.

KUnit (mt76-dma): mt76_dma_test_tx_no_entry (descriptors written, entries never; the tail to the index; nothing completed through the driver), _wrap (across the ring's end, a full ring in one step), _bad_idx (an index past the head, a dead bus), _flush (the resync, and a second flush of the empty ring). mt7915-dma: only the data rings carry the flag, and the DBDC reset test marks band 1's ring as holding a frame instead of queueing a raw one there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dma.c                   | 105 +++++++++++++++++---
 mt76.h                  |  11 +++
 mt7915/dma.c            |   4 +-
 mt7915/tests/dma-test.c |  18 +++-
 tests/dma-test.c        | 211 ++++++++++++++++++++++++++++++++++++++++
 tx.c                    |   3 +-
 6 files changed, 335 insertions(+), 17 deletions(-)

diff --git a/dma.c b/dma.c
index 9d8ab38f..b9ebaacc 100644
--- a/dma.c
+++ b/dma.c
@@ -324,12 +324,19 @@ mt76_dma_add_buf(struct mt76_dev *dev, struct mt76_queue *q,
 		 struct mt76_queue_buf *buf, int nbufs, u32 info,
 		 struct sk_buff *skb, void *txwi)
 {
+	bool no_entry = mt76_queue_is_tx_no_entry(q);
 	struct mt76_queue_entry *entry;
 	struct mt76_desc *desc;
 	int i, idx = -1;
 	u32 ctrl, next;
 
-	if (txwi) {
+	/* nothing a token-tracked queue's cleanup would have to undo */
+	if (no_entry)
+		WARN_ON_ONCE(skb || !txwi ||
+			     !(dev->drv->drv_flags & MT_DRV_TXWI_NO_FREE) ||
+			     (nbufs > 1 && !buf[1].skip_unmap) || nbufs > 2);
+
+	if (txwi && !no_entry) {
 		q->entry[q->head].txwi = DMA_DUMMY_DATA;
 		q->entry[q->head].skip_buf0 = true;
 	}
@@ -341,30 +348,34 @@ mt76_dma_add_buf(struct mt76_dev *dev, struct mt76_queue *q,
 		next = mt76_queue_next(q, q->head);
 
 		desc = &q->desc[idx];
-		entry = &q->entry[idx];
+		entry = no_entry ? NULL : &q->entry[idx];
 
-		if (buf[0].skip_unmap)
-			entry->skip_buf0 = true;
-		entry->skip_buf1 = i == nbufs - 1;
+		if (entry) {
+			if (buf[0].skip_unmap)
+				entry->skip_buf0 = true;
+			entry->skip_buf1 = i == nbufs - 1;
 
-		entry->dma_addr[0] = buf[0].addr;
-		entry->dma_len[0] = buf[0].len;
+			entry->dma_addr[0] = buf[0].addr;
+			entry->dma_len[0] = buf[0].len;
+		}
 
 		ctrl = FIELD_PREP(MT_DMA_CTL_SD_LEN0, buf[0].len);
 #ifdef CONFIG_ARCH_DMA_ADDR_T_64BIT
 		info |= FIELD_PREP(MT_DMA_CTL_SDP0_H, buf[0].addr >> 32);
 #endif
 		if (i < nbufs - 1) {
-			entry->dma_addr[1] = buf[1].addr;
-			entry->dma_len[1] = buf[1].len;
 			buf1 = buf[1].addr;
 			ctrl |= FIELD_PREP(MT_DMA_CTL_SD_LEN1, buf[1].len);
 #ifdef CONFIG_ARCH_DMA_ADDR_T_64BIT
 			info |= FIELD_PREP(MT_DMA_CTL_SDP1_H,
 					   buf[1].addr >> 32);
 #endif
-			if (buf[1].skip_unmap)
-				entry->skip_buf1 = true;
+			if (entry) {
+				entry->dma_addr[1] = buf[1].addr;
+				entry->dma_len[1] = buf[1].len;
+				if (buf[1].skip_unmap)
+					entry->skip_buf1 = true;
+			}
 		}
 
 		if (i == nbufs - 1)
@@ -381,9 +392,11 @@ mt76_dma_add_buf(struct mt76_dev *dev, struct mt76_queue *q,
 		q->queued++;
 	}
 
-	q->entry[idx].txwi = txwi;
-	q->entry[idx].skb = skb;
-	q->entry[idx].wcid = 0xffff;
+	if (!no_entry) {
+		q->entry[idx].txwi = txwi;
+		q->entry[idx].skb = skb;
+		q->entry[idx].wcid = 0xffff;
+	}
 
 	return idx;
 }
@@ -419,6 +432,61 @@ mt76_dma_kick_queue(struct mt76_dev *dev, struct mt76_queue *q)
 		Q_WRITE(q, cpu_idx, q->head);
 }
 
+/* A token-tracked queue (MT_QFLAG_TX_NO_ENTRY): the descriptors up to the
+ * DMA index are done and hold nothing to undo, so the tail moves there in
+ * one step, under one q->lock. A flush, or a DMA index that can't be read
+ * (a dead bus), takes everything back, as the per-entry loop would.
+ */
+static void
+mt76_dma_tx_cleanup_no_entry(struct mt76_dev *dev, struct mt76_queue *q,
+			     bool flush)
+{
+	int last, done;
+	bool empty;
+
+	/* An empty ring (an idle band, on every tx-free event): no index to
+	 * read, no lock to take. A frame queued meanwhile waits for the next
+	 * cleanup, which its own completion brings; the cleanup that emptied
+	 * the ring has woken tx_wait.
+	 */
+	if (!flush && !READ_ONCE(q->queued))
+		return;
+
+	spin_lock_bh(&q->cleanup_lock);
+	last = flush ? -1 : mt76_dma_read_dma_idx(q, -1);
+	/* the hardware hasn't moved (a dead bus reads -1, never the tail) */
+	if (last == q->tail) {
+		spin_unlock_bh(&q->cleanup_lock);
+		return;
+	}
+
+	spin_lock_bh(&q->lock);
+	if (last < 0) {
+		q->tail = q->head;
+		q->queued = 0;
+	} else if (q->queued > 0) {
+		done = last - q->tail;
+		if (done < 0)
+			done += q->ndesc;
+		/* an index past the head: no more than is queued */
+		done = min(done, q->queued);
+		q->tail += done;
+		if (q->tail >= q->ndesc)
+			q->tail -= q->ndesc;
+		q->queued -= done;
+	}
+	if (flush) {
+		mt76_dma_sync_idx(dev, q);
+		mt76_dma_kick_queue(dev, q);
+	}
+	empty = !q->queued;
+	spin_unlock_bh(&q->lock);
+	spin_unlock_bh(&q->cleanup_lock);
+
+	if (empty)
+		wake_up(&dev->tx_wait);
+}
+
 static void
 mt76_dma_tx_cleanup(struct mt76_dev *dev, struct mt76_queue *q, bool flush)
 {
@@ -428,6 +496,11 @@ mt76_dma_tx_cleanup(struct mt76_dev *dev, struct mt76_queue *q, bool flush)
 	if (!q || !q->ndesc)
 		return;
 
+	if (mt76_queue_is_tx_no_entry(q)) {
+		mt76_dma_tx_cleanup_no_entry(dev, q, flush);
+		return;
+	}
+
 	spin_lock_bh(&q->cleanup_lock);
 	if (flush)
 		last = -1;
@@ -642,6 +715,10 @@ mt76_dma_tx_queue_skb_raw(struct mt76_dev *dev, struct mt76_queue *q,
 	if (test_bit(MT76_MCU_RESET, &dev->phy.state))
 		goto error;
 
+	/* an skb to unmap and free: not on a token-tracked queue */
+	if (WARN_ON_ONCE(mt76_queue_is_tx_no_entry(q)))
+		goto error;
+
 	if (q->queued + 1 >= q->ndesc - 1)
 		goto error;
 
diff --git a/mt76.h b/mt76.h
index a693f709..3b91d5ab 100644
--- a/mt76.h
+++ b/mt76.h
@@ -51,6 +51,12 @@
 #define MT_QFLAG_WED_RRO_EN	BIT(7)
 #define MT_QFLAG_EMI_EN		BIT(8)
 #define MT_QFLAG_NPU		BIT(9)
+/* A tx queue whose frames the driver tracks by token: every descriptor's
+ * buffers stay mapped (the txwi, the header the firmware parses) and no skb
+ * or txwi is freed with it, so its entries are never written or read and
+ * its cleanup just moves the tail up to the DMA index.
+ */
+#define MT_QFLAG_TX_NO_ENTRY	BIT(10)
 
 #define __MT_WED_Q(_type, _n)	(MT_QFLAG_WED | \
 				 FIELD_PREP(MT_QFLAG_WED_TYPE, _type) | \
@@ -2129,6 +2135,11 @@ static inline bool mt76_queue_is_npu(struct mt76_queue *q)
 	return q->flags & MT_QFLAG_NPU;
 }
 
+static inline bool mt76_queue_is_tx_no_entry(struct mt76_queue *q)
+{
+	return q->flags & MT_QFLAG_TX_NO_ENTRY;
+}
+
 /* The ring index after @idx: a compare, not a division by a ring size that
  * isn't a power of two everywhere (1536-entry rx rings)
  */
diff --git a/mt7915/dma.c b/mt7915/dma.c
index 529899cc..cd0a1fa9 100644
--- a/mt7915/dma.c
+++ b/mt7915/dma.c
@@ -21,8 +21,10 @@ mt7915_init_tx_queues(struct mt7915_phy *phy, int idx, int n_desc, int ring_base
 		wed = &dev->mt76.mmio.wed;
 	}
 
+	/* every frame is one descriptor the token owns (mt7915_tx_prepare_skb()) */
 	return mt76_connac_init_tx_queues(phy->mt76, idx, n_desc, ring_base,
-					  wed, MT_WED_Q_TX(idx));
+					  wed, MT_WED_Q_TX(idx) |
+					  MT_QFLAG_TX_NO_ENTRY);
 }
 
 static int mt7915_poll_tx(struct napi_struct *napi, int budget)
diff --git a/mt7915/tests/dma-test.c b/mt7915/tests/dma-test.c
