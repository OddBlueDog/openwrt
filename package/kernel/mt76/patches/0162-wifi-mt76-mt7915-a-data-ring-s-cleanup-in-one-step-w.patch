 	for (i = 0; i <= MT_TXQ_PSD; i++)
 		KUNIT_EXPECT_PTR_EQ(test, dev->mphy.q_tx[i], q);
+	/* its frames are the tokens' (one descriptor each, nothing to unmap
+	 * or free from the ring); the firmware rings' frames are the ring's
+	 */
+	KUNIT_EXPECT_TRUE(test, mt76_queue_is_tx_no_entry(q));
+	KUNIT_EXPECT_FALSE(test,
+			   mt76_queue_is_tx_no_entry(mdev->q_mcu[MT_MCUQ_FWDL]));
+	KUNIT_EXPECT_FALSE(test,
+			   mt76_queue_is_tx_no_entry(mdev->q_mcu[MT_MCUQ_WM]));
+	KUNIT_EXPECT_FALSE(test,
+			   mt76_queue_is_tx_no_entry(mdev->q_mcu[MT_MCUQ_WA]));
 
 	mt7915_dma_test_expect_ring(test, dev, mdev->q_mcu[MT_MCUQ_FWDL],
 				    MT7915_DMA_TEST_TX_RING(16),
@@ -767,7 +777,13 @@ static void mt7915_dma_test_dbdc_reset(struct kunit *test)
 	KUNIT_EXPECT_PTR_NE(test, dev->mphy.q_tx[MT_TXQ_BE], tx1);
 
 	mt7915_dma_test_queue_raw(test, dev, mcu);
-	mt7915_dma_test_queue_raw(test, dev, tx1);
+	/* a data frame on band 1's ring, as far as the ring knows: one
+	 * descriptor its token owns (a raw frame isn't taken there)
+	 */
+	spin_lock_bh(&tx1->lock);
+	tx1->head = 1;
+	tx1->queued = 1;
