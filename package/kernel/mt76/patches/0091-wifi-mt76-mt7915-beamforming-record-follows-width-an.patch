 /* The rate control work sends what changed for each queued station:
@@ -3958,6 +3965,80 @@ static void mt7915_test_sta_rc_work(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, fake->n_msgs, 3);
 }
 
+/* A station we explicitly beamform gets its beamforming record
+ * (STA_REC_BF) again, sized for its new width, when that or its stream
+ * count changes; new rates alone don't send it, nor does a station we
+ * don't beamform.
+ */
+static void mt7915_test_sta_rc_work_bf(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *a = mt7915_test_sta(test, dev, 9, mvif);
+	struct mt7915_sta *b = mt7915_test_sta(test, dev, 10, mvif);
+	struct mt7915_sta *c = mt7915_test_sta(test, dev, 11, mvif);
+	struct mt7915_sta *d = mt7915_test_sta(test, dev, 12, mvif);
+	struct mt7915_sta *all[] = { a, b, c, d };
+	struct cfg80211_bitrate_mask *mask = &mvif->bitrate_mask;
+	const struct sta_rec_bf *bf;
+	struct mt76_test_msg *msg;
+	int i;
+
+	mask->control[NL80211_BAND_5GHZ].legacy = GENMASK(7, 0);
+	mask->control[NL80211_BAND_5GHZ].he_gi = GENMASK(7, 0);
+	mask->control[NL80211_BAND_5GHZ].he_ltf = GENMASK(7, 0);
+	mvif->cap.vht_su_ebfer = true;
+
+	/* VHT SU beamformees at 40 MHz, two streams; d is HT only */
+	for (i = 0; i < ARRAY_SIZE(all); i++) {
+		struct ieee80211_sta *sta = mt7915_test_to_sta(all[i]);
+
+		sta->deflink.ht_cap.ht_supported = true;
+		sta->deflink.ht_cap.mcs.rx_mask[0] = 0xff;
+		sta->deflink.ht_cap.mcs.rx_mask[1] = 0xff;
+		sta->deflink.rx_nss = 2;
+		sta->deflink.bandwidth = IEEE80211_STA_RX_BW_40;
+		if (all[i] == d)
+			continue;
+		sta->deflink.vht_cap.vht_supported = true;
+		sta->deflink.vht_cap.cap =
+			IEEE80211_VHT_CAP_SU_BEAMFORMEE_CAPABLE;
+		sta->deflink.vht_cap.vht_mcs.rx_mcs_map = cpu_to_le16(0xfffa);
+	}
+
+	a->changed = IEEE80211_RC_BW_CHANGED;
+	b->changed = IEEE80211_RC_NSS_CHANGED;
+	c->changed = IEEE80211_RC_SUPP_RATES_CHANGED;
+	d->changed = IEEE80211_RC_BW_CHANGED | IEEE80211_RC_NSS_CHANGED;
+	for (i = 0; i < ARRAY_SIZE(all); i++)
+		list_add_tail(&all[i]->rc_list, &dev->sta_rc_list);
+
+	mt7915_mac_sta_rc_work(&dev->rc_work);
+
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->sta_rc_list));
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 4);
+	for (i = 0; i < ARRAY_SIZE(all); i++) {
+		msg = mt76_test_msg(fake, i);
+		KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+		KUNIT_EXPECT_EQ(test, msg->data[1], 9 + i);
+		KUNIT_EXPECT_TRUE(test, mt7915_test_has_tlv(msg, STA_REC_RA));
+	}
+
+	msg = mt76_test_msg(fake, 0);
+	bf = (const struct sta_rec_bf *)mt7915_test_find_tlv(msg, STA_REC_BF);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->bw, IEEE80211_STA_RX_BW_40);
+	KUNIT_EXPECT_EQ(test, bf->ibf_dbw, IEEE80211_STA_RX_BW_40);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_has_tlv(mt76_test_msg(fake, 1),
+						     STA_REC_BF));
+	KUNIT_EXPECT_FALSE(test, mt7915_test_has_tlv(mt76_test_msg(fake, 2),
+						      STA_REC_BF));
+	KUNIT_EXPECT_FALSE(test, mt7915_test_has_tlv(mt76_test_msg(fake, 3),
+						      STA_REC_BF));
+}
+
 /* --- beacons after a reset ---------------------------------------------- */
 
 /* After a reset the beacon state of AP, mesh and IBSS interfaces is sent to
@@ -5090,6 +5171,7 @@ static struct kunit_suite mt7915_mac_dfs_test_suite = {
 
 static struct kunit_case mt7915_mac_reset_test_cases[] = {
 	KUNIT_CASE(mt7915_test_sta_rc_work),
+	KUNIT_CASE(mt7915_test_sta_rc_work_bf),
 	KUNIT_CASE(mt7915_test_sta_rc_reset),
 	KUNIT_CASE(mt7915_test_update_vif_beacon),
 	KUNIT_CASE(mt7915_test_reset_events),
diff --git a/mt7915/tests/mcu-test.c b/mt7915/tests/mcu-test.c
index a94bc296..076be490 100644
--- a/mt7915/tests/mcu-test.c
+++ b/mt7915/tests/mcu-test.c
@@ -3376,8 +3376,11 @@ static void mt7915_test_bfer_he(struct kunit *test)
 	KUNIT_ASSERT_NOT_NULL(test, bf);
 	KUNIT_EXPECT_EQ(test, bf->nrow, 3);
 
-	/* 160 MHz with 80+80: columns from the smaller of the two maps */
+	/* 160 MHz with 80+80: columns from the smaller of the two maps (of
+	 * a station taking all three streams of its 160 MHz map)
+	 */
 	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_160;
+	c.sta->deflink.rx_nss = 3;
 	pe->phy_cap_info[0] =
 		IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_160MHZ_IN_5G |
 		IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_80PLUS80_MHZ_IN_5G;
@@ -3607,6 +3610,83 @@ static void mt7915_test_bfer_he_ibf(struct kunit *test)
 	KUNIT_EXPECT_NULL(test, mt7915_test_bf_tlv(test, &c));
 }
 
+/* Beamforming columns follow the streams the station takes now (rx_nss,
+ * which an Operating Mode Notification lowers), not only its MCS maps: HE
+ * at 80 and above 80 MHz, VHT explicit and implicit.
+ */
+static void mt7915_test_bfer_nss(struct kunit *test)
+{
+	struct ieee80211_he_cap_elem *pe;
+	struct mt7915_test_ctx c;
+	struct sta_rec_bf *bf;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_ht(c.sta);
+	mt7915_test_vht(c.sta);
+	mt7915_test_he(c.sta);
+	pe = &c.sta->deflink.he_cap.he_cap_elem;
+	pe->phy_cap_info[4] = IEEE80211_HE_PHY_CAP4_SU_BEAMFORMEE |
+		u8_encode_bits(3, IEEE80211_HE_PHY_CAP4_BEAMFORMEE_MAX_STS_UNDER_80MHZ_MASK) |
+		u8_encode_bits(3, IEEE80211_HE_PHY_CAP4_BEAMFORMEE_MAX_STS_ABOVE_80MHZ_MASK);
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_80;
+
+	/* HE, four rows: 4x2, then 4x1 at one stream */
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->nrow, 3);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 5);
+	c.sta->deflink.rx_nss = 1;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->nrow, 3);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 0);
+	KUNIT_EXPECT_EQ(test, bf->ibf_ncol, 0);
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 3);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 6);
+
+	/* above 80 MHz the same, from both maps */
+	pe->phy_cap_info[0] =
+		IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_160MHZ_IN_5G |
+		IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_80PLUS80_MHZ_IN_5G;
+	c.sta->deflink.he_cap.he_mcs_nss_supp.rx_mcs_160 = cpu_to_le16(0xfffa);
+	c.sta->deflink.he_cap.he_mcs_nss_supp.rx_mcs_80p80 =
+		cpu_to_le16(0xfffa);
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_160;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol_gt_bw80, 0);
+	c.sta->deflink.rx_nss = 2;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol_gt_bw80, 1);
+
+	/* VHT explicit */
+	c.sta->deflink.he_cap.has_he = false;
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_80;
+	c.sta->deflink.rx_nss = 1;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->tx_mode, MT_PHY_TYPE_VHT);
+	KUNIT_EXPECT_EQ(test, bf->bf_cap, 1);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 0);
+	KUNIT_EXPECT_EQ(test, bf->ibf_ncol, 0);
+
+	/* and implicit */
+	c.mvif->cap.vht_su_ebfer = false;
+	c.dev->ibf = true;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->bf_cap, 2);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 0);
+	KUNIT_EXPECT_EQ(test, bf->ibf_ncol, 0);
+	c.sta->deflink.rx_nss = 2;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->ibf_ncol, 1);
+}
+
 /* @c's station's STA_REC_BFEE, built on its own */
