@@ -1705,6 +1715,12 @@ int mt7915_mcu_add_rate_ctrl(struct mt7915_dev *dev, struct ieee80211_vif *vif,
 	if (IS_ERR(skb))
 		return PTR_ERR(skb);
 
+	/* the beamforming record (if the station has one) is sized for its
+	 * width and streams, so it follows them; first, as when it's added
