+/* the streams of @mcs_map the station takes now: an Operating Mode
+ * Notification (rx_nss) can turn some off
+ */
+static u8
+mt7915_mcu_get_sta_bf_nss(struct ieee80211_sta *sta, u16 mcs_map)
+{
+	return min_t(u8, mt7915_mcu_get_sta_nss(mcs_map),
+		     sta->deflink.rx_nss - 1);
+}
+
