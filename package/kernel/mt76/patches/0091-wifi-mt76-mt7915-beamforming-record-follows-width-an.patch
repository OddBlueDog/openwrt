+/* A station we beamform gets its STA_REC_BF again, first as when it's
+ * added, when its width or stream count changes (an Operating Mode
+ * Notification), sized for the new ones. New rates alone don't send it,
+ * and neither does a station without one.
+ */
+static void mt7915_test_add_rate_ctrl_bf(struct kunit *test)
+{
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+	struct sta_rec_bf *bf;
+	struct sta_rec_he *he;
+	u16 tags[4];
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_ht(c.sta);
+	mt7915_test_vht(c.sta);
+	mt7915_test_he(c.sta);
+
+	/* from 80 to 40 MHz: 4x2 for one 20 MHz half, not two */
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_40;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_rate_ctrl(c.dev, c.vif, c.sta,
+			&c.msta->wcid, IEEE80211_RC_BW_CHANGED), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 1);
+	msg = mt76_test_msg(c.fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	KUNIT_ASSERT_EQ(test, mt7915_test_tags(test, msg, tags, 4), 3);
+	KUNIT_EXPECT_EQ(test, tags[0], STA_REC_BF);
+	KUNIT_EXPECT_EQ(test, tags[1], STA_REC_HE);
+	KUNIT_EXPECT_EQ(test, tags[2], STA_REC_RA);
+	bf = mt7915_test_tlv(test, msg, STA_REC_BF, struct sta_rec_bf);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->bw, IEEE80211_STA_RX_BW_40);
+	KUNIT_EXPECT_EQ(test, bf->ibf_dbw, IEEE80211_STA_RX_BW_40);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 5);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 5);
+
+	/* down to one stream: one column (4x1), and one in STA_REC_HE */
+	c.sta->deflink.rx_nss = 1;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_rate_ctrl(c.dev, c.vif, c.sta,
+			&c.msta->wcid, IEEE80211_RC_NSS_CHANGED), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 2);
+	msg = mt76_test_msg(c.fake, 1);
+	KUNIT_ASSERT_EQ(test, mt7915_test_tags(test, msg, tags, 4), 3);
+	KUNIT_EXPECT_EQ(test, tags[0], STA_REC_BF);
+	bf = mt7915_test_tlv(test, msg, STA_REC_BF, struct sta_rec_bf);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 0);
+	KUNIT_EXPECT_EQ(test, bf->ibf_ncol, 0);
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 3);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 3);
+	he = mt7915_test_tlv(test, msg, STA_REC_HE, struct sta_rec_he);
+	KUNIT_ASSERT_NOT_NULL(test, he);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->max_nss_mcs[CMD_HE_MCS_BW80]),
+			0xfffe);
+
+	/* new rates alone leave it */
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_rate_ctrl(c.dev, c.vif, c.sta,
+			&c.msta->wcid, IEEE80211_RC_SUPP_RATES_CHANGED), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 3);
+	msg = mt76_test_msg(c.fake, 2);
+	KUNIT_ASSERT_EQ(test, mt7915_test_tags(test, msg, tags, 4), 2);
+	KUNIT_EXPECT_EQ(test, tags[0], STA_REC_HE);
+	KUNIT_EXPECT_EQ(test, tags[1], STA_REC_RA);
+
+	/* no beamforming record at add (we don't beamform it): none now */
+	c.mvif->cap.he_su_ebfer = false;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_rate_ctrl(c.dev, c.vif, c.sta,
+			&c.msta->wcid,
+			IEEE80211_RC_BW_CHANGED | IEEE80211_RC_NSS_CHANGED), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 4);
+	msg = mt76_test_msg(c.fake, 3);
+	KUNIT_ASSERT_EQ(test, mt7915_test_tags(test, msg, tags, 4), 2);
+	KUNIT_EXPECT_EQ(test, tags[0], STA_REC_HE);
+	KUNIT_EXPECT_EQ(test, tags[1], STA_REC_RA);
+}
