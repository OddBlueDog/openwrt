From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Fri, 20 Nov 2026 13:14:16 +0000
Subject: [PATCH] wifi: mt76: mt7915: close the firmware log channel when the
 device goes

Writing fw_debug_bin opens a relay channel for the firmware's binary log
(1500 sub-buffers of 512 bytes per CPU). Nothing ever closed it: each
unload of the driver after that leaked the channel and its buffers, and
mac80211's removal of the debugfs tree took its file away underneath it.

mt7915_unregister_device() closes it first, while its file still exists.
The log writers check for it under the same lock as the close, so a
firmware log event during the removal is dropped, and fw_debug_bin opens
nothing once the removal has started.

mt7915_debugfs_test_fwlog_close; mt7915_init_test_unregister_device opens
the channel first (the debug kernel's kmemleak finds it otherwise).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mt7915/debugfs.c            | 55 ++++++++++++++++++++++++++++++-------
 mt7915/init.c               |  1 +
 mt7915/mt7915.h             |  1 +
 mt7915/tests/debugfs-test.c | 52 +++++++++++++++++++++++++++++++++++
 mt7915/tests/init-test.c    |  7 +++++
 5 files changed, 106 insertions(+), 10 deletions(-)

diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
index f300c4b1..732bb3c9 100644
--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -686,6 +686,9 @@ mt7915_fw_debug_wa_get(void *data, u64 *val)
 DEFINE_DEBUGFS_ATTRIBUTE(fops_fw_debug_wa, mt7915_fw_debug_wa_get,
 			 mt7915_fw_debug_wa_set, "%lld\n");
 
+/* dev->relay_fwlog: its writers (firmware log events) and its closing */
+static DEFINE_SPINLOCK(mt7915_fwlog_lock);
+
 static struct dentry *
 create_buf_file_cb(const char *filename, struct dentry *parent, umode_t mode,
 		   struct rchan_buf *buf, int *is_global)
@@ -718,12 +721,23 @@ mt7915_fw_debug_bin_set(void *data, u64 val)
 		.remove_buf_file = remove_buf_file_cb,
 	};
 	struct mt7915_dev *dev = data;
+	struct rchan *relay;
+	unsigned long flags;
 
-	if (!dev->relay_fwlog)
-		dev->relay_fwlog = relay_open("fwlog_data", dev->debugfs_dir,
-					    1500, 512, &relay_cb, NULL);
-	if (!dev->relay_fwlog)
-		return -ENOMEM;
+	/* the device is going: its channel was closed or is about to be */
+	if (test_bit(MT76_REMOVED, &dev->mphy.state))
+		return -ENODEV;
+
+	if (!dev->relay_fwlog) {
+		relay = relay_open("fwlog_data", dev->debugfs_dir, 1500, 512,
+				   &relay_cb, NULL);
+		if (!relay)
+			return -ENOMEM;
+
+		spin_lock_irqsave(&mt7915_fwlog_lock, flags);
+		dev->relay_fwlog = relay;
+		spin_unlock_irqrestore(&mt7915_fwlog_lock, flags);
+	}
 
 	dev->fw.debug_bin = val;
 
@@ -1708,12 +1722,12 @@ static void
 mt7915_debugfs_write_fwlog(struct mt7915_dev *dev, const void *hdr, int hdrlen,
 			 const void *data, int len)
 {
-	static DEFINE_SPINLOCK(lock);
 	unsigned long flags;
-	void *dest;
+	void *dest = NULL;
 
-	spin_lock_irqsave(&lock, flags);
-	dest = relay_reserve(dev->relay_fwlog, hdrlen + len + 4);
+	spin_lock_irqsave(&mt7915_fwlog_lock, flags);
+	if (dev->relay_fwlog)
+		dest = relay_reserve(dev->relay_fwlog, hdrlen + len + 4);
 	if (dest) {
 		*(u32 *)dest = hdrlen + len;
 		dest += 4;
@@ -1726,7 +1740,28 @@ mt7915_debugfs_write_fwlog(struct mt7915_dev *dev, const void *hdr, int hdrlen,
 		memcpy(dest, data, len);
 		relay_flush(dev->relay_fwlog);
 	}
-	spin_unlock_irqrestore(&lock, flags);
+	spin_unlock_irqrestore(&mt7915_fwlog_lock, flags);
+}
+
+/*
+ * The firmware log channel fw_debug_bin opened, closed for the device's
+ * removal: its buffers (1500 sub-buffers of 512 bytes per CPU) are freed
+ * nowhere else. Before mac80211 removes the debugfs tree, while its file
+ * there still exists (relay_close() removes it). A log event that comes
+ * in after it is dropped.
+ */
+void mt7915_debugfs_fwlog_close(struct mt7915_dev *dev)
+{
+	struct rchan *relay;
+	unsigned long flags;
+
+	spin_lock_irqsave(&mt7915_fwlog_lock, flags);
+	relay = dev->relay_fwlog;
+	dev->relay_fwlog = NULL;
+	spin_unlock_irqrestore(&mt7915_fwlog_lock, flags);
+
+	if (relay)
+		relay_close(relay);
 }
 
 void mt7915_debugfs_rx_fw_monitor(struct mt7915_dev *dev, const void *data, int len)
diff --git a/mt7915/init.c b/mt7915/init.c
index ddad4349..1912e776 100644
--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -1434,6 +1434,7 @@ void mt7915_unregister_device(struct mt7915_dev *dev)
 	cancel_work_sync(&dev->dump_work);
 	cancel_work_sync(&dev->reset_work);
 	cancel_work_sync(&dev->rc_work);
+	mt7915_debugfs_fwlog_close(dev);
 	mt7915_unregister_ext_phy(dev);
 	mt7915_coredump_unregister(dev);
 	mt7915_unregister_thermal(&dev->phy);
diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
index 25729c6e..0b3c548f 100644
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -828,6 +828,7 @@ int mt7915_mcu_wed_enable_rx_stats(struct mt7915_dev *dev);
 int mt7915_init_debugfs(struct mt7915_phy *phy);
 void mt7915_debugfs_rx_fw_monitor(struct mt7915_dev *dev, const void *data, int len);
 bool mt7915_debugfs_rx_log(struct mt7915_dev *dev, const void *data, int len);
+void mt7915_debugfs_fwlog_close(struct mt7915_dev *dev);
 /* mac80211's per-station debugfs; backports (OpenWrt's mac80211) calls the
  * option CPTCFG_MAC80211_DEBUGFS
  */
diff --git a/mt7915/tests/debugfs-test.c b/mt7915/tests/debugfs-test.c
index 223bfcef..1ab18b1d 100644
--- a/mt7915/tests/debugfs-test.c
+++ b/mt7915/tests/debugfs-test.c
@@ -291,11 +291,63 @@ static void mt7915_debugfs_test_twt_status(struct kunit *test)
 	KUNIT_EXPECT_NULL(test, strstr(t->buf, "id=1 "));
 }
 
+struct mt76_test_fake;
+struct mt7915_dev *mt7915_init_test_device(struct kunit *test, u32 sku,
+					   struct mt76_test_fake **fake);
+
+int mt7915_debugfs_test_fwlog_open(struct mt7915_dev *dev);
+
+/* for tests/init-test.c: fw_debug_bin turned on, its channel opened */
+int mt7915_debugfs_test_fwlog_open(struct mt7915_dev *dev)
+{
+	return mt7915_fw_debug_bin_set(dev, 1);
+}
+
+/* the firmware log channel's file is in the device's debugfs directory */
+static bool mt7915_debugfs_test_fwlog_file(struct mt7915_dev *dev)
+{
+	struct dentry *d = debugfs_lookup("fwlog_data", dev->debugfs_dir);
+
+	dput(d);
+	return d;
+}
+
+/* fw_debug_bin opens the firmware log channel, a file in the device's
+ * debugfs directory; closing it for the device's removal removes the file
+ * and frees the channel, and a log event after is dropped. Closing twice is
+ * fine, and once the device is being removed fw_debug_bin opens nothing.
+ */
+static void mt7915_debugfs_test_fwlog_close(struct kunit *test)
+{
+	__le32 log[4] = { cpu_to_le32(FW_BIN_LOG_MAGIC) };
+	struct mt7915_dev *dev;
+
+	dev = mt7915_init_test_device(test, MT7976_ONE_ADIE_DBDC, NULL);
+	KUNIT_ASSERT_EQ(test, mt7915_init_debugfs(&dev->phy), 0);
+	KUNIT_ASSERT_NOT_NULL(test, dev->debugfs_dir);
+	KUNIT_ASSERT_EQ(test, mt7915_debugfs_test_fwlog_open(dev), 0);
+	KUNIT_ASSERT_NOT_NULL(test, dev->relay_fwlog);
+	KUNIT_EXPECT_TRUE(test, mt7915_debugfs_test_fwlog_file(dev));
+	KUNIT_EXPECT_TRUE(test, mt7915_debugfs_rx_log(dev, log, sizeof(log)));
+
+	mt7915_debugfs_fwlog_close(dev);
+	KUNIT_EXPECT_NULL(test, dev->relay_fwlog);
+	KUNIT_EXPECT_FALSE(test, mt7915_debugfs_test_fwlog_file(dev));
+	KUNIT_EXPECT_TRUE(test, mt7915_debugfs_rx_log(dev, log, sizeof(log)));
+	mt7915_debugfs_fwlog_close(dev);
+
+	set_bit(MT76_REMOVED, &dev->mphy.state);
+	KUNIT_EXPECT_EQ(test, mt7915_debugfs_test_fwlog_open(dev), -ENODEV);
+	KUNIT_EXPECT_NULL(test, dev->relay_fwlog);
+	clear_bit(MT76_REMOVED, &dev->mphy.state);
+}
+
 static struct kunit_case mt7915_debugfs_test_cases[] = {
 	KUNIT_CASE(mt7915_debugfs_test_twt_stats_locked),
 	KUNIT_CASE(mt7915_debugfs_test_twt_policy_set),
 	KUNIT_CASE(mt7915_debugfs_test_twt_status),
 	KUNIT_CASE(mt7915_debugfs_test_rdd_reports),
+	KUNIT_CASE(mt7915_debugfs_test_fwlog_close),
 	{}
 };
 
diff --git a/mt7915/tests/init-test.c b/mt7915/tests/init-test.c
index 01147bbd..1a717fd8 100644
--- a/mt7915/tests/init-test.c
+++ b/mt7915/tests/init-test.c
@@ -17,6 +17,7 @@
 
 struct mt7915_dev *mt7915_init_test_device(struct kunit *test, u32 sku,
 					   struct mt76_test_fake **fake);
+int mt7915_debugfs_test_fwlog_open(struct mt7915_dev *dev);
 
 /* kernel/rcu/rcu.h, exported: registering and unregistering a wiphy waits
  * for several RCU grace periods, ~70 ms each time in the test VM unless
@@ -1782,6 +1783,12 @@ static void mt7915_init_test_unregister_device(struct kunit *test)
 	mt7915_init_test_register(test, dev, true);
 	KUNIT_ASSERT_NOT_NULL(test, mt7915_ext_phy(dev));
 	KUNIT_ASSERT_EQ(test, mt7915_coredump_register(dev), 0);
+	/* the firmware log channel open: unregistering closes it (or the
+	 * debug kernel's kmemleak finds it, and KASAN a close after
+	 * mac80211 removed its debugfs file)
+	 */
+	KUNIT_ASSERT_EQ(test, mt7915_init_debugfs(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, mt7915_debugfs_test_fwlog_open(dev), 0);
 	/* the firmware goes back to its download state when restarted */
 	mt76_wr(dev, MT_TOP_MISC, FIELD_PREP(MT_TOP_MISC_FW_STATE,
 					     FW_STATE_FW_DOWNLOAD));
