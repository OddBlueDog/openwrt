+/* The device taking up the terms in @twt, the radio's answer: as a station
+ * does after an ALTERNATE or DICTATE.
+ */
+static u8 mt7915_test_twt_retake(struct kunit *test, struct ieee80211_hw *hw,
+				 struct ieee80211_sta *sta,
+				 struct ieee80211_twt_setup **twt)
+{
+	struct ieee80211_twt_params *p = mt7915_test_twt_params(*twt);
+	u16 req_type = le16_to_cpu(p->req_type);
+	struct ieee80211_twt_setup *again;
+
+	again = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST,
+				    FIELD_GET(IEEE80211_TWT_REQTYPE_WAKE_INT_EXP,
+					      req_type),
+				    le16_to_cpu(p->mantissa), p->min_twt_dur,
+				    req_type & IEEE80211_TWT_REQTYPE_FLOWID);
+	again->control = (*twt)->control;
+	mt7915_mac_add_twt_setup(hw, sta, again);
+	*twt = again;
+	return mt7915_test_twt_answer(again);
+}
+
+/* Terms the radio suggests are its policy's fixed point: the device taking
+ * them up gets them accepted, not suggested again, also where the limits
+ * are closer together than the fields can say (60 s exactly isn't one of
+ * the intervals they hold), where the maximum is shorter than the wake
+ * duration (the device has to be able to sleep: over it), and where the
+ * floor is more than a duration in TUs can say (63 TUs = 252).
+ */
+static void mt7915_test_twt_policy_converges(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_phy *phy = &dev->phy;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *a = mt7915_test_sta(test, dev, 9, mvif);
+	struct ieee80211_sta *sta = mt7915_test_to_sta(a);
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_twt_setup *twt;
+	struct ieee80211_twt_params *p;
+	u8 exp;
+
+	mt7915_test_tsf(dev, 1 << 30);
+
+	phy->twt_policy.min_interval_ms = 60000;
+	phy->twt_policy.max_interval_ms = 60000;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 20, 1024, 64, 0);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ALTERNATE);
+	p = mt7915_test_twt_params(twt);
+	exp = le16_get_bits(p->req_type, IEEE80211_TWT_REQTYPE_WAKE_INT_EXP);
+	/* the longest under the maximum */
+	KUNIT_EXPECT_EQ(test, (u64)le16_to_cpu(p->mantissa) << exp, 59999232);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_retake(test, hw, sta, &twt),
+			TWT_SETUP_CMD_ACCEPT);
+	mutex_lock(&dev->mt76.mutex);
+	mt7915_mac_twt_teardown_flow(dev, a, 0);
+	mutex_unlock(&dev->mt76.mutex);
+	phy->twt_policy.min_interval_ms = 0;
+	phy->twt_policy.max_interval_ms = 0;
+
+	/* a maximum of 65 ms, a floor of 255 x 256 us = 65.28 ms */
+	phy->twt_policy.max_interval_ms = 65;
+	phy->twt_policy.min_wake_dur = U8_MAX;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64, 0);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ALTERNATE);
+	p = mt7915_test_twt_params(twt);
+	exp = le16_get_bits(p->req_type, IEEE80211_TWT_REQTYPE_WAKE_INT_EXP);
+	KUNIT_EXPECT_GT(test, (u64)le16_to_cpu(p->mantissa) << exp,
+			(u64)U8_MAX << 8);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_retake(test, hw, sta, &twt),
+			TWT_SETUP_CMD_ACCEPT);
+	mutex_lock(&dev->mt76.mutex);
+	mt7915_mac_twt_teardown_flow(dev, a, 0);
+	mutex_unlock(&dev->mt76.mutex);
+	phy->twt_policy.max_interval_ms = 0;
+
+	/* in TUs, a floor of 253: 63 TUs is as near as it gets */
+	phy->twt_policy.min_wake_dur = 253;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 20, 0);
+	twt->control = IEEE80211_TWT_CONTROL_WAKE_DUR_UNIT;
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ALTERNATE);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_params(twt)->min_twt_dur, 63);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_retake(test, hw, sta, &twt),
+			TWT_SETUP_CMD_ACCEPT);
+	KUNIT_EXPECT_EQ(test, a->twt.flow[0].duration, 252);
+	phy->twt_policy.min_wake_dur = 0;
+}
+
+/* New terms for a flow a station has don't make one flow more: with the
+ * band at its limit (lowered under the flows there are) the station keeps
+ * the flow it has; at the limit it doesn't go over, the terms replace it.
