+struct mt7915_debugfs_test_locked {
+	struct work_struct work;
+	struct completion done;
+	int (*fn)(struct mt7915_debugfs_test_locked *t);
+	struct mt7915_dev *dev;
+	struct seq_file s;
+	char buf[2048];
+	int ret;
+};
+
+static int mt7915_debugfs_test_util_wm(struct mt7915_debugfs_test_locked *t)
+{
+	t->s.private = t->dev;
+	return mt7915_fw_util_wm_show(&t->s, NULL);
+}
+
+static int mt7915_debugfs_test_util_wa(struct mt7915_debugfs_test_locked *t)
+{
+	t->s.private = t->dev;
+	return mt7915_fw_util_wa_show(&t->s, NULL);
+}
+
+static int mt7915_debugfs_test_hw_queues(struct mt7915_debugfs_test_locked *t)
+{
+	t->s.private = &t->dev->phy;
+	return mt7915_hw_queues_show(&t->s, NULL);
+}
+
+static int mt7915_debugfs_test_txbf(struct mt7915_debugfs_test_locked *t)
+{
+	return mt7915_implicit_txbf_set(t->dev, 0);
+}
+
+static int mt7915_debugfs_test_debug_wm(struct mt7915_debugfs_test_locked *t)
+{
+	return mt7915_fw_debug_wm_set(t->dev, 0);
+}
+
+static void mt7915_debugfs_test_locked_fn(struct work_struct *work)
+{
+	struct mt7915_debugfs_test_locked *t =
+		container_of(work, struct mt7915_debugfs_test_locked, work);
+
+	t->ret = t->fn(t);
+	complete(&t->done);
+}
+
+/* What reads WiFi subsystem registers or asks the firmware waits for the
+ * driver mutex, which a full reset holds while that subsystem is down
+ * (a diagnostics script reads hw-queues and fw_util_* on a live router). The
+ * mutex also keeps hw-queues and the stations' queues from changing each
+ * other's MT_FL_Q0_CTRL selection.
+ */
+static void mt7915_debugfs_test_wfsys_locked(struct kunit *test)
+{
+	static int (*const fns[])(struct mt7915_debugfs_test_locked *) = {
+		mt7915_debugfs_test_util_wm, mt7915_debugfs_test_util_wa,
+		mt7915_debugfs_test_hw_queues, mt7915_debugfs_test_txbf,
+		mt7915_debugfs_test_debug_wm,
+	};
+	struct mt7915_debugfs_test_locked *t;
+	struct mt7915_dev *dev;
+	int i;
+
+	dev = mt7915_init_test_device(test, MT7976_ONE_ADIE_DBDC, NULL);
+	t = kunit_kzalloc(test, sizeof(*t), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, t);
+	t->dev = dev;
+
+	for (i = 0; i < ARRAY_SIZE(fns); i++) {
+		memset(&t->s, 0, sizeof(t->s));
+		t->s.buf = t->buf;
+		t->s.size = sizeof(t->buf);
+		t->fn = fns[i];
+		init_completion(&t->done);
+		INIT_WORK(&t->work, mt7915_debugfs_test_locked_fn);
+
+		mutex_lock(&dev->mt76.mutex);
+		schedule_work(&t->work);
+		msleep(50);
+		KUNIT_EXPECT_FALSE_MSG(test, completion_done(&t->done),
+				       "reader %d", i);
+		mutex_unlock(&dev->mt76.mutex);
+
+		flush_work(&t->work);
+		KUNIT_EXPECT_TRUE_MSG(test, completion_done(&t->done),
+				      "reader %d", i);
+		KUNIT_EXPECT_EQ_MSG(test, t->ret, 0, "reader %d", i);
+	}
+}
+
+struct mt7915_debugfs_test_fwlog_work {
+	struct work_struct work;
+	struct completion done;
+	struct mt7915_dev *dev;
+	bool close;
+	int ret;
+};
+
+static void mt7915_debugfs_test_fwlog_fn(struct work_struct *work)
+{
+	struct mt7915_debugfs_test_fwlog_work *w =
+		container_of(work, struct mt7915_debugfs_test_fwlog_work, work);
+
+	if (w->close)
+		mt7915_debugfs_fwlog_close(w->dev);
+	else
+		w->ret = mt7915_fw_debug_bin_set(w->dev, 1);
+	complete(&w->done);
+}
+
+/* fw_debug_bin and the channel's closing for the device's removal take
+ * turns: one that set up a channel just as it was closed would leave it
+ * open for good (or reset one being closed), two at once would open two.
+ */
+static void mt7915_debugfs_test_fwlog_serialised(struct kunit *test)
+{
+	struct mt7915_debugfs_test_fwlog_work *w;
+	struct mt7915_dev *dev;
+	int i;
+
+	dev = mt7915_init_test_device(test, MT7976_ONE_ADIE_DBDC, NULL);
+	KUNIT_ASSERT_EQ(test, mt7915_init_debugfs(&dev->phy), 0);
+	w = kunit_kzalloc(test, sizeof(*w), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, w);
+	w->dev = dev;
+
+	/* opening, resetting the open one, closing */
+	for (i = 0; i < 3; i++) {
+		w->close = i == 2;
+		init_completion(&w->done);
+		INIT_WORK(&w->work, mt7915_debugfs_test_fwlog_fn);
+
+		/* still waiting after 50 ms (a check that doesn't consume
+		 * the completion)
+		 */
+		mutex_lock(&mt7915_fwlog_mutex);
+		schedule_work(&w->work);
+		msleep(50);
+		KUNIT_EXPECT_FALSE(test, completion_done(&w->done));
+		mutex_unlock(&mt7915_fwlog_mutex);
+
+		flush_work(&w->work);
+		KUNIT_EXPECT_TRUE(test, completion_done(&w->done));
+		if (w->close) {
+			KUNIT_EXPECT_NULL(test, dev->relay_fwlog);
+		} else {
+			KUNIT_EXPECT_EQ(test, w->ret, 0);
+			KUNIT_EXPECT_NOT_NULL(test, dev->relay_fwlog);
+		}
+	}
+	KUNIT_EXPECT_FALSE(test, mt7915_debugfs_test_fwlog_file(dev));
+}
