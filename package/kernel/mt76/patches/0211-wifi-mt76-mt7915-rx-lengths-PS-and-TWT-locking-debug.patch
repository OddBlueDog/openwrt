+/* What fixed_rate's line asks for: a rate, or (any other line) the
+ * firmware's choice again.
+ */
+static int mt7915_sta_fixed_rate_parse(struct ieee80211_sta *sta,
+				       const char *buf, struct sta_phy *phy,
+				       u32 *field)
+{
+	u8 i, gi, he_ltf;
+
+	memset(phy, 0, sizeof(*phy));
+
+	/* mode - cck: 0, ofdm: 1, ht: 2, gf: 3, vht: 4, he_su: 8, he_er: 9
+	 * bw - bw20: 0, bw40: 1, bw80: 2, bw160: 3
+	 * nss - vht: 1~4, he: 1~4, others: ignore
+	 * mcs - cck: 0~4, ofdm: 0~7, ht: 0~32, vht: 0~9, he_su: 0~11, he_er: 0~2
+	 * gi - (ht/vht) lgi: 0, sgi: 1; (he) 0.8us: 0, 1.6us: 1, 3.2us: 2
+	 * ldpc - off: 0, on: 1
+	 * stbc - off: 0, on: 1
+	 * he_ltf - 1xltf: 0, 2xltf: 1, 4xltf: 2
+	 */
+	if (sscanf(buf, "%hhu %hhu %hhu %hhu %hhu %hhu %hhu %hhu",
+		   &phy->type, &phy->bw, &phy->nss, &phy->mcs, &gi,
+		   &phy->ldpc, &phy->stbc, &he_ltf) != 8) {
+		*field = RATE_PARAM_AUTO;
+		return 0;
+	}
+
+	/* the loop below runs to it: up to 160 MHz */
+	if (phy->bw > IEEE80211_STA_RX_BW_160)
+		return -EINVAL;
+
+	phy->ldpc = (phy->bw || phy->ldpc) * GENMASK(2, 0);
+	for (i = 0; i <= phy->bw; i++) {
+		phy->sgi |= gi << (i << sta->deflink.he_cap.has_he);
+		phy->he_ltf |= he_ltf << (i << sta->deflink.he_cap.has_he);
+	}
+	*field = RATE_PARAM_FIXED;
+
+	return 0;
+}
