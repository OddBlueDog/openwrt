+/* After a full reset mac80211 adds its stations again, drv_priv as it was,
+ * while a station's debugfs "ps" can be read (under msta->ps.lock): the
+ * re-add starts the record again under that lock, and doesn't initialise
+ * the lock again under the reader's feet.
+ */
+static void mt7915_main_test_sta_readd_ps_lock(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw2 = mt7915_main_test_hw2(dev);
+	struct mt7915_main_test_readd *r;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	bool waited;
+	int cpu;
+
+	r = kunit_kzalloc(test, sizeof(*r), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, r);
+	r->dev = dev;
+	r->vif = mt7915_main_test_ap(test, hw2, 1);
+	sta = mt7915_main_test_sta(test, r->vif, 1);
+	r->sta = sta;
+	msta = mt7915_main_test_msta(sta);
+	KUNIT_ASSERT_EQ(test, mt7915_mac_sta_add(&dev->mt76, r->vif, sta), 0);
+	msta->ps.dozing = true;
+	msta->ps.dozes = 3;
+
+	init_completion(&r->done);
+	INIT_WORK(&r->work, mt7915_main_test_readd_fn);
+	/* as mt76_reset_device() leaves it for mt76_sta_add() */
+	set_bit(MT_WCID_FLAG_RESET, &msta->wcid.flags);
+
+	/* a reader has the lock here, the re-add runs on another CPU */
+	spin_lock_bh(&msta->ps.lock);
+	cpu = cpumask_any_but(cpu_online_mask, smp_processor_id());
+	if (cpu >= nr_cpu_ids) {
+		spin_unlock_bh(&msta->ps.lock);
+		kunit_skip(test, "needs a second CPU");
+	}
+	queue_work_on(cpu, system_wq, &r->work);
+	mdelay(100);
+	waited = !completion_done(&r->done);
+	spin_unlock_bh(&msta->ps.lock);
+	flush_work(&r->work);
+
+	KUNIT_EXPECT_TRUE(test, waited);
+	KUNIT_EXPECT_TRUE(test, completion_done(&r->done));
+	KUNIT_EXPECT_EQ(test, r->ret, 0);
+	KUNIT_EXPECT_FALSE(test, msta->ps.dozing);
+	KUNIT_EXPECT_EQ(test, msta->ps.dozes, 0);
+	KUNIT_EXPECT_FALSE(test, spin_is_locked(&msta->ps.lock));
+	clear_bit(MT_WCID_FLAG_RESET, &msta->wcid.flags);
+}
