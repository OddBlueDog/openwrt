+static ssize_t mt7915_debugfs_test_teardown(struct mt7915_phy *phy,
+					    const char *line)
+{
+	struct wiphy *wiphy = phy->mt76->hw->wiphy;
+	char buf[32];
+	ssize_t ret;
+
+	strscpy(buf, line, sizeof(buf));
+	wiphy_lock(wiphy);
+	ret = mt7915_twt_teardown_handler(wiphy, NULL, buf, strlen(buf), phy);
+	wiphy_unlock(wiphy);
+	return ret;
+}
+
+/* twt_teardown: "<mac> <flow id|all>", the second word all of it ("allX"
+ * isn't "all"), checked before the station is looked up (under RCU: the
+ * write holds the wiphy lock, which isn't it).
+ */
+static void mt7915_debugfs_test_twt_teardown_parse(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_phy *phy;
+
+	dev = mt7915_init_test_device(test, MT7976_ONE_ADIE_DBDC, NULL);
+	phy = &dev->phy;
+	KUNIT_EXPECT_EQ(test, mt7915_debugfs_test_teardown(phy,
+			"02:00:00:00:00:01 allX"), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_debugfs_test_teardown(phy,
+			"02:00:00:00:00:01 8"), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_debugfs_test_teardown(phy,
+			"02:00:00:00:00:01 1x"), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_debugfs_test_teardown(phy,
+			"02:00:00:00:00:01"), -EINVAL);
+	/* well formed, no such station */
+	KUNIT_EXPECT_EQ(test, mt7915_debugfs_test_teardown(phy,
+			"02:00:00:00:00:01 all"), -ENOENT);
+	KUNIT_EXPECT_EQ(test, mt7915_debugfs_test_teardown(phy,
+			"02:00:00:00:00:01 7"), -ENOENT);
+}
+
+#ifdef MT7915_STA_DEBUGFS
+/* fixed_rate: a bandwidth up to 160 MHz, which the GI and LTF are repeated
+ * for (an out of range one looped for ever, the counter being a u8, or
+ * shifted past 32 bits); a line that isn't one asks for the firmware's
+ * rates.
+ */
+static void mt7915_debugfs_test_fixed_rate_parse(struct kunit *test)
+{
+	static const char * const bad[] = {
+		"8 4 2 7 1 1 0 1", "8 16 2 7 1 1 0 1", "8 32 2 7 1 1 0 1",
+		"8 255 2 7 1 1 0 1",
+	};
+	struct ieee80211_sta *sta;
+	struct sta_phy phy;
+	u32 field;
+	int i;
+
+	sta = kunit_kzalloc(test, sizeof(*sta) + sizeof(struct mt7915_sta),
+			    GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sta);
+
+	for (i = 0; i < ARRAY_SIZE(bad); i++)
+		KUNIT_EXPECT_EQ_MSG(test, mt7915_sta_fixed_rate_parse(sta,
+				    bad[i], &phy, &field), -EINVAL,
+				    "%s", bad[i]);
+
+	/* HE: two bits per width */
+	sta->deflink.he_cap.has_he = true;
+	KUNIT_ASSERT_EQ(test, mt7915_sta_fixed_rate_parse(sta,
+			"8 3 2 7 1 0 0 2", &phy, &field), 0);
+	KUNIT_EXPECT_EQ(test, field, RATE_PARAM_FIXED);
+	KUNIT_EXPECT_EQ(test, phy.bw, 3);
+	KUNIT_EXPECT_EQ(test, phy.sgi, 0x55);
+	KUNIT_EXPECT_EQ(test, phy.he_ltf, 0xaa);
+	KUNIT_EXPECT_EQ(test, phy.ldpc, 7);
+
+	/* VHT: one */
+	sta->deflink.he_cap.has_he = false;
+	KUNIT_ASSERT_EQ(test, mt7915_sta_fixed_rate_parse(sta,
+			"4 2 2 7 1 0 0 0", &phy, &field), 0);
+	KUNIT_EXPECT_EQ(test, phy.sgi, 0x7);
+
+	KUNIT_ASSERT_EQ(test, mt7915_sta_fixed_rate_parse(sta, "auto", &phy,
+			&field), 0);
+	KUNIT_EXPECT_EQ(test, field, RATE_PARAM_AUTO);
+}
+#endif
