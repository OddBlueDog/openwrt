+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 2);
+	KUNIT_EXPECT_EQ(test, phy->twt_counters.replaced, 0);
+
+	phy->twt_policy.max_flows = 2;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 11, 1024, 64, 0);
+	mt7915_mac_add_twt_setup(hw, mt7915_test_to_sta(a), twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ACCEPT);
+	KUNIT_EXPECT_EQ(test, a->twt.flow[0].exp, 11);
+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 2);
+	KUNIT_EXPECT_EQ(test, phy->twt_counters.replaced, 1);
+	phy->twt_policy.max_flows = 0;
+}
