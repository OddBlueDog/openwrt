+/* An 802.11 frame shorter than what's read of its header: not even a frame
+ * control, or a QoS data header cut before its QoS control (with four
+ * addresses that's at 30, not 24). A 10-byte ACK, all of its header, is
+ * fine.
+ */
+static void mt7915_test_rx_short_headers(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_test_frame f;
+	struct mt7915_test_rxd d;
+	struct sk_buff *skb;
+
+	mt7915_test_rxd_init(&d, 0, 0, true);
+	mt7915_test_qos_frame(&f, 0, 1, 0);
+	skb = mt7915_test_rx_skb(test, &d, &f, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), -EINVAL);
+	kfree_skb(skb);
+
+	skb = mt7915_test_rx_skb(test, &d, &f, 25);
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), -EINVAL);
+	kfree_skb(skb);
+
+	skb = mt7915_test_rx_skb(test, &d, &f, 26);
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	kfree_skb(skb);
+
+	mt7915_test_qos_frame(&f, IEEE80211_FCTL_FROMDS, 1, 0);
+	skb = mt7915_test_rx_skb(test, &d, &f, 26);
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), -EINVAL);
+	kfree_skb(skb);
+
+	skb = mt7915_test_rx_skb(test, &d, &f, 32);
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	kfree_skb(skb);
+
+	memset(&f, 0, sizeof(f));
+	f.hdr.frame_control = cpu_to_le16(IEEE80211_FTYPE_CTL |
+					  IEEE80211_STYPE_ACK);
+	skb = mt7915_test_rx_skb(test, &d, &f, 10);
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	kfree_skb(skb);
+}
+
+/* A non-QoS frame cut inside its header is no frame either. A CCMP
+ * fragment's header would get the CCMP header in front of what's there,
+ * its PN bytes then read as the frame control (0x88 here: QoS data, with
+ * sequence and QoS control 24 bytes on); a PS-Poll's or BAR's 16 bytes
+ * hold the address mt76_check_sta() reads.
+ */
+static void mt7915_test_rx_short_nonqos(struct kunit *test)
+{
+	static const u8 data[2] = { 0x08, 0x00 };
+	static const u8 pspoll[16] = { 0xa4, 0x00 };
+	static const u8 bar[2] = { 0x84, 0x00 };
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_test_rxd d;
+	struct sk_buff *skb;
+
+	mt7915_test_rxd_init(&d, 0, MT_RXD1_NORMAL_GROUP_1, true);
+	d.rxd[1] |= FIELD_PREP(MT_RXD1_NORMAL_SEC_MODE, MT_CIPHER_AES_CCMP);
+	d.rxd[2] |= MT_RXD2_NORMAL_FRAG;
+	/* PN bytes 5 and 4, which go first */
+	d.g1[0] = 0x00000088;
+	skb = mt7915_test_rx_skb(test, &d, data, sizeof(data));
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), -EINVAL);
+	kfree_skb(skb);
+
+	mt7915_test_rxd_init(&d, 0, 0, true);
+	skb = mt7915_test_rx_skb(test, &d, pspoll, 2);
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), -EINVAL);
+	kfree_skb(skb);
+
+	skb = mt7915_test_rx_skb(test, &d, bar, sizeof(bar));
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), -EINVAL);
+	kfree_skb(skb);
+
+	skb = mt7915_test_rx_skb(test, &d, pspoll, sizeof(pspoll));
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	kfree_skb(skb);
+}
