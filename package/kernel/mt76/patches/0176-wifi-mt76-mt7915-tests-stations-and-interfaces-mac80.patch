index 91c885df..f4c22f1e 100644
--- a/mt7915/tests/main-test.c
+++ b/mt7915/tests/main-test.c
@@ -19,6 +19,7 @@
 #include <kunit/static_stub.h>
 #include "fake.h"
 #include "../eeprom.h"
+#include "../../mt76_connac2_mac.h"
 #include "../../tests/wed-fake.h"
 
 struct mt7915_dev *mt7915_init_test_device(struct kunit *test, u32 sku,
@@ -316,12 +317,18 @@ static void mt7915_main_test_check_group(struct kunit *test,
 #undef ewma_avg_signal_add
 #define MT7915_MAIN_TEST_SDATA
 
