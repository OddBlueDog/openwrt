+/* A station interface's BSS info names its AP's station, which mac80211
+ * finds by the BSSID, as the BSS's wcid.
+ */
+static void mt7915_main_test_bss_info_sta(struct kunit *test)
+{
+	static const u8 ap[ETH_ALEN] = { 0x02, 0xaa, 0xbb, 0xcc, 0xdd, 0x02 };
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct bss_info_basic *basic;
+	struct ieee80211_vif *vif;
+	struct mt76_wcid *wcid;
+	struct sta_info *si;
+
+	vif = mt7915_main_test_sdata(test, hw, NL80211_IFTYPE_STATION, 1);
+	memcpy(vif->cfg.ap_addr, ap, ETH_ALEN);
+	vif->bss_conf.bssid = vif->cfg.ap_addr;
+	si = mt7915_main_test_mac80211_sta(test, hw, vif, ap);
+	wcid = (struct mt76_wcid *)si->sta.drv_priv;
+	mt7915_main_test_clear(fake);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_bss_info(&dev->phy, vif, true), 0);
+	basic = mt7915_main_test_tlv(mt76_test_find_msg(fake,
+			MCU_EXT_CMD(BSS_INFO_UPDATE)), BSS_INFO_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, basic);
+	KUNIT_EXPECT_EQ(test, basic->bmc_wcid_lo, wcid->idx & 0xff);
+	KUNIT_EXPECT_EQ(test, basic->bmc_wcid_hi, wcid->idx >> 8);
+}
