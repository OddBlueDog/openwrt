 	sdata->control_port_protocol = cpu_to_be16(ETH_P_PAE);
 	sdata->bss = &sdata->u.ap;
@@ -349,7 +356,7 @@ mt7915_main_test_sdata_ap(struct kunit *test, struct ieee80211_hw *hw, u8 id)
 	}
 
 	vif = &sdata->vif;
-	vif->type = NL80211_IFTYPE_AP;
+	vif->type = type;
