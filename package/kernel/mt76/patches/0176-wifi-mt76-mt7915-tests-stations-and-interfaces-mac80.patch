 	vif->addr[4] = 0x76;
 	vif->addr[5] = id;
@@ -366,6 +373,118 @@ mt7915_main_test_sdata_ap(struct kunit *test, struct ieee80211_hw *hw, u8 id)
 	KUNIT_ASSERT_EQ(test, mt7915_add_interface(hw, vif), 0);
 	return vif;
 }
