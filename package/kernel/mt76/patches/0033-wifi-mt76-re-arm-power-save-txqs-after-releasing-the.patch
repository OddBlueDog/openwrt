From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Sun, 18 Oct 2026 21:30:42 +0100
Subject: [PATCH] wifi: mt76: re-arm power-save txqs after releasing their
 airtime

With hardware PS buffering, mt76_txq_send_burst() holds back frames for
a station in power save while AQL airtime is pending, and the txq is
left unscheduled. The completion path re-armed the txq before
ieee80211_tx_status_ext() released the completed frame's airtime, and
the tx status (TXS) and status timeout paths, which release it for
frames with a packet id, never re-armed at all. The scheduler then saw
pending airtime again and dropped the txq, and the next buffered frame
waited for unrelated traffic.

Re-arm after the airtime has been released, on both paths.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tx.c | 47 ++++++++++++++++++++++++++++++++---------------
 1 file changed, 32 insertions(+), 15 deletions(-)

diff --git a/tx.c b/tx.c
index 05d73ac4..f5e7c683 100644
--- a/tx.c
+++ b/tx.c
@@ -36,6 +36,35 @@ mt76_tx_check_agg_ssn(struct ieee80211_sta *sta, struct sk_buff *skb)
 }
 EXPORT_SYMBOL_GPL(mt76_tx_check_agg_ssn);
 
+/*
+ * Re-arm the txqs of a power-save station after one of its frames completed.
+ * mt76_txq_send_burst() refuses to queue to a PS station while any AQL
+ * airtime is pending, and mt76_txq_schedule_list() then leaves the txq
+ * unscheduled, so this must run after ieee80211_tx_status_ext() released
+ * the frame's airtime, or the wakeup is lost.
+ */
+static void
+mt76_tx_ps_rearm(struct mt76_dev *dev, struct mt76_wcid *wcid)
+{
+	struct ieee80211_sta *sta;
+	struct ieee80211_hw *hw;
+	int i;
+
+	if (!wcid || !(dev->drv->drv_flags & MT_DRV_HW_PS_BUFFERING) ||
+	    !test_bit(MT_WCID_FLAG_PS, &wcid->flags))
+		return;
+
+	sta = wcid_to_sta(wcid);
+	if (!sta)
+		return;
+
+	hw = mt76_phy_hw(dev, wcid->phy_idx);
+	for (i = 0; i < ARRAY_SIZE(sta->txq); i++)
+		if (sta->txq[i])
+			ieee80211_schedule_txq(hw, sta->txq[i]);
+	mt76_worker_schedule(&dev->tx_worker);
+}
+
 void
 mt76_tx_status_lock(struct mt76_dev *dev, struct sk_buff_head *list)
 		   __acquires(&dev->status_lock)
@@ -80,6 +109,8 @@ mt76_tx_status_unlock(struct mt76_dev *dev, struct sk_buff_head *list)
 		spin_lock_bh(&dev->rx_lock);
 		ieee80211_tx_status_ext(hw, &status);
 		spin_unlock_bh(&dev->rx_lock);
+
+		mt76_tx_ps_rearm(dev, wcid);
 	}
 	rcu_read_unlock();
 }
@@ -275,21 +306,6 @@ void __mt76_tx_complete_skb(struct mt76_dev *dev, u16 wcid_idx, struct sk_buff *
 	wcid = __mt76_wcid_ptr(dev, wcid_idx);
 	mt76_tx_check_non_aql(dev, wcid, skb);
 
-	if (wcid && (dev->drv->drv_flags & MT_DRV_HW_PS_BUFFERING) &&
-	    test_bit(MT_WCID_FLAG_PS, &wcid->flags)) {
-		struct ieee80211_sta *sta = wcid_to_sta(wcid);
-
-		if (sta) {
-			struct ieee80211_hw *hw = mt76_phy_hw(dev, wcid->phy_idx);
-			int i;
-
-			for (i = 0; i < ARRAY_SIZE(sta->txq); i++)
-				if (sta->txq[i])
-					ieee80211_schedule_txq(hw, sta->txq[i]);
-			mt76_worker_schedule(&dev->tx_worker);
-		}
-	}
-
 #ifdef CONFIG_NL80211_TESTMODE
 	if (mt76_is_testmode_skb(dev, skb, &hw)) {
 		struct mt76_phy *phy = hw->priv;
@@ -317,6 +333,7 @@ void __mt76_tx_complete_skb(struct mt76_dev *dev, u16 wcid_idx, struct sk_buff *
 		spin_lock_bh(&dev->rx_lock);
 		ieee80211_tx_status_ext(hw, &status);
 		spin_unlock_bh(&dev->rx_lock);
+		mt76_tx_ps_rearm(dev, wcid);
 		goto out;
 	}
 
