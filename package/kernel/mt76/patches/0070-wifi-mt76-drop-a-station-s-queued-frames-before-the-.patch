From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Mon, 19 Oct 2026 17:52:06 +0100
Subject: [PATCH] wifi: mt76: drop a station's queued frames before the driver
 removes it

__mt76_sta_remove() let the driver release the station in the hardware
(dev->drv->sta_remove) before mt76_wcid_cleanup() took its wcid off the
phy's tx list and freed its pending frames. In between, the tx worker
could still send the station's pending frames on a wcid the firmware no
longer has.

Clean the wcid up first: under phy->tx_lock it leaves the tx list and its
frames are freed, so nothing more is sent for it once the driver tells
the hardware. mt7915's sta_remove only clears the WTBL admission counters
and takes the station off the poll lists, which doesn't depend on the
order.

mt76_test_sta_remove now puts the station on the tx list too and checks
that the driver's remove hook sees no frames and no tx list entry.

Ported from pesa1234/openwrt next-r4.12.0.rss.mtk,
9999-27-wifi-mt76-clean-up-station-wcid-before-sta-remove (Alexandr
Astrouski, submitted as openwrt/mt76 pull request 1125).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mac80211.c        |  4 ++--
 tests/core-test.c | 17 ++++++++++++++---
 2 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/mac80211.c b/mac80211.c
index b2c0da94..e8ea18d7 100644
--- a/mac80211.c
+++ b/mac80211.c
@@ -1661,11 +1661,11 @@ void __mt76_sta_remove(struct mt76_phy *phy, struct ieee80211_vif *vif,
 	for (i = 0; i < ARRAY_SIZE(wcid->aggr); i++)
 		mt76_rx_aggr_stop(dev, wcid, i);
 
+	mt76_wcid_cleanup(dev, wcid);
+
 	if (dev->drv->sta_remove)
 		dev->drv->sta_remove(dev, vif, sta);
 
-	mt76_wcid_cleanup(dev, wcid);
-
 	mt76_wcid_mask_clear(dev->wcid_mask, idx);
 	phy->num_sta--;
 }
diff --git a/tests/core-test.c b/tests/core-test.c
index 4344d823..372c369e 100644
--- a/tests/core-test.c
+++ b/tests/core-test.c
@@ -35,6 +35,7 @@ static struct {
 	struct ieee80211_vif *sta_vif;
 	struct ieee80211_sta *sta_sta;
 	int n_sta_remove;
+	bool sta_remove_queued;	/* frames still queued or tx list at remove */
 	int n_sta_event;
 	enum mt76_sta_event sta_ev;
 	int sta_event_ret;
@@ -102,8 +103,13 @@ static void mt76_test_drv_sta_remove(struct mt76_dev *dev,
 				     struct ieee80211_vif *vif,
 				     struct ieee80211_sta *sta)
 {
+	struct mt76_wcid *wcid = (struct mt76_wcid *)sta->drv_priv;
+
 	mt76_test_drv.n_sta_remove++;
 	mt76_test_drv.sta_sta = sta;
+	mt76_test_drv.sta_remove_queued = !skb_queue_empty(&wcid->tx_pending) ||
+					  !skb_queue_empty(&wcid->tx_offchannel) ||
+					  !list_empty(&wcid->tx_list);
 }
 
 static int mt76_test_sta_event(struct mt76_dev *dev, struct ieee80211_vif *vif,
@@ -2879,9 +2885,11 @@ static void mt76_test_sta_add_published(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, dev->phy.num_sta, 1);
 }
 
-/* Removing a station ends its rx BA sessions, lets the driver clean up,
- * drops its queued frames and frees its wcid index; the rx path loses it
- * before that, in pre_rcu_remove.
+/* Removing a station ends its rx BA sessions, drops its queued frames and
+ * takes it off the tx list (before the driver releases it in the
+ * hardware, so the tx worker can't send for it after that), lets the
+ * driver clean up and frees its wcid index; the rx path loses it before
+ * that, in pre_rcu_remove.
  */
 static void mt76_test_sta_remove(struct kunit *test)
 {
@@ -2903,6 +2911,7 @@ static void mt76_test_sta_remove(struct kunit *test)
 			ARRAY_SIZE(wcid->aggr) - 1, 100, 8), 0);
 	mutex_unlock(&dev->mutex);
 	skb_queue_tail(&wcid->tx_pending, mt76_test_skb(test, 32));
+	list_add_tail(&wcid->tx_list, &dev->phy.tx_list);
 
 	mt76_sta_pre_rcu_remove(dev->hw, vif, sta);
 	KUNIT_EXPECT_NULL(test, rcu_access_pointer(dev->wcid[9]));
@@ -2912,6 +2921,8 @@ static void mt76_test_sta_remove(struct kunit *test)
 					     IEEE80211_STA_NOTEXIST), 0);
 	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_remove, 1);
 	KUNIT_EXPECT_PTR_EQ(test, mt76_test_drv.sta_sta, sta);
+	KUNIT_EXPECT_FALSE(test, mt76_test_drv.sta_remove_queued);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->phy.tx_list));
 	KUNIT_EXPECT_NULL(test, rcu_access_pointer(wcid->aggr[2]));
 	KUNIT_EXPECT_NULL(test, rcu_access_pointer(wcid->aggr[0]));
 	KUNIT_EXPECT_NULL(test, rcu_access_pointer(
