+/* --- recovery ----------------------------------------------------------- */
+
+/* Holds the device's ordered workqueue: work queued on it after this stays
+ * pending, so tests can see what was queued without it running. When the
+ * test ends, the reset and dump work still pending are cancelled first.
+ */
+struct mt7915_test_wq_block {
+	struct work_struct work;
+	struct completion go;
+	struct mt7915_dev *dev;
+};
+
+static void mt7915_test_block_fn(struct work_struct *work)
+{
+	struct mt7915_test_wq_block *b;
+
+	b = container_of(work, struct mt7915_test_wq_block, work);
+	wait_for_completion(&b->go);
+}
+
+static void mt7915_test_unblock(void *data)
+{
+	struct mt7915_test_wq_block *b = data;
+
+	cancel_work_sync(&b->dev->reset_work);
+	cancel_work_sync(&b->dev->dump_work);
+	complete(&b->go);
+	flush_work(&b->work);
+}
+
+static void mt7915_test_block_wq(struct kunit *test, struct mt7915_dev *dev)
+{
+	struct mt7915_test_wq_block *b;
+
+	b = kunit_kzalloc(test, sizeof(*b), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	b->dev = dev;
+	INIT_WORK(&b->work, mt7915_test_block_fn);
+	init_completion(&b->go);
+	queue_work(dev->mt76.wq, &b->work);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_unblock, b), 0);
+}
+
+/* The irq tasklet's view of a firmware state change: what mt7915_reset()
+ * does for crashes, the SER handshake and nothing at all.
+ */
+static void mt7915_test_reset_events(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+
+	mt7915_test_block_wq(test, dev);
+
+	/* before the hardware is up, or during a full reset: ignored */
+	dev->recovery.state = MT_MCU_CMD_WM_WDT;
+	mt7915_reset(dev);
+	dev->recovery.hw_init_done = true;
+	dev->recovery.hw_full_reset = true;
+	mt7915_reset(dev);
+	KUNIT_EXPECT_FALSE(test, work_pending(&dev->dump_work));
+	KUNIT_EXPECT_FALSE(test, work_pending(&dev->reset_work));
+	KUNIT_EXPECT_FALSE(test, dev->recovery.restart);
+	dev->recovery.hw_full_reset = false;
+
+	/* firmware crash: dump, then full recovery; MCU interrupts off */
+	dev->mt76.mmio.irqmask = MT_INT_MCU_CMD | BIT(0);
+	mt7915_reset(dev);
+	KUNIT_EXPECT_TRUE(test, dev->recovery.restart);
+	KUNIT_EXPECT_TRUE(test, work_pending(&dev->dump_work));
+	KUNIT_EXPECT_FALSE(test, work_pending(&dev->reset_work));
+	KUNIT_EXPECT_EQ(test, dev->mt76.mmio.irqmask, BIT(0));
+	cancel_work_sync(&dev->dump_work);
+	dev->recovery.restart = false;
+
+	/* SER: the firmware stopped DMA; firmware commands must stop too */
+	dev->recovery.state = MT_MCU_CMD_STOP_DMA;
+	mt7915_reset(dev);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_MCU_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, work_pending(&dev->reset_work));
+	KUNIT_EXPECT_FALSE(test, work_pending(&dev->dump_work));
+	KUNIT_EXPECT_FALSE(test, dev->recovery.restart);
+	cancel_work_sync(&dev->reset_work);
+
+	/* a later handshake step: just wake the reset work */
+	clear_bit(MT76_MCU_RESET, &dev->mphy.state);
+	dev->recovery.state = MT_MCU_CMD_RESET_DONE;
+	mt7915_reset(dev);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_MCU_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, work_pending(&dev->reset_work));
+}
+
+/* The dump work (no coredump support built in) goes on to the reset. */
+static void mt7915_test_dump_work(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+
+	mt7915_test_block_wq(test, dev);
+	mt7915_mac_dump_work(&dev->dump_work);
+	KUNIT_EXPECT_TRUE(test, work_pending(&dev->reset_work));
+	KUNIT_EXPECT_FALSE(test, mutex_is_locked(&dev->dump_mutex));
+}
+
+/* Waiting for a SER handshake step returns as soon as the firmware reached
+ * it, and gives up (without waiting out the timeout) when it crashed.
+ */
+static void mt7915_test_wait_reset_state(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+
+	dev->recovery.state = MT_MCU_CMD_RESET_DONE;
+	KUNIT_EXPECT_TRUE(test, mt7915_wait_reset_state(dev,
+				MT_MCU_CMD_RESET_DONE));
+	dev->recovery.state = MT_MCU_CMD_WA_WDT;
+	KUNIT_EXPECT_FALSE(test, mt7915_wait_reset_state(dev,
+				 MT_MCU_CMD_RESET_DONE));
+	dev->recovery.state = MT_MCU_CMD_RESET_DONE | MT_MCU_CMD_WM_WDT;
+	KUNIT_EXPECT_FALSE(test, mt7915_wait_reset_state(dev,
+				 MT_MCU_CMD_RESET_DONE));
+}
+
+/* kernel/rcu/rcu.h, exported: removing a NAPI or registering a wiphy waits
+ * for RCU grace periods, slow in the test VM unless they're expedited
+ */
+void rcu_expedite_gp(void);
+void rcu_unexpedite_gp(void);
+
+/* The tx NAPI and a netdev for it, as mt7915_dma_init() sets them up. */
+struct mt7915_test_napi {
+	struct net_device *ndev;
+	struct mt7915_dev *dev;
+};
+
+static int mt7915_test_napi_poll(struct napi_struct *napi, int budget)
+{
+	napi_complete(napi);
+	return 0;
+}
+
+static void mt7915_test_napi_free(void *data)
+{
+	struct mt7915_test_napi *n = data;
+
+	napi_disable(&n->dev->mt76.tx_napi);
+	netif_napi_del(&n->dev->mt76.tx_napi);
+	free_netdev(n->ndev);
+	rcu_unexpedite_gp();
+}
+
+static void mt7915_test_napi(struct kunit *test, struct mt7915_dev *dev)
+{
+	struct mt7915_test_napi *n;
+
+	n = kunit_kzalloc(test, sizeof(*n), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, n);
+	n->dev = dev;
+	n->ndev = alloc_netdev_dummy(0);
+	KUNIT_ASSERT_NOT_NULL(test, n->ndev);
+	rcu_expedite_gp();
+	netif_napi_add_tx(n->ndev, &dev->mt76.tx_napi, mt7915_test_napi_poll);
+	napi_enable(&dev->mt76.tx_napi);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_napi_free, n), 0);
+}
+
+static bool mt7915_test_napi_enabled(struct napi_struct *napi)
+{
+	return !test_bit(NAPI_STATE_SCHED, &napi->state);
+}
+
+/* DMA queue ops that only count what a reset asks of the rings */
+static int mt7915_test_rx_cleanups, mt7915_test_ring_resets;
+
+static void mt7915_test_rx_cleanup(struct mt76_dev *mdev, struct mt76_queue *q)
+{
+	mt7915_test_rx_cleanups++;
+}
+
+static void mt7915_test_reset_q(struct mt76_dev *mdev, struct mt76_queue *q,
+				bool reset_idx)
+{
+	if (q && q->ndesc)
+		mt7915_test_ring_resets++;
+}
+
+static void mt7915_test_rx_reset(struct mt76_dev *mdev, enum mt76_rxq_id qid)
+{
+	mt7915_test_ring_resets++;
+}
+
+static const struct mt76_queue_ops mt7915_test_dma_ops = {
+	.tx_cleanup = mt7915_test_tx_cleanup,
+	.rx_cleanup = mt7915_test_rx_cleanup,
+	.reset_q = mt7915_test_reset_q,
+	.rx_reset = mt7915_test_rx_reset,
+};
+
+static void mt7915_test_rx_napi_free(void *data)
+{
+	struct mt7915_dev *dev = data;
+
+	napi_disable(&dev->mt76.napi[MT_RXQ_MAIN]);
+	netif_napi_del(&dev->mt76.napi[MT_RXQ_MAIN]);
+	dev->mt76.q_rx[MT_RXQ_MAIN].ndesc = 0;
+}
+
+/* The tx NAPI, plus a band 0 data ring (no descriptors: the ring ops are
+ * mt7915_test_dma_ops) with its NAPI, enabled as after DMA init.
+ */
+static void mt7915_test_rings(struct kunit *test, struct mt7915_dev *dev)
+{
+	mt7915_test_napi(test, dev);
+	dev->mt76.queue_ops = &mt7915_test_dma_ops;
+	mt7915_test_cleanups = 0;
+	mt7915_test_rx_cleanups = 0;
+	mt7915_test_ring_resets = 0;
+
+	netif_napi_add(dev->mt76.tx_napi.dev, &dev->mt76.napi[MT_RXQ_MAIN],
+		       mt7915_test_napi_poll);
+	napi_enable(&dev->mt76.napi[MT_RXQ_MAIN]);
+	dev->mt76.q_rx[MT_RXQ_MAIN].ndesc = 1;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_rx_napi_free, dev), 0);
+}
+
+/* The reset work with nothing to recover from does nothing. */
+static void mt7915_test_reset_work_idle(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	dev->recovery.state = MT_MCU_CMD_NORMAL_STATE;
+	mt7915_mac_reset_work(&dev->reset_work);
+	KUNIT_EXPECT_EQ(test, fake->n_wr, 0);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_FALSE(test, ieee80211_queue_stopped(dev->mt76.hw, 0));
+}
+
+/* SER handshake, the firmware crashing before it reset the DMA: the L1
+ * recovery is abandoned to the full recovery queued behind it. NAPI and
+ * the tx worker are re-enabled for it, but the reset flags and stopped
+ * queues stay. The firmware was told DMA stopped and nothing more.
+ */
+static void mt7915_test_reset_work_aborted(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_phy *phy1 = mt7915_test_band1(test, env);
+
+	mt7915_test_rings(test, dev);
+	mt7915_test_block_wq(test, dev);
+	dev->recovery.state = MT_MCU_CMD_STOP_DMA | MT_MCU_CMD_RESET_DONE |
+			      MT_MCU_CMD_WM_WDT;
+
+	mt7915_mac_reset_work(&dev->reset_work);
+
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_MCU_INT_EVENT),
+			MT_MCU_INT_EVENT_DMA_STOPPED);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_MCU_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_RESET, &phy1->mt76->state));
+	KUNIT_EXPECT_TRUE(test, ieee80211_queue_stopped(dev->mt76.hw, 0));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_napi_enabled(&dev->mt76.tx_napi));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_napi_enabled(
+			  &dev->mt76.napi[MT_RXQ_MAIN]));
+	/* the rings weren't touched */
+	KUNIT_EXPECT_EQ(test, mt7915_test_rx_cleanups, 0);
+	KUNIT_EXPECT_FALSE(test, mutex_is_locked(&dev->mt76.mutex));
+	/* the full recovery comes from the dump work, not from here */
+	KUNIT_EXPECT_FALSE(test, work_pending(&dev->reset_work));
+}
+
+/* sets the WDT bit once the driver told the firmware DMA stopped: the
+ * firmware crashes in the middle of the handshake
+ */
+struct mt7915_test_crash {
+	struct mt7915_dev *dev;
+	u32 event_reg;
+};
+
+static u32 mt7915_test_crash_hook(struct mt76_test_fake *fake, u32 addr,
+				  u32 val)
+{
+	struct mt7915_test_crash *c = fake->priv;
+
+	if (mt76_test_reg(fake, c->event_reg) == MT_MCU_INT_EVENT_DMA_STOPPED)
+		WRITE_ONCE(c->dev->recovery.state,
+			   c->dev->recovery.state | MT_MCU_CMD_WA_WDT);
+	return val;
+}
+
+/* SER handshake past RESET_DONE: DMA is stopped and its rings reset, every
+ * tx token is given back (their frames freed, tx unblocked) and the
+ * firmware told DMA is ready again. A crash then aborts the rest.
+ */
+static void mt7915_test_reset_work_dma_reset(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_test_crash crash = { .dev = dev };
+	struct sk_buff *skb;
+
+	mt7915_test_rings(test, dev);
+	mt7915_test_block_wq(test, dev);
+	mt7915_test_token(test, dev, 0, &skb);
+	env->q.blocked = true;
+	mt76_wr(dev, MT_WFDMA0_GLO_CFG, MT_WFDMA0_GLO_CFG_TX_DMA_EN |
+		MT_WFDMA0_GLO_CFG_RX_DMA_EN);
+
+	mt76_wr(dev, MT_MCU_INT_EVENT, 0);
+	crash.event_reg = fake->last_addr;
+	fake->priv = &crash;
+	fake->rr_hook = mt7915_test_crash_hook;
+	dev->recovery.state = MT_MCU_CMD_STOP_DMA | MT_MCU_CMD_RESET_DONE |
+			      MT_MCU_CMD_RECOVERY_DONE;
+
+	mt7915_mac_reset_work(&dev->reset_work);
+	fake->rr_hook = NULL;
+
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_MCU_INT_EVENT),
+			MT_MCU_INT_EVENT_DMA_INIT);
+	KUNIT_EXPECT_FALSE(test, mt76_rr(dev, MT_WFDMA0_GLO_CFG) &
+			   (MT_WFDMA0_GLO_CFG_TX_DMA_EN |
+			    MT_WFDMA0_GLO_CFG_RX_DMA_EN));
+	/* the rx ring was emptied and reset, the tx rings flushed */
+	KUNIT_EXPECT_EQ(test, mt7915_test_rx_cleanups, 1);
+	KUNIT_EXPECT_GE(test, mt7915_test_ring_resets, 2);
+	KUNIT_EXPECT_GT(test, mt7915_test_cleanups, 0);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb));
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 0);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&dev->mt76.token));
+	KUNIT_EXPECT_FALSE(test, env->q.blocked);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_napi_enabled(&dev->mt76.tx_napi));
+	KUNIT_EXPECT_FALSE(test, mutex_is_locked(&dev->mt76.mutex));
+	kfree_skb(skb);
+}
+
+/* the firmware's patch semaphore says "already downloaded" */
+static void mt7915_test_patch_dl_reply(struct mt76_test_fake *fake,
+				       const struct mt76_test_msg *msg,
+				       struct sk_buff *reply)
+{
+	if (msg->cmd == MCU_CMD(PATCH_SEM_CONTROL))
+		reply->data[sizeof(struct mt76_connac2_mcu_rxd) - 4] =
+			PATCH_IS_DL;
+}
+
+static void mt7915_test_vfree_action(void *p)
+{
+	vfree(p);
+}
+
+/* The SoC side of a WiFi subsystem reset: the glue's own register blocks
+ * (plain memory), and the states the reset and firmware download poll
+ * for. With @ack, a thread plays the bus acking sleep protection requests
+ * (clearing them) instead of letting the driver wait them out.
+ */
+struct mt7915_test_soc {
+	struct task_struct *ack;
+	void __iomem *dcm;
+};
+
+static int mt7915_test_soc_ack(void *data)
+{
+	struct mt7915_test_soc *soc = data;
+
+	while (!kthread_should_stop()) {
+		memset_io(soc->dcm, 0, 0x100);
+		usleep_range(100, 200);
+	}
+	return 0;
+}
+
+static void mt7915_test_soc_stop(void *data)
+{
+	struct mt7915_test_soc *soc = data;
+
+	kthread_stop(soc->ack);
+}
+
+static void mt7915_test_soc(struct kunit *test, struct mt7915_dev *dev,
+			    bool ack)
+{
+	struct mt7915_test_soc *soc;
+
+	dev->dcm = vzalloc(SZ_64K);
+	dev->sku = vzalloc(SZ_64K);
+	KUNIT_ASSERT_NOT_NULL(test, dev->dcm);
+	KUNIT_ASSERT_NOT_NULL(test, dev->sku);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_vfree_action, (void __force *)dev->dcm), 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_vfree_action, (void __force *)dev->sku), 0);
+	/* CONN_INFRA version of the MT7986, sleep protection ready, firmware
+	 * waiting for download
+	 */
+	mt76_wr(dev, MT_CONN_INFRA_BASE, 0x02070000);
+	mt76_wr(dev, MT_CONN_INFRA_WF_SLP_PROT_RDY, MT_CONN_INFRA_CONN);
+	mt76_wr(dev, MT_TOP_MISC, FIELD_PREP(MT_TOP_MISC_FW_STATE,
+					     FW_STATE_FW_DOWNLOAD));
+	mt76_wr(dev, MT_SWDEF_MODE, 0x5a);
+
+	if (!ack)
+		return;
+	soc = kunit_kzalloc(test, sizeof(*soc), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, soc);
+	soc->dcm = dev->dcm;
+	soc->ack = kthread_run(mt7915_test_soc_ack, soc, "mt7915-test-soc");
+	KUNIT_ASSERT_FALSE(test, IS_ERR(soc->ack));
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_soc_stop, soc), 0);
+}
+
+/* A full chip restart: tx stopped, tokens reclaimed, WFDMA and the WiFi
+ * subsystem reset and DMA restarted, then the firmware reloaded. Here the
+ * RAM firmware isn't there (no files in the test VM), so the restart
+ * fails; the reset flags are cleared and tx NAPI is back either way.
+ */
+static void mt7915_test_mac_restart(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_phy *phy1 = mt7915_test_band1(test, env);
+	struct sk_buff *skb;
+	int ret;
+
+	mt7915_test_rings(test, dev);
+	mt7915_test_soc(test, dev, false);
+	fake->reply = mt7915_test_patch_dl_reply;
+
+	mt7915_test_token(test, dev, 0, &skb);
+	set_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+	set_bit(MT76_RESET, &phy1->mt76->state);
+
+	mutex_lock(&dev->mt76.mutex);
+	ret = mt7915_mac_restart(dev);
+	mutex_unlock(&dev->mt76.mutex);
+
+	KUNIT_EXPECT_LT(test, ret, 0);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb));
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 0);
+	/* DMA re-enabled after the reset */
+	KUNIT_EXPECT_TRUE(test, mt76_rr(dev, MT_WFDMA0_GLO_CFG) &
+			  MT_WFDMA0_GLO_CFG_TX_DMA_EN);
+	/* firmware download started: normal mode, driver own, patch */
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_SWDEF_MODE), MT_SWDEF_NORMAL_MODE);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_CMD(PATCH_SEM_CONTROL)), 2);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_RESET, &phy1->mt76->state));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_MCU_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_MCU_RUNNING,
+					  &dev->mphy.state));
+	/* the band stays marked running for the next attempt */
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_RUNNING, &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_napi_enabled(&dev->mt76.tx_napi));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_napi_enabled(
+			  &dev->mt76.napi[MT_RXQ_MAIN]));
+	KUNIT_EXPECT_EQ(test, mt7915_test_rx_cleanups, 1);
+	kfree_skb(skb);
+}
+
+/* Plays the firmware crashing while the driver waits for the last SER
+ * step: once the driver reports RESET_DONE, the WDT bit is set and the
+ * waiter woken.
+ */
+struct mt7915_test_crash_later {
+	struct work_struct work;
+	struct mt76_test_fake *fake;
+	struct mt7915_dev *dev;
+	u32 event_reg;
+};
+
+static void mt7915_test_crash_later_fn(struct work_struct *work)
+{
+	struct mt7915_test_crash_later *c;
+	int i;
+
+	c = container_of(work, struct mt7915_test_crash_later, work);
+	for (i = 0; i < 2000; i++) {
+		if (mt76_test_reg(c->fake, c->event_reg) ==
+		    MT_MCU_INT_EVENT_RESET_DONE)
+			break;
+		usleep_range(100, 200);
+	}
+	WRITE_ONCE(c->dev->recovery.state,
+		   c->dev->recovery.state | MT_MCU_CMD_WM_WDT);
+	wake_up(&c->dev->reset_wait);
+}
+
+/* SER handshake with the firmware crashing at the last step, while the
+ * driver waits for it to return to normal: DMA was reset and the firmware
+ * told so, then the L1 recovery is abandoned.
+ */
+static void mt7915_test_reset_work_crash_late(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_test_crash_later c = { .fake = fake, .dev = dev };
+
+	mt7915_test_rings(test, dev);
+	mt7915_test_block_wq(test, dev);
+	mt76_wr(dev, MT_MCU_INT_EVENT, 0);
+	c.event_reg = fake->last_addr;
+	dev->recovery.state = MT_MCU_CMD_STOP_DMA | MT_MCU_CMD_RESET_DONE |
+			      MT_MCU_CMD_RECOVERY_DONE;
+	INIT_WORK_ONSTACK(&c.work, mt7915_test_crash_later_fn);
+	queue_work(system_unbound_wq, &c.work);
+
+	mt7915_mac_reset_work(&dev->reset_work);
+	flush_work(&c.work);
+	destroy_work_on_stack(&c.work);
+
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_MCU_INT_EVENT),
+			MT_MCU_INT_EVENT_RESET_DONE);
+	KUNIT_EXPECT_EQ(test, mt7915_test_rx_cleanups, 1);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_MCU_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_napi_enabled(&dev->mt76.tx_napi));
+	KUNIT_EXPECT_FALSE(test, mutex_is_locked(&dev->mt76.mutex));
+}
+
+/* --- with mac80211 ------------------------------------------------------ */
+
+static void mt7915_test_hw_unregister(void *data)
+{
+	struct mt7915_dev *dev = data;
+
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+	mt76_unregister_device(&dev->mt76);
+	rcu_unexpedite_gp();
+}
+
+/* mt7915_test_env() registered with mac80211 (one 5 GHz band, no
+ * interfaces): for the code that queues mac80211 work, which needs a
+ * registered hw.
+ */
+static struct mt7915_test_env *mt7915_test_hw_env(struct kunit *test)
+{
+	static const u8 addr[ETH_ALEN] = { 0x00, 0x0c, 0x43, 0x26, 0x60, 0x10 };
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	int ret;
+
+	ether_addr_copy(dev->mphy.macaddr, addr);
+	dev->mphy.cap.has_5ghz = true;
+	hw->queues = 4;
+	hw->vif_data_size = sizeof(struct mt7915_vif);
+	hw->sta_data_size = sizeof(struct mt7915_sta);
+	ieee80211_hw_set(hw, NO_AUTO_VIF);
+	/* no "add" uevent: OpenWrt's hotplug would try to set the radio up */
+	dev_set_uevent_suppress(&hw->wiphy->dev, true);
+
+	rcu_expedite_gp();
+	ret = mt76_register_device(&dev->mt76, true, mt76_rates,
+				   ARRAY_SIZE(mt76_rates));
+	if (ret)
+		rcu_unexpedite_gp();
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_hw_unregister, dev), 0);
+	/* registering pointed the phy at the new band's first channel */
+	dev->mphy.chandef.chan = &env->chan_5g;
+	dev->mphy.chan_state = &env->chan_state;
+
+	return env;
+}
+
+/* MU statistics answers: all zero, but complete */
+static void mt7915_test_muru_reply(struct mt76_test_fake *fake,
+				   const struct mt76_test_msg *msg,
+				   struct sk_buff *reply)
+{
+	if (msg->cmd == MCU_EXT_CMD(MURU_CTRL))
+		skb_put_zero(reply, sizeof(struct mt7915_mcu_muru_stats));
+	else
+		mt7915_test_mib_reply(fake, msg, reply);
+}
+
+/* The watchdog work, every 100 ms: channel survey each time; every 5th time
+ * the MIB counters, the rx-stuck checks and (when enabled) the MU stats.
+ * It always re-arms itself.
+ */
+static void mt7915_test_mac_work(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_hw_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	int i;
+
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+	fake->reply = mt7915_test_muru_reply;
+	mt76_wr(dev, MT_MIB_SDR3(0), 0x00070000);
+	mt76_wr(dev, MT_TRB_RXPSR0(0), 0x5);
+	dev->phy.omac_mask = BIT(0);
+	dev->muru_debug = true;
+
+	for (i = 1; i <= 4; i++) {
+		mt7915_mac_work(&dev->mphy.mac_work.work);
+		KUNIT_EXPECT_EQ(test, dev->mphy.mac_work_count, i);
+	}
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(GET_MIB_INFO)), 4);
+	KUNIT_EXPECT_EQ(test, dev->phy.mib.fcs_err_cnt, 0);
+	KUNIT_EXPECT_EQ(test, dev->phy.trb_ts, 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(MURU_CTRL)), 0);
+	/* re-armed */
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&dev->mphy.mac_work));
+
+	mt7915_mac_work(&dev->mphy.mac_work.work);
+	KUNIT_EXPECT_EQ(test, dev->mphy.mac_work_count, 0);
+	KUNIT_EXPECT_EQ(test, dev->phy.mib.fcs_err_cnt, 7);
+	KUNIT_EXPECT_EQ(test, dev->phy.trb_ts, 0x5);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(MURU_CTRL)), 1);
+	KUNIT_EXPECT_EQ(test, env->chan_state.cc_busy, 1000);
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&dev->mphy.mac_work));
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+}
+
+/* A complete SER (L1) recovery: DMA stopped and reset, tokens reclaimed,
+ * each handshake step reported, DMA and interrupts back on, the reset
+ * flags cleared, NAPI and the queues running again, beacons refreshed and
+ * both bands' watchdogs re-armed.
+ */
+static void mt7915_test_reset_work_ser(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_hw_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_phy *phy1 = mt7915_test_band1(test, env);
+	struct sk_buff *skb;
+
+	mt7915_test_rings(test, dev);
+	mt7915_test_token(test, dev, 0, &skb);
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+	dev->recovery.state = MT_MCU_CMD_STOP_DMA | MT_MCU_CMD_RESET_DONE |
+			      MT_MCU_CMD_RECOVERY_DONE |
+			      MT_MCU_CMD_NORMAL_STATE;
+	dev->mt76.mmio.irqmask = 0;
+
+	mt7915_mac_reset_work(&dev->reset_work);
+
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_MCU_INT_EVENT),
+			MT_MCU_INT_EVENT_RESET_DONE);
+	KUNIT_EXPECT_TRUE(test, mt76_rr(dev, MT_WFDMA0_GLO_CFG) &
+			  MT_WFDMA0_GLO_CFG_TX_DMA_EN);
+	KUNIT_EXPECT_TRUE(test, dev->mt76.mmio.irqmask & MT_INT_MCU_CMD);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb));
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 0);
+	KUNIT_EXPECT_EQ(test, mt7915_test_rx_cleanups, 1);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_MCU_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_RESET, &phy1->mt76->state));
+	KUNIT_EXPECT_FALSE(test, ieee80211_queue_stopped(dev->mt76.hw, 0));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_napi_enabled(&dev->mt76.tx_napi));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_napi_enabled(
+			  &dev->mt76.napi[MT_RXQ_MAIN]));
+	KUNIT_EXPECT_FALSE(test, mutex_is_locked(&dev->mt76.mutex));
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&dev->mphy.mac_work));
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&phy1->mt76->mac_work));
+	cancel_delayed_work_sync(&phy1->mt76->mac_work);
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+	kfree_skb(skb);
+}
+
+/* A firmware crash: full recovery. The MCU watchdog interrupts are off
+ * while the chip restarts (here every attempt fails, the firmware can't
+ * be loaded), then everything the firmware knew is forgotten: interfaces'
+ * MAC slots, radar detector state, stations, TWT agreements, rate control
+ * updates; the global entry is set up again, the recovery state cleared,
+ * mac80211 asked to restore its configuration and the watchdog re-armed.
+ */
+static void mt7915_test_full_reset(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_hw_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_phy *phy1 = mt7915_test_band1(test, env);
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 9, mvif);
+	u16 global = dev->mt76.global_wcid.idx;
+
+	mt7915_test_rings(test, dev);
+	mt7915_test_soc(test, dev, true);
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+
+	dev->phy.omac_mask = BIT(1);
+	phy1->omac_mask = BIT(2);
+	dev->mphy.dfs_state = MT_DFS_STATE_ACTIVE;
+	phy1->mt76->dfs_state = MT_DFS_STATE_CAC;
+	mt7915_test_twt_link(dev, msta, 0, 0);
+	list_add_tail(&msta->rc_list, &dev->sta_rc_list);
+	dev->recovery.hw_init_done = true;
+	dev->recovery.restart = true;
+	dev->recovery.state = MT_MCU_CMD_WM_WDT;
+	dev->mt76.mmio.irqmask = 0;
+
+	mt7915_mac_reset_work(&dev->reset_work);
+
+	KUNIT_EXPECT_EQ(test, dev->recovery.wm_reset_count, 1);
+	KUNIT_EXPECT_EQ(test, dev->recovery.wa_reset_count, 0);
+	/* ten attempts, each through the patch semaphore */
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_CMD(PATCH_SEM_CONTROL)), 2 * 10);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WFDMA0_MCU_HOST_INT_ENA) &
+			MT_MCU_CMD_WDT_MASK, MT_MCU_CMD_WDT_MASK);
+	KUNIT_EXPECT_TRUE(test, dev->mt76.mmio.irqmask & MT_INT_MCU_CMD);
+
+	KUNIT_EXPECT_EQ(test, dev->phy.omac_mask, 0);
+	KUNIT_EXPECT_EQ(test, phy1->omac_mask, 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.dfs_state, MT_DFS_STATE_UNKNOWN);
+	KUNIT_EXPECT_EQ(test, phy1->mt76->dfs_state, MT_DFS_STATE_UNKNOWN);
+	KUNIT_EXPECT_NULL(test, rcu_access_pointer(dev->mt76.wcid[9]));
+	KUNIT_EXPECT_FALSE(test, msta->wcid.sta);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->twt_list));
+	KUNIT_EXPECT_EQ(test, msta->twt.flowid_mask, 0);
+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->sta_rc_list));
+	/* the global entry: first free WTBL index again, as at init */
+	KUNIT_EXPECT_NE(test, global, 0);
+	KUNIT_EXPECT_EQ(test, dev->mt76.global_wcid.idx, 0);
+	KUNIT_EXPECT_PTR_EQ(test, rcu_access_pointer(dev->mt76.wcid[0]),
+			    &dev->mt76.global_wcid);
+	KUNIT_EXPECT_TRUE(test, dev->mt76.wcid_mask[0] & BIT(0));
+
+	KUNIT_EXPECT_EQ(test, dev->recovery.state, MT_MCU_CMD_NORMAL_STATE);
+	KUNIT_EXPECT_FALSE(test, dev->recovery.restart);
+	KUNIT_EXPECT_FALSE(test, dev->recovery.hw_full_reset);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_MCU_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_FALSE(test, mutex_is_locked(&dev->mt76.mutex));
+}
