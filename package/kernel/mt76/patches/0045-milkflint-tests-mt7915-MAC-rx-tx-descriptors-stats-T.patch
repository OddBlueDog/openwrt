+/* Interframe timing for 5 GHz, with the coverage class stretching the CCA
+ * and PLCP timeouts by 3 us per class: SIFS 10 us on the MT7986, 24M for
+ * CF-End, no CCK EIFS. Tx/rx are paused around the update and resumed.
+ */
+static void mt7915_test_set_timing_5g(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	unsigned int n_wr;
+
+	dev->phy.coverage_class = 2;
+	dev->phy.slottime = 9;
+	mt76_wr(dev, MT_TMAC_ICR1(0), 0x5a5a);
+	mt76_wr(dev, MT_AGG_ACR0(0), BIT(20));
+	mt76_wr(dev, MT_ARB_SCR(0), BIT(0));
+
+	mt7915_mac_set_timing(&dev->phy);
+
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TMAC_CDTR(0)),
+			FIELD_PREP(MT_TIMEOUT_VAL_PLCP, 231 + 6) |
+			FIELD_PREP(MT_TIMEOUT_VAL_CCA, 48 + 6));
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TMAC_ODTR(0)),
+			FIELD_PREP(MT_TIMEOUT_VAL_PLCP, 60 + 6) |
+			FIELD_PREP(MT_TIMEOUT_VAL_CCA, 28 + 6));
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TMAC_ICR0(0)),
+			FIELD_PREP(MT_IFS_EIFS_OFDM, 84) |
+			FIELD_PREP(MT_IFS_RIFS, 2) |
+			FIELD_PREP(MT_IFS_SIFS, 10) |
+			FIELD_PREP(MT_IFS_SLOT, 9));
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TMAC_ICR1(0)), 0x5a5a);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_AGG_ACR0(0)),
+			BIT(20) | MT7915_CFEND_RATE_DEFAULT);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_ARB_SCR(0)), BIT(0));
+
+	/* a band that isn't up is left alone */
+	clear_bit(MT76_STATE_RUNNING, &dev->mphy.state);
+	n_wr = fake->n_wr;
+	mt7915_mac_set_timing(&dev->phy);
+	KUNIT_EXPECT_EQ(test, fake->n_wr, n_wr);
+}
+
+/* 2.4 GHz: CCK EIFS, the shorter OFDM EIFS, and CF-End at 11M CCK when the
+ * long slot is in use.
+ */
+static void mt7915_test_set_timing_2g(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+
+	dev->mphy.chandef.chan = &env->chan_2g;
+	dev->phy.slottime = 20;
+	mt7915_mac_set_timing(&dev->phy);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TMAC_ICR1(0)),
+			FIELD_PREP(MT_IFS_EIFS_CCK, 314));
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TMAC_ICR0(0)),
+			FIELD_PREP(MT_IFS_EIFS_OFDM, 78) |
+			FIELD_PREP(MT_IFS_RIFS, 2) |
+			FIELD_PREP(MT_IFS_SIFS, 10) |
+			FIELD_PREP(MT_IFS_SLOT, 20));
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_AGG_ACR0(0)),
+			MT7915_CFEND_RATE_11B);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TMAC_CDTR(0)),
+			FIELD_PREP(MT_TIMEOUT_VAL_PLCP, 231) |
+			FIELD_PREP(MT_TIMEOUT_VAL_CCA, 48));
+
+	/* short slot: OFDM CF-End again */
+	dev->phy.slottime = 9;
+	mt7915_mac_set_timing(&dev->phy);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_AGG_ACR0(0)),
+			MT7915_CFEND_RATE_DEFAULT);
+}
