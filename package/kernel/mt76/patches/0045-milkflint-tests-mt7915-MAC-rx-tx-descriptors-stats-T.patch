+/* On the MT7915 the detector's antenna selection is set after starting it
+ * and when going back to normal rx: both chains on a DBDC card (2), all
+ * of them otherwise (0). Its failure is reported too.
+ */
+static void mt7915_test_dfs_mt7915(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env_chip(test, 0x7915);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_test_fail_at f;
+
+	mt7915_test_dfs_setup(env, NL80211_DFS_ETSI);
+	dev->dbdc_support = true;
+	KUNIT_ASSERT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 23);
+	mt7915_test_expect_rdd(test, 19, RDD_START, 0);
+	mt7915_test_expect_rdd(test, 20, RDD_SET_WF_ANT, 2);
+	mt7915_test_expect_rdd(test, 21, RDD_DET_MODE, 1);
+
+	dev->mt76.region = NL80211_DFS_UNSET;
+	dev->dbdc_support = false;
+	KUNIT_ASSERT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 26);
+	mt7915_test_expect_rdd(test, 23, RDD_NORMAL_START, 0);
+	mt7915_test_expect_rdd(test, 24, RDD_SET_WF_ANT, 0);
+	mt7915_test_expect_rdd(test, 25, RDD_STOP, 0);
+
+	fake->priv = &f;
+	fake->reply = mt7915_test_fail_reply;
+	/* the antenna setting fails, starting and stopping */
+	dev->mt76.region = NL80211_DFS_ETSI;
+	dev->mphy.dfs_state = MT_DFS_STATE_UNKNOWN;
+	f.at = fake->n_msgs + 21;
+	KUNIT_EXPECT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), -EIO);
+	fake->mcu_ret = 0;
+
+	dev->mphy.dfs_state = MT_DFS_STATE_ACTIVE;
+	dev->mt76.region = NL80211_DFS_UNSET;
+	f.at = fake->n_msgs + 2;
+	KUNIT_EXPECT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), -EIO);
+	KUNIT_EXPECT_EQ(test, dev->mphy.dfs_state, MT_DFS_STATE_ACTIVE);
+	fake->mcu_ret = 0;
+}
