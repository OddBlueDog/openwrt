+/* The noise floor is the IRPI histogram's average over the band's chains,
+ * smoothed (x16) in phy->noise and reported negated; an empty histogram
+ * leaves it as it was. The airtime counters are refreshed alongside.
+ */
+static void mt7915_test_update_channel_noise(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_test_irpi *irpi;
+	struct mt76_test_msg *msg;
+
+	irpi = kunit_kzalloc(test, sizeof(*irpi), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, irpi);
+	fake->priv = irpi;
+	fake->rr_hook = mt7915_test_irpi_hook;
+	fake->reply = mt7915_test_mib_reply;
+	dev->mphy.chainmask = 0x3;
+
+	/* chain 0: 10 x -86 dBm, chain 1: 30 x -80 dBm; chains 2/3 unused */
+	irpi->count[0][2] = 10;
+	irpi->count[1][4] = 30;
+	irpi->count[2][0] = 1000;
+	mt7915_update_channel(&dev->mphy);
+	KUNIT_EXPECT_EQ(test, dev->phy.noise, 81 << 4);
+	KUNIT_EXPECT_EQ(test, env->chan_state.noise, -81);
+
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(GET_MIB_INFO));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, env->chan_state.cc_tx, 200);
+	KUNIT_EXPECT_EQ(test, env->chan_state.cc_rx, 300 + 400);
+	KUNIT_EXPECT_EQ(test, env->chan_state.cc_busy, 100 + 200 + 300 + 400);
+
+	/* nothing measured */
+	memset(irpi->count, 0, sizeof(irpi->count));
+	mt7915_update_channel(&dev->mphy);
+	KUNIT_EXPECT_EQ(test, dev->phy.noise, 81 << 4);
+
+	/* -60 dBm: the average moves by 1/16 of the difference */
+	irpi->count[0][8] = 5;
+	mt7915_update_channel(&dev->mphy);
+	KUNIT_EXPECT_EQ(test, dev->phy.noise, (81 << 4) + 60 - 81);
+	KUNIT_EXPECT_EQ(test, env->chan_state.noise, -79);
+}
