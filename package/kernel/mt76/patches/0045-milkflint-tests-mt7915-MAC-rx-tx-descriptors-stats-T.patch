+/* --- rx: mt7915_mac_fill_rx() ------------------------------------------- */
+
+/* An HE frame from a station: rate, streams, width, GI, coding and per-chain
+ * signal come from the P-RXV, the frame is handed on with the descriptor
+ * and the hardware's header padding stripped, and the station gets polled.
+ */
+static void mt7915_test_rx_he_frame(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 5, NULL);
+	struct mt7915_test_frame f;
+	struct mt7915_test_rxd d;
+	struct mt76_rx_status *s;
+	struct sk_buff *skb;
+
+	mt7915_test_qos_frame(&f, 0, 0x123, 5);
+	mt7915_test_rxd_init(&d, 5, MT_RXD1_NORMAL_GROUP_3, true);
+	d.rxd[0] |= MT_RXD0_NORMAL_IP_SUM | MT_RXD0_NORMAL_UDP_TCP_SUM;
+	d.rxd[2] |= FIELD_PREP(MT_RXD2_NORMAL_HDR_OFFSET, 1);
+	d.g3[0] = mt7915_test_prxv0(MT_PHY_TYPE_HE_SU, 7, 1,
+				    IEEE80211_STA_RX_BW_80, 1) |
+		  MT_PRXV_HT_AD_CODE;
+	/* RCPI = 2 * (dBm + 110) */
+	d.g3[1] = mt7915_test_rcpi(96, 88, 80, 72);
+
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	s = (struct mt76_rx_status *)skb->cb;
+
+	KUNIT_EXPECT_EQ(test, (int)s->phy_idx, 0);
+	KUNIT_EXPECT_EQ(test, (int)s->band, NL80211_BAND_5GHZ);
+	KUNIT_EXPECT_EQ(test, s->freq, 5180);
+	KUNIT_EXPECT_EQ(test, (int)s->encoding, RX_ENC_HE);
+	KUNIT_EXPECT_EQ(test, s->rate_idx, 7);
+	KUNIT_EXPECT_EQ(test, (int)s->nss, 2);
+	KUNIT_EXPECT_EQ(test, (int)s->bw, RATE_INFO_BW_80);
+	KUNIT_EXPECT_EQ(test, (int)s->he_gi, NL80211_RATE_INFO_HE_GI_1_6);
+	KUNIT_EXPECT_TRUE(test, s->enc_flags & RX_ENC_FLAG_LDPC);
+	KUNIT_EXPECT_EQ(test, s->chains, 0xf);
+	KUNIT_EXPECT_EQ(test, s->chain_signal[0], -62);
+	KUNIT_EXPECT_EQ(test, s->chain_signal[1], -66);
+	KUNIT_EXPECT_EQ(test, s->chain_signal[2], -70);
+	KUNIT_EXPECT_EQ(test, s->chain_signal[3], -74);
+	/* not part of an A-MPDU, no timestamp group */
+	KUNIT_EXPECT_FALSE(test, s->flag & (RX_FLAG_AMPDU_DETAILS |
+					    RX_FLAG_MACTIME_START |
+					    RX_FLAG_DECRYPTED | RX_FLAG_8023));
+	KUNIT_EXPECT_EQ(test, (int)skb->ip_summed, CHECKSUM_UNNECESSARY);
+
+	KUNIT_EXPECT_PTR_EQ(test, s->wcid, &msta->wcid);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_polled(dev, &msta->wcid));
+	KUNIT_EXPECT_TRUE(test, s->aggr);
+	KUNIT_EXPECT_EQ(test, s->qos_ctl, 5);
+	KUNIT_EXPECT_EQ(test, s->seqno, 0x123);
+
+	KUNIT_ASSERT_EQ(test, skb->len, sizeof(f));
+	KUNIT_EXPECT_EQ(test, memcmp(skb->data, &f, sizeof(f)), 0);
+	kfree_skb(skb);
+}
