+/* The flags mac80211 needs to judge a frame: FCS and MIC failures, ICV
+ * errors (monitor only) and the checksum offload result.
+ */
+static void mt7915_test_rx_error_flags(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_test_frame f;
+	struct mt7915_test_rxd d;
+	struct mt76_rx_status *s;
+	struct sk_buff *skb;
+
+	mt7915_test_qos_frame(&f, 0, 1, 0);
+	mt7915_test_rxd_init(&d, 0, 0, true);
+	d.rxd[1] |= MT_RXD1_NORMAL_FCS_ERR | MT_RXD1_NORMAL_TKIP_MIC_ERR |
+		    MT_RXD1_NORMAL_ICV_ERR;
+	d.rxd[0] |= MT_RXD0_NORMAL_IP_SUM | MT_RXD0_NORMAL_UDP_TCP_SUM;
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	/* the DMA layer reports a checksum error in cb */
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, BIT(0)), 0);
+	s = (struct mt76_rx_status *)skb->cb;
+	KUNIT_EXPECT_TRUE(test, s->flag & RX_FLAG_FAILED_FCS_CRC);
+	KUNIT_EXPECT_TRUE(test, s->flag & RX_FLAG_MMIC_ERROR);
+	KUNIT_EXPECT_TRUE(test, s->flag & RX_FLAG_ONLY_MONITOR);
+	KUNIT_EXPECT_NE(test, (int)skb->ip_summed, CHECKSUM_UNNECESSARY);
+	kfree_skb(skb);
+
+	/* only the IP checksum was checked */
+	mt7915_test_rxd_init(&d, 0, 0, true);
+	d.rxd[0] |= MT_RXD0_NORMAL_IP_SUM;
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	s = (struct mt76_rx_status *)skb->cb;
+	KUNIT_EXPECT_EQ(test, s->flag, 0);
+	KUNIT_EXPECT_NE(test, (int)skb->ip_summed, CHECKSUM_UNNECESSARY);
+	kfree_skb(skb);
+}
