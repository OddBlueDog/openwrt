+	fake->rr_hook = NULL;
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WF_PHY_RXTD12_MT7916(1)),
+			MT_WF_PHY_RXTD12_IRPI_SW_CLR_ONLY |
+			MT_WF_PHY_RXTD12_IRPI_SW_CLR);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WF_PHY_RX_CTRL1_MT7916(1)),
+			FIELD_PREP(MT_WF_PHY_RX_CTRL1_IPI_EN, 0x5));
+}
