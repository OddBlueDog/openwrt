+/* A translated frame the PPE (hardware NAT) marked, from a WED rx ring, is
+ * handed to the PPE check with the receiving interface's netdev; unmarked
+ * frames and frames from other rings aren't.
+ */
+static void mt7915_test_rx_wed_ppe(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct net_device *ndev = (struct net_device *)env;
+	struct mt7915_test_rxd d;
+	struct wireless_dev *wdev;
+	struct ieee80211_vif *vif;
+	struct mt7915_vif *mvif;
+	struct sk_buff *skb;
+	u8 *buf;
+
+	/* mac80211 keeps the wdev in front of the vif: give it room */
+	buf = vzalloc(SZ_256K);
+	KUNIT_ASSERT_NOT_NULL(test, buf);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_vfree_buf, buf), 0);
+	vif = (struct ieee80211_vif *)(buf + SZ_128K + SZ_64K);
+	wdev = ieee80211_vif_to_wdev(vif);
+	if ((u8 *)wdev < buf || (u8 *)(wdev + 1) > (u8 *)vif)
+		kunit_skip(test, "no room for mac80211's interface data");
+	wdev->netdev = ndev;
+	vif->type = NL80211_IFTYPE_AP;
+	mvif = (struct mt7915_vif *)vif->drv_priv;
+	mvif->phy = &dev->phy;
+	mt7915_test_sta(test, dev, 9, mvif);
+
+	mt7915_test_rxd_init(&d, 9, 0, true);
+	d.rxd[2] |= MT_RXD2_NORMAL_HDR_TRANS;
+
+	/* not a WED ring */
+	skb = mt7915_test_rx_skb(test, &d, mt7915_test_frame_eth,
+				 sizeof(mt7915_test_frame_eth));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx_info(dev, skb, 0,
+				MT_DMA_INFO_PPE_VLD), 0);
+	KUNIT_EXPECT_NULL(test, skb->dev);
+	kfree_skb(skb);
+
+	dev->mt76.q_rx[MT_RXQ_MAIN].flags = MT_WED_Q_RX(0);
+	skb = mt7915_test_rx_skb(test, &d, mt7915_test_frame_eth,
+				 sizeof(mt7915_test_frame_eth));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx_info(dev, skb, 0, 0), 0);
+	KUNIT_EXPECT_NULL(test, skb->dev);
+	kfree_skb(skb);
+
+	skb = mt7915_test_rx_skb(test, &d, mt7915_test_frame_eth,
+				 sizeof(mt7915_test_frame_eth));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx_info(dev, skb, 0,
+				MT_DMA_INFO_PPE_VLD |
+				FIELD_PREP(MT_DMA_PPE_ENTRY, 0x123)), 0);
+	KUNIT_EXPECT_PTR_EQ(test, skb->dev, ndev);
+	KUNIT_EXPECT_TRUE(test, ((struct mt76_rx_status *)skb->cb)->flag &
+			  RX_FLAG_8023);
+	skb->dev = NULL;
+	kfree_skb(skb);
+	dev->mt76.q_rx[MT_RXQ_MAIN].flags = 0;
+}
