+/* Subframes of one A-MPDU share a timestamp and so a reference number; the
+ * next A-MPDU gets a new one, never 0, which means "no A-MPDU".
+ */
+static void mt7915_test_rx_ampdu_ref(struct kunit *test)
+{
+	static const struct {
+		u32 ts;
+		bool ampdu;
+		u32 ref;
+	} rx[] = {
+		{ 1000, true, 1 }, { 1000, true, 1 }, { 2000, true, 2 },
+		{ 3000, false, 0 }, { 2000, true, 2 }, { 4000, true, 3 },
+	};
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_test_frame f;
+	struct mt7915_test_rxd d;
+	struct mt76_rx_status *s;
+	struct sk_buff *skb;
+	int i;
+
+	mt7915_test_qos_frame(&f, 0, 1, 0);
+	for (i = 0; i < ARRAY_SIZE(rx); i++) {
+		mt7915_test_rxd_init(&d, 0, MT_RXD1_NORMAL_GROUP_2, true);
+		if (rx[i].ampdu)
+			d.rxd[2] &= ~MT_RXD2_NORMAL_NON_AMPDU;
+		d.g2[0] = rx[i].ts;
+		skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+		KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+		s = (struct mt76_rx_status *)skb->cb;
+		KUNIT_EXPECT_EQ(test, s->timestamp, rx[i].ts);
+		KUNIT_EXPECT_TRUE(test, s->flag & RX_FLAG_MACTIME_START);
+		KUNIT_EXPECT_EQ(test, !!(s->flag & RX_FLAG_AMPDU_DETAILS),
+				rx[i].ampdu);
+		KUNIT_EXPECT_EQ(test, s->ampdu_ref, rx[i].ref);
+		/* no station: nothing to reorder */
+		KUNIT_EXPECT_NULL(test, s->wcid);
+		KUNIT_EXPECT_FALSE(test, s->aggr);
+		kfree_skb(skb);
+	}
+
+	/* the counter wraps around 0 */
+	dev->phy.ampdu_ref = U32_MAX;
+	mt7915_test_rxd_init(&d, 0, MT_RXD1_NORMAL_GROUP_2, true);
+	d.rxd[2] &= ~MT_RXD2_NORMAL_NON_AMPDU;
+	d.g2[0] = 5000;
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	s = (struct mt76_rx_status *)skb->cb;
+	KUNIT_EXPECT_EQ(test, s->ampdu_ref, 1);
+	kfree_skb(skb);
+}
+
+/* Legacy rates are looked up in the band's bitrate table: OFDM 24M on
+ * 2.4 GHz is entry 8 (after the four CCK rates), short-preamble CCK 2M is
+ * entry 1. HT rates past MCS 31 are rejected.
+ */
+static void mt7915_test_rx_legacy_rates(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_test_frame f;
+	struct mt7915_test_rxd d;
+	struct mt76_rx_status *s;
+	struct sk_buff *skb;
+
+	dev->mphy.chandef.chan = &env->chan_2g;
+	mt7915_test_qos_frame(&f, 0, 1, 0);
+
+	mt7915_test_rxd_init(&d, 0, MT_RXD1_NORMAL_GROUP_3, true);
+	d.g3[0] = mt7915_test_prxv0(MT_PHY_TYPE_OFDM, 9, 0, 0, 0);
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	s = (struct mt76_rx_status *)skb->cb;
+	KUNIT_EXPECT_EQ(test, (int)s->band, NL80211_BAND_2GHZ);
+	KUNIT_EXPECT_EQ(test, s->freq, 2412);
+	KUNIT_EXPECT_EQ(test, (int)s->encoding, RX_ENC_LEGACY);
+	KUNIT_EXPECT_EQ(test, s->rate_idx, 8);
+	KUNIT_EXPECT_EQ(test, mt76_rates[s->rate_idx].bitrate, 240);
+	kfree_skb(skb);
+
+	mt7915_test_rxd_init(&d, 0, MT_RXD1_NORMAL_GROUP_3, true);
+	d.g3[0] = mt7915_test_prxv0(MT_PHY_TYPE_CCK, 1 | BIT(2), 0, 0, 0);
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	s = (struct mt76_rx_status *)skb->cb;
+	KUNIT_EXPECT_EQ(test, s->rate_idx, 1);
+	kfree_skb(skb);
+
+	mt7915_test_rxd_init(&d, 0, MT_RXD1_NORMAL_GROUP_3, true);
+	d.g3[0] = mt7915_test_prxv0(MT_PHY_TYPE_HT, 40, 0, 0, 0);
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), -EINVAL);
+	kfree_skb(skb);
+}
