+/* The MT7915 uses a 16 us SIFS on 5 GHz and has no CCK EIFS register to
+ * set on 2.4 GHz.
+ */
+static void mt7915_test_set_timing_mt7915(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env_chip(test, 0x7915);
+	struct mt7915_dev *dev = env->dev;
+
+	dev->phy.slottime = 9;
+	mt7915_mac_set_timing(&dev->phy);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TMAC_ICR0(0)),
+			FIELD_PREP(MT_IFS_EIFS_OFDM, 84) |
+			FIELD_PREP(MT_IFS_RIFS, 2) |
+			FIELD_PREP(MT_IFS_SIFS, 16) |
+			FIELD_PREP(MT_IFS_SLOT, 9));
+
+	dev->mphy.chandef.chan = &env->chan_2g;
+	mt7915_mac_set_timing(&dev->phy);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TMAC_ICR0(0)),
+			FIELD_PREP(MT_IFS_EIFS_OFDM, 84) |
+			FIELD_PREP(MT_IFS_RIFS, 2) |
+			FIELD_PREP(MT_IFS_SIFS, 10) |
+			FIELD_PREP(MT_IFS_SLOT, 9));
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TMAC_ICR1(0)), 0);
+}
