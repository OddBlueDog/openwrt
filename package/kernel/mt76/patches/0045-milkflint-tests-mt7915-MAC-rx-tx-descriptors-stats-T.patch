+/* Frames received on band 1 are reported on band 1's phy: its channel, its
+ * chains and its own A-MPDU numbering.
+ */
+static void mt7915_test_rx_band1(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_phy *phy1;
+	struct mt7915_test_frame f;
+	struct mt7915_test_rxd d;
+	struct mt76_rx_status *s;
+	struct sk_buff *skb;
+
+	dev->mphy.chandef.chan = &env->chan_2g;
+	phy1 = mt7915_test_band1(test, env);
+	mt7915_test_qos_frame(&f, 0, 1, 0);
+
+	mt7915_test_rxd_init(&d, 0, MT_RXD1_NORMAL_GROUP_2 |
+			     MT_RXD1_NORMAL_GROUP_3, true);
+	d.rxd[1] |= MT_RXD1_NORMAL_BAND_IDX;
+	d.rxd[2] &= ~MT_RXD2_NORMAL_NON_AMPDU;
+	d.g2[0] = 77;
+	d.g3[0] = mt7915_test_prxv0(MT_PHY_TYPE_VHT, 9, 1, 0, 0);
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	s = (struct mt76_rx_status *)skb->cb;
+	KUNIT_EXPECT_EQ(test, (int)s->phy_idx, 1);
+	KUNIT_EXPECT_EQ(test, (int)s->band, NL80211_BAND_5GHZ);
+	KUNIT_EXPECT_EQ(test, s->freq, 5180);
+	KUNIT_EXPECT_EQ(test, s->chains, 0x3);
+	KUNIT_EXPECT_EQ(test, (int)s->encoding, RX_ENC_VHT);
+	KUNIT_EXPECT_EQ(test, (int)s->nss, 2);
+	KUNIT_EXPECT_EQ(test, phy1->rx_ampdu_ts, 77);
+	KUNIT_EXPECT_EQ(test, phy1->ampdu_ref, 1);
+	KUNIT_EXPECT_EQ(test, dev->phy.ampdu_ref, 0);
+	kfree_skb(skb);
+
+	/* band 1 down */
+	clear_bit(MT76_STATE_RUNNING, &phy1->mt76->state);
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	KUNIT_EXPECT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), -EINVAL);
+	kfree_skb(skb);
+}
