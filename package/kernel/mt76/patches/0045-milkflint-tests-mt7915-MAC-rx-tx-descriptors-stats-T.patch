From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Mon, 19 Oct 2026 05:19:58 +0100
Subject: [PATCH] milkflint tests: mt7915 MAC (rx/tx descriptors, stats, TWT,
 DFS, reset)

82 more KUnit tests in 8 new suites. The 6 existing mt7915-mac tests are
kept. In-scope coverage of mt7915/mac.c goes from 8.7% to 97.0%, and
covers all 45 functions.

- mt7915-mac-rx: RX descriptor parsing.
  - HE/legacy/HT rates, NSS, bandwidth, GI and LDPC;
  - per-chain signal and A-MPDU references;
  - the FCS/MIC/ICV and checksum flags, PN per cipher and CCMP header
    re-insertion;
  - every drop path;
  - 802.3 frames (with the VLAN fix-up), A-MSDU padding and the
    first-fragment rebuild;
  - HE radiotap, band 1 and queue_rx_skb dispatch.
- mt7915-mac-stats: MIB counters, set_timing, the noise floor and the
  counter reset.
- mt7915-mac-tx:
  - tx_prepare_skb: txp, tokens, status requests, keys, 4-address and
    management frames, runt frames and token exhaustion;
  - tx-free events in all three formats, and tx status records;
  - station polling.
- mt7915-mac-twt: setup with exact wake times, every reject and dictate
  path, duplicates and teardown.
- mt7915-mac-dfs: ETSI/FCC/JP patterns and the CAC/active state machine.
- mt7915-mac-reset:
  - rate-control work, and the beacon refresh after reset;
  - reset events and dump work;
  - SER aborted at three points;
  - mac_restart up to the firmware load.
- mt7915-mac-hw, on a device registered with mac80211: the watchdog work,
  a complete SER recovery and a full reset.
- mt7915-mac-mt7915: MT7915-only branches.

One test is skipped as a suspected driver bug, MT7915 only:
MT_MIB_SDR33 is 0x088, the same register as SDR32, since commit 15f9f88b.
So tx_pkt_ibf_cnt counts the explicit beamforming counter.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mt7915/tests/mac-test.c | 4635 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 4632 insertions(+), 3 deletions(-)

diff --git a/mt7915/tests/mac-test.c b/mt7915/tests/mac-test.c
index 477ac3f4..4d8cdbb3 100644
--- a/mt7915/tests/mac-test.c
+++ b/mt7915/tests/mac-test.c
@@ -2,10 +2,21 @@
 /*
  * KUnit tests for mt7915 mac code. Included at the end of mt7915/mac.c when
  * CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU test build only).
- * Nothing here touches hardware: register access and DMA queue cleanup go
- * through stubs.
+ * Nothing here touches hardware: the first tests use their own register and
+ * queue stubs, the rest an MT7986 probed on the fakes of fake.h
+ * (mt7915_test_env()), registered with mac80211 where the code under test
+ * queues mac80211 work (mt7915_test_hw_env()).
+ *
+ * Suites: mt7915-mac (the first tests, two of which trigger WARN_ON_ONCE on
+ * purpose), -rx (rx descriptors), -stats (MIB counters, timing, noise),
+ * -tx (tx descriptors, tx-free and tx status, station polling), -twt, -dfs,
+ * -reset (rate control work, beacons, SER and chip restart), -hw (watchdog,
+ * complete SER and full recovery, on a registered device) and -mt7915 (the
+ * MT7915's own register layout).
  */
 #include <kunit/test.h>
+#include <linux/kthread.h>
+#include "fake.h"
 
 /* --- TWT ------------------------------------------------------------------ */
 
@@ -239,6 +250,4477 @@ static void mt7915_test_reset_tokens_unblocks(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, dev->mt76.wed_token_count, 0);
 }
 
+
+/* --- a running MT7986 on the fakes -------------------------------------- */
+
+/* What the tests below run on besides mt7915_test_dev(): the channels the
+ * bands offer, the tx queue tokens and tx blocking need, a channel state.
+ */
+struct mt7915_test_env {
+	struct mt7915_dev *dev;
+	struct ieee80211_channel chan_2g, chan_5g, chan_6g;
+	struct mt76_queue q;
+	struct mt76_channel_state chan_state;
+};
+
+static void mt7915_test_env_free(void *data)
+{
+	struct mt7915_test_env *env = data;
+	struct mt7915_dev *dev = env->dev;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(dev->mt76.rx_skb); i++)
+		skb_queue_purge(&dev->mt76.rx_skb[i]);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+	cancel_work_sync(&dev->rc_work);
+	idr_destroy(&dev->mt76.global_wcid.pktid);
+}
+
+static void mt7915_test_sband(struct mt76_sband *msband, enum nl80211_band band,
+			      struct ieee80211_channel *chan)
+{
+	struct ieee80211_supported_band *sband = &msband->sband;
+
+	sband->band = band;
+	sband->channels = chan;
+	sband->n_channels = 1;
+	if (band == NL80211_BAND_2GHZ) {
+		sband->bitrates = mt76_rates;
+		sband->n_bitrates = ARRAY_SIZE(mt76_rates);
+	} else {
+		sband->bitrates = mt76_rates + 4;
+		sband->n_bitrates = ARRAY_SIZE(mt76_rates) - 4;
+	}
+}
+
+/* fake.h's mt7915_test_dev() for another chip: the same fakes behind that
+ * chip's register layout
+ */
+static struct mt7915_dev *mt7915_test_dev_chip(struct kunit *test, u32 chip)
+{
+	struct mt76_test_fake *fake;
+	struct mt76_bus_ops *bus;
+	struct mt7915_dev *dev;
+	struct device *kdev;
+	void *mem;
+
+	if (chip == 0x7986)
+		return mt7915_test_dev(test);
+
+	kdev = kunit_device_register(test, "mt7915e-test");
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(kdev));
+	mem = vzalloc(SZ_8M);
+	KUNIT_ASSERT_NOT_NULL(test, mem);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_vfree, mem), 0);
+	dev = mt7915_mmio_probe(kdev, mem, chip);
+	KUNIT_ASSERT_FALSE(test, IS_ERR(dev));
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_test_free_device, &dev->mt76), 0);
+
+	fake = mt76_test_fake_attach(test, &dev->mt76);
+	fake->reply_hdr = sizeof(struct mt76_connac2_mcu_rxd);
+	fake->reply_seq_off = offsetof(struct mt76_connac2_mcu_rxd, seq);
+	dev->bus_ops = &mt76_test_bus_ops;
+	bus = (struct mt76_bus_ops *)dev->mt76.bus;
+	bus->write_copy = mt76_test_write_copy;
+	bus->read_copy = mt76_test_read_copy;
+	bus->wr_rp = mt76_test_wr_rp;
+	bus->rd_rp = mt76_test_rd_rp;
+	dev->mt76.mcu_ops = &mt7915_test_mcu_ops;
+
+	dev->phy.dev = dev;
+	dev->phy.mt76 = &dev->mt76.phy;
+	dev->mt76.phy.priv = &dev->phy;
+	INIT_WORK(&dev->rc_work, mt7915_mac_sta_rc_work);
+	INIT_DELAYED_WORK(&dev->mphy.mac_work, mt7915_mac_work);
+	INIT_LIST_HEAD(&dev->sta_rc_list);
+	INIT_LIST_HEAD(&dev->twt_list);
+	init_waitqueue_head(&dev->reset_wait);
+	INIT_WORK(&dev->reset_work, mt7915_mac_reset_work);
+	INIT_WORK(&dev->dump_work, mt7915_mac_dump_work);
+	mutex_init(&dev->dump_mutex);
+
+	return dev;
+}
+
+/* A @chip (0x7986 for the router's MT7986) whose band 0 is up on channel
+ * 36 (5180 MHz) with four chains.
+ */
+static struct mt7915_test_env *mt7915_test_env_chip(struct kunit *test,
+						    u32 chip)
+{
+	struct mt7915_test_env *env;
+	struct mt7915_dev *dev;
+	struct mt76_phy *mphy;
+	int i;
+
+	env = kunit_kzalloc(test, sizeof(*env), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, env);
+	dev = mt7915_test_dev_chip(test, chip);
+	env->dev = dev;
+	mphy = &dev->mphy;
+
+	env->chan_2g.band = NL80211_BAND_2GHZ;
+	env->chan_2g.center_freq = 2412;
+	env->chan_2g.hw_value = 1;
+	env->chan_5g.band = NL80211_BAND_5GHZ;
+	env->chan_5g.center_freq = 5180;
+	env->chan_5g.hw_value = 36;
+	env->chan_6g.band = NL80211_BAND_6GHZ;
+	env->chan_6g.center_freq = 5955;
+	env->chan_6g.hw_value = 1;
+
+	mt7915_test_sband(&mphy->sband_2g, NL80211_BAND_2GHZ, &env->chan_2g);
+	mt7915_test_sband(&mphy->sband_5g, NL80211_BAND_5GHZ, &env->chan_5g);
+	mphy->chandef.chan = &env->chan_5g;
+	mphy->chandef.width = NL80211_CHAN_WIDTH_20;
+	mphy->chandef.center_freq1 = 5180;
+	mphy->chainmask = 0xf;
+	mphy->antenna_mask = 0xf;
+	mphy->chan_state = &env->chan_state;
+	for (i = 0; i <= MT_TXQ_PSD; i++)
+		mphy->q_tx[i] = &env->q;
+	INIT_LIST_HEAD(&mphy->tx_list);
+	spin_lock_init(&mphy->tx_lock);
+	set_bit(MT76_STATE_RUNNING, &mphy->state);
+
+	mt76_wcid_init(&dev->mt76.global_wcid, 0);
+	dev->mt76.global_wcid.idx = MT7915_WTBL_STA;
+	/* tx-free events clean the tx rings first: count it */
+	dev->mt76.queue_ops = &mt7915_test_queue_ops;
+	mt7915_test_cleanups = 0;
+
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_env_free, env), 0);
+	return env;
+}
+
+static struct mt7915_test_env *mt7915_test_env(struct kunit *test)
+{
+	return mt7915_test_env_chip(test, 0x7986);
+}
+
+/* Band 1 (the MT7986's 5 GHz radio) up on channel 36 with two chains. */
+struct mt7915_test_band1 {
+	struct mt76_phy mphy;
+	struct mt7915_phy phy;
+	struct mt76_channel_state chan_state;
+	struct mt7915_dev *dev;
+};
+
+static void mt7915_test_no_work(struct work_struct *work)
+{
+}
+
+static void mt7915_test_band1_free(void *data)
+{
+	struct mt7915_test_band1 *b = data;
+
+	cancel_delayed_work_sync(&b->mphy.mac_work);
+	b->dev->mt76.phys[MT_BAND1] = NULL;
+}
+
+static struct mt7915_phy *mt7915_test_band1(struct kunit *test,
+					    struct mt7915_test_env *env)
+{
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_test_band1 *b;
+
+	b = kunit_kzalloc(test, sizeof(*b), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	b->dev = dev;
+	b->mphy.dev = &dev->mt76;
+	b->mphy.hw = dev->mt76.hw;
+	b->mphy.band_idx = MT_BAND1;
+	b->mphy.priv = &b->phy;
+	b->phy.mt76 = &b->mphy;
+	b->phy.dev = dev;
+	mt7915_test_sband(&b->mphy.sband_5g, NL80211_BAND_5GHZ, &env->chan_5g);
+	b->mphy.chandef.chan = &env->chan_5g;
+	b->mphy.chainmask = 0x3;
+	b->mphy.antenna_mask = 0x3;
+	b->mphy.chan_state = &b->chan_state;
+	INIT_LIST_HEAD(&b->mphy.tx_list);
+	spin_lock_init(&b->mphy.tx_lock);
+	INIT_DELAYED_WORK(&b->mphy.mac_work, mt7915_mac_work);
+	INIT_DELAYED_WORK(&b->mphy.scan_work, mt7915_test_no_work);
+	set_bit(MT76_STATE_RUNNING, &b->mphy.state);
+	dev->mt76.phys[MT_BAND1] = &b->mphy;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_band1_free, b), 0);
+
+	return &b->phy;
+}
+
+static void mt7915_test_wcid_free(void *data)
+{
+	struct mt76_wcid *wcid = data;
+
+	idr_destroy(&wcid->pktid);
+}
+
+static struct ieee80211_vif *mt7915_test_to_vif(struct mt7915_vif *mvif)
+{
+	return container_of((void *)mvif, struct ieee80211_vif, drv_priv);
+}
+
+static struct ieee80211_sta *mt7915_test_to_sta(struct mt7915_sta *msta)
+{
+	return container_of((void *)msta, struct ieee80211_sta, drv_priv);
+}
+
+/* An AP interface on band 0, own MAC (and BSS) index @idx. */
+static struct mt7915_vif *mt7915_test_vif(struct kunit *test,
+					  struct mt7915_dev *dev, u8 idx)
+{
+	static const u8 addr[ETH_ALEN] = { 0x02, 0x11, 0x22, 0x33, 0x44, 0 };
+	struct ieee80211_vif *vif;
+	struct mt7915_vif *mvif;
+
+	vif = kunit_kzalloc(test, sizeof(*vif) + sizeof(*mvif), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, vif);
+	vif->type = NL80211_IFTYPE_AP;
+	ether_addr_copy(vif->addr, addr);
+	vif->addr[5] = idx;
+	vif->bss_conf.vif = vif;
+	mvif = (struct mt7915_vif *)vif->drv_priv;
+	mvif->mt76.idx = idx;
+	mvif->mt76.omac_idx = idx;
+	mvif->phy = &dev->phy;
+	mvif->sta.vif = mvif;
+	INIT_LIST_HEAD(&mvif->sta.rc_list);
+	mt76_wcid_init(&mvif->sta.wcid, 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_wcid_free, &mvif->sta.wcid), 0);
+
+	return mvif;
+}
+
+/* A station published at WTBL index @idx, associated to @mvif (or none). */
+static struct mt7915_sta *mt7915_test_sta(struct kunit *test,
+					  struct mt7915_dev *dev, u16 idx,
+					  struct mt7915_vif *mvif)
+{
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+
+	sta = kunit_kzalloc(test, sizeof(*sta) + sizeof(*msta), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sta);
+	sta->addr[0] = 0x02;
+	sta->addr[4] = idx >> 8;
+	sta->addr[5] = idx;
+	msta = (struct mt7915_sta *)sta->drv_priv;
+	mt76_wcid_init(&msta->wcid, 0);
+	msta->wcid.idx = idx;
+	msta->wcid.sta = 1;
+	msta->vif = mvif;
+	msta->jiffies = jiffies;
+	INIT_LIST_HEAD(&msta->rc_list);
+	rcu_assign_pointer(dev->mt76.wcid[idx], &msta->wcid);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_wcid_free, &msta->wcid), 0);
+
+	return msta;
+}
+
+static bool mt7915_test_polled(struct mt7915_dev *dev, struct mt76_wcid *wcid)
+{
+	struct mt76_wcid *iter;
+
+	list_for_each_entry(iter, &dev->mt76.sta_poll_list, poll_list)
+		if (iter == wcid)
+			return true;
+	return false;
+}
+
+/* The MT798x reaches WF_PHY, IRPI and the like through a layer 2 remap
+ * window: the fake sees the window offset, the remap register holds the
+ * rest. The bus address of such an access, or 0 for any other register.
+ */
+#define MT7915_TEST_L2_WIN	(MT_HIF_REMAP_BASE_L2_MT7916 + 0x400000)
+#define MT7915_TEST_L2_REG	(MT_HIF_REMAP_L2_MT7916 + 0x400000)
+
+static u32 mt7915_test_l2_addr(struct mt76_test_fake *fake, u32 addr)
+{
+	u32 base;
+
+	if (addr < MT7915_TEST_L2_WIN || addr >= MT7915_TEST_L2_WIN + 0x10000)
+		return 0;
+
+	base = mt76_test_reg(fake, MT7915_TEST_L2_REG) &
+	       MT_HIF_REMAP_L2_MASK_MT7916;
+	return base | (addr - MT7915_TEST_L2_WIN);
+}
+
+/* Bus addresses of the layer 2 remapped registers the driver read, so
+ * tests can tell which band's or chain's register it picked.
+ */
+struct mt7915_test_l2_log {
+	u32 addr[64];
+	int n;
+};
+
+static u32 mt7915_test_l2_log_hook(struct mt76_test_fake *fake, u32 addr,
+				   u32 val)
+{
+	struct mt7915_test_l2_log *log = fake->priv;
+	u32 bus = mt7915_test_l2_addr(fake, addr);
+
+	if (bus && log->n < ARRAY_SIZE(log->addr))
+		log->addr[log->n++] = bus;
+	return val;
+}
+
+static bool mt7915_test_l2_logged(struct mt7915_test_l2_log *log, u32 addr)
+{
+	int i;
+
+	for (i = 0; i < log->n; i++)
+		if (log->addr[i] == addr)
+			return true;
+	return false;
+}
+
+/* --- rx descriptors ----------------------------------------------------- */
+
+/* An rx descriptor: the six base words and the groups rxd[1] announces,
+ * in the order the hardware puts them (4, 1, 2, 3, then 5 inside 3).
+ */
+struct mt7915_test_rxd {
+	u32 rxd[6];
+	u32 g4[4];
+	u32 g1[4];
+	u32 g2[2];
+	u32 g3[2];
+	u32 g5[18];
+};
+
+static void mt7915_test_put_le32(struct sk_buff *skb, const u32 *w, int n)
+{
+	__le32 *p = skb_put(skb, n * 4);
+	int i;
+
+	for (i = 0; i < n; i++)
+		p[i] = cpu_to_le32(w[i]);
+}
+
+/* @d, the header padding rxd[2] announces, then @frame. Room is left in
+ * front for the radiotap and CCMP headers the driver may push.
+ */
+static struct sk_buff *mt7915_test_rx_skb(struct kunit *test,
+					  const struct mt7915_test_rxd *d,
+					  const void *frame, int len)
+{
+	int pad = 2 * FIELD_GET(MT_RXD2_NORMAL_HDR_OFFSET, d->rxd[2]);
+	u32 rxd1 = d->rxd[1];
+	struct sk_buff *skb;
+
+	skb = alloc_skb(128 + sizeof(*d) + pad + len, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	skb_reserve(skb, 64);
+	mt7915_test_put_le32(skb, d->rxd, ARRAY_SIZE(d->rxd));
+	if (rxd1 & MT_RXD1_NORMAL_GROUP_4)
+		mt7915_test_put_le32(skb, d->g4, ARRAY_SIZE(d->g4));
+	if (rxd1 & MT_RXD1_NORMAL_GROUP_1)
+		mt7915_test_put_le32(skb, d->g1, ARRAY_SIZE(d->g1));
+	if (rxd1 & MT_RXD1_NORMAL_GROUP_2)
+		mt7915_test_put_le32(skb, d->g2, ARRAY_SIZE(d->g2));
+	if (rxd1 & MT_RXD1_NORMAL_GROUP_3) {
+		mt7915_test_put_le32(skb, d->g3, ARRAY_SIZE(d->g3));
+		if (rxd1 & MT_RXD1_NORMAL_GROUP_5)
+			mt7915_test_put_le32(skb, d->g5, ARRAY_SIZE(d->g5));
+	}
+	skb_put_zero(skb, pad);
+	if (len)
+		skb_put_data(skb, frame, len);
+
+	return skb;
+}
+
+/* mt7915_mac_fill_rx() in the context NAPI calls it from, @info being the
+ * DMA descriptor's info word
+ */
+static int mt7915_test_fill_rx_info(struct mt7915_dev *dev,
+				    struct sk_buff *skb, u32 csum_status,
+				    u32 info)
+{
+	int ret;
+
+	*(u32 *)skb->cb = csum_status;
+	local_bh_disable();
+	rcu_read_lock();
+	ret = mt7915_mac_fill_rx(dev, skb, MT_RXQ_MAIN, &info);
+	rcu_read_unlock();
+	local_bh_enable();
+
+	return ret;
+}
+
+static int mt7915_test_fill_rx(struct mt7915_dev *dev, struct sk_buff *skb,
+			       u32 csum_status)
+{
+	return mt7915_test_fill_rx_info(dev, skb, csum_status, 0);
+}
+
+static void mt7915_test_queue_rx(struct mt7915_dev *dev, struct sk_buff *skb)
+{
+	u32 info = 0;
+
+	local_bh_disable();
+	rcu_read_lock();
+	mt7915_queue_rx_skb(&dev->mt76, MT_RXQ_MAIN, skb, &info);
+	rcu_read_unlock();
+	local_bh_enable();
+}
+
+/* A unicast QoS data frame with TID @tid and sequence number @sn. */
+struct mt7915_test_frame {
+	struct ieee80211_qos_hdr hdr;
+	u8 payload[12];
+} __packed;
+
+static void mt7915_test_qos_frame(struct mt7915_test_frame *f, u16 extra_fc,
+				  u16 sn, u8 tid)
+{
+	static const u8 llc[] = { 0xaa, 0xaa, 0x03, 0, 0, 0, 0x08, 0x00,
+				  0xde, 0xad, 0xbe, 0xef };
+	int i;
+
+	memset(f, 0, sizeof(*f));
+	f->hdr.frame_control = cpu_to_le16(IEEE80211_FTYPE_DATA |
+					   IEEE80211_STYPE_QOS_DATA |
+					   IEEE80211_FCTL_TODS | extra_fc);
+	for (i = 0; i < ETH_ALEN; i++) {
+		f->hdr.addr1[i] = 0x10 + i;
+		f->hdr.addr2[i] = 0x20 + i;
+		f->hdr.addr3[i] = 0x30 + i;
+	}
+	f->hdr.seq_ctrl = cpu_to_le16(sn << 4);
+	f->hdr.qos_ctrl = cpu_to_le16(tid);
+	memcpy(f->payload, llc, sizeof(llc));
+}
+
+/* the base words of a frame from WTBL entry @idx, @groups present */
+static void mt7915_test_rxd_init(struct mt7915_test_rxd *d, u16 idx,
+				 u32 groups, bool unicast)
+{
+	memset(d, 0, sizeof(*d));
+	d->rxd[0] = FIELD_PREP(MT_RXD0_PKT_TYPE, PKT_TYPE_NORMAL);
+	d->rxd[1] = FIELD_PREP(MT_RXD1_NORMAL_WLAN_IDX, idx) | groups;
+	d->rxd[2] = MT_RXD2_NORMAL_NON_AMPDU;
+	d->rxd[3] = FIELD_PREP(MT_RXD3_NORMAL_ADDR_TYPE,
+			       unicast ? MT_RXD3_NORMAL_U2M : 2);
+}
+
+static u32 mt7915_test_prxv0(u8 mode, u8 rate, u8 nsts, u8 bw, u8 gi)
+{
+	return FIELD_PREP(MT_PRXV_TX_MODE, mode) |
+	       FIELD_PREP(MT_PRXV_TX_RATE, rate) |
+	       FIELD_PREP(MT_PRXV_NSTS, nsts) |
+	       FIELD_PREP(MT_PRXV_FRAME_MODE, bw) |
+	       FIELD_PREP(MT_PRXV_HT_SGI, gi);
+}
+
+static u32 mt7915_test_rcpi(u8 r0, u8 r1, u8 r2, u8 r3)
+{
+	return FIELD_PREP(MT_PRXV_RCPI0, r0) | FIELD_PREP(MT_PRXV_RCPI1, r1) |
+	       FIELD_PREP(MT_PRXV_RCPI2, r2) | FIELD_PREP(MT_PRXV_RCPI3, r3);
+}
