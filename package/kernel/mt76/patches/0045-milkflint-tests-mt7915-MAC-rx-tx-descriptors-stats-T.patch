+/* --- MIB counters and timing -------------------------------------------- */
+
+/* register k of the MIB test: distinct halves, low half above 8 bits */
+#define MIB_LO(k)	(0x1010 + (k))
+#define MIB_HI(k)	(0x100 + (k))
+#define MIB_V(k)	((MIB_HI(k) << 16) | MIB_LO(k))
+#define MIB_24(k)	(MIB_V(k) & GENMASK(23, 0))
+
+/* The MT7986's MIB counters (MT7916 layout) are clear-on-read: each read is
+ * added to phy->mib, with the field widths of that layout. The beamforming
+ * feedback bandwidth is a state, not a counter.
+ */
+static void mt7915_test_mib_stats(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_mib_stats *mib = &dev->phy.mib;
+	u32 *aggr = dev->mphy.aggr_stats;
+	const u32 regs[] = {
+		0,
+		MT_MIB_SDR3(0), MT_MIB_SDR4(0), MT_MIB_SDR5(0), MT_MIB_SDR6(0),
+		/* 5: the MT7916 layout has SDR7 and SDRVEC in one register */
+		MT_MIB_SDR7(0), MT_MIB_SDR8(0), MT_MIB_SDR10(0),
+		MT_MIB_SDR11(0), MT_MIB_SDR12(0), MT_MIB_SDR13(0),
+		MT_MIB_SDR14(0), MT_MIB_SDR15(0), MT_MIB_SDR16(0),
+		MT_MIB_SDR17(0), MT_MIB_SDR18(0), MT_MIB_SDR19(0),
+		MT_MIB_SDR20(0), MT_MIB_SDR21(0), MT_MIB_SDR22(0),
+		MT_MIB_SDR23(0), MT_MIB_SDR24(0), MT_MIB_SDR25(0),
+		MT_MIB_SDR27(0), MT_MIB_SDR28(0), MT_MIB_SDR29(0),
+		0, MT_MIB_SDR31(0), MT_MIB_SDRMUBF(0), MT_MIB_DR8(0),
+		MT_MIB_DR9(0), MT_MIB_DR11(0),
+		/* 32 */
+		MT_PLE_AMSDU_PACK_MSDU_CNT(0), MT_PLE_AMSDU_PACK_MSDU_CNT(1),
+		MT_PLE_AMSDU_PACK_MSDU_CNT(2), MT_PLE_AMSDU_PACK_MSDU_CNT(3),
+		MT_PLE_AMSDU_PACK_MSDU_CNT(4), MT_PLE_AMSDU_PACK_MSDU_CNT(5),
+		MT_PLE_AMSDU_PACK_MSDU_CNT(6), MT_PLE_AMSDU_PACK_MSDU_CNT(7),
+		/* 40 */
+		MT_MIB_MB_SDR0(0, 0), MT_MIB_MB_SDR0(0, 4),
+		MT_MIB_MB_SDR1(0, 0), MT_MIB_MB_SDR1(0, 4),
+		MT_MIB_MB_SDR2(0, 0), MT_MIB_MB_SDR2(0, 4),
+		MT_MIB_MB_BFTF(0, 0), MT_MIB_MB_BFTF(0, 4),
+		/* 48 */
+		MT_TX_AGG_CNT(0, 0), MT_TX_AGG_CNT(0, 1), MT_TX_AGG_CNT(0, 2),
+		MT_TX_AGG_CNT(0, 3), MT_TX_AGG_CNT(0, 4), MT_TX_AGG_CNT(0, 5),
+		MT_TX_AGG_CNT(0, 6), MT_TX_AGG_CNT(0, 7),
+		/* 56 */
+		MT_MIB_SDR32(0), MT_MIB_BFCR7(0), MT_MIB_BFCR2(0),
+		MT_MIB_BFCR0(0), MT_MIB_BFCR1(0),
+	};
+	int i, n;
+
+	for (i = 1; i < ARRAY_SIZE(regs); i++)
+		if (regs[i])
+			mt76_wr(dev, regs[i], MIB_V(i));
+	/* feedback bandwidth 3, Nc 5, Nr 3 */
+	mt76_wr(dev, MT_ETBF_PAR_RPT0(0), 0xeb);
+
+	for (n = 1; n <= 2; n++) {
+		mt7915_mac_update_stats(&dev->phy);
+
+		KUNIT_EXPECT_EQ(test, mib->fcs_err_cnt, n * MIB_HI(1));
+		KUNIT_EXPECT_EQ(test, mib->rx_fifo_full_cnt, n * MIB_LO(2));
+		KUNIT_EXPECT_EQ(test, mib->rx_mpdu_cnt, n * MIB_V(3));
+		KUNIT_EXPECT_EQ(test, mib->channel_idle_cnt, n * MIB_LO(4));
+		KUNIT_EXPECT_EQ(test, mib->rx_vector_mismatch_cnt,
+				n * MIB_LO(5));
+		KUNIT_EXPECT_EQ(test, mib->rx_vec_queue_overflow_drop_cnt,
+				n * MIB_HI(5));
+		KUNIT_EXPECT_EQ(test, mib->rx_delimiter_fail_cnt,
+				n * MIB_LO(6));
+		KUNIT_EXPECT_EQ(test, mib->rx_mrdy_cnt, n * MIB_V(7));
+		KUNIT_EXPECT_EQ(test, mib->rx_len_mismatch_cnt, n * MIB_LO(8));
+		KUNIT_EXPECT_EQ(test, mib->tx_ampdu_cnt, n * MIB_V(9));
+		KUNIT_EXPECT_EQ(test, mib->tx_stop_q_empty_cnt, n * MIB_LO(10));
+		KUNIT_EXPECT_EQ(test, mib->tx_mpdu_attempts_cnt, n * MIB_V(11));
+		KUNIT_EXPECT_EQ(test, mib->tx_mpdu_success_cnt, n * MIB_V(12));
+		KUNIT_EXPECT_EQ(test, mib->primary_cca_busy_time,
+				n * MIB_24(13));
+		KUNIT_EXPECT_EQ(test, mib->secondary_cca_busy_time,
+				n * MIB_24(14));
+		KUNIT_EXPECT_EQ(test, mib->primary_energy_detect_time,
+				n * MIB_24(15));
+		KUNIT_EXPECT_EQ(test, mib->cck_mdrdy_time, n * MIB_24(16));
+		KUNIT_EXPECT_EQ(test, mib->ofdm_mdrdy_time, n * MIB_24(17));
+		KUNIT_EXPECT_EQ(test, mib->green_mdrdy_time, n * MIB_24(18));
+		KUNIT_EXPECT_EQ(test, mib->rx_ampdu_cnt, n * MIB_V(19));
+		KUNIT_EXPECT_EQ(test, mib->rx_ampdu_bytes_cnt, n * MIB_V(20));
+		KUNIT_EXPECT_EQ(test, mib->rx_ampdu_valid_subframe_cnt,
+				n * MIB_V(21));
+		KUNIT_EXPECT_EQ(test, mib->rx_ampdu_valid_subframe_bytes_cnt,
+				n * MIB_V(22));
+		KUNIT_EXPECT_EQ(test, mib->tx_rwp_fail_cnt, n * MIB_LO(23));
+		KUNIT_EXPECT_EQ(test, mib->tx_rwp_need_cnt, n * MIB_LO(24));
+		KUNIT_EXPECT_EQ(test, mib->rx_pfdrop_cnt, n * MIB_LO(25));
+		KUNIT_EXPECT_EQ(test, mib->rx_ba_cnt, n * MIB_V(27));
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_cnt, n * MIB_LO(28));
+		KUNIT_EXPECT_EQ(test, mib->tx_mu_mpdu_cnt, n * MIB_V(29));
+		KUNIT_EXPECT_EQ(test, mib->tx_mu_acked_mpdu_cnt, n * MIB_V(30));
+		KUNIT_EXPECT_EQ(test, mib->tx_su_acked_mpdu_cnt, n * MIB_V(31));
+
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_rx_fb_bw, 3);
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_rx_fb_nc_cnt, n * 5);
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_rx_fb_nr_cnt, n * 3);
+
+		for (i = 0; i < 8; i++)
+			KUNIT_EXPECT_EQ(test, mib->tx_amsdu[i],
+					n * MIB_V(32 + i));
+		KUNIT_EXPECT_EQ(test, mib->tx_amsdu_cnt,
+				n * (8 * MIB_V(32) + 28 * 0x10001));
+
+		/* two 16-bit counters per register, two registers each */
+		KUNIT_EXPECT_EQ(test, mib->rts_cnt,
+				n * (MIB_LO(40) + MIB_HI(40) +
+				     MIB_LO(41) + MIB_HI(41)));
+		KUNIT_EXPECT_EQ(test, mib->rts_retries_cnt,
+				n * (MIB_LO(42) + MIB_HI(42) +
+				     MIB_LO(43) + MIB_HI(43)));
+		KUNIT_EXPECT_EQ(test, mib->ba_miss_cnt,
+				n * (MIB_LO(44) + MIB_HI(44) +
+				     MIB_LO(45) + MIB_HI(45)));
+		KUNIT_EXPECT_EQ(test, mib->ack_fail_cnt,
+				n * (MIB_LO(46) + MIB_HI(46) +
+				     MIB_LO(47) + MIB_HI(47)));
+
+		/* A-MPDU length histogram: 16 bins, two per register */
+		for (i = 0; i < 8; i++) {
+			KUNIT_EXPECT_EQ(test, aggr[2 * i], n * MIB_LO(48 + i));
+			KUNIT_EXPECT_EQ(test, aggr[2 * i + 1],
+					n * MIB_HI(48 + i));
+		}
+
+		KUNIT_EXPECT_EQ(test, mib->tx_pkt_ibf_cnt, n * MIB_HI(56));
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_ibf_ppdu_cnt, n * MIB_HI(56));
+		KUNIT_EXPECT_EQ(test, mib->tx_pkt_ebf_cnt, n * MIB_LO(56));
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_ebf_ppdu_cnt, n * MIB_LO(56));
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_fb_cpl_cnt, n * MIB_LO(57));
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_fb_trig_cnt, n * MIB_LO(58));
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_rx_fb_vht_cnt, n * MIB_HI(59));
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_rx_fb_ht_cnt, n * MIB_LO(59));
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_rx_fb_he_cnt, n * MIB_LO(60));
+		KUNIT_EXPECT_EQ(test, mib->tx_bf_rx_fb_all_cnt,
+				n * (MIB_HI(59) + MIB_LO(59) + MIB_LO(60)));
+	}
