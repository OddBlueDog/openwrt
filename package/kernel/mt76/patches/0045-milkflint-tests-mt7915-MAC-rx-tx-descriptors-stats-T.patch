+/* Resetting the counters (on a channel switch) drops the A-MPDU histogram,
+ * restarts the airtime counters and only re-bases the firmware's channel
+ * airtime: nothing is added to the channel's state.
+ */
+static void mt7915_test_reset_counters(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_mcu_mib *req;
+	struct mt76_test_msg *msg;
+	int i;
+
+	fake->reply = mt7915_test_mib_reply;
+	for (i = 0; i < ARRAY_SIZE(dev->mphy.aggr_stats); i++)
+		dev->mphy.aggr_stats[i] = i + 1;
+
+	mt7915_mac_reset_counters(&dev->phy);
+
+	KUNIT_EXPECT_TRUE(test, !memchr_inv(dev->mphy.aggr_stats, 0,
+					    sizeof(dev->mphy.aggr_stats)));
+	KUNIT_EXPECT_NE(test, ktime_to_ns(dev->mphy.survey_time), 0);
+	KUNIT_EXPECT_TRUE(test, mt76_rr(dev, MT_WF_RMAC_MIB_AIRTIME0(0)) &
+			  MT_WF_RMAC_MIB_RXTIME_CLR);
+
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(GET_MIB_INFO));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_ASSERT_EQ(test, msg->len, 4 * sizeof(*req));
+	req = (struct mt7915_mcu_mib *)msg->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req[0].offs), MIB_NON_WIFI_TIME_V2);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req[1].offs), MIB_TX_TIME_V2);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req[2].offs), MIB_RX_TIME_V2);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req[3].offs), MIB_OBSS_AIRTIME_V2);
+	KUNIT_EXPECT_EQ(test, env->chan_state.cc_busy, 0);
+	KUNIT_EXPECT_EQ(test, dev->phy.state_ts.cc_busy, 1000);
+}
+
+/* A stuck rx path (RMAC and WTBL pointers apart and not moving between two
+ * checks) gets an L3 rx-abort recovery; a new PLE hang an L1 SER, once.
+ * A band with no interface isn't checked.
+ */
+static void mt7915_test_severe_check(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u32 stuck = FIELD_PREP(MT_TRB_RXPSR0_RX_RMAC_PTR, 5) |
+		    FIELD_PREP(MT_TRB_RXPSR0_RX_WTBL_PTR, 7);
+	struct mt76_test_msg *msg;
+	unsigned int n_rr;
+
+	mt76_wr(dev, MT_TRB_RXPSR0(0), stuck);
+	n_rr = fake->n_rr;
+	mt7915_mac_severe_check(&dev->phy);
+	KUNIT_EXPECT_EQ(test, fake->n_rr, n_rr);
+	KUNIT_EXPECT_EQ(test, dev->phy.trb_ts, 0);
+
+	dev->phy.omac_mask = BIT(0);
+	/* first sighting: remembered, not acted on */
+	mt7915_mac_severe_check(&dev->phy);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	KUNIT_EXPECT_EQ(test, dev->phy.trb_ts, stuck);
+
+	mt7915_mac_severe_check(&dev->phy);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 1);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_SER_TRIGGER));
+	KUNIT_EXPECT_EQ(test, msg->data[0], SER_RECOVER);
+	KUNIT_EXPECT_EQ(test, msg->data[1], SER_SET_RECOVER_L3_RX_ABORT);
+	KUNIT_EXPECT_EQ(test, msg->data[2], 0);
+
+	/* pointers moved on */
+	mt76_wr(dev, MT_TRB_RXPSR0(0), stuck + 1);
+	mt7915_mac_severe_check(&dev->phy);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+	/* in step: fine */
+	mt76_wr(dev, MT_TRB_RXPSR0(0), FIELD_PREP(MT_TRB_RXPSR0_RX_RMAC_PTR, 3) |
+				       FIELD_PREP(MT_TRB_RXPSR0_RX_WTBL_PTR, 3));
+	mt7915_mac_severe_check(&dev->phy);
+	mt7915_mac_severe_check(&dev->phy);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+
+	mt76_wr(dev, MT_SWDEF_PLE1_STATS, MT_SWDEF_PLE1_MDP_RIOC_HANG_ERR);
+	mt7915_mac_severe_check(&dev->phy);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	msg = mt76_test_msg(fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->data[0], SER_RECOVER);
+	KUNIT_EXPECT_EQ(test, msg->data[1], SER_SET_RECOVER_L1);
+	KUNIT_EXPECT_EQ(test, dev->ple1_sts, MT_SWDEF_PLE1_MDP_RIOC_HANG_ERR);
+	/* still hung: already being recovered */
+	mt7915_mac_severe_check(&dev->phy);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 2);
+}
+
+/* --- tx: descriptors and tokens ----------------------------------------- */
+
+/* A txwi as the DMA layer hands it to tx_prepare_skb(): descriptor and
+ * firmware txp, then the txwi cache entry.
+ */
+static u8 *mt7915_test_txwi(struct kunit *test, struct mt7915_dev *dev)
+{
+	u8 *txwi;
+
+	txwi = kunit_kzalloc(test, dev->mt76.drv->txwi_size +
+			     sizeof(struct mt76_txwi_cache), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, txwi);
+	return txwi;
+}
+
+static struct mt76_txwi_cache *mt7915_test_txwi_cache(struct mt7915_dev *dev,
+						      u8 *txwi)
+{
+	return (struct mt76_txwi_cache *)(txwi + dev->mt76.drv->txwi_size);
+}
+
+static struct mt76_connac_fw_txp *mt7915_test_txp(u8 *txwi)
+{
+	return (struct mt76_connac_fw_txp *)(txwi + MT_TXD_SIZE);
+}
+
+/* A frame for the air: @len bytes of @data in an skb with room in front. */
+static struct sk_buff *mt7915_test_tx_skb(struct kunit *test, const void *data,
+					  int len)
+{
+	struct sk_buff *skb;
+
+	skb = alloc_skb(len + 64, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	skb_reserve(skb, 32);
+	skb_put_data(skb, data, len);
+	return skb;
+}
+
+static void mt7915_test_tx_info(struct mt76_tx_info *tx_info,
+				struct sk_buff *skb, int nbuf)
+{
+	int i;
+
+	memset(tx_info, 0, sizeof(*tx_info));
+	tx_info->skb = skb;
+	tx_info->nbuf = nbuf;
+	tx_info->buf[0].len = MT_TXD_SIZE + sizeof(struct mt76_connac_fw_txp);
+	for (i = 1; i < nbuf; i++) {
+		tx_info->buf[i].addr = 0x10000 * i;
+		tx_info->buf[i].len = 100 * i;
+	}
+}
+
+static int mt7915_test_prepare(struct mt7915_dev *dev, u8 *txwi,
+			       struct mt76_wcid *wcid,
+			       struct ieee80211_sta *sta,
+			       struct mt76_tx_info *tx_info)
+{
+	int ret;
+
+	rcu_read_lock();
+	ret = mt7915_tx_prepare_skb(&dev->mt76, txwi, MT_TXQ_BE, wcid, sta,
+				    tx_info);
+	rcu_read_unlock();
+	return ret;
+}
+
+/* Give back a token tx_prepare_skb() took, without completing its frame. */
+static void mt7915_test_untoken(struct kunit *test, struct mt7915_dev *dev,
+				int id, struct sk_buff *skb)
+{
+	struct mt76_txwi_cache *t;
+	bool wake = false;
+
+	t = mt76_token_release(&dev->mt76, id, &wake);
+	KUNIT_EXPECT_NOT_NULL(test, t);
+	if (t)
+		KUNIT_EXPECT_PTR_EQ(test, t->skb, skb);
+}
+
+static const u8 mt7915_test_eth[] = {
+	0x00, 0x00, 0x11, 0x22, 0x33, 0x44, 0x02, 0x11, 0x22, 0x33, 0x44, 0x01,
+	0x08, 0x00, 0x45, 0x00, 0x00, 0x14, 0, 0, 0, 0,
+};
+
+/* A data frame for a station: the firmware txp lists the frame's DMA
+ * buffers after the one with the descriptor, carries the token, the
+ * station's BSS and "no cipher"; only the first 72 bytes are handed over
+ * with the txwi. A station not heard from for 250 ms has its next frame's
+ * tx status requested (for rate and inactivity tracking).
+ */
+static void mt7915_test_tx_prepare_data(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 2);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 9, mvif);
+	struct ieee80211_tx_info *info;
+	struct mt76_connac_fw_txp *txp;
+	struct mt7915_test_frame f;
+	struct mt76_tx_info tx_info;
+	struct sk_buff *skb;
+	__le32 *txd;
+	u8 *txwi;
+	int id, pid;
+
+	mt7915_test_qos_frame(&f, 0, 1, 0);
+	skb = mt7915_test_tx_skb(test, &f, sizeof(f));
+	info = IEEE80211_SKB_CB(skb);
+	info->control.vif = mt7915_test_to_vif(mvif);
+	mt7915_test_tx_info(&tx_info, skb, 3);
+	txwi = mt7915_test_txwi(test, dev);
+	txd = (__le32 *)txwi;
+	msta->jiffies = jiffies - HZ;
+
+	KUNIT_ASSERT_EQ(test, mt7915_test_prepare(dev, txwi, &msta->wcid,
+				mt7915_test_to_sta(msta), &tx_info), 0);
+
+	txp = mt7915_test_txp(txwi);
+	KUNIT_EXPECT_EQ(test, txp->nbuf, 2);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(txp->buf[0]), 0x10000);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txp->len[0]), 100);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(txp->buf[1]), 0x20000);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txp->len[1]), 200);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txp->flags),
+			MT_CT_INFO_APPLY_TXD | MT_CT_INFO_FROM_HOST |
+			MT_CT_INFO_NONE_CIPHER_FRAME);
+	KUNIT_EXPECT_EQ(test, txp->bss_idx, 2);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txp->rept_wds_wcid), 0x3ff);
+
+	id = le16_to_cpu(txp->token);
+	KUNIT_EXPECT_PTR_EQ(test, idr_find(&dev->mt76.token, id),
+			    mt7915_test_txwi_cache(dev, txwi));
+	KUNIT_EXPECT_PTR_EQ(test, mt7915_test_txwi_cache(dev, txwi)->skb, skb);
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 1);
+
+	/* the skb belongs to the token now; two buffers go to the DMA ring */
+	KUNIT_EXPECT_NULL(test, tx_info.skb);
+	KUNIT_EXPECT_EQ(test, tx_info.nbuf, MT_CT_DMA_BUF_NUM);
+	KUNIT_EXPECT_EQ(test, (int)tx_info.buf[1].len, MT_CT_PARSE_LEN);
+	KUNIT_EXPECT_TRUE(test, !!tx_info.buf[1].skip_unmap);
+
+	KUNIT_EXPECT_TRUE(test, info->flags & IEEE80211_TX_CTL_REQ_TX_STATUS);
+	KUNIT_EXPECT_TRUE(test, time_after_eq(msta->jiffies, jiffies - HZ / 10));
+	pid = le32_get_bits(txd[5], MT_TXD5_PID);
+	KUNIT_EXPECT_GE(test, pid, MT_PACKET_ID_FIRST);
+	KUNIT_EXPECT_TRUE(test, le32_to_cpu(txd[5]) & MT_TXD5_TX_STATUS_HOST);
+	KUNIT_EXPECT_PTR_EQ(test, idr_find(&msta->wcid.pktid, pid), skb);
+	KUNIT_EXPECT_EQ(test, le32_get_bits(txd[1], MT_TXD1_WLAN_IDX), 9);
+	KUNIT_EXPECT_EQ(test, le32_get_bits(txd[1], MT_TXD1_OWN_MAC), 2);
+	KUNIT_EXPECT_EQ(test, le32_get_bits(txd[0], MT_TXD0_TX_BYTES),
+			sizeof(f) + MT_TXD_SIZE);
+
+	/* the next frame within 250 ms: no status needed */
+	info->flags = 0;
+	mt7915_test_untoken(test, dev, id, skb);
+	spin_lock_bh(&dev->mt76.status_lock);
+	idr_remove(&msta->wcid.pktid, pid);
+	list_del_init(&msta->wcid.list);
+	spin_unlock_bh(&dev->mt76.status_lock);
+	mt7915_test_tx_info(&tx_info, skb, 1);
+	KUNIT_ASSERT_EQ(test, mt7915_test_prepare(dev, txwi, &msta->wcid,
+				mt7915_test_to_sta(msta), &tx_info), 0);
+	KUNIT_EXPECT_FALSE(test, info->flags & IEEE80211_TX_CTL_REQ_TX_STATUS);
+	KUNIT_EXPECT_EQ(test, le32_get_bits(txd[5], MT_TXD5_PID),
+			MT_PACKET_ID_NO_SKB);
+	KUNIT_EXPECT_EQ(test, txp->nbuf, 0);
+	mt7915_test_untoken(test, dev, le16_to_cpu(txp->token), skb);
+	kfree_skb(skb);
+}
+
+/* Encrypted frames lose "no cipher"; a 4-address (WDS) station's frames
+ * name it as the repeater entry.
+ */
+static void mt7915_test_tx_prepare_key_4addr(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 33, mvif);
+	struct ieee80211_key_conf key = {
+		.cipher = WLAN_CIPHER_SUITE_CCMP,
+		.keyidx = 1,
+	};
+	struct ieee80211_tx_info *info;
+	struct mt76_connac_fw_txp *txp;
+	struct mt7915_test_frame f;
+	struct mt76_tx_info tx_info;
+	struct sk_buff *skb;
+	__le32 *txd;
+	u8 *txwi;
+
+	mt7915_test_qos_frame(&f, IEEE80211_FCTL_FROMDS, 1, 0);
+	skb = mt7915_test_tx_skb(test, &f, sizeof(f));
+	info = IEEE80211_SKB_CB(skb);
+	info->control.hw_key = &key;
+	set_bit(MT_WCID_FLAG_4ADDR, &msta->wcid.flags);
+	mt7915_test_tx_info(&tx_info, skb, 1);
+	txwi = mt7915_test_txwi(test, dev);
+	txd = (__le32 *)txwi;
+
+	KUNIT_ASSERT_EQ(test, mt7915_test_prepare(dev, txwi, &msta->wcid,
+						  NULL, &tx_info), 0);
+	txp = mt7915_test_txp(txwi);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txp->flags),
+			MT_CT_INFO_APPLY_TXD | MT_CT_INFO_FROM_HOST);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txp->rept_wds_wcid), 33);
+	/* no vif in the frame's control: BSS 0 */
+	KUNIT_EXPECT_EQ(test, txp->bss_idx, 0);
+	KUNIT_EXPECT_TRUE(test, le32_to_cpu(txd[3]) & MT_TXD3_PROTECT_FRAME);
+	mt7915_test_untoken(test, dev, le16_to_cpu(txp->token), skb);
+	kfree_skb(skb);
+}
+
+/* Management frames are flagged for the firmware (it schedules them on
+ * the management queue); without a station they go out on the global
+ * entry. 802.3 frames are data, whatever their first bytes look like.
+ */
+static void mt7915_test_tx_prepare_mgmt(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct ieee80211_mgmt mgmt = {
+		.frame_control = cpu_to_le16(IEEE80211_FTYPE_MGMT |
+					     IEEE80211_STYPE_AUTH),
+	};
+	struct ieee80211_tx_info *info;
+	struct mt76_connac_fw_txp *txp;
+	struct mt76_tx_info tx_info;
+	struct sk_buff *skb;
+	__le32 *txd;
+	u8 *txwi;
+
+	skb = mt7915_test_tx_skb(test, &mgmt, 24 + 6);
+	mt7915_test_tx_info(&tx_info, skb, 1);
+	txwi = mt7915_test_txwi(test, dev);
+	txd = (__le32 *)txwi;
+	KUNIT_ASSERT_EQ(test, mt7915_test_prepare(dev, txwi, NULL, NULL,
+						  &tx_info), 0);
+	txp = mt7915_test_txp(txwi);
+	KUNIT_EXPECT_TRUE(test, le16_to_cpu(txp->flags) &
+			  MT_CT_INFO_MGMT_FRAME);
+	KUNIT_EXPECT_EQ(test, le32_get_bits(txd[1], MT_TXD1_WLAN_IDX),
+			dev->mt76.global_wcid.idx);
+	mt7915_test_untoken(test, dev, le16_to_cpu(txp->token), skb);
+	kfree_skb(skb);
+
+	/* an Ethernet frame to 00:00:...: its first bytes read as "assoc
+	 * request", but it's data
+	 */
+	skb = mt7915_test_tx_skb(test, mt7915_test_eth,
+				 sizeof(mt7915_test_eth));
+	info = IEEE80211_SKB_CB(skb);
+	info->flags = IEEE80211_TX_CTL_HW_80211_ENCAP;
+	mt7915_test_tx_info(&tx_info, skb, 1);
+	KUNIT_ASSERT_EQ(test, mt7915_test_prepare(dev, txwi, NULL, NULL,
+						  &tx_info), 0);
+	KUNIT_EXPECT_FALSE(test, le16_to_cpu(txp->flags) &
+			   MT_CT_INFO_MGMT_FRAME);
+	KUNIT_EXPECT_EQ(test, le32_get_bits(txd[1], MT_TXD1_HDR_FORMAT),
+			MT_HDR_FORMAT_802_3);
+	mt7915_test_untoken(test, dev, le16_to_cpu(txp->token), skb);
+	kfree_skb(skb);
+}
+
+/* Runt frames and frames with no token left are refused; the caller keeps
+ * the skb and no tx status is pending for it.
+ */
+static void mt7915_test_tx_prepare_refused(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 9, mvif);
+	struct mt76_txwi_cache *dummy;
+	struct mt76_tx_info tx_info;
+	struct sk_buff *skb;
+	bool wake = false;
+	u8 *txwi, *txwi2;
+	int id;
+
+	txwi = mt7915_test_txwi(test, dev);
+	skb = mt7915_test_tx_skb(test, mt7915_test_eth, ETH_HLEN);
+	mt7915_test_tx_info(&tx_info, skb, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_test_prepare(dev, txwi, &msta->wcid, NULL,
+						  &tx_info), -EINVAL);
+	KUNIT_EXPECT_PTR_EQ(test, tx_info.skb, skb);
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 0);
+	kfree_skb(skb);
+
+	/* the only token is taken */
+	dev->mt76.token_size = 1;
+	txwi2 = mt7915_test_txwi(test, dev);
+	dummy = mt7915_test_txwi_cache(dev, txwi2);
+	id = mt76_token_consume(&dev->mt76, &dummy);
+	KUNIT_ASSERT_EQ(test, id, 0);
+
+	skb = mt7915_test_tx_skb(test, mt7915_test_eth,
+				 sizeof(mt7915_test_eth));
+	IEEE80211_SKB_CB(skb)->flags = IEEE80211_TX_CTL_HW_80211_ENCAP |
+				       IEEE80211_TX_CTL_REQ_TX_STATUS;
+	mt7915_test_tx_info(&tx_info, skb, 1);
+	KUNIT_EXPECT_LT(test, mt7915_test_prepare(dev, txwi, &msta->wcid, NULL,
+						  &tx_info), 0);
+	KUNIT_EXPECT_PTR_EQ(test, tx_info.skb, skb);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&msta->wcid.pktid));
+	/* running out of tokens stops the tx queues */
+	KUNIT_EXPECT_TRUE(test, env->q.blocked);
+	kfree_skb(skb);
+	mt76_token_release(&dev->mt76, id, &wake);
+}
+
+/* On band 1 the descriptor is tagged for the second band. */
+static void mt7915_test_write_txwi_band1(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct ieee80211_tx_info *info;
+	struct sk_buff *skb;
+	__le32 txd[16];
+
+	mt7915_test_band1(test, env);
+	skb = mt7915_test_tx_skb(test, mt7915_test_eth,
+				 sizeof(mt7915_test_eth));
+	info = IEEE80211_SKB_CB(skb);
+	info->flags = IEEE80211_TX_CTL_HW_80211_ENCAP;
+
+	mt7915_mac_write_txwi(&dev->mt76, txd, skb, &dev->mt76.global_wcid,
+			      MT_PACKET_ID_NO_SKB, NULL, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_FALSE(test, le32_to_cpu(txd[1]) & MT_TXD1_TGID);
+
+	info->hw_queue |= FIELD_PREP(MT_TX_HW_QUEUE_PHY, MT_BAND1);
+	mt7915_mac_write_txwi(&dev->mt76, txd, skb, &dev->mt76.global_wcid,
+			      MT_PACKET_ID_NO_SKB, NULL, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_TRUE(test, le32_to_cpu(txd[1]) & MT_TXD1_TGID);
+	KUNIT_EXPECT_EQ(test, le32_get_bits(txd[5], MT_TXD5_PID),
+			MT_PACKET_ID_NO_SKB);
+	kfree_skb(skb);
+}
+
+/* --- tx: tx-free events ------------------------------------------------- */
+
+/* A frame the hardware holds: a token for a txwi from WTBL entry @idx, as
+ * tx_prepare_skb() leaves it (no extra buffers to unmap). The test keeps a
+ * reference to the skb to see it freed.
+ */
+static int mt7915_test_token(struct kunit *test, struct mt7915_dev *dev,
+			     u16 idx, struct sk_buff **pskb)
+{
+	u8 *txwi = mt7915_test_txwi(test, dev);
+	struct mt76_txwi_cache *t = mt7915_test_txwi_cache(dev, txwi);
+	struct sk_buff *skb;
+	int id;
+
+	skb = mt7915_test_tx_skb(test, mt7915_test_eth,
+				 sizeof(mt7915_test_eth));
+	((__le32 *)txwi)[1] = cpu_to_le32(FIELD_PREP(MT_TXD1_WLAN_IDX, idx));
+	t->skb = skb;
+	id = mt76_token_consume(&dev->mt76, &t);
+	KUNIT_ASSERT_GE(test, id, 0);
+	*pskb = skb_get(skb);
+
+	return id;
+}
+
+static bool mt7915_test_skb_freed(struct sk_buff *skb)
+{
+	return refcount_read(&skb->users) == 1;
+}
+
+/* A tx-free (or tx status) event of @n words: the packet type in the first
+ * word, @ctrl in its upper half, then @txd and @info.
+ */
+static __le32 *mt7915_test_event(struct kunit *test, u8 type, u16 ctrl,
+				 u32 txd, const u32 *info, int n)
+{
+	__le32 *ev;
+	int i;
+
+	ev = kunit_kzalloc(test, (2 + n) * 4, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ev);
+	ev[0] = cpu_to_le32(FIELD_PREP(MT_RXD0_PKT_TYPE, type) |
+			    ((u32)ctrl << 16));
+	ev[1] = cpu_to_le32(txd);
+	for (i = 0; i < n; i++)
+		ev[2 + i] = cpu_to_le32(info[i]);
+	return ev;
+}
+
+static bool mt7915_test_rx_check(struct mt7915_dev *dev, void *data, int len)
+{
+	bool ret;
+
+	local_bh_disable();
+	rcu_read_lock();
+	ret = mt7915_rx_check(&dev->mt76, data, len);
+	rcu_read_unlock();
+	local_bh_enable();
+	return ret;
+}
+
+/* The tx-free event: a "wcid pair" word names the station, the MSDU words
+ * after it free their tokens and complete the frames; MPDU header words
+ * carry the retry count and status for the station's statistics. Freeing
+ * tokens unblocks tx, and the station's airtime and ack signal are polled.
+ */
+static void mt7915_test_tx_free(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 9, mvif);
+	struct sk_buff *skb[2];
+	int id[2], i;
+	u32 info[3];
+	__le32 *ev;
+
+	for (i = 0; i < 2; i++)
+		id[i] = mt7915_test_token(test, dev, 9, &skb[i]);
+	env->q.blocked = true;
+	/* ack signal of the station's responses: -62 dBm on every chain */
+	mt76_wr(dev, MT_WTBL_LMAC_OFFS(9, 30), 0x60606060);
+
+	info[0] = MT_TX_FREE_PAIR | FIELD_PREP(MT_TX_FREE_WLAN_ID, 9);
+	/* sent 3 times, then dropped */
+	info[1] = FIELD_PREP(MT_TX_FREE_MSDU_ID, id[0]) |
+		  MT_TX_FREE_MPDU_HEADER | FIELD_PREP(MT_TX_FREE_COUNT, 3) |
+		  FIELD_PREP(MT_TX_FREE_STAT, 1);
+	info[2] = FIELD_PREP(MT_TX_FREE_MSDU_ID, id[1]);
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY, 2, 0, info, 3);
+
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 5 * 4));
+
+	for (i = 0; i < 2; i++) {
+		KUNIT_EXPECT_NULL(test, idr_find(&dev->mt76.token, id[i]));
+		KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb[i]));
+		kfree_skb(skb[i]);
+	}
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 0);
+	KUNIT_EXPECT_EQ(test, msta->wcid.stats.tx_retries, 2);
+	KUNIT_EXPECT_EQ(test, msta->wcid.stats.tx_failed, 3);
+	KUNIT_EXPECT_FALSE(test, env->q.blocked);
+	/* band 0's PSD and BE rings were cleaned first */
+	KUNIT_EXPECT_EQ(test, mt7915_test_cleanups, 2);
+
+	/* polled: four chains at -62 dBm combine to -57 dBm */
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->mt76.sta_poll_list));
+	KUNIT_EXPECT_EQ(test, msta->ack_signal, -57);
+	KUNIT_EXPECT_EQ(test, ewma_avg_signal_read(&msta->avg_ack_signal), 57);
+}
+
+/* Version 4 (v3 format) events: two MSDU IDs per word (0x7fff: none) and
+ * MPDU header words that only carry statistics.
+ */
+static void mt7915_test_tx_free_v3(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 9, mvif);
+	struct sk_buff *skb[3];
+	int id[3], i;
+	u32 info[4];
+	__le32 *ev;
+
+	mt7915_test_band1(test, env);
+	for (i = 0; i < 3; i++)
+		id[i] = mt7915_test_token(test, dev, 9, &skb[i]);
+
+	info[0] = MT_TX_FREE_PAIR | FIELD_PREP(MT_TX_FREE_WLAN_ID, 9);
+	info[1] = MT_TX_FREE_MPDU_HEADER_V3 |
+		  FIELD_PREP(MT_TX_FREE_COUNT_V3, 2) |
+		  FIELD_PREP(MT_TX_FREE_STAT_V3, 0);
+	info[2] = id[0] | (MT_TX_FREE_MSDU_ID_V3 << 15);
+	info[3] = id[1] | (id[2] << 15);
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY, 3,
+			       FIELD_PREP(MT_TX_FREE_VER, 4), info, 4);
+
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 6 * 4));
+	for (i = 0; i < 3; i++) {
+		KUNIT_EXPECT_NULL(test, idr_find(&dev->mt76.token, id[i]));
+		KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb[i]));
+		kfree_skb(skb[i]);
+	}
+	/* sent twice, then acked */
+	KUNIT_EXPECT_EQ(test, msta->wcid.stats.tx_retries, 1);
+	KUNIT_EXPECT_EQ(test, msta->wcid.stats.tx_failed, 1);
+	/* both bands' rings */
+	KUNIT_EXPECT_EQ(test, mt7915_test_cleanups, 4);
+}
+
+/* Words before any wcid pair, for an entry that's no station, or for
+ * unknown tokens are skipped; the rest of the event is still handled.
+ */
+static void mt7915_test_tx_free_unknown(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct sk_buff *skb;
+	u32 info[5];
+	__le32 *ev;
+	int id;
+
+	mvif->sta.wcid.idx = 12;
+	rcu_assign_pointer(dev->mt76.wcid[12], &mvif->sta.wcid);
+	id = mt7915_test_token(test, dev, 12, &skb);
+
+	/* an unknown entry, then a word for it: no statistics */
+	info[0] = MT_TX_FREE_PAIR | FIELD_PREP(MT_TX_FREE_WLAN_ID, 300);
+	info[1] = FIELD_PREP(MT_TX_FREE_MSDU_ID, 4000) |
+		  MT_TX_FREE_MPDU_HEADER | FIELD_PREP(MT_TX_FREE_COUNT, 5);
+	info[2] = MT_TX_FREE_PAIR | FIELD_PREP(MT_TX_FREE_WLAN_ID, 12);
+	info[3] = FIELD_PREP(MT_TX_FREE_MSDU_ID, 4001) |
+		  MT_TX_FREE_MPDU_HEADER | FIELD_PREP(MT_TX_FREE_COUNT, 4);
+	info[4] = FIELD_PREP(MT_TX_FREE_MSDU_ID, id);
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY, 3, 0, info, 5);
+
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 7 * 4));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb));
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 0);
+	/* the interface entry's frames are counted to it */
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.stats.tx_retries, 3);
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.stats.tx_failed, 3);
+	kfree_skb(skb);
+}
+
+/* The older tx-free format: a list of 16-bit tokens, the station taken
+ * from each frame's descriptor.
+ */
+static void mt7915_test_tx_free_v0(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 9, mvif);
+	struct sk_buff *skb[2];
+	int id[2];
+	u32 info[2];
+	__le32 *ev;
+
+	id[0] = mt7915_test_token(test, dev, 9, &skb[0]);
+	id[1] = mt7915_test_token(test, dev, 0, &skb[1]);
+	mt76_wr(dev, MT_WTBL_LMAC_OFFS(9, 30), 0x00606060);
+	env->q.blocked = true;
+
+	info[0] = id[0] | (id[1] << 16);
+	/* unknown token */
+	info[1] = 4000;
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY_V0, 3, 0, info, 2);
+
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 4 * 4));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb[0]));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb[1]));
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 0);
+	KUNIT_EXPECT_FALSE(test, env->q.blocked);
+	KUNIT_EXPECT_EQ(test, mt7915_test_cleanups, 2);
+	/* the station was polled from its frame's descriptor: three chains
+	 * at -62 dBm, the fourth unheard
+	 */
+	KUNIT_EXPECT_EQ(test, msta->ack_signal, -58);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->mt76.sta_poll_list));
+	kfree_skb(skb[0]);
+	kfree_skb(skb[1]);
+}
+
+/* --- tx: tx status ------------------------------------------------------ */
+
+static void mt7915_test_txs(u32 *txs, u16 wcid, u8 pid, u32 txs0)
+{
+	memset(txs, 0, 8 * 4);
+	txs[0] = txs0;
+	txs[2] = FIELD_PREP(MT_TXS2_WCID, wcid);
+	txs[3] = FIELD_PREP(MT_TXS3_PID, pid);
+}
+
+static u32 mt7915_test_txs0(u8 mode, u8 mcs, u8 nss, u8 bw)
+{
+	u32 rate = FIELD_PREP(MT_TX_RATE_MODE, mode) |
+		   FIELD_PREP(MT_TX_RATE_IDX, mcs) |
+		   FIELD_PREP(MT_TX_RATE_NSS, nss - 1);
+
+	return FIELD_PREP(MT_TXS0_TX_RATE, rate) | FIELD_PREP(MT_TXS0_BW, bw);
+}
+
+/* Tx status records without a frame behind them (the "rate only" ID) feed
+ * the station's rate and statistics and get it polled; records for the
+ * no-status IDs and for unknown entries are ignored. One event can carry
+ * several records.
+ */
+static void mt7915_test_txs_rate(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 9, mvif);
+	struct mt7915_sta *other = mt7915_test_sta(test, dev, 10, mvif);
+	struct mt76_sta_stats *st = &msta->wcid.stats;
+	u32 txs[4 * 8 + 4];
+	__le32 *ev;
+
+	mt7915_test_txs(txs, 9, MT_PACKET_ID_WED,
+			mt7915_test_txs0(MT_PHY_TYPE_HE_SU, 9, 2,
+					 IEEE80211_STA_RX_BW_80));
+	mt7915_test_txs(txs + 8, 10, MT_PACKET_ID_NO_SKB,
+			mt7915_test_txs0(MT_PHY_TYPE_VHT, 3, 1, 0));
+	mt7915_test_txs(txs + 16, 300, MT_PACKET_ID_WED,
+			mt7915_test_txs0(MT_PHY_TYPE_VHT, 3, 1, 0));
+	mt7915_test_txs(txs + 24, 10, MT_PACKET_ID_NO_ACK,
+			mt7915_test_txs0(MT_PHY_TYPE_VHT, 3, 1, 0));
+	/* a trailing partial record */
+	txs[32] = mt7915_test_txs0(MT_PHY_TYPE_VHT, 3, 1, 0);
+	txs[34] = FIELD_PREP(MT_TXS2_WCID, 10);
+	txs[35] = FIELD_PREP(MT_TXS3_PID, MT_PACKET_ID_WED);
+	ev = mt7915_test_event(test, PKT_TYPE_TXS, 0, 0, txs, ARRAY_SIZE(txs));
+
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev,
+				(2 + ARRAY_SIZE(txs)) * 4));
+
+	KUNIT_EXPECT_EQ(test, msta->wcid.rate.mcs, 9);
+	KUNIT_EXPECT_EQ(test, msta->wcid.rate.nss, 2);
+	KUNIT_EXPECT_EQ(test, (int)msta->wcid.rate.bw, RATE_INFO_BW_80);
+	KUNIT_EXPECT_TRUE(test, msta->wcid.rate.flags & RATE_INFO_FLAGS_HE_MCS);
+	KUNIT_EXPECT_EQ(test, st->tx_mode[MT_PHY_TYPE_HE_SU], 1);
+	KUNIT_EXPECT_EQ(test, st->tx_bw[2], 1);
+	KUNIT_EXPECT_EQ(test, st->tx_nss[1], 1);
+	KUNIT_EXPECT_EQ(test, st->tx_mcs[9], 1);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_polled(dev, &msta->wcid));
+
+	KUNIT_EXPECT_EQ(test, other->wcid.stats.tx_mode[MT_PHY_TYPE_VHT], 0);
+	KUNIT_EXPECT_EQ(test, other->wcid.rate.mcs, 0);
+	KUNIT_EXPECT_FALSE(test, mt7915_test_polled(dev, &other->wcid));
+}
+
+/* A frame whose status mac80211 asked for, from queueing to completion:
+ * tx_prepare_skb() registers it under a packet ID, the tx status record
+ * with that ID marks it acked (or not), and the tx-free event for its
+ * token reports it to mac80211 and frees it.
+ */
+static void mt7915_test_tx_status_lifecycle(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt76_wcid *wcid = &mvif->sta.wcid;
+	struct mt76_tx_info tx_info;
+	struct sk_buff *skb;
+	u32 txs[8], info[2];
+	int i, id, pid;
+	__le32 *ev;
+	u8 *txwi;
+
+	wcid->idx = 12;
+	rcu_assign_pointer(dev->mt76.wcid[12], wcid);
+
+	for (i = 0; i < 2; i++) {
+		bool acked = !i;
+
+		skb = mt7915_test_tx_skb(test, mt7915_test_eth,
+					 sizeof(mt7915_test_eth));
+		IEEE80211_SKB_CB(skb)->flags = IEEE80211_TX_CTL_HW_80211_ENCAP |
+					       IEEE80211_TX_CTL_REQ_TX_STATUS;
+		skb_get(skb);
+		mt7915_test_tx_info(&tx_info, skb, 1);
+		txwi = mt7915_test_txwi(test, dev);
+		KUNIT_ASSERT_EQ(test, mt7915_test_prepare(dev, txwi, wcid, NULL,
+							  &tx_info), 0);
+		id = le16_to_cpu(mt7915_test_txp(txwi)->token);
+		pid = le32_get_bits(((__le32 *)txwi)[5], MT_TXD5_PID);
+		KUNIT_ASSERT_GE(test, pid, MT_PACKET_ID_FIRST);
+		KUNIT_EXPECT_PTR_EQ(test, idr_find(&wcid->pktid, pid), skb);
+
+		mt7915_test_txs(txs, 12, pid,
+				mt7915_test_txs0(MT_PHY_TYPE_OFDM, 11, 1, 0) |
+				(acked ? 0 : MT_TXS0_ACK_TIMEOUT));
+		ev = mt7915_test_event(test, PKT_TYPE_TXS, 0, 0, txs, 8);
+		KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 10 * 4));
+		KUNIT_EXPECT_NULL(test, idr_find(&wcid->pktid, pid));
+		KUNIT_EXPECT_EQ(test, !!(IEEE80211_SKB_CB(skb)->flags &
+					 IEEE80211_TX_STAT_ACK), acked);
+		/* still with the hardware */
+		KUNIT_EXPECT_FALSE(test, mt7915_test_skb_freed(skb));
+
+		info[0] = MT_TX_FREE_PAIR | FIELD_PREP(MT_TX_FREE_WLAN_ID, 12);
+		info[1] = FIELD_PREP(MT_TX_FREE_MSDU_ID, id);
+		ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY, 1, 0,
+				       info, 2);
+		KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 4 * 4));
+		KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb));
+		KUNIT_EXPECT_EQ(test, !!(IEEE80211_SKB_CB(skb)->flags &
+					 IEEE80211_TX_STAT_ACK), acked);
+		kfree_skb(skb);
+	}
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 0);
+}
+
+/* What mt7915_rx_check() handles in the interrupt path itself (tx-free,
+ * tx status, firmware monitor) and what it leaves to the rx queue.
+ */
+static void mt7915_test_rx_check_types(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	__le32 *ev;
+
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY, 0, 0, NULL, 0);
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 8));
+	KUNIT_EXPECT_EQ(test, mt7915_test_cleanups, 2);
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY_V0, 0, 0, NULL, 0);
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 8));
+	KUNIT_EXPECT_EQ(test, mt7915_test_cleanups, 4);
+	ev = mt7915_test_event(test, PKT_TYPE_RX_FW_MONITOR, 0, 0, NULL, 0);
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 8));
+	ev = mt7915_test_event(test, PKT_TYPE_TXS, 0, 0, NULL, 0);
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 8));
+
+	ev = mt7915_test_event(test, PKT_TYPE_NORMAL, 0, 0, NULL, 0);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_rx_check(dev, ev, 8));
+	ev = mt7915_test_event(test, PKT_TYPE_RX_EVENT, 0, 0, NULL, 0);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_rx_check(dev, ev, 8));
+	KUNIT_EXPECT_EQ(test, mt7915_test_cleanups, 4);
+}
+
+static struct sk_buff *mt7915_test_event_skb(struct kunit *test, __le32 *ev,
+					     int len)
+{
+	struct sk_buff *skb = alloc_skb(len + 32, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	skb_put_data(skb, ev, len);
+	return skb;
+}
+
+/* The same events arriving on an rx queue: handled, then the skb freed. */
+static void mt7915_test_queue_rx_tx_events(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 9, mvif);
+	struct sk_buff *frame[2], *skb;
+	u32 info[2], txs[8];
+	int id[2];
+	__le32 *ev;
+
+	id[0] = mt7915_test_token(test, dev, 9, &frame[0]);
+	id[1] = mt7915_test_token(test, dev, 9, &frame[1]);
+
+	info[0] = MT_TX_FREE_PAIR | FIELD_PREP(MT_TX_FREE_WLAN_ID, 9);
+	info[1] = FIELD_PREP(MT_TX_FREE_MSDU_ID, id[0]);
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY, 1, 0, info, 2);
+	skb = skb_get(mt7915_test_event_skb(test, ev, 4 * 4));
+	mt7915_test_queue_rx(dev, skb);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(frame[0]));
+	kfree_skb(skb);
+
+	info[0] = id[1];
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY_V0, 1, 0, info, 1);
+	skb = skb_get(mt7915_test_event_skb(test, ev, 3 * 4));
+	mt7915_test_queue_rx(dev, skb);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(frame[1]));
+	kfree_skb(skb);
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 0);
+
+	mt7915_test_txs(txs, 9, MT_PACKET_ID_WED,
+			mt7915_test_txs0(MT_PHY_TYPE_VHT, 7, 1, 0));
+	ev = mt7915_test_event(test, PKT_TYPE_TXS, 0, 0, txs, 8);
+	skb = skb_get(mt7915_test_event_skb(test, ev, 10 * 4));
+	mt7915_test_queue_rx(dev, skb);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb));
+	KUNIT_EXPECT_EQ(test, msta->wcid.stats.tx_mode[MT_PHY_TYPE_VHT], 1);
+	kfree_skb(skb);
+
+	kfree_skb(frame[0]);
+	kfree_skb(frame[1]);
+}
+
+/* --- station polling ---------------------------------------------------- */
+
+/* where WTBL entry @idx's word @dw is, once its group is selected */
+static u32 mt7915_test_wtbl(u16 idx, u8 dw)
+{
+	return MT_WTBL_BASE | FIELD_PREP(MT_WTBL_LMAC_ID, idx & 0x7f) |
+	       FIELD_PREP(MT_WTBL_LMAC_DW, dw);
+}
+
+static void mt7915_test_poll(struct mt7915_dev *dev, struct mt7915_sta *msta)
+{
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	if (list_empty(&msta->wcid.poll_list))
+		list_add_tail(&msta->wcid.poll_list, &dev->mt76.sta_poll_list);
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+	mt7915_mac_sta_poll(dev);
+}
+
+/* The GI isn't in tx status reports: it's read from the station's WTBL
+ * entry, at the position for its current bandwidth (2 bits per width for
+ * HE, one bit per width for HT/VHT). Entries above 127 are reached through
+ * the WTBL group register.
+ */
+static void mt7915_test_sta_poll_gi(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 130, mvif);
+	struct rate_info *rate = &msta->wcid.rate;
+	u32 dw7 = mt7915_test_wtbl(130, 7);
+
+	rate->flags = RATE_INFO_FLAGS_HE_MCS;
+	rate->bw = RATE_INFO_BW_80;
+	mt76_wr(dev, dw7, (2 << 28) | (1 << 24));
+	mt7915_test_poll(dev, msta);
+	KUNIT_EXPECT_EQ(test, rate->he_gi, 2);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WTBLON_TOP_WDUCR), 1);
+
+	rate->bw = RATE_INFO_BW_160;
+	mt76_wr(dev, dw7, 3 << 30);
+	mt7915_test_poll(dev, msta);
+	KUNIT_EXPECT_EQ(test, rate->he_gi, 3);
+
+	rate->flags = RATE_INFO_FLAGS_VHT_MCS;
+	rate->bw = RATE_INFO_BW_40;
+	mt76_wr(dev, dw7, BIT(13));
+	mt7915_test_poll(dev, msta);
+	KUNIT_EXPECT_TRUE(test, rate->flags & RATE_INFO_FLAGS_SHORT_GI);
+	mt76_wr(dev, dw7, BIT(12));
+	mt7915_test_poll(dev, msta);
+	KUNIT_EXPECT_FALSE(test, rate->flags & RATE_INFO_FLAGS_SHORT_GI);
+
+	rate->flags = RATE_INFO_FLAGS_MCS;
+	rate->bw = RATE_INFO_BW_20;
+	mt7915_test_poll(dev, msta);
+	KUNIT_EXPECT_TRUE(test, rate->flags & RATE_INFO_FLAGS_SHORT_GI);
+
+	/* legacy rates have no GI to update */
+	rate->flags = 0;
+	mt7915_test_poll(dev, msta);
+	KUNIT_EXPECT_EQ(test, rate->flags, 0);
+}
+
+/* Ack signal: the RCPI of the station's responses on the interface's
+ * chains, combined, and averaged.
+ */
+static void mt7915_test_sta_poll_ack_signal(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 9, mvif);
+
+	/* chain 0 at -62 dBm, chain 1 at -66 dBm, two chains on the phy */
+	dev->mphy.antenna_mask = 0x3;
+	mt76_wr(dev, MT_WTBL_LMAC_OFFS(9, 30), 0x00005860);
+	mt7915_test_poll(dev, msta);
+	KUNIT_EXPECT_EQ(test, msta->ack_signal, -61);
+	KUNIT_EXPECT_EQ(test, ewma_avg_signal_read(&msta->avg_ack_signal), 61);
+}
+
+/* The airtime counters are cumulative; when one gets near the top (bit 30)
+ * the driver clears the station's counters in the WTBL and starts over.
+ * A station that's gone (unpublished) is just dropped from the list.
+ */
+static void mt7915_test_sta_poll_airtime(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 9, mvif);
+	unsigned int n_rr;
+	int i;
+
+	/* the hardware counters as last read: AC 2 tx near overflow */
+	msta->airtime_ac[2] = BIT(30) | 100;
+	msta->airtime_ac[6] = 50;
+	mt76_wr(dev, MT_WTBL_LMAC_OFFS(9, 20 + 2 * 2), BIT(30) | 100);
+	mt76_wr(dev, MT_WTBL_LMAC_OFFS(9, 21 + 2 * 2), 50);
+	mt7915_test_poll(dev, msta);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WTBL_UPDATE),
+			FIELD_PREP(MT_WTBL_UPDATE_WLAN_IDX, 9) |
+			MT_WTBL_UPDATE_ADM_COUNT_CLEAR);
+	for (i = 0; i < ARRAY_SIZE(msta->airtime_ac); i++)
+		KUNIT_EXPECT_EQ(test, msta->airtime_ac[i], 0);
+
+	/* gone: not polled, not touched */
+	msta->airtime_ac[0] = 7;
+	rcu_assign_pointer(dev->mt76.wcid[9], NULL);
+	n_rr = fake->n_rr;
+	mt7915_test_poll(dev, msta);
+	KUNIT_EXPECT_EQ(test, fake->n_rr, n_rr);
+	KUNIT_EXPECT_EQ(test, msta->airtime_ac[0], 7);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->mt76.sta_poll_list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&msta->wcid.poll_list));
+}
+
+/* An interface's own entry on the poll list (no station behind it): its
+ * airtime counters are kept, nothing else.
+ */
+static void mt7915_test_sta_poll_no_sta(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = &mvif->sta;
+
+	msta->wcid.idx = 12;
+	rcu_assign_pointer(dev->mt76.wcid[12], &msta->wcid);
+	mt76_wr(dev, MT_WTBL_LMAC_OFFS(12, 20), 1234);
+	mt76_wr(dev, MT_WTBL_LMAC_OFFS(12, 21), 99);
+	mt76_wr(dev, MT_WTBL_LMAC_OFFS(12, 30), 0x60606060);
+	mt7915_test_poll(dev, msta);
+	KUNIT_EXPECT_EQ(test, msta->airtime_ac[0], 1234);
+	KUNIT_EXPECT_EQ(test, msta->airtime_ac[4], 99);
+	KUNIT_EXPECT_EQ(test, msta->ack_signal, 0);
+}
+
+/* --- TWT agreements ----------------------------------------------------- */
+
+/* the firmware's TWT_AGRT_UPDATE request */
+struct mt7915_test_twt_agrt {
+	u8 tbl_idx;
+	u8 cmd;
+	u8 own_mac_idx;
+	u8 flowid;
+	__le16 peer_id;
+	u8 duration;
+	u8 bss_idx;
+	__le64 start_tsf;
+	__le16 mantissa;
+	u8 exponent;
+	u8 is_ap;
+	u8 agrt_params;
+	u8 rsv[23];
+} __packed;
+
+#define MT7915_TEST_TWT_TRIGGER		BIT(0)
+#define MT7915_TEST_TWT_ANNOUNCE	BIT(1)
+#define MT7915_TEST_TWT_PROTECT		BIT(2)
+
+/* An individual, implicit TWT request: setup command @cmd, wake interval
+ * @mantissa << @exp us, minimum wake duration @dur x 256 us.
+ */
+static struct ieee80211_twt_setup *
+mt7915_test_twt_req(struct kunit *test, u8 cmd, u8 exp, u16 mantissa, u8 dur,
+		    u16 flags)
+{
+	struct ieee80211_twt_params *p;
+	struct ieee80211_twt_setup *twt;
+
+	twt = kunit_kzalloc(test, sizeof(*twt) + sizeof(*p), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, twt);
+	p = (struct ieee80211_twt_params *)twt->params;
+	flags |= IEEE80211_TWT_REQTYPE_REQUEST |
+		 IEEE80211_TWT_REQTYPE_IMPLICIT |
+		 FIELD_PREP(IEEE80211_TWT_REQTYPE_SETUP_CMD, cmd) |
+		 FIELD_PREP(IEEE80211_TWT_REQTYPE_WAKE_INT_EXP, exp);
+	p->req_type = cpu_to_le16(flags);
+	p->mantissa = cpu_to_le16(mantissa);
+	p->min_twt_dur = dur;
+
+	return twt;
+}
+
+static struct ieee80211_twt_params *
+mt7915_test_twt_params(struct ieee80211_twt_setup *twt)
+{
+	return (struct ieee80211_twt_params *)twt->params;
+}
+
+static u8 mt7915_test_twt_answer(struct ieee80211_twt_setup *twt)
+{
+	return le16_get_bits(mt7915_test_twt_params(twt)->req_type,
+			     IEEE80211_TWT_REQTYPE_SETUP_CMD);
+}
+
+static void mt7915_test_tsf(struct mt7915_dev *dev, u64 tsf)
+{
+	mt76_wr(dev, MT_LPON_UTTR0(0), lower_32_bits(tsf));
+	mt76_wr(dev, MT_LPON_UTTR1(0), upper_32_bits(tsf));
+}
+
+/* A request the AP can serve is accepted: the flow gets the station's first
+ * free flow ID and the first free table entry, the firmware is told, and
+ * the target wake time is the next interval boundary after "now" counted
+ * from the flow's slot (0 for the first flow). Only the wake duration unit
+ * and rx-disabled bits of the control field are echoed.
+ */
+static void mt7915_test_twt_accept(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 3);
+	struct mt7915_sta *a = mt7915_test_sta(test, dev, 9, mvif);
+	struct mt7915_sta *b = mt7915_test_sta(test, dev, 10, mvif);
+	struct mt7915_test_twt_agrt *req;
+	struct ieee80211_twt_setup *twt;
+	struct ieee80211_twt_params *p;
+	struct mt7915_twt_flow *flow;
+	struct mt76_test_msg *msg;
+
+	mt7915_test_tsf(dev, 5000000);
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64,
+				  IEEE80211_TWT_REQTYPE_TRIGGER |
+				  IEEE80211_TWT_REQTYPE_PROTECTION);
+	twt->control = IEEE80211_TWT_CONTROL_NDP |
+		       IEEE80211_TWT_CONTROL_RESP_MODE |
+		       IEEE80211_TWT_CONTROL_RX_DISABLED;
+	p = mt7915_test_twt_params(twt);
+
+	mt7915_mac_add_twt_setup(dev->mt76.hw, mt7915_test_to_sta(a), twt);
+
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ACCEPT);
+	KUNIT_EXPECT_EQ(test, le16_get_bits(p->req_type,
+					    IEEE80211_TWT_REQTYPE_FLOWID), 0);
+	KUNIT_EXPECT_EQ(test, twt->control, IEEE80211_TWT_CONTROL_RX_DISABLED);
+	/* interval 1048576 us: the next boundary after 5000000 */
+	KUNIT_EXPECT_EQ(test, le64_to_cpu(p->twt), 5 * 1048576);
+	/* the TSF was read in software mode for the interface's own MAC */
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_TCR_MT7916(0, 3)) &
+			MT_LPON_TCR_SW_MODE, MT_LPON_TCR_SW_READ);
+
+	flow = &a->twt.flow[0];
+	KUNIT_EXPECT_TRUE(test, flow->sched);
+	KUNIT_EXPECT_EQ(test, flow->start_tsf, 0);
+	KUNIT_EXPECT_EQ(test, flow->tsf, 5 * 1048576);
+	KUNIT_EXPECT_EQ(test, flow->duration, 64);
+	KUNIT_EXPECT_EQ(test, flow->exp, 10);
+	KUNIT_EXPECT_EQ(test, flow->wcid, 9);
+	KUNIT_EXPECT_EQ(test, flow->table_id, 0);
+	KUNIT_EXPECT_EQ(test, a->twt.flowid_mask, BIT(0));
+	KUNIT_EXPECT_EQ(test, dev->twt.table_mask, BIT(0));
+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 1);
+	KUNIT_EXPECT_PTR_EQ(test, list_first_entry(&dev->twt_list,
+			    struct mt7915_twt_flow, list), flow);
+
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(TWT_AGRT_UPDATE));
+	req = mt7915_test_payload(msg, struct mt7915_test_twt_agrt);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->cmd, MCU_TWT_AGRT_ADD);
+	KUNIT_EXPECT_EQ(test, req->tbl_idx, 0);
+	KUNIT_EXPECT_EQ(test, req->own_mac_idx, 3);
+	KUNIT_EXPECT_EQ(test, req->bss_idx, 3);
+	KUNIT_EXPECT_EQ(test, req->flowid, 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->peer_id), 9);
+	KUNIT_EXPECT_EQ(test, req->duration, 64);
+	KUNIT_EXPECT_EQ(test, le64_to_cpu(req->start_tsf), 5 * 1048576);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->mantissa), 1024);
+	KUNIT_EXPECT_EQ(test, req->exponent, 10);
+	KUNIT_EXPECT_EQ(test, req->is_ap, 1);
+	KUNIT_EXPECT_EQ(test, req->agrt_params, MT7915_TEST_TWT_TRIGGER |
+			MT7915_TEST_TWT_ANNOUNCE | MT7915_TEST_TWT_PROTECT);
+
+	/* the next station's flow is scheduled right after the first one's
+	 * wake period (64 x 256 us)
+	 */
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_SUGGEST, 10, 1024, 64,
+				  IEEE80211_TWT_REQTYPE_FLOWTYPE);
+	p = mt7915_test_twt_params(twt);
+	mt7915_mac_add_twt_setup(dev->mt76.hw, mt7915_test_to_sta(b), twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ACCEPT);
+	flow = &b->twt.flow[0];
+	KUNIT_EXPECT_EQ(test, flow->start_tsf, 16384);
+	KUNIT_EXPECT_EQ(test, le64_to_cpu(p->twt),
+			5000000 + 1048576 - (5000000 - 16384) % 1048576);
+	KUNIT_EXPECT_EQ(test, flow->table_id, 1);
+	KUNIT_EXPECT_EQ(test, dev->twt.table_mask, BIT(0) | BIT(1));
+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 2);
+	KUNIT_EXPECT_PTR_EQ(test, list_last_entry(&dev->twt_list,
+			    struct mt7915_twt_flow, list), flow);
+	req = mt7915_test_payload(mt76_test_find_msg(fake,
+				  MCU_EXT_CMD(TWT_AGRT_UPDATE)),
+				  struct mt7915_test_twt_agrt);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	/* unannounced flow, no trigger, no protection */
+	KUNIT_EXPECT_EQ(test, req->agrt_params, 0);
+	KUNIT_EXPECT_EQ(test, req->tbl_idx, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->peer_id), 10);
+
+	/* the first station's second flow: next free ID and table entry */
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 11, 1024, 64, 0);
+	mt7915_mac_add_twt_setup(dev->mt76.hw, mt7915_test_to_sta(a), twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ACCEPT);
+	p = mt7915_test_twt_params(twt);
+	KUNIT_EXPECT_EQ(test, le16_get_bits(p->req_type,
+					    IEEE80211_TWT_REQTYPE_FLOWID), 1);
+	KUNIT_EXPECT_EQ(test, a->twt.flowid_mask, BIT(0) | BIT(1));
+	KUNIT_EXPECT_EQ(test, a->twt.flow[1].table_id, 2);
+	KUNIT_EXPECT_EQ(test, a->twt.flow[1].start_tsf, 2 * 16384);
+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 3);
+}
+
+/* Demand (and other non-request) setups aren't scheduled by the AP: the
+ * station's own target wake time is used as it is.
+ */
+static void mt7915_test_twt_demand(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *a = mt7915_test_sta(test, dev, 9, mvif);
+	struct mt7915_test_twt_agrt *req;
+	struct ieee80211_twt_setup *twt;
+
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_DEMAND, 8, 500, 70, 0);
+	mt7915_test_twt_params(twt)->twt = cpu_to_le64(123456789);
+	mt7915_mac_add_twt_setup(dev->mt76.hw, mt7915_test_to_sta(a), twt);
+
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ACCEPT);
+	KUNIT_EXPECT_EQ(test, le64_to_cpu(mt7915_test_twt_params(twt)->twt),
+			123456789);
+	KUNIT_EXPECT_FALSE(test, a->twt.flow[0].sched);
+	KUNIT_EXPECT_EQ(test, a->twt.flow[0].tsf, 123456789);
+	KUNIT_EXPECT_FALSE(test, list_empty(&a->twt.flow[0].list));
+	req = mt7915_test_payload(mt76_test_find_msg(mt76_test_fake,
+				  MCU_EXT_CMD(TWT_AGRT_UPDATE)),
+				  struct mt7915_test_twt_agrt);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, le64_to_cpu(req->start_tsf), 123456789);
+	KUNIT_EXPECT_EQ(test, req->duration, 70);
+}
+
+/* What the AP turns down: broadcast TWT, a wake duration in TUs, explicit
+ * agreements, a full agreement table or station, a duplicate of an
+ * existing flow, and anything the firmware refused (whose flow mustn't be
+ * left on the list). Too short a wake duration gets a counter-proposal.
+ */
+static void mt7915_test_twt_reject(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *a = mt7915_test_sta(test, dev, 9, mvif);
+	struct ieee80211_sta *sta = mt7915_test_to_sta(a);
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_twt_setup *twt;
+	struct ieee80211_twt_params *p;
+
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64, 0);
+	twt->control = IEEE80211_TWT_CONTROL_NEG_TYPE_BROADCAST;
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_REJECT);
+	KUNIT_EXPECT_EQ(test, twt->control, 0);
+
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64, 0);
+	twt->control = IEEE80211_TWT_CONTROL_WAKE_DUR_UNIT;
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_REJECT);
+	KUNIT_EXPECT_EQ(test, twt->control, IEEE80211_TWT_CONTROL_WAKE_DUR_UNIT);
+
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64, 0);
+	p = mt7915_test_twt_params(twt);
+	p->req_type &= ~cpu_to_le16(IEEE80211_TWT_REQTYPE_IMPLICIT);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_REJECT);
+
+	/* the device's agreement table is full */
+	dev->twt.n_agrt = MT7915_MAX_TWT_AGRT;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64, 0);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_REJECT);
+	dev->twt.n_agrt = 0;
+
+	/* the station has all its flows */
+	a->twt.flowid_mask = GENMASK(MT7915_MAX_STA_TWT_AGRT - 1, 0);
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64, 0);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_REJECT);
+	a->twt.flowid_mask = 0;
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	/* shorter than the firmware's minimum: dictate the minimum */
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 32, 0);
+	p = mt7915_test_twt_params(twt);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt),
+			TWT_SETUP_CMD_DICTATE);
+	KUNIT_EXPECT_EQ(test, p->min_twt_dur, MT7915_MIN_TWT_DUR);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	/* the firmware says no */
+	fake->mcu_ret = -EIO;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64, 0);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_REJECT);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->twt_list));
+	KUNIT_EXPECT_EQ(test, a->twt.flowid_mask, 0);
+	KUNIT_EXPECT_EQ(test, dev->twt.table_mask, 0);
+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 0);
+	fake->mcu_ret = 0;
+
+	/* a flow the station already has */
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64,
+				  IEEE80211_TWT_REQTYPE_TRIGGER);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_ASSERT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ACCEPT);
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64,
+				  IEEE80211_TWT_REQTYPE_TRIGGER);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_REJECT);
+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 1);
+	KUNIT_EXPECT_EQ(test, a->twt.flowid_mask, BIT(0));
+}
+
+/* Flows differing in any parameter aren't duplicates; unused flow slots
+ * aren't compared.
+ */
+static void mt7915_test_twt_not_duplicate(struct kunit *test)
+{
+	static const struct {
+		u8 exp, dur;
+		u16 mantissa, flags;
+	} req[] = {
+		{ 10, 64, 1024, 0 },
+		{ 10, 64, 1024, IEEE80211_TWT_REQTYPE_TRIGGER },
+		{ 10, 64, 1024, IEEE80211_TWT_REQTYPE_FLOWTYPE },
+		{ 10, 64, 1024, IEEE80211_TWT_REQTYPE_PROTECTION },
+		{ 11, 64, 1024, 0 },
+		{ 10, 65, 1024, 0 },
+		{ 10, 64, 1000, 0 },
+	};
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *a = mt7915_test_sta(test, dev, 9, mvif);
+	struct ieee80211_twt_setup *twt;
+	int i;
+
+	mt7915_test_tsf(dev, 1 << 30);
+	for (i = 0; i < ARRAY_SIZE(req); i++) {
+		twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST,
+					  req[i].exp, req[i].mantissa,
+					  req[i].dur, req[i].flags);
+		mt7915_mac_add_twt_setup(dev->mt76.hw, mt7915_test_to_sta(a),
+					 twt);
+		KUNIT_EXPECT_EQ_MSG(test, mt7915_test_twt_answer(twt),
+				    TWT_SETUP_CMD_ACCEPT, "request %d", i);
+	}
+	KUNIT_EXPECT_EQ(test, a->twt.flowid_mask, GENMASK(6, 0));
+
+	/* slot 0 freed: a new flow takes it, the others are still compared */
+	mutex_lock(&dev->mt76.mutex);
+	mt7915_mac_twt_teardown_flow(dev, a, 0);
+	mutex_unlock(&dev->mt76.mutex);
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64,
+				  IEEE80211_TWT_REQTYPE_TRIGGER);
+	mt7915_mac_add_twt_setup(dev->mt76.hw, mt7915_test_to_sta(a), twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_REJECT);
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 12, 1024, 64, 0);
+	mt7915_mac_add_twt_setup(dev->mt76.hw, mt7915_test_to_sta(a), twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ACCEPT);
+	KUNIT_EXPECT_EQ(test, a->twt.flow[0].exp, 12);
+}
+
+static void mt7915_test_twt_flow(struct mt7915_twt_flow *f, bool sched,
+				 u64 start, u32 dur)
+{
+	memset(f, 0, sizeof(*f));
+	INIT_LIST_HEAD(&f->list);
+	f->sched = sched;
+	f->start_tsf = start;
+	f->duration = dur;
+}
+
+/* The AP's schedule: flows in start order, each new one placed in the
+ * first gap long enough for its wake period, or at the end.
+ */
+static void mt7915_test_twt_schedule(struct kunit *test)
+{
+	struct mt7915_twt_flow *f;
+	struct mt7915_dev *dev;
+
+	f = kunit_kcalloc(test, 6, sizeof(*f), GFP_KERNEL);
+	dev = kunit_kzalloc(test, sizeof(*dev), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, dev);
+	INIT_LIST_HEAD(&dev->twt_list);
+
+	/* empty schedule: at 0 */
+	mt7915_test_twt_flow(&f[0], true, 0, 64);
+	KUNIT_EXPECT_EQ(test, mt7915_mac_twt_sched_list_add(dev, &f[0]), 0);
+	f[0].start_tsf = 100000;
+
+	/* room before the first flow: first */
+	mt7915_test_twt_flow(&f[1], true, 0, 64);
+	KUNIT_EXPECT_EQ(test, mt7915_mac_twt_sched_list_add(dev, &f[1]), 0);
+	KUNIT_EXPECT_PTR_EQ(test, list_first_entry(&dev->twt_list,
+			    struct mt7915_twt_flow, list), &f[1]);
+
+	/* f[1] ends at 16384, f[0] starts at 100000: the gap fits one */
+	mt7915_test_twt_flow(&f[2], true, 0, 64);
+	KUNIT_EXPECT_EQ(test, mt7915_mac_twt_sched_list_add(dev, &f[2]), 16384);
+	KUNIT_EXPECT_PTR_EQ(test, list_next_entry(&f[1], list), &f[2]);
+	f[2].start_tsf = 16384;
+
+	/* f[2] ends at 32768: 5 * 16384 more doesn't fit before 100000, so
+	 * at the end, after f[0]'s wake period
+	 */
+	mt7915_test_twt_flow(&f[3], true, 0, 5 * 64);
+	KUNIT_EXPECT_EQ(test, mt7915_mac_twt_sched_list_add(dev, &f[3]),
+			100000 + 16384);
+	KUNIT_EXPECT_PTR_EQ(test, list_last_entry(&dev->twt_list,
+			    struct mt7915_twt_flow, list), &f[3]);
+
+	/* an unscheduled flow next in the list leaves room after this one */
+	list_del(&f[3].list);
+	mt7915_test_twt_flow(&f[4], false, 0, 64);
+	list_add(&f[4].list, &f[2].list);
+	mt7915_test_twt_flow(&f[5], true, 0, 64);
+	KUNIT_EXPECT_EQ(test, mt7915_mac_twt_sched_list_add(dev, &f[5]), 32768);
+	KUNIT_EXPECT_PTR_EQ(test, list_next_entry(&f[2], list), &f[5]);
+
+	/* an unscheduled flow first: the new one goes first */
+	INIT_LIST_HEAD(&dev->twt_list);
+	mt7915_test_twt_flow(&f[4], false, 0, 64);
+	list_add(&f[4].list, &dev->twt_list);
+	mt7915_test_twt_flow(&f[5], true, 0, 64);
+	KUNIT_EXPECT_EQ(test, mt7915_mac_twt_sched_list_add(dev, &f[5]), 0);
+	KUNIT_EXPECT_PTR_EQ(test, list_first_entry(&dev->twt_list,
+			    struct mt7915_twt_flow, list), &f[5]);
+}
+
+/* Teardown deletes the agreement in the firmware and frees the flow ID and
+ * table entry; even when the firmware fails, since this also runs when the
+ * station goes away. Unknown flow IDs are ignored.
+ */
+static void mt7915_test_twt_teardown(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *a = mt7915_test_sta(test, dev, 9, mvif);
+	struct mt7915_test_twt_agrt *req;
+	struct ieee80211_twt_setup *twt;
+	unsigned int n;
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10 + i,
+					  1024, 64, 0);
+		mt7915_mac_add_twt_setup(dev->mt76.hw, mt7915_test_to_sta(a),
+					 twt);
+		KUNIT_ASSERT_EQ(test, mt7915_test_twt_answer(twt),
+				TWT_SETUP_CMD_ACCEPT);
+	}
+
+	mutex_lock(&dev->mt76.mutex);
+	n = fake->n_msgs;
+	mt7915_mac_twt_teardown_flow(dev, a, MT7915_MAX_STA_TWT_AGRT);
+	mt7915_mac_twt_teardown_flow(dev, a, 5);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, n);
+
+	mt7915_mac_twt_teardown_flow(dev, a, 1);
+	req = mt7915_test_payload(mt76_test_msg(fake, n),
+				  struct mt7915_test_twt_agrt);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->cmd, MCU_TWT_AGRT_DELETE);
+	KUNIT_EXPECT_EQ(test, req->flowid, 1);
+	KUNIT_EXPECT_EQ(test, req->tbl_idx, 1);
+	KUNIT_EXPECT_EQ(test, a->twt.flowid_mask, BIT(0));
+	KUNIT_EXPECT_EQ(test, dev->twt.table_mask, BIT(0));
+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 1);
+	KUNIT_EXPECT_TRUE(test, list_empty(&a->twt.flow[1].list));
+
+	fake->mcu_ret = -EIO;
+	mt7915_mac_twt_teardown_flow(dev, a, 0);
+	mutex_unlock(&dev->mt76.mutex);
+	KUNIT_EXPECT_EQ(test, a->twt.flowid_mask, 0);
+	KUNIT_EXPECT_EQ(test, dev->twt.table_mask, 0);
+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->twt_list));
+}
