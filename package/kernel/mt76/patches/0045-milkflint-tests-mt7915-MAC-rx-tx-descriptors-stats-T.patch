+/* Group-addressed frames from a station are accounted to the interface's
+ * own entry (they aren't per-station traffic) and never reordered; with
+ * no station or no interface behind the entry there's none.
+ */
+static void mt7915_test_rx_group_addressed(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *msta = mt7915_test_sta(test, dev, 9, mvif);
+	struct mt7915_sta *lone = mt7915_test_sta(test, dev, 10, NULL);
+	struct mt7915_test_frame f;
+	struct mt7915_test_rxd d;
+	struct mt76_rx_status *s;
+	struct sk_buff *skb;
+
+	mvif->sta.wcid.idx = 11;
+	rcu_assign_pointer(dev->mt76.wcid[11], &mvif->sta.wcid);
+	mt7915_test_qos_frame(&f, 0, 1, 0);
+
+	mt7915_test_rxd_init(&d, 9, 0, false);
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	s = (struct mt76_rx_status *)skb->cb;
+	KUNIT_EXPECT_PTR_EQ(test, s->wcid, &mvif->sta.wcid);
+	KUNIT_EXPECT_FALSE(test, s->aggr);
+	KUNIT_EXPECT_FALSE(test, mt7915_test_polled(dev, &msta->wcid));
+	kfree_skb(skb);
+
+	/* the interface entry itself is no station */
+	mt7915_test_rxd_init(&d, 11, 0, false);
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	KUNIT_EXPECT_NULL(test, ((struct mt76_rx_status *)skb->cb)->wcid);
+	kfree_skb(skb);
+
+	mt7915_test_rxd_init(&d, 10, 0, false);
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+	KUNIT_EXPECT_NULL(test, ((struct mt76_rx_status *)skb->cb)->wcid);
+	KUNIT_EXPECT_FALSE(test, mt7915_test_polled(dev, &lone->wcid));
+	kfree_skb(skb);
+}
