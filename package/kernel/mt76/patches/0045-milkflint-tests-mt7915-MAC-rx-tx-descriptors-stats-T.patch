+/* IRPI histogram counts per chain, returned for the MT7916 IRPI registers
+ * of one band.
+ */
+struct mt7915_test_irpi {
+	u8 band;
+	u32 count[4][11];
+};
+
+static u32 mt7915_test_irpi_hook(struct mt76_test_fake *fake, u32 addr,
+				 u32 val)
+{
+	struct mt7915_test_irpi *irpi = fake->priv;
+	u32 bus = mt7915_test_l2_addr(fake, addr);
+	int nss;
+
+	for (nss = 0; bus && nss < 4; nss++) {
+		u32 base = MT_WF_IRPI_NSS_MT7916(irpi->band, nss);
+
+		if (bus >= base && bus < base + 11 * 4)
+			return irpi->count[nss][(bus - base) / 4];
+	}
+
+	return val;
+}
