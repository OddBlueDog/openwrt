+/* Noise floor measurement: IRPI clear-and-count and IPI enabled in the
+ * MT7916-layout PHY registers of the band asked for.
+ */
+static void mt7915_test_enable_nf(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_test_l2_log *log;
+
+	log = kunit_kzalloc(test, sizeof(*log), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, log);
+	fake->priv = log;
+	fake->rr_hook = mt7915_test_l2_log_hook;
+
+	mt7915_mac_enable_nf(dev, 1);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_l2_logged(log,
+			  MT_WF_PHY_RXTD12_MT7916(1)));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_l2_logged(log,
+			  MT_WF_PHY_RX_CTRL1_MT7916(1)));
+	KUNIT_EXPECT_FALSE(test, mt7915_test_l2_logged(log,
