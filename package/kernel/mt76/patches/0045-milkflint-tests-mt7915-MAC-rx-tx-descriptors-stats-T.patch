+/* GET_MIB_INFO answers: non-Wi-Fi, tx, rx and OBSS airtime */
+static void mt7915_test_mib_reply(struct mt76_test_fake *fake,
+				  const struct mt76_test_msg *msg,
+				  struct sk_buff *reply)
+{
+	struct mt7915_mcu_mib res[4] = {};
+	int i;
+
+	if (msg->cmd != MCU_EXT_CMD(GET_MIB_INFO))
+		return;
+	for (i = 0; i < 4; i++)
+		res[i].data = cpu_to_le64(100 * (i + 1));
+	skb_put_data(reply, res, sizeof(res));
+}
