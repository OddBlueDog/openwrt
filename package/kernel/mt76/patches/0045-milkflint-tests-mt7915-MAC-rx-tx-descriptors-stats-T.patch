+/* --- beacons after a reset ---------------------------------------------- */
+
+/* After a reset the beacon state of AP, mesh and IBSS interfaces is sent to
+ * the firmware again; stations have none.
+ */
+static void mt7915_test_update_vif_beacon(struct kunit *test)
+{
+	static const enum nl80211_iftype types[] = {
+		NL80211_IFTYPE_AP, NL80211_IFTYPE_MESH_POINT,
+		NL80211_IFTYPE_ADHOC, NL80211_IFTYPE_STATION,
+		NL80211_IFTYPE_MONITOR,
+	};
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 2);
+	struct ieee80211_vif *vif = mt7915_test_to_vif(mvif);
+	struct mt76_test_msg *msg;
+	int i;
+
+	/* no interfaces up: nothing to do */
+	mt7915_test_band1(test, env);
+	mt7915_update_beacons(dev);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	for (i = 0; i < ARRAY_SIZE(types); i++) {
+		vif->type = types[i];
