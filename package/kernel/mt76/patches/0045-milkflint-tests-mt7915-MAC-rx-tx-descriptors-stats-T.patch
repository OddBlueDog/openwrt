+/* --- the MT7915's own register layout and firmware steps ---------------- */
+
+/* The MT7915 (PCIe, not on the router; cheap to cover) has narrower MIB
+ * counters, per-AC MPDU retry/RTS registers, two A-MPDU histogram blocks
+ * and its beamforming counters in the ETBF block.
+ */
+static void mt7915_test_mib_stats_mt7915(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env_chip(test, 0x7915);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_mib_stats *mib = &dev->phy.mib;
+	u32 *aggr = dev->mphy.aggr_stats;
+	u32 ba_miss = 0, ack_fail = 0, rts = 0, rts_retries = 0;
+	int i;
+
+	KUNIT_ASSERT_TRUE(test, is_mt7915(&dev->mt76));
+	mt76_wr(dev, MT_MIB_SDR3(0), MIB_V(1));
+	mt76_wr(dev, MT_MIB_SDR10(0), 0xffffffff);
+	mt76_wr(dev, MT_MIB_SDR14(0), 0xffffffff);
+	mt76_wr(dev, MT_MIB_SDR29(0), MIB_V(2));
+	mt76_wr(dev, MT_MIB_SDRVEC(0), MIB_V(3));
+	for (i = 0; i < 4; i++) {
+		mt76_wr(dev, MT_MIB_MB_SDR1(0, i << 4), MIB_V(10 + i));
+		mt76_wr(dev, MT_MIB_MB_SDR0(0, i << 4), MIB_V(20 + i));
+		mt76_wr(dev, MT_TX_AGG_CNT(0, i), MIB_V(30 + i));
+		mt76_wr(dev, MT_TX_AGG_CNT2(0, i), MIB_V(40 + i));
+		ba_miss += MIB_LO(10 + i);
+		ack_fail += MIB_HI(10 + i);
+		rts += MIB_LO(20 + i);
+		rts_retries += MIB_HI(20 + i);
+	}
+	mt76_wr(dev, MT_MIB_SDR32(0), MIB_V(50));
+	mt76_wr(dev, MT_ETBF_TX_APP_CNT(0), MIB_V(51));
+	mt76_wr(dev, MT_ETBF_TX_NDP_BFRP(0), MIB_V(52));
+	/* all 4, HE 3, VHT 2, HT 1 */
+	mt76_wr(dev, MT_ETBF_RX_FB_CNT(0), 0x04030201);
+
+	mt7915_mac_update_stats(&dev->phy);
+
+	KUNIT_EXPECT_EQ(test, mib->fcs_err_cnt, MIB_LO(1));
+	KUNIT_EXPECT_EQ(test, mib->rx_mrdy_cnt, GENMASK(25, 0));
+	KUNIT_EXPECT_EQ(test, mib->tx_mpdu_attempts_cnt, GENMASK(23, 0));
+	KUNIT_EXPECT_EQ(test, mib->rx_pfdrop_cnt, MIB_LO(2) & 0xff);
+	KUNIT_EXPECT_EQ(test, mib->rx_vec_queue_overflow_drop_cnt, MIB_LO(3));
+	KUNIT_EXPECT_EQ(test, mib->ba_miss_cnt, ba_miss);
+	KUNIT_EXPECT_EQ(test, mib->ack_fail_cnt, ack_fail);
+	KUNIT_EXPECT_EQ(test, mib->rts_cnt, rts);
+	KUNIT_EXPECT_EQ(test, mib->rts_retries_cnt, rts_retries);
+	for (i = 0; i < 4; i++) {
+		KUNIT_EXPECT_EQ(test, aggr[2 * i], MIB_LO(30 + i));
+		KUNIT_EXPECT_EQ(test, aggr[2 * i + 1], MIB_HI(30 + i));
+		KUNIT_EXPECT_EQ(test, aggr[8 + 2 * i], MIB_LO(40 + i));
+		KUNIT_EXPECT_EQ(test, aggr[8 + 2 * i + 1], MIB_HI(40 + i));
+	}
+	KUNIT_EXPECT_EQ(test, mib->tx_pkt_ebf_cnt, MIB_LO(50));
+	KUNIT_EXPECT_EQ(test, mib->tx_bf_ibf_ppdu_cnt, MIB_HI(51));
+	KUNIT_EXPECT_EQ(test, mib->tx_bf_ebf_ppdu_cnt, MIB_LO(51));
+	KUNIT_EXPECT_EQ(test, mib->tx_bf_fb_cpl_cnt, MIB_HI(52));
+	KUNIT_EXPECT_EQ(test, mib->tx_bf_fb_trig_cnt, MIB_LO(52));
+	KUNIT_EXPECT_EQ(test, mib->tx_bf_rx_fb_all_cnt, 4);
+	KUNIT_EXPECT_EQ(test, mib->tx_bf_rx_fb_he_cnt, 3);
+	KUNIT_EXPECT_EQ(test, mib->tx_bf_rx_fb_vht_cnt, 2);
+	KUNIT_EXPECT_EQ(test, mib->tx_bf_rx_fb_ht_cnt, 1);
+}
+
+/* MIB SDRn sits at 0x008 + 4 * n on the MT7915: SDR32 (explicit
+ * beamforming) at 0x088, SDR33 (implicit) at 0x08c. The implicit count
+ * must come from SDR33.
+ */
+static void mt7915_test_mib_ibf_mt7915(struct kunit *test)
+{
+	struct mt7915_test_env *env;
+	struct mt7915_dev *dev;
+
+	kunit_skip(test, "driver bug: MT7915 MT_MIB_SDR33 is 0x088 (SDR32), "
+		   "should be 0x08c since 15f9f88b; IBF count reads EBF");
+
+	env = mt7915_test_env_chip(test, 0x7915);
+	dev = env->dev;
+	mt76_wr(dev, MT_WF_MIB(0, 0x088), 5);
+	mt76_wr(dev, MT_WF_MIB(0, 0x08c), 9);
+	mt7915_mac_update_stats(&dev->phy);
+	KUNIT_EXPECT_EQ(test, dev->phy.mib.tx_pkt_ebf_cnt, 5);
+	KUNIT_EXPECT_EQ(test, dev->phy.mib.tx_pkt_ibf_cnt, 9);
+}
