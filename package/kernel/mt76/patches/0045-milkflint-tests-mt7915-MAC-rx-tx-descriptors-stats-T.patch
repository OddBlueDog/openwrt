+/* band 0 on a radar channel with a monitor interface: detection active */
+static void mt7915_test_dfs_setup(struct mt7915_test_env *env, u8 region)
+{
+	struct mt7915_dev *dev = env->dev;
+
+	dev->mt76.region = region;
+	dev->mphy.cap.has_5ghz = true;
+	env->chan_5g.flags |= IEEE80211_CHAN_RADAR;
+	dev->mt76.hw->conf.flags |= IEEE80211_CONF_MONITOR;
+}
+
+/* Turning detection on (ETSI): the detector is stopped first (its state is
+ * unknown), the ETSI radar patterns and pulse thresholds are loaded, CAC
+ * and detection start; with nothing left to wait for, CAC ends at once.
+ * Off again: back to normal rx, detector stopped.
+ */
+static void mt7915_test_dfs_etsi(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_test_pulse_th *pulse;
+	struct mt7915_test_radar_th *th;
+	struct mt76_test_msg *msg;
+	int i;
+
+	mt7915_test_dfs_setup(env, NL80211_DFS_ETSI);
+	KUNIT_ASSERT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.dfs_state, MT_DFS_STATE_ACTIVE);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 1 + 16 + 1 + 3 + 1);
+
+	mt7915_test_expect_rdd(test, 0, RDD_STOP, 0);
+	for (i = 0; i < 16; i++) {
+		msg = mt76_test_msg(fake, 1 + i);
+		KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_RDD_TH));
+		th = mt7915_test_payload(msg, struct mt7915_test_radar_th);
+		KUNIT_ASSERT_NOT_NULL(test, th);
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(th->tag), 2);
+		KUNIT_EXPECT_EQ(test, le16_to_cpu(th->radar_type), i);
+		/* ETSI uses patterns 5..12 */
+		KUNIT_EXPECT_EQ(test, th->enb, i >= 5 && i <= 12);
+	}
+	th = mt7915_test_payload(mt76_test_msg(fake, 1 + 9),
+				 struct mt7915_test_radar_th);
+	KUNIT_EXPECT_EQ(test, th->stgr, 1);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(th->min_pri), 2490);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(th->max_pri), 3343);
+	KUNIT_EXPECT_EQ(test, th->max_pw, 14);
+	KUNIT_EXPECT_EQ(test, th->min_stgpn, 12);
+	KUNIT_EXPECT_EQ(test, th->max_stgpn, 32);
+	KUNIT_EXPECT_EQ(test, th->min_stgpr, 28);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(th->min_stgpr_diff), 126);
+
+	msg = mt76_test_msg(fake, 17);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_RDD_TH));
+	pulse = mt7915_test_payload(msg, struct mt7915_test_pulse_th);
+	KUNIT_ASSERT_NOT_NULL(test, pulse);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pulse->tag), 3);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pulse->max_width), 110);
+	KUNIT_EXPECT_EQ(test, (s32)le32_to_cpu(pulse->max_pwr), -10);
+	KUNIT_EXPECT_EQ(test, (s32)le32_to_cpu(pulse->min_pwr), -80);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pulse->min_stgr_pri), 40);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pulse->max_stgr_pri), 5200);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pulse->min_cr_pri), 128);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pulse->max_cr_pri), 5200);
+
+	mt7915_test_expect_rdd(test, 18, RDD_CAC_START, 0);
+	/* region code 0: ETSI */
+	mt7915_test_expect_rdd(test, 19, RDD_START, 0);
+	mt7915_test_expect_rdd(test, 20, RDD_DET_MODE, 1);
+	mt7915_test_expect_rdd(test, 21, RDD_CAC_END, 0);
+
+	/* nothing changed: nothing sent */
+	KUNIT_ASSERT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 22);
+
+	/* no DFS region any more */
+	dev->mt76.region = NL80211_DFS_UNSET;
+	KUNIT_ASSERT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.dfs_state, MT_DFS_STATE_DISABLED);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 24);
+	mt7915_test_expect_rdd(test, 22, RDD_NORMAL_START, 0);
+	mt7915_test_expect_rdd(test, 23, RDD_STOP, 0);
+}
+
+/* FCC also sets the minimum pulse count for type 5 (long) radars and uses
+ * region code 1, Japan region code 2 and its own patterns.
+ */
+static void mt7915_test_dfs_fcc_jp(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_test_radar_th *th;
+	struct mt76_test_msg *msg;
+	struct {
+		__le32 tag;
+		__le16 min_lpn;
+		u8 rsv[2];
+	} __packed *lpn;
+
+	mt7915_test_dfs_setup(env, NL80211_DFS_FCC);
+	KUNIT_ASSERT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 1 + 1 + 16 + 1 + 3 + 1);
+	msg = mt76_test_msg(fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_RDD_TH));
+	lpn = (void *)mt7915_test_payload(msg, typeof(*lpn));
+	KUNIT_ASSERT_NOT_NULL(test, lpn);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(lpn->tag), 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(lpn->min_lpn), 8);
+	/* FCC type 4 */
+	th = mt7915_test_payload(mt76_test_msg(fake, 2 + 4),
+				 struct mt7915_test_radar_th);
+	KUNIT_EXPECT_EQ(test, th->enb, 1);
+	KUNIT_EXPECT_EQ(test, th->max_crpn, 255);
+	KUNIT_EXPECT_EQ(test, th->max_crbn, 32);
+	mt7915_test_expect_rdd(test, 2 + 16 + 1 + 1, RDD_START, 1);
+
+	/* start over in Japan */
+	dev->mphy.dfs_state = MT_DFS_STATE_UNKNOWN;
+	dev->mt76.region = NL80211_DFS_JP;
+	KUNIT_ASSERT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 23 + 22);
+	th = mt7915_test_payload(mt76_test_msg(fake, 23 + 1 + 15),
+				 struct mt7915_test_radar_th);
+	KUNIT_EXPECT_EQ(test, th->enb, 1);
+	KUNIT_EXPECT_EQ(test, th->stgr, 1);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(th->min_pri), 15);
+	mt7915_test_expect_rdd(test, 23 + 1 + 16 + 1 + 1, RDD_START, 2);
+}
+
+/* An AP on a channel that still needs CAC: detection runs, CAC isn't
+ * ended. When the channel becomes usable, only CAC is ended.
+ */
+static void mt7915_test_dfs_cac(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	mt7915_test_dfs_setup(env, NL80211_DFS_ETSI);
+	dev->mt76.hw->conf.flags &= ~IEEE80211_CONF_MONITOR;
+	dev->mphy.radar_enabled = true;
+	/* cfg80211 looks the radar channel up in the wiphy's bands */
+	dev->mt76.hw->wiphy->bands[NL80211_BAND_5GHZ] =
+		&dev->mphy.sband_5g.sband;
+	KUNIT_ASSERT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.dfs_state, MT_DFS_STATE_CAC);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 21);
+	mt7915_test_expect_rdd(test, 18, RDD_CAC_START, 0);
+	mt7915_test_expect_rdd(test, 20, RDD_DET_MODE, 1);
+
+	/* now active (monitor on the radar channel) */
+	dev->mphy.radar_enabled = false;
+	dev->mt76.hw->conf.flags |= IEEE80211_CONF_MONITOR;
+	KUNIT_ASSERT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.dfs_state, MT_DFS_STATE_ACTIVE);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 22);
+	mt7915_test_expect_rdd(test, 21, RDD_CAC_END, 0);
+}
+
+/* fail the firmware command after the @at-th message from now */
+struct mt7915_test_fail_at {
+	unsigned int at;
+};
+
+static void mt7915_test_fail_reply(struct mt76_test_fake *fake,
+				   const struct mt76_test_msg *msg,
+				   struct sk_buff *reply)
+{
+	struct mt7915_test_fail_at *f = fake->priv;
+
+	if (fake->n_msgs + 1 == f->at)
+		fake->mcu_ret = -EIO;
+}
+
+/* A firmware error at any step of turning detection on is returned; when
+ * ending CAC fails the detector state is unknown, so the next call starts
+ * from scratch. No 5 GHz, no detector; an unknown region has no patterns.
+ */
+static void mt7915_test_dfs_errors(struct kunit *test)
+{
+	/* ETSI: 1 stop, 2..17 patterns, 18 pulse, 19 CAC start, 20 start,
+	 * 21 detection mode, 22 CAC end
+	 */
+	static const unsigned int steps[] = { 2, 18, 19, 20, 21, 22 };
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_test_fail_at f;
+	int i;
+
+	dev->mt76.region = NL80211_DFS_ETSI;
+	env->chan_5g.flags |= IEEE80211_CHAN_RADAR;
+	dev->mt76.hw->conf.flags |= IEEE80211_CONF_MONITOR;
+	KUNIT_EXPECT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.dfs_state, MT_DFS_STATE_UNKNOWN);
+
+	dev->mphy.cap.has_5ghz = true;
+	fake->priv = &f;
+	fake->reply = mt7915_test_fail_reply;
+	for (i = 0; i < ARRAY_SIZE(steps); i++) {
+		dev->mphy.dfs_state = MT_DFS_STATE_UNKNOWN;
+		f.at = fake->n_msgs + steps[i];
+		KUNIT_EXPECT_EQ_MSG(test,
+				    mt7915_dfs_init_radar_detector(&dev->phy),
+				    -EIO, "step %u", steps[i]);
+		KUNIT_EXPECT_EQ(test, dev->mphy.dfs_state,
+				MT_DFS_STATE_UNKNOWN);
+		fake->mcu_ret = 0;
+	}
+
+	/* FCC's extra threshold */
+	dev->mt76.region = NL80211_DFS_FCC;
+	f.at = fake->n_msgs + 2;
+	KUNIT_EXPECT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), -EIO);
+	fake->mcu_ret = 0;
+
+	/* turning it off: the first command fails */
+	dev->mphy.dfs_state = MT_DFS_STATE_ACTIVE;
+	dev->mt76.region = NL80211_DFS_UNSET;
+	f.at = 0;
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy), -EIO);
+	KUNIT_EXPECT_EQ(test, dev->mphy.dfs_state, MT_DFS_STATE_ACTIVE);
+	fake->mcu_ret = 0;
+	fake->reply = NULL;
+
+	/* a region the driver has no patterns for */
+	dev->mphy.dfs_state = MT_DFS_STATE_UNKNOWN;
+	dev->mt76.region = NL80211_DFS_JP + 1;
+	KUNIT_EXPECT_EQ(test, mt7915_dfs_init_radar_detector(&dev->phy),
+			-EINVAL);
+}
+
+/* --- rate control updates ----------------------------------------------- */
+
+static bool mt7915_test_has_tlv(const struct mt76_test_msg *msg, u16 tag)
+{
+	int off = sizeof(struct sta_req_hdr);
+
+	while (off + sizeof(struct tlv) <= msg->len) {
+		const struct tlv *t = (const struct tlv *)(msg->data + off);
+		u16 len = le16_to_cpu(t->len);
+
+		if (le16_to_cpu(t->tag) == tag)
+			return true;
+		if (len < sizeof(*t))
+			break;
+		off += len;
+	}
+	return false;
+}
+
+/* The rate control work sends what changed for each queued station:
+ * bandwidth, streams or rates as a new rate table (STA_REC_RA), SMPS as a
+ * WTBL update plus the firmware's MMPS mode. The queue ends up empty.
+ */
+static void mt7915_test_sta_rc_work(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *a = mt7915_test_sta(test, dev, 9, mvif);
+	struct mt7915_sta *b = mt7915_test_sta(test, dev, 10, mvif);
+	struct mt7915_sta *c = mt7915_test_sta(test, dev, 11, mvif);
+	struct cfg80211_bitrate_mask *mask = &mvif->bitrate_mask;
+	struct mt76_test_msg *msg;
+
+	/* mac80211's default mask: everything allowed, auto GI and LTF */
+	mask->control[NL80211_BAND_5GHZ].legacy = GENMASK(7, 0);
+	mask->control[NL80211_BAND_5GHZ].he_gi = GENMASK(7, 0);
+	mask->control[NL80211_BAND_5GHZ].he_ltf = GENMASK(7, 0);
+	mt7915_test_to_sta(a)->deflink.supp_rates[NL80211_BAND_5GHZ] = 0xff;
+
+	a->changed = IEEE80211_RC_BW_CHANGED;
+	b->changed = IEEE80211_RC_SMPS_CHANGED;
+	c->changed = 0;
+	list_add_tail(&a->rc_list, &dev->sta_rc_list);
+	list_add_tail(&b->rc_list, &dev->sta_rc_list);
+	list_add_tail(&c->rc_list, &dev->sta_rc_list);
+
+	mt7915_mac_sta_rc_work(&dev->rc_work);
+
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->sta_rc_list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&a->rc_list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&c->rc_list));
+	KUNIT_EXPECT_EQ(test, a->changed, 0);
+	KUNIT_EXPECT_EQ(test, b->changed, 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	KUNIT_EXPECT_EQ(test, msg->data[1], 9);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_has_tlv(msg, STA_REC_RA));
+
+	msg = mt76_test_msg(fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->data[1], 10);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_has_tlv(msg, STA_REC_WTBL));
+	KUNIT_EXPECT_FALSE(test, mt7915_test_has_tlv(msg, STA_REC_RA));
+	msg = mt76_test_msg(fake, 2);
+	KUNIT_EXPECT_EQ(test, msg->data[1], 10);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_has_tlv(msg, STA_REC_RA_UPDATE));
+
+	/* nothing queued: nothing sent */
+	mt7915_mac_sta_rc_work(&dev->rc_work);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 3);
+}
