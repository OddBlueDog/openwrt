+/* --- rx: what mt7915_queue_rx_skb() does with each packet type ---------- */
+
+/* A good data frame goes up to mac80211's rx path (mt76_rx's queue), a bad
+ * one is freed.
+ */
+static void mt7915_test_queue_rx_normal(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct sk_buff_head *q = &dev->mt76.rx_skb[MT_RXQ_MAIN];
+	struct mt7915_test_frame f;
+	struct mt7915_test_rxd d;
+	struct sk_buff *skb;
+
+	mt7915_test_qos_frame(&f, 0, 1, 0);
+	mt7915_test_rxd_init(&d, 0, 0, true);
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	mt7915_test_queue_rx(dev, skb);
+	KUNIT_ASSERT_EQ(test, skb_queue_len(q), 1);
+	KUNIT_EXPECT_PTR_EQ(test, skb_peek(q), skb);
+	KUNIT_EXPECT_EQ(test, skb->len, sizeof(f));
+
+	d.rxd[2] |= MT_RXD2_NORMAL_AMSDU_ERR;
+	skb = mt7915_test_rx_skb(test, &d, &f, sizeof(f));
+	skb_get(skb);
+	mt7915_test_queue_rx(dev, skb);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(q), 1);
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 1);
+	kfree_skb(skb);
+}
+
+/* Packets the driver has no use for (rx vectors without testmode, firmware
+ * monitor data with no relay open, unknown types) are freed.
+ */
+static void mt7915_test_queue_rx_dropped(struct kunit *test)
+{
+	static const u8 types[] = {
+		PKT_TYPE_TXRXV, PKT_TYPE_RX_FW_MONITOR, PKT_TYPE_RX_TMR,
+		PKT_TYPE_RETRIEVE,
+	};
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct sk_buff *skb;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(types); i++) {
+		skb = alloc_skb(128, GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, skb);
+		*(__le32 *)skb_put_zero(skb, 96) =
+			cpu_to_le32(FIELD_PREP(MT_RXD0_PKT_TYPE, types[i]));
+		skb_get(skb);
+		mt7915_test_queue_rx(dev, skb);
+		KUNIT_EXPECT_EQ_MSG(test, refcount_read(&skb->users), 1,
+				    "type %d", types[i]);
+		kfree_skb(skb);
+	}
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->mt76.rx_skb[MT_RXQ_MAIN]),
+			0);
+}
+
+/* Firmware events: a response goes to the command waiting for it, an
+ * unsolicited event (sequence number 0) is handled and freed.
+ */
+static void mt7915_test_queue_rx_event(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt76_connac2_mcu_rxd *rxd;
+	struct sk_buff *skb;
+
+	skb = alloc_skb(128, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	rxd = skb_put_zero(skb, sizeof(*rxd) + 8);
+	rxd->rxd[0] = cpu_to_le32(FIELD_PREP(MT_RXD0_PKT_TYPE,
+					     PKT_TYPE_RX_EVENT));
+	rxd->eid = 0x01;
+	rxd->seq = 3;
+	mt7915_test_queue_rx(dev, skb);
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&dev->mt76.mcu.res_q), 1);
+	KUNIT_EXPECT_PTR_EQ(test, skb_peek(&dev->mt76.mcu.res_q), skb);
+
+	skb = alloc_skb(128, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	rxd = skb_put_zero(skb, sizeof(*rxd) + 8);
+	rxd->rxd[0] = cpu_to_le32(FIELD_PREP(MT_RXD0_PKT_TYPE,
+					     PKT_TYPE_RX_EVENT));
+	rxd->eid = MCU_EVENT_EXT;
+	rxd->ext_eid = 0x7e;
+	skb_get(skb);
+	mt7915_test_queue_rx(dev, skb);
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 1);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->mt76.mcu.res_q), 1);
+	kfree_skb(skb);
+}
