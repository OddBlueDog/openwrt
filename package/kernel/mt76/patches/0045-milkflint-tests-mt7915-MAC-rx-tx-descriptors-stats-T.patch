+/* the @i-th message, which must be an RDD control command @ctrl */
+static void mt7915_test_expect_rdd(struct kunit *test, unsigned int i, u8 ctrl,
+				   u8 val)
+{
+	struct mt76_test_msg *msg = mt76_test_msg(mt76_test_fake, i);
+	struct mt7915_test_rdd *req;
+
+	KUNIT_ASSERT_NOT_NULL_MSG(test, msg, "message %u", i);
+	KUNIT_EXPECT_EQ_MSG(test, msg->cmd, MCU_EXT_CMD(SET_RDD_CTRL),
+			    "message %u", i);
+	req = mt7915_test_payload(msg, struct mt7915_test_rdd);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ_MSG(test, req->ctrl, ctrl, "message %u", i);
+	KUNIT_EXPECT_EQ_MSG(test, req->val, val, "message %u", i);
+	KUNIT_EXPECT_EQ(test, req->rdd_idx, MT_RDD_IDX_BAND0);
+}
