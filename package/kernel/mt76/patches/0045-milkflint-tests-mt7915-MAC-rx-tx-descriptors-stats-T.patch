+/* A-MSDU subframes are marked first/middle/last; the 2 bytes of padding the
+ * hardware puts after the 802.11 header of each subframe are removed.
+ */
+static void mt7915_test_rx_amsdu(struct kunit *test)
+{
+	static const struct {
+		u8 fmt;
+		bool first, last;
+	} sub[] = {
+		{ MT_RXD4_FIRST_AMSDU_FRAME, true, false },
+		{ MT_RXD4_MID_AMSDU_FRAME, false, false },
+		{ MT_RXD4_LAST_AMSDU_FRAME, false, true },
+	};
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_test_frame f;
+	struct mt7915_test_rxd d;
+	struct mt76_rx_status *s;
+	struct sk_buff *skb;
+	u8 buf[sizeof(f) + 2];
+	int i;
+
+	mt7915_test_qos_frame(&f, 0, 1, 0);
+	f.hdr.qos_ctrl |= cpu_to_le16(IEEE80211_QOS_CTL_A_MSDU_PRESENT);
+	memcpy(buf, &f.hdr, sizeof(f.hdr));
+	buf[sizeof(f.hdr)] = 0xee;
+	buf[sizeof(f.hdr) + 1] = 0xee;
+	memcpy(buf + sizeof(f.hdr) + 2, f.payload, sizeof(f.payload));
+
+	for (i = 0; i < ARRAY_SIZE(sub); i++) {
+		mt7915_test_rxd_init(&d, 0, 0, true);
+		d.rxd[4] = FIELD_PREP(MT_RXD4_NORMAL_PAYLOAD_FORMAT,
+				      sub[i].fmt);
+		skb = mt7915_test_rx_skb(test, &d, buf, sizeof(buf));
+		KUNIT_ASSERT_EQ(test, mt7915_test_fill_rx(dev, skb, 0), 0);
+		s = (struct mt76_rx_status *)skb->cb;
+		KUNIT_EXPECT_TRUE(test, s->amsdu);
+		KUNIT_EXPECT_EQ(test, (int)s->first_amsdu, sub[i].first);
+		KUNIT_EXPECT_EQ(test, (int)s->last_amsdu, sub[i].last);
+		KUNIT_ASSERT_EQ(test, skb->len, sizeof(f));
+		KUNIT_EXPECT_EQ(test, memcmp(skb->data, &f, sizeof(f)), 0);
+		kfree_skb(skb);
+	}
+}
