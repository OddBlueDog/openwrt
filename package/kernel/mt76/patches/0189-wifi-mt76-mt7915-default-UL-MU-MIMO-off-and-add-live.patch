+/* muru: the band's flags, one "<name> <0|1>" line each, as MilkFlint's rpcd
+ * reads them; a write returns what it took, or why it didn't
+ */
+static void mt7915_debugfs_test_muru(struct kunit *test)
+{
+	char line[] = "ofdma_dl=1 ofdma_ul=0 mimo_dl=1 mimo_ul=0\n";
+	struct mt7915_phy *phy;
+	struct mt7915_dev *dev;
+	char buf[64];
+
+	dev = kunit_kzalloc(test, sizeof(*dev), GFP_KERNEL);
+	phy = kunit_kzalloc(test, sizeof(*phy), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	mutex_init(&dev->mt76.mutex);
+	dev->mt76.rev = 0x79860000;
+	phy->dev = dev;
+
+	/* the defaults: download on, upload off */
+	KUNIT_EXPECT_EQ(test, mt7915_muru_show(phy, buf, sizeof(buf)),
+			(int)strlen("ofdma_dl 1\nofdma_ul 0\nmimo_dl 1\nmimo_ul 0\n"));
+	KUNIT_EXPECT_STREQ(test, buf,
+			   "ofdma_dl 1\nofdma_ul 0\nmimo_dl 1\nmimo_ul 0\n");
+
+	phy->muru_en = (MURU_DL_UL_EN_MASK << 4) | MURU_OFDMA_UL_EN |
+		       MURU_MIMO_UL_EN;
+	mt7915_muru_show(phy, buf, sizeof(buf));
+	KUNIT_EXPECT_STREQ(test, buf,
+			   "ofdma_dl 0\nofdma_ul 1\nmimo_dl 0\nmimo_ul 1\n");
+	/* the MT7915 has no UL MU-MIMO */
+	dev->mt76.rev = 0x79150000;
+	mt7915_muru_show(phy, buf, sizeof(buf));
+	KUNIT_EXPECT_STREQ(test, buf,
+			   "ofdma_dl 0\nofdma_ul 1\nmimo_dl 0\nmimo_ul 0\n");
+	dev->mt76.rev = 0x79860000;
+	phy->muru_en = 0;
+
+	/* the defaults written over the defaults: taken, nothing to send */
+	KUNIT_EXPECT_EQ(test, mt7915_muru_handler(NULL, NULL, line,
+						  strlen(line), phy),
+			(ssize_t)strlen(line));
+	KUNIT_EXPECT_EQ(test, phy->muru_en,
+			(MURU_DL_UL_EN_MASK << 4) | MURU_OFDMA_DL_EN |
+			MURU_MIMO_DL_EN);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_handler(NULL, NULL, "bogus 1", 7,
+						  phy), -EINVAL);
+	KUNIT_EXPECT_EQ(test, phy->muru_en,
+			(MURU_DL_UL_EN_MASK << 4) | MURU_OFDMA_DL_EN |
+			MURU_MIMO_DL_EN);
+}
