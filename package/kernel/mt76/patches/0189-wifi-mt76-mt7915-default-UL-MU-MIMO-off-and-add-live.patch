+/* Applying live MURU flags sends BSS subcmd 81 per AP/STA vif (skipping other
+ * types) and respects each BSS's MU beamformer capability; only APs count for
+ * the band's DL MU-MIMO.
+ */
+static void mt7915_main_test_muru_apply_iter(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct mt7915_phy *phy = mt7915_hw_phy(hw);
+	struct mt7915_muru_apply_data data = { .phy = phy };
+	struct mt7915_muru_apply_data sta_data = { .phy = phy };
+	struct mt7915_test_muru_dl_ul_req *req;
+	struct mt76_test_msg *msg;
+	struct ieee80211_vif *vif, *sta;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	memset(&mt7915_main_test_mvif(vif)->cap, 0,
+	       sizeof(mt7915_main_test_mvif(vif)->cap));
+	mt7915_main_test_clear(fake);
+
+	/* without MU beamformer cap, BSS mimo_dl stays off */
+	mt7915_muru_apply_iter(&data, vif->addr, vif);
+	KUNIT_ASSERT_EQ(test, mt76_test_count_msgs(fake, MCU_EXT_CMD(MURU_CTRL)), 1);
+	KUNIT_EXPECT_TRUE(test, data.has_ap);
+	KUNIT_EXPECT_FALSE(test, data.any_mimo_dl);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(MURU_CTRL));
+	req = (void *)msg->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->cmd), MURU_SET_DL_UL_EN);
+	KUNIT_EXPECT_EQ(test, req->type, MURU_DL_UL_TYPE_BSS);
+	KUNIT_EXPECT_EQ(test, req->val, MURU_OFDMA_DL_EN);
+
+	/* with HE MU beamformer cap, BSS mimo_dl is on */
+	mt7915_main_test_mvif(vif)->cap.he_mu_ebfer = true;
+	mt7915_main_test_clear(fake);
+	mt7915_muru_apply_iter(&data, vif->addr, vif);
+	KUNIT_EXPECT_TRUE(test, data.any_mimo_dl);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(MURU_CTRL));
+	req = (void *)msg->data;
+	KUNIT_EXPECT_EQ(test, req->val, MURU_OFDMA_DL_EN | MURU_MIMO_DL_EN);
+
+	/* monitor vifs are skipped */
+	vif->type = NL80211_IFTYPE_MONITOR;
+	mt7915_main_test_clear(fake);
+	mt7915_muru_apply_iter(&data, vif->addr, vif);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake, MCU_EXT_CMD(MURU_CTRL)), 0);
+
+	/* a station interface gets its BSS flags (with the caps
+	 * mt7915_add_interface() leaves it, all set) but doesn't count for the
+	 * band
+	 */
+	sta = mt7915_main_test_sdata(test, hw, NL80211_IFTYPE_STATION, 2);
+	mt7915_main_test_clear(fake);
+	mt7915_muru_apply_iter(&sta_data, sta->addr, sta);
+	KUNIT_ASSERT_EQ(test, mt76_test_count_msgs(fake, MCU_EXT_CMD(MURU_CTRL)), 1);
+	KUNIT_EXPECT_FALSE(test, sta_data.has_ap);
+	KUNIT_EXPECT_FALSE(test, sta_data.any_mimo_dl);
+	KUNIT_EXPECT_EQ(test, sta_data.err, 0);
+	req = (void *)mt76_test_find_msg(fake, MCU_EXT_CMD(MURU_CTRL))->data;
+	KUNIT_EXPECT_EQ(test, req->type, MURU_DL_UL_TYPE_BSS);
+	KUNIT_EXPECT_EQ(test, req->idx, mt7915_main_test_mvif(sta)->mt76.idx);
+	KUNIT_EXPECT_EQ(test, req->val, MURU_OFDMA_DL_EN | MURU_MIMO_DL_EN);
+
+	/* the first error is kept */
+	fake->mcu_ret = -EIO;
+	mt7915_muru_apply_iter(&sta_data, sta->addr, sta);
+	fake->mcu_ret = -ENOMEM;
+	mt7915_muru_apply_iter(&sta_data, sta->addr, sta);
+	fake->mcu_ret = 0;
+	KUNIT_EXPECT_EQ(test, sta_data.err, -EIO);
+}
