+static int mt7915_main_test_refuse_muru(struct mt76_test_fake *fake,
+					const struct mt76_test_msg *msg)
+{
+	return msg->cmd == MCU_EXT_CMD(MURU_CTRL) ? -EIO : 0;
+}
+
+/* The firmware refusing the MURU flags doesn't fail start_ap (the BSS runs on
+ * the firmware's own); it's marked, so the next write sends them again.
+ */
+static void mt7915_main_test_start_ap_muru_refused(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct mt7915_phy *phy = mt7915_hw_phy(hw);
+	struct ieee80211_vif *vif;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	vif->bss_conf.he_mu_beamformer = true;
+	mt7915_main_test_clear(fake);
+	fake->mcu_hook = mt7915_main_test_refuse_muru;
+
+	wiphy_lock(hw->wiphy);
+	KUNIT_EXPECT_EQ(test, mt7915_start_ap(hw, vif, &vif->bss_conf), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake, MCU_EXT_CMD(MURU_CTRL)), 2);
+	KUNIT_EXPECT_TRUE(test, phy->muru_unapplied);
+
+	fake->mcu_hook = NULL;
+	mt7915_main_test_clear(fake);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "ofdma_dl 1"), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake, MCU_EXT_CMD(MURU_CTRL)), 1);
+	KUNIT_EXPECT_FALSE(test, phy->muru_unapplied);
+	wiphy_unlock(hw->wiphy);
+}
