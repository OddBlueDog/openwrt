+	mt7915_main_test_clear(fake);
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_muru_apply(phy), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 4);
+	fake->mcu_ret = 0;
+	wiphy_unlock(hw->wiphy);
+}
