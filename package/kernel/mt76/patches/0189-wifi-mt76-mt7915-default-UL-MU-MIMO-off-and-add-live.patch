diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
index 7fa566cc..b64d87d2 100644
--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -1437,6 +1437,63 @@ static const struct file_operations mt7915_spatial_reuse_fops = {
 	.llseek = default_llseek,
 };
 
+/* The band's flags as set (a band without an MU beamformer AP still sends
+ * no DL MU-MIMO), one "<name> <0|1>" line each, as MilkFlint's rpcd reads them
+ */
+static int mt7915_muru_show(const struct mt7915_phy *phy, char *buf,
+			    size_t size)
+{
+	u8 flags = mt7915_muru_band_flags(phy);
+
+	return scnprintf(buf, size,
+			 "ofdma_dl %u\nofdma_ul %u\nmimo_dl %u\nmimo_ul %u\n",
+			 !!(flags & MURU_OFDMA_DL_EN),
+			 !!(flags & MURU_OFDMA_UL_EN),
+			 !!(flags & MURU_MIMO_DL_EN),
+			 !!(flags & MURU_MIMO_UL_EN));
+}
+
+static ssize_t
+mt7915_muru_read(struct file *file, char __user *userbuf,
+		 size_t count, loff_t *ppos)
+{
+	struct mt7915_phy *phy = file->private_data;
+	char buf[64];
+	int len;
+
+	len = mt7915_muru_show(phy, buf, sizeof(buf));
+
+	return simple_read_from_buffer(userbuf, count, ppos, buf, len);
+}
+
+static ssize_t
+mt7915_muru_handler(struct wiphy *wiphy, struct file *file, char *buf,
+		    size_t count, void *data)
+{
+	int ret = mt7915_muru_set_flags(data, buf);
+
+	return ret ? ret : count;
+}
+
+static ssize_t
+mt7915_muru_write(struct file *file, const char __user *userbuf,
+		  size_t count, loff_t *ppos)
+{
+	struct mt7915_phy *phy = file->private_data;
+	char buf[64];
+
+	return wiphy_locked_debugfs_write(phy->mt76->hw->wiphy, file, buf,
+					  sizeof(buf), userbuf, count,
+					  mt7915_muru_handler, phy);
+}
+
+static const struct file_operations mt7915_muru_fops = {
+	.open = simple_open,
+	.read = mt7915_muru_read,
+	.write = mt7915_muru_write,
+	.llseek = default_llseek,
+};
+
 static const char * const mt7915_twt_trigger_names[] = {
 	[MT7915_TWT_TRIGGER_ALLOW] = "allow",
 	[MT7915_TWT_TRIGGER_NEVER] = "never",
@@ -1669,6 +1726,7 @@ int mt7915_init_debugfs(struct mt7915_phy *phy)
 
 	dir = mt76_register_debugfs_fops(phy->mt76, NULL);
 
+	debugfs_create_file("muru", 0600, dir, phy, &mt7915_muru_fops);
 	debugfs_create_file("muru_debug", 0600, dir, dev, &fops_muru_debug);
 	debugfs_create_file("muru_stats", 0400, dir, phy,
 			    &mt7915_muru_stats_fops);
diff --git a/mt7915/init.c b/mt7915/init.c
