+/* A BSS without MU beamforming starting next to one with it: the band keeps
+ * DL MU-MIMO for the other, the new BSS doesn't get it.
+ */
+static void mt7915_main_test_start_ap_muru_other_ap(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct mt7915_test_muru_dl_ul_req *band_req, *bss_req;
+	struct ieee80211_vif *ap, *ap2;
+
+	ap = mt7915_main_test_sdata_ap(test, hw, 1);
+	ap2 = mt7915_main_test_sdata_ap(test, hw, 2);
+	mt7915_main_test_sdata_up(test, ap);
+	mt7915_main_test_sdata_up(test, ap2);
+	memset(&mt7915_main_test_mvif(ap)->cap, 0,
+	       sizeof(mt7915_main_test_mvif(ap)->cap));
+	mt7915_main_test_mvif(ap)->cap.he_mu_ebfer = true;
+	ap2->bss_conf.vht_mu_beamformer = false;
+	ap2->bss_conf.he_mu_beamformer = false;
+
+	wiphy_lock(hw->wiphy);
+	mt7915_main_test_clear(fake);
+	KUNIT_ASSERT_EQ(test, mt7915_start_ap(hw, ap2, &ap2->bss_conf), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 5);
+	band_req = (void *)mt76_test_msg(fake, 3)->data;
+	bss_req = (void *)mt76_test_msg(fake, 4)->data;
+	KUNIT_EXPECT_EQ(test, band_req->type, MURU_DL_UL_TYPE_BAND);
+	KUNIT_EXPECT_EQ(test, band_req->val, MURU_OFDMA_DL_EN | MURU_MIMO_DL_EN);
+	KUNIT_EXPECT_EQ(test, bss_req->type, MURU_DL_UL_TYPE_BSS);
+	KUNIT_EXPECT_EQ(test, bss_req->idx, mt7915_main_test_mvif(ap2)->mt76.idx);
+	KUNIT_EXPECT_EQ(test, bss_req->val, MURU_OFDMA_DL_EN);
+
+	/* the other one is a station interface (caps all set): it doesn't
+	 * count, the band's goes off
+	 */
+	ap->type = NL80211_IFTYPE_STATION;
+	mt7915_main_test_mvif(ap)->cap.vht_mu_ebfer = true;
+	mt7915_main_test_clear(fake);
+	KUNIT_ASSERT_EQ(test, mt7915_start_ap(hw, ap2, &ap2->bss_conf), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 5);
+	band_req = (void *)mt76_test_msg(fake, 3)->data;
+	KUNIT_EXPECT_EQ(test, band_req->val, MURU_OFDMA_DL_EN);
+	ap->type = NL80211_IFTYPE_AP;
+	wiphy_unlock(hw->wiphy);
+}
