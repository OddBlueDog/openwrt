+/* start_ap updates both band and BSS MURU flags so turning MU-MIMO off on
+ * wifi reload takes effect in firmware without rebooting.
+ */
+static void mt7915_main_test_start_ap_muru_off(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct mt7915_test_muru_dl_ul_req *band_req, *bss_req;
+	struct ieee80211_vif *vif;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	mt7915_main_test_clear(fake);
+	vif->bss_conf.vht_mu_beamformer = false;
+	vif->bss_conf.he_mu_beamformer = false;
+
+	/* as mac80211 calls it: the interface walk needs the wiphy lock */
+	wiphy_lock(hw->wiphy);
+	KUNIT_ASSERT_EQ(test, mt7915_start_ap(hw, vif, &vif->bss_conf), 0);
+	wiphy_unlock(hw->wiphy);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 5);
+	band_req = (void *)mt76_test_msg(fake, 3)->data;
+	bss_req = (void *)mt76_test_msg(fake, 4)->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(band_req->cmd), MURU_SET_DL_UL_EN);
+	KUNIT_EXPECT_EQ(test, band_req->type, MURU_DL_UL_TYPE_BAND);
+	KUNIT_EXPECT_EQ(test, band_req->val, MURU_OFDMA_DL_EN);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(bss_req->cmd), MURU_SET_DL_UL_EN);
+	KUNIT_EXPECT_EQ(test, bss_req->type, MURU_DL_UL_TYPE_BSS);
+	KUNIT_EXPECT_EQ(test, bss_req->val, MURU_OFDMA_DL_EN);
+}
