+	 */
+	dev->mt76.rev = 0x79150000;
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy,
+			"ofdma_dl=0 ofdma_ul=0 mimo_dl=1 mimo_ul=1"), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_band_flags(phy), MURU_MIMO_DL_EN);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_muru_applied, 6);
+	/* there mimo_ul alone changes nothing the firmware has */
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "mimo_ul 0"), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_muru_applied, 6);
+	dev->mt76.rev = 0x79860000;
+	wiphy_unlock(hw->wiphy);
