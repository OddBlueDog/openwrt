+/* With only station interfaces, or none, the band's DL MU-MIMO stays as set:
+ * no AP says otherwise.
+ */
+static void mt7915_main_test_muru_apply_no_ap(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct mt7915_phy *phy = mt7915_hw_phy(hw);
+	struct mt7915_test_muru_dl_ul_req *req;
+	struct ieee80211_vif *sta;
+
+	wiphy_lock(hw->wiphy);
+	mt7915_main_test_clear(fake);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_apply(phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 1);
+	req = (void *)mt76_test_msg(fake, 0)->data;
+	KUNIT_EXPECT_EQ(test, req->type, MURU_DL_UL_TYPE_BAND);
+	KUNIT_EXPECT_EQ(test, req->val, MURU_OFDMA_DL_EN | MURU_MIMO_DL_EN);
+
+	sta = mt7915_main_test_sdata(test, hw, NL80211_IFTYPE_STATION, 1);
+	mt7915_main_test_sdata_up(test, sta);
+	memset(&mt7915_main_test_mvif(sta)->cap, 0,
+	       sizeof(mt7915_main_test_mvif(sta)->cap));
+	mt7915_main_test_clear(fake);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_apply(phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	req = (void *)mt76_test_msg(fake, 0)->data;
+	KUNIT_EXPECT_EQ(test, req->type, MURU_DL_UL_TYPE_BSS);
+	KUNIT_EXPECT_EQ(test, req->val, MURU_OFDMA_DL_EN);
+	req = (void *)mt76_test_msg(fake, 1)->data;
+	KUNIT_EXPECT_EQ(test, req->type, MURU_DL_UL_TYPE_BAND);
+	KUNIT_EXPECT_EQ(test, req->val, MURU_OFDMA_DL_EN | MURU_MIMO_DL_EN);
+	wiphy_unlock(hw->wiphy);
+}
