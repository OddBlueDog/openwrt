+	KUNIT_EXPECT_EQ(test, req->type, MURU_DL_UL_TYPE_BAND);
+	KUNIT_EXPECT_EQ(test, req->val, MURU_OFDMA_DL_EN);
+
+	/* a station interface on the band, its caps all set, doesn't keep the
+	 * band's on either
+	 */
+	sta = mt7915_main_test_sdata(test, hw, NL80211_IFTYPE_STATION, 3);
+	mt7915_main_test_sdata_up(test, sta);
+	mt7915_main_test_clear(fake);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_apply(phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 4);
+	req = (void *)mt76_test_msg(fake, 2)->data;
+	KUNIT_EXPECT_EQ(test, req->idx, mt7915_main_test_mvif(sta)->mt76.idx);
+	KUNIT_EXPECT_EQ(test, req->val, MURU_OFDMA_DL_EN | MURU_MIMO_DL_EN);
+	req = (void *)mt76_test_msg(fake, 3)->data;
+	KUNIT_EXPECT_EQ(test, req->type, MURU_DL_UL_TYPE_BAND);
+	KUNIT_EXPECT_EQ(test, req->val, MURU_OFDMA_DL_EN);
