+/* Live MURU DL/UL enable command (subcmd 81): 8-byte payload with type
+ * (band or BSS), index, 4-bit mask and masked value.
+ */
+static void mt7915_test_mcu_set_muru_dl_ul(struct kunit *test)
+{
+	struct mt7915_test_muru_dl_ul_req {
+		__le32 cmd;
+		u8 type;
+		u8 idx;
+		u8 mask;
+		u8 val;
+	} __packed;
+	struct mt7915_test_muru_dl_ul_req *req;
+	struct mt76_test_msg *msg;
