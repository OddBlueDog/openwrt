+/* Parsing, per-band isolation, MT7915 guard, no-op skip and retry after error. */
+static void mt7915_main_test_muru_set_flags(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct mt7915_phy *phy = mt7915_hw_phy(hw);
+	struct mt7915_phy *phy2 = mt7915_hw_phy(mt7915_main_test_hw2(dev));
+
+	mt7915_main_test_muru_applied = 0;
+	mt7915_main_test_muru_apply_ret = 0;
+	kunit_activate_static_stub(test, mt7915_muru_apply,
+				   mt7915_main_test_muru_apply_stub);
+
+	KUNIT_EXPECT_EQ(test, mt7915_muru_band_flags(phy),
+			MURU_OFDMA_DL_EN | MURU_MIMO_DL_EN);
+
+	wiphy_lock(hw->wiphy);
+	/* invalid inputs leave flags and apply count untouched */
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, ""), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "   "), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "\n"), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "bogus 1"), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "mimo_ul 2"), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "mimo_ul 1 extra"),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "mimo_ul=yes"),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "ofdma_dl=1 extra"),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_muru_applied, 0);
+
+	/* single-pair and multi-token writes */
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "mimo_ul 1\n"), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_band_flags(phy),
+			MURU_OFDMA_DL_EN | MURU_MIMO_DL_EN | MURU_MIMO_UL_EN);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_muru_applied, 1);
+
+	/* writing the same state skips firmware update */
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "mimo_ul=1"), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_muru_applied, 1);
+
+	/* atomic multi-flag write; other band stays at defaults */
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy,
+			"ofdma_dl=0 ofdma_ul=1 mimo_dl=0 mimo_ul=0\n"), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_band_flags(phy), MURU_OFDMA_UL_EN);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_band_flags(phy2),
+			MURU_OFDMA_DL_EN | MURU_MIMO_DL_EN);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_muru_applied, 2);
+
+	/* firmware error marks unapplied so the same write retries */
+	mt7915_main_test_muru_apply_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "ofdma_dl 1"), -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_muru_applied, 3);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "ofdma_dl 1"), -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_muru_applied, 4);
+	mt7915_main_test_muru_apply_ret = 0;
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "ofdma_dl 1"), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_muru_applied, 5);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_set_flags(phy, "ofdma_dl 1"), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_muru_applied, 5);
+
+	/* the MT7915 has no UL MU-MIMO: mimo_ul=1 is taken but stays off, and
