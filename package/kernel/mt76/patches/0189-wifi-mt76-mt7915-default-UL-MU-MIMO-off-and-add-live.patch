--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -1071,7 +1071,7 @@ mt7915_set_stream_he_txbf_caps(struct mt7915_phy *phy,
 	elem->phy_cap_info[7] &= ~c;
 
 	c = IEEE80211_HE_PHY_CAP2_NDP_4x_LTF_AND_3_2US;
-	if (!is_mt7915(&dev->mt76))
+	if (!is_mt7915(&dev->mt76) && READ_ONCE(mt7915_muru_mimo_ul))
 		c |= IEEE80211_HE_PHY_CAP2_UL_MU_FULL_MU_MIMO;
 	elem->phy_cap_info[2] |= c;
 
diff --git a/mt7915/main.c b/mt7915/main.c
index e021a879..90d4eea0 100644
--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -725,6 +725,51 @@ mt7915_vif_check_caps(struct mt7915_phy *phy, struct ieee80211_vif *vif)
 	vc->he_mu_ebfer = vif->bss_conf.he_mu_beamformer;
 }
 
+/* Whether the band keeps DL MU-MIMO goes by its access points alone: an AP
+ * sends it, a station interface doesn't, and a station's caps are never read
+ * (they stay all set from mt7915_add_interface()).
+ */
+static void mt7915_muru_any_mimo_dl_iter(void *data, u8 *mac,
+					 struct ieee80211_vif *vif)
+{
+	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
+	bool *any = data;
+
+	if (vif->type == NL80211_IFTYPE_AP &&
+	    (mvif->cap.he_mu_ebfer || mvif->cap.vht_mu_ebfer))
+		*any = true;
+}
+
+static void mt7915_muru_update_vif(struct mt7915_phy *phy,
+				   struct ieee80211_vif *vif)
+{
+	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
+	struct mt7915_dev *dev = phy->dev;
+	u8 band_flags = mt7915_muru_band_flags(phy);
+	u8 bss_flags = mt7915_muru_bss_flags(phy, vif);
+	int ret, bss_ret;
+
+	if ((band_flags & MURU_MIMO_DL_EN) && !(bss_flags & MURU_MIMO_DL_EN)) {
+		bool any = false;
+
+		ieee80211_iterate_active_interfaces_mtx(phy->mt76->hw,
+							IEEE80211_IFACE_ITER_NORMAL,
+							mt7915_muru_any_mimo_dl_iter,
+							&any);
+		if (!any)
+			band_flags &= ~MURU_MIMO_DL_EN;
+	}
+
+	ret = mt7915_mcu_set_muru_dl_ul(dev, MURU_DL_UL_TYPE_BAND,
+					phy->mt76->band_idx,
+					MURU_DL_UL_EN_MASK, band_flags);
+	bss_ret = mt7915_mcu_set_muru_dl_ul(dev, MURU_DL_UL_TYPE_BSS,
+					    mvif->mt76.idx,
+					    MURU_DL_UL_EN_MASK, bss_flags);
+	if (ret || bss_ret)
+		phy->muru_unapplied = true;
+}
+
 static int
 mt7915_start_ap(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 		struct ieee80211_bss_conf *link_conf)
@@ -741,6 +786,9 @@ mt7915_start_ap(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 	if (err)
 		goto out;
 	err = mt7915_mcu_add_sta(dev, vif, NULL, CONN_STATE_PORT_SECURE, false);
+	if (err)
+		goto out;
+	mt7915_muru_update_vif(phy, vif);
 out:
 	mutex_unlock(&dev->mt76.mutex);
 
@@ -2081,6 +2129,169 @@ int mt7915_spr_set_mode(struct mt7915_phy *phy, const char *name)
 	return ret;
 }
 
+static const char * const mt7915_muru_flag_names[] = {
+	[0] = "ofdma_dl",
+	[1] = "ofdma_ul",
+	[2] = "mimo_dl",
+	[3] = "mimo_ul",
+};
+
+static int mt7915_muru_parse_flag(const char *name, const char *val,
+				  u8 *mask, u8 *bits)
+{
+	int idx = match_string(mt7915_muru_flag_names,
+			       ARRAY_SIZE(mt7915_muru_flag_names), name);
+
+	if (idx < 0)
+		return -EINVAL;
+	if (!strcmp(val, "1"))
+		*bits |= BIT(idx);
+	else if (!strcmp(val, "0"))
+		*bits &= ~BIT(idx);
+	else
+		return -EINVAL;
+
+	*mask |= BIT(idx);
+	return 0;
+}
+
+static int mt7915_muru_parse_flags(const char *buf, u8 *mask, u8 *bits)
+{
+	char tmp[64], *p, *tok, *eq;
+	char name[16], val[8], extra[2];
+	int n;
+
+	if (strscpy(tmp, buf, sizeof(tmp)) < 0)
+		return -EINVAL;
+
+	*mask = 0;
+	*bits = 0;
+	p = strim(tmp);
+	if (!*p)
+		return -EINVAL;
+
+	if (!strchr(p, '=')) {
+		n = sscanf(p, "%15s %7s %1s", name, val, extra);
+		if (n != 2)
+			return -EINVAL;
+		return mt7915_muru_parse_flag(name, val, mask, bits);
+	}
+
+	while ((tok = strsep(&p, " \t\n\r")) != NULL) {
+		if (!*tok)
+			continue;
+		eq = strchr(tok, '=');
+		if (!eq)
+			return -EINVAL;
+		*eq = '\0';
+		if (mt7915_muru_parse_flag(tok, eq + 1, mask, bits))
+			return -EINVAL;
+	}
+
+	return *mask ? 0 : -EINVAL;
+}
+
+struct mt7915_muru_apply_data {
+	struct mt7915_phy *phy;
+	bool has_ap;		/* an AP interface is up */
+	bool any_mimo_dl;	/* and one of them sends DL MU-MIMO */
+	int err;
+};
+
+static void mt7915_muru_apply_iter(void *_data, u8 *mac,
+				   struct ieee80211_vif *vif)
+{
+	struct mt7915_muru_apply_data *data = _data;
+	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
+	u8 flags;
+	int ret;
+
+	if (vif->type != NL80211_IFTYPE_AP &&
+	    vif->type != NL80211_IFTYPE_STATION)
+		return;
+
+	flags = mt7915_muru_bss_flags(data->phy, vif);
+	/* the band's DL MU-MIMO goes by its APs, as in
+	 * mt7915_muru_any_mimo_dl_iter()
+	 */
+	if (vif->type == NL80211_IFTYPE_AP) {
+		data->has_ap = true;
+		if (flags & MURU_MIMO_DL_EN)
+			data->any_mimo_dl = true;
+	}
+
+	ret = mt7915_mcu_set_muru_dl_ul(data->phy->dev, MURU_DL_UL_TYPE_BSS,
+					mvif->mt76.idx, MURU_DL_UL_EN_MASK,
+					flags);
+	if (ret && !data->err)
+		data->err = ret;
+}
+
+/* Push this radio's multi-user (OFDMA / MU-MIMO) flags to the firmware for the
+ * band and every active AP/STA BSS. Under the wiphy lock.
+ */
+static int mt7915_muru_apply(struct mt7915_phy *phy)
+{
+	struct mt7915_muru_apply_data data = { .phy = phy };
+	struct mt7915_dev *dev = phy->dev;
+	u8 band_flags = mt7915_muru_band_flags(phy);
+	int ret;
+
+	KUNIT_STATIC_STUB_REDIRECT(mt7915_muru_apply, phy);
+
+	mutex_lock(&dev->mt76.mutex);
+	ieee80211_iterate_active_interfaces_mtx(phy->mt76->hw,
+						IEEE80211_IFACE_ITER_NORMAL,
+						mt7915_muru_apply_iter, &data);
+	if (data.has_ap && !data.any_mimo_dl)
+		band_flags &= ~MURU_MIMO_DL_EN;
+
+	ret = mt7915_mcu_set_muru_dl_ul(dev, MURU_DL_UL_TYPE_BAND,
+					phy->mt76->band_idx,
+					MURU_DL_UL_EN_MASK, band_flags);
+	mutex_unlock(&dev->mt76.mutex);
+
+	if (ret && !data.err)
+		data.err = ret;
+
+	if (data.err)
+		dev_warn(dev->mt76.dev, "muru flags 0x%x not applied: %d\n",
+			 band_flags, data.err);
+
+	return data.err;
+}
+
+/* Update one or more per-band multi-user flags live. Accepts either a single
+ * "<name> <0|1>" pair or whitespace-separated "<name>=<0|1>" tokens. Under the
+ * wiphy lock. mimo_ul=1 is taken on the MT7915 too but stays off there
+ * (mt7915_muru_band_flags()), so a line with all four flags still sets the
+ * other three.
+ */
+int mt7915_muru_set_flags(struct mt7915_phy *phy, const char *buf)
+{
+	u8 mask, bits, old_flags, ov, new_ov, new_flags;
+	int ret;
+
+	ret = mt7915_muru_parse_flags(buf, &mask, &bits);
+	if (ret)
+		return ret;
+
+	old_flags = mt7915_muru_band_flags(phy);
+	ov = READ_ONCE(phy->muru_en);
+	new_ov = (((ov >> 4) | mask) << 4) |
+		 ((ov & MURU_DL_UL_EN_MASK & ~mask) | bits);
+	WRITE_ONCE(phy->muru_en, new_ov);
+	new_flags = mt7915_muru_band_flags(phy);
+
+	if (new_flags == old_flags && !phy->muru_unapplied)
+		return 0;
+
+	ret = mt7915_muru_apply(phy);
+	phy->muru_unapplied = !!ret;
+
+	return ret;
+}
+
 /* The restarted firmware has no TWT agreements: a station that still sleeps by
  * one would miss what's sent outside its wake periods, and no one tells it else.
  */
@@ -2136,6 +2347,7 @@ mt7915_reconfig_complete(struct ieee80211_hw *hw,
 	if (reconfig_type == IEEE80211_RECONFIG_TYPE_RESTART) {
 		mt7915_bss_color_restore(phy);
 		phy->spr_unapplied = !!mt7915_spr_apply(phy);
+		phy->muru_unapplied = !!mt7915_muru_apply(phy);
 	}
 
 	ieee80211_wake_queues(hw);
diff --git a/mt7915/mcu.c b/mt7915/mcu.c
index e63708a0..b9af89f3 100644
--- a/mt7915/mcu.c
+++ b/mt7915/mcu.c
@@ -58,6 +58,11 @@ static bool vow_fw_quanta;
 module_param(vow_fw_quanta, bool, 0444);
 MODULE_PARM_DESC(vow_fw_quanta, "Alternative airtime (VoW) values: no WATF with ATF, the firmware's own quantum table, station quanta one level down");
 
+/* On by default: off is there to compare or work around client issues. */
+static bool muru_ofdma_dl = true;
+module_param(muru_ofdma_dl, bool, 0644);
+MODULE_PARM_DESC(muru_ofdma_dl, "Let the firmware schedule DL OFDMA (default on)");
+
 /* Off by default, as stock mt76 has it since upstream found UL OFDMA hung
  * the firmware (75977a85).
  */
@@ -65,6 +70,15 @@ static bool muru_ofdma_ul;
 module_param(muru_ofdma_ul, bool, 0644);
 MODULE_PARM_DESC(muru_ofdma_ul, "Let the firmware schedule UL OFDMA for HE stations (default off, as stock mt76; the firmware keeps the first station's setting per band, so set it before stations join)");
 
+/* Off by default: scheduled uplink triggers can pause best-effort downlink
+ * traffic on MT798x. It also decides whether the HE capabilities advertise
+ * full-bandwidth UL MU-MIMO, which they take when the radio is set up: the
+ * debugfs muru file switches the firmware's scheduling only.
+ */
+bool mt7915_muru_mimo_ul;
+module_param_named(muru_mimo_ul, mt7915_muru_mimo_ul, bool, 0644);
+MODULE_PARM_DESC(muru_mimo_ul, "Let the firmware schedule UL MU-MIMO on MT7916/MT798x and advertise it in the HE capabilities, which follow it at load (default off)");
+
 static int muru_platform_type = -1;
 module_param(muru_platform_type, int, 0444);
 MODULE_PARM_DESC(muru_platform_type, "MU/RU platform type sent at boot: -1 by chip (2 on the MT7915, none on the MT798x), 0 none, 1 or 2 that value");
@@ -1217,6 +1231,38 @@ mt7915_mcu_sta_he_tlv(struct sk_buff *skb, struct ieee80211_sta *sta,
 	he->pkt_ext = 2;
 }
 
+u8 mt7915_muru_band_flags(const struct mt7915_phy *phy)
+{
+	u8 ov = READ_ONCE(phy->muru_en);
+	u8 set = ov >> 4;
+	u8 flags = MURU_MIMO_DL_EN;
+
+	if (READ_ONCE(muru_ofdma_dl))
+		flags |= MURU_OFDMA_DL_EN;
+	if (READ_ONCE(muru_ofdma_ul))
+		flags |= MURU_OFDMA_UL_EN;
+	if (!is_mt7915(&phy->dev->mt76) && READ_ONCE(mt7915_muru_mimo_ul))
+		flags |= MURU_MIMO_UL_EN;
+
+	flags = (flags & ~set) | (ov & set);
+	if (is_mt7915(&phy->dev->mt76))
+		flags &= ~MURU_MIMO_UL_EN;
+
+	return flags;
+}
+
+u8 mt7915_muru_bss_flags(const struct mt7915_phy *phy,
+			 const struct ieee80211_vif *vif)
+{
+	const struct mt7915_vif *mvif = (const struct mt7915_vif *)vif->drv_priv;
+	u8 flags = mt7915_muru_band_flags(phy);
+
+	if (!mvif->cap.he_mu_ebfer && !mvif->cap.vht_mu_ebfer)
+		flags &= ~MURU_MIMO_DL_EN;
+
+	return flags;
+}
+
 static void
 mt7915_mcu_sta_muru_tlv(struct mt7915_dev *dev, struct sk_buff *skb,
 			struct ieee80211_sta *sta, struct ieee80211_vif *vif)
@@ -1225,6 +1271,7 @@ mt7915_mcu_sta_muru_tlv(struct mt7915_dev *dev, struct sk_buff *skb,
 	struct ieee80211_he_cap_elem *elem = &sta->deflink.he_cap.he_cap_elem;
 	struct sta_rec_muru *muru;
 	struct tlv *tlv;
+	u8 flags;
 
 	if (vif->type != NL80211_IFTYPE_STATION &&
 	    vif->type != NL80211_IFTYPE_AP)
@@ -1238,12 +1285,11 @@ mt7915_mcu_sta_muru_tlv(struct mt7915_dev *dev, struct sk_buff *skb,
 	 * VHT MU beamformee bit (hostapd's mu_beamformee, on by default) is
 	 * about receiving it and doesn't count
 	 */
-	muru->cfg.mimo_dl_en = mvif->cap.he_mu_ebfer ||
-			       mvif->cap.vht_mu_ebfer;
-	if (!is_mt7915(&dev->mt76))
-		muru->cfg.mimo_ul_en = true;
-	muru->cfg.ofdma_dl_en = true;
-	muru->cfg.ofdma_ul_en = READ_ONCE(muru_ofdma_ul);
+	flags = mt7915_muru_bss_flags(mvif->phy, vif);
+	muru->cfg.mimo_dl_en = !!(flags & MURU_MIMO_DL_EN);
+	muru->cfg.mimo_ul_en = !!(flags & MURU_MIMO_UL_EN);
+	muru->cfg.ofdma_dl_en = !!(flags & MURU_OFDMA_DL_EN);
+	muru->cfg.ofdma_ul_en = !!(flags & MURU_OFDMA_UL_EN);
 
 	if (sta->deflink.vht_cap.vht_supported)
 		muru->mimo_dl.vht_mu_bfee =
@@ -1255,10 +1301,12 @@ mt7915_mcu_sta_muru_tlv(struct mt7915_dev *dev, struct sk_buff *skb,
 	muru->mimo_dl.partial_bw_dl_mimo =
 		HE_PHY(CAP6_PARTIAL_BANDWIDTH_DL_MUMIMO, elem->phy_cap_info[6]);
 
+	/* no partial_ul_mimo: the AP advertises full-bandwidth UL MU-MIMO
+	 * only (mt7915_set_stream_he_txbf_caps()), so the firmware isn't told
+	 * a station can do it in part of the channel
+	 */
 	muru->mimo_ul.full_ul_mimo =
 		HE_PHY(CAP2_UL_MU_FULL_MU_MIMO, elem->phy_cap_info[2]);
-	muru->mimo_ul.partial_ul_mimo =
-		HE_PHY(CAP2_UL_MU_PARTIAL_MU_MIMO, elem->phy_cap_info[2]);
 
 	muru->ofdma_dl.punc_pream_rx =
 		HE_PHY(CAP1_PREAMBLE_PUNC_RX_MASK, elem->phy_cap_info[1]);
@@ -2635,6 +2683,27 @@ int mt7915_mcu_set_muru_ctrl(struct mt7915_dev *dev, u32 cmd, u32 val)
 				 sizeof(req), false);
 }
 
+int mt7915_mcu_set_muru_dl_ul(struct mt7915_dev *dev, u8 type, u8 idx,
+			      u8 mask, u8 val)
+{
+	struct {
+		__le32 cmd;
+		u8 type;
+		u8 idx;
+		u8 mask;
+		u8 val;
+	} __packed req = {
+		.cmd = cpu_to_le32(MURU_SET_DL_UL_EN),
+		.type = type,
+		.idx = idx,
+		.mask = mask & MURU_DL_UL_EN_MASK,
+		.val = val & mask & MURU_DL_UL_EN_MASK,
+	};
+
+	return mt76_mcu_send_msg(&dev->mt76, MCU_EXT_CMD(MURU_CTRL), &req,
+				 sizeof(req), false);
+}
+
 /*
  * The MU/RU platform type goes to the MT7915 only (2); on
