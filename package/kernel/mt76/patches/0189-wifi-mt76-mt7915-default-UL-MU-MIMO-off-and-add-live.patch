+/* mt7915_muru_apply() walks the band's interfaces: a BSS message for each AP
+ * and station interface, then the band's, which keeps DL MU-MIMO only while
+ * an AP sends it.
+ */
+static void mt7915_main_test_muru_apply(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct mt7915_phy *phy = mt7915_hw_phy(hw);
+	struct mt7915_test_muru_dl_ul_req *req;
+	struct ieee80211_vif *ap, *ap2, *sta;
+	int i;
+
+	ap = mt7915_main_test_sdata_ap(test, hw, 1);
+	ap2 = mt7915_main_test_sdata_ap(test, hw, 2);
+	mt7915_main_test_sdata_up(test, ap);
+	mt7915_main_test_sdata_up(test, ap2);
+	/* as start_ap leaves them: MU beamforming on the first only */
+	memset(&mt7915_main_test_mvif(ap)->cap, 0,
+	       sizeof(mt7915_main_test_mvif(ap)->cap));
+	memset(&mt7915_main_test_mvif(ap2)->cap, 0,
+	       sizeof(mt7915_main_test_mvif(ap2)->cap));
+	mt7915_main_test_mvif(ap)->cap.vht_mu_ebfer = true;
+
+	wiphy_lock(hw->wiphy);
+	mt7915_main_test_clear(fake);
+	KUNIT_EXPECT_EQ(test, mt7915_muru_apply(phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+	for (i = 0; i < 3; i++) {
+		KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, i)->cmd,
+				MCU_EXT_CMD(MURU_CTRL));
