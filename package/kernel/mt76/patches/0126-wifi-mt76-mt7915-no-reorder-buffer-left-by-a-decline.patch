From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Wed, 4 Nov 2026 12:08:07 +0000
Subject: [PATCH] wifi: mt76: mt7915: no reorder buffer left by a declined rx
 BA session

mt7915_ampdu_action() set up mt76's reorder buffer for IEEE80211_AMPDU_
RX_START before asking the firmware for the recipient entry. When that
failed (an MCU timeout, or during a reset), the error declined the
session, but the reorder buffer stayed: mac80211 keeps no session and
never sends RX_STOP for it, not even through a full reset. mt76 then
went on reordering the station's plain QoS frames on that TID, holding
them back for the reorder timeout (100 ms) at every frame the station
gave up on, until it asked for a new session or reassociated.

Remove it when the firmware refuses.

mt7915_main_test_ampdu_rx_declined checks it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mt7915/main.c            |  7 +++++++
 mt7915/tests/main-test.c | 33 +++++++++++++++++++++++++++++++++
 2 files changed, 40 insertions(+)

diff --git a/mt7915/main.c b/mt7915/main.c
index c838f155..32cbb15d 100644
--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -1037,6 +1037,13 @@ mt7915_ampdu_action(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 		mt76_rx_aggr_start(&dev->mt76, &msta->wcid, tid, ssn,
 				   params->buf_size);
 		ret = mt7915_mcu_add_rx_ba(dev, params, true);
+		/*
+		 * Declined: mac80211 keeps no session, so no RX_STOP will come
+		 * for it, and a reorder buffer left here would hold the
+		 * station's plain QoS frames back at every hole.
+		 */
+		if (ret)
+			mt76_rx_aggr_stop(&dev->mt76, &msta->wcid, tid);
 		break;
 	case IEEE80211_AMPDU_RX_STOP:
 		mt76_rx_aggr_stop(&dev->mt76, &msta->wcid, tid);
diff --git a/mt7915/tests/main-test.c b/mt7915/tests/main-test.c
index 7ec90494..56de530d 100644
--- a/mt7915/tests/main-test.c
+++ b/mt7915/tests/main-test.c
@@ -2273,6 +2273,38 @@ static void mt7915_main_test_ampdu_rx(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
 }
 
+/* The firmware refusing the recipient entry declines the session: mac80211
+ * keeps none and won't stop it, so no reorder buffer may stay behind.
+ */
+static void mt7915_main_test_ampdu_rx_declined(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_ampdu_params p;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	mt7915_main_test_clear(fake);
+
+	mt7915_main_test_ba_params(&p, sta, IEEE80211_AMPDU_RX_START);
+	mt7915_main_test_fail_at(fake, 1, -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_ampdu_action(hw, vif, &p), -EIO);
+	KUNIT_EXPECT_NULL(test, rcu_access_pointer(msta->wcid.aggr[5]));
+
+	/* accepted the next time */
+	mt7915_main_test_clear(fake);
+	KUNIT_EXPECT_EQ(test, mt7915_ampdu_action(hw, vif, &p), 0);
+	KUNIT_EXPECT_NOT_NULL(test, rcu_access_pointer(msta->wcid.aggr[5]));
+
+	p.action = IEEE80211_AMPDU_RX_STOP;
+	KUNIT_EXPECT_EQ(test, mt7915_ampdu_action(hw, vif, &p), 0);
+}
+
 /* tx BA: starting is immediate and only marks the tid; once operational
  * the txq aggregates and the firmware gets an originator entry; stopping
  * (flush) undoes both. A session without A-MSDU turns A-MSDU off for the
@@ -3339,6 +3371,7 @@ static struct kunit_case mt7915_main_test_cases[] = {
 	KUNIT_CASE(mt7915_main_test_sta_remove),
 	KUNIT_CASE(mt7915_main_test_tx),
 	KUNIT_CASE(mt7915_main_test_ampdu_rx),
+	KUNIT_CASE(mt7915_main_test_ampdu_rx_declined),
 	KUNIT_CASE(mt7915_main_test_ampdu_tx),
 	KUNIT_CASE(mt7915_main_test_sta_flags),
 	KUNIT_CASE(mt7915_main_test_sta_airtime),
