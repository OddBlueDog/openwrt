From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Mon, 19 Oct 2026 23:35:35 +0100
Subject: [PATCH] wifi: mt76: mt7915: refuse new stations between a full reset
 and the restart

mt7915_mac_full_reset() clears the wcid table and mask, unlocks the
driver mutex, and only then asks mac80211 to restart, which re-adds
every station it knows from its own work, after mt7915_start(). A
NEW_STATION from hostapd that was waiting for the mutex ran in between:
it got wcid X and was published. mac80211's restart then added the same
station again: mt7915_mac_sta_add() allocated a second index Y and
re-initialised poll_list, and mt76_sta_add() re-initialised tx_list,
list and pktid, all while still linked into the phy's tx list, the
device's wcid list and the poll list (mt76_tx_status_check() walks the
wcid list every 100 ms). wcid[X] stayed published with its firmware
entry; removing the station cleared only Y, so a later rx frame, tx-free
or tx status for X used the freed station.

Refuse station adds with -EBUSY on a band from the full reset until
mt7915_start() runs for it; the association fails and the client
retries it. Stations mac80211 re-adds come after the start.

The reset also re-initialised dev->sta_rc_list while stations were
still linked on it, so a station removed before the restart re-added it
wrote its neighbours into the emptied head. Unlink them instead.

mt7915_main_test_sta_add_restart_pending and mt7915_test_sta_rc_reset
check both.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mt7915/mac.c             | 24 +++++++++++++++++++++++-
 mt7915/main.c            | 11 +++++++++++
 mt7915/mt7915.h          |  2 ++
 mt7915/tests/mac-test.c  | 27 +++++++++++++++++++++++++++
 mt7915/tests/main-test.c | 35 +++++++++++++++++++++++++++++++++++
 5 files changed, 98 insertions(+), 1 deletion(-)

diff --git a/mt7915/mac.c b/mt7915/mac.c
index 11d4d77e..6c88b928 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1508,6 +1508,19 @@ static void mt7915_mac_twt_reset(struct mt7915_dev *dev)
 	dev->twt.n_agrt = 0;
 }
 
+/* Unlink the stations waiting for a rate update: the restarted firmware
+ * gets every station's rates again when mac80211 re-adds it.
+ */
+static void mt7915_mac_sta_rc_reset(struct mt7915_dev *dev)
+{
+	struct mt7915_sta *msta, *tmp;
+
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	list_for_each_entry_safe(msta, tmp, &dev->sta_rc_list, rc_list)
+		list_del_init(&msta->rc_list);
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+}
+
 static void
 mt7915_mac_full_reset(struct mt7915_dev *dev)
 {
@@ -1552,7 +1565,7 @@ mt7915_mac_full_reset(struct mt7915_dev *dev)
 
 	mt76_reset_device(&dev->mt76);
 
-	INIT_LIST_HEAD(&dev->sta_rc_list);
+	mt7915_mac_sta_rc_reset(dev);
 	mt7915_mac_twt_reset(dev);
 
 	i = mt76_wcid_alloc(dev->mt76.wcid_mask, MT7915_WTBL_STA);
@@ -1567,6 +1580,15 @@ mt7915_mac_full_reset(struct mt7915_dev *dev)
 	dev->recovery.restart = false;
 	dev->recovery.hw_full_reset = false;
 
+	/*
+	 * mac80211's restart work re-adds every station it knows, after
+	 * mt7915_start(). A station hostapd adds before then would be added
+	 * twice (see mt7915_mac_sta_add()).
+	 */
+	dev->phy.restart_pending = true;
+	if (phy2)
+		phy2->restart_pending = true;
+
 	mutex_unlock(&dev->mt76.mutex);
 
 	ieee80211_wake_queues(mt76_hw(dev));
diff --git a/mt7915/main.c b/mt7915/main.c
index d433a1ec..087c8620 100644
--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -102,6 +102,7 @@ static int mt7915_start(struct ieee80211_hw *hw)
 	flush_work(&dev->init_work);
 
 	mutex_lock(&dev->mt76.mutex);
+	mt7915_hw_phy(hw)->restart_pending = false;
 	ret = mt7915_run(hw);
 	mutex_unlock(&dev->mt76.mutex);
 
@@ -768,6 +769,16 @@ int mt7915_mac_sta_add(struct mt76_dev *mdev, struct ieee80211_vif *vif,
 	bool ext_phy = mvif->phy != &dev->phy;
 	int idx;
 
+	/*
+	 * Between a full reset and mac80211's restart: the restart re-adds
+	 * every station mac80211 has, this one included, and a second add
+	 * would allocate it a second wcid while the first stays published
+	 * and its lists are re-initialised while linked. The client retries
+	 * its association.
+	 */
+	if (mvif->phy->restart_pending)
+		return -EBUSY;
+
 	if (mtk_wed_device_active(&dev->mt76.mmio.wed) &&
 	    !is_mt7915(&dev->mt76) &&
 	    test_bit(MT_WCID_FLAG_4ADDR, &msta->wcid.flags))
diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
index 7da2b5f7..1b42d576 100644
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -239,6 +239,8 @@ struct mt7915_phy {
 
 	bool sku_limit_en:1;
 	bool sku_path_en:1;
+	/* full reset done, mac80211's restart not yet: no new stations */
+	bool restart_pending:1;
 
 #ifdef CONFIG_NL80211_TESTMODE
 	struct {
diff --git a/mt7915/tests/mac-test.c b/mt7915/tests/mac-test.c
index f9bdf345..7d18e77c 100644
--- a/mt7915/tests/mac-test.c
+++ b/mt7915/tests/mac-test.c
@@ -1477,6 +1477,32 @@ static void mt7915_test_rx_wed_ppe(struct kunit *test)
 	dev->mt76.q_rx[MT_RXQ_MAIN].flags = 0;
 }
 
+/* A full reset unlinks every station waiting for a rate update, so a
+ * station removed before mac80211 re-adds it can unlink itself without
+ * writing into the emptied list head.
+ */
+static void mt7915_test_sta_rc_reset(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *a = mt7915_test_sta(test, dev, 9, mvif);
+	struct mt7915_sta *b = mt7915_test_sta(test, dev, 10, mvif);
+
+	list_add_tail(&a->rc_list, &dev->sta_rc_list);
+	list_add_tail(&b->rc_list, &dev->sta_rc_list);
+
+	mt7915_mac_sta_rc_reset(dev);
+
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->sta_rc_list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&a->rc_list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&b->rc_list));
+
+	/* what mt7915_sta_remove() does later */
+	list_del_init(&a->rc_list);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->sta_rc_list));
+}
+
 /* --- rx: what mt7915_queue_rx_skb() does with each packet type ---------- */
 
 /* A good data frame goes up to mac80211's rx path (mt76_rx's queue), a bad
@@ -4985,6 +5011,7 @@ static struct kunit_suite mt7915_mac_dfs_test_suite = {
 
 static struct kunit_case mt7915_mac_reset_test_cases[] = {
 	KUNIT_CASE(mt7915_test_sta_rc_work),
+	KUNIT_CASE(mt7915_test_sta_rc_reset),
 	KUNIT_CASE(mt7915_test_update_vif_beacon),
 	KUNIT_CASE(mt7915_test_reset_events),
 	KUNIT_CASE(mt7915_test_dump_work),
diff --git a/mt7915/tests/main-test.c b/mt7915/tests/main-test.c
index ed8002fe..d2d2d2d2 100644
--- a/mt7915/tests/main-test.c
+++ b/mt7915/tests/main-test.c
@@ -1810,6 +1810,40 @@ static void mt7915_main_test_sta_add_full(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
 }
 
+/* After a full reset and before mac80211's restart has started the band
+ * again, a new station is refused (mac80211 re-adds the ones it has);
+ * once mt7915_start() runs, stations are added again. The other band
+ * isn't affected.
+ */
+static void mt7915_main_test_sta_add_restart_pending(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw2 = mt7915_main_test_hw2(dev);
+	struct ieee80211_vif *vif, *vif0;
+	struct ieee80211_sta *sta, *sta0;
+	u32 mask0;
+
+	vif = mt7915_main_test_ap(test, hw2, 1);
+	vif0 = mt7915_main_test_ap(test, dev->mt76.hw, 2);
+	mt7915_main_test_clear(fake);
+	sta = mt7915_main_test_sta(test, vif, 1);
+	sta0 = mt7915_main_test_sta(test, vif0, 2);
+	mask0 = dev->mt76.wcid_mask[0];
+
+	mt7915_ext_phy(dev)->restart_pending = true;
+	KUNIT_EXPECT_EQ(test, mt7915_mac_sta_add(&dev->mt76, vif, sta),
+			-EBUSY);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	KUNIT_EXPECT_EQ(test, dev->mt76.wcid_mask[0], mask0);
+
+	KUNIT_EXPECT_EQ(test, mt7915_mac_sta_add(&dev->mt76, vif0, sta0), 0);
+
+	KUNIT_ASSERT_EQ(test, mt7915_start(hw2), 0);
+	KUNIT_EXPECT_FALSE(test, mt7915_ext_phy(dev)->restart_pending);
+	KUNIT_EXPECT_EQ(test, mt7915_mac_sta_add(&dev->mt76, vif, sta), 0);
+}
+
 /* Association: the station entry goes to connected with its capabilities,
  * the WTBL gets the RCPI default, rate control is set up, and only then
  * may frames go out to it. Each step's firmware error aborts it with tx
@@ -3078,6 +3112,7 @@ static struct kunit_case mt7915_main_test_cases[] = {
 	KUNIT_CASE(mt7915_main_test_start_stop_ap),
 	KUNIT_CASE(mt7915_main_test_sta_add),
 	KUNIT_CASE(mt7915_main_test_sta_add_full),
+	KUNIT_CASE(mt7915_main_test_sta_add_restart_pending),
 	KUNIT_CASE(mt7915_main_test_sta_assoc),
 	KUNIT_CASE(mt7915_main_test_sta_authorize),
 	KUNIT_CASE(mt7915_main_test_drop_other_sta),
