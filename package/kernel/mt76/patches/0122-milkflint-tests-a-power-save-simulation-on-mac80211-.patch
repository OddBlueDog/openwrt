+static struct psim *psim_init(struct kunit *test, const struct psim_cfg *cfg)
+{
+	struct ieee80211_sub_if_data *sdata;
+	struct mt76_phy *phy;
+	struct ieee80211_hw *hw;
+	struct mt76_dev *dev;
+	struct mt76_queue *q;
+	struct psim *s;
+	int i, ac;
+
+	s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	s->test = test;
+	s->cfg = cfg;
+	s->rng = cfg->seed ?: 1;
+	INIT_LIST_HEAD(&s->events);
+	s->frames = kunit_kcalloc(test, PSIM_MAX_FRAMES, sizeof(*s->frames),
+				  GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, s->frames);
+	psim_ctx = s;
+
+	dev = mt76_test_dev(test, sizeof(*dev), &psim_hw_ops, &psim_drv);
+	s->dev = dev;
+	hw = dev->hw;
+	s->hw = hw;
+	s->local = hw_to_local(hw);
+	phy = &dev->phy;
+	dev->queue_ops = &psim_queue_ops;
+	/* freed before the device (KUnit runs actions in reverse) */
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, psim_free, s), 0);
+
+	/* one ring for every data AC and the PS queue, as on connac */
+	q = devm_kzalloc(dev->dev, sizeof(*q), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, q);
+	q->entry = devm_kcalloc(dev->dev, PSIM_NDESC, sizeof(*q->entry),
+				GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, q->entry);
+	q->ndesc = PSIM_NDESC;
+	spin_lock_init(&q->lock);
+	spin_lock_init(&q->cleanup_lock);
+	s->q = q;
+	INIT_LIST_HEAD(&phy->tx_list);
+	spin_lock_init(&phy->tx_lock);
+	for (i = 0; i < __MT_TXQ_MAX; i++)
+		phy->q_tx[i] = q;
+
+	/* parked: mt76_worker_schedule() only sets its flag */
+	KUNIT_ASSERT_EQ(test, mt76_worker_setup(hw, &dev->tx_worker,
+			psim_worker_stub, "psim"), 0);
+	mt76_worker_disable(&dev->tx_worker);
+
+	/* what mt76_phy_init() and mt7915 set that matters on the tx side */
+	hw->queues = IEEE80211_NUM_ACS;
+	hw->txq_data_size = sizeof(struct mt76_txq);
+	hw->sta_data_size = sizeof(struct mt76_wcid);
+	hw->vif_data_size = sizeof(struct mt76_vif_link);
+	ieee80211_hw_set(hw, HAS_RATE_CONTROL);
+	ieee80211_hw_set(hw, SUPPORTS_TX_ENCAP_OFFLOAD);
+	ieee80211_hw_set(hw, SUPPORTS_RX_DECAP_OFFLOAD);
+	ieee80211_hw_set(hw, AP_LINK_PS);
+	ieee80211_hw_set(hw, AMPDU_AGGREGATION);
+	ieee80211_hw_set(hw, SUPPORT_FAST_XMIT);
+	wiphy_ext_feature_set(hw->wiphy, NL80211_EXT_FEATURE_AQL);
+	wiphy_ext_feature_set(hw->wiphy, NL80211_EXT_FEATURE_AIRTIME_FAIRNESS);
+
+	s->sband.band = NL80211_BAND_5GHZ;
+	s->sband.channels = &psim_chan;
+	s->sband.n_channels = 1;
+	s->sband.bitrates = psim_rates;
+	s->sband.n_bitrates = ARRAY_SIZE(psim_rates);
+	s->sband.ht_cap.ht_supported = true;
+	s->sband.vht_cap.vht_supported = true;
+	hw->wiphy->bands[NL80211_BAND_5GHZ] = &s->sband;
+
+	KUNIT_ASSERT_EQ(test, 0, ieee80211_txq_setup_flows(s->local));
+	s->flows = true;
+	/* nothing may be dropped for sitting in a txq: a dozing station's
+	 * frames wait as long as it sleeps
+	 */
+	s->local->cparams.target = MS2TIME(100000);
+	s->local->cparams.interval = MS2TIME(100000);
+	s->local->fq.limit = PSIM_MAX_FRAMES;
+	s->local->fq.memory_limit = 64 << 20;
+
+	/* the AP interface, as ieee80211_if_add() and do_open() leave it */
+	sdata = kzalloc(sizeof(*sdata) + hw->vif_data_size, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sdata);
+	s->sdata = sdata;
+	s->ndev = alloc_netdev_dummy(0);
+	KUNIT_ASSERT_NOT_NULL(test, s->ndev);
+	strscpy(sdata->name, "psim0");
+	sdata->local = s->local;
+	sdata->wdev.wiphy = hw->wiphy;
+	sdata->wdev.iftype = NL80211_IFTYPE_AP;
+	sdata->vif.type = NL80211_IFTYPE_AP;
+	memcpy(sdata->vif.addr, psim_ap_addr, ETH_ALEN);
+	sdata->flags = IEEE80211_SDATA_IN_DRIVER;
+	sdata->control_port_protocol = cpu_to_be16(ETH_P_PAE);
+	sdata->bss = &sdata->u.ap;
+	INIT_LIST_HEAD(&sdata->u.ap.vlans);
+	skb_queue_head_init(&sdata->u.ap.ps.bc_buf);
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
+		sdata->vif.hw_queue[ac] = ac;
+	sdata->deflink.sdata = sdata;
+	sdata->deflink.conf = &sdata->vif.bss_conf;
+	sdata->vif.bss_conf.vif = &sdata->vif;
+	memcpy(sdata->vif.bss_conf.addr, psim_ap_addr, ETH_ALEN);
+	sdata->vif.bss_conf.bssid = sdata->vif.bss_conf.addr;
+	rcu_assign_pointer(sdata->vif.link_conf[0], &sdata->vif.bss_conf);
+	rcu_assign_pointer(sdata->link[0], &sdata->deflink);
+
+	s->vif_txqi = kzalloc(sizeof(struct txq_info) + hw->txq_data_size,
+			      GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, s->vif_txqi);
+	ieee80211_txq_init(sdata, NULL, s->vif_txqi, 0);
+
+	for (i = 0; i < cfg->n_sta; i++) {
+		s->sta[i].kind = cfg->kinds[i];
+		KUNIT_ASSERT_EQ(test, psim_sta_join(s, i), 0);
+	}
+
+	return s;
+}
+
+/* A station associates: allocated as ieee80211_add_station() does, added
+ * to the driver through mt76_sta_state() as sta_info_insert() would.
+ */
+static int psim_sta_join(struct psim *s, int i)
+{
+	struct psim_sta *ps = &s->sta[i];
+	u8 addr[ETH_ALEN] = { 0x02, 0x53, 0x54, 0x41, ps->gen + 1, i };
+	struct sta_info *si;
+	int ret, tid;
+
+	KUNIT_ASSERT_NULL(s->test, ps->si);
+	si = sta_info_alloc(s->sdata, addr, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(s->test, si);
+	si->uploaded = true;
+	si->sta.wme = true;
+	set_bit(WLAN_STA_AUTH, &si->_flags);
+	set_bit(WLAN_STA_ASSOC, &si->_flags);
+	set_bit(WLAN_STA_AUTHORIZED, &si->_flags);
+	/* HE80 MCS 9 2SS: airtime estimates are known */
+	si->deflink.tx_stats.last_rate_info = (struct rate_info) {
+		.flags = RATE_INFO_FLAGS_HE_MCS,
+		.mcs = 9,
+		.nss = 2,
+		.bw = RATE_INFO_BW_80,
+		.he_gi = NL80211_RATE_INFO_HE_GI_0_8,
+	};
+
+	ret = mt76_sta_state(s->hw, &s->sdata->vif, &si->sta,
+			     IEEE80211_STA_NOTEXIST, IEEE80211_STA_NONE);
+	if (ret) {
+		sta_info_free(s->local, si);
+		return ret;
+	}
+
+	ps->si = si;
+	ps->present = true;
+	ps->idx = ((struct mt76_wcid *)si->sta.drv_priv)->idx;
+	ps->dozing = false;
+	ps->polling = false;
+	ps->idle = 0;
+	ps->stall = 0;
+	ps->backlog = 0;
+	memset(ps->fw_len, 0, sizeof(ps->fw_len));
+	memset(ps->ps_out, 0, sizeof(ps->ps_out));
+	memset(ps->airtime, 0, sizeof(ps->airtime));
+	ps->late_hits = 0;
+	for (tid = 0; tid < IEEE80211_NUM_TIDS; tid++) {
+		ps->seq[tid] = 0;
+		ps->rx_any[tid] = false;
+	}
+	return 0;
+}
+
+static void psim_event(struct psim *s, struct psim_sta *ps, bool dozing)
+{
+	struct psim_event *ev, *pos;
+
+	if (s->cfg->lost_events && !s->quiesce &&
+	    psim_chance(s, s->cfg->lost_events)) {
+		s->events_lost++;
+		return;
+	}
+
+	ev = kzalloc(sizeof(*ev), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(s->test, ev);
+	ev->sta = ps - s->sta;
+	ev->gen = ps->gen;
+	ev->dozing = dozing;
+	ev->due = s->step + (s->quiesce ? 0 :
+			     psim_range(s, 0, s->cfg->event_delay));
+	/* the firmware's events arrive in the order it sent them */
+	list_for_each_entry(pos, &s->events, list)
+		if (pos->due > ev->due)
+			pos->due = ev->due;
+	list_add_tail(&ev->list, &s->events);
+}
+
+static void psim_set_dozing(struct psim *s, struct psim_sta *ps, bool dozing)
+{
+	if (ps->dozing == dozing)
+		return;
+	ps->dozing = dozing;
+	if (!dozing)
+		ps->wakes++;
+	psim_event(s, ps, dozing);
+}
+
+/* PS sync events whose time has come: mt7915_mcu_rx_ps_sync() */
+static void psim_deliver_events(struct psim *s)
+{
+	struct psim_event *ev, *tmp;
+
+	list_for_each_entry_safe(ev, tmp, &s->events, list) {
+		struct psim_sta *ps = &s->sta[ev->sta];
+
+		if (ev->due > s->step)
+			break;
+		list_del(&ev->list);
+		/* mt76_wcid_ptr() finds no station: dropped */
+		if (ps->present && ps->gen == ev->gen)
+			mt76_sta_ps_transition(s->dev, psim_wcid(ps),
+					       s->cfg->ps_sync && ev->dozing);
+		kfree(ev);
+	}
+}
+
+static bool psim_fw_pending(struct psim_sta *ps)
+{
+	int ac;
+
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
+		if (ps->fw_len[ac])
+			return true;
+	return false;
+}
+
+/* the frame that leaves the firmware's buffer next, highest AC first */
+static int psim_fw_next(struct psim_sta *ps, u32 *id)
+{
+	int ac;
+
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+		if (!ps->fw_len[ac])
+			continue;
+		*id = ps->fw[ac][ps->fw_head[ac]];
+		ps->fw_head[ac] = (ps->fw_head[ac] + 1) % ARRAY_SIZE(ps->fw[ac]);
+		ps->fw_len[ac]--;
+		return ac;
+	}
+	return -1;
+}
+
+static void psim_complete(struct psim *s, u16 idx, struct sk_buff *skb,
+			  bool acked)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+
+	/* the status mt7915's tx-free event gives */
+	memset(&info->status, 0, sizeof(info->status));
+	info->status.rates[0].idx = -1;
+	if (acked)
+		info->flags |= IEEE80211_TX_STAT_ACK;
+	__mt76_tx_complete_skb(s->dev, idx, skb, NULL);
+}
+
+/* the skb of frame @id, out of the firmware model */
+static struct sk_buff *psim_take_skb(u32 id)
+{
+	struct sk_buff *skb;
+
+	skb_queue_walk(&psim_skbs, skb)
+		if (psim_skb_id(skb) == id) {
+			__skb_unlink(skb, &psim_skbs);
+			return skb;
+		}
+	return NULL;
+}
+
+/* The air: the firmware sends up to @burst frames of @ps, and they are
+ * acked or fail; the completions go out as one tx-free event.
+ */
+static unsigned int psim_air(struct psim *s, struct psim_sta *ps,
+			     unsigned int burst)
+{
+	struct mt76_wcid *wcid = psim_wcid(ps);
+	unsigned int n = 0;
+	u32 id;
+	int ac;
+
+	while (n < burst && (ac = psim_fw_next(ps, &id)) >= 0) {
+		struct psim_frame *f = &s->frames[id];
+		struct sk_buff *skb = psim_take_skb(id);
+		bool acked = !psim_chance(s, 30);
+		u32 lat = s->step - f->step;
+
+		KUNIT_ASSERT_NOT_NULL(s->test, skb);
+		KUNIT_ASSERT_EQ(s->test, f->state, PF_HW);
+		if (f->ps)
+			ps->ps_out[ac]--;
+		f->state = acked ? PF_ACKED : PF_FAILED;
+		if (acked) {
+			ps->acked++;
+			if (ps->rx_any[f->tid] &&
+			    f->seq <= ps->last_rx[f->tid] && !s->n_order++)
+				psim_note(s, "step %u: %s got tid %u seq %u after seq %u\n",
+					  s->step, psim_kind_name[ps->kind],
+					  f->tid, f->seq,
+					  ps->last_rx[f->tid]);
+			ps->rx_any[f->tid] = true;
+			ps->last_rx[f->tid] = f->seq;
+		} else {
+			ps->failed++;
+		}
+		ps->latency_sum += lat;
+		ps->latency_max = max_t(unsigned long, ps->latency_max, lat);
+		ps->airtime[ac] += ieee80211_info_get_tx_time_est(IEEE80211_SKB_CB(skb)) ?: 10;
+		ps->backlog--;
+		ps->progress = true;
+		n++;
+		psim_complete(s, wcid->idx, skb, acked);
+	}
+	return n;
+}
+
+/* A tx-free event's other half, as mt7915_mac_tx_free_done() does it. */
+static void psim_tx_free_done(struct psim *s)
+{
+	/* a TID of each AC */
+	static const u8 ac_tid[IEEE80211_NUM_ACS] = { 6, 5, 0, 1 };
+	int i, ac;
+
+	for (i = 0; i < s->cfg->n_sta; i++) {
+		struct psim_sta *ps = &s->sta[i];
+
+		if (!ps->present)
+			continue;
+		/* mt7915_mac_sta_poll(): the airtime used, per AC */
+		for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+			if (!ps->airtime[ac])
+				continue;
+			ieee80211_sta_register_airtime(&ps->si->sta, ac_tid[ac],
+						       ps->airtime[ac], 0);
+			ps->airtime[ac] = 0;
+		}
+	}
+	mt76_worker_schedule(&s->dev->tx_worker);
+}
+
+/* What a station does this step, by kind. */
+static void psim_behave(struct psim *s, struct psim_sta *ps, bool beacon)
+{
+	bool tim = psim_fw_pending(ps);
+
+	if (s->quiesce) {
+		psim_set_dozing(s, ps, false);
+		ps->polling = false;
+		return;
+	}
+
+	switch (ps->kind) {
+	case PSIM_LAPTOP:
+		break;
+	case PSIM_PHONE:
+		if (!ps->dozing) {
+			/* asleep after a few idle steps */
+			if (ps->progress)
+				ps->idle = 0;
+			else if (++ps->idle > psim_range(s, 3, 15))
+				psim_set_dozing(s, ps, true);
+		} else if ((beacon && tim) || psim_chance(s, 3)) {
+			/* its TIM bit, or an app sends */
+			psim_set_dozing(s, ps, false);
+			ps->idle = 0;
+		}
+		break;
+	case PSIM_SCANNER:
+		if (!ps->dozing && psim_chance(s, 15)) {
+			/* off channel for a scan, whatever is queued */
+			psim_set_dozing(s, ps, true);
+			ps->wake_until = s->step + psim_range(s, 3, 40);
+		} else if (ps->dozing && s->step >= ps->wake_until) {
+			psim_set_dozing(s, ps, false);
+		}
+		break;
+	case PSIM_SENSOR:
+		if (!ps->dozing) {
+			if (s->step >= ps->wake_until)
+				psim_set_dozing(s, ps, true);
+		} else if (psim_chance(s, 1)) {
+			/* it reports in now and then */
+			psim_set_dozing(s, ps, false);
+			ps->wake_until = s->step + psim_range(s, 1, 5);
+		} else if (beacon && tim) {
+			/* PS-Poll: no PM change, no PS sync event */
+			ps->polling = true;
+		}
+		break;
+	case PSIM_FLAPPER:
+		if (psim_chance(s, 500))
+			psim_set_dozing(s, ps, !ps->dozing);
+		break;
+	default:
+		break;
+	}
+}
+
+static void psim_transmit(struct psim *s)
+{
+	int i;
+	bool any = false;
+
+	for (i = 0; i < s->cfg->n_sta; i++) {
+		struct psim_sta *ps = &s->sta[i];
+
+		if (!ps->present)
+			continue;
+		if (!ps->dozing) {
+			if (psim_air(s, ps, s->quiesce ? 1024 :
+				     psim_range(s, 1, 48)))
+				any = true;
+		} else if (ps->polling) {
+			/* one frame per PS-Poll, more data from the buffer */
+			ps->polls++;
+			if (psim_air(s, ps, 1))
+				any = true;
+			ps->polling = psim_fw_pending(ps);
+		}
+	}
+
+	/* the late completions of stations that left */
+	if (s->n_late && (s->quiesce || psim_chance(s, 300))) {
+		unsigned int j;
+
+		for (j = 0; j < s->n_late; j++) {
+			struct sk_buff *skb = psim_take_skb(s->late[j]);
+			int k;
+
+			/* the wcid may be a new station's by now */
+			for (k = 0; k < s->cfg->n_sta; k++)
+				if (s->sta[k].present &&
+				    s->sta[k].idx == s->late_idx[j])
+					s->sta[k].late_hits++;
+
+			KUNIT_ASSERT_NOT_NULL(s->test, skb);
+			s->frames[s->late[j]].state = PF_FAILED;
+			psim_complete(s, s->late_idx[j], skb, false);
+		}
+		s->n_late = 0;
+		any = true;
+	}
+
+	if (any || psim_chance(s, 700))
+		psim_dma(s);
+	if (any)
+		psim_tx_free_done(s);
+}
+
+static void psim_enqueue(struct psim *s, struct psim_sta *ps, u8 tid)
+{
+	struct ieee80211_txq *txq = ps->si->sta.txq[tid];
+	unsigned int len = psim_range(s, 64, 1500);
+	struct ieee80211_tx_info *info;
+	struct psim_frame *f;
+	struct sk_buff *skb;
+	struct ethhdr *eth;
+	u8 ac = psim_tid_to_ac[tid];
+	u32 id;
+
+	if (s->n_frames >= PSIM_MAX_FRAMES)
+		return;
+	id = s->n_frames++;
+	f = &s->frames[id];
+	f->state = PF_QUEUED;
+	f->sta = ps - s->sta;
+	f->tid = tid;
+	f->gen = ps->gen;
+	f->seq = ps->seq[tid]++;
+	f->step = s->step;
+
+	skb = alloc_skb(len + 64, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(s->test, skb);
+	skb_reserve(skb, 64);
+	eth = skb_put_zero(skb, len);
+	memcpy(eth->h_dest, ps->si->sta.addr, ETH_ALEN);
+	memcpy(eth->h_source, psim_lan_addr, ETH_ALEN);
+	eth->h_proto = htons(ETH_P_IP);
+	skb->priority = tid;
+	skb->dev = s->ndev;
+	skb->mark = id + 1;
+	/*
+	 * A flow per station and TID, each in an fq bucket of its own
+	 * (fq_flow_idx() takes the top 12 bits), as real traffic mostly is;
+	 * or the blank headers' hash for all (one_hash): every station's
+	 * frames then share fq's bucket
+	 */
+	if (!s->cfg->one_hash)
+		skb_set_hash(skb, ((f->sta * IEEE80211_NUM_TIDS + tid + 1) << 24) |
+			     (f->gen << 8), PKT_HASH_TYPE_L4);
+	skb->destructor = psim_skb_destructor;
+	skb_set_queue_mapping(skb, ac);
+
+	info = IEEE80211_SKB_CB(skb);
+	memset(info, 0, sizeof(*info));
+	info->hw_queue = s->sdata->vif.hw_queue[ac];
+	info->band = NL80211_BAND_5GHZ;
+	info->flags = IEEE80211_TX_CTL_HW_80211_ENCAP;
+	info->control.vif = &s->sdata->vif;
+
+	ps->queued++;
+	ps->backlog++;
+	/* ieee80211_queue_skb(): enqueue, schedule, wake the driver */
+	ieee80211_txq_enqueue(s->local, to_txq_info(txq), skb);
+	ieee80211_schedule_txq(s->hw, txq);
+	mt76_wake_tx_queue(s->hw, txq);
+}
+
+static void psim_traffic(struct psim *s)
+{
+	static const unsigned int rate[] = {
+		[PSIM_LAPTOP] = 400, [PSIM_PHONE] = 120, [PSIM_SCANNER] = 250,
+		[PSIM_SENSOR] = 15, [PSIM_FLAPPER] = 250,
+	};
+	int i, n;
+
+	for (i = 0; i < s->cfg->n_sta; i++) {
+		struct psim_sta *ps = &s->sta[i];
+		u8 tid;
+
+		if (!ps->present || !psim_chance(s, rate[ps->kind]))
+			continue;
+		tid = psim_tids[psim_rand(s) % ARRAY_SIZE(psim_tids)];
+		for (n = psim_range(s, 1, 12); n; n--)
+			if (ps->backlog < PSIM_BACKLOG)
+				psim_enqueue(s, ps, tid);
+	}
+}
+
+/* the tx worker, if anything scheduled it */
+static bool psim_worker(struct psim *s)
+{
+	struct mt76_dev *dev = s->dev;
+
+	if (!test_and_clear_bit(MT76_WORKER_SCHEDULED, &dev->tx_worker.state) &&
+	    !atomic_xchg(&s->worker_due, 0))
+		return false;
+	mt76_tx_worker_run(dev);
+	return true;
+}
+
+/* A station leaves: mac80211's __sta_info_destroy() order. What the
+ * firmware still buffers for it is flushed now, or (late_free) completes
+ * after it has gone, maybe once its wcid belongs to a new station.
+ */
+static void psim_sta_leave(struct psim *s, int i)
+{
+	struct psim_sta *ps = &s->sta[i];
+	struct mt76_dev *dev = s->dev;
+	bool late = psim_chance(s, s->cfg->late_free);
+	u16 idx = ps->idx;
+	bool due;
+	u32 id;
+	int ac;
+
+	mt76_sta_pre_rcu_remove(s->hw, &s->sdata->vif, &ps->si->sta);
+	synchronize_rcu();
+
+	/* sta_remove: STA_REC removed, the firmware drops what it holds */
+	while ((ac = psim_fw_next(ps, &id)) >= 0) {
+		if (late && s->n_late < ARRAY_SIZE(s->late)) {
+			s->late[s->n_late] = id;
+			s->late_idx[s->n_late++] = idx;
+			continue;
+		}
+		s->frames[id].state = PF_FAILED;
+		psim_complete(s, idx, psim_take_skb(id), false);
+	}
+
+	due = test_bit(MT76_WORKER_SCHEDULED, &dev->tx_worker.state);
+	/* running, as mt76_sta_remove() expects to find it */
+	mt76_worker_enable(&dev->tx_worker);
+	mt76_sta_state(s->hw, &s->sdata->vif, &ps->si->sta,
+		       IEEE80211_STA_NONE, IEEE80211_STA_NOTEXIST);
+	/* mt76_sta_remove() parked and unparked the worker (and scheduled
+	 * it): park it again, keep what it was asked for
+	 */
+	mt76_worker_disable(&dev->tx_worker);
+	atomic_set(&s->worker_due, 1);
+	if (due)
+		set_bit(MT76_WORKER_SCHEDULED, &dev->tx_worker.state);
+
+	ps->present = false;
+	wiphy_lock(s->hw->wiphy);
+	ieee80211_purge_sta_txqs(ps->si);
+	sta_info_free(s->local, ps->si);
+	wiphy_unlock(s->hw->wiphy);
+	ps->si = NULL;
+	ps->gen++;
+
+	/* and associates again */
+	KUNIT_ASSERT_EQ(s->test, psim_sta_join(s, i), 0);
+}
+
+/* The checks that hold after every step. */
+static void psim_check(struct psim *s)
+{
+	struct mt76_dev *dev = s->dev;
+	bool blocked = test_bit(MT76_RESET, &dev->phy.state) ||
+		       dev->phy.offchannel || mt76_txq_stopped(s->q) ||
+		       test_bit(MT76_WORKER_SCHEDULED, &dev->tx_worker.state) ||
+		       atomic_read(&s->worker_due);
+	int i, tid;
+
+	psim_print_notes(s);
+	for (i = 0; i < s->cfg->n_sta; i++) {
+		struct psim_sta *ps = &s->sta[i];
+		struct mt76_wcid *wcid;
+		unsigned long frames, bytes;
+		bool queued[IEEE80211_NUM_ACS] = {};
+		bool any = false;
+		int ac;
+
+		if (!ps->present)
+			continue;
+		wcid = psim_wcid(ps);
+		for (tid = 0; tid < IEEE80211_NUM_TIDS; tid++) {
+			ieee80211_txq_get_depth(ps->si->sta.txq[tid], &frames,
+						&bytes);
+			if (frames) {
+				queued[psim_tid_to_ac[tid & 7]] = true;
+				any = true;
+			}
+		}
+
+		/*
+		 * Held by the driver: each AC with frames in mac80211 has
+		 * one in the firmware, or nothing sets the TIM bit for them.
+		 */
+		if (!blocked && test_bit(MT_WCID_FLAG_PS, &wcid->flags)) {
+			bool fw_any = psim_fw_pending(ps);
+
+			for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
+				if (queued[ac] && !ps->fw_len[ac])
+					s->tim_warn++;
+			if (any && !fw_any && !s->n_tim++)
+				kunit_info(s->test, "step %u: %s held with frames queued and none in the firmware: its TIM bit stays clear\n",
+					   s->step, psim_kind_name[ps->kind]);
+		}
+
+		/* awake on both sides: the backlog moves */
+		if (!ps->dozing && !test_bit(MT_WCID_FLAG_PS, &wcid->flags) &&
+		    any && !ps->progress && !blocked) {
+			if (++ps->stall == PSIM_STALL && !s->n_stall++)
+				kunit_info(s->test, "step %u: %s awake, %u frames queued, nothing sent for %u steps\n",
+					   s->step, psim_kind_name[ps->kind],
+					   ps->backlog, PSIM_STALL);
+		} else {
+			ps->stall = 0;
+		}
+		ps->progress = false;
+	}
+}
+
+static void psim_step(struct psim *s)
+{
+	bool beacon = !(s->step % PSIM_BEACON);
+	unsigned int order = psim_rand(s);
+	int i, k;
+
+	s->step++;
+	if (!s->quiesce)
+		psim_traffic(s);
+
+	/* the firmware's events, the stations and the air, in some order */
+	for (k = 0; k < 3; k++) {
+		switch ((order >> (2 * k)) % 3) {
+		case 0:
+			psim_deliver_events(s);
+			break;
+		case 1:
+			for (i = 0; i < s->cfg->n_sta; i++)
+				if (s->sta[i].present)
+					psim_behave(s, &s->sta[i], beacon);
+			break;
+		default:
+			psim_transmit(s);
+			break;
+		}
+		if (psim_chance(s, 300))
+			psim_worker(s);
+	}
+
+	/* the AP scans now and then (mt76_set_channel()) */
+	if (s->cfg->offchannel && !s->quiesce) {
+		if (!s->dev->phy.offchannel && psim_chance(s, 3)) {
+			s->dev->phy.offchannel = true;
+			s->offchannel_until = s->step + psim_range(s, 5, 50);
+		} else if (s->dev->phy.offchannel &&
+			   s->step >= s->offchannel_until) {
+			s->dev->phy.offchannel = false;
+			mt76_worker_schedule(&s->dev->tx_worker);
+		}
+	}
+	if (s->quiesce && s->dev->phy.offchannel) {
+		s->dev->phy.offchannel = false;
+		mt76_worker_schedule(&s->dev->tx_worker);
+	}
+
+	if (s->cfg->leave && !s->quiesce && psim_chance(s, s->cfg->leave)) {
+		i = psim_rand(s) % s->cfg->n_sta;
+		if (s->sta[i].kind != PSIM_LAPTOP)
+			psim_sta_leave(s, i);
+	}
+
+	while (psim_worker(s))
+		;
+	psim_check(s);
+}
+
+static bool psim_busy(struct psim *s)
+{
+	int i;
+
+	if (!list_empty(&s->events) || s->n_late)
+		return true;
+	for (i = 0; i < s->cfg->n_sta; i++)
+		if (s->sta[i].present && s->sta[i].backlog)
+			return true;
+	return false;
+}
+
+static void psim_report(struct psim *s)
+{
+	int i;
+
+	for (i = 0; i < s->cfg->n_sta; i++) {
+		struct psim_sta *ps = &s->sta[i];
+		unsigned long done = ps->acked + ps->failed;
+
+		kunit_info(s->test, "%-8s queued %lu acked %lu failed %lu dropped %lu wakes %lu polls %lu latency avg %lu max %lu steps%s\n",
+			   psim_kind_name[ps->kind], ps->queued, ps->acked,
+			   ps->failed, ps->dropped, ps->wakes, ps->polls,
+			   done ? ps->latency_sum / done : 0, ps->latency_max,
+			   ps->gen ? " (rejoined)" : "");
+	}
+	if (s->events_lost || s->tim_warn || s->n_ps_burst_late ||
+	    (s->cfg->one_hash && s->n_order))
+		kunit_info(s->test, "events lost %lu, AC-steps held with nothing in the firmware %lu, extra frames while held after late completions %u, out of order (fq collisions) %u\n",
+			   s->events_lost, s->tim_warn, s->n_ps_burst_late,
+			   s->cfg->one_hash ? s->n_order : 0);
+}
+
+static void psim_run(struct kunit *test, const struct psim_cfg *cfg)
+{
+	struct psim *s;
+	unsigned int n;
+	int i, ac;
+	u32 id;
+
+	skb_queue_head_init(&psim_skbs);
+	s = psim_init(test, cfg);
+
+	for (n = 0; n < cfg->steps; n++)
+		psim_step(s);
+
+	/*
+	 * Lost wake events leave the driver holding an awake station until
+	 * its next doze and wake. Count them, then have the firmware report
+	 * everyone again so the end checks look at the rest.
+	 */
+	for (i = 0; i < cfg->n_sta; i++) {
+		struct psim_sta *ps = &s->sta[i];
+
+		struct psim_event *ev;
+		bool on_its_way = false;
+
+		list_for_each_entry(ev, &s->events, list)
+			if (ev->sta == i && ev->gen == ps->gen)
+				on_its_way = true;
+		if (ps->present && !ps->dozing && !on_its_way &&
+		    test_bit(MT_WCID_FLAG_PS, &psim_wcid(ps)->flags))
+			kunit_info(test, "%s held while awake at the end (a lost wake event)\n",
+				   psim_kind_name[ps->kind]);
+	}
+
+	/* everyone awake, every event delivered, until nothing moves */
+	s->quiesce = true;
+	if (cfg->lost_events)
+		for (i = 0; i < cfg->n_sta; i++)
+			if (s->sta[i].present)
+				psim_event(s, &s->sta[i], s->sta[i].dozing);
+	for (n = 0; n < 2000 && psim_busy(s); n++)
+		psim_step(s);
+	for (n = 0; n < 10; n++)
+		psim_step(s);
+
+	psim_print_notes(s);
+	psim_report(s);
+
+	KUNIT_EXPECT_EQ_MSG(test, s->n_vanished, 0,
+			    "frames freed without going on the air");
+	/*
+	 * In one fq bucket, a station's frames end up in two flows when
+	 * another station held the bucket's flow at first (its tin's default
+	 * flow, then the bucket's): mac80211's fq can then send newer ones
+	 * first. Holding frames makes those collisions last; that's fq's,
+	 * reported above.
+	 */
+	if (!cfg->one_hash)
+		KUNIT_EXPECT_EQ_MSG(test, s->n_order, 0, "frames out of order");
+	KUNIT_EXPECT_EQ_MSG(test, s->n_stall, 0, "awake stations stalled");
+	KUNIT_EXPECT_EQ_MSG(test, s->n_tim, 0,
+			    "held stations with nothing in the firmware");
+	KUNIT_EXPECT_EQ_MSG(test, s->n_ps_burst, 0,
+			    "more than one frame per AC while held");
+	KUNIT_EXPECT_FALSE_MSG(test, psim_busy(s), "still busy after %u steps",
+			       n);
+
+	for (i = 0; i < cfg->n_sta; i++) {
+		struct psim_sta *ps = &s->sta[i];
+		struct mt76_wcid *wcid;
+
+		if (!ps->present)
+			continue;
+		wcid = psim_wcid(ps);
+		KUNIT_EXPECT_EQ_MSG(test, ps->backlog, 0, "%s",
+				    psim_kind_name[ps->kind]);
+		KUNIT_EXPECT_FALSE_MSG(test,
+				       test_bit(MT_WCID_FLAG_PS, &wcid->flags),
+				       "%s still held", psim_kind_name[ps->kind]);
+		KUNIT_EXPECT_EQ_MSG(test,
+				    atomic_read(&wcid->non_aql_packets), 0,
+				    "%s non-AQL", psim_kind_name[ps->kind]);
+		for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+			KUNIT_EXPECT_EQ_MSG(test, ps->fw_len[ac], 0, "%s AC %d",
+					    psim_kind_name[ps->kind], ac);
+			KUNIT_EXPECT_EQ_MSG(test,
+				atomic_read(&ps->si->airtime[ac].aql_tx_pending),
+				0, "%s AQL AC %d", psim_kind_name[ps->kind], ac);
+		}
+	}
+	KUNIT_EXPECT_EQ(test, atomic_read(&s->local->aql_total_pending_airtime),
+			0);
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
+		KUNIT_EXPECT_EQ(test,
+			atomic_read(&s->local->aql_ac_pending_airtime[ac]), 0);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&psim_skbs));
+
+	/* every frame ended on the air, or with the station that left */
+	for (id = 0; id < s->n_frames; id++) {
+		struct psim_frame *f = &s->frames[id];
+
+		if (f->state == PF_ACKED || f->state == PF_FAILED)
+			continue;
+		if (f->state == PF_DROPPED &&
+		    (f->gen != s->sta[f->sta].gen || !s->sta[f->sta].present))
+			continue;
+		KUNIT_FAIL(test, "frame %u (%s tid %u seq %u) ended in state %u",
+			   id, psim_kind_name[s->sta[f->sta].kind], f->tid,
+			   f->seq, f->state);
+		break;
+	}
+	skb_queue_purge(&psim_skbs);
+}
+
+/* the five kinds of client, the laptop first */
+#define PSIM_ALL_KINDS \
+	.kinds = { PSIM_LAPTOP, PSIM_PHONE, PSIM_SCANNER, PSIM_SENSOR, \
+		   PSIM_FLAPPER, PSIM_PHONE }, \
+	.n_sta = 6
+
+static const struct psim_cfg psim_cases[] = {
+	{ .seed = 1, .steps = 20000, .ps_sync = true, .event_delay = 2,
+	  PSIM_ALL_KINDS },
+	{ .seed = 2, .steps = 20000, .ps_sync = true, .event_delay = 8,
+	  PSIM_ALL_KINDS },
+	{ .seed = 3, .steps = 20000, .ps_sync = true, .event_delay = 3,
+	  .offchannel = true, PSIM_ALL_KINDS },
+	{ .seed = 4, .steps = 20000, .ps_sync = true, .event_delay = 3,
+	  .leave = 3, .late_free = 500, PSIM_ALL_KINDS },
+	{ .seed = 5, .steps = 20000, .ps_sync = true, .event_delay = 3,
+	  .lost_events = 20, PSIM_ALL_KINDS },
+	{ .seed = 6, .steps = 20000, .ps_sync = true, .event_delay = 4,
+	  .offchannel = true, .leave = 2, .late_free = 300,
+	  .lost_events = 5, PSIM_ALL_KINDS },
+	/* doze events landing in the middle of the tx worker's bursts */
+	{ .seed = 8, .steps = 20000, .ps_sync = true, .event_delay = 4,
+	  .midburst = 200, PSIM_ALL_KINDS },
+	/* every frame in fq's same bucket: with and without holding */
+	{ .seed = 9, .steps = 20000, .ps_sync = true, .event_delay = 3,
+	  .one_hash = true, PSIM_ALL_KINDS },
+	{ .seed = 9, .steps = 20000, .ps_sync = false, .event_delay = 3,
+	  .one_hash = true, PSIM_ALL_KINDS },
+	/* leavers whose frames the firmware drops at once */
+	{ .seed = 10, .steps = 20000, .ps_sync = true, .event_delay = 3,
+	  .leave = 3, PSIM_ALL_KINDS },
+	/* as stock mt76: every event says awake, nothing is held */
+	{ .seed = 7, .steps = 20000, .ps_sync = false, .event_delay = 3,
+	  .offchannel = true, .leave = 2, PSIM_ALL_KINDS },
+};
+
+static void psim_case_desc(const struct psim_cfg *cfg, char *desc)
+{
+	snprintf(desc, KUNIT_PARAM_DESC_SIZE,
+		 "seed %u ps_sync %d delay %u%s%s%s%s%s%s", cfg->seed, cfg->ps_sync,
+		 cfg->event_delay, cfg->offchannel ? " scans" : "",
+		 cfg->leave ? " leavers" : "",
+		 cfg->lost_events ? " lost-events" : "",
+		 cfg->midburst ? " mid-burst" : "",
+		 cfg->one_hash ? " one-hash" : "",
+		 cfg->late_free ? " late-frees" : "");
+}
+
+KUNIT_ARRAY_PARAM(psim, psim_cases, psim_case_desc);
+
+static void mt76_psim_test_run(struct kunit *test)
+{
+	psim_run(test, test->param_value);
+}
+
+/* the same mix with many seeds, shorter */
+#define PSIM_SEEDS	32
+
+static struct psim_cfg psim_seed_cfgs[PSIM_SEEDS];
+
+static const void *psim_seed_params(const void *prev, char *desc)
+{
+	const struct psim_cfg *cfg = prev;
+	int i;
+
+	if (!prev) {
+		for (i = 0; i < PSIM_SEEDS; i++)
+			psim_seed_cfgs[i] = (struct psim_cfg) {
+				.seed = 100 + i, .steps = 3000,
+				.ps_sync = true, .event_delay = 5,
+				.offchannel = true, .leave = 3,
+				.late_free = 400, PSIM_ALL_KINDS,
+			};
+		cfg = psim_seed_cfgs;
+	} else if (++cfg >= psim_seed_cfgs + PSIM_SEEDS) {
+		return NULL;
+	}
+	psim_case_desc(cfg, desc);
+	return cfg;
+}
+
+static struct kunit_case mt76_psim_test_cases[] = {
+	KUNIT_CASE_PARAM(mt76_psim_test_run, psim_gen_params),
+	KUNIT_CASE_PARAM(mt76_psim_test_run, psim_seed_params),
+	{}
+};
+
+static struct kunit_suite mt76_psim_test_suite = {
+	.name = "mt76-ps-sim",
+	.test_cases = mt76_psim_test_cases,
+};
+
+kunit_test_suites(&mt76_psim_test_suite);
