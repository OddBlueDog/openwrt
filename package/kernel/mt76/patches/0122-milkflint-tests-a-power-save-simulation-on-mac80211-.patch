From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Wed, 4 Nov 2026 10:59:03 +0000
Subject: [PATCH] milkflint tests: a power save simulation on mac80211's own
 stations

tx-test.c checks the PS pieces one at a time on bare stations. How they
work together, under mac80211's real fq flows, AQL and airtime
scheduler, wasn't tested: a lost wakeup, a txq left off the active list,
a dozing station whose TIM bit never gets set, airtime that is never
given back.

mt76-ps-sim runs mt76's tx path on a hw that is allocated but never
registered, with an AP interface and sta_info stations added and
removed through mt76_sta_state(), as mt7915 drives mac80211 on the
GL-MT6000. Under it, a model of the firmware and the air: per-station
buffers it sends from while the station is awake and holds while it
dozes (its TIM bit set while it holds any), PS sync events that reach
the driver late, tx-free events completing frames as mt7915 does.
Its clients: a laptop that never dozes, phones that doze when idle and
wake for their TIM bit, a Mac that leaves the channel to scan, a sensor
that fetches one frame per PS-Poll, and a station that flips every step
or two. Seeded randomness, so a failure replays; the tx worker runs only
when something scheduled it.

Checked as it runs and at the end: no frame freed without going on the
air, each TID in order, an awake backlog drains, a held station has a
frame in the firmware for each AC with frames queued and no more than
one, AQL and non-AQL accounting back to zero. Cases add late events,
lost events, AP scans, stations that leave (their frames dropped at
once or completing late), doze events mid-burst, one fq bucket for
every frame, and ps_sync off; 32 more seeds run the mix.

tx.c sees mac80211's internal headers in this build only (Makefile).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Makefile            |    6 +
 tests/ps-sim-test.c | 1493 +++++++++++++++++++++++++++++++++++++++++++
 tx.c                |    1 +
 3 files changed, 1500 insertions(+)
 create mode 100644 tests/ps-sim-test.c

diff --git a/Makefile b/Makefile
index da760841..07cd3c07 100644
--- a/Makefile
+++ b/Makefile
@@ -5,6 +5,12 @@ ccflags-y += -Werror -DCONFIG_MT76_LEDS
 ifneq ($(MT76_RECORD),)
 ccflags-y += -DCONFIG_MT76_RECORD
 endif
+# milkflint's KUnit tests (QEMU test build only): the power save simulation
+# (tests/ps-sim-test.c) runs mt76 on mac80211's own stations and txqs, so
+# tx.c sees mac80211's internal headers there
+ifneq ($(findstring -DCONFIG_MT76_KUNIT_TEST,$(NOSTDINC_FLAGS)),)
+CFLAGS_tx.o += -I$(firstword $(wildcard $(KBUILD_EXTMOD)/../mac80211-*/backports-*/net/mac80211))
+endif
 obj-m := mt76.o
 obj-$(CONFIG_MT76_USB) += mt76-usb.o
 obj-$(CONFIG_MT76_SDIO) += mt76-sdio.o
diff --git a/tests/ps-sim-test.c b/tests/ps-sim-test.c
new file mode 100644
index 00000000..b5691809
--- /dev/null
+++ b/tests/ps-sim-test.c
@@ -0,0 +1,1493 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * A power save simulation for mt76's tx path (milkflint's QEMU test build
+ * only; included at the end of tx.c, after tx-test.c).
+ *
+ * Unlike tx-test.c, the stations and txqs here are mac80211's own: a hw
+ * that is allocated but never registered, with mac80211's fq/codel flows,
+ * AQL and airtime scheduler, one AP interface and real sta_info stations,
+ * set up as mt7915 drives mac80211
+ * on the GL-MT6000 (802.3 tx encap, AP_LINK_PS, AQL, airtime fairness).
+ * Stations come and go through mt76_sta_state(), as mac80211 calls it.
+ *
+ * Under mt76's scheduler sits a model of the MT7986 firmware and the air:
+ *
+ * - The hardware ring is shared by all ACs, as on connac: the driver's
+ *   frames land in it, and DMA moves them into the firmware's per-station,
+ *   per-AC buffers, in order.
+ * - The firmware sends a station's frames while it is awake. While it
+ *   dozes they wait there (the firmware's own PS buffering), and its TIM
+ *   bit is set while any do.
+ * - Each doze and wake is reported as a PS sync event that reaches the
+ *   driver some steps later, where mt7915_mcu_rx_ps_sync() turns it into
+ *   mt76_sta_ps_transition() (dozing && ps_sync).
+ * - A tx-free event completes what was sent, as mt7915_mac_tx_free() does:
+ *   DMA cleanup, __mt76_tx_complete_skb() per frame, then the tx worker is
+ *   scheduled. The airtime used goes to mac80211's scheduler, as
+ *   mt7915_mac_sta_poll() reports it.
+ *
+ * The clients: a laptop that never dozes, a phone that dozes when idle and
+ * wakes for its TIM bit, a Mac that leaves the channel to scan whatever is
+ * queued, a sensor that stays asleep and fetches one frame per PS-Poll
+ * (more data from the firmware's buffer), and a station that flips between
+ * doze and wake every step or two.
+ *
+ * Everything random comes from a seeded PRNG, so a failing seed replays.
+ * The tx worker is parked: it runs only when something scheduled it, so a
+ * lost wakeup shows. Checked as it runs and at the end (everyone awake, run
+ * until quiet):
+ *
+ * - every frame is delivered or fails on the air: none is freed anywhere
+ *   else (except those of a station that leaves);
+ * - each TID's frames arrive in order;
+ * - an awake station's backlog drains;
+ * - a station the driver holds frames for has one in the firmware per AC
+ *   with frames queued (or the firmware has nothing to set its TIM bit for,
+ *   and it is never told to wake), and never more than one queued while
+ *   the AC has airtime pending;
+ * - AQL and non-AQL accounting go back to zero.
+ */
+/*
+ * mac80211's sta_info.h declares the same EWMA as mt76.h (signal): its copy
+ * gets other names here (DECLARE_EWMA pastes them, and the result is
+ * expanded again)
+ */
+#define ewma_signal		psim_mac80211_ewma_signal
+#define ewma_signal_init	psim_mac80211_ewma_signal_init
+#define ewma_signal_read	psim_mac80211_ewma_signal_read
+#define ewma_signal_add		psim_mac80211_ewma_signal_add
+#include "ieee80211_i.h"
+#include "sta_info.h"
+#undef ewma_signal
+#undef ewma_signal_init
+#undef ewma_signal_read
+#undef ewma_signal_add
+
+/* MODULE_IMPORT_NS() of either form: 6.12 stringifies its argument, 6.13+
+ * takes a string (and backports' module.h may or may not have caught up)
+ */
+MODULE_INFO(import_ns, "EXPORTED_FOR_KUNIT_TESTING");
+
+#define PSIM_MAX_STA		6
+#define PSIM_NDESC		256
+#define PSIM_MAX_FRAMES		(1 << 16)
+#define PSIM_BEACON		20	/* steps between beacons (DTIM 1) */
+#define PSIM_STALL		60	/* steps an awake backlog may sit */
+#define PSIM_BACKLOG		256	/* frames a station may have queued */
+
+enum psim_kind {
+	PSIM_LAPTOP,
+	PSIM_PHONE,
+	PSIM_SCANNER,
+	PSIM_SENSOR,
+	PSIM_FLAPPER,
+	__PSIM_KINDS,
+};
+
+static const char * const psim_kind_name[] = {
+	"laptop", "phone", "scanner", "sensor", "flapper",
+};
+
+enum psim_fstate {
+	PF_UNUSED,
+	PF_QUEUED,	/* in mac80211 or mt76 */
+	PF_HW,		/* handed to the hardware */
+	PF_ACKED,
+	PF_FAILED,
+	PF_DROPPED,	/* freed without going on the air */
+};
+
+struct psim_frame {
+	u8 state;
+	u8 sta;
+	u8 tid;
+	u8 gen;		/* the station's association it was for */
+	bool ps;	/* queued to the hardware while the driver held the sta */
+	u32 seq;
+	u32 step;	/* when it was queued in mac80211 */
+};
+
+struct psim_event {
+	struct list_head list;
+	u32 due;
+	u8 sta;
+	u8 gen;
+	bool dozing;
+};
+
+struct psim_sta {
+	struct sta_info *si;
+	enum psim_kind kind;
+	bool present;
+	u8 gen;
+	u16 idx;		/* its wcid */
+
+	bool dozing;		/* the truth, as the firmware knows it */
+	bool polling;		/* sensor: fetching with PS-Poll */
+	u32 wake_until;		/* scanner: back on channel; phone: idle */
+	unsigned int idle;
+
+	/* the firmware's buffers: frame ids, oldest first */
+	u32 fw[IEEE80211_NUM_ACS][PSIM_BACKLOG * 2];
+	unsigned int fw_head[IEEE80211_NUM_ACS], fw_len[IEEE80211_NUM_ACS];
+	unsigned int ps_out[IEEE80211_NUM_ACS];
+	unsigned int late_hits;	/* completions of a former station's frames */
+
+	u32 seq[IEEE80211_NUM_TIDS];
+	u32 last_rx[IEEE80211_NUM_TIDS];
+	bool rx_any[IEEE80211_NUM_TIDS];
+	unsigned int backlog;	/* frames queued and not yet done */
+	unsigned int stall;	/* steps awake with a backlog and no progress */
+	bool progress;
+	u32 airtime[IEEE80211_NUM_ACS];	/* to report to mac80211 */
+
+	/* for the report */
+	unsigned long queued, acked, failed, dropped, polls, wakes;
+	unsigned long latency_sum, latency_max;
+};
+
+struct psim_cfg {
+	u32 seed;
+	unsigned int steps;
+	bool ps_sync;			/* the driver holds a dozing sta's frames */
+	unsigned int event_delay;	/* max steps an event is late */
+	unsigned int lost_events;	/* per mille of PS sync events lost */
+	unsigned int leave;		/* per mille per step: a station leaves */
+	unsigned int late_free;		/* per mille: a leaver's frames complete late */
+	bool offchannel;		/* the AP scans now and then */
+	unsigned int midburst;		/* per mille: a doze event lands mid-burst */
+	bool one_hash;			/* every frame hashes alike: fq collisions */
+	enum psim_kind kinds[PSIM_MAX_STA];
+	int n_sta;
+};
+
+struct psim {
+	struct kunit *test;
+	const struct psim_cfg *cfg;
+	struct mt76_dev *dev;
+	struct ieee80211_hw *hw;
+	struct ieee80211_local *local;
+	struct ieee80211_sub_if_data *sdata;
+	struct txq_info *vif_txqi;
+	struct net_device *ndev;
+	struct ieee80211_supported_band sband;
+	struct mt76_queue *q;
+	bool flows;
+
+	struct psim_sta sta[PSIM_MAX_STA];
+	unsigned long wcid_used;
+	/* frames of stations that left, completing late */
+	u32 late[PSIM_BACKLOG * 4];
+	u16 late_idx[PSIM_BACKLOG * 4];
+	unsigned int n_late;
+
+	struct psim_frame *frames;
+	u32 n_frames;
+	struct list_head events;
+	u32 step;
+	u32 rng;
+	atomic_t worker_due;
+	bool quiesce;
+	unsigned int offchannel_until;
+
+	/* what went wrong, the first of each kind reported in full (noted
+	 * where the driver may hold locks, printed in psim_check())
+	 */
+	char note[8][160];
+	unsigned int n_notes;
+	unsigned int n_vanished, n_order, n_stall, n_tim, n_ps_burst;
+	/* more than one frame while held, after a former station's frames
+	 * completed on this one's wcid and released its airtime
+	 */
+	unsigned int n_ps_burst_late;
+	unsigned long tim_warn;		/* an AC held with nothing in the fw */
+	unsigned long events_lost;
+};
+
+static struct psim *psim_ctx;
+
+static __printf(2, 3) void psim_note(struct psim *s, const char *fmt, ...)
+{
+	va_list args;
+
+	if (s->n_notes >= ARRAY_SIZE(s->note))
+		return;
+	va_start(args, fmt);
+	vsnprintf(s->note[s->n_notes++], sizeof(s->note[0]), fmt, args);
+	va_end(args);
+}
+
+static void psim_print_notes(struct psim *s)
+{
+	unsigned int i;
+
+	for (i = 0; i < s->n_notes; i++)
+		kunit_info(s->test, "%s", s->note[i]);
+	s->n_notes = 0;
+}
+
+/* the skbs the firmware model holds, whatever station they are for */
+static struct sk_buff_head psim_skbs;
+
+static const u8 psim_ap_addr[ETH_ALEN] = { 0x02, 0x50, 0x53, 0x00, 0x00, 0x01 };
+static const u8 psim_lan_addr[ETH_ALEN] = { 0x02, 0x4c, 0x41, 0x4e, 0x00, 0x01 };
+static const u8 psim_tid_to_ac[8] = {
+	IEEE80211_AC_BE, IEEE80211_AC_BK, IEEE80211_AC_BK, IEEE80211_AC_BE,
+	IEEE80211_AC_VI, IEEE80211_AC_VI, IEEE80211_AC_VO, IEEE80211_AC_VO,
+};
+static const u8 psim_tids[] = { 0, 0, 0, 0, 0, 3, 5, 6, 1 };
+
+static u32 psim_rand(struct psim *s)
+{
+	/* xorshift32 */
+	s->rng ^= s->rng << 13;
+	s->rng ^= s->rng >> 17;
+	s->rng ^= s->rng << 5;
+	return s->rng;
+}
+
+static bool psim_chance(struct psim *s, unsigned int per_mille)
+{
+	return psim_rand(s) % 1000 < per_mille;
+}
+
+static unsigned int psim_range(struct psim *s, unsigned int lo, unsigned int hi)
+{
+	return lo + psim_rand(s) % (hi - lo + 1);
+}
+
+static struct mt76_wcid *psim_wcid(struct psim_sta *ps)
+{
+	return (struct mt76_wcid *)ps->si->sta.drv_priv;
+}
+
+/* the mac80211 hw ops: what mt76 drivers give it for the tx side */
+static const struct ieee80211_ops psim_hw_ops = {
+	.tx = mt76_test_tx,
+	.start = mt76_test_start,
+	.stop = mt76_test_stop,
+	.add_interface = mt76_test_add_interface,
+	.remove_interface = mt76_test_remove_interface,
+	.config = mt76_test_config,
+	.configure_filter = mt76_test_configure_filter,
+	.wake_tx_queue = mt76_wake_tx_queue,
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
+};
+
+static int psim_drv_sta_add(struct mt76_dev *dev, struct ieee80211_vif *vif,
+			    struct ieee80211_sta *sta)
+{
+	struct mt76_wcid *wcid = (struct mt76_wcid *)sta->drv_priv;
+	struct psim *s = psim_ctx;
+	int idx;
+
+	/* the lowest free index, as mt76_wcid_alloc() hands them out */
+	idx = find_next_zero_bit(&s->wcid_used, BITS_PER_LONG, 1);
+	if (idx >= BITS_PER_LONG)
+		return -ENOSPC;
+	__set_bit(idx, &s->wcid_used);
+	wcid->idx = idx;
+	wcid->sta = 1;
+	wcid->tx_info = MT_WCID_TX_INFO_SET;
+	return 0;
+}
+
+static void psim_drv_sta_remove(struct mt76_dev *dev, struct ieee80211_vif *vif,
+				struct ieee80211_sta *sta)
+{
+	struct mt76_wcid *wcid = (struct mt76_wcid *)sta->drv_priv;
+
+	__clear_bit(wcid->idx, &psim_ctx->wcid_used);
+}
+
+static void psim_drv_tx_complete(struct mt76_dev *dev,
+				 struct mt76_queue_entry *e)
+{
+}
+
+/* mt7915's tx-side driver flags */
+static const struct mt76_driver_ops psim_drv = {
+	.drv_flags = MT_DRV_TXWI_NO_FREE | MT_DRV_HW_MGMT_TXQ |
+		     MT_DRV_AMSDU_OFFLOAD | MT_DRV_HW_PS_BUFFERING,
+	.sta_add = psim_drv_sta_add,
+	.sta_remove = psim_drv_sta_remove,
+	.tx_complete_skb = psim_drv_tx_complete,
+};
+
+static u32 psim_skb_id(struct sk_buff *skb)
+{
+	return skb->mark - 1;
+}
+
+/* The hardware ring: the driver's frame goes into the firmware's buffer
+ * for its station and AC (DMA moves it there; psim_dma() frees the ring).
+ */
+static int psim_queue_skb(struct mt76_phy *phy, struct mt76_queue *q,
+			  enum mt76_txq_id qid, struct sk_buff *skb,
+			  struct mt76_wcid *wcid, struct ieee80211_sta *sta)
+{
+	struct psim *s = psim_ctx;
+	struct kunit *test = s->test;
+	u32 id = psim_skb_id(skb);
+	struct psim_frame *f;
+	struct psim_sta *ps;
+	int idx, ac, pos;
+
+	KUNIT_ASSERT_LT(test, id, s->n_frames);
+	f = &s->frames[id];
+	KUNIT_ASSERT_EQ_MSG(test, f->state, PF_QUEUED,
+			    "frame %u handed to the hardware twice", id);
+	ps = &s->sta[f->sta];
+	KUNIT_ASSERT_TRUE(test, ps->present && ps->gen == f->gen);
+	KUNIT_ASSERT_PTR_EQ(test, wcid, psim_wcid(ps));
+	KUNIT_ASSERT_LT(test, (int)q->queued, q->ndesc);
+
+	ac = psim_tid_to_ac[f->tid];
+	f->state = PF_HW;
+	if (test_bit(MT_WCID_FLAG_PS, &wcid->flags)) {
+		/*
+		 * Held: one frame at a time per AC, once the AC has no
+		 * airtime pending (it has this frame's now).
+		 */
+		f->ps = true;
+		if (++ps->ps_out[ac] > 1 && ps->late_hits)
+			s->n_ps_burst_late++;
+		else if (ps->ps_out[ac] > 1 && !s->n_ps_burst++)
+			psim_note(s, "step %u: %s got %u frames on AC %d while held (AQL pending %d us)\n",
+				  s->step, psim_kind_name[ps->kind],
+				  ps->ps_out[ac], ac,
+				  atomic_read(&ps->si->airtime[ac].aql_tx_pending));
+	}
+
+	KUNIT_ASSERT_LT(test, ps->fw_len[ac], ARRAY_SIZE(ps->fw[ac]));
+	pos = (ps->fw_head[ac] + ps->fw_len[ac]) % ARRAY_SIZE(ps->fw[ac]);
+	ps->fw[ac][pos] = id;
+	ps->fw_len[ac]++;
+	ps->progress = true;
+	__skb_queue_tail(&psim_skbs, skb);
+
+	/*
+	 * mt7915 handles PS sync events in its MCU NAPI, maybe on another
+	 * CPU while the tx worker is in the middle of a burst: the next doze
+	 * event lands now (only a doze: set_bit, nothing locked).
+	 */
+	if (s->cfg->midburst && !list_empty(&s->events) &&
+	    psim_chance(s, s->cfg->midburst)) {
+		struct psim_event *ev = list_first_entry(&s->events,
+						struct psim_event, list);
+		struct psim_sta *eps = &s->sta[ev->sta];
+
+		if (ev->dozing && eps->present && eps->gen == ev->gen) {
+			list_del(&ev->list);
+			mt76_sta_ps_transition(s->dev, psim_wcid(eps),
+					       s->cfg->ps_sync);
+			kfree(ev);
+		}
+	}
+
+	/* the skb stays with the firmware model until it completes */
+	idx = q->head;
+	q->head = (q->head + 1) % q->ndesc;
+	q->queued++;
+	return idx;
+}
+
+static void psim_dma(struct psim *s)
+{
+	struct mt76_queue *q = s->q;
+	bool stopped = q->queued + MT_TXQ_FREE_THR >= q->ndesc;
+
+	q->queued = 0;
+	q->tail = q->head;
+	/* as mt76_dma_tx_cleanup() wakes tx once a stopped ring has room */
+	if (stopped)
+		mt76_worker_schedule(&s->dev->tx_worker);
+}
+
+static void psim_tx_cleanup(struct mt76_dev *dev, struct mt76_queue *q,
+			    bool flush)
+{
+	struct psim *s = psim_ctx;
+
+	/* the scheduler asks before the ring fills; DMA may not be done */
+	if (flush || psim_chance(s, 500))
+		psim_dma(s);
+}
+
+static void psim_kick(struct mt76_dev *dev, struct mt76_queue *q)
+{
+}
+
+static const struct mt76_queue_ops psim_queue_ops = {
+	.tx_queue_skb = psim_queue_skb,
+	.tx_cleanup = psim_tx_cleanup,
+	.kick = psim_kick,
+};
+
+/* what the skbs are freed with: one that never went on the air vanished */
+static void psim_skb_destructor(struct sk_buff *skb)
+{
+	struct psim *s = psim_ctx;
+	struct psim_frame *f;
+	u32 id;
+
+	if (!s || !skb->mark)
+		return;
+	id = psim_skb_id(skb);
+	if (id >= s->n_frames)
+		return;
+	f = &s->frames[id];
+	if (f->state == PF_ACKED || f->state == PF_FAILED)
+		return;
+	if (f->state == PF_QUEUED || f->state == PF_HW) {
+		struct psim_sta *ps = &s->sta[f->sta];
+		bool hw = f->state == PF_HW;
+
+		f->state = PF_DROPPED;
+		/* a station that left takes its frames with it */
+		if (!ps->present || ps->gen != f->gen)
+			return;
+		ps->dropped++;
+		if (ps->backlog)
+			ps->backlog--;
+		if (!s->n_vanished++)
+			psim_note(s, "step %u: %s's frame %u (tid %u seq %u) freed while %s, without going on the air\n",
+				  s->step, psim_kind_name[ps->kind], id,
+				  f->tid, f->seq,
+				  hw ? "in the hardware" : "queued");
+	}
+}
+
+static void psim_free(void *data)
+{
+	struct psim *s = data;
+	struct psim_event *ev, *tmp;
+	int i;
+
+	list_for_each_entry_safe(ev, tmp, &s->events, list) {
+		list_del(&ev->list);
+		kfree(ev);
+	}
+	/* what the firmware model still held (a test that stopped early) */
+	s->quiesce = true;
+	skb_queue_purge(&psim_skbs);
+	if (!s->hw)
+		return;
+
+	for (i = 0; i < s->cfg->n_sta; i++) {
+		struct psim_sta *ps = &s->sta[i];
+
+		if (!ps->si)
+			continue;
+		if (ps->present) {
+			mt76_sta_pre_rcu_remove(s->hw, &s->sdata->vif,
+						&ps->si->sta);
+			synchronize_rcu();
+			mt76_worker_enable(&s->dev->tx_worker);
+			mt76_sta_state(s->hw, &s->sdata->vif, &ps->si->sta,
+				       IEEE80211_STA_NONE,
+				       IEEE80211_STA_NOTEXIST);
+			mt76_worker_disable(&s->dev->tx_worker);
+		}
+		wiphy_lock(s->hw->wiphy);
+		ieee80211_purge_sta_txqs(ps->si);
+		sta_info_free(s->local, ps->si);
+		wiphy_unlock(s->hw->wiphy);
+		ps->si = NULL;
+	}
+	if (s->vif_txqi)
+		ieee80211_txq_purge(s->local, s->vif_txqi);
+	if (s->flows)
+		ieee80211_txq_teardown_flows(s->local);
+	kfree(s->vif_txqi);
+	kfree(s->sdata);
+	if (s->ndev)
+		free_netdev(s->ndev);
+	psim_ctx = NULL;
+}
+
+static struct ieee80211_channel psim_chan = {
+	.band = NL80211_BAND_5GHZ,
+	.center_freq = 5180,
+	.hw_value = 36,
+};
+
+static struct ieee80211_rate psim_rates[] = {
+	{ .bitrate = 60, .flags = IEEE80211_RATE_MANDATORY_A },
+	{ .bitrate = 120, .flags = IEEE80211_RATE_MANDATORY_A },
+	{ .bitrate = 240, .flags = IEEE80211_RATE_MANDATORY_A },
+	{ .bitrate = 540 },
+};
