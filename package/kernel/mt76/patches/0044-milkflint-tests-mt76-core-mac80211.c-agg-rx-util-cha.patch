+static void mt76_test_free_ext_phy(void *data)
+{
+	struct mt76_phy *phy = data;
+
+	rcu_expedite_gp();
+	if (test_bit(MT76_STATE_REGISTERED, &phy->state))
+		mt76_unregister_phy(phy);
+	ieee80211_free_hw(phy->hw);
+	rcu_unexpedite_gp();
+}
