+/* --- tx power and SAR ----------------------------------------------------- */
+
+/* SAR limits come in 0.25 dBm and are kept in 0.5 dB steps per frequency
+ * range; out-of-range values mean no limit, and malformed specs are refused.
+ */
+static void mt76_test_sar_power(struct kunit *test)
+{
+	const struct cfg80211_sar_capa *capa;
+	struct cfg80211_sar_specs *sar;
+	struct ieee80211_channel *chan;
+	struct mt76_dev *dev;
+	struct mt76_phy *phy;
+
+	dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	phy = &dev->phy;
+	KUNIT_ASSERT_EQ(test, mt76_phy_init(phy, dev->hw), 0);
+	mt76_test_sbands(test, phy);
+	capa = dev->hw->wiphy->sar_capa;
+
+	sar = kunit_kzalloc(test, struct_size(sar, sub_specs, 3), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sar);
+	sar->type = NL80211_SAR_TYPE_POWER;
+	sar->num_sub_specs = 3;
+	sar->sub_specs[0].freq_range_index = 0;	/* 2.4 GHz */
+	sar->sub_specs[0].power = 40;		/* 10 dBm */
+	sar->sub_specs[1].freq_range_index = 3;	/* 5470-5725 */
+	sar->sub_specs[1].power = 600;
+	sar->sub_specs[2].freq_range_index = 1;	/* 5150-5350 */
+	sar->sub_specs[2].power = -600;
+	KUNIT_ASSERT_EQ(test, mt76_init_sar_power(dev->hw, sar), 0);
+	KUNIT_EXPECT_PTR_EQ(test, phy->frp[0].range, &capa->freq_ranges[0]);
+	KUNIT_EXPECT_EQ(test, phy->frp[0].power, 20);
+	KUNIT_EXPECT_PTR_EQ(test, phy->frp[3].range, &capa->freq_ranges[3]);
+	KUNIT_EXPECT_EQ(test, phy->frp[3].power, 127);
+	KUNIT_EXPECT_EQ(test, phy->frp[1].power, 127);
+	KUNIT_EXPECT_NULL(test, phy->frp[2].range);
+
+	/* channel 1 is limited to 10 dBm, lower requests stay */
+	chan = &phy->sband_2g.sband.channels[0];
+	KUNIT_EXPECT_EQ(test, mt76_get_sar_power(phy, chan, 30), 20);
+	KUNIT_EXPECT_EQ(test, mt76_get_sar_power(phy, chan, 16), 16);
+	KUNIT_EXPECT_EQ(test, mt76_get_sar_power(phy, chan, 400), 20);
+	/* channel 100: no real limit; out of range requests are capped */
+	chan = &phy->sband_5g.sband.channels[8];
+	KUNIT_EXPECT_EQ(test, mt76_get_sar_power(phy, chan, 30), 30);
+	KUNIT_EXPECT_EQ(test, mt76_get_sar_power(phy, chan, 400), 127);
+	/* channel 149: in a range without a limit */
+	chan = &phy->sband_5g.sband.channels[20];
+	KUNIT_EXPECT_EQ(test, mt76_get_sar_power(phy, chan, 30), 30);
+
+	/* malformed */
+	sar->num_sub_specs = 0;
+	KUNIT_EXPECT_EQ(test, mt76_init_sar_power(dev->hw, sar), -EINVAL);
+	sar->num_sub_specs = 1;
+	sar->type = NUM_NL80211_SAR_TYPE;
+	KUNIT_EXPECT_EQ(test, mt76_init_sar_power(dev->hw, sar), -EINVAL);
+	KUNIT_EXPECT_EQ(test, phy->frp[0].power, 20);
+
+	/* no SAR support: the power passes as it is */
+	dev->hw->wiphy->sar_capa = NULL;
+	chan = &phy->sband_2g.sband.channels[0];
+	KUNIT_EXPECT_EQ(test, mt76_get_sar_power(phy, chan, 400), 400);
+}
+
+/* The per-chain power limit: the SAR-limited total (in 0.5 dB) minus what
+ * spreading it over the chains adds.
+ */
+static void mt76_test_power_bound(struct kunit *test)
+{
+	struct cfg80211_sar_specs *sar;
+	struct mt76_dev *dev;
+	struct mt76_phy *phy;
+
+	dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	phy = &dev->phy;
+	KUNIT_ASSERT_EQ(test, mt76_phy_init(phy, dev->hw), 0);
+	mt76_test_sbands(test, phy);
+	sar = kunit_kzalloc(test, struct_size(sar, sub_specs, 1), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sar);
+	sar->type = NL80211_SAR_TYPE_POWER;
+	sar->num_sub_specs = 1;
+	sar->sub_specs[0].power = 40;		/* 10 dBm on 2.4 GHz */
+	KUNIT_ASSERT_EQ(test, mt76_init_sar_power(dev->hw, sar), 0);
+
