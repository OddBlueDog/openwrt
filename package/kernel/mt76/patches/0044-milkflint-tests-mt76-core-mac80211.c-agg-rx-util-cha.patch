+/* Per-station tx counters add up into the ethtool array at the worker's
+ * position, in the order the driver's string table lists them.
+ */
+static void mt76_test_ethtool_worker(struct kunit *test)
+{
+	struct mt76_ethtool_worker_info wi = {};
+	struct mt76_sta_stats *stats;
+	u64 *data;
+	int i;
+
+	stats = kunit_kzalloc(test, sizeof(*stats), GFP_KERNEL);
+	data = kunit_kcalloc(test, 64, sizeof(*data), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, stats);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	for (i = 0; i < ARRAY_SIZE(stats->tx_mode); i++)
+		stats->tx_mode[i] = 100 + i;
+	for (i = 0; i < ARRAY_SIZE(stats->tx_bw); i++)
+		stats->tx_bw[i] = 200 + i;
+	for (i = 0; i < ARRAY_SIZE(stats->tx_mcs); i++)
+		stats->tx_mcs[i] = 300 + i;
+	for (i = 0; i < ARRAY_SIZE(stats->tx_nss); i++)
+		stats->tx_nss[i] = 400 + i;
+	wi.data = data;
+	wi.initial_stat_idx = 3;
+
+	/* without EHT: 9 modes, 4 widths, 12 MCS, 4 NSS */
+	mt76_ethtool_worker(&wi, stats, false);
+	mt76_ethtool_worker(&wi, stats, false);
+	KUNIT_EXPECT_EQ(test, wi.sta_count, 2);
+	KUNIT_EXPECT_EQ(test, wi.worker_stat_count, 29);
+	KUNIT_EXPECT_EQ(test, data[2], 0);
+	KUNIT_EXPECT_EQ(test, data[3], 2 * (100 + MT_PHY_TYPE_CCK));
+	KUNIT_EXPECT_EQ(test, data[7], 2 * (100 + MT_PHY_TYPE_VHT));
+	KUNIT_EXPECT_EQ(test, data[8], 2 * (100 + MT_PHY_TYPE_HE_SU));
+	KUNIT_EXPECT_EQ(test, data[11], 2 * (100 + MT_PHY_TYPE_HE_MU));
+	KUNIT_EXPECT_EQ(test, data[12], 2 * 200);
+	KUNIT_EXPECT_EQ(test, data[15], 2 * 203);
+	KUNIT_EXPECT_EQ(test, data[16], 2 * 300);
+	KUNIT_EXPECT_EQ(test, data[27], 2 * 311);
+	KUNIT_EXPECT_EQ(test, data[28], 2 * 400);
+	KUNIT_EXPECT_EQ(test, data[31], 2 * 403);
+	KUNIT_EXPECT_EQ(test, data[32], 0);
+
+	/* with EHT: 12 modes, 5 widths, 14 MCS, 4 NSS */
+	memset(data, 0, 64 * sizeof(*data));
+	memset(&wi, 0, sizeof(wi));
+	wi.data = data;
+	mt76_ethtool_worker(&wi, stats, true);
+	KUNIT_EXPECT_EQ(test, wi.sta_count, 1);
+	KUNIT_EXPECT_EQ(test, wi.worker_stat_count, 35);
+	KUNIT_EXPECT_EQ(test, data[8], 100 + MT_PHY_TYPE_HE_MU);
+	KUNIT_EXPECT_EQ(test, data[9], 100 + MT_PHY_TYPE_EHT_SU);
+	KUNIT_EXPECT_EQ(test, data[11], 100 + MT_PHY_TYPE_EHT_MU);
+	KUNIT_EXPECT_EQ(test, data[16], 204);
+	KUNIT_EXPECT_EQ(test, data[17], 300);
+	KUNIT_EXPECT_EQ(test, data[30], 313);
+	KUNIT_EXPECT_EQ(test, data[31], 400);
+	KUNIT_EXPECT_EQ(test, data[34], 403);
+	KUNIT_EXPECT_EQ(test, data[35], 0);
+}
