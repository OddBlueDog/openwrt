+/* The antennas reported for a hw are the chains of every phy on it. */
+static void mt76_test_get_antenna(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct mt76_phy *band1;
+	u32 tx = 0, rx = 0;
+
+	band1 = mt76_alloc_radio_phy(dev, 0, MT_BAND1);
+	KUNIT_ASSERT_NOT_NULL(test, band1);
+	dev->phy.chainmask = 0x3;
+	band1->chainmask = 0xc;
+	dev->phys[MT_BAND1] = band1;
+
+	KUNIT_EXPECT_EQ(test, mt76_get_antenna(dev->hw, 0, &tx, &rx), 0);
+	KUNIT_EXPECT_EQ(test, tx, 0xf);
+	KUNIT_EXPECT_EQ(test, rx, 0xf);
+
+	/* a phy with a hw of its own doesn't count */
+	band1->hw = NULL;
+	KUNIT_EXPECT_EQ(test, mt76_get_antenna(dev->hw, 0, &tx, &rx), 0);
+	KUNIT_EXPECT_EQ(test, tx, 0x3);
+	KUNIT_EXPECT_EQ(test, rx, 0x3);
+	dev->phys[MT_BAND1] = NULL;
+}
