+/* --- the rx path ---------------------------------------------------------- */
+
+/* Frames for a phy that isn't running are dropped; the others queue for the
+ * rx queue's completion, by the phy of their band.
+ */
+static void mt76_test_rx_needs_running_phy(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct sk_buff_head *rxq = &dev->rx_skb[MT_RXQ_MAIN];
+	struct mt76_phy *band1;
+	struct sk_buff *skb;
+
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 8);
+	mt76_rx(dev, MT_RXQ_MAIN, mt76_test_counted(skb));
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 1);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(rxq));
+
+	set_bit(MT76_STATE_RUNNING, &dev->phy.state);
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 8);
+	mt76_rx(dev, MT_RXQ_MAIN, mt76_test_counted(skb));
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 1);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(rxq), 1);
+	KUNIT_EXPECT_PTR_EQ(test, skb_peek(rxq), skb);
+
+	/* band 1's frames: its phy is down although band 0's is up */
+	band1 = mt76_alloc_radio_phy(dev, 0, MT_BAND1);
+	KUNIT_ASSERT_NOT_NULL(test, band1);
+	dev->phys[MT_BAND1] = band1;
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 2, 8);
+	mt76_test_status(skb)->phy_idx = MT_BAND1;
+	mt76_rx(dev, MT_RXQ_MAIN, mt76_test_counted(skb));
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 2);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(rxq), 1);
+
+	set_bit(MT76_STATE_RUNNING, &band1->state);
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 2, 8);
+	mt76_test_status(skb)->phy_idx = MT_BAND1;
+	mt76_rx(dev, MT_RXQ_MAIN, skb);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(rxq), 2);
+	KUNIT_EXPECT_PTR_EQ(test, skb_peek_tail(rxq), skb);
+
+	skb_queue_purge(rxq);
+	dev->phys[MT_BAND1] = NULL;
+}
+
+/* The subframes of an A-MSDU are held until the last one and then queued as
+ * one frame, the later subframes on the first one's frag_list.
+ */
+static void mt76_test_rx_amsdu_reassembly(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct sk_buff_head *rxq = &dev->rx_skb[MT_RXQ_MAIN];
+	struct mt76_phy *phy = &dev->phy;
+	struct sk_buff *a, *b, *c;
+
+	set_bit(MT76_STATE_RUNNING, &phy->state);
+	a = mt76_test_amsdu(test, 1, 5, true, false, mt76_hwt_addr);
+	b = mt76_test_amsdu(test, 2, 5, false, false, mt76_hwt_addr);
+	c = mt76_test_amsdu(test, 3, 5, false, true, mt76_hwt_addr);
+
+	mt76_rx(dev, MT_RXQ_MAIN, a);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(rxq));
+	KUNIT_EXPECT_PTR_EQ(test, phy->rx_amsdu[MT_RXQ_MAIN].head, a);
+	KUNIT_EXPECT_EQ(test, phy->rx_amsdu[MT_RXQ_MAIN].seqno, 5);
+	mt76_rx(dev, MT_RXQ_MAIN, b);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(rxq));
+	mt76_rx(dev, MT_RXQ_MAIN, c);
+
+	KUNIT_ASSERT_EQ(test, skb_queue_len(rxq), 1);
+	KUNIT_EXPECT_PTR_EQ(test, skb_peek(rxq), a);
+	KUNIT_EXPECT_PTR_EQ(test, skb_shinfo(a)->frag_list, b);
+	KUNIT_EXPECT_PTR_EQ(test, b->next, c);
+	KUNIT_EXPECT_NULL(test, c->next);
+	KUNIT_EXPECT_NULL(test, phy->rx_amsdu[MT_RXQ_MAIN].head);
+	KUNIT_EXPECT_NULL(test, phy->rx_amsdu[MT_RXQ_MAIN].tail);
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 0);
+
+	/* freeing the A-MSDU frees its subframes */
+	skb_queue_purge(rxq);
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 3);
+}
+
+/* An A-MSDU ends early when a new one (new sequence number, or a new first
+ * subframe) or a plain frame arrives: what was collected goes first.
+ */
+static void mt76_test_rx_amsdu_boundaries(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct sk_buff_head *rxq = &dev->rx_skb[MT_RXQ_MAIN];
+	static const int order[] = { 0, 1, 3, 4, 5, 6, 7, 8 };
+	struct sk_buff *f[9], *skb;
+	int i, n = 0;
+
+	set_bit(MT76_STATE_RUNNING, &dev->phy.state);
+	f[0] = mt76_test_amsdu(test, 0, 5, true, false, mt76_hwt_addr);
+	/* a new sequence number */
+	f[1] = mt76_test_amsdu(test, 1, 6, true, false, mt76_hwt_addr);
+	f[2] = mt76_test_amsdu(test, 2, 6, false, false, mt76_hwt_addr);
+	/* a new sequence number without a first subframe */
+	f[3] = mt76_test_amsdu(test, 3, 7, false, true, mt76_hwt_addr);
+	/* a plain frame after a complete A-MSDU, then in the middle of one */
+	f[4] = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 4, 8);
+	f[5] = mt76_test_amsdu(test, 5, 8, true, false, mt76_hwt_addr);
+	f[6] = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 6, 8);
+	/* the same sequence number, but a new first subframe */
+	f[7] = mt76_test_amsdu(test, 7, 9, true, false, mt76_hwt_addr);
+	f[8] = mt76_test_amsdu(test, 8, 9, true, true, mt76_hwt_addr);
+	for (i = 0; i < ARRAY_SIZE(f); i++)
+		mt76_rx(dev, MT_RXQ_MAIN, f[i]);
+
+	/* f[2] is on f[1]'s frag_list */
+	KUNIT_ASSERT_EQ(test, skb_queue_len(rxq), ARRAY_SIZE(order));
+	skb_queue_walk(rxq, skb)
+		KUNIT_EXPECT_PTR_EQ(test, skb, f[order[n++]]);
+	KUNIT_EXPECT_PTR_EQ(test, skb_shinfo(f[1])->frag_list, f[2]);
+	KUNIT_EXPECT_NULL(test, skb_shinfo(f[3])->frag_list);
+	KUNIT_EXPECT_NULL(test, skb_shinfo(f[7])->frag_list);
+	KUNIT_EXPECT_NULL(test, dev->phy.rx_amsdu[MT_RXQ_MAIN].head);
+	skb_queue_purge(rxq);
+}
+
+/* Queue a two-subframe A-MSDU whose first subframe header starts with @da
+ * at @off bytes into the frame, with rx @flag, and say if it got through.
+ */
+static bool mt76_test_amsdu_kept(struct kunit *test, struct mt76_dev *dev,
+				 int off, const u8 *da, u32 flag)
+{
+	struct sk_buff_head *rxq = &dev->rx_skb[MT_RXQ_MAIN];
+	struct sk_buff *a, *b;
+	bool kept;
+
+	a = mt76_test_amsdu(test, 1, 5, true, false, mt76_hwt_addr);
+	b = mt76_test_amsdu(test, 2, 5, false, true, mt76_hwt_addr);
+	memcpy(a->data + off, da, ETH_ALEN);
+	mt76_test_status(a)->flag = flag;
+	mt76_test_status(b)->flag = flag;
+	mt76_rx(dev, MT_RXQ_MAIN, a);
+	mt76_rx(dev, MT_RXQ_MAIN, b);
+	kept = !skb_queue_empty(rxq);
+	skb_queue_purge(rxq);
+	return kept;
+}
+
+/* A plain frame whose A-MSDU bit was flipped (the unprotected A-MSDU
+ * attack) has an LLC/SNAP header where a subframe's destination address
+ * would be: such an A-MSDU is dropped. Where that address is depends on the
+ * header, and on whether the CCMP header is still in the frame.
+ */
+static void mt76_test_rx_amsdu_bad_first_subframe(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct sk_buff *skb;
+
+	set_bit(MT76_STATE_RUNNING, &dev->phy.state);
+
+	KUNIT_EXPECT_TRUE(test, mt76_test_amsdu_kept(test, dev, 26,
+						     mt76_hwt_addr, 0));
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 2);
+	atomic_set(&mt76_test_nfreed, 0);
+
+	/* behind the QoS data header */
+	KUNIT_EXPECT_FALSE(test, mt76_test_amsdu_kept(test, dev, 26,
+						      rfc1042_header, 0));
+	/* both subframes went */
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 2);
+	/* decrypted, IV stripped: same place */
+	KUNIT_EXPECT_FALSE(test, mt76_test_amsdu_kept(test, dev, 26,
+			   rfc1042_header,
+			   RX_FLAG_DECRYPTED | RX_FLAG_IV_STRIPPED));
+	/* decrypted, CCMP header still there: 8 bytes further */
+	KUNIT_EXPECT_FALSE(test, mt76_test_amsdu_kept(test, dev, 34,
+			   rfc1042_header, RX_FLAG_DECRYPTED));
+	KUNIT_EXPECT_TRUE(test, mt76_test_amsdu_kept(test, dev, 26,
+			  rfc1042_header, RX_FLAG_DECRYPTED));
+	/* 802.3 frames (header translated in hardware): at the start */
+	KUNIT_EXPECT_FALSE(test, mt76_test_amsdu_kept(test, dev, 0,
+			   rfc1042_header, RX_FLAG_8023));
+	KUNIT_EXPECT_TRUE(test, mt76_test_amsdu_kept(test, dev, 26,
+			  rfc1042_header, RX_FLAG_8023));
+
+	/* a frame on its own isn't an A-MSDU: kept */
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 8);
+	memcpy(skb->data + 26, rfc1042_header, ETH_ALEN);
+	mt76_rx(dev, MT_RXQ_MAIN, skb);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->rx_skb[MT_RXQ_MAIN]), 1);
+	skb_queue_purge(&dev->rx_skb[MT_RXQ_MAIN]);
+}
+
+/* With WED's RRO 3.0, frames of an RRO data queue complete in the context
+ * of the indication queue, so they are queued there.
+ */
+static void mt76_test_rx_rro_v3(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct sk_buff *skb;
+
+	set_bit(MT76_STATE_RUNNING, &dev->phy.state);
+	dev->q_rx[MT_RXQ_RRO_BAND0].flags = MT_WED_RRO_Q_DATA(0);
+
+	dev->hwrro_mode = MT76_HWRRO_V3;
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 8);
+	mt76_rx(dev, MT_RXQ_RRO_BAND0, skb);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->rx_skb[MT_RXQ_RRO_IND]), 1);
+	KUNIT_EXPECT_TRUE(test,
+			  skb_queue_empty(&dev->rx_skb[MT_RXQ_RRO_BAND0]));
+
+	dev->hwrro_mode = MT76_HWRRO_V3_1;
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 8);
+	mt76_rx(dev, MT_RXQ_RRO_BAND0, skb);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->rx_skb[MT_RXQ_RRO_BAND0]), 1);
+
+	skb_queue_purge(&dev->rx_skb[MT_RXQ_RRO_IND]);
+	skb_queue_purge(&dev->rx_skb[MT_RXQ_RRO_BAND0]);
+}
+
+/* The driver's rx status becomes mac80211's: rate, signal, timing, link,
+ * and the station and hw the frame belongs to.
+ */
+static void mt76_test_rx_convert(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct ieee80211_sta *sta = mt76_test_sta(test), *rsta;
+	struct mt76_wcid *wcid = mt76_test_sta_wcid(sta);
+	struct ieee80211_rx_status *rx;
+	struct mt76_rx_status *status;
+	struct ieee80211_hw *hw, *hw1;
+	struct mt76_phy *band1;
+	struct sk_buff *skb;
+	u64 t0;
+
+	wcid->link_valid = true;
+	wcid->link_id = 3;
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 8);
+	status = mt76_test_status(skb);
+	status->wcid = wcid;
+	status->qos_ctl = 0x25;
+	status->flag = RX_FLAG_DECRYPTED | RX_FLAG_AMPDU_DETAILS;
+	status->freq = 5180;
+	status->band = NL80211_BAND_5GHZ;
+	status->enc_flags = RX_ENC_FLAG_LDPC;
+	status->encoding = RX_ENC_HE;
+	status->bw = RATE_INFO_BW_80;
+	status->he_ru = 2;
+	status->he_gi = 1;
+	status->he_dcm = 1;
+	status->rate_idx = 9;
+	status->nss = 2;
+	status->chains = 0x3;
+	status->chain_signal[0] = -40;
+	status->chain_signal[1] = -42;
+	status->ampdu_ref = 77;
+	status->timestamp = 123456;
+
+	mt76_rx_convert(dev, skb, &hw, &rsta);
+	rx = IEEE80211_SKB_RXCB(skb);
+	KUNIT_EXPECT_EQ(test, skb->priority, 5);
+	KUNIT_EXPECT_EQ(test, rx->flag,
+			RX_FLAG_DECRYPTED | RX_FLAG_AMPDU_DETAILS);
+	KUNIT_EXPECT_EQ(test, (int)rx->freq, 5180);
+	KUNIT_EXPECT_EQ(test, rx->enc_flags, RX_ENC_FLAG_LDPC);
+	KUNIT_EXPECT_EQ(test, (int)rx->encoding, RX_ENC_HE);
+	KUNIT_EXPECT_EQ(test, (int)rx->bw, RATE_INFO_BW_80);
+	KUNIT_EXPECT_EQ(test, (int)rx->he_ru, 2);
+	KUNIT_EXPECT_EQ(test, (int)rx->he_gi, 1);
+	KUNIT_EXPECT_EQ(test, (int)rx->he_dcm, 1);
+	KUNIT_EXPECT_EQ(test, rx->rate_idx, 9);
+	KUNIT_EXPECT_EQ(test, (int)rx->nss, 2);
+	KUNIT_EXPECT_EQ(test, rx->band, NL80211_BAND_5GHZ);
+	KUNIT_EXPECT_EQ(test, rx->chains, 0x3);
+	KUNIT_EXPECT_EQ(test, rx->ampdu_reference, 77);
+	KUNIT_EXPECT_EQ(test, rx->device_timestamp, 123456);
+	KUNIT_EXPECT_EQ(test, rx->mactime, 123456);
+	KUNIT_EXPECT_EQ(test, rx->signal, -38);
+	KUNIT_EXPECT_EQ(test, rx->chain_signal[0], -40);
+	KUNIT_EXPECT_EQ(test, rx->chain_signal[1], -42);
+	KUNIT_EXPECT_EQ(test, (int)rx->link_valid, 1);
+	KUNIT_EXPECT_EQ(test, (int)rx->link_id, 3);
+	KUNIT_EXPECT_EQ(test, rx->boottime_ns, 0);
+	/* a wcid without a station */
+	KUNIT_EXPECT_NULL(test, rsta);
+	KUNIT_EXPECT_PTR_EQ(test, hw, dev->hw);
+	kfree_skb(skb);
+
+	/* EHT, from a station, on band 1's hw, without signal: a beacon */
+	hw1 = kunit_kzalloc(test, sizeof(*hw1), GFP_KERNEL);
+	band1 = mt76_alloc_radio_phy(dev, 0, MT_BAND1);
+	KUNIT_ASSERT_NOT_NULL(test, hw1);
+	KUNIT_ASSERT_NOT_NULL(test, band1);
+	band1->hw = hw1;
+	dev->phys[MT_BAND1] = band1;
+	wcid->sta = 1;
+	skb = mt76_test_rx_skb(test, IEEE80211_FTYPE_MGMT |
+			       IEEE80211_STYPE_BEACON, mt76_hwt_addr, 1, 8);
+	status = mt76_test_status(skb);
+	status->wcid = wcid;
+	status->phy_idx = MT_BAND1;
+	status->encoding = RX_ENC_EHT;
+	status->eht.ru = 5;
+	status->eht.gi = 2;
+	status->chains = 0;
+	t0 = ktime_get_boottime_ns();
+	mt76_rx_convert(dev, skb, &hw, &rsta);
+	rx = IEEE80211_SKB_RXCB(skb);
+	KUNIT_EXPECT_EQ(test, (int)rx->eht.ru, 5);
+	KUNIT_EXPECT_EQ(test, (int)rx->eht.gi, 2);
+	KUNIT_EXPECT_TRUE(test, rx->flag & RX_FLAG_NO_SIGNAL_VAL);
+	KUNIT_EXPECT_GE(test, rx->boottime_ns, t0);
+	KUNIT_EXPECT_LE(test, rx->boottime_ns, ktime_get_boottime_ns());
+	KUNIT_EXPECT_PTR_EQ(test, rsta, sta);
+	KUNIT_EXPECT_PTR_EQ(test, hw, hw1);
+	kfree_skb(skb);
+
+	/* probe responses carry the boot time too, other frames don't */
+	skb = mt76_test_rx_skb(test, IEEE80211_FTYPE_MGMT |
+			       IEEE80211_STYPE_PROBE_RESP, mt76_hwt_addr, 1, 8);
+	mt76_rx_convert(dev, skb, &hw, &rsta);
+	KUNIT_EXPECT_GE(test, IEEE80211_SKB_RXCB(skb)->boottime_ns, t0);
+	KUNIT_EXPECT_NULL(test, rsta);
+	KUNIT_EXPECT_PTR_EQ(test, hw, dev->hw);
+	kfree_skb(skb);
+	skb = mt76_test_rx_skb(test, IEEE80211_FTYPE_MGMT |
+			       IEEE80211_STYPE_PROBE_REQ, mt76_hwt_addr, 1, 8);
+	mt76_rx_convert(dev, skb, &hw, &rsta);
+	KUNIT_EXPECT_EQ(test, IEEE80211_SKB_RXCB(skb)->boottime_ns, 0);
+	kfree_skb(skb);
+	dev->phys[MT_BAND1] = NULL;
+}
+
+static void mt76_test_set_pn(u8 *pn, u64 val)
+{
+	int i;
+
+	for (i = 0; i < IEEE80211_CCMP_PN_LEN; i++)
+		pn[i] = val >> (8 * (IEEE80211_CCMP_PN_LEN - 1 - i));
+}
+
+static u64 mt76_test_get_pn(const u8 *pn)
+{
+	u64 val = 0;
+	int i;
+
+	for (i = 0; i < IEEE80211_CCMP_PN_LEN; i++)
+		val = (val << 8) | pn[i];
+	return val;
+}
+
+/* Run the PN check on a frame of type @fc for TID @tid with PN @pn and rx
+ * @flag from @wcid, and return the flags it ends up with.
+ */
+static u32 mt76_test_pn_check(struct kunit *test, struct mt76_wcid *wcid,
+			      u16 fc, u16 seq_ctrl, u8 tid, u64 pn, u32 flag)
+{
+	struct mt76_rx_status *status;
+	struct ieee80211_hdr *hdr;
+	struct sk_buff *skb;
+	u32 ret;
+
+	skb = mt76_test_rx_skb(test, fc, mt76_hwt_addr, 1, 8);
+	hdr = (struct ieee80211_hdr *)skb->data;
+	hdr->seq_ctrl = cpu_to_le16(seq_ctrl);
+	status = mt76_test_status(skb);
+	status->wcid = wcid;
+	status->qos_ctl = tid;
+	status->flag = flag;
+	mt76_test_set_pn(status->iv, pn);
+	mt76_check_ccmp_pn(skb);
+	ret = status->flag;
+	kfree_skb(skb);
+	return ret;
+}
+
+#define MT76_TEST_DEC	(RX_FLAG_DECRYPTED | RX_FLAG_IV_STRIPPED)
+
+/* A frame with a higher PN than the last one of its TID is accepted and
+ * moves that TID's counter; mac80211 is told it needn't check again only if
+ * the IV is gone from the frame.
+ */
+static void mt76_test_ccmp_pn_advances(struct kunit *test)
+{
+	struct mt76_wcid *wcid;
+
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+	wcid->rx_check_pn = true;
+	mt76_test_set_pn(wcid->rx_key_pn[3], 5);
+
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA, 0, 3, 6, MT76_TEST_DEC),
+			MT76_TEST_DEC | RX_FLAG_PN_VALIDATED);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[3]), 6);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[0]), 0);
+
+	/* a 48-bit number, most significant byte first */
+	mt76_test_set_pn(wcid->rx_key_pn[3], 0xffff);
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA, 0, 3, 0x10000, MT76_TEST_DEC),
+			MT76_TEST_DEC | RX_FLAG_PN_VALIDATED);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[3]), 0x10000);
+
+	/* the IV still in the frame: accepted, mac80211 checks it again */
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA, 0, 3, 0x10001, RX_FLAG_DECRYPTED),
+			RX_FLAG_DECRYPTED);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[3]), 0x10001);
+}
+
+/* A replay (the same or a lower PN) goes to monitor interfaces only. */
+static void mt76_test_ccmp_pn_replay(struct kunit *test)
+{
+	struct mt76_wcid *wcid;
+
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+	wcid->rx_check_pn = true;
+	mt76_test_set_pn(wcid->rx_key_pn[3], 6);
+
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA, 0, 3, 6, MT76_TEST_DEC),
+			MT76_TEST_DEC | RX_FLAG_ONLY_MONITOR);
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA, 0, 3, 2, RX_FLAG_DECRYPTED),
+			RX_FLAG_DECRYPTED | RX_FLAG_ONLY_MONITOR);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[3]), 6);
+	/* other TIDs count on their own */
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA, 0, 4, 2, MT76_TEST_DEC),
+			MT76_TEST_DEC | RX_FLAG_PN_VALIDATED);
+}
+
+/* Frames the check doesn't apply to are left alone: not decrypted, already
+ * monitor-only, no key to check against, and fragments after the first
+ * while the IV is in the frame (mac80211 checks those).
+ */
+static void mt76_test_ccmp_pn_skipped(struct kunit *test)
+{
+	struct mt76_wcid *wcid;
+
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+	wcid->rx_check_pn = true;
+	mt76_test_set_pn(wcid->rx_key_pn[0], 10);
+
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA, 0, 0, 2, 0), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA, 0, 0, 20,
+			MT76_TEST_DEC | RX_FLAG_ONLY_MONITOR),
+			MT76_TEST_DEC | RX_FLAG_ONLY_MONITOR);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[0]), 10);
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, NULL,
+			MT76_TEST_QOS_DATA, 0, 0, 2, MT76_TEST_DEC),
+			MT76_TEST_DEC);
+
+	/* fragment 1 with the IV in place: mac80211's job */
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA, 1, 0, 2, RX_FLAG_DECRYPTED),
+			RX_FLAG_DECRYPTED);
+	/* the first fragment is checked */
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA | IEEE80211_FCTL_MOREFRAGS, 0, 0, 2,
+			RX_FLAG_DECRYPTED),
+			RX_FLAG_DECRYPTED | RX_FLAG_ONLY_MONITOR);
+	/* and with the IV stripped every fragment is */
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA, 1, 0, 2, MT76_TEST_DEC),
+			MT76_TEST_DEC | RX_FLAG_ONLY_MONITOR);
+
+	wcid->rx_check_pn = false;
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			MT76_TEST_QOS_DATA, 0, 0, 2, MT76_TEST_DEC),
+			MT76_TEST_DEC);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[0]), 10);
+}
+
+/* Robust management frames sent without To DS share one counter of their
+ * own (IEEE 802.11-2020 12.5.3.4.4); 802.3 frames count by TID.
+ */
+static void mt76_test_ccmp_pn_counters(struct kunit *test)
+{
+	struct mt76_rx_status *status;
+	struct mt76_wcid *wcid;
+	struct sk_buff *skb;
+
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+	wcid->rx_check_pn = true;
+	mt76_test_set_pn(wcid->rx_key_pn[IEEE80211_NUM_TIDS], 5);
+	mt76_test_set_pn(wcid->rx_key_pn[0], 50);
+
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			IEEE80211_FTYPE_MGMT | IEEE80211_STYPE_ACTION, 0, 0, 6,
+			MT76_TEST_DEC), MT76_TEST_DEC | RX_FLAG_PN_VALIDATED);
+	KUNIT_EXPECT_EQ(test,
+			mt76_test_get_pn(wcid->rx_key_pn[IEEE80211_NUM_TIDS]),
+			6);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[0]), 50);
+	/* with To DS: the TID's counter */
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_check(test, wcid,
+			IEEE80211_FTYPE_MGMT | IEEE80211_STYPE_ACTION |
+			IEEE80211_FCTL_TODS, 0, 0, 51, MT76_TEST_DEC),
+			MT76_TEST_DEC | RX_FLAG_PN_VALIDATED);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[0]), 51);
+
+	/* 802.3: no 802.11 header to look at */
+	skb = mt76_test_skb(test, 32);
+	memset(skb->data, 0xff, skb->len);
+	status = mt76_test_status(skb);
+	status->wcid = wcid;
+	status->qos_ctl = 5;
+	status->flag = MT76_TEST_DEC | RX_FLAG_8023;
+	mt76_test_set_pn(status->iv, 1);
+	mt76_check_ccmp_pn(skb);
+	KUNIT_EXPECT_EQ(test, status->flag,
+			MT76_TEST_DEC | RX_FLAG_8023 | RX_FLAG_PN_VALIDATED);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[5]), 1);
+	kfree_skb(skb);
+}
+
+/* what mac80211 makes of @len bytes at the test frames' rate */
+static u32 mt76_test_airtime(struct mt76_dev *dev, int len)
+{
+	struct ieee80211_rx_status info = {
+		.band = NL80211_BAND_2GHZ,
+		.encoding = RX_ENC_LEGACY,
+	};
+
+	return ieee80211_calc_rx_airtime(dev->hw, &info, len);
+}
+
+/* With software rx airtime, frames addressed to the device or from a known
+ * station count towards the channel's bss rx time.
+ */
+static void mt76_test_airtime_frames(struct kunit *test)
+{
+	static const u8 other[ETH_ALEN] = { 0x02, 0x99, 0, 0, 0, 1 };
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_airtime_ops);
+	struct sk_buff *skb;
+	u32 airtime;
+
+	mt76_test_sbands(test, &dev->phy);
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 100);
+	airtime = mt76_test_airtime(dev, skb->len);
+	KUNIT_ASSERT_GT(test, airtime, 0);
+	mt76_airtime_check(dev, skb);
+	KUNIT_EXPECT_EQ(test, dev->cur_cc_bss_rx, airtime);
+	kfree_skb(skb);
+
+	/* for someone else, from no station we know */
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, other, 1, 100);
+	mt76_airtime_check(dev, skb);
+	KUNIT_EXPECT_EQ(test, dev->cur_cc_bss_rx, airtime);
+	kfree_skb(skb);
+
+	/* 802.3 from no station */
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 100);
+	mt76_test_status(skb)->flag = RX_FLAG_8023;
+	mt76_airtime_check(dev, skb);
+	KUNIT_EXPECT_EQ(test, dev->cur_cc_bss_rx, airtime);
+	kfree_skb(skb);
+
+	/* without software airtime the driver counts it */
+	dev->drv = &mt76_test_drv_ops;
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 100);
+	mt76_airtime_check(dev, skb);
+	KUNIT_EXPECT_EQ(test, dev->cur_cc_bss_rx, airtime);
+	kfree_skb(skb);
+}
+
+/* The subframes of an A-MPDU are summed up and counted as one when the
+ * A-MPDU ends: at the next one or at a frame outside any.
+ */
+static void mt76_test_airtime_ampdu(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_airtime_ops);
+	struct sk_buff *skb[4];
+	u32 len[4], expect;
+	int i;
+
+	mt76_test_sbands(test, &dev->phy);
+	for (i = 0; i < 4; i++) {
+		struct mt76_rx_status *status;
+
+		skb[i] = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA,
+					  mt76_hwt_addr, 1, 100 * (i + 1));
+		len[i] = skb[i]->len;
+		status = mt76_test_status(skb[i]);
+		if (i < 3)
+			status->flag = RX_FLAG_AMPDU_DETAILS;
+		status->ampdu_ref = i < 2 ? 9 : 10;
+	}
+
+	rcu_read_lock();
+	mt76_airtime_check(dev, skb[0]);
+	mt76_airtime_check(dev, skb[1]);
+	KUNIT_EXPECT_EQ(test, dev->cur_cc_bss_rx, 0);
+	KUNIT_EXPECT_EQ(test, dev->rx_ampdu_len, len[0] + len[1]);
+	KUNIT_EXPECT_EQ(test, dev->rx_ampdu_ref, 9);
+	KUNIT_EXPECT_EQ(test, dev->rx_ampdu_status.wcid_idx, 0xff);
+
+	mt76_airtime_check(dev, skb[2]);
+	expect = mt76_test_airtime(dev, len[0] + len[1]);
+	KUNIT_EXPECT_EQ(test, dev->cur_cc_bss_rx, expect);
+	KUNIT_EXPECT_EQ(test, dev->rx_ampdu_len, len[2]);
+	KUNIT_EXPECT_EQ(test, dev->rx_ampdu_ref, 10);
+	KUNIT_EXPECT_EQ(test, dev->rx_ampdu_status.wcid_idx, 0xff);
+
+	mt76_airtime_check(dev, skb[3]);
+	rcu_read_unlock();
+	expect += mt76_test_airtime(dev, len[2]) +
+		  mt76_test_airtime(dev, len[3]);
+	KUNIT_EXPECT_EQ(test, dev->cur_cc_bss_rx, expect);
+	KUNIT_EXPECT_EQ(test, dev->rx_ampdu_len, 0);
+	KUNIT_EXPECT_EQ(test, dev->rx_ampdu_ref, 0);
+
+	for (i = 0; i < 4; i++)
+		kfree_skb(skb[i]);
+}
+
+/* Every frame from a station updates its signal average and marks it
+ * active; frames without a station or a signal change nothing of it.
+ */
+static void mt76_test_check_sta_signal(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct ieee80211_sta *sta = mt76_test_sta(test);
+	struct mt76_wcid *wcid = mt76_test_sta_wcid(sta);
+	struct mt76_rx_status *status;
+	struct sk_buff *skb;
+
+	ewma_signal_init(&wcid->rssi);
+	wcid->inactive_count = 4;
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 8);
+	status = mt76_test_status(skb);
+	status->wcid = wcid;
+
+	/* a wcid that isn't a station's */
+	mt76_check_sta(dev, skb);
+	KUNIT_EXPECT_EQ(test, wcid->inactive_count, 4);
+	KUNIT_EXPECT_EQ(test, ewma_signal_read(&wcid->rssi), 0);
+
+	wcid->sta = 1;
+	mt76_check_sta(dev, skb);
+	KUNIT_EXPECT_EQ(test, wcid->inactive_count, 0);
+	KUNIT_EXPECT_EQ(test, ewma_signal_read(&wcid->rssi), 50);
+
+	/* no signal: the average stays */
+	status->chains = 0;
+	wcid->inactive_count = 2;
+	mt76_check_sta(dev, skb);
+	KUNIT_EXPECT_EQ(test, wcid->inactive_count, 0);
+	KUNIT_EXPECT_EQ(test, ewma_signal_read(&wcid->rssi), 50);
+
+	/* 802.3 frames count too */
+	status->chains = BIT(0);
+	status->chain_signal[0] = -60;
+	status->flag = RX_FLAG_8023;
+	mt76_check_sta(dev, skb);
+	KUNIT_EXPECT_GT(test, ewma_signal_read(&wcid->rssi), 50);
+	kfree_skb(skb);
+}
+
+/* With power save tracking on, only frames that carry a station's power
+ * state can change it: not fragments, not control frames, not 802.3
+ * frames, and not frames that repeat the current state.
+ */
+static void mt76_test_check_sta_ps_unchanged(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct ieee80211_sta *sta = mt76_test_sta(test);
+	struct mt76_wcid *wcid = mt76_test_sta_wcid(sta);
+	static const u16 fcs[] = {
+		MT76_TEST_QOS_DATA | IEEE80211_FCTL_PM |
+			IEEE80211_FCTL_MOREFRAGS,
+		IEEE80211_FTYPE_CTL | IEEE80211_STYPE_BACK_REQ |
+			IEEE80211_FCTL_PM,
+		MT76_TEST_QOS_DATA,
+		IEEE80211_FTYPE_DATA | IEEE80211_STYPE_DATA,
+	};
+	struct sk_buff *skb;
+	int i;
+
+	wcid->sta = 1;
+	set_bit(MT_WCID_FLAG_CHECK_PS, &wcid->flags);
+	for (i = 0; i < ARRAY_SIZE(fcs); i++) {
+		skb = mt76_test_rx_skb(test, fcs[i], mt76_hwt_addr, 1, 8);
+		mt76_test_status(skb)->wcid = wcid;
+		mt76_check_sta(dev, skb);
+		kfree_skb(skb);
+	}
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA | IEEE80211_FCTL_PM,
+			       mt76_hwt_addr, 1, 8);
+	mt76_test_status(skb)->wcid = wcid;
+	mt76_test_status(skb)->flag = RX_FLAG_8023;
+	mt76_check_sta(dev, skb);
+	kfree_skb(skb);
+
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &wcid->flags));
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_ps, 0);
+}
+
+/* A PS-Poll from a sender the hardware didn't match is looked up by its
+ * address; nothing is found for a sender mac80211 doesn't know.
+ */
+static void mt76_test_check_sta_pspoll_unknown(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct sk_buff *skb;
+
+	skb = mt76_test_rx_skb(test,
+			       IEEE80211_FTYPE_CTL | IEEE80211_STYPE_PSPOLL,
+			       mt76_hwt_addr, 1, 8);
+	rcu_read_lock();
+	mt76_check_sta(dev, skb);
+	rcu_read_unlock();
+	KUNIT_EXPECT_NULL(test, mt76_test_status(skb)->wcid);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_ps, 0);
+	kfree_skb(skb);
+}
+
+/* the station address a captured frame came from */
+static u8 mt76_test_captured_ta(struct sk_buff *skb)
+{
+	return mt76_hwt_frame(skb)->addr2[5];
+}
+
+/* Completing an rx queue hands its frames to mac80211 in order, each
+ * A-MSDU subframe as a frame of its own, after the replay check.
+ */
+static void mt76_test_rx_poll_complete(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_test_drv_ops);
+	struct mt76_dev *dev = hwt->dev;
+	struct sk_buff_head frames;
+	struct napi_struct *napi;
+	struct mt76_wcid *wcid;
+	struct sk_buff *skb;
+	int i;
+
+	mt76_hwt_iface(hwt, "monitor");
+	set_bit(MT76_STATE_RUNNING, &dev->phy.state);
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+	wcid->rx_check_pn = true;
+
+	mt76_rx(dev, MT_RXQ_MAIN, mt76_test_rx_skb(test, MT76_TEST_QOS_DATA,
+						    mt76_hwt_addr, 1, 8));
+	mt76_rx(dev, MT_RXQ_MAIN, mt76_test_amsdu(test, 2, 7, true, false,
+						   mt76_hwt_addr));
+	mt76_rx(dev, MT_RXQ_MAIN, mt76_test_amsdu(test, 3, 7, false, false,
+						   mt76_hwt_addr));
+	mt76_rx(dev, MT_RXQ_MAIN, mt76_test_amsdu(test, 4, 7, false, true,
+						   mt76_hwt_addr));
+	/* encrypted: PN 6 then a replay of it */
+	for (i = 0; i < 2; i++) {
+		skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr,
+				       5 + i, 8);
+		mt76_test_status(skb)->wcid = wcid;
+		mt76_test_status(skb)->flag = MT76_TEST_DEC;
+		mt76_test_set_pn(mt76_test_status(skb)->iv, 6);
+		mt76_rx(dev, MT_RXQ_MAIN, skb);
+	}
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&dev->rx_skb[MT_RXQ_MAIN]), 4);
+
+	local_bh_disable();
+	rcu_read_lock();
+	mt76_rx_poll_complete(dev, MT_RXQ_MAIN, NULL);
+	rcu_read_unlock();
+	local_bh_enable();
+
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&dev->rx_skb[MT_RXQ_MAIN]));
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[0]), 6);
+	/* the monitor interface sees everything, the replay included */
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&hwt->rx), 6);
+	for (i = 1; i <= 6; i++) {
+		skb = skb_dequeue(&hwt->rx);
+		KUNIT_EXPECT_EQ(test, mt76_test_captured_ta(skb), i);
+		kfree_skb(skb);
+	}
+
+	/* through a NAPI: mac80211 hands nothing back for one, here */
+	napi = kunit_kzalloc(test, sizeof(*napi), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, napi);
+	__skb_queue_head_init(&frames);
+	__skb_queue_tail(&frames, mt76_test_rx_skb(test, MT76_TEST_QOS_DATA,
+						   mt76_hwt_addr, 9, 8));
+	local_bh_disable();
+	rcu_read_lock();
+	mt76_rx_complete(dev, &frames, napi);
+	rcu_read_unlock();
+	local_bh_enable();
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&frames));
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&hwt->rx), 1);
+	KUNIT_EXPECT_EQ(test, mt76_test_captured_ta(skb_peek(&hwt->rx)), 9);
+}
