+/* A second band on a hw of its own (the MT7986's 5 GHz phy) registers with
+ * mac80211 separately and takes over its band; unregistering it detaches it.
+ */
+static void mt76_test_register_ext_phy(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct wiphy *wiphy;
+	struct mt76_phy *phy;
+
+	phy = mt76_alloc_phy(dev, 24, &mt76_hwt_ops, MT_BAND1);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_test_free_ext_phy, phy), 0);
+	wiphy = phy->hw->wiphy;
+	KUNIT_EXPECT_PTR_EQ(test, phy->dev, dev);
+	KUNIT_EXPECT_PTR_EQ(test, phy->hw->priv, (void *)phy);
+	KUNIT_EXPECT_PTR_EQ(test, phy->priv,
+			    (void *)phy + ALIGN(sizeof(*phy), 8));
+	KUNIT_EXPECT_EQ(test, phy->band_idx, MT_BAND1);
+	KUNIT_EXPECT_TRUE(test, wiphy->flags & WIPHY_FLAG_IBSS_RSN);
+	KUNIT_EXPECT_EQ(test, wiphy->interface_modes &
+			(BIT(NL80211_IFTYPE_STATION) | BIT(NL80211_IFTYPE_AP) |
+			 BIT(NL80211_IFTYPE_ADHOC)),
+			BIT(NL80211_IFTYPE_STATION) | BIT(NL80211_IFTYPE_AP) |
+			BIT(NL80211_IFTYPE_ADHOC));
+
+	phy->cap.has_5ghz = true;
+	phy->cap.has_6ghz = true;
+	mt76_test_he_6ghz(phy);
+	mt76_hwt_phy_setup(phy, phy->hw);
+	KUNIT_ASSERT_EQ(test, mt76_register_phy(phy, true, mt76_rates,
+						ARRAY_SIZE(mt76_rates)), 0);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_REGISTERED, &phy->state));
+	KUNIT_EXPECT_TRUE(test, wiphy->registered);
+	KUNIT_EXPECT_PTR_EQ(test, dev->phys[MT_BAND1], phy);
+	KUNIT_EXPECT_NULL(test, wiphy->bands[NL80211_BAND_2GHZ]);
+	KUNIT_ASSERT_NOT_NULL(test, wiphy->bands[NL80211_BAND_5GHZ]);
+	KUNIT_EXPECT_PTR_EQ(test, wiphy->bands[NL80211_BAND_5GHZ]->channels,
+			    phy->sband_5g.sband.channels);
+	KUNIT_EXPECT_PTR_EQ(test, wiphy->sar_capa, &mt76_sar_capa);
+	KUNIT_EXPECT_PTR_EQ(test, dev->band_phys[NL80211_BAND_5GHZ], phy);
+	KUNIT_ASSERT_NOT_NULL(test, wiphy->bands[NL80211_BAND_6GHZ]);
+	KUNIT_EXPECT_PTR_EQ(test, wiphy->bands[NL80211_BAND_6GHZ]->channels,
+			    phy->sband_6g.sband.channels);
+	KUNIT_EXPECT_PTR_EQ(test, dev->band_phys[NL80211_BAND_6GHZ], phy);
+	KUNIT_ASSERT_NOT_NULL(test, phy->chandef.chan);
+	KUNIT_EXPECT_EQ(test, phy->chandef.chan->center_freq, 5955);
+
+	rcu_expedite_gp();
+	mt76_unregister_phy(phy);
+	rcu_unexpedite_gp();
+	KUNIT_EXPECT_NULL(test, dev->phys[MT_BAND1]);
+	KUNIT_EXPECT_FALSE(test, wiphy->registered);
+	clear_bit(MT76_STATE_REGISTERED, &phy->state);
+
+	/* a phy that isn't registered: nothing to undo */
+	dev->phys[MT_BAND1] = phy;
+	mt76_unregister_phy(phy);
+	KUNIT_EXPECT_PTR_EQ(test, dev->phys[MT_BAND1], phy);
+	dev->phys[MT_BAND1] = NULL;
+}
