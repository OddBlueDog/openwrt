diff --git a/tests/agg-rx-test.c b/tests/agg-rx-test.c
index 60de3cfc..510ff586 100644
--- a/tests/agg-rx-test.c
+++ b/tests/agg-rx-test.c
@@ -4,6 +4,7 @@
  * when CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU test build only).
  */
 #include <kunit/test.h>
+#include "core-hw.h"
 
 #define MT76_TEST_REORDER_SIZE	8
 
@@ -79,9 +80,585 @@ static void mt76_test_reorder_hold_before_timeout(struct kunit *test)
 	mt76_test_reorder_free(tid, &frames);
 }
 
+/* Nothing buffered: nothing to look at, nothing released. */
+static void mt76_test_reorder_check_empty(struct kunit *test)
+{
+	struct sk_buff_head frames;
+	struct mt76_rx_tid *tid;
+
+	tid = mt76_test_reorder_tid(test, mt76_aggr_tid_to_timeo(0));
+	kfree_skb(tid->reorder_buf[101 % MT76_TEST_REORDER_SIZE]);
+	tid->reorder_buf[101 % MT76_TEST_REORDER_SIZE] = NULL;
+	tid->nframes = 0;
+	__skb_queue_head_init(&frames);
+
+	mt76_rx_aggr_check_release(tid, &frames);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&frames));
+	KUNIT_EXPECT_EQ(test, tid->head, 100);
+}
+
+/* --- BA sessions through the rx path -------------------------------------- */
+
+static atomic_t mt76_test_aggr_nfreed;
+
+static void mt76_test_aggr_count_free(struct sk_buff *skb)
+{
+	atomic_inc(&mt76_test_aggr_nfreed);
+}
+
+struct mt76_test_aggr {
+	struct mt76_hwt *hwt;		/* if registered */
+	struct mt76_dev *dev;
+	struct mt76_wcid *wcid;		/* a station's */
+	struct sk_buff_head frames;	/* what the rx path passes on */
+};
+
+static struct mt76_rx_tid *
+mt76_test_aggr_tid(struct mt76_test_aggr *a, u8 tidno)
+{
+	return rcu_dereference_protected(a->wcid->aggr[tidno], true);
+}
+
+static void mt76_test_aggr_stop_all(void *data)
+{
+	struct mt76_test_aggr *a = data;
+	int i;
+
+	mutex_lock(&a->dev->mutex);
+	for (i = 0; i < IEEE80211_NUM_TIDS; i++)
+		mt76_rx_aggr_stop(a->dev, a->wcid, i);
+	mutex_unlock(&a->dev->mutex);
+	__skb_queue_purge(&a->frames);
+}
+
+/* A station's wcid on a device (registered with mac80211 if @registered,
+ * which buffering frames needs: the reorder timer runs on its workqueue),
+ * with a BA session for TID 0 from @ssn of @size frames.
+ */
+static struct mt76_test_aggr *
+mt76_test_aggr(struct kunit *test, bool registered, u16 ssn, u16 size)
+{
+	struct ieee80211_sta *sta;
+	struct mt76_test_aggr *a;
+
+	a = kunit_kzalloc(test, sizeof(*a), GFP_KERNEL);
+	sta = kunit_kzalloc(test, sizeof(*sta) + sizeof(*a->wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, a);
+	KUNIT_ASSERT_NOT_NULL(test, sta);
+	if (registered) {
+		a->hwt = mt76_hwt_new(test, NULL);
+		a->dev = a->hwt->dev;
+	} else {
+		a->dev = mt76_hwt_dev(test, NULL);
+	}
+	a->wcid = (struct mt76_wcid *)sta->drv_priv;
+	mt76_wcid_init(a->wcid, MT_BAND0);
+	a->wcid->sta = 1;
+	__skb_queue_head_init(&a->frames);
+	atomic_set(&mt76_test_aggr_nfreed, 0);
+
+	mutex_lock(&a->dev->mutex);
+	KUNIT_ASSERT_EQ(test, mt76_rx_aggr_start(a->dev, a->wcid, 0, ssn, size),
+			0);
+	mutex_unlock(&a->dev->mutex);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_test_aggr_stop_all, a), 0);
+	return a;
+}
+
+/* A QoS data frame of TID 0 with sequence number @sn from @wcid, received
+ * in an A-MPDU; freeing it counts in mt76_test_aggr_nfreed.
+ */
+static struct sk_buff *mt76_test_aggr_skb(struct kunit *test,
+					  struct mt76_wcid *wcid, u16 sn)
+{
+	struct mt76_rx_status *status;
+	struct ieee80211_hdr *hdr;
+	struct sk_buff *skb;
+
+	skb = alloc_skb(64, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	hdr = skb_put_zero(skb, 26);
+	hdr->frame_control = cpu_to_le16(IEEE80211_FTYPE_DATA |
+					 IEEE80211_STYPE_QOS_DATA);
+	memcpy(hdr->addr1, mt76_hwt_addr, ETH_ALEN);
+	hdr->addr2[0] = 0x02;
+	hdr->addr2[5] = sn & 0xff;
+	hdr->seq_ctrl = cpu_to_le16(IEEE80211_SN_TO_SEQ(sn));
+	skb_put_zero(skb, 8);
+	skb->destructor = mt76_test_aggr_count_free;
+
+	status = (struct mt76_rx_status *)skb->cb;
+	status->wcid = wcid;
+	status->aggr = 1;
+	status->seqno = sn;
+	status->band = NL80211_BAND_2GHZ;
+	status->freq = 2412;
+	status->chains = BIT(0);
+	status->chain_signal[0] = -50;
+	return skb;
+}
+
+static void mt76_test_aggr_rx(struct mt76_test_aggr *a, struct sk_buff *skb)
+{
+	rcu_read_lock();
+	mt76_rx_aggr_reorder(skb, &a->frames);
+	rcu_read_unlock();
+}
+
+static struct mt76_rx_status *mt76_test_aggr_status(struct sk_buff *skb)
+{
+	return (struct mt76_rx_status *)skb->cb;
+}
+
+/* the frames passed on are @sns (sequence numbers), in that order */
+static void mt76_test_aggr_expect(struct kunit *test, struct mt76_test_aggr *a,
+				  const u16 *sns, int n)
+{
+	struct sk_buff *skb;
+	int i = 0;
+
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&a->frames), n);
+	skb_queue_walk(&a->frames, skb) {
+		if (i < n)
+			KUNIT_EXPECT_EQ(test,
+					mt76_test_aggr_status(skb)->seqno,
+					sns[i]);
+		i++;
+	}
+	__skb_queue_purge(&a->frames);
+}
+
+#define MT76_TEST_AGGR_EXPECT(test, a, ...) do {			\
+	static const u16 __sns[] = { __VA_ARGS__ };			\
+	mt76_test_aggr_expect(test, a, __sns, ARRAY_SIZE(__sns));	\
+} while (0)
+
+/* A session starts at the agreed sequence number with a buffer of the
+ * agreed size; starting it again replaces it, stopping removes it.
+ */
+static void mt76_test_aggr_start_stop(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, false, 100, 64);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0), *tid2;
+
+	KUNIT_ASSERT_NOT_NULL(test, tid);
+	KUNIT_EXPECT_PTR_EQ(test, tid->dev, a->dev);
+	KUNIT_EXPECT_EQ(test, tid->head, 100);
+	KUNIT_EXPECT_EQ(test, tid->size, 64);
+	KUNIT_EXPECT_EQ(test, tid->num, 0);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 0);
+	KUNIT_EXPECT_FALSE(test, tid->started);
+	KUNIT_EXPECT_FALSE(test, tid->stopped);
+	KUNIT_EXPECT_PTR_EQ(test, (void *)tid->reorder_work.work.func,
+			    (void *)mt76_rx_aggr_reorder_work);
+
+	mutex_lock(&a->dev->mutex);
+	KUNIT_ASSERT_EQ(test, mt76_rx_aggr_start(a->dev, a->wcid, 0, 2000, 8),
+			0);
+	tid2 = mt76_test_aggr_tid(a, 0);
+	KUNIT_ASSERT_NOT_NULL(test, tid2);
+	KUNIT_EXPECT_EQ(test, tid2->head, 2000);
+	KUNIT_EXPECT_EQ(test, tid2->size, 8);
+
+	KUNIT_ASSERT_EQ(test, mt76_rx_aggr_start(a->dev, a->wcid, 6, 0, 8), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_aggr_tid(a, 6)->num, 6);
+
+	mt76_rx_aggr_stop(a->dev, a->wcid, 0);
+	KUNIT_EXPECT_NULL(test, mt76_test_aggr_tid(a, 0));
+	KUNIT_EXPECT_NOT_NULL(test, mt76_test_aggr_tid(a, 6));
+	/* no session: nothing to do */
+	mt76_rx_aggr_stop(a->dev, a->wcid, 0);
+	mutex_unlock(&a->dev->mutex);
+}
+
+/* Shutting a session down drops what it still holds and stops it. */
+static void mt76_test_aggr_shutdown(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, false, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+	int i;
+
+	tid->reorder_buf[2] = mt76_test_aggr_skb(test, a->wcid, 102);
+	tid->reorder_buf[5] = mt76_test_aggr_skb(test, a->wcid, 105);
+	tid->nframes = 2;
+
+	mt76_rx_aggr_shutdown(a->dev, tid);
+	KUNIT_EXPECT_TRUE(test, tid->stopped);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 0);
+	for (i = 0; i < tid->size; i++)
+		KUNIT_EXPECT_NULL(test, tid->reorder_buf[i]);
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_aggr_nfreed), 2);
+}
+
+/* Frames that aren't part of the session pass straight through: no
+ * station, not from an A-MPDU, no-ack policy, a TID without a session.
+ */
+static void mt76_test_aggr_not_reordered(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, false, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+	struct sk_buff *skb;
+
+	a->wcid->sta = 0;
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 105));
+	a->wcid->sta = 1;
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, NULL, 106));
+
+	skb = mt76_test_aggr_skb(test, a->wcid, 107);
+	mt76_test_aggr_status(skb)->aggr = 0;
+	mt76_test_aggr_rx(a, skb);
+
+	skb = mt76_test_aggr_skb(test, a->wcid, 108);
+	mt76_test_aggr_status(skb)->qos_ctl =
+		IEEE80211_QOS_CTL_ACK_POLICY_NOACK;
+	mt76_test_aggr_rx(a, skb);
+	KUNIT_EXPECT_FALSE(test, mt76_test_aggr_status(skb)->flag &
+			   RX_FLAG_DUP_VALIDATED);
+
+	skb = mt76_test_aggr_skb(test, a->wcid, 109);
+	mt76_test_aggr_status(skb)->qos_ctl = 5;
+	mt76_test_aggr_rx(a, skb);
+	KUNIT_EXPECT_FALSE(test, mt76_test_aggr_status(skb)->flag &
+			   RX_FLAG_DUP_VALIDATED);
+
+	MT76_TEST_AGGR_EXPECT(test, a, 105, 106, 107, 108, 109);
+	KUNIT_EXPECT_EQ(test, tid->head, 100);
+	KUNIT_EXPECT_FALSE(test, tid->started);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 0);
+}
+
+/* In order: frames pass and move the window; mac80211 needn't check them
+ * for duplicates. Behind the window: dropped once the session has started,
+ * passed before (frames sent before the session).
+ */
+static void mt76_test_aggr_in_order(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, false, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+	struct sk_buff *skb;
+
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 98));
+	KUNIT_EXPECT_FALSE(test, tid->started);
+	MT76_TEST_AGGR_EXPECT(test, a, 98);
+
+	skb = mt76_test_aggr_skb(test, a->wcid, 100);
+	mt76_test_aggr_rx(a, skb);
+	KUNIT_EXPECT_TRUE(test, mt76_test_aggr_status(skb)->flag &
+			  RX_FLAG_DUP_VALIDATED);
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 101));
+	KUNIT_EXPECT_TRUE(test, tid->started);
+	KUNIT_EXPECT_EQ(test, tid->head, 102);
+	MT76_TEST_AGGR_EXPECT(test, a, 100, 101);
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_aggr_nfreed), 3);
+
+	atomic_set(&mt76_test_aggr_nfreed, 0);
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 99));
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 101));
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&a->frames));
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_aggr_nfreed), 2);
+	KUNIT_EXPECT_EQ(test, tid->head, 102);
+
+	/* a stopped session lets everything through */
+	tid->stopped = true;
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 105));
+	MT76_TEST_AGGR_EXPECT(test, a, 105);
+	KUNIT_EXPECT_EQ(test, tid->head, 102);
+	tid->stopped = false;
+}
+
+/* Frames after a hole wait in the buffer (and the reorder timer starts);
+ * the missing frame releases them all, in order. A duplicate of a waiting
+ * frame is dropped.
+ */
+static void mt76_test_aggr_hole(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, true, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+	struct sk_buff *skb;
+
+	skb = mt76_test_aggr_skb(test, a->wcid, 102);
+	mt76_test_aggr_rx(a, skb);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&a->frames));
+	KUNIT_EXPECT_EQ(test, tid->nframes, 1);
+	KUNIT_EXPECT_PTR_EQ(test, tid->reorder_buf[102 % 8], skb);
+	KUNIT_EXPECT_LE(test,
+			jiffies - mt76_test_aggr_status(skb)->reorder_time, 3);
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&tid->reorder_work));
+	KUNIT_EXPECT_TRUE(test, tid->started);
+
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 103));
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 102));
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_aggr_nfreed), 1);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 2);
+	KUNIT_EXPECT_EQ(test, tid->head, 100);
+
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 100));
+	MT76_TEST_AGGR_EXPECT(test, a, 100);
+	KUNIT_EXPECT_EQ(test, tid->head, 101);
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 101));
+	MT76_TEST_AGGR_EXPECT(test, a, 101, 102, 103);
+	KUNIT_EXPECT_EQ(test, tid->head, 104);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 0);
+	KUNIT_EXPECT_NULL(test, tid->reorder_buf[102 % 8]);
+}
+
+/* A frame beyond the window moves it: what falls out of it is released,
+ * holes skipped.
+ */
+static void mt76_test_aggr_window(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, true, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 103));
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 110));
+	/* the window is 103-110 now */
+	MT76_TEST_AGGR_EXPECT(test, a, 103);
+	KUNIT_EXPECT_EQ(test, tid->head, 104);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 1);
+
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 120));
+	MT76_TEST_AGGR_EXPECT(test, a, 110);
+	KUNIT_EXPECT_EQ(test, tid->head, 113);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 1);
+}
+
+/* Sequence numbers wrap at 4096. */
+static void mt76_test_aggr_wrap(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, true, 4094, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 4094));
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 1));
+	MT76_TEST_AGGR_EXPECT(test, a, 4094);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 1);
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 4095));
+	MT76_TEST_AGGR_EXPECT(test, a, 4095);
+	KUNIT_EXPECT_EQ(test, tid->head, 0);
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 0));
+	MT76_TEST_AGGR_EXPECT(test, a, 0, 1);
+	KUNIT_EXPECT_EQ(test, tid->head, 2);
+	/* and 4095 is behind the window now */
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 4095));
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&a->frames));
+}
+
+/* A link's frames belong to the station's session on its default link. */
+static void mt76_test_aggr_link_wcid(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, true, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+	struct mt76_wcid *link;
+
+	link = kunit_kzalloc(test, sizeof(*link), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, link);
+	mt76_wcid_init(link, MT_BAND1);
+	link->sta = 1;
+	link->def_wcid = a->wcid;
+
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, link, 101));
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&a->frames));
+	KUNIT_EXPECT_EQ(test, tid->nframes, 1);
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, link, 100));
+	MT76_TEST_AGGR_EXPECT(test, a, 100, 101);
+}
+
+/* a block ack request for TID @tidno from @ssn, from @wcid */
+static struct sk_buff *mt76_test_aggr_bar(struct kunit *test,
+					  struct mt76_wcid *wcid, u8 tidno,
+					  u16 ssn)
+{
+	struct mt76_rx_status *status;
+	struct ieee80211_bar *bar;
+	struct sk_buff *skb;
+
+	skb = alloc_skb(sizeof(*bar), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	bar = skb_put_zero(skb, sizeof(*bar));
+	bar->frame_control = cpu_to_le16(IEEE80211_FTYPE_CTL |
+					 IEEE80211_STYPE_BACK_REQ);
+	bar->control = cpu_to_le16(tidno << 12);
+	bar->start_seq_num = cpu_to_le16(IEEE80211_SN_TO_SEQ(ssn));
+	status = (struct mt76_rx_status *)skb->cb;
+	status->wcid = wcid;
+	status->seqno = 0xfff;
+	return skb;
+}
+
+/* A block ack request moves the window to its start: frames before it
+ * are given up on, the waiting ones after it are released.
+ */
+static void mt76_test_aggr_bar_release(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, true, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+	struct sk_buff *skb;
+
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 102));
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 103));
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 105));
+
+	skb = mt76_test_aggr_bar(test, a->wcid, 0, 102);
+	mt76_test_aggr_status(skb)->qos_ctl = 7;
+	mt76_test_aggr_rx(a, skb);
+	KUNIT_EXPECT_EQ(test, mt76_test_aggr_status(skb)->qos_ctl, 0);
+	/* the request itself, then 102 and 103 */
+	MT76_TEST_AGGR_EXPECT(test, a, 0xfff, 102, 103);
+	KUNIT_EXPECT_EQ(test, tid->head, 104);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 1);
+
+	/* a start behind the window changes nothing */
+	mt76_test_aggr_rx(a, mt76_test_aggr_bar(test, a->wcid, 0, 90));
+	MT76_TEST_AGGR_EXPECT(test, a, 0xfff);
+	KUNIT_EXPECT_EQ(test, tid->head, 104);
+
+	/* past 105: everything goes */
+	mt76_test_aggr_rx(a, mt76_test_aggr_bar(test, a->wcid, 0, 107));
+	MT76_TEST_AGGR_EXPECT(test, a, 0xfff, 105);
+	KUNIT_EXPECT_EQ(test, tid->head, 107);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 0);
+}
+
+/* Block ack requests without a session, for a stopped one, other control
+ * frames and 802.3 frames release nothing.
+ */
+static void mt76_test_aggr_bar_ignored(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, true, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+	struct ieee80211_bar *bar;
+	struct sk_buff *skb;
+
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 102));
+
+	/* TID 5 has no session */
+	mt76_test_aggr_rx(a, mt76_test_aggr_bar(test, a->wcid, 5, 110));
+	/* a block ack, not a request */
+	skb = mt76_test_aggr_bar(test, a->wcid, 0, 110);
+	bar = (struct ieee80211_bar *)skb->data;
+	bar->frame_control = cpu_to_le16(IEEE80211_FTYPE_CTL |
+					 IEEE80211_STYPE_BACK);
+	mt76_test_aggr_rx(a, skb);
+	/* data that only looks like one (header already translated) */
+	skb = mt76_test_aggr_bar(test, a->wcid, 0, 110);
+	mt76_test_aggr_status(skb)->flag = RX_FLAG_8023;
+	mt76_test_aggr_rx(a, skb);
+	/* a data frame with the same bytes */
+	skb = mt76_test_aggr_bar(test, a->wcid, 0, 110);
+	bar = (struct ieee80211_bar *)skb->data;
+	bar->frame_control = cpu_to_le16(IEEE80211_FTYPE_DATA);
+	mt76_test_aggr_rx(a, skb);
+	MT76_TEST_AGGR_EXPECT(test, a, 0xfff, 0xfff, 0xfff, 0xfff);
+	KUNIT_EXPECT_EQ(test, tid->head, 100);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 1);
+
+	tid->stopped = true;
+	mt76_test_aggr_rx(a, mt76_test_aggr_bar(test, a->wcid, 0, 110));
+	MT76_TEST_AGGR_EXPECT(test, a, 0xfff);
+	KUNIT_EXPECT_EQ(test, tid->head, 100);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 1);
+	tid->stopped = false;
+}
+
+/* The reorder timer finds nothing old enough: it releases nothing and
+ * looks again later.
+ */
+static void mt76_test_aggr_work_holds(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, true, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 102));
+	KUNIT_ASSERT_TRUE(test, cancel_delayed_work_sync(&tid->reorder_work));
+
+	mt76_rx_aggr_reorder_work(&tid->reorder_work.work);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 1);
+	KUNIT_EXPECT_EQ(test, tid->head, 100);
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&tid->reorder_work));
+	cancel_delayed_work_sync(&tid->reorder_work);
+}
+
+/* When the timer fires on a frame that waited long enough, the hole
+ * before it is given up on and the frame goes up to mac80211.
+ */
+static void mt76_test_aggr_work_releases(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, true, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+	struct sk_buff *skb;
+
+	mt76_hwt_iface(a->hwt, "monitor");
+	skb = mt76_test_aggr_skb(test, a->wcid, 102);
+	mt76_test_aggr_rx(a, skb);
+	KUNIT_ASSERT_TRUE(test, delayed_work_pending(&tid->reorder_work));
+	mt76_test_aggr_status(skb)->reorder_time = jiffies - HZ / 10;
+	/* to mac80211 without its station, which mac80211 doesn't know */
+	a->wcid->sta = 0;
+
+	flush_delayed_work(&tid->reorder_work);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 0);
+	KUNIT_EXPECT_EQ(test, tid->head, 103);
+	KUNIT_EXPECT_FALSE(test, delayed_work_pending(&tid->reorder_work));
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&a->hwt->rx), 1);
+	skb = skb_peek(&a->hwt->rx);
+	KUNIT_EXPECT_EQ(test, mt76_hwt_frame(skb)->addr2[5], 102);
+}
+
+/* Voice and video TIDs (4-7) wait less for a hole: 40 instead of 100 ms. */
+static void mt76_test_aggr_timeout_by_tid(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, true, 100, 8);
+	struct sk_buff_head frames;
+	struct mt76_rx_tid *tid;
+	struct sk_buff *skb;
+
+	mutex_lock(&a->dev->mutex);
+	KUNIT_ASSERT_EQ(test, mt76_rx_aggr_start(a->dev, a->wcid, 6, 100, 8),
+			0);
+	mutex_unlock(&a->dev->mutex);
+	tid = mt76_test_aggr_tid(a, 6);
+	KUNIT_EXPECT_EQ(test, mt76_aggr_tid_to_timeo(6), HZ / 25);
+	KUNIT_EXPECT_EQ(test, mt76_aggr_tid_to_timeo(3), HZ / 10);
+
+	skb = mt76_test_aggr_skb(test, a->wcid, 102);
+	mt76_test_aggr_status(skb)->qos_ctl = 6;
+	mt76_test_aggr_rx(a, skb);
+	KUNIT_ASSERT_EQ(test, tid->nframes, 1);
+	cancel_delayed_work_sync(&tid->reorder_work);
+
+	__skb_queue_head_init(&frames);
+	mt76_test_aggr_status(skb)->reorder_time = jiffies - HZ / 25 + 1;
+	spin_lock_bh(&tid->lock);
+	mt76_rx_aggr_check_release(tid, &frames);
+	spin_unlock_bh(&tid->lock);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&frames));
+	mt76_test_aggr_status(skb)->reorder_time = jiffies - HZ / 25;
+	spin_lock_bh(&tid->lock);
+	mt76_rx_aggr_check_release(tid, &frames);
+	spin_unlock_bh(&tid->lock);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&frames), 1);
+	__skb_queue_purge(&frames);
+}
+
 static struct kunit_case mt76_agg_rx_test_cases[] = {
 	KUNIT_CASE(mt76_test_reorder_release_at_timeout),
 	KUNIT_CASE(mt76_test_reorder_hold_before_timeout),
+	KUNIT_CASE(mt76_test_reorder_check_empty),
+	KUNIT_CASE(mt76_test_aggr_start_stop),
+	KUNIT_CASE(mt76_test_aggr_shutdown),
+	KUNIT_CASE(mt76_test_aggr_not_reordered),
+	KUNIT_CASE(mt76_test_aggr_in_order),
+	KUNIT_CASE(mt76_test_aggr_hole),
+	KUNIT_CASE(mt76_test_aggr_window),
+	KUNIT_CASE(mt76_test_aggr_wrap),
+	KUNIT_CASE(mt76_test_aggr_link_wcid),
+	KUNIT_CASE(mt76_test_aggr_bar_release),
+	KUNIT_CASE(mt76_test_aggr_bar_ignored),
+	KUNIT_CASE(mt76_test_aggr_work_holds),
+	KUNIT_CASE(mt76_test_aggr_work_releases),
+	KUNIT_CASE(mt76_test_aggr_timeout_by_tid),
 	{}
 };
 
diff --git a/tests/channel-test.c b/tests/channel-test.c
new file mode 100644
index 00000000..acdec5a1
--- /dev/null
+++ b/tests/channel-test.c
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for mt76's channel code (channel.c): the end of a
+ * remain-on-channel and the off-channel links. Included at the end of
+ * channel.c when CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU test
+ * build only).
+ */
+#include <kunit/test.h>
+#include "core-hw.h"
+
+static struct {
+	int n_set_channel;
+	struct ieee80211_channel *set_chan;
+	bool set_offchannel;
+
+	int n_link_remove;
+	struct mt76_phy *rm_phy;
+	struct ieee80211_vif *rm_vif;
+	struct ieee80211_bss_conf *rm_conf;
+	struct mt76_vif_link *rm_link;
+} mt76_chan_test_drv;
+
+static int mt76_chan_test_init(struct kunit *test)
+{
+	memset(&mt76_chan_test_drv, 0, sizeof(mt76_chan_test_drv));
+	return 0;
+}
+
+static int mt76_chan_test_set_channel(struct mt76_phy *phy)
+{
+	mt76_chan_test_drv.n_set_channel++;
+	mt76_chan_test_drv.set_chan = phy->chandef.chan;
+	mt76_chan_test_drv.set_offchannel = phy->offchannel;
+	return 0;
+}
+
+static void mt76_chan_test_link_remove(struct mt76_phy *phy,
+				       struct ieee80211_vif *vif,
+				       struct ieee80211_bss_conf *link_conf,
+				       struct mt76_vif_link *mlink)
+{
+	mt76_chan_test_drv.n_link_remove++;
+	mt76_chan_test_drv.rm_phy = phy;
+	mt76_chan_test_drv.rm_vif = vif;
+	mt76_chan_test_drv.rm_conf = link_conf;
+	mt76_chan_test_drv.rm_link = mlink;
+}
+
+static const struct mt76_driver_ops mt76_chan_test_ops = {
+	.link_data_size = sizeof(struct mt76_vif_link),
+	.set_channel = mt76_chan_test_set_channel,
+	.vif_link_remove = mt76_chan_test_link_remove,
+};
+
+/* a vif mac80211 doesn't know, with the test device's drv_priv */
+static struct ieee80211_vif *mt76_chan_test_vif(struct kunit *test)
+{
+	struct ieee80211_vif *vif;
+	struct mt76_hwt_vif *mv;
+
+	vif = kunit_kzalloc(test, sizeof(*vif) + sizeof(*mv), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, vif);
+	mv = (struct mt76_hwt_vif *)vif->drv_priv;
+	mv->mlink.mvif = &mv->mvif;
+	return vif;
+}
+
+static struct mt76_hwt_vif *mt76_chan_test_mv(struct ieee80211_vif *vif)
+{
+	return (struct mt76_hwt_vif *)vif->drv_priv;
+}
+
+/* an off-channel link of @vif, as made for a scan or ROC (kfree_rcu'd) */
+static struct mt76_vif_link *
+mt76_chan_test_offchannel_link(struct kunit *test, struct ieee80211_vif *vif)
+{
+	struct mt76_vif_link *mlink = kzalloc(sizeof(*mlink), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, mlink);
+	mlink->mvif = &mt76_chan_test_mv(vif)->mvif;
+	mlink->offchannel = true;
+	return mlink;
+}
+
+/* An off-channel link goes back to the driver and is freed; the vif's own
+ * links, and no link at all, are left alone.
+ */
+static void mt76_chan_test_put_link(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_chan_test_ops);
+	struct ieee80211_vif *vif = mt76_chan_test_vif(test);
+	struct mt76_vif_link *off;
+
+	mt76_put_vif_phy_link(&dev->phy, vif, NULL);
+	mt76_put_vif_phy_link(&dev->phy, vif, ERR_PTR(-ENOMEM));
+	mt76_put_vif_phy_link(&dev->phy, vif, &mt76_chan_test_mv(vif)->mlink);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_link_remove, 0);
+
+	off = mt76_chan_test_offchannel_link(test, vif);
+	mt76_put_vif_phy_link(&dev->phy, vif, off);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_link_remove, 1);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_chan_test_drv.rm_phy, &dev->phy);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_chan_test_drv.rm_vif, vif);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_chan_test_drv.rm_conf, &vif->bss_conf);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_chan_test_drv.rm_link, off);
+}
+
+/* @phy is on a remain-on-channel for @vif through @mlink, off its
+ * operating channel (channel 1) on channel 6
+ */
+static void mt76_chan_test_roc(struct mt76_phy *phy, struct ieee80211_vif *vif,
+			       struct mt76_vif_link *mlink)
+{
+	struct ieee80211_channel *chans = phy->sband_2g.sband.channels;
+
+	cfg80211_chandef_create(&phy->main_chandef, &chans[0],
+				NL80211_CHAN_HT20);
+	cfg80211_chandef_create(&phy->chandef, &chans[5], NL80211_CHAN_HT20);
+	phy->chan_state = &phy->sband_2g.chan[5];
+	phy->offchannel = true;
+	mt76_chan_test_mv(vif)->mvif.roc_phy = phy;
+	phy->roc_vif = vif;
+	phy->roc_link = mlink;
+}
+
+static void mt76_chan_test_roc_complete_locked(struct mt76_phy *phy)
+{
+	mutex_lock(&phy->dev->mutex);
+	mt76_roc_complete(phy);
+	mutex_unlock(&phy->dev->mutex);
+}
+
+/* When a remain-on-channel ends, a phy with a channel context goes back
+ * to its operating channel, the vif's ROC is over and its off-channel link
+ * goes away.
+ */
+static void mt76_chan_test_roc_complete(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_chan_test_ops);
+	struct ieee80211_vif *vif = mt76_chan_test_vif(test);
+	struct mt76_phy *phy = &hwt->dev->phy;
+	struct mt76_chanctx ctx = { .phy = phy };
+	struct mt76_vif_link *off;
+
+	off = mt76_chan_test_offchannel_link(test, vif);
+	phy->chanctx = &ctx;
+	mt76_chan_test_roc(phy, vif, off);
+
+	mt76_chan_test_roc_complete_locked(phy);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_set_channel, 1);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_chan_test_drv.set_chan,
+			    &phy->sband_2g.sband.channels[0]);
+	KUNIT_EXPECT_FALSE(test, mt76_chan_test_drv.set_offchannel);
+	KUNIT_EXPECT_FALSE(test, phy->offchannel);
+	KUNIT_EXPECT_NULL(test, mt76_chan_test_mv(vif)->mvif.roc_phy);
+	KUNIT_EXPECT_NULL(test, phy->roc_vif);
+	KUNIT_EXPECT_NULL(test, phy->roc_link);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_link_remove, 1);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_chan_test_drv.rm_link, off);
+
+	/* nothing in progress: nothing to do */
+	mt76_chan_test_roc_complete_locked(phy);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_set_channel, 1);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_link_remove, 1);
+	phy->chanctx = NULL;
+}
+
+/* Without a channel context (the MT7986: mac80211 sets the channel), or
+ * with the MCU restarting, the channel isn't touched, but the phy stops
+ * being off-channel: that flag holds back every station's tx queues.
+ */
+static void mt76_chan_test_roc_complete_no_switch(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_chan_test_ops);
+	struct ieee80211_vif *vif = mt76_chan_test_vif(test);
+	struct mt76_phy *phy = &hwt->dev->phy;
+	struct mt76_chanctx ctx = { .phy = phy };
+
+	/* the vif's own link: not removed */
+	mt76_chan_test_roc(phy, vif, &mt76_chan_test_mv(vif)->mlink);
+	mt76_chan_test_roc_complete_locked(phy);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_set_channel, 0);
+	KUNIT_EXPECT_FALSE(test, phy->offchannel);
+	KUNIT_EXPECT_NULL(test, phy->roc_vif);
+	KUNIT_EXPECT_NULL(test, mt76_chan_test_mv(vif)->mvif.roc_phy);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_link_remove, 0);
+
+	phy->chanctx = &ctx;
+	set_bit(MT76_MCU_RESET, &phy->state);
+	mt76_chan_test_roc(phy, vif, &mt76_chan_test_mv(vif)->mlink);
+	mt76_chan_test_roc_complete_locked(phy);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_set_channel, 0);
+	KUNIT_EXPECT_FALSE(test, phy->offchannel);
+	KUNIT_EXPECT_NULL(test, phy->roc_vif);
+	clear_bit(MT76_MCU_RESET, &phy->state);
+
+	/* back on the operating channel already: no switch either */
+	mt76_chan_test_roc(phy, vif, NULL);
+	phy->offchannel = false;
+	mt76_chan_test_roc_complete_locked(phy);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_set_channel, 0);
+	KUNIT_EXPECT_NULL(test, phy->roc_vif);
+
+	/* during a restart mac80211 isn't told (it is restarting too) */
+	set_bit(MT76_RESTART, &phy->state);
+	mt76_chan_test_roc(phy, vif, &mt76_chan_test_mv(vif)->mlink);
+	mt76_chan_test_roc_complete_locked(phy);
+	KUNIT_EXPECT_NULL(test, phy->roc_vif);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_set_channel, 1);
+	clear_bit(MT76_RESTART, &phy->state);
+	phy->chanctx = NULL;
+}
+
+/* The ROC's timer: its work ends the remain-on-channel. */
+static void mt76_chan_test_roc_work(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_chan_test_ops);
+	struct ieee80211_vif *vif = mt76_chan_test_vif(test);
+	struct mt76_phy *phy = &hwt->dev->phy;
+	struct mt76_chanctx ctx = { .phy = phy };
+
+	phy->chanctx = &ctx;
+	mt76_chan_test_roc(phy, vif, mt76_chan_test_offchannel_link(test, vif));
+	ieee80211_queue_delayed_work(phy->hw, &phy->roc_work, 0);
+	flush_delayed_work(&phy->roc_work);
+
+	KUNIT_EXPECT_NULL(test, phy->roc_vif);
+	KUNIT_EXPECT_FALSE(test, phy->offchannel);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_set_channel, 1);
+	KUNIT_EXPECT_EQ(test, mt76_chan_test_drv.n_link_remove, 1);
+	KUNIT_EXPECT_FALSE(test, mutex_is_locked(&hwt->dev->mutex));
+	phy->chanctx = NULL;
+}
+
+static struct kunit_case mt76_chan_test_cases[] = {
+	KUNIT_CASE(mt76_chan_test_put_link),
+	KUNIT_CASE(mt76_chan_test_roc_complete),
+	KUNIT_CASE(mt76_chan_test_roc_complete_no_switch),
+	KUNIT_CASE(mt76_chan_test_roc_work),
+	{}
+};
+
+static struct kunit_suite mt76_chan_test_suite = {
+	.name = "mt76-channel",
+	.init = mt76_chan_test_init,
+	.test_cases = mt76_chan_test_cases,
+};
+
+kunit_test_suites(&mt76_chan_test_suite);
diff --git a/tests/core-hw.h b/tests/core-hw.h
new file mode 100644
index 00000000..90d0856a
--- /dev/null
+++ b/tests/core-hw.h
@@ -0,0 +1,273 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/*
+ * A registered mt76 device for the core KUnit tests (milkflint's QEMU test
+ * build only; included by the core tests: tests/core-test.c, agg-rx-test.c,
+ * util-test.c, scan-test.c and channel-test.c, never by the driver itself).
+ *
+ * - mt76_hwt_dev(): mt76_test_dev() (tests/fake.h) set up the way a driver
+ *   sets up its device before mt76_register_device(): a 2.4 and a 5 GHz
+ *   band, two chains, a MAC address, four hardware queues.
+ * - mt76_hwt_new(): that device registered with mac80211 for real. Every tx
+ *   queue is a stopped stub, so the tx worker leaves queued frames on the
+ *   wcid's pending lists for the test to look at. When the test ends the
+ *   phy's work items are cancelled and the device unregistered.
+ * - mt76_hwt_iface(): code that hands frames to mac80211 needs an interface
+ *   that is up (mac80211 drops rx while nothing is). This adds one the way
+ *   userspace does, with iw (nl80211), and brings it up. A monitor interface
+ *   also captures every frame mac80211 receives (hwt->rx), which is how the
+ *   tests see what the rx path delivered. Without iw those tests skip.
+ */
+#ifndef __MT76_TEST_CORE_HW_H
+#define __MT76_TEST_CORE_HW_H
+
+#include <linux/umh.h>
+#include <linux/rtnetlink.h>
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+#include <linux/unaligned.h>
+#include "fake.h"
+
+/* Exported by the kernel but declared in kernel/rcu/rcu.h only. Taking a
+ * wiphy and its interfaces down waits for several RCU grace periods, ~100 ms
+ * at the VM's HZ=100 unless they are expedited.
+ */
+void rcu_expedite_gp(void);
+void rcu_unexpedite_gp(void);
+
+/* what a vif's drv_priv holds on this device: a link, its vif data, a wcid */
+struct mt76_hwt_vif {
+	struct mt76_vif_link mlink;
+	struct mt76_vif_data mvif;
+	struct mt76_wcid wcid;
+};
+
+struct mt76_hwt {
+	struct kunit *test;
+	struct mt76_dev *dev;
+	struct mt76_queue txq;		/* every phy->q_tx[]: stopped */
+
+	struct net_device *ndev;	/* the interface that is up, if any */
+	struct ieee80211_vif *vif;	/* its vif (not for a monitor) */
+	struct packet_type pt;		/* monitor capture */
+	bool capturing;
+	struct sk_buff_head rx;		/* what the monitor saw */
+};
+
+static const u8 mt76_hwt_addr[ETH_ALEN] __maybe_unused = {
+	0x02, 0x76, 0x00, 0x00, 0x00, 0x01
+};
+
+static inline int mt76_hwt_add_interface(struct ieee80211_hw *hw,
+					 struct ieee80211_vif *vif)
+{
+	struct mt76_hwt_vif *mv = (struct mt76_hwt_vif *)vif->drv_priv;
+	struct mt76_phy *phy = hw->priv;
+
+	mv->mlink.mvif = &mv->mvif;
+	mv->mlink.wcid = &mv->wcid;
+	mt76_wcid_init(&mv->wcid, phy->band_idx);
+	return 0;
+}
+
+static inline void mt76_hwt_remove_interface(struct ieee80211_hw *hw,
+					     struct ieee80211_vif *vif)
+{
+	struct mt76_hwt_vif *mv = (struct mt76_hwt_vif *)vif->drv_priv;
+	struct mt76_phy *phy = hw->priv;
+
+	mt76_wcid_cleanup(phy->dev, &mv->wcid);
+}
+
+static const struct ieee80211_ops mt76_hwt_ops __maybe_unused = {
+	.tx = mt76_test_tx,
+	.start = mt76_test_start,
+	.stop = mt76_test_stop,
+	.add_interface = mt76_hwt_add_interface,
+	.remove_interface = mt76_hwt_remove_interface,
+	.config = mt76_test_config,
+	.configure_filter = mt76_test_configure_filter,
+	.wake_tx_queue = mt76_test_wake_tx_queue,
+	/* this mac80211 refuses ops without them (fake.h's hw ops lack them) */
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
+};
+
+static inline void mt76_hwt_mac_work(struct work_struct *work) {}
+
+/* the per-phy setup a driver does before registering @phy on @hw */
+static inline void mt76_hwt_phy_setup(struct mt76_phy *phy,
+				      struct ieee80211_hw *hw)
+{
+	/* what mt76_phy_init() does first, for tests that skip it */
+	INIT_LIST_HEAD(&phy->tx_list);
+	spin_lock_init(&phy->tx_lock);
+	phy->antenna_mask = 3;
+	phy->chainmask = 3;
+	memcpy(phy->macaddr, mt76_hwt_addr, ETH_ALEN);
+	INIT_DELAYED_WORK(&phy->mac_work, mt76_hwt_mac_work);
+	hw->queues = 4;
+	hw->vif_data_size = sizeof(struct mt76_hwt_vif);
+	/* no "add" uevent: OpenWrt's hotplug would try to set the radio up */
+	dev_set_uevent_suppress(&hw->wiphy->dev, true);
+}
+
+/* A device with mac80211 @ops (mt76_hwt_ops and more) set up for
+ * mt76_register_device() (not registered).
+ */
+static inline struct mt76_dev *
+mt76_hwt_dev_ops(struct kunit *test, const struct ieee80211_ops *ops,
+		 const struct mt76_driver_ops *drv_ops)
+{
+	struct mt76_dev *dev;
+
+	dev = mt76_test_dev(test, sizeof(*dev), ops, drv_ops);
+	dev->phy.cap.has_2ghz = true;
+	dev->phy.cap.has_5ghz = true;
+	mt76_hwt_phy_setup(&dev->phy, dev->hw);
+	return dev;
+}
+
+/* A device set up for mt76_register_device() (not registered). */
+static inline struct mt76_dev *
+mt76_hwt_dev(struct kunit *test, const struct mt76_driver_ops *drv_ops)
+{
+	return mt76_hwt_dev_ops(test, &mt76_hwt_ops, drv_ops);
+}
+
+static inline void mt76_hwt_cleanup(void *data)
+{
+	struct mt76_hwt *hwt = data;
+	struct mt76_dev *dev = hwt->dev;
+	int i;
+
+	rcu_expedite_gp();
+	if (hwt->capturing) {
+		dev_remove_pack(&hwt->pt);
+		hwt->capturing = false;
+	}
+	skb_queue_purge(&hwt->rx);
+
+	for (i = 0; i < ARRAY_SIZE(dev->phys); i++) {
+		struct mt76_phy *phy = dev->phys[i];
+
+		if (!phy)
+			continue;
+		cancel_delayed_work_sync(&phy->scan_work);
+		cancel_delayed_work_sync(&phy->roc_work);
+		cancel_delayed_work_sync(&phy->mac_work);
+	}
+
+	/* a test that unregistered the device itself clears the bit */
+	if (test_bit(MT76_STATE_REGISTERED, &dev->phy.state)) {
+		mt76_unregister_device(dev);
+		clear_bit(MT76_STATE_REGISTERED, &dev->phy.state);
+	}
+	rcu_unexpedite_gp();
+}
+
+/* Register @dev (from mt76_hwt_dev()); unregistered when the test ends. */
+static inline struct mt76_hwt *
+mt76_hwt_register(struct kunit *test, struct mt76_dev *dev)
+{
+	struct mt76_hwt *hwt;
+	int i;
+
+	hwt = kunit_kzalloc(test, sizeof(*hwt), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, hwt);
+	hwt->test = test;
+	skb_queue_head_init(&hwt->rx);
+	hwt->dev = dev;
+	spin_lock_init(&hwt->txq.lock);
+	spin_lock_init(&hwt->txq.cleanup_lock);
+	hwt->txq.ndesc = 256;
+	hwt->txq.stopped = true;
+	for (i = 0; i < __MT_TXQ_MAX; i++)
+		dev->phy.q_tx[i] = &hwt->txq;
+
+	KUNIT_ASSERT_EQ(test, mt76_register_device(dev, true, mt76_rates,
+						   ARRAY_SIZE(mt76_rates)), 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_hwt_cleanup, hwt), 0);
+	return hwt;
+}
+
+/* A registered device, unregistered when the test ends. */
+static inline struct mt76_hwt *
+mt76_hwt_new(struct kunit *test, const struct mt76_driver_ops *drv_ops)
+{
+	return mt76_hwt_register(test, mt76_hwt_dev(test, drv_ops));
+}
+
+static inline int mt76_hwt_capture(struct sk_buff *skb, struct net_device *ndev,
+				   struct packet_type *pt,
+				   struct net_device *orig)
+{
+	struct mt76_hwt *hwt = container_of(pt, struct mt76_hwt, pt);
+	struct sk_buff *copy = skb_copy(skb, GFP_ATOMIC);
+
+	if (copy)
+		skb_queue_tail(&hwt->rx, copy);
+	kfree_skb(skb);
+	return NET_RX_SUCCESS;
+}
+
+/* run a userspace program (@argv[0] a full path); its exit status */
+static inline int mt76_hwt_run(char **argv)
+{
+	static char *envp[] = { "HOME=/", "PATH=/usr/sbin:/usr/bin:/sbin:/bin",
+				NULL };
+
+	return call_usermodehelper(argv[0], argv, envp, UMH_WAIT_PROC);
+}
+
+/* Add an interface of @type ("monitor" or "managed") with iw and bring it
+ * up. Skips the test if iw can't.
+ */
+static inline void mt76_hwt_iface(struct mt76_hwt *hwt, const char *type)
+{
+	static unsigned int n;
+	struct kunit *test = hwt->test;
+	char phy[32], name[IFNAMSIZ];
+	char *argv[] = { "/usr/sbin/iw", "phy", phy, "interface", "add", name,
+			 "type", (char *)type, NULL };
+	struct net_device *ndev;
+	int ret;
+
+	strscpy(phy, wiphy_name(hwt->dev->hw->wiphy), sizeof(phy));
+	snprintf(name, sizeof(name), "mt76kt%u", n++);
+	ret = mt76_hwt_run(argv);
+	if (ret)
+		kunit_skip(test, "iw interface add failed: %d", ret);
+
+	ndev = dev_get_by_name(&init_net, name);
+	KUNIT_ASSERT_NOT_NULL(test, ndev);
+	/* it goes away with the device, which a held reference would block */
+	dev_put(ndev);
+	rtnl_lock();
+	ret = dev_open(ndev, NULL);
+	rtnl_unlock();
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	hwt->ndev = ndev;
+
+	if (!strcmp(type, "monitor")) {
+		hwt->pt.type = htons(ETH_P_ALL);
+		hwt->pt.dev = ndev;
+		hwt->pt.func = mt76_hwt_capture;
+		dev_add_pack(&hwt->pt);
+		hwt->capturing = true;
+	} else {
+		hwt->vif = wdev_to_ieee80211_vif(ndev->ieee80211_ptr);
+		KUNIT_ASSERT_NOT_NULL(test, hwt->vif);
+	}
+}
+
+/* the 802.11 header of a captured frame (behind its radiotap header) */
+static inline struct ieee80211_hdr *mt76_hwt_frame(struct sk_buff *skb)
+{
+	return (struct ieee80211_hdr *)(skb->data +
+					get_unaligned_le16(skb->data + 2));
+}
+
+#endif
