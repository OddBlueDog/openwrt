+/* A hardware queue is allocated by the bus code with its flags and WED
+ * device set, and an allocation error comes back as an error pointer.
+ */
+static void mt76_test_init_queue(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct mt76_queue *q;
+	int wed;
+
+	dev->queue_ops = &mt76_test_queue_ops;
+	q = mt76_init_queue(dev, MT_TXQ_BE, 18, 256, 0xd4300, &wed,
+			    MT_WED_Q_TX(0));
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(q));
+	KUNIT_EXPECT_PTR_EQ(test, mt76_test_queue_alloc_args.q, q);
+	KUNIT_EXPECT_EQ(test, mt76_test_queue_alloc_args.idx, 18);
+	KUNIT_EXPECT_EQ(test, mt76_test_queue_alloc_args.n_desc, 256);
+	KUNIT_EXPECT_EQ(test, mt76_test_queue_alloc_args.bufsize, 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_queue_alloc_args.ring_base, 0xd4300);
+	KUNIT_EXPECT_EQ(test, q->flags, MT_WED_Q_TX(0));
+	KUNIT_EXPECT_PTR_EQ(test, (void *)q->wed, (void *)&wed);
+
+	mt76_test_queue_alloc_ret = -ENOMEM;
+	q = mt76_init_queue(dev, MT_TXQ_BE, 18, 256, 0xd4300, NULL, 0);
+	mt76_test_queue_alloc_ret = 0;
+	KUNIT_EXPECT_TRUE(test, IS_ERR(q));
+	KUNIT_EXPECT_EQ(test, PTR_ERR(q), -ENOMEM);
+}
