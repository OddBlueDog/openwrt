+/* Registration sets up every band, runs the driver's wiphy hook before
+ * mac80211 sees the device, and starts the tx worker.
+ */
+static void mt76_test_register_device(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct wiphy *wiphy = dev->hw->wiphy;
+	struct ieee80211_supported_band *sband;
+
+	dev->init_wiphy = mt76_test_init_wiphy;
+	dev->phy.cap.has_6ghz = true;
+	mt76_test_he_6ghz(&dev->phy);
+	mt76_hwt_register(test, dev);
+
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_REGISTERED,
+					 &dev->phy.state));
+	KUNIT_EXPECT_TRUE(test, wiphy->registered);
+	KUNIT_EXPECT_PTR_EQ(test, dev_get_drvdata(dev->dev), (void *)dev);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_init_wiphy, 1);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_test_drv.init_wiphy_dev, dev);
+	KUNIT_EXPECT_FALSE(test, mt76_test_drv.init_wiphy_registered);
+
+	/* the device's own wcid */
+	KUNIT_EXPECT_EQ(test, dev->global_wcid.hw_key_idx, 0xff);
+	KUNIT_EXPECT_EQ(test, (int)dev->global_wcid.phy_idx, MT_BAND0);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&dev->global_wcid.tx_pending));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->global_wcid.poll_list));
+
+	/* the tx worker runs as a real-time thread */
+	KUNIT_ASSERT_NOT_NULL(test, dev->tx_worker.task);
+	KUNIT_EXPECT_EQ(test, dev->tx_worker.task->policy, SCHED_FIFO);
+
+	sband = wiphy->bands[NL80211_BAND_2GHZ];
+	KUNIT_ASSERT_NOT_NULL(test, sband);
+	KUNIT_EXPECT_EQ(test, sband->n_channels, 14);
+	KUNIT_EXPECT_EQ(test, sband->n_bitrates, 12);
+	/* (mac80211 may hand the wiphy a copy of a VHT band) */
+	sband = wiphy->bands[NL80211_BAND_5GHZ];
+	KUNIT_ASSERT_NOT_NULL(test, sband);
+	KUNIT_EXPECT_PTR_EQ(test, sband->channels,
+			    dev->phy.sband_5g.sband.channels);
+	KUNIT_EXPECT_EQ(test, sband->n_bitrates, 8);
+	KUNIT_EXPECT_TRUE(test, sband->vht_cap.vht_supported);
+	sband = wiphy->bands[NL80211_BAND_6GHZ];
+	KUNIT_ASSERT_NOT_NULL(test, sband);
+	KUNIT_EXPECT_EQ(test, sband->n_channels, 59);
+	KUNIT_EXPECT_EQ(test, sband->n_bitrates, 8);
+	KUNIT_EXPECT_PTR_EQ(test, dev->band_phys[NL80211_BAND_2GHZ],
+			    &dev->phy);
+	KUNIT_EXPECT_PTR_EQ(test, dev->band_phys[NL80211_BAND_5GHZ],
+			    &dev->phy);
+	KUNIT_EXPECT_PTR_EQ(test, dev->band_phys[NL80211_BAND_6GHZ],
+			    &dev->phy);
+	/* the last band checked gives the default channel */
+	KUNIT_ASSERT_NOT_NULL(test, dev->phy.chandef.chan);
+	KUNIT_EXPECT_EQ(test, dev->phy.chandef.chan->center_freq, 5955);
+	KUNIT_EXPECT_PTR_EQ(test, dev->phy.chan_state,
+			    &dev->phy.sband_6g.chan[0]);
+	KUNIT_EXPECT_PTR_EQ(test, wiphy->sar_capa, &mt76_sar_capa);
+}
+
+/* If the driver's wiphy hook fails, nothing is registered, and
+ * unregistering such a device does nothing.
+ */
+static void mt76_test_register_device_hook_fails(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct sk_buff *skb;
+
+	dev->init_wiphy = mt76_test_init_wiphy;
+	mt76_test_drv.init_wiphy_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt76_register_device(dev, true, mt76_rates,
+						   ARRAY_SIZE(mt76_rates)),
+			-EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_init_wiphy, 1);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_REGISTERED,
+					  &dev->phy.state));
+	KUNIT_EXPECT_FALSE(test, dev->hw->wiphy->registered);
+	KUNIT_EXPECT_NULL(test, dev->tx_worker.task);
+
+	skb = mt76_test_skb(test, 32);
+	skb_queue_tail(&dev->global_wcid.tx_pending, skb);
+	mt76_unregister_device(dev);
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 0);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->global_wcid.tx_pending), 1);
+	skb_queue_purge(&dev->global_wcid.tx_pending);
+}
+
+/* Unregistering drops what is still queued for the device's own wcid and
+ * takes the wiphy away.
+ */
+static void mt76_test_unregister_device(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_test_drv_ops);
+	struct mt76_dev *dev = hwt->dev;
+
+	skb_queue_tail(&dev->global_wcid.tx_pending, mt76_test_skb(test, 32));
+	skb_queue_tail(&dev->global_wcid.tx_offchannel,
+		       mt76_test_skb(test, 32));
+
+	rcu_expedite_gp();
+	mt76_unregister_device(dev);
+	rcu_unexpedite_gp();
+	clear_bit(MT76_STATE_REGISTERED, &dev->phy.state);
+
+	KUNIT_EXPECT_FALSE(test, dev->hw->wiphy->registered);
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 2);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&dev->global_wcid.tx_pending));
+	KUNIT_EXPECT_TRUE(test,
+			  skb_queue_empty(&dev->global_wcid.tx_offchannel));
+}
