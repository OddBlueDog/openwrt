+/* The survey lists every channel of every band in order, with the times
+ * in ms, the noise when known and the operating channel marked; the first
+ * channel of a band refreshes the counters.
+ */
+static void mt76_test_get_survey(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct mt76_phy *phy = &dev->phy;
+	struct mt76_channel_state *state;
+	struct mt76_phy *band2, *other;
+	struct survey_info survey;
+
+	mt76_test_sbands(test, phy);
+	state = &phy->sband_2g.chan[1];
+	state->cc_busy = 5000;
+	state->cc_rx = 3000;
+	state->cc_active = 9000;
+	state->cc_bss_rx = 4000;
+	state->cc_tx = 1000;
+	state->noise = -90;
+	phy->main_chandef.chan = &phy->sband_5g.sband.channels[2];
+	phy->chan_state = &phy->sband_5g.chan[2];
+	phy->survey_time = ktime_get_boottime();
+	/* a phy with a hw of its own isn't part of this survey */
+	other = kunit_kzalloc(test, sizeof(*other), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, other);
+	dev->phys[MT_BAND1] = other;
+
+	KUNIT_EXPECT_EQ(test, mt76_get_survey(dev->hw, 1, &survey), 0);
+	KUNIT_EXPECT_PTR_EQ(test, survey.channel,
+			    &phy->sband_2g.sband.channels[1]);
+	KUNIT_EXPECT_EQ(test, survey.filled,
+			SURVEY_INFO_TIME | SURVEY_INFO_TIME_BUSY |
+			SURVEY_INFO_TIME_TX | SURVEY_INFO_TIME_RX |
+			SURVEY_INFO_NOISE_DBM);
+	KUNIT_EXPECT_EQ(test, survey.time, 9);
+	KUNIT_EXPECT_EQ(test, survey.time_busy, 5);
+	KUNIT_EXPECT_EQ(test, survey.time_rx, 3);
+	KUNIT_EXPECT_EQ(test, survey.time_bss_rx, 4);
+	KUNIT_EXPECT_EQ(test, survey.time_tx, 1);
+	KUNIT_EXPECT_EQ(test, survey.noise, -90);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_update_survey, 0);
+
+	/* the operating channel, third on 5 GHz */
+	KUNIT_EXPECT_EQ(test, mt76_get_survey(dev->hw, 14 + 2, &survey), 0);
+	KUNIT_EXPECT_PTR_EQ(test, survey.channel,
+			    &phy->sband_5g.sband.channels[2]);
+	KUNIT_EXPECT_TRUE(test, survey.filled & SURVEY_INFO_IN_USE);
+	KUNIT_EXPECT_FALSE(test, survey.filled & SURVEY_INFO_NOISE_DBM);
+	KUNIT_EXPECT_FALSE(test, survey.filled & SURVEY_INFO_TIME_BSS_RX);
+
+	/* software rx airtime: the bss rx time is known for it */
+	dev->drv = &mt76_test_airtime_ops;
+	KUNIT_EXPECT_EQ(test, mt76_get_survey(dev->hw, 14 + 2, &survey), 0);
+	KUNIT_EXPECT_TRUE(test, survey.filled & SURVEY_INFO_TIME_BSS_RX);
+	KUNIT_EXPECT_FALSE(test, survey.filled & SURVEY_INFO_TIME_TX);
+	dev->drv = &mt76_test_drv_ops;
+
+	/* the first channel of each band */
+	KUNIT_EXPECT_EQ(test, mt76_get_survey(dev->hw, 0, &survey), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_update_survey, 1);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_test_drv.survey_phy, phy);
+	KUNIT_EXPECT_EQ(test, mt76_get_survey(dev->hw, 14, &survey), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_update_survey, 2);
+	KUNIT_EXPECT_PTR_EQ(test, survey.channel,
+			    &phy->sband_5g.sband.channels[0]);
+
+	/* past the last channel */
+	KUNIT_EXPECT_EQ(test, mt76_get_survey(dev->hw, 14 + 28, &survey),
+			-ENOENT);
+
+	/* several radios on one hw: the count goes on into the next phy of
+	 * that hw (band 2 here; band 1 is on another hw)
+	 */
+	band2 = mt76_alloc_radio_phy(dev, 0, MT_BAND2);
+	KUNIT_ASSERT_NOT_NULL(test, band2);
+	KUNIT_ASSERT_EQ(test, mt76_init_sband_6g(band2, mt76_rates + 4, 8), 0);
+	band2->chan_state = &band2->sband_6g.chan[0];
+	band2->sband_6g.chan[1].cc_active = 7000;
+	dev->phys[MT_BAND2] = band2;
+	dev->hw->wiphy->n_radio = 2;
+	KUNIT_EXPECT_EQ(test, mt76_get_survey(dev->hw, 14 + 28 + 1, &survey),
+			0);
+	KUNIT_EXPECT_PTR_EQ(test, survey.channel,
+			    &band2->sband_6g.sband.channels[1]);
+	KUNIT_EXPECT_EQ(test, survey.time, 7);
+	dev->hw->wiphy->n_radio = 0;
+	dev->phys[MT_BAND1] = NULL;
+	dev->phys[MT_BAND2] = NULL;
+}
