+struct mt76_test_dt {
+	struct device_node np, led;
+	struct property sources, active_low, status;
+	__be32 pin;
+};
+
+static void mt76_test_dt_detach(void *data)
+{
+	struct device *dev = data;
+
+	dev->of_node = NULL;
+}
+
+/* Give @dev a device tree node with an "led" child: LED 2, active low,
+ * and disabled if @disabled. (A static node: refcounting is a no-op
+ * without CONFIG_OF_DYNAMIC.)
+ */
+static void mt76_test_dt_led(struct kunit *test, struct mt76_dev *dev,
+			     bool disabled)
+{
+	struct mt76_test_dt *dt;
+
+	if (IS_ENABLED(CONFIG_OF_DYNAMIC))
+		kunit_skip(test, "needs a kernel without CONFIG_OF_DYNAMIC");
+	dt = kunit_kzalloc(test, sizeof(*dt), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dt);
+	dt->np.name = "wifi";
+	dt->np.full_name = "wifi@18000000";
+	dt->np.child = &dt->led;
+	dt->led.name = "led";
+	dt->led.full_name = "led";
+	dt->led.parent = &dt->np;
+	dt->pin = cpu_to_be32(2);
+	dt->sources.name = "led-sources";
+	dt->sources.length = sizeof(dt->pin);
+	dt->sources.value = &dt->pin;
+	dt->sources.next = &dt->active_low;
+	dt->active_low.name = "led-active-low";
+	dt->led.properties = &dt->sources;
+	if (disabled) {
+		dt->status.name = "status";
+		dt->status.value = "disabled";
+		dt->status.length = sizeof("disabled");
+		dt->active_low.next = &dt->status;
+	}
+	dev->dev->of_node = &dt->np;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_test_dt_detach, dev->dev), 0);
+}
+
+/* The board's device tree can say which pin drives the LED and that it
+ * is active low.
+ */
+static void mt76_test_register_led_dt(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+
+	dev->phy.leds.cdev.brightness_set = mt76_test_led_set;
+	mt76_test_dt_led(test, dev, false);
+	mt76_hwt_register(test, dev);
+	KUNIT_EXPECT_EQ(test, dev->phy.leds.pin, 2);
+	KUNIT_EXPECT_TRUE(test, dev->phy.leds.al);
+	KUNIT_EXPECT_NOT_NULL(test, dev->phy.leds.cdev.dev);
+}
+
+/* ... or that there is none: no LED is registered (and none removed). */
+static void mt76_test_register_led_dt_disabled(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+
+	dev->phy.leds.cdev.brightness_set = mt76_test_led_set;
+	mt76_test_dt_led(test, dev, true);
+	mt76_hwt_register(test, dev);
+	KUNIT_EXPECT_NULL(test, dev->phy.leds.cdev.dev);
+	KUNIT_EXPECT_NULL(test, dev->phy.leds.cdev.default_trigger);
+	KUNIT_EXPECT_STREQ(test, dev->phy.leds.name, "");
+	KUNIT_EXPECT_EQ(test, dev->phy.leds.pin, 0);
+	KUNIT_EXPECT_FALSE(test, dev->phy.leds.al);
+
+	rcu_expedite_gp();
+	mt76_unregister_device(dev);
+	rcu_unexpedite_gp();
+	clear_bit(MT76_STATE_REGISTERED, &dev->phy.state);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_led, 0);
+}
