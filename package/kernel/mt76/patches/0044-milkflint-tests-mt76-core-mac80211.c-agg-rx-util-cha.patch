+/* A driver with an LED gets a "mt76-<phy>" LED driven by mac80211's
+ * throughput trigger, turned off and removed with the device.
+ */
+static void mt76_test_register_led(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct led_classdev *cdev = &dev->phy.leds.cdev;
+	char name[32], trig[32];
+
+	cdev->brightness_set = mt76_test_led_set;
+	mt76_hwt_register(test, dev);
+
+	snprintf(name, sizeof(name), "mt76-%s", wiphy_name(dev->hw->wiphy));
+	snprintf(trig, sizeof(trig), "%stpt", wiphy_name(dev->hw->wiphy));
+	KUNIT_EXPECT_STREQ(test, dev->phy.leds.name, name);
+	KUNIT_EXPECT_PTR_EQ(test, cdev->name, (const char *)dev->phy.leds.name);
+	KUNIT_ASSERT_NOT_NULL(test, cdev->default_trigger);
+	KUNIT_EXPECT_STREQ(test, cdev->default_trigger, trig);
+	KUNIT_EXPECT_NOT_NULL(test, cdev->dev);
+	KUNIT_ASSERT_NOT_NULL(test, cdev->trigger);
+	KUNIT_EXPECT_STREQ(test, cdev->trigger->name, trig);
+
+	mt76_test_drv.n_led = 0;
+	mt76_test_drv.led_brightness = -1;
+	rcu_expedite_gp();
+	mt76_unregister_device(dev);
+	rcu_unexpedite_gp();
+	clear_bit(MT76_STATE_REGISTERED, &dev->phy.state);
+	KUNIT_EXPECT_GT(test, mt76_test_drv.n_led, 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.led_brightness, LED_OFF);
+}
