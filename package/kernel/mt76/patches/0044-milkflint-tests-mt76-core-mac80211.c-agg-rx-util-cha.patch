+/* --- stations and wcids --------------------------------------------------- */
+
+static struct ieee80211_sta *mt76_test_sta_txqs(struct kunit *test, int n)
+{
+	struct ieee80211_sta *sta = mt76_test_sta(test);
+	int i;
+
+	for (i = 0; i < n; i++) {
+		sta->txq[i] = kunit_kzalloc(test, sizeof(*sta->txq[i]) +
+					    sizeof(struct mt76_txq),
+					    GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, sta->txq[i]);
+	}
+	return sta;
+}
+
+static u16 mt76_test_txq_wcid(struct ieee80211_sta *sta, int i)
+{
+	return ((struct mt76_txq *)sta->txq[i]->drv_priv)->wcid;
+}
+
+/* A new station: the driver sets it up (choosing its wcid), its tx queues
+ * learn the wcid, and the wcid is initialised before it is published for
+ * the rx path to find.
+ */
+static void mt76_test_sta_add(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct ieee80211_sta *sta = mt76_test_sta_txqs(test, 2);
+	struct mt76_wcid *wcid = mt76_test_sta_wcid(sta);
+	struct ieee80211_vif *vif = mt76_test_vif(test);
+
+	mt76_test_drv.sta_add_idx = 9;
+	KUNIT_ASSERT_EQ(test, mt76_sta_state(dev->hw, vif, sta,
+					     IEEE80211_STA_NOTEXIST,
+					     IEEE80211_STA_NONE), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_add, 1);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_test_drv.sta_vif, vif);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_test_drv.sta_sta, sta);
+	KUNIT_EXPECT_EQ(test, mt76_test_txq_wcid(sta, 0), 9);
+	KUNIT_EXPECT_EQ(test, mt76_test_txq_wcid(sta, 1), 9);
+	KUNIT_EXPECT_PTR_EQ(test, rcu_access_pointer(dev->wcid[9]), wcid);
+	KUNIT_EXPECT_EQ(test, wcid->hw_key_idx, 0xff);
+	KUNIT_EXPECT_EQ(test, (int)wcid->phy_idx, MT_BAND0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&wcid->tx_list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&wcid->poll_list));
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&wcid->tx_pending));
+	KUNIT_EXPECT_EQ(test, ewma_signal_read(&wcid->rssi), 0);
+	KUNIT_EXPECT_EQ(test, dev->phy.num_sta, 1);
+	/* no events for adding */
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_event, 0);
+}
+
+/* If the driver can't take the station, nothing is published or counted. */
+static void mt76_test_sta_add_fails(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct ieee80211_sta *sta = mt76_test_sta_txqs(test, 1);
+
+	mt76_test_drv.sta_add_idx = 9;
+	mt76_test_drv.sta_add_ret = -ENOSPC;
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(dev->hw, mt76_test_vif(test), sta,
+					     IEEE80211_STA_NOTEXIST,
+					     IEEE80211_STA_NONE), -ENOSPC);
+	KUNIT_EXPECT_NULL(test, rcu_access_pointer(dev->wcid[9]));
+	KUNIT_EXPECT_EQ(test, mt76_test_txq_wcid(sta, 0), 0);
+	KUNIT_EXPECT_EQ(test, dev->phy.num_sta, 0);
+}
+
+/* A driver that published the wcid itself keeps what it set up; only the
+ * band follows the phy the station was added on.
+ */
+static void mt76_test_sta_add_published(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct ieee80211_sta *sta = mt76_test_sta(test);
+	struct mt76_wcid *wcid = mt76_test_sta_wcid(sta);
+
+	mt76_test_drv.sta_add_idx = 12;
+	mt76_test_drv.sta_add_publish = true;
+	KUNIT_ASSERT_EQ(test, mt76_sta_state(dev->hw, mt76_test_vif(test), sta,
+					     IEEE80211_STA_NOTEXIST,
+					     IEEE80211_STA_NONE), 0);
+	KUNIT_EXPECT_PTR_EQ(test, rcu_access_pointer(dev->wcid[12]), wcid);
+	KUNIT_EXPECT_EQ(test, wcid->hw_key_idx, 4);
+	KUNIT_EXPECT_EQ(test, (int)wcid->phy_idx, MT_BAND0);
+	KUNIT_EXPECT_EQ(test, dev->phy.num_sta, 1);
+}
+
+/* Removing a station ends its rx BA sessions, lets the driver clean up,
+ * drops its queued frames and frees its wcid index; the rx path loses it
+ * before that, in pre_rcu_remove.
+ */
+static void mt76_test_sta_remove(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct ieee80211_sta *sta = mt76_test_sta(test);
+	struct mt76_wcid *wcid = mt76_test_sta_wcid(sta);
+	struct ieee80211_vif *vif = mt76_test_vif(test);
+
+	mt76_test_drv.sta_add_idx = 9;
+	KUNIT_ASSERT_EQ(test, mt76_sta_state(dev->hw, vif, sta,
+					     IEEE80211_STA_NOTEXIST,
+					     IEEE80211_STA_NONE), 0);
+	mt76_wcid_mask_set(dev->wcid_mask, 9);
+	mutex_lock(&dev->mutex);
+	KUNIT_ASSERT_EQ(test, mt76_rx_aggr_start(dev, wcid, 2, 100, 8), 0);
+	mutex_unlock(&dev->mutex);
+	skb_queue_tail(&wcid->tx_pending, mt76_test_skb(test, 32));
+
+	mt76_sta_pre_rcu_remove(dev->hw, vif, sta);
+	KUNIT_EXPECT_NULL(test, rcu_access_pointer(dev->wcid[9]));
+
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(dev->hw, vif, sta,
+					     IEEE80211_STA_NONE,
+					     IEEE80211_STA_NOTEXIST), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_remove, 1);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_test_drv.sta_sta, sta);
+	KUNIT_EXPECT_NULL(test, rcu_access_pointer(wcid->aggr[2]));
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 1);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&wcid->tx_pending));
+	KUNIT_EXPECT_FALSE(test, dev->wcid_mask[0] & BIT(9));
+	KUNIT_EXPECT_EQ(test, dev->phy.num_sta, 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_event, 0);
+
+	/* a driver without a remove hook */
+	dev->drv = &mt76_test_airtime_ops;
+	KUNIT_ASSERT_EQ(test, mt76_sta_state(dev->hw, vif, sta,
+					     IEEE80211_STA_NOTEXIST,
+					     IEEE80211_STA_NONE), 0);
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(dev->hw, vif, sta,
+					     IEEE80211_STA_NONE,
+					     IEEE80211_STA_NOTEXIST), 0);
+	KUNIT_EXPECT_EQ(test, dev->phy.num_sta, 0);
+}
+
+/* The association steps reach the driver as events; other steps don't. */
+static void mt76_test_sta_events(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct ieee80211_sta *sta = mt76_test_sta(test);
+	struct ieee80211_vif *vif = mt76_test_vif(test);
+	struct ieee80211_hw *hw = dev->hw;
+
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_AUTH,
+					     IEEE80211_STA_ASSOC), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.sta_ev, MT76_STA_EVENT_ASSOC);
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_ASSOC,
+					     IEEE80211_STA_AUTHORIZED), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.sta_ev, MT76_STA_EVENT_AUTHORIZE);
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_ASSOC,
+					     IEEE80211_STA_AUTH), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.sta_ev, MT76_STA_EVENT_DISASSOC);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_event, 3);
+
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_NONE,
+					     IEEE80211_STA_AUTH), 0);
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(hw, vif, sta,
+					     IEEE80211_STA_AUTHORIZED,
+					     IEEE80211_STA_ASSOC), 0);
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_AUTH,
+					     IEEE80211_STA_NONE), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_event, 3);
+
+	/* the driver's error comes back */
+	mt76_test_drv.sta_event_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_AUTH,
+					     IEEE80211_STA_ASSOC), -EIO);
+
+	/* a driver without events */
+	dev->drv = &mt76_test_airtime_ops;
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_AUTH,
+					     IEEE80211_STA_ASSOC), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_event, 4);
+}
+
+/* On a hw shared by several radios, a vif not bound to one has no phy for
+ * its stations.
+ */
+static void mt76_test_sta_state_no_phy(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+
+	dev->hw->wiphy->n_radio = 2;
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(dev->hw, mt76_test_vif(test),
+					     mt76_test_sta(test),
+					     IEEE80211_STA_NOTEXIST,
+					     IEEE80211_STA_NONE), -EINVAL);
+	dev->hw->wiphy->n_radio = 0;
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_add, 0);
+}
+
+/* Cleaning a wcid up drops its queued and off-channel frames and takes it
+ * off the phy's tx list and the device's poll list.
+ */
+static void mt76_test_wcid_cleanup(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct mt76_wcid *wcid;
+
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+	mt76_wcid_init(wcid, MT_BAND0);
+	wcid->sta = 1;
+	skb_queue_tail(&wcid->tx_pending, mt76_test_skb(test, 32));
+	skb_queue_tail(&wcid->tx_pending, mt76_test_skb(test, 32));
+	skb_queue_tail(&wcid->tx_offchannel, mt76_test_skb(test, 32));
+	list_add_tail(&wcid->tx_list, &dev->phy.tx_list);
+	mt76_wcid_add_poll(dev, wcid);
+	KUNIT_ASSERT_FALSE(test, list_empty(&dev->sta_poll_list));
+
+	mt76_wcid_cleanup(dev, wcid);
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 3);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&wcid->tx_pending));
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&wcid->tx_offchannel));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->phy.tx_list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->sta_poll_list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&wcid->poll_list));
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&wcid->pktid));
+}
+
+/* Only stations are polled, once each, and not while the MCU restarts. */
+static void mt76_test_wcid_add_poll(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct mt76_wcid *a, *b;
+
+	a = kunit_kzalloc(test, sizeof(*a), GFP_KERNEL);
+	b = kunit_kzalloc(test, sizeof(*b), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, a);
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	mt76_wcid_init(a, MT_BAND0);
+	mt76_wcid_init(b, MT_BAND0);
+
+	mt76_wcid_add_poll(dev, a);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->sta_poll_list));
+	a->sta = 1;
+	mt76_wcid_add_poll(dev, a);
+	mt76_wcid_add_poll(dev, a);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->sta_poll_list), 1);
+	KUNIT_EXPECT_PTR_EQ(test, list_first_entry(&dev->sta_poll_list,
+						   struct mt76_wcid, poll_list),
+			    a);
+
+	b->sta = 1;
+	set_bit(MT76_MCU_RESET, &dev->phy.state);
+	mt76_wcid_add_poll(dev, b);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->sta_poll_list), 1);
+	clear_bit(MT76_MCU_RESET, &dev->phy.state);
+	mt76_wcid_add_poll(dev, b);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->sta_poll_list), 2);
+}
+
+/* A full reset forgets every station: wcids unpublished and cleaned up,
+ * all allocation masks and lists empty, the phys' station counts and
+ * channel contexts cleared. A station's wcid can be polled again after.
+ */
+static void mt76_test_reset_device(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct mt76_wcid *a, *b;
+	struct mt76_phy *band1;
+	struct mt76_chanctx ctx = {};
+
+	a = kunit_kzalloc(test, sizeof(*a), GFP_KERNEL);
+	b = kunit_kzalloc(test, sizeof(*b), GFP_KERNEL);
+	band1 = mt76_alloc_radio_phy(dev, 0, MT_BAND1);
+	KUNIT_ASSERT_NOT_NULL(test, a);
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	KUNIT_ASSERT_NOT_NULL(test, band1);
+	INIT_LIST_HEAD(&band1->tx_list);
+	dev->phys[MT_BAND1] = band1;
+
+	mt76_wcid_init(a, MT_BAND0);
+	mt76_wcid_init(b, MT_BAND1);
+	a->idx = 3;
+	b->idx = 300;
+	a->sta = 1;
+	b->sta = 1;
+	rcu_assign_pointer(dev->wcid[3], a);
+	rcu_assign_pointer(dev->wcid[300], b);
+	mt76_wcid_mask_set(dev->wcid_mask, 3);
+	mt76_wcid_mask_set(dev->wcid_mask, 300);
+	list_add_tail(&a->list, &dev->wcid_list);
+	mt76_wcid_add_poll(dev, a);
+	skb_queue_tail(&b->tx_pending, mt76_test_skb(test, 32));
+	list_add_tail(&b->tx_list, &band1->tx_list);
+	dev->vif_mask = 0x5;
+	dev->phy.num_sta = 1;
+	dev->phy.chanctx = &ctx;
+	band1->num_sta = 1;
+
+	mt76_reset_device(dev);
+
+	KUNIT_EXPECT_NULL(test, rcu_access_pointer(dev->wcid[3]));
+	KUNIT_EXPECT_NULL(test, rcu_access_pointer(dev->wcid[300]));
+	KUNIT_EXPECT_EQ(test, (int)a->sta, 0);
+	KUNIT_EXPECT_EQ(test, (int)b->sta, 0);
+	KUNIT_EXPECT_EQ(test, atomic_read(&mt76_test_nfreed), 1);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&b->tx_pending));
+	KUNIT_EXPECT_TRUE(test, mem_is_zero(dev->wcid_mask,
+					    sizeof(dev->wcid_mask)));
+	KUNIT_EXPECT_EQ(test, dev->vif_mask, 0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->wcid_list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->sta_poll_list));
+	KUNIT_EXPECT_EQ(test, dev->phy.num_sta, 0);
+	KUNIT_EXPECT_NULL(test, dev->phy.chanctx);
+	KUNIT_EXPECT_EQ(test, band1->num_sta, 0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&band1->tx_list));
+
+	/* the station comes back: polling it doesn't trip over stale links */
+	a->sta = 1;
+	mt76_wcid_add_poll(dev, a);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->sta_poll_list), 1);
+	dev->phys[MT_BAND1] = NULL;
+}
+
+/* A key conf with mac80211's ieee80211_key in front of it. That struct is
+ * private to mac80211, so the bytes before the conf are a known pattern
+ * (byte i is i) and the copied PNs show which counter was read.
+ */
+#define MT76_TEST_KEY_PAD	2048
+
+static struct ieee80211_key_conf *mt76_test_key(struct kunit *test, u32 cipher)
+{
+	struct ieee80211_key_conf *conf;
+	u8 *buf;
+	int i;
+
+	buf = kunit_kzalloc(test, MT76_TEST_KEY_PAD + sizeof(*conf) + 32,
+			    GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, buf);
+	for (i = 0; i < MT76_TEST_KEY_PAD; i++)
+		buf[i] = i;
+	conf = (struct ieee80211_key_conf *)(buf + MT76_TEST_KEY_PAD);
+	conf->cipher = cipher;
+	conf->keylen = 16;
+	return conf;
+}
+
+/* A CCMP key turns the PN check on, starting from mac80211's counters: one
+ * per TID and one for management frames; other keys turn it off.
+ */
+static void mt76_test_wcid_key_setup(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct ieee80211_key_conf *key;
+	struct mt76_wcid *wcid;
+	u8 *base;
+	int i, j;
+
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+
+	key = mt76_test_key(test, WLAN_CIPHER_SUITE_CCMP);
+	mt76_wcid_key_setup(dev, wcid, key);
+	KUNIT_EXPECT_TRUE(test, wcid->rx_check_pn);
+	/* 17 counters of 6 bytes, back to back in mac80211's key */
+	base = wcid->rx_key_pn[0];
+	for (i = 0; i <= IEEE80211_NUM_TIDS; i++)
+		for (j = 0; j < IEEE80211_CCMP_PN_LEN; j++)
+			KUNIT_EXPECT_EQ(test, wcid->rx_key_pn[i][j],
+					(u8)(base[0] + 6 * i + j));
+	/* not the zeroes of the conf itself */
+	KUNIT_EXPECT_NE(test, mt76_test_get_pn(wcid->rx_key_pn[1]), 0);
+
+	mt76_wcid_key_setup(dev, wcid, mt76_test_key(test,
+					WLAN_CIPHER_SUITE_GCMP));
+	KUNIT_EXPECT_FALSE(test, wcid->rx_check_pn);
+	wcid->rx_check_pn = true;
+	mt76_wcid_key_setup(dev, wcid, NULL);
+	KUNIT_EXPECT_FALSE(test, wcid->rx_check_pn);
+}
+
+/* the chanctx_conf a vif link of @phy points at */
+static struct ieee80211_chanctx_conf *
+mt76_test_chanctx(struct kunit *test, struct mt76_phy *phy)
+{
+	struct ieee80211_chanctx_conf *conf;
+
+	conf = kunit_kzalloc(test, sizeof(*conf) + sizeof(struct mt76_chanctx),
+			     GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, conf);
+	((struct mt76_chanctx *)conf->drv_priv)->phy = phy;
+	return conf;
+}
+
+/* Going off and back on channel, an associated station interface of the
+ * phy tells its AP (a null frame, which mac80211 refuses here: it knows no
+ * AP) and restarts beacon loss monitoring on the way back.
+ */
+static void mt76_test_offchannel_notify(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_test_drv_ops);
+	struct mt76_dev *dev = hwt->dev;
+	struct mt76_phy *phy = &dev->phy;
+	struct ieee80211_vif *vif;
+	struct mt76_hwt_vif *mv;
+
+	mt76_hwt_iface(hwt, "managed");
+	vif = hwt->vif;
+	mv = (struct mt76_hwt_vif *)vif->drv_priv;
+	mv->mlink.ctx = mt76_test_chanctx(test, phy);
+	mv->mlink.beacon_mon_interval = 100;
+	phy->main_chandef = phy->chandef;
+
+	/* no station connected: nothing to tell */
+	mv->mlink.beacon_mon_last = 0;
+	vif->cfg.assoc = true;
+	mt76_offchannel_notify(phy, false);
+	KUNIT_EXPECT_EQ(test, mv->mlink.beacon_mon_last, 0);
+
+	phy->num_sta = 1;
+	mt76_offchannel_notify(phy, true);
+	KUNIT_EXPECT_EQ(test, mv->mlink.beacon_mon_last, 0);
+	mt76_offchannel_notify(phy, false);
+	KUNIT_EXPECT_NE(test, mv->mlink.beacon_mon_last, 0);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&mv->wcid.tx_pending));
+
+	/* not associated, or on another phy: left alone */
+	mv->mlink.beacon_mon_last = 0;
+	vif->cfg.assoc = false;
+	mt76_offchannel_notify(phy, false);
+	KUNIT_EXPECT_EQ(test, mv->mlink.beacon_mon_last, 0);
+	vif->cfg.assoc = true;
+	mv->mlink.ctx = NULL;
+	mt76_offchannel_notify(phy, false);
+	KUNIT_EXPECT_EQ(test, mv->mlink.beacon_mon_last, 0);
+	vif->cfg.assoc = false;
+	phy->num_sta = 0;
+}
+
+static struct kunit_case mt76_core_sta_test_cases[] = {
+	KUNIT_CASE(mt76_test_sta_add),
+	KUNIT_CASE(mt76_test_sta_add_fails),
+	KUNIT_CASE(mt76_test_sta_add_published),
+	KUNIT_CASE(mt76_test_sta_remove),
+	KUNIT_CASE(mt76_test_sta_events),
+	KUNIT_CASE(mt76_test_sta_state_no_phy),
+	KUNIT_CASE(mt76_test_wcid_cleanup),
+	KUNIT_CASE(mt76_test_wcid_add_poll),
+	KUNIT_CASE(mt76_test_reset_device),
+	KUNIT_CASE(mt76_test_wcid_key_setup),
+	KUNIT_CASE(mt76_test_offchannel_notify),
+	{}
+};
+
+static struct kunit_suite mt76_core_sta_test_suite = {
+	.name = "mt76-core-sta",
+	.init = mt76_test_case_init,
+	.test_cases = mt76_core_sta_test_cases,
+};
+
+kunit_test_suites(&mt76_core_test_suite, &mt76_core_init_test_suite,
+		  &mt76_core_chan_test_suite, &mt76_core_rx_test_suite,
+		  &mt76_core_sta_test_suite);
diff --git a/tests/scan-test.c b/tests/scan-test.c
new file mode 100644
index 00000000..2c5b819e
--- /dev/null
+++ b/tests/scan-test.c
@@ -0,0 +1,612 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for mt76's hardware scan (scan.c): stepping through the
+ * channels, probe requests, waiting for a beacon on radar channels, going
+ * back to the operating channel, completion and abort. Included at the end
+ * of scan.c when CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU test
+ * build only).
+ *
+ * Most tests run the scan work one step at a time on a registered device
+ * (mt76_hwt_new(), tests/core-hw.h), with band 1 marked as scanning too, so
+ * the scan never completes towards mac80211, which didn't start it. The
+ * last one runs a scan the way userspace starts it, through mac80211.
+ */
+#include <kunit/test.h>
+#include "core-hw.h"
+
+static struct {
+	int n_set_channel;
+	struct cfg80211_chan_def set_chandef;
+	bool set_offchannel;
+	int n_link_add, n_link_remove;
+	struct mt76_vif_link *rm_link;
+} mt76_scan_test_drv;
+
+/* the wcid of the off-channel links made for a scan */
+static struct mt76_wcid mt76_scan_test_wcid;
+
+static int mt76_scan_test_init(struct kunit *test)
+{
+	memset(&mt76_scan_test_drv, 0, sizeof(mt76_scan_test_drv));
+	memset(&mt76_scan_test_wcid, 0, sizeof(mt76_scan_test_wcid));
+	mt76_wcid_init(&mt76_scan_test_wcid, MT_BAND0);
+	return 0;
+}
+
+static int mt76_scan_test_set_channel(struct mt76_phy *phy)
+{
+	mt76_scan_test_drv.n_set_channel++;
+	mt76_scan_test_drv.set_chandef = phy->chandef;
+	mt76_scan_test_drv.set_offchannel = phy->offchannel;
+	return 0;
+}
+
+static int mt76_scan_test_link_add(struct mt76_phy *phy,
+				   struct ieee80211_vif *vif,
+				   struct ieee80211_bss_conf *link_conf,
+				   struct mt76_vif_link *mlink)
+{
+	mt76_scan_test_drv.n_link_add++;
+	mlink->wcid = &mt76_scan_test_wcid;
+	return 0;
+}
+
+static void mt76_scan_test_link_remove(struct mt76_phy *phy,
+				       struct ieee80211_vif *vif,
+				       struct ieee80211_bss_conf *link_conf,
+				       struct mt76_vif_link *mlink)
+{
+	mt76_scan_test_drv.n_link_remove++;
+	mt76_scan_test_drv.rm_link = mlink;
+}
+
+static const struct mt76_driver_ops mt76_scan_test_ops = {
+	.link_data_size = sizeof(struct mt76_vif_link),
+	.set_channel = mt76_scan_test_set_channel,
+	.vif_link_add = mt76_scan_test_link_add,
+	.vif_link_remove = mt76_scan_test_link_remove,
+};
+
+/* the device's 2.4 GHz channel @n (1-14) and 5 GHz channel @idx */
+static struct ieee80211_channel *mt76_scan_test_2g(struct mt76_phy *phy, int n)
+{
+	return &phy->sband_2g.sband.channels[n - 1];
+}
+
+static struct ieee80211_channel *mt76_scan_test_5g(struct mt76_phy *phy,
+						   int idx)
+{
+	return &phy->sband_5g.sband.channels[idx];
+}
+
+/* @phy operates on @chan */
+static void mt76_scan_test_operate(struct mt76_phy *phy,
+				   struct ieee80211_channel *chan)
+{
+	cfg80211_chandef_create(&phy->main_chandef, chan, NL80211_CHAN_HT20);
+	phy->chandef = phy->main_chandef;
+	phy->chan_state = &phy->sband_2g.chan[0];
+	phy->offchannel = false;
+}
+
+/* A scan of @n_chan channels for @n_ssids SSIDs from @vif through @mlink,
+ * in progress on the device's phy (and, so it never completes, band 1).
+ */
+static struct ieee80211_scan_request *
+mt76_scan_test_start(struct kunit *test, struct mt76_dev *dev,
+		     struct ieee80211_vif *vif, struct mt76_vif_link *mlink,
+		     struct ieee80211_channel **chans, int n_chan, int n_ssids)
+{
+	struct ieee80211_scan_request *req;
+	struct mt76_phy *phy = &dev->phy;
+
+	req = kunit_kzalloc(test, struct_size(req, req.channels, n_chan),
+			    GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	req->req.n_channels = n_chan;
+	memcpy(req->req.channels, chans, n_chan * sizeof(*chans));
+	if (n_ssids) {
+		req->req.ssids = kunit_kcalloc(test, n_ssids,
+					       sizeof(*req->req.ssids),
+					       GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, req->req.ssids);
+		req->req.n_ssids = n_ssids;
+	}
+	eth_broadcast_addr(req->req.bssid);
+
+	dev->scan.req = req;
+	dev->scan.vif = vif;
+	dev->scan.phy_mask = BIT(phy->band_idx) | BIT(MT_BAND1);
+	memset(&phy->scan, 0, sizeof(phy->scan));
+	phy->scan.mlink = mlink;
+	set_bit(MT76_SCANNING, &phy->state);
+	return req;
+}
+
+static void mt76_scan_test_stop(struct mt76_dev *dev)
+{
+	dev->scan.req = NULL;
+	dev->scan.phy_mask = 0;
+	clear_bit(MT76_SCANNING, &dev->phy.state);
+}
+
+/* Run one step of the scan; return when the next one is due, in jiffies
+ * from now (-1: none).
+ */
+static long mt76_scan_test_step(struct mt76_phy *phy)
+{
+	unsigned long now = jiffies;
+	long delay = -1;
+
+	mt76_scan_work(&phy->scan_work.work);
+	if (delayed_work_pending(&phy->scan_work))
+		delay = (long)(phy->scan_work.timer.expires - now);
+	cancel_delayed_work_sync(&phy->scan_work);
+	return delay;
+}
+
+/* the expected delay of a step, with some slack for a slow (emulated) VM */
+#define MT76_SCAN_TEST_DELAY(test, delay, expect) do {			\
+	KUNIT_EXPECT_GE(test, delay, (long)(expect));			\
+	KUNIT_EXPECT_LE(test, delay, (long)(expect) + 3);		\
+} while (0)
+
+/* a vif mac80211 doesn't know, with the test device's drv_priv */
+static struct ieee80211_vif *mt76_scan_test_vif(struct kunit *test)
+{
+	struct ieee80211_vif *vif;
+	struct mt76_hwt_vif *mv;
+
+	vif = kunit_kzalloc(test, sizeof(*vif) + sizeof(*mv), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, vif);
+	mv = (struct mt76_hwt_vif *)vif->drv_priv;
+	mv->mlink.mvif = &mv->mvif;
+	return vif;
+}
+
+static struct mt76_vif_link *mt76_scan_test_mlink(struct ieee80211_vif *vif)
+{
+	return &((struct mt76_hwt_vif *)vif->drv_priv)->mlink;
+}
+
+/* Without a scan, or on a phy not part of it, the work does nothing. */
+static void mt76_scan_test_idle(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_scan_test_ops);
+	struct mt76_dev *dev = hwt->dev;
+	struct ieee80211_vif *vif = mt76_scan_test_vif(test);
+	struct ieee80211_channel *chans[1];
+
+	mt76_scan_test_operate(&dev->phy, mt76_scan_test_2g(&dev->phy, 1));
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_step(&dev->phy), -1);
+
+	chans[0] = mt76_scan_test_2g(&dev->phy, 6);
+	mt76_scan_test_start(test, dev, vif, mt76_scan_test_mlink(vif), chans,
+			     1, 0);
+	dev->scan.phy_mask = BIT(MT_BAND1);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_step(&dev->phy), -1);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_drv.n_set_channel, 0);
+	KUNIT_EXPECT_NULL(test, dev->phy.scan.chan);
+	mt76_scan_test_stop(dev);
+}
+
+/* A passive scan visits each channel in turn (staying ~110 ms, or the
+ * requested dwell time off-channel) and then returns to the operating
+ * channel.
+ */
+static void mt76_scan_test_passive(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_scan_test_ops);
+	struct mt76_dev *dev = hwt->dev;
+	struct mt76_phy *phy = &dev->phy;
+	struct ieee80211_vif *vif = mt76_scan_test_vif(test);
+	struct ieee80211_scan_request *req;
+	struct ieee80211_channel *chans[3];
+	long delay;
+
+	chans[0] = mt76_scan_test_2g(phy, 1);
+	chans[1] = mt76_scan_test_5g(phy, 0);
+	chans[2] = mt76_scan_test_2g(phy, 11);
+	mt76_scan_test_operate(phy, chans[0]);
+	req = mt76_scan_test_start(test, dev, vif, mt76_scan_test_mlink(vif),
+				   chans, 3, 0);
+
+	/* the operating channel: no need to leave it */
+	delay = mt76_scan_test_step(phy);
+	MT76_SCAN_TEST_DELAY(test, delay, HZ / 9);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_drv.n_set_channel, 1);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_scan_test_drv.set_chandef.chan,
+			    chans[0]);
+	KUNIT_EXPECT_FALSE(test, mt76_scan_test_drv.set_offchannel);
+	KUNIT_EXPECT_PTR_EQ(test, phy->scan.chan, chans[0]);
+	KUNIT_EXPECT_EQ(test, phy->scan.chan_idx, 1);
+
+	/* channel 36, off-channel */
+	delay = mt76_scan_test_step(phy);
+	MT76_SCAN_TEST_DELAY(test, delay, HZ / 9);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_drv.n_set_channel, 2);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_scan_test_drv.set_chandef.chan,
+			    chans[1]);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_drv.set_chandef.width,
+			NL80211_CHAN_WIDTH_20);
+	KUNIT_EXPECT_TRUE(test, mt76_scan_test_drv.set_offchannel);
+	KUNIT_EXPECT_PTR_EQ(test, phy->main_chandef.chan, chans[0]);
+	KUNIT_EXPECT_EQ(test, phy->scan.chan_idx, 2);
+
+	/* channel 11 with a longer dwell time asked for (in TUs) */
+	req->req.duration = 300;
+	delay = mt76_scan_test_step(phy);
+	MT76_SCAN_TEST_DELAY(test, delay, msecs_to_jiffies(300 + 300 / 32));
+	KUNIT_EXPECT_PTR_EQ(test, phy->scan.chan, chans[2]);
+
+	/* done: back on the operating channel */
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_step(phy), -1);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_drv.n_set_channel, 4);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_scan_test_drv.set_chandef.chan,
+			    chans[0]);
+	KUNIT_EXPECT_FALSE(test, mt76_scan_test_drv.set_offchannel);
+	KUNIT_EXPECT_FALSE(test, phy->offchannel);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_SCANNING, &phy->state));
+	KUNIT_EXPECT_NULL(test, phy->scan.chan);
+	KUNIT_EXPECT_NULL(test, phy->scan.mlink);
+	KUNIT_EXPECT_EQ(test, phy->scan.chan_idx, 0);
+	KUNIT_EXPECT_EQ(test, dev->scan.phy_mask, BIT(MT_BAND1));
+	KUNIT_EXPECT_FALSE(test, dev->scan.aborted);
+	/* the vif's own link is not given back */
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_drv.n_link_remove, 0);
+	mt76_scan_test_stop(dev);
+}
+
+/* With stations connected, the phy returns to the operating channel
+ * between two scan channels.
+ */
+static void mt76_scan_test_back_to_operating(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_scan_test_ops);
+	struct mt76_dev *dev = hwt->dev;
+	struct mt76_phy *phy = &dev->phy;
+	struct ieee80211_vif *vif = mt76_scan_test_vif(test);
+	struct ieee80211_channel *chans[2];
+	long delay;
+
+	chans[0] = mt76_scan_test_2g(phy, 6);
+	chans[1] = mt76_scan_test_2g(phy, 11);
+	mt76_scan_test_operate(phy, mt76_scan_test_2g(phy, 1));
+	mt76_scan_test_start(test, dev, vif, mt76_scan_test_mlink(vif), chans,
+			     2, 0);
+	dev->scan.req->req.duration = 300;
+	phy->num_sta = 1;
+
+	delay = mt76_scan_test_step(phy);
+	KUNIT_EXPECT_GE(test, delay, (long)msecs_to_jiffies(300));
+	KUNIT_EXPECT_TRUE(test, phy->offchannel);
+
+	/* back home for a normal step, then on to the next channel */
+	delay = mt76_scan_test_step(phy);
+	MT76_SCAN_TEST_DELAY(test, delay, HZ / 9);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_drv.n_set_channel, 2);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_scan_test_drv.set_chandef.chan,
+			    phy->main_chandef.chan);
+	KUNIT_EXPECT_FALSE(test, phy->offchannel);
+	KUNIT_EXPECT_NULL(test, phy->scan.chan);
+	KUNIT_EXPECT_EQ(test, phy->scan.chan_idx, 1);
+
+	mt76_scan_test_step(phy);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_scan_test_drv.set_chandef.chan,
+			    chans[1]);
+	KUNIT_EXPECT_TRUE(test, phy->offchannel);
+	mt76_scan_test_step(phy);
+	KUNIT_EXPECT_FALSE(test, phy->offchannel);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_step(phy), -1);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_SCANNING, &phy->state));
+	phy->num_sta = 0;
+	mt76_scan_test_stop(dev);
+}
+
+/* Aborting stops the scan work for good (until a new scan), forgets a
+ * pending beacon wait and returns to the operating channel.
+ */
+static void mt76_scan_test_abort(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_scan_test_ops);
+	struct mt76_dev *dev = hwt->dev;
+	struct mt76_phy *phy = &dev->phy;
+	struct ieee80211_vif *vif = mt76_scan_test_vif(test);
+	struct ieee80211_channel *chans[2];
+
+	chans[0] = mt76_scan_test_2g(phy, 6);
+	chans[1] = mt76_scan_test_2g(phy, 11);
+	mt76_scan_test_operate(phy, mt76_scan_test_2g(phy, 1));
+	mt76_scan_test_start(test, dev, vif, mt76_scan_test_mlink(vif), chans,
+			     2, 0);
+	mt76_scan_test_step(phy);
+	KUNIT_ASSERT_TRUE(test, phy->offchannel);
+	phy->scan.beacon_wait = true;
+	ieee80211_queue_delayed_work(phy->hw, &phy->scan_work, HZ);
+
+	mt76_abort_scan(dev);
+	KUNIT_EXPECT_FALSE(test, delayed_work_pending(&phy->scan_work));
+	KUNIT_EXPECT_FALSE(test, phy->scan.beacon_wait);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_SCANNING, &phy->state));
+	KUNIT_EXPECT_TRUE(test, dev->scan.aborted);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_drv.n_set_channel, 2);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_scan_test_drv.set_chandef.chan,
+			    phy->main_chandef.chan);
+	KUNIT_EXPECT_FALSE(test, phy->offchannel);
+	KUNIT_EXPECT_NULL(test, phy->scan.chan);
+
+	/* the work can be queued again */
+	ieee80211_queue_delayed_work(phy->hw, &phy->scan_work, HZ);
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&phy->scan_work));
+	cancel_delayed_work_sync(&phy->scan_work);
+
+	/* no scan: nothing to abort */
+	mt76_abort_scan(dev);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_drv.n_set_channel, 2);
+	mt76_scan_test_stop(dev);
+}
+
+static const u8 mt76_scan_test_bssid[ETH_ALEN] = {
+	0x02, 0x55, 0x66, 0x77, 0x88, 0x99
+};
+static const u8 mt76_scan_test_band_ies[] = { 0x01, 0x02, 0x82, 0x84 };
+static const u8 mt76_scan_test_common_ies[] = { 0x7f, 0x01, 0x04 };
+
+/* An active scan sends a probe request per SSID on each channel: from the
+ * vif, to the requested BSSID, with the SSID and then the band's and the
+ * common IEs, on the voice queue, through the scan link's wcid, as an
+ * off-channel frame.
+ */
+static void mt76_scan_test_probe_requests(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_scan_test_ops);
+	struct mt76_dev *dev = hwt->dev;
+	struct mt76_phy *phy = &dev->phy;
+	struct ieee80211_scan_request *req;
+	struct ieee80211_channel *chans[3];
+	struct ieee80211_tx_info *info;
+	struct ieee80211_hdr *hdr;
+	struct mt76_hwt_vif *mv;
+	struct sk_buff *skb;
+	long delay;
+	int i, tail;
+
+	mt76_hwt_iface(hwt, "managed");
+	mv = (struct mt76_hwt_vif *)hwt->vif->drv_priv;
+	mv->wcid.link_id = 2;
+	chans[0] = mt76_scan_test_2g(phy, 6);
+	chans[1] = mt76_scan_test_2g(phy, 11);
+	chans[2] = mt76_scan_test_2g(phy, 1);
+	for (i = 0; i < ARRAY_SIZE(chans); i++)
+		chans[i]->flags &= ~(IEEE80211_CHAN_NO_IR |
+				     IEEE80211_CHAN_RADAR);
+	mt76_scan_test_operate(phy, chans[2]);
+	req = mt76_scan_test_start(test, dev, hwt->vif, &mv->mlink, chans, 3,
+				   2);
+	memcpy(req->req.ssids[0].ssid, "milkflint", 9);
+	req->req.ssids[0].ssid_len = 9;
+	memcpy(req->req.bssid, mt76_scan_test_bssid, ETH_ALEN);
+	req->req.no_cck = true;
+	req->ies.ies[NL80211_BAND_2GHZ] = mt76_scan_test_band_ies;
+	req->ies.len[NL80211_BAND_2GHZ] = sizeof(mt76_scan_test_band_ies);
+	req->ies.common_ies = mt76_scan_test_common_ies;
+	req->ies.common_ie_len = sizeof(mt76_scan_test_common_ies);
+
+	/* off-channel with probes: ~60 ms */
+	delay = mt76_scan_test_step(phy);
+	MT76_SCAN_TEST_DELAY(test, delay, HZ / 16);
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&mv->wcid.tx_offchannel), 2);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&mv->wcid.tx_pending));
+	KUNIT_EXPECT_FALSE(test, list_empty(&mv->wcid.tx_list));
+
+	skb = skb_peek(&mv->wcid.tx_offchannel);
+	hdr = (struct ieee80211_hdr *)skb->data;
+	info = IEEE80211_SKB_CB(skb);
+	KUNIT_EXPECT_TRUE(test, ieee80211_is_probe_req(hdr->frame_control));
+	KUNIT_EXPECT_MEMEQ(test, hdr->addr1, mt76_scan_test_bssid, ETH_ALEN);
+	KUNIT_EXPECT_MEMEQ(test, hdr->addr2, hwt->vif->addr, ETH_ALEN);
+	KUNIT_EXPECT_MEMEQ(test, hdr->addr3, mt76_scan_test_bssid, ETH_ALEN);
+	KUNIT_ASSERT_GE(test, skb->len, 24 + 2 + 9);
+	KUNIT_EXPECT_EQ(test, skb->data[24], WLAN_EID_SSID);
+	KUNIT_EXPECT_EQ(test, skb->data[25], 9);
+	KUNIT_EXPECT_MEMEQ(test, skb->data + 26, "milkflint", 9);
+	tail = sizeof(mt76_scan_test_band_ies) +
+	       sizeof(mt76_scan_test_common_ies);
+	KUNIT_EXPECT_EQ(test, skb->len, 24 + 2 + 9 + tail);
+	KUNIT_EXPECT_MEMEQ(test, skb->data + 35, mt76_scan_test_band_ies,
+			   sizeof(mt76_scan_test_band_ies));
+	KUNIT_EXPECT_MEMEQ(test, skb->data + 35 +
+			   sizeof(mt76_scan_test_band_ies),
+			   mt76_scan_test_common_ies,
+			   sizeof(mt76_scan_test_common_ies));
+	KUNIT_EXPECT_EQ(test, skb->priority, 7);
+	KUNIT_EXPECT_EQ(test, skb_get_queue_mapping(skb), IEEE80211_AC_VO);
+	KUNIT_EXPECT_PTR_EQ(test, info->control.vif, hwt->vif);
+	KUNIT_EXPECT_EQ(test, (int)info->band, NL80211_BAND_2GHZ);
+	KUNIT_EXPECT_TRUE(test, info->flags & IEEE80211_TX_CTL_NO_CCK_RATE);
+	KUNIT_EXPECT_TRUE(test, info->control.flags &
+			  IEEE80211_TX_CTRL_DONT_USE_RATE_MASK);
+	KUNIT_EXPECT_EQ(test, u32_get_bits(info->control.flags,
+					   IEEE80211_TX_CTRL_MLO_LINK), 2);
+	/* the second SSID: the wildcard */
+	skb = skb_peek_tail(&mv->wcid.tx_offchannel);
+	KUNIT_EXPECT_EQ(test, skb->data[24], WLAN_EID_SSID);
+	KUNIT_EXPECT_EQ(test, skb->data[25], 0);
+	KUNIT_EXPECT_EQ(test, skb->len, 24 + 2 + tail);
+
+	/* any BSSID, CCK allowed, no extra IEs, no link */
+	eth_broadcast_addr(req->req.bssid);
+	req->req.no_cck = false;
+	req->req.n_ssids = 1;
+	req->ies.len[NL80211_BAND_2GHZ] = 0;
+	req->ies.common_ie_len = 0;
+	skb_queue_purge(&mv->wcid.tx_offchannel);
+	mt76_scan_test_step(phy);
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&mv->wcid.tx_offchannel), 1);
+	skb = skb_peek(&mv->wcid.tx_offchannel);
+	hdr = (struct ieee80211_hdr *)skb->data;
+	info = IEEE80211_SKB_CB(skb);
+	KUNIT_EXPECT_TRUE(test, is_broadcast_ether_addr(hdr->addr1));
+	KUNIT_EXPECT_TRUE(test, is_broadcast_ether_addr(hdr->addr3));
+	KUNIT_EXPECT_EQ(test, skb->len, 24 + 2 + 9);
+	KUNIT_EXPECT_FALSE(test, info->flags & IEEE80211_TX_CTL_NO_CCK_RATE);
+
+	/* on the operating channel: a full step */
+	skb_queue_purge(&mv->wcid.tx_offchannel);
+	delay = mt76_scan_test_step(phy);
+	MT76_SCAN_TEST_DELAY(test, delay, HZ / 9);
+	KUNIT_EXPECT_FALSE(test, phy->offchannel);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&mv->wcid.tx_offchannel), 1);
+	mt76_scan_test_stop(dev);
+}
+
+/* On radar and no-IR channels a scan may only probe after hearing a
+ * beacon there: it waits, and the beacon starts the probes at once.
+ */
+static void mt76_scan_test_beacon_wait(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_scan_test_ops);
+	struct mt76_dev *dev = hwt->dev;
+	struct mt76_phy *phy = &dev->phy;
+	struct ieee80211_scan_request *req;
+	struct ieee80211_channel *chans[2];
+	struct mt76_hwt_vif *mv;
+	long delay;
+
+	mt76_hwt_iface(hwt, "managed");
+	mv = (struct mt76_hwt_vif *)hwt->vif->drv_priv;
+	chans[0] = mt76_scan_test_2g(phy, 6);
+	chans[1] = mt76_scan_test_2g(phy, 11);
+	mt76_scan_test_operate(phy, mt76_scan_test_2g(phy, 1));
+	req = mt76_scan_test_start(test, dev, hwt->vif, &mv->mlink, chans, 2,
+				   1);
+
+	/* radar */
+	chans[0]->flags |= IEEE80211_CHAN_RADAR;
+	chans[0]->flags &= ~IEEE80211_CHAN_NO_IR;
+	delay = mt76_scan_test_step(phy);
+	MT76_SCAN_TEST_DELAY(test, delay, HZ / 9);
+	KUNIT_EXPECT_TRUE(test, phy->scan.beacon_wait);
+	KUNIT_EXPECT_FALSE(test, phy->scan.beacon_received);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&mv->wcid.tx_offchannel));
+
+	/* a beacon on another channel doesn't count */
+	mt76_scan_rx_beacon(phy, chans[1]);
+	KUNIT_EXPECT_FALSE(test, phy->scan.beacon_received);
+	KUNIT_EXPECT_FALSE(test, delayed_work_pending(&phy->scan_work));
+
+	/* one here runs the next step right away: the probes */
+	mt76_scan_rx_beacon(phy, chans[0]);
+	KUNIT_EXPECT_TRUE(test, phy->scan.beacon_received);
+	flush_delayed_work(&phy->scan_work);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&mv->wcid.tx_offchannel), 1);
+	KUNIT_EXPECT_FALSE(test, phy->scan.beacon_wait);
+	KUNIT_EXPECT_PTR_EQ(test, phy->scan.chan, chans[0]);
+	/* still on the same channel, a probe step long */
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&phy->scan_work));
+	cancel_delayed_work_sync(&phy->scan_work);
+	/* and only once */
+	mt76_scan_rx_beacon(phy, chans[0]);
+	KUNIT_EXPECT_FALSE(test, delayed_work_pending(&phy->scan_work));
+
+	/* no-IR */
+	chans[0]->flags &= ~IEEE80211_CHAN_RADAR;
+	chans[1]->flags |= IEEE80211_CHAN_NO_IR;
+	chans[1]->flags &= ~IEEE80211_CHAN_RADAR;
+	mt76_scan_test_step(phy);
+	KUNIT_EXPECT_PTR_EQ(test, phy->scan.chan, chans[1]);
+	KUNIT_EXPECT_TRUE(test, phy->scan.beacon_wait);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&mv->wcid.tx_offchannel), 1);
+	chans[1]->flags &= ~IEEE80211_CHAN_NO_IR;
+	mt76_scan_test_stop(dev);
+}
+
+static const struct ieee80211_ops mt76_scan_test_hw_ops = {
+	.tx = mt76_test_tx,
+	.start = mt76_test_start,
+	.stop = mt76_test_stop,
+	.add_interface = mt76_hwt_add_interface,
+	.remove_interface = mt76_hwt_remove_interface,
+	.config = mt76_test_config,
+	.configure_filter = mt76_test_configure_filter,
+	.wake_tx_queue = mt76_test_wake_tx_queue,
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
+	.hw_scan = mt76_hw_scan,
+	.cancel_hw_scan = mt76_cancel_hw_scan,
+};
+
+static void mt76_scan_test_free_wcid(void *data)
+{
+	struct mt76_dev *dev = data;
+
+	mt76_wcid_cleanup(dev, &mt76_scan_test_wcid);
+}
+
+/* A scan userspace starts (iw, through nl80211 and mac80211) runs to the
+ * end: a probe request on the channel, the scan's off-channel link given
+ * back, and mac80211 told the scan is done.
+ */
+static void mt76_scan_test_from_userspace(struct kunit *test)
+{
+	struct mt76_hwt *hwt;
+	struct mt76_dev *dev;
+	struct sk_buff *skb;
+	char *argv[] = { "/usr/sbin/iw", "dev", NULL, "scan", "trigger",
+			 "freq", "2437", "ssid", "milkflint", NULL };
+	int i, ret;
+
+	dev = mt76_hwt_dev_ops(test, &mt76_scan_test_hw_ops,
+			       &mt76_scan_test_ops);
+	/* what a driver with hardware scan says it can do */
+	dev->hw->wiphy->max_scan_ssids = 4;
+	dev->hw->wiphy->max_scan_ie_len = IEEE80211_MAX_DATA_LEN;
+	hwt = mt76_hwt_register(test, dev);
+	mt76_hwt_iface(hwt, "managed");
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_scan_test_free_wcid, dev), 0);
+	mt76_scan_test_2g(&dev->phy, 6)->flags &=
+		~(IEEE80211_CHAN_NO_IR | IEEE80211_CHAN_RADAR);
+
+	argv[2] = hwt->ndev->name;
+	ret = mt76_hwt_run(argv);
+	if (ret)
+		kunit_skip(test, "iw scan trigger failed: %d", ret);
+	for (i = 0; i < 300 && READ_ONCE(dev->scan.req); i++)
+		msleep(10);
+
+	KUNIT_EXPECT_NULL(test, READ_ONCE(dev->scan.req));
+	KUNIT_EXPECT_EQ(test, dev->scan.phy_mask, 0);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_SCANNING, &dev->phy.state));
+	KUNIT_EXPECT_FALSE(test, dev->phy.offchannel);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_drv.n_link_add, 1);
+	KUNIT_EXPECT_EQ(test, mt76_scan_test_drv.n_link_remove, 1);
+	KUNIT_EXPECT_GE(test, mt76_scan_test_drv.n_set_channel, 1);
+	KUNIT_ASSERT_GE(test, skb_queue_len(&mt76_scan_test_wcid.tx_offchannel),
+			1);
+	skb = skb_peek(&mt76_scan_test_wcid.tx_offchannel);
+	KUNIT_EXPECT_TRUE(test, ieee80211_is_probe_req(
+			  ((struct ieee80211_hdr *)skb->data)->frame_control));
+	KUNIT_EXPECT_MEMEQ(test, skb->data + 26, "milkflint", 9);
+}
+
+static struct kunit_case mt76_scan_test_cases[] = {
+	KUNIT_CASE(mt76_scan_test_idle),
+	KUNIT_CASE(mt76_scan_test_passive),
+	KUNIT_CASE(mt76_scan_test_back_to_operating),
+	KUNIT_CASE(mt76_scan_test_abort),
+	KUNIT_CASE(mt76_scan_test_probe_requests),
+	KUNIT_CASE(mt76_scan_test_beacon_wait),
+	KUNIT_CASE(mt76_scan_test_from_userspace),
+	{}
+};
+
+static struct kunit_suite mt76_scan_test_suite = {
+	.name = "mt76-scan",
+	.init = mt76_scan_test_init,
+	.test_cases = mt76_scan_test_cases,
+};
+
+kunit_test_suites(&mt76_scan_test_suite);
diff --git a/tests/util-test.c b/tests/util-test.c
new file mode 100644
index 00000000..e85ecccb
--- /dev/null
+++ b/tests/util-test.c
@@ -0,0 +1,283 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for mt76's register polling, wcid allocation and worker
+ * threads (util.c, util.h). Included at the end of util.c when
+ * CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU test build only).
+ */
+#include <kunit/test.h>
+#include "core-hw.h"
+
+#define MT76_UTIL_TEST_REG	0x8a00
+
+/* the status register reads @ready from its @after-th read on */
+struct mt76_util_test_reg {
+	unsigned int reads, after;
+	u32 ready;
+};
+
+static u32 mt76_util_test_rr(struct mt76_test_fake *fake, u32 addr, u32 val)
+{
+	struct mt76_util_test_reg *reg = fake->priv;
+
+	if (addr != MT76_UTIL_TEST_REG)
+		return val;
+	if (++reg->reads >= reg->after)
+		return reg->ready;
+	return val;
+}
+
+static struct mt76_util_test_reg *
+mt76_util_test_reg(struct kunit *test, unsigned int after, u32 ready)
+{
+	struct mt76_util_test_reg *reg;
+
+	reg = kunit_kzalloc(test, sizeof(*reg), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, reg);
+	reg->after = after;
+	reg->ready = ready;
+	mt76_test_fake->priv = reg;
+	mt76_test_fake->rr_hook = mt76_util_test_rr;
+	return reg;
+}
+
+/* A poll ends at the first read where the masked bits have the value. */
+static void mt76_util_test_poll_ready(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, NULL);
+	struct mt76_util_test_reg *reg;
+
+	/* already there; the other bits don't matter */
+	reg = mt76_util_test_reg(test, 1, 0x80000003);
+	KUNIT_EXPECT_TRUE(test, __mt76_poll(dev, MT76_UTIL_TEST_REG,
+					    0x80000000, 0x80000000, 1000));
+	KUNIT_EXPECT_EQ(test, reg->reads, 1);
+
+	/* after three reads */
+	reg = mt76_util_test_reg(test, 3, 0x2);
+	KUNIT_EXPECT_TRUE(test, __mt76_poll(dev, MT76_UTIL_TEST_REG, 0x3, 0x2,
+					    1000));
+	KUNIT_EXPECT_EQ(test, reg->reads, 3);
+
+	/* waiting for bits to clear */
+	reg = mt76_util_test_reg(test, 2, 0);
+	mt76_test_set_reg(mt76_test_fake, MT76_UTIL_TEST_REG, BIT(5));
+	KUNIT_EXPECT_TRUE(test, __mt76_poll(dev, MT76_UTIL_TEST_REG, BIT(5), 0,
+					    1000));
+	KUNIT_EXPECT_EQ(test, reg->reads, 2);
+}
+
+/* A register that never gets there: false after the timeout (in us), read
+ * every 10 us; all masked bits must match, not some.
+ */
+static void mt76_util_test_poll_timeout(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, NULL);
+	struct mt76_util_test_reg *reg;
+	ktime_t t0;
+
+	reg = mt76_util_test_reg(test, 1, 0x1);
+	t0 = ktime_get();
+	KUNIT_EXPECT_FALSE(test, __mt76_poll(dev, MT76_UTIL_TEST_REG, 0x3, 0x3,
+					     100));
+	KUNIT_EXPECT_GE(test, ktime_us_delta(ktime_get(), t0), 100);
+	KUNIT_EXPECT_EQ(test, reg->reads, 100 / 10 + 1);
+}
+
+/* The sleeping poll reads once per tick (in ms) until the timeout. */
+static void mt76_util_test_poll_msec(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, NULL);
+	struct mt76_util_test_reg *reg;
+	ktime_t t0;
+
+	reg = mt76_util_test_reg(test, 2, BIT(0));
+	t0 = ktime_get();
+	KUNIT_EXPECT_TRUE(test, ____mt76_poll_msec(dev, MT76_UTIL_TEST_REG,
+						   BIT(0), BIT(0), 10, 1));
+	KUNIT_EXPECT_EQ(test, reg->reads, 2);
+	KUNIT_EXPECT_GE(test, ktime_us_delta(ktime_get(), t0), 1000);
+
+	reg = mt76_util_test_reg(test, 100, BIT(0));
+	t0 = ktime_get();
+	KUNIT_EXPECT_FALSE(test, ____mt76_poll_msec(dev, MT76_UTIL_TEST_REG,
+						    BIT(0), BIT(0), 3, 1));
+	KUNIT_EXPECT_EQ(test, reg->reads, 3 / 1 + 1);
+	KUNIT_EXPECT_GE(test, ktime_us_delta(ktime_get(), t0), 4000);
+	/* a coarser tick reads less often */
+	reg = mt76_util_test_reg(test, 100, BIT(0));
+	KUNIT_EXPECT_FALSE(test, ____mt76_poll_msec(dev, MT76_UTIL_TEST_REG,
+						    BIT(0), BIT(0), 4, 2));
+	KUNIT_EXPECT_EQ(test, reg->reads, 4 / 2 + 1);
+}
+
+/* Full words are skipped, a range starting inside a word skips the bits
+ * below it, and nothing at or past the size is handed out.
+ */
+static void mt76_util_test_wcid_alloc(struct kunit *test)
+{
+	u32 mask[3] = { ~0, 0, 0 };
+
+	KUNIT_EXPECT_EQ(test, mt76_wcid_alloc(mask, 96), 32);
+	KUNIT_EXPECT_EQ(test, mask[1], BIT(0));
+
+	/* from 36 on, although 33-35 are free */
+	KUNIT_EXPECT_EQ(test, __mt76_wcid_alloc(mask, 36, 96), 36);
+	KUNIT_EXPECT_EQ(test, mask[1], BIT(0) | BIT(4));
+	KUNIT_EXPECT_EQ(test, __mt76_wcid_alloc(mask, 33, 96), 33);
+
+	/* a size that ends inside a word */
+	mask[1] = GENMASK(7, 0);
+	KUNIT_EXPECT_EQ(test, mt76_wcid_alloc(mask, 40), -1);
+	KUNIT_EXPECT_EQ(test, mask[1], GENMASK(7, 0));
+	KUNIT_EXPECT_EQ(test, mt76_wcid_alloc(mask, 41), 40);
+	KUNIT_EXPECT_EQ(test, mt76_wcid_alloc(mask, 41), -1);
+}
+
+struct mt76_util_test_worker {
+	struct mt76_worker w;
+	struct completion done;
+	atomic_t runs;
+	bool running, scheduled;
+};
+
+static void mt76_util_test_work(struct mt76_worker *w)
+{
+	struct mt76_util_test_worker *t =
+		container_of(w, struct mt76_util_test_worker, w);
+
+	t->running = test_bit(MT76_WORKER_RUNNING, &w->state);
+	t->scheduled = test_bit(MT76_WORKER_SCHEDULED, &w->state);
+	atomic_inc(&t->runs);
+	complete(&t->done);
+}
+
+static void mt76_util_test_teardown(void *data)
+{
+	mt76_worker_teardown(data);
+}
+
+static struct mt76_util_test_worker *
+mt76_util_test_worker(struct kunit *test, struct mt76_dev *dev)
+{
+	struct mt76_util_test_worker *t;
+
+	t = kunit_kzalloc(test, sizeof(*t), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, t);
+	init_completion(&t->done);
+	KUNIT_ASSERT_EQ(test, mt76_worker_setup(dev->hw, &t->w,
+						mt76_util_test_work, "test"),
+			0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_util_test_teardown, &t->w), 0);
+	return t;
+}
+
+/* wait for the worker to finish what it is running */
+static bool mt76_util_test_idle(struct mt76_worker *w)
+{
+	int i;
+
+	for (i = 0; i < 1000; i++) {
+		if (!test_bit(MT76_WORKER_RUNNING, &w->state) &&
+		    !test_bit(MT76_WORKER_SCHEDULED, &w->state))
+			return true;
+		usleep_range(100, 200);
+	}
+	return false;
+}
+
+/* The worker thread runs its function once per schedule, flagged as
+ * running and with the request consumed.
+ */
+static void mt76_util_test_worker_runs(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, NULL);
+	struct mt76_util_test_worker *t = mt76_util_test_worker(test, dev);
+	char name[TASK_COMM_LEN];
+
+	KUNIT_ASSERT_NOT_NULL(test, t->w.task);
+	snprintf(name, sizeof(name), "mt76-test %s",
+		 wiphy_name(dev->hw->wiphy));
+	KUNIT_EXPECT_STREQ(test, t->w.task->comm, name);
+	/* nothing until asked */
+	msleep(5);
+	KUNIT_EXPECT_EQ(test, atomic_read(&t->runs), 0);
+
+	mt76_worker_schedule(&t->w);
+	KUNIT_ASSERT_TRUE(test, wait_for_completion_timeout(&t->done, HZ));
+	KUNIT_EXPECT_TRUE(test, t->running);
+	KUNIT_EXPECT_FALSE(test, t->scheduled);
+	KUNIT_ASSERT_TRUE(test, mt76_util_test_idle(&t->w));
+	KUNIT_EXPECT_EQ(test, atomic_read(&t->runs), 1);
+
+	reinit_completion(&t->done);
+	mt76_worker_schedule(&t->w);
+	KUNIT_ASSERT_TRUE(test, wait_for_completion_timeout(&t->done, HZ));
+	KUNIT_ASSERT_TRUE(test, mt76_util_test_idle(&t->w));
+	KUNIT_EXPECT_EQ(test, atomic_read(&t->runs), 2);
+}
+
+/* A disabled (parked) worker doesn't run; enabling it runs it. */
+static void mt76_util_test_worker_disable(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, NULL);
+	struct mt76_util_test_worker *t = mt76_util_test_worker(test, dev);
+
+	mt76_worker_disable(&t->w);
+	KUNIT_EXPECT_EQ(test, t->w.state, 0);
+	mt76_worker_schedule(&t->w);
+	msleep(10);
+	KUNIT_EXPECT_EQ(test, atomic_read(&t->runs), 0);
+
+	mt76_worker_enable(&t->w);
+	KUNIT_ASSERT_TRUE(test, wait_for_completion_timeout(&t->done, HZ));
+	KUNIT_ASSERT_TRUE(test, mt76_util_test_idle(&t->w));
+	KUNIT_EXPECT_GE(test, atomic_read(&t->runs), 1);
+}
+
+/* After teardown the thread is gone and scheduling does nothing; a worker
+ * set up without a function keeps the one it has.
+ */
+static void mt76_util_test_worker_teardown(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, NULL);
+	struct mt76_util_test_worker *t;
+
+	t = kunit_kzalloc(test, sizeof(*t), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, t);
+	init_completion(&t->done);
+	t->w.fn = mt76_util_test_work;
+	KUNIT_ASSERT_EQ(test, mt76_worker_setup(dev->hw, &t->w, NULL, "test"),
+			0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_util_test_teardown, &t->w), 0);
+	mt76_worker_schedule(&t->w);
+	KUNIT_ASSERT_TRUE(test, wait_for_completion_timeout(&t->done, HZ));
+	KUNIT_ASSERT_TRUE(test, mt76_util_test_idle(&t->w));
+
+	mt76_worker_teardown(&t->w);
+	KUNIT_EXPECT_NULL(test, t->w.task);
+	mt76_worker_schedule(&t->w);
+	mt76_worker_disable(&t->w);
+	mt76_worker_enable(&t->w);
+	msleep(5);
+	KUNIT_EXPECT_EQ(test, atomic_read(&t->runs), 1);
+}
+
+static struct kunit_case mt76_util_test_cases[] = {
+	KUNIT_CASE(mt76_util_test_poll_ready),
+	KUNIT_CASE(mt76_util_test_poll_timeout),
+	KUNIT_CASE(mt76_util_test_poll_msec),
+	KUNIT_CASE(mt76_util_test_wcid_alloc),
+	KUNIT_CASE(mt76_util_test_worker_runs),
+	KUNIT_CASE(mt76_util_test_worker_disable),
+	KUNIT_CASE(mt76_util_test_worker_teardown),
+	{}
+};
+
+static struct kunit_suite mt76_util_test_suite = {
+	.name = "mt76-util",
+	.test_cases = mt76_util_test_cases,
+};
+
+kunit_test_suites(&mt76_util_test_suite);
