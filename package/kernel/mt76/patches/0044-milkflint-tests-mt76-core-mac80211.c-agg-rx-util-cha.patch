+static void mt76_test_destroy_pool(void *pool)
+{
+	page_pool_destroy(pool);
+}
+
+/* Rx queues get a page pool sized for their traffic, mapped for the device
+ * and tied to their NAPI on MMIO; tx queues get none unless WED frees tx
+ * buffers through them.
+ */
+static void mt76_test_create_page_pool(struct kunit *test)
+{
+	struct mt76_bus_ops *usb_bus;
+	struct mt76_queue txq = {};
+	struct page_pool *pool;
+	struct mt76_dev *dev;
+	struct mt76_queue *q;
+
+	dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+
+	/* the main data queue */
+	q = &dev->q_rx[MT_RXQ_MAIN];
+	KUNIT_ASSERT_EQ(test, mt76_create_page_pool(dev, q), 0);
+	pool = q->page_pool;
+	KUNIT_ASSERT_NOT_NULL(test, pool);
+	kunit_add_action(test, mt76_test_destroy_pool, pool);
+	KUNIT_EXPECT_EQ(test, pool->p.pool_size, 256);
+	KUNIT_EXPECT_PTR_EQ(test, pool->p.napi, &dev->napi[MT_RXQ_MAIN]);
+	KUNIT_EXPECT_PTR_EQ(test, pool->p.dev, dev->dma_dev);
+	KUNIT_EXPECT_TRUE(test, pool->dma_map);
+	KUNIT_EXPECT_TRUE(test, pool->dma_sync);
+	KUNIT_EXPECT_EQ(test, pool->p.dma_dir, DMA_FROM_DEVICE);
+	KUNIT_EXPECT_EQ(test, pool->p.max_len, PAGE_SIZE);
+
+	/* band 1 (the MT7986's 5 GHz) is a data queue too */
+	q = &dev->q_rx[MT_RXQ_BAND1];
+	KUNIT_ASSERT_EQ(test, mt76_create_page_pool(dev, q), 0);
+	KUNIT_ASSERT_NOT_NULL(test, q->page_pool);
+	kunit_add_action(test, mt76_test_destroy_pool, q->page_pool);
+	KUNIT_EXPECT_EQ(test, q->page_pool->p.pool_size, 256);
+	KUNIT_EXPECT_PTR_EQ(test, q->page_pool->p.napi,
+			    &dev->napi[MT_RXQ_BAND1]);
+
+	/* firmware events: a small pool */
+	q = &dev->q_rx[MT_RXQ_MCU];
+	KUNIT_ASSERT_EQ(test, mt76_create_page_pool(dev, q), 0);
+	KUNIT_ASSERT_NOT_NULL(test, q->page_pool);
+	kunit_add_action(test, mt76_test_destroy_pool, q->page_pool);
+	KUNIT_EXPECT_EQ(test, q->page_pool->p.pool_size, 16);
+	KUNIT_EXPECT_PTR_EQ(test, q->page_pool->p.napi,
+			    &dev->napi[MT_RXQ_MCU]);
+
+	/* a tx queue: none */
+	KUNIT_EXPECT_EQ(test, mt76_create_page_pool(dev, &txq), 0);
+	KUNIT_EXPECT_NULL(test, txq.page_pool);
+
+	/* WED's tx-free ring: a small pool without NAPI */
+	txq.flags = MT_WED_Q_TXFREE;
+	KUNIT_ASSERT_EQ(test, mt76_create_page_pool(dev, &txq), 0);
+	KUNIT_ASSERT_NOT_NULL(test, txq.page_pool);
+	kunit_add_action(test, mt76_test_destroy_pool, txq.page_pool);
+	KUNIT_EXPECT_EQ(test, txq.page_pool->p.pool_size, 16);
+	KUNIT_EXPECT_NULL(test, txq.page_pool->p.napi);
+
+	/* not MMIO: no DMA mapping, no NAPI */
+	usb_bus = kunit_kmalloc(test, sizeof(*usb_bus), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, usb_bus);
+	*usb_bus = *dev->bus;
+	usb_bus->type = MT76_BUS_USB;
+	dev->bus = usb_bus;
+	q = &dev->q_rx[MT_RXQ_BAND2];
+	KUNIT_ASSERT_EQ(test, mt76_create_page_pool(dev, q), 0);
+	KUNIT_ASSERT_NOT_NULL(test, q->page_pool);
+	kunit_add_action(test, mt76_test_destroy_pool, q->page_pool);
+	KUNIT_EXPECT_EQ(test, q->page_pool->p.pool_size, 256);
+	KUNIT_EXPECT_FALSE(test, q->page_pool->dma_map);
+	KUNIT_EXPECT_NULL(test, q->page_pool->p.napi);
+}
