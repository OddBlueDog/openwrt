+/* 6 GHz needs HE, which the driver adds to the band (mt76 doesn't) */
+static const struct ieee80211_sband_iftype_data mt76_test_he_iftype = {
+	.types_mask = BIT(NL80211_IFTYPE_STATION) | BIT(NL80211_IFTYPE_AP),
+	.he_cap = {
+		.has_he = true,
+		.he_mcs_nss_supp = {
+			.rx_mcs_80 = cpu_to_le16(0xfffa),
+			.tx_mcs_80 = cpu_to_le16(0xfffa),
+		},
+	},
+};
