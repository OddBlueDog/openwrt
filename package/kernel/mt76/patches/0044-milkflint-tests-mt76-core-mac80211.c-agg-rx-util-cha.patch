+/* The page pool counters of every rx queue in use add up into the ethtool
+ * array, and the index moves past them.
+ */
+static void mt76_test_ethtool_page_pool_stats(struct kunit *test)
+{
+	struct mt76_bus_ops *usb_bus;
+	struct page *page[2];
+	struct mt76_dev *dev;
+	u64 data[64] = {};
+	int i, idx = 5;
+
+	dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	/* not MMIO, so allocating pages maps nothing */
+	usb_bus = kunit_kmalloc(test, sizeof(*usb_bus), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, usb_bus);
+	*usb_bus = *dev->bus;
+	usb_bus->type = MT76_BUS_USB;
+	dev->bus = usb_bus;
+
+	for (i = 0; i < 2; i++) {
+		struct mt76_queue *q = &dev->q_rx[i];
+
+		KUNIT_ASSERT_EQ(test, mt76_create_page_pool(dev, q), 0);
+		KUNIT_ASSERT_NOT_NULL(test, q->page_pool);
+		kunit_add_action(test, mt76_test_destroy_pool, q->page_pool);
+		q->ndesc = 128;
+		page[i] = page_pool_dev_alloc_pages(q->page_pool);
+		KUNIT_ASSERT_NOT_NULL(test, page[i]);
+	}
+
+	mt76_ethtool_page_pool_stats(dev, &data[idx], &idx);
+
+	KUNIT_EXPECT_EQ(test, idx, 5 + page_pool_ethtool_stats_get_count());
+	/* rx_pp_alloc_slow: one page from each queue's pool */
+	KUNIT_EXPECT_EQ(test, data[5 + 1], 2);
+	KUNIT_EXPECT_EQ(test, data[4], 0);
+
+	for (i = 0; i < 2; i++)
+		page_pool_put_full_page(dev->q_rx[i].page_pool, page[i], false);
+}
