+	OPTIMIZER_HIDE_VAR(ops.sw_scan_start);
+	OPTIMIZER_HIDE_VAR(ops.sw_scan_complete);
+	ops.sw_scan_start(dev->hw, NULL, mt76_hwt_addr);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_SCANNING, &dev->phy.state));
+	ops.sw_scan_complete(dev->hw, NULL);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_SCANNING, &dev->phy.state));
+}
