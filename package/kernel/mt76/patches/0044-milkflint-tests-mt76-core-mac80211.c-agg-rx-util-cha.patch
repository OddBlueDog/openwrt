+	s8 one[] = { -50 };
+	s8 equal[] = { -50, -50 };
+	s8 close2[] = { -50, -52 };
+	s8 close6[] = { -50, -56 };
+	s8 far[] = { -50, -57 };
+	s8 three[] = { -50, -50, -50 };
+	s8 masked[] = { -30, -60 };
+	s8 invalid[] = { 5, -60 };
+
+	KUNIT_EXPECT_EQ(test, mt76_rx_signal(0x1, one), -50);
+	KUNIT_EXPECT_EQ(test, mt76_rx_signal(0x3, equal), -47);
+	KUNIT_EXPECT_EQ(test, mt76_rx_signal(0x3, close2), -48);
+	KUNIT_EXPECT_EQ(test, mt76_rx_signal(0x3, close6), -49);
+	KUNIT_EXPECT_EQ(test, mt76_rx_signal(0x3, far), -50);
+	/* the order of the chains doesn't matter */
+	swap(close2[0], close2[1]);
+	KUNIT_EXPECT_EQ(test, mt76_rx_signal(0x3, close2), -48);
+	KUNIT_EXPECT_EQ(test, mt76_rx_signal(0x7, three), -46);
+	KUNIT_EXPECT_EQ(test, mt76_rx_signal(0x2, masked), -60);
+	KUNIT_EXPECT_EQ(test, mt76_rx_signal(0x3, invalid), -60);
+	/* no chain: no signal */
+	KUNIT_EXPECT_EQ(test, mt76_rx_signal(0, one), -128);
+}
+
+/* Firmware rate indices map to the band's bitrate table: CCK (with the
+ * short preamble bit ignored) only on 2.4 GHz, OFDM after the CCK rates
+ * there and from the start on 5 GHz; unknown ones fall back to the first.
+ */
+static void mt76_test_get_rate(struct kunit *test)
+{
+	struct ieee80211_supported_band sband_2g = {
+		.band = NL80211_BAND_2GHZ,
+		.bitrates = mt76_rates,
+		.n_bitrates = ARRAY_SIZE(mt76_rates),
+	};
+	struct ieee80211_supported_band sband_5g = {
+		.band = NL80211_BAND_5GHZ,
+		.bitrates = mt76_rates + 4,
+		.n_bitrates = ARRAY_SIZE(mt76_rates) - 4,
+	};
+	struct mt76_dev *dev;
+
+	dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+
+	/* CCK 1, 2, 5.5, 11 Mbps; 4-7 are the short preamble variants */
+	KUNIT_EXPECT_EQ(test, mt76_get_rate(dev, &sband_2g, 0, true), 0);
+	KUNIT_EXPECT_EQ(test, mt76_get_rate(dev, &sband_2g, 3, true), 3);
+	KUNIT_EXPECT_EQ(test, mt76_get_rate(dev, &sband_2g, 6, true), 2);
+	/* OFDM 6 Mbps (11) and 54 Mbps (12) */
+	KUNIT_EXPECT_EQ(test, mt76_get_rate(dev, &sband_2g, 11, false), 4);
+	KUNIT_EXPECT_EQ(test, mt76_get_rate(dev, &sband_2g, 12, false), 11);
+	/* an OFDM index that equals a CCK one isn't taken for it */
+	KUNIT_EXPECT_EQ(test, mt76_get_rate(dev, &sband_2g, 8, false), 10);
+	KUNIT_EXPECT_EQ(test, mt76_get_rate(dev, &sband_5g, 11, false), 0);
+	KUNIT_EXPECT_EQ(test, mt76_get_rate(dev, &sband_5g, 12, false), 7);
+	/* no CCK on 5 GHz, and an unknown index: the first rate */
+	KUNIT_EXPECT_EQ(test, mt76_get_rate(dev, &sband_5g, 3, true), 0);
+	KUNIT_EXPECT_EQ(test, mt76_get_rate(dev, &sband_5g, 7, false), 0);
+}
