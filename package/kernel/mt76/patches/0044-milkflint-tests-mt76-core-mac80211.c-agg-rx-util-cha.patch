+/* The stream capabilities follow the antenna mask, on every band. */
+static void mt76_test_stream_caps(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct mt76_phy *phy = &dev->phy;
+	struct ieee80211_sta_ht_cap *ht2 = &phy->sband_2g.sband.ht_cap;
+	struct ieee80211_sta_ht_cap *ht5 = &phy->sband_5g.sband.ht_cap;
+	struct ieee80211_sta_vht_cap *vht5 = &phy->sband_5g.sband.vht_cap;
+
+	mt76_test_sbands(test, phy);
+	KUNIT_ASSERT_EQ(test, mt76_init_sband_6g(phy, mt76_rates + 4, 8), 0);
+	phy->cap.has_6ghz = true;
+
+	/* one antenna: no tx STBC, one stream */
+	phy->antenna_mask = 0x1;
+	mt76_set_stream_caps(phy, true);
+	KUNIT_EXPECT_FALSE(test, ht2->cap & IEEE80211_HT_CAP_TX_STBC);
+	KUNIT_EXPECT_EQ(test, ht2->mcs.rx_mask[0], 0xff);
+	KUNIT_EXPECT_EQ(test, ht2->mcs.rx_mask[1], 0);
+	KUNIT_EXPECT_FALSE(test, ht5->cap & IEEE80211_HT_CAP_TX_STBC);
+	KUNIT_EXPECT_FALSE(test, vht5->cap & IEEE80211_VHT_CAP_TXSTBC);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(vht5->vht_mcs.rx_mcs_map), 0xfffe);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(vht5->vht_mcs.tx_mcs_map), 0xfffe);
+	/* 2.4 GHz has no VHT to touch */
+	KUNIT_EXPECT_EQ(test, phy->sband_2g.sband.vht_cap.cap, 0);
+	/* the 6 GHz band follows too */
+	KUNIT_EXPECT_EQ(test, phy->sband_6g.sband.ht_cap.mcs.rx_mask[0], 0xff);
+	KUNIT_EXPECT_EQ(test, phy->sband_6g.sband.ht_cap.mcs.rx_mask[1], 0);
+
+	/* four antennas */
+	phy->antenna_mask = 0xf;
+	mt76_set_stream_caps(phy, true);
+	KUNIT_EXPECT_TRUE(test, ht2->cap & IEEE80211_HT_CAP_TX_STBC);
+	KUNIT_EXPECT_EQ(test, ht2->mcs.rx_mask[3], 0xff);
+	KUNIT_EXPECT_EQ(test, ht2->mcs.rx_mask[4], 0);
+	KUNIT_EXPECT_TRUE(test, vht5->cap & IEEE80211_VHT_CAP_TXSTBC);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(vht5->vht_mcs.rx_mcs_map), 0xffaa);
+
+	/* without VHT only HT changes */
+	phy->antenna_mask = 0x1;
+	mt76_set_stream_caps(phy, false);
+	KUNIT_EXPECT_EQ(test, ht5->mcs.rx_mask[1], 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(vht5->vht_mcs.rx_mcs_map), 0xffaa);
+
+	/* rate control that handles VHT extended NSS bandwidth */
+	ieee80211_hw_set(dev->hw, SUPPORTS_VHT_EXT_NSS_BW);
+	mt76_set_stream_caps(phy, true);
+	KUNIT_EXPECT_TRUE(test, le16_to_cpu(vht5->vht_mcs.tx_highest) &
