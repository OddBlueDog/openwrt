+/* mac80211's software scan brackets: the phy is scanning in between. */
+static void mt76_test_sw_scan(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	/* called the way mac80211 does, through its ops (not inlined here) */
+	struct ieee80211_ops ops = {
+		.sw_scan_start = mt76_sw_scan,
+		.sw_scan_complete = mt76_sw_scan_complete,
+	};
