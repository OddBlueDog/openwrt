+	mt76_check_sband(phy, &phy->sband_2g, NL80211_BAND_2GHZ);
+	KUNIT_EXPECT_EQ(test, phy->sband_2g.sband.n_channels, 0);
+	KUNIT_EXPECT_NULL(test, wiphy->bands[NL80211_BAND_2GHZ]);
+	KUNIT_EXPECT_NULL(test, dev->band_phys[NL80211_BAND_2GHZ]);
+	KUNIT_EXPECT_NULL(test, phy->chandef.chan);
+
+	mt76_check_sband(phy, &phy->sband_5g, NL80211_BAND_5GHZ);
+	KUNIT_EXPECT_EQ(test, phy->sband_5g.sband.n_channels, 28);
+	KUNIT_EXPECT_PTR_EQ(test, phy->chandef.chan,
+			    &phy->sband_5g.sband.channels[0]);
+	KUNIT_EXPECT_EQ(test, phy->chandef.width, NL80211_CHAN_WIDTH_20);
+	KUNIT_EXPECT_EQ(test, phy->chandef.center_freq1, 5180);
+	KUNIT_EXPECT_PTR_EQ(test, phy->chan_state, &phy->sband_5g.chan[0]);
+	KUNIT_EXPECT_PTR_EQ(test, dev->band_phys[NL80211_BAND_5GHZ], phy);
+
+	/* a band this phy doesn't have leaves another phy's band alone */
+	wiphy->bands[NL80211_BAND_6GHZ] = &other;
+	mt76_check_sband(phy, &phy->sband_6g, NL80211_BAND_6GHZ);
+	KUNIT_EXPECT_PTR_EQ(test, wiphy->bands[NL80211_BAND_6GHZ], &other);
+	KUNIT_EXPECT_NULL(test, dev->band_phys[NL80211_BAND_6GHZ]);
+	wiphy->bands[NL80211_BAND_6GHZ] = NULL;
+}
