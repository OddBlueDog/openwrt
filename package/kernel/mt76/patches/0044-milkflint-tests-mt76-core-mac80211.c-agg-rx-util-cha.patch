+	band1->txpower_cur = 10;
+	conf = kunit_kzalloc(test, sizeof(*conf) + sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, conf);
+	ctx = (struct mt76_chanctx *)conf->drv_priv;
+	ctx->phy = band1;
+	mv->mlink.ctx = conf;
+	KUNIT_EXPECT_EQ(test, mt76_get_txpower(dev->hw, vif, 0, &dbm), 0);
+	KUNIT_EXPECT_EQ(test, dbm, 11);
+	dev->hw->wiphy->n_radio = 0;
+}
