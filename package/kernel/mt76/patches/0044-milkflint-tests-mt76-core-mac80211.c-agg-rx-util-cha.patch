+/* --- channels and the survey ---------------------------------------------- */
+
+/* Each channel has its survey slot in its band's table. */
+static void mt76_test_channel_state(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct mt76_phy *phy = &dev->phy;
+
+	mt76_test_sbands(test, phy);
+	KUNIT_ASSERT_EQ(test, mt76_init_sband_6g(phy, mt76_rates + 4, 8), 0);
+
+	struct ieee80211_channel *c2 = &phy->sband_2g.sband.channels[3];
+	struct ieee80211_channel *c5 = &phy->sband_5g.sband.channels[10];
+	struct ieee80211_channel *c6 = &phy->sband_6g.sband.channels[5];
+
+	KUNIT_EXPECT_PTR_EQ(test, mt76_channel_state(phy, c2),
+			    &phy->sband_2g.chan[3]);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_channel_state(phy, c5),
+			    &phy->sband_5g.chan[10]);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_channel_state(phy, c6),
+			    &phy->sband_6g.chan[5]);
+}
+
+/* Bringing the survey up to date asks the driver for its counters and adds
+ * the time since the last update to the channel's active time; software rx
+ * airtime moves to the channel too.
+ */
+static void mt76_test_survey_update(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct mt76_channel_state *state;
+	struct mt76_phy *phy = &dev->phy;
+	ktime_t before;
+
+	mt76_test_sbands(test, phy);
+	state = &phy->sband_2g.chan[0];
+	phy->chan_state = state;
+	before = ktime_sub_us(ktime_get_boottime(), 5000);
+	phy->survey_time = before;
+	dev->cur_cc_bss_rx = 77;
+
+	mt76_update_survey(phy);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_update_survey, 1);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_test_drv.survey_phy, phy);
+	KUNIT_EXPECT_GE(test, state->cc_active, 5000);
+	KUNIT_EXPECT_LT(test, state->cc_active, 5000 + USEC_PER_SEC);
+	KUNIT_EXPECT_GE(test, ktime_us_delta(phy->survey_time, before), 5000);
+	/* the bss rx time is the driver's business here */
+	KUNIT_EXPECT_EQ(test, state->cc_bss_rx, 0);
+	KUNIT_EXPECT_EQ(test, dev->cur_cc_bss_rx, 77);
+
+	dev->drv = &mt76_test_airtime_ops;
+	mt76_update_survey(phy);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_update_survey, 2);
+	KUNIT_EXPECT_EQ(test, state->cc_bss_rx, 77);
+	KUNIT_EXPECT_EQ(test, dev->cur_cc_bss_rx, 0);
+}
+
+/* A channel switch holds the tx path (MT76_RESET) while the driver
+ * reprograms the radio, closes the survey of the old channel first, resets
+ * the DFS state when the channel or its width changes, and keeps the
+ * operating channel when it only visits another one.
+ */
+static void mt76_test_set_channel_switch(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct cfg80211_chan_def ch1, ch6, ch6_40, ch11;
+	struct mt76_phy *phy = &dev->phy;
+	struct mt76_channel_state *states;
+	struct ieee80211_channel *chans;
+
+	mt76_test_sbands(test, phy);
+	chans = phy->sband_2g.sband.channels;
+	states = phy->sband_2g.chan;
+	cfg80211_chandef_create(&ch1, &chans[0], NL80211_CHAN_HT20);
+	cfg80211_chandef_create(&ch6, &chans[5], NL80211_CHAN_HT20);
+	cfg80211_chandef_create(&ch6_40, &chans[5], NL80211_CHAN_HT40PLUS);
+	cfg80211_chandef_create(&ch11, &chans[10], NL80211_CHAN_HT20);
+	phy->chandef = ch1;
+	phy->main_chandef = ch1;
+	phy->chan_state = &states[0];
+	phy->survey_time = ktime_get_boottime();
+	phy->dfs_state = MT_DFS_STATE_ACTIVE;
+	states[5].cc_busy = 123;
+
+	KUNIT_EXPECT_EQ(test, mt76_set_channel(phy, &ch6, false), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_set_channel, 1);
+	KUNIT_EXPECT_TRUE(test, mt76_test_drv.set_in_reset);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_test_drv.set_chandef.chan, &chans[5]);
+	KUNIT_EXPECT_FALSE(test, mt76_test_drv.set_offchannel);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_test_drv.set_state, &states[5]);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_RESET, &phy->state));
+	KUNIT_EXPECT_PTR_EQ(test, phy->main_chandef.chan, &chans[5]);
+	KUNIT_EXPECT_EQ(test, phy->dfs_state, MT_DFS_STATE_UNKNOWN);
+	KUNIT_EXPECT_EQ(test, states[5].cc_busy, 123);
+	/* the survey was brought up to date on the old channel */
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_update_survey, 1);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_test_drv.survey_state, &states[0]);
+
+	/* the same channel and width: the DFS state stays */
+	phy->dfs_state = MT_DFS_STATE_ACTIVE;
+	KUNIT_EXPECT_EQ(test, mt76_set_channel(phy, &ch6, false), 0);
+	KUNIT_EXPECT_EQ(test, phy->dfs_state, MT_DFS_STATE_ACTIVE);
+	/* a new width: not */
+	KUNIT_EXPECT_EQ(test, mt76_set_channel(phy, &ch6_40, false), 0);
+	KUNIT_EXPECT_EQ(test, phy->dfs_state, MT_DFS_STATE_UNKNOWN);
+	KUNIT_EXPECT_EQ(test, phy->chandef.width, NL80211_CHAN_WIDTH_40);
+
+	/* visiting channel 11: its survey starts over, channel 6 stays */
+	states[10].cc_busy = 55;
+	KUNIT_EXPECT_EQ(test, mt76_set_channel(phy, &ch11, true), 0);
+	KUNIT_EXPECT_TRUE(test, mt76_test_drv.set_offchannel);
+	KUNIT_EXPECT_TRUE(test, phy->offchannel);
+	KUNIT_EXPECT_PTR_EQ(test, phy->chandef.chan, &chans[10]);
+	KUNIT_EXPECT_PTR_EQ(test, phy->main_chandef.chan, &chans[5]);
+	KUNIT_EXPECT_PTR_EQ(test, phy->chan_state, &states[10]);
+	KUNIT_EXPECT_EQ(test, states[10].cc_busy, 0);
+
+	/* the driver's error comes back, and the tx path is released */
+	mt76_test_drv.set_channel_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt76_set_channel(phy, &ch1, false), -EIO);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_RESET, &phy->state));
+}
+
+/* mac80211's channel (and radar and off-channel flags) are what the phy
+ * switches to.
+ */
+static void mt76_test_update_channel(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct mt76_phy *phy = &dev->phy;
+	struct ieee80211_hw *hw = dev->hw;
+	struct ieee80211_channel *ch1, *ch36;
+
+	mt76_test_sbands(test, phy);
+	ch1 = &phy->sband_2g.sband.channels[0];
+	ch36 = &phy->sband_5g.sband.channels[0];
+	cfg80211_chandef_create(&phy->chandef, ch1, NL80211_CHAN_HT20);
+	phy->main_chandef = phy->chandef;
+	phy->chan_state = &phy->sband_2g.chan[0];
+
+	cfg80211_chandef_create(&hw->conf.chandef, ch36, NL80211_CHAN_HT20);
+	hw->conf.flags = IEEE80211_CONF_OFFCHANNEL;
+	hw->conf.radar_enabled = true;
+	KUNIT_EXPECT_EQ(test, mt76_update_channel(phy), 0);
+	KUNIT_EXPECT_TRUE(test, phy->radar_enabled);
+	KUNIT_EXPECT_TRUE(test, phy->offchannel);
+	KUNIT_EXPECT_PTR_EQ(test, phy->chandef.chan, ch36);
+	KUNIT_EXPECT_PTR_EQ(test, phy->main_chandef.chan, ch1);
+
+	hw->conf.flags = 0;
+	hw->conf.radar_enabled = false;
+	KUNIT_EXPECT_EQ(test, mt76_update_channel(phy), 0);
+	KUNIT_EXPECT_FALSE(test, phy->radar_enabled);
+	KUNIT_EXPECT_FALSE(test, phy->offchannel);
+	KUNIT_EXPECT_PTR_EQ(test, phy->main_chandef.chan, ch36);
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_set_channel, 2);
+}
+
+/* Frames are pending while any tx queue of the phy holds some, or while
+ * management frames are on their way.
+ */
+static void mt76_test_has_tx_pending(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct mt76_phy *phy = &dev->phy;
+	struct mt76_queue q = {};
+
+	KUNIT_EXPECT_FALSE(test, mt76_has_tx_pending(phy));
+	phy->q_tx[MT_TXQ_BE] = &q;
+	KUNIT_EXPECT_FALSE(test, mt76_has_tx_pending(phy));
+	q.queued = 2;
+	KUNIT_EXPECT_TRUE(test, mt76_has_tx_pending(phy));
+	q.queued = 0;
+	atomic_set(&phy->mgmt_tx_pending, 1);
+	KUNIT_EXPECT_TRUE(test, mt76_has_tx_pending(phy));
+	phy->q_tx[MT_TXQ_BE] = NULL;
+}
