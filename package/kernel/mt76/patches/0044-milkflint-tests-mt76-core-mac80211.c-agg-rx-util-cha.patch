+/* The hardware strips the CCMP header; putting it back must rebuild it from
+ * the PN (stored most significant byte first) behind the 802.11 header.
+ */
+static void mt76_test_insert_ccmp_hdr(struct kunit *test)
+{
+	static const u8 pn[6] = { 0x15, 0x14, 0x13, 0x12, 0x11, 0x10 };
+	static const u8 ccmp[8] = { 0x10, 0x11, 0x00, 0xa0,
+				    0x12, 0x13, 0x14, 0x15 };
+	struct mt76_rx_status *status;
+	struct sk_buff *skb;
+	u8 hdr[26];
+
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 4);
+	memcpy(skb->data + 26, "body", 4);
+	memcpy(hdr, skb->data, sizeof(hdr));
+	status = mt76_test_status(skb);
+	memcpy(status->iv, pn, sizeof(pn));
+	status->flag = RX_FLAG_DECRYPTED | RX_FLAG_IV_STRIPPED |
+		       RX_FLAG_MMIC_STRIPPED;
+
+	mt76_insert_ccmp_hdr(skb, 2);
+
+	KUNIT_ASSERT_EQ(test, skb->len, 26 + 8 + 4);
+	KUNIT_EXPECT_MEMEQ(test, skb->data, hdr, sizeof(hdr));
+	KUNIT_EXPECT_MEMEQ(test, skb->data + 26, ccmp, sizeof(ccmp));
+	KUNIT_EXPECT_MEMEQ(test, skb->data + 34, "body", 4);
+	/* the IV is in the frame now; nothing else changes */
+	KUNIT_EXPECT_EQ(test, status->flag,
+			RX_FLAG_DECRYPTED | RX_FLAG_MMIC_STRIPPED);
+	kfree_skb(skb);
+}
