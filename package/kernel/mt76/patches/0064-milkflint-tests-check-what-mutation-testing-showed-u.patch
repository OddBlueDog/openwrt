 };
@@ -291,6 +292,7 @@ static int mt7915_mcu2_fw_queue(struct mt76_dev *mdev, struct mt76_queue *q,
 	frame = kunit_kmalloc(fw->test, sizeof(*frame) + skb->len, GFP_KERNEL);
 	if (frame) {
 		frame->q = q;
