 mt7915/tests/main-test.c |  7 ++-
 mt7915/tests/mcu-test.c  |  8 ++++
 mt7915/tests/mcu2-test.c | 14 ++++++
 tests/core-test.c        | 56 +++++++++++++++++++++++
 tests/mcu-test.c         | 16 ++++++-
 6 files changed, 195 insertions(+), 2 deletions(-)

diff --git a/mt7915/tests/mac-test.c b/mt7915/tests/mac-test.c
index 87e4f1c1..870ef3b7 100644
--- a/mt7915/tests/mac-test.c
+++ b/mt7915/tests/mac-test.c
@@ -2601,6 +2601,65 @@ static void mt7915_test_tx_free_v0(struct kunit *test)
 	kfree_skb(skb[1]);
 }
 
+/* Tx blocked because the token pool ran full stays blocked while freeing
+ * leaves it at the threshold or above, in either event format.
+ */
+static void mt7915_test_tx_free_still_full(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	int full = dev->mt76.token_size - MT76_TOKEN_FREE_THR;
+	struct sk_buff *skb;
+	u32 info[2];
+	__le32 *ev;
+	int id;
+
+	mt7915_test_sta(test, dev, 9, mvif);
+
+	/* the older format: one token freed, the pool still at the threshold */
+	id = mt7915_test_token(test, dev, 9, &skb);
+	dev->mt76.token_count += full;
+	env->q.blocked = true;
+	info[0] = id;
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY_V0, 1, 0, info, 1);
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 3 * 4));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb));
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, full);
+	KUNIT_EXPECT_TRUE(test, env->q.blocked);
+	kfree_skb(skb);
+
+	/* the current format: the same */
+	dev->mt76.token_count -= full;
+	id = mt7915_test_token(test, dev, 9, &skb);
+	dev->mt76.token_count += full;
+	info[0] = MT_TX_FREE_PAIR | FIELD_PREP(MT_TX_FREE_WLAN_ID, 9);
+	info[1] = FIELD_PREP(MT_TX_FREE_MSDU_ID, id);
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY, 2, 0, info, 2);
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 4 * 4));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb));
+	KUNIT_EXPECT_TRUE(test, env->q.blocked);
+	kfree_skb(skb);
+
+	/* back at the threshold: still blocked; one below it: unblocked */
+	id = mt7915_test_token(test, dev, 9, &skb);
+	info[1] = FIELD_PREP(MT_TX_FREE_MSDU_ID, id);
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY, 2, 0, info, 2);
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 4 * 4));
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, full);
+	KUNIT_EXPECT_TRUE(test, env->q.blocked);
+	kfree_skb(skb);
+	dev->mt76.token_count = full - 1;
+	id = mt7915_test_token(test, dev, 9, &skb);
+	kfree_skb(skb);
+	info[1] = FIELD_PREP(MT_TX_FREE_MSDU_ID, id);
+	ev = mt7915_test_event(test, PKT_TYPE_TXRX_NOTIFY, 2, 0, info, 2);
+	KUNIT_EXPECT_FALSE(test, mt7915_test_rx_check(dev, ev, 4 * 4));
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, full - 1);
+	KUNIT_EXPECT_FALSE(test, env->q.blocked);
+	dev->mt76.token_count = 0;
+}
+
 /* --- tx: tx status ------------------------------------------------------ */
 
 static void mt7915_test_txs(u32 *txs, u16 wcid, u8 pid, u32 txs0)
@@ -4111,12 +4170,28 @@ struct mt7915_test_napi {
 	struct mt7915_dev *dev;
 };
 
+/* the NAPI contexts polled since the test's last mt7915_test_napi() */
+static struct napi_struct *mt7915_test_napi_log[8];
+static int mt7915_test_npolled;
+
 static int mt7915_test_napi_poll(struct napi_struct *napi, int budget)
 {
+	if (mt7915_test_npolled < ARRAY_SIZE(mt7915_test_napi_log))
+		mt7915_test_napi_log[mt7915_test_npolled++] = napi;
 	napi_complete(napi);
 	return 0;
 }
 
+static bool mt7915_test_was_polled(struct napi_struct *napi)
+{
+	int i;
+
+	for (i = 0; i < mt7915_test_npolled; i++)
+		if (mt7915_test_napi_log[i] == napi)
+			return true;
+	return false;
+}
+
 static void mt7915_test_napi_free(void *data)
 {
 	struct mt7915_test_napi *n = data;
@@ -4136,6 +4211,7 @@ static void mt7915_test_napi(struct kunit *test, struct mt7915_dev *dev)
 	n->dev = dev;
 	n->ndev = alloc_netdev_dummy(0);
 	KUNIT_ASSERT_NOT_NULL(test, n->ndev);
+	mt7915_test_npolled = 0;
 	rcu_expedite_gp();
 	netif_napi_add_tx(n->ndev, &dev->mt76.tx_napi, mt7915_test_napi_poll);
 	napi_enable(&dev->mt76.tx_napi);
@@ -4415,12 +4491,21 @@ static void mt7915_test_mac_restart(struct kunit *test)
 	mt7915_test_token(test, dev, 0, &skb);
 	set_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
 	set_bit(MT76_RESET, &phy1->mt76->state);
+	/* the MT7986 has no second host interface: its registers aren't ours */
+	mt76_wr(dev, MT_INT1_MASK_CSR, 0x5a5a);
+	mt76_wr(dev, MT_INT1_SOURCE_CSR, 0xa5a5);
+	mt76_wr(dev, MT_INT_MASK_CSR, 0);
 
 	mutex_lock(&dev->mt76.mutex);
 	ret = mt7915_mac_restart(dev);
 	mutex_unlock(&dev->mt76.mutex);
 
 	KUNIT_EXPECT_LT(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_INT1_MASK_CSR), 0x5a5a);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_INT1_SOURCE_CSR), 0xa5a5);
+	/* interrupts back on */
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_INT_MASK_CSR),
+			dev->mt76.mmio.irqmask);
 	KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb));
 	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 0);
 	/* DMA re-enabled after the reset */
@@ -4624,9 +4709,19 @@ static void mt7915_test_reset_work_ser(struct kunit *test)
 			      MT_MCU_CMD_RECOVERY_DONE |
 			      MT_MCU_CMD_NORMAL_STATE;
 	dev->mt76.mmio.irqmask = 0;
+	KUNIT_ASSERT_NOT_NULL(test, dev->mt76.tx_worker.task);
+	mt7915_test_npolled = 0;
 
 	mt7915_mac_reset_work(&dev->reset_work);
 
+	/* tx runs again: the tx worker is back, and the tx NAPI (which
+	 * reclaims what the hardware sent) was kicked
+	 */
+	KUNIT_EXPECT_NE(test, READ_ONCE(dev->mt76.tx_worker.task->__state),
+			TASK_PARKED);
+	KUNIT_EXPECT_TRUE(test, mt7915_test_was_polled(&dev->mt76.tx_napi));
+	KUNIT_EXPECT_TRUE(test, mt7915_test_was_polled(
+			  &dev->mt76.napi[MT_RXQ_MAIN]));
 	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_MCU_INT_EVENT),
 			MT_MCU_INT_EVENT_RESET_DONE);
 	KUNIT_EXPECT_TRUE(test, mt76_rr(dev, MT_WFDMA0_GLO_CFG) &
@@ -4788,6 +4883,7 @@ static struct kunit_case mt7915_mac_tx_test_cases[] = {
 	KUNIT_CASE(mt7915_test_tx_free_v3),
 	KUNIT_CASE(mt7915_test_tx_free_unknown),
 	KUNIT_CASE(mt7915_test_tx_free_v0),
+	KUNIT_CASE(mt7915_test_tx_free_still_full),
 	KUNIT_CASE(mt7915_test_txs_rate),
 	KUNIT_CASE(mt7915_test_tx_status_lifecycle),
 	KUNIT_CASE(mt7915_test_rx_check_types),
diff --git a/mt7915/tests/main-test.c b/mt7915/tests/main-test.c
