@@ -1804,6 +1816,7 @@ static void mt76_test_has_tx_pending(struct kunit *test)
 	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
 	struct mt76_phy *phy = &dev->phy;
 	struct mt76_queue q = {};
+	int i;
 
 	KUNIT_EXPECT_FALSE(test, mt76_has_tx_pending(phy));
 	phy->q_tx[MT_TXQ_BE] = &q;
@@ -1813,7 +1826,17 @@ static void mt76_test_has_tx_pending(struct kunit *test)
