 		list_add_tail(&frame->list, &fw->frames);
@@ -376,6 +378,8 @@ mt7915_mcu2_frame(struct kunit *test, struct mt7915_mcu2_fw *fw,
 	KUNIT_ASSERT_NOT_NULL(test, found);
 	KUNIT_ASSERT_EQ(test, found->len, (int)sizeof(*txd) + len);
 	KUNIT_EXPECT_PTR_EQ(test, found->q, &fw->q[qid]);
+	/* nothing for the descriptor's info word: the TXD says it all */
+	KUNIT_EXPECT_EQ(test, found->tx_info, 0);
 
 	txd = (struct mt76_connac2_mcu_txd *)found->data;
 	KUNIT_EXPECT_EQ(test, txd->cid, cid);
@@ -581,6 +585,7 @@ mt7915_mcu2_last_frame(struct kunit *test, struct mt7915_mcu2_fw *fw,
 	KUNIT_ASSERT_FALSE(test, list_empty(&fw->frames));
 	frame = list_last_entry(&fw->frames, struct mt7915_mcu2_frame, list);
 	KUNIT_EXPECT_PTR_EQ(test, frame->q, &fw->q[qid]);
+	KUNIT_EXPECT_EQ(test, frame->tx_info, 0);
 	KUNIT_EXPECT_EQ(test, frame->len,
 			(int)sizeof(struct mt76_connac2_mcu_txd) + len);
 	return (struct mt76_connac2_mcu_txd *)frame->data;
@@ -715,6 +720,7 @@ static void mt7915_mcu2_send_queues(struct kunit *test)
 					list);
 		KUNIT_EXPECT_PTR_EQ_MSG(test, frame->q, &fw->q[cases[i].qid],
 					"case %d", i);
+		KUNIT_EXPECT_EQ_MSG(test, frame->tx_info, 0, "case %d", i);
 	}
 	clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
 }
@@ -2519,6 +2525,7 @@ static void mt7915_mcu2_power_setup(struct kunit *test,
 static void mt7915_mcu2_txpower_sku_off(struct kunit *test)
 {
 	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 *eep;
 
 	mt7915_mcu2_power_setup(test, dev, 10);
 	mt7915_mcu2_power_eeprom(test, dev, MT_EE_RATE_DELTA_EN |
@@ -2529,6 +2536,13 @@ static void mt7915_mcu2_txpower_sku_off(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, dev->mphy.txpower_cur, 36);
 	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 0);
 
+	/* the best chain can be the first one */
+	eep = dev->mt76.eeprom.data;
+	eep[MT_EE_TX0_POWER_2G_V2] = 40;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_txpower_sku(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.txpower_cur, 42);
+	eep[MT_EE_TX0_POWER_2G_V2] = 30;
+
 	mt7915_mcu2_power_eeprom(test, dev, MT_EE_RATE_DELTA_EN | 3);
 	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_txpower_sku(&dev->phy), 0);
 	KUNIT_EXPECT_EQ(test, dev->mphy.txpower_cur, 31);
