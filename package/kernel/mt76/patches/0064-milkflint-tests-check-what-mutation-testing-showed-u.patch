+	c.sta->deflink.vht_cap.cap |= IEEE80211_VHT_CAP_SU_BEAMFORMEE_CAPABLE;
 	c.mvif->cap.vht_su_ebfer = false;
 	c.mvif->cap.vht_su_ebfee = false;
 	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
@@ -3701,6 +3708,7 @@ static void mt7915_test_rate_ctrl_tlv_5g(struct kunit *test)
 			PHY_MODE_A | PHY_MODE_AN | PHY_MODE_AC);
 	KUNIT_EXPECT_EQ(test, ra->channel, 36);
 	KUNIT_EXPECT_EQ(test, ra->bw, IEEE80211_STA_RX_BW_80);
+	KUNIT_EXPECT_EQ(test, ra->phy.bw, IEEE80211_STA_RX_BW_80);
 	KUNIT_EXPECT_EQ(test, ra->rate_len, 4);
 	KUNIT_EXPECT_EQ(test, ra->supp_mode, MODE_OFDM | MODE_HT | MODE_VHT);
 	KUNIT_EXPECT_EQ(test, ra->supp_cck_rate, 0);
diff --git a/mt7915/tests/mcu2-test.c b/mt7915/tests/mcu2-test.c
index f2a5ebb7..436851d2 100644
--- a/mt7915/tests/mcu2-test.c
+++ b/mt7915/tests/mcu2-test.c
@@ -254,6 +254,7 @@ mt7915_mcu2_tune(struct kunit *test, struct mt7915_dev *dev, int freq,
 struct mt7915_mcu2_frame {
 	struct list_head list;
 	struct mt76_queue *q;
