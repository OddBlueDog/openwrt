 	bool set_offchannel;
 	struct mt76_channel_state *set_state;
@@ -61,6 +62,7 @@ static int mt76_test_set_channel(struct mt76_phy *phy)
 {
 	mt76_test_drv.n_set_channel++;
 	mt76_test_drv.set_in_reset = test_bit(MT76_RESET, &phy->state);
