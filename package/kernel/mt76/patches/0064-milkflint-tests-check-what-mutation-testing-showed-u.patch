+	mt76_test_status(skb)->wcid = wcid;
+	mt76_check_sta(dev, skb);
+	kfree_skb(skb);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_PS, &wcid->flags));
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_ps, 0);
+	clear_bit(MT_WCID_FLAG_PS, &wcid->flags);
+
+	/* without power save tracking the power bit means nothing */
+	clear_bit(MT_WCID_FLAG_CHECK_PS, &wcid->flags);
+	skb = mt76_test_rx_skb(test, IEEE80211_FTYPE_DATA |
+			       IEEE80211_STYPE_DATA | IEEE80211_FCTL_PM,
+			       mt76_hwt_addr, 1, 8);
+	mt76_test_status(skb)->wcid = wcid;
+	mt76_check_sta(dev, skb);
+	kfree_skb(skb);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &wcid->flags));
+	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_ps, 0);
 }
 
 /* A PS-Poll from a sender the hardware didn't match is looked up by its
@@ -2851,6 +2897,10 @@ static void mt76_test_sta_remove(struct kunit *test)
 	mt76_wcid_mask_set(dev->wcid_mask, 9);
 	mutex_lock(&dev->mutex);
 	KUNIT_ASSERT_EQ(test, mt76_rx_aggr_start(dev, wcid, 2, 100, 8), 0);
