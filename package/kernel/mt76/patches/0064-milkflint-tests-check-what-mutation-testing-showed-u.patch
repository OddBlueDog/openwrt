 /* The survey lists every channel of every band in order, with the times
@@ -2621,6 +2644,29 @@ static void mt76_test_check_sta_ps_unchanged(struct kunit *test)
 
 	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &wcid->flags));
 	KUNIT_EXPECT_EQ(test, mt76_test_drv.n_sta_ps, 0);
+
+	/* a station asleep that says so again stays asleep */
+	set_bit(MT_WCID_FLAG_PS, &wcid->flags);
+	skb = mt76_test_rx_skb(test, IEEE80211_FTYPE_DATA |
+			       IEEE80211_STYPE_DATA | IEEE80211_FCTL_PM,
