+		} else {
+			int idx = (r >> 8) % (nslots + 8);
+			bool wake = false;
+			struct mt76_txwi_cache *got;
+
+			got = mt76_token_release(dev, dev->token_start + idx,
+						 &wake);
+			if (idx < nslots && live[idx]) {
+				KUNIT_EXPECT_PTR_EQ(test, got, live[idx]);
+				if (live[idx]->qid == MT_TXQ_PSD)
+					n_mgmt--;
+				live[idx] = NULL;
+				n_live--;
+			} else {
+				KUNIT_EXPECT_NULL(test, got);
+				KUNIT_EXPECT_FALSE(test, wake);
+			}
+		}
+
+		KUNIT_EXPECT_EQ_MSG(test, dev->token_count, n_live,
+				    "step %d: token_count mismatch", step);
+		KUNIT_EXPECT_EQ_MSG(test, atomic_read(&dev->phy.mgmt_tx_pending),
+				    n_mgmt, "step %d: mgmt_tx_pending mismatch",
+				    step);
+	}
+
+	for (i = 0; i < nslots; i++) {
+		if (!live[i])
+			continue;
+		KUNIT_EXPECT_PTR_EQ(test,
+				    mt76_token_release(dev, dev->token_start + i,
+						       NULL),
+				    live[i]);
+	}
+	KUNIT_EXPECT_EQ(test, dev->token_count, 0);
+	KUNIT_EXPECT_EQ(test, atomic_read(&dev->phy.mgmt_tx_pending), 0);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&dev->token));
+}
