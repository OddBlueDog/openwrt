From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Sun, 18 Oct 2026 21:16:34 +0100
Subject: [PATCH] wifi: mt76: mt7915: use the vif's phy for FILS discovery
 frames

mt7915_mcu_add_inband_discov() always looked up the main hw and phy, so
for a BSS on the second band (5 GHz on MT7986) ext_phy was false: the
template was queued for band 0 and got band 0's fixed rate (CCK).

Take the phy and hw from the vif, as the beacon path does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mt7915/mcu.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/mt7915/mcu.c b/mt7915/mcu.c
index 2690dcff..9b6f2fb1 100644
--- a/mt7915/mcu.c
+++ b/mt7915/mcu.c
@@ -1983,10 +1983,10 @@ mt7915_mcu_add_inband_discov(struct mt7915_dev *dev, struct ieee80211_vif *vif,
 {
 #define OFFLOAD_TX_MODE_SU	BIT(0)
 #define OFFLOAD_TX_MODE_MU	BIT(1)
-	struct ieee80211_hw *hw = mt76_hw(dev);
-	struct mt7915_phy *phy = mt7915_hw_phy(hw);
 	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
-	struct cfg80211_chan_def *chandef = &mvif->phy->mt76->chandef;
+	struct mt7915_phy *phy = mvif->phy;
+	struct ieee80211_hw *hw = phy->mt76->hw;
+	struct cfg80211_chan_def *chandef = &phy->mt76->chandef;
 	enum nl80211_band band = chandef->chan->band;
 	struct mt76_wcid *wcid = &dev->mt76.global_wcid;
 	struct bss_info_bcn *bcn;
