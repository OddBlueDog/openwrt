@@ -696,6 +708,22 @@ static void mt76_dma_test_rxwi_cache(struct kunit *test)
 
 /* --- tx -------------------------------------------------------------------------- */
 
+/* queue_ops->tx_queue_skb() with BH off, as the driver's tx paths call it
+ * (mt76_txq_schedule(), mt76_tx_worker_run()): the txwi cache's lock is
+ * taken in softirq too
+ */
+static int mt76_dma_test_tx(struct mt76_phy *phy, struct mt76_queue *q,
+			    enum mt76_txq_id qid, struct sk_buff *skb,
+			    struct mt76_wcid *wcid, struct ieee80211_sta *sta)
+{
+	int ret;
+
+	local_bh_disable();
+	ret = phy->dev->queue_ops->tx_queue_skb(phy, q, qid, skb, wcid, sta);
+	local_bh_enable();
+	return ret;
+}
+
 /* A linear frame takes one descriptor: the txwi in buf0, the frame in buf1.
  * The driver gets the txwi to fill; the hardware is only told about the
  * frame once the queue is kicked.
@@ -723,7 +751,7 @@ static void mt76_dma_test_tx_queue_skb(struct kunit *test)
 	dev->phy.band_idx = MT_BAND1;
 	t->tx_info = 0xc0000a50;
 
