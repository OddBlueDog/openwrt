diff --git a/tests/eeprom-test.c b/tests/eeprom-test.c
index 1ae703f3..19cac357 100644
--- a/tests/eeprom-test.c
+++ b/tests/eeprom-test.c
@@ -111,10 +111,16 @@ static void mt76_eeprom_test_strip(struct device_node *np)
 		mt76_eeprom_test_strip(child);
 }
 
-static void mt76_eeprom_test_of_reset(void *data)
+/* The suite's exit: it runs before kunit frees what the test allocated,
+ * the nodes and properties among them, which a kunit action registered
+ * when the node is made would walk after their release.
+ */
+static void mt76_eeprom_test_of_reset(struct kunit *test)
 {
-	struct device *dev = data;
+	struct device *dev = test->priv;
 
+	if (!dev)
+		return;
 	if (dev->of_node)
 		mt76_eeprom_test_strip(dev->of_node);
 	dev->of_node = NULL;
@@ -127,8 +133,7 @@ static struct device_node *mt76_eeprom_test_of(struct kunit *test,
 	struct device_node *np = mt76_eeprom_test_node(test, NULL, "wifi");
 
 	dev->dev->of_node = np;
-	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
-			mt76_eeprom_test_of_reset, dev->dev), 0);
+	test->priv = dev->dev;
 	return np;
 }
 
@@ -823,6 +828,7 @@ static struct kunit_case mt76_eeprom_test_cases[] = {
 
 static struct kunit_suite mt76_eeprom_test_suite = {
 	.name = "mt76-eeprom",
+	.exit = mt76_eeprom_test_of_reset,
 	.test_cases = mt76_eeprom_test_cases,
 };
 
