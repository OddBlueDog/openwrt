 			MT_TXQ_BE, skb, NULL, NULL), -EINVAL);
 	KUNIT_EXPECT_EQ(test, t->n_prepare, 1);
 	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
@@ -972,7 +1000,7 @@ static void mt76_dma_test_tx_queue_skb_pad(struct kunit *test)
 	hdr->frame_control = cpu_to_le16(IEEE80211_FTYPE_DATA |
 					 IEEE80211_STYPE_QOS_DATA);
 
-	KUNIT_ASSERT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+	KUNIT_ASSERT_EQ(test, mt76_dma_test_tx(&dev->phy, q,
 			MT_TXQ_BE, skb, NULL, NULL), 0);
 	KUNIT_EXPECT_EQ(test, skb->len, 42);
 	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_SD_LEN1,
@@ -1077,7 +1105,7 @@ static void mt76_dma_test_queue_frames(struct mt76_dma_test *t,
 
 	for (i = 0; i < n; i++) {
 		skbs[i] = mt76_dma_test_skb(t, 50 + i, i);
-		KUNIT_ASSERT_GE(t->test, dev->queue_ops->tx_queue_skb(&dev->phy,
+		KUNIT_ASSERT_GE(t->test, mt76_dma_test_tx(&dev->phy,
 				q, MT_TXQ_BE, skbs[i], NULL, NULL), 0);
 	}
 	dev->queue_ops->kick(dev, q);
@@ -1171,7 +1199,7 @@ static void mt76_dma_test_tx_cleanup_multi_desc(struct kunit *test)
 	q = mt76_dma_test_tx_queue(t, 0, 8);
 	skb = mt76_dma_test_skb(t, 60, 0x01);
 	mt76_dma_test_add_frags(t, skb, 2, 40);
-	KUNIT_ASSERT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+	KUNIT_ASSERT_EQ(test, mt76_dma_test_tx(&dev->phy, q,
 			MT_TXQ_BE, skb, NULL, NULL), 1);
