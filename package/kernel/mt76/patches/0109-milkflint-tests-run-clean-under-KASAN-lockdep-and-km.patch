 	KUNIT_EXPECT_EQ(test, tid->nframes, 1);
 	KUNIT_EXPECT_PTR_EQ(test, tid->reorder_buf[102 % 8], skb);
+	/* reorder_time is 32 bits, as agg-rx.c compares it (time_before32()):
