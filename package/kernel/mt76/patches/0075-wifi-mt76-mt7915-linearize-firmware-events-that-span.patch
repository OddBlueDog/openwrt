From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Mon, 19 Oct 2026 23:29:13 +0100
Subject: [PATCH] wifi: mt76: mt7915: linearize firmware events that span rx
 buffers

A packet longer than one rx buffer (about 1.7 KB of data in a 2 KB page
pool buffer) comes from mt76_dma_rx_process() as an skb with the later
buffers attached as page fragments. rx_check doesn't see such packets;
they go to mt7915_queue_rx_skb(), which hands skb->data and skb->len to
the tx-free, tx status, MCU event and firmware monitor parsers. skb->len
counts the fragments but only the first buffer follows skb->data, so the
parsers read the skb's own shared info and whatever the next buffer
held: for a tx-free event, as token ids to release. The tokens in the
event's real tail were never released.

A tx-free event can list up to 1023 MSDUs (MT_TX_FREE_MSDU_CNT), four
bytes each, so it can need more than one buffer.

Linearize every packet except data frames before parsing it, and count
how often it happens in debugfs (rx_event_frags), so the router can show
whether its firmware ever sends one.

mt7915_test_tx_free_frags checks a tx-free event whose last MSDU is in
a second buffer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mt7915/debugfs.c        |  1 +
 mt7915/mac.c            | 18 ++++++++++++++-
 mt7915/mt7915.h         |  2 ++
 mt7915/tests/mac-test.c | 50 +++++++++++++++++++++++++++++++++++++++++
 4 files changed, 70 insertions(+), 1 deletion(-)

diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
index 7e561a47..80cf52cb 100644
--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -1335,6 +1335,7 @@ int mt7915_init_debugfs(struct mt7915_phy *phy)
 	debugfs_create_devm_seqfile(dev->mt76.dev, "twt_stats", dir,
 				    mt7915_twt_stats);
 	debugfs_create_file("rf_regval", 0600, dir, dev, &fops_rf_regval);
+	debugfs_create_u32("rx_event_frags", 0400, dir, &dev->rx_event_frags);
 	if (!is_mt7915(&dev->mt76))
 		debugfs_create_file("vow_atf", 0600, dir, dev, &fops_vow_atf);
 
diff --git a/mt7915/mac.c b/mt7915/mac.c
index 4b6bff33..11d4d77e 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1076,10 +1076,26 @@ void mt7915_queue_rx_skb(struct mt76_dev *mdev, enum mt76_rxq_id q,
 {
 	struct mt7915_dev *dev = container_of(mdev, struct mt7915_dev, mt76);
 	__le32 *rxd = (__le32 *)skb->data;
-	__le32 *end = (__le32 *)&skb->data[skb->len];
+	__le32 *end;
 	enum rx_pkt_type type;
 
 	type = le32_get_bits(rxd[0], MT_RXD0_PKT_TYPE);
+
+	/*
+	 * An event longer than one rx buffer arrives as page fragments
+	 * (mt76_add_fragment()), but everything below except data frames
+	 * parses skb->data for skb->len bytes.
+	 */
+	if (type != PKT_TYPE_NORMAL && skb_is_nonlinear(skb)) {
+		dev->rx_event_frags++;
+		if (skb_linearize(skb)) {
+			dev_kfree_skb(skb);
+			return;
+		}
+		rxd = (__le32 *)skb->data;
+	}
+	end = (__le32 *)&skb->data[skb->len];
+
 	mt76_record_rx_if(mdev, type != PKT_TYPE_NORMAL, q, skb->data,
 			  skb->len);
 
diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
index 4bc692bf..7da2b5f7 100644
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -310,6 +310,8 @@ struct mt7915_dev {
 
 	u32 hw_pattern;
 	u32 ple1_sts;
+	/* firmware events that spanned several rx buffers */
+	u32 rx_event_frags;
 
 	bool dbdc_support;
 	bool flash_mode;
diff --git a/mt7915/tests/mac-test.c b/mt7915/tests/mac-test.c
index a6325325..f9bdf345 100644
--- a/mt7915/tests/mac-test.c
+++ b/mt7915/tests/mac-test.c
@@ -2491,6 +2491,55 @@ static void mt7915_test_tx_free(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, ewma_avg_signal_read(&msta->avg_ack_signal), 57);
 }
 
+/* A tx-free event longer than one rx buffer reaches mt7915_queue_rx_skb()
+ * as page fragments (mt76_add_fragment()); the MSDU words in the later
+ * buffer free their tokens too, and debugfs counts the event.
+ */
+static void mt7915_test_tx_free_frags(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct sk_buff *skb[2], *ev;
+	struct page *page;
+	__le32 *w;
+	int id[2], i;
+
+	mt7915_test_sta(test, dev, 9, mvif);
+	for (i = 0; i < 2; i++)
+		id[i] = mt7915_test_token(test, dev, 9, &skb[i]);
+
+	/* the first buffer: the header, the wcid pair and the first MSDU */
+	ev = alloc_skb(256, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ev);
+	memset(ev->data, 0, skb_tailroom(ev));
+	w = skb_put(ev, 4 * 4);
+	w[0] = cpu_to_le32(FIELD_PREP(MT_RXD0_PKT_TYPE, PKT_TYPE_TXRX_NOTIFY) |
+			   (2 << 16));
+	w[1] = 0;
+	w[2] = cpu_to_le32(MT_TX_FREE_PAIR | FIELD_PREP(MT_TX_FREE_WLAN_ID, 9));
+	w[3] = cpu_to_le32(FIELD_PREP(MT_TX_FREE_MSDU_ID, id[0]));
+
+	/* the second buffer: the last MSDU */
+	page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	KUNIT_ASSERT_NOT_NULL(test, page);
+	w = page_address(page);
+	w[0] = cpu_to_le32(FIELD_PREP(MT_TX_FREE_MSDU_ID, id[1]));
+	skb_add_rx_frag(ev, 0, page, 0, 4, PAGE_SIZE);
+	KUNIT_ASSERT_TRUE(test, skb_is_nonlinear(ev));
+
+	mt7915_test_queue_rx(dev, ev);
+
+	for (i = 0; i < 2; i++) {
+		KUNIT_EXPECT_NULL_MSG(test, idr_find(&dev->mt76.token, id[i]),
+				      "token %d", i);
+		KUNIT_EXPECT_TRUE(test, mt7915_test_skb_freed(skb[i]));
+		kfree_skb(skb[i]);
+	}
+	KUNIT_EXPECT_EQ(test, dev->mt76.token_count, 0);
+	KUNIT_EXPECT_EQ(test, dev->rx_event_frags, 1);
+}
+
 /* Version 4 (v3 format) events: two MSDU IDs per word (0x7fff: none) and
  * MPDU header words that only carry statistics.
  */
@@ -4885,6 +4934,7 @@ static struct kunit_case mt7915_mac_tx_test_cases[] = {
 	KUNIT_CASE(mt7915_test_tx_prepare_refused),
 	KUNIT_CASE(mt7915_test_write_txwi_band1),
 	KUNIT_CASE(mt7915_test_tx_free),
+	KUNIT_CASE(mt7915_test_tx_free_frags),
 	KUNIT_CASE(mt7915_test_tx_free_v3),
 	KUNIT_CASE(mt7915_test_tx_free_unknown),
 	KUNIT_CASE(mt7915_test_tx_free_v0),
