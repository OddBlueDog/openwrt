From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Sun, 18 Oct 2026 21:27:47 +0100
Subject: [PATCH] wifi: mt76: mt7915: abort an L1 SER when the firmware crashes
 during it

mt7915_mac_reset_work() holds dev->mt76.mutex while it waits up to
MT7915_RESET_TIMEOUT (30 s) for each step of the L1 recovery handshake.
If the WM/WA firmware crashes meanwhile, mt7915_reset() queues the full
recovery but never wakes reset_wait, and the wait condition can't come
true, so the L1 work sits out two full timeouts with the mutex held
(blocking hostapd and every mutex-taking mac80211 op), then resumes on
the dead firmware before the full reset queued behind it can run.

Wake reset_wait from the watchdog branch, let the waits end on the
watchdog bits, and when they are set, re-enable NAPI and the tx worker
and leave everything else to the full reset.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mt7915/mac.c | 42 +++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 41 insertions(+), 1 deletion(-)

diff --git a/mt7915/mac.c b/mt7915/mac.c
index 7c8422bd..00abadfe 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1250,15 +1250,29 @@ void mt7915_update_channel(struct mt76_phy *mphy)
 	state->noise = -(phy->noise >> 4);
 }
 
+/* The firmware crashed (or a full reset was forced) while a SER handshake
+ * was in progress: mt7915_reset() has queued dump_work, which queues the
+ * full reset.
+ */
+static bool
+mt7915_reset_aborted(struct mt7915_dev *dev)
+{
+	return READ_ONCE(dev->recovery.state) & MT_MCU_CMD_WDT_MASK;
+}
+
 static bool
 mt7915_wait_reset_state(struct mt7915_dev *dev, u32 state)
 {
 	bool ret;
 
 	ret = wait_event_timeout(dev->reset_wait,
-				 (READ_ONCE(dev->recovery.state) & state),
+				 (READ_ONCE(dev->recovery.state) &
+				  (state | MT_MCU_CMD_WDT_MASK)),
 				 MT7915_RESET_TIMEOUT);
 
+	if (mt7915_reset_aborted(dev))
+		return false;
+
 	WARN(!ret, "Timeout waiting for MCU reset state %x\n", state);
 	return ret;
 }
@@ -1593,9 +1607,15 @@ void mt7915_mac_reset_work(struct work_struct *work)
 		mt7915_wait_reset_state(dev, MT_MCU_CMD_RECOVERY_DONE);
 	}
 
+	if (mt7915_reset_aborted(dev))
+		goto out_aborted;
+
 	mt76_wr(dev, MT_MCU_INT_EVENT, MT_MCU_INT_EVENT_RESET_DONE);
 	mt7915_wait_reset_state(dev, MT_MCU_CMD_NORMAL_STATE);
 
+	if (mt7915_reset_aborted(dev))
+		goto out_aborted;
+
 	/* enable DMA Tx/Rx and interrupt */
 	mt7915_dma_start(dev, false, false);
 
@@ -1637,6 +1657,24 @@ void mt7915_mac_reset_work(struct work_struct *work)
 		ieee80211_queue_delayed_work(ext_phy->hw,
 					     &phy2->mt76->mac_work,
 					     MT7915_WATCHDOG_TIME);
+	return;
+
+out_aborted:
+	/* The full reset runs next on this ordered workqueue and expects
+	 * napi and the tx worker enabled, so only undo their disabling.
+	 * MT76_RESET, MT76_MCU_RESET and the stopped mac80211 queues stay
+	 * as they are until mt7915_mac_full_reset() takes over.
+	 */
+	dev_warn(dev->mt76.dev,
+		 "L1 SER aborted (state 0x%08x), deferring to full recovery\n",
+		 READ_ONCE(dev->recovery.state));
+
+	mt76_for_each_q_rx(&dev->mt76, i)
+		napi_enable(&dev->mt76.napi[i]);
+	napi_enable(&dev->mt76.tx_napi);
+	mt76_worker_enable(&dev->mt76.tx_worker);
+
+	mutex_unlock(&dev->mt76.mutex);
 }
 
 /* firmware coredump */
@@ -1726,6 +1764,8 @@ void mt7915_reset(struct mt7915_dev *dev)
 
 		mt7915_irq_disable(dev, MT_INT_MCU_CMD);
 		queue_work(dev->mt76.wq, &dev->dump_work);
+		/* abort a SER handshake waiting in mt7915_mac_reset_work() */
+		wake_up(&dev->reset_wait);
 		return;
 	}
 
