+
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status, sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_HT, 15, 2,
+					      IEEE80211_STA_RX_BW_40, 1, 0,
+					      false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, (int)status.encoding, RX_ENC_HT);
+	KUNIT_EXPECT_EQ(test, status.rate_idx, 15);
+	KUNIT_EXPECT_EQ(test, (int)status.bw, RATE_INFO_BW_40);
+	KUNIT_EXPECT_TRUE(test, status.enc_flags & RX_ENC_FLAG_SHORT_GI);
+
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status, sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_HT_GF, 3, 1, 0, 0, 0,
+					      false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, (int)status.encoding, RX_ENC_HT);
+	KUNIT_EXPECT_FALSE(test, status.enc_flags & RX_ENC_FLAG_SHORT_GI);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_rx_rate(dev, &status, sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_HT, 32, 1, 0, 0, 0,
+					      false), &mode), -EINVAL);
+
+	/* VHT MCS 9, 4 space-time streams with STBC: 2 streams */
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status, sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_VHT, 9, 4,
+					      IEEE80211_STA_RX_BW_80, 1, 1,
+					      false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, (int)status.encoding, RX_ENC_VHT);
+	KUNIT_EXPECT_EQ(test, (int)status.nss, 2);
+	KUNIT_EXPECT_EQ(test, status.rate_idx, 9);
+	KUNIT_EXPECT_EQ(test, (int)status.bw, RATE_INFO_BW_80);
+	KUNIT_EXPECT_TRUE(test, status.enc_flags & RX_ENC_FLAG_SHORT_GI);
+	KUNIT_EXPECT_TRUE(test, status.enc_flags & RX_ENC_FLAG_STBC_MASK);
+
+	/* VHT MCS 11 (1024-QAM) is fine, 12 isn't */
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status, sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_VHT, 11, 1,
+					      IEEE80211_STA_RX_BW_160, 0, 0,
+					      false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, (int)status.nss, 1);
+	KUNIT_EXPECT_EQ(test, (int)status.bw, RATE_INFO_BW_160);
+	KUNIT_EXPECT_EQ(test, status.enc_flags, 0);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_rx_rate(dev, &status, sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_VHT, 12, 1, 0, 0, 0,
+					      false), &mode), -EINVAL);
+}
