+/* A frame waiting for its tx status gets it: acked unless the status says
+ * otherwise, as a single-frame A-MPDU, the station's rate updated.
+ */
+static void mt76_connac_test_add_txs_skb(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_wcid *wcid = mt76_connac_test_reg_wcid(test, dev, 12);
+	struct ieee80211_tx_info *info;
+	struct sk_buff *skb;
+	__le32 txs[8] = {};
+	int pid;
+
+	skb = mt76_connac_test_frame(test, MT76_CONNAC_TEST_QOS_DATA,
+				     mt76_connac_test_peer, 60);
+	info = IEEE80211_SKB_CB(skb);
+	info->flags = IEEE80211_TX_CTL_REQ_TX_STATUS;
+	pid = mt76_tx_status_skb_add(dev, wcid, skb);
+	KUNIT_ASSERT_GE(test, pid, MT_PACKET_ID_FIRST);
+	/* mac80211 frees the frame once reported: keep it for the checks */
+	skb_get(skb);
+	/* DMA is done already */
+	mt76_tx_complete_skb(dev, wcid->idx, skb);
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 2);
+
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_VHT, 8, 2,
+				      IEEE80211_STA_RX_BW_80, 0);
+	KUNIT_EXPECT_TRUE(test, mt76_connac2_mac_add_txs_skb(dev, wcid, pid,
+							     txs));
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 1);
+	KUNIT_EXPECT_TRUE(test, info->flags & IEEE80211_TX_STAT_ACK);
+	KUNIT_EXPECT_EQ(test, info->status.ampdu_len, 1);
+	KUNIT_EXPECT_EQ(test, info->status.ampdu_ack_len, 1);
+	KUNIT_EXPECT_EQ(test, info->status.rates[0].idx, -1);
+	KUNIT_EXPECT_EQ(test, wcid->rate.mcs, 8);
+	KUNIT_EXPECT_EQ(test, wcid->rate.flags, RATE_INFO_FLAGS_VHT_MCS);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&wcid->pktid));
+
+	/* the same packet id again: nothing waits for it any more */
+	KUNIT_EXPECT_FALSE(test, mt76_connac2_mac_add_txs_skb(dev, wcid, pid,
+							      txs));
+}
