+static const u8 mt76_connac_mcu_test_bssid[ETH_ALEN] = {
+	0x02, 0xaa, 0xbb, 0xcc, 0xdd, 0xee
+};
+
+/* An AP's basic BSS info: network type, broadcast entry, WMM set, cipher,
+ * BSSID, beacon timing and phy mode.
+ */
+static void mt76_connac_mcu_test_bss_basic_ap(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_vif *vif;
+	struct bss_info_basic *bss;
+	int ret;
+
+	mt76_connac_mcu_test_bands(test, dev);
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 0);
+	mt76_connac_mcu_test_mvif(vif)->cipher = MCU_CIPHER_AES_CCMP;
+	vif->bss_conf.bssid = mt76_connac_mcu_test_bssid;
+	vif->bss_conf.beacon_int = 100;
+	vif->bss_conf.dtim_period = 3;
+
+	bss = mt76_connac_mcu_test_bss_basic(test, dev, vif, NULL, 0x234,
+					     true, &ret);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(bss->network_type), NETWORK_INFRA);
+	KUNIT_EXPECT_EQ(test, bss->bmc_wcid_lo, 0x34);
+	KUNIT_EXPECT_EQ(test, bss->bmc_wcid_hi, 2);
+	KUNIT_EXPECT_EQ(test, bss->wmm_idx, 2);
+	KUNIT_EXPECT_EQ(test, bss->active, 1);
+	KUNIT_EXPECT_EQ(test, bss->cipher, MCU_CIPHER_AES_CCMP);
+	KUNIT_EXPECT_MEMEQ(test, bss->bssid, mt76_connac_mcu_test_bssid,
+			   ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(bss->bcn_interval), 100);
+	KUNIT_EXPECT_EQ(test, bss->dtim_period, 3);
+	KUNIT_EXPECT_EQ(test, bss->phy_mode, PHY_MODE_A | PHY_MODE_AN |
+			PHY_MODE_AC | PHY_MODE_AX_5G);
+	KUNIT_EXPECT_EQ(test, bss->max_bssid, 0);	/* no MBSSID */
+
+	/* P2P GO, being torn down */
+	vif->p2p = true;
+	bss = mt76_connac_mcu_test_bss_basic(test, dev, vif, NULL, 1, false,
+					     &ret);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(bss->network_type), NETWORK_P2P);
+	KUNIT_EXPECT_EQ(test, bss->active, 0);
+}
