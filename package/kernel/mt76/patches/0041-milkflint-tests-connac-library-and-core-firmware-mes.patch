+/* Without a WED (the MT7986 here) station records aren't mirrored to it.
+ * Called through a pointer, as mt7915 does: in this file the compiler
+ * folds the inlined copies away.
+ */
+static void mt76_connac_mcu_test_sta_wed_update(struct kunit *test)
+{
+	int (*wed_update)(struct mt76_dev *dev, struct sk_buff *skb);
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct sk_buff *skb = mt76_connac_mcu_test_skb(test, 8);
+	struct mt76_bus_ops *bus;
+
+	wed_update = mt76_connac_mcu_sta_wed_update;
+	OPTIMIZER_HIDE_VAR(wed_update);
+	KUNIT_EXPECT_FALSE(test, mtk_wed_device_active(&dev->mmio.wed));
+	KUNIT_EXPECT_EQ(test, wed_update(dev, skb), 0);
+	KUNIT_EXPECT_EQ(test, skb->len, 8);
+
+	bus = kunit_kmalloc(test, sizeof(*bus), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, bus);
+	*bus = mt76_test_bus_ops;
+	bus->type = MT76_BUS_USB;
+	dev->bus = bus;
+	KUNIT_EXPECT_EQ(test, wed_update(dev, skb), 0);
+}
