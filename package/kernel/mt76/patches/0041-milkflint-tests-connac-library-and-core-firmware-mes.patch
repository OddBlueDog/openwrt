+/* A download to the patch address is a patch download; anything else a
+ * RAM download. connac2 chips also patch at 0x900000.
+ */
+static void mt76_connac_mcu_test_init_download(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct mt76_test_msg *msg;
+	__le32 *req;
+
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_init_download(dev, 0x200000,
+							    0x1234, 0x80000001),
+			0);
+	req = mt76_connac_mcu_test_req(test, MCU_CMD(PATCH_START_REQ), 12);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req[0]), 0x200000);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req[1]), 0x1234);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req[2]), 0x80000001);
+
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_init_download(dev, 0x900000, 16,
+							    0), 0);
+	msg = mt76_test_msg(mt76_test_fake, 1);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_CMD(TARGET_ADDRESS_LEN_REQ));
+
+	dev->rev = MT76_CONNAC_MCU_TEST_C2_REV;
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_init_download(dev, 0x900000, 16,
+							    0), 0);
+	msg = mt76_test_msg(mt76_test_fake, 2);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_CMD(PATCH_START_REQ));
+
+	/* connac v1 has no patch address of its own here */
+	dev->rev = MT76_CONNAC_MCU_TEST_V1_REV;
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_init_download(dev, 0x200000, 16,
+							    0), 0);
+	msg = mt76_test_msg(mt76_test_fake, 3);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_CMD(TARGET_ADDRESS_LEN_REQ));
+
+	/* the connac3 chips' patch addresses */
+	dev->rev = 0x79250000;
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_init_download(dev, 0xe0002800,
+							    16, 0), 0);
+	dev->rev = 0x79280000;
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_init_download(dev, 0xe0002000,
+							    16, 0), 0);
+	dev->rev = 0x79900000;
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_init_download(dev, 0x900000,
+							    16, 0), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(mt76_test_fake,
+			MCU_CMD(PATCH_START_REQ)), 5);
+	/* but not each other's */
+	dev->rev = 0x79900000;
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_init_download(dev, 0xe0002000,
+							    16, 0), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(mt76_test_fake,
+			MCU_CMD(PATCH_START_REQ)), 5);
+}
