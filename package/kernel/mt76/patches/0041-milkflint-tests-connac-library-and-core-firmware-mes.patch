+/* --- request headers and TLV plumbing ------------------------------------ */
+
+/* A station request names the BSS, the station's WTBL entry (split over
+ * two bytes) and its own MAC; a non-station wcid (a BSS's broadcast
+ * entry) uses MUAR 0xe.
+ */
+static void mt76_connac_mcu_test_alloc_sta_req(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_vif *vif;
+	struct mt76_vif_link *mvif;
+	struct ieee80211_sta *sta;
+	struct sta_req_hdr *hdr;
+	struct mt76_wcid *wcid;
+	struct sk_buff *skb;
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 5);
+	mvif = mt76_connac_mcu_test_mvif(vif);
+	sta = mt76_connac_mcu_test_sta(test, 0x123);
+	wcid = mt76_connac_mcu_test_wcid(sta);
+
+	skb = mt76_connac_mcu_alloc_sta_req(dev, mvif, wcid);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(skb));
+	KUNIT_ASSERT_EQ(test, skb->len, sizeof(*hdr));
+	KUNIT_EXPECT_GE(test, skb_tailroom(skb),
+			MT76_CONNAC_STA_UPDATE_MAX_SIZE - sizeof(*hdr));
+	hdr = (struct sta_req_hdr *)skb->data;
+	KUNIT_EXPECT_EQ(test, hdr->bss_idx, 3);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_lo, 0x23);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_hi, 1);
+	KUNIT_EXPECT_EQ(test, hdr->muar_idx, 5);
+	KUNIT_EXPECT_EQ(test, hdr->is_tlv_append, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(hdr->tlv_num), 0);
+	kfree_skb(skb);
+
+	/* the BSS's own entry */
+	wcid->sta = 0;
+	skb = __mt76_connac_mcu_alloc_sta_req(dev, mvif, wcid, 64);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(skb));
+	KUNIT_EXPECT_EQ(test, ((struct sta_req_hdr *)skb->data)->muar_idx,
+			0xe);
+	kfree_skb(skb);
+
+	/* a station being removed keeps its MUAR */
+	wcid->sta_disabled = 1;
+	skb = __mt76_connac_mcu_alloc_sta_req(dev, mvif, wcid, 64);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(skb));
+	KUNIT_EXPECT_EQ(test, ((struct sta_req_hdr *)skb->data)->muar_idx, 5);
+	kfree_skb(skb);
+
+	/* no wcid at all: BSS-wide */
+	skb = __mt76_connac_mcu_alloc_sta_req(dev, mvif, NULL, 64);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(skb));
+	hdr = (struct sta_req_hdr *)skb->data;
+	KUNIT_EXPECT_EQ(test, hdr->muar_idx, 0);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_lo, 0);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_hi, 0);
+	kfree_skb(skb);
+}
+
+/* A WTBL request starts a new message when given none, or is appended to
+ * the station request it's nested in, whose WTBL TLV grows with it.
+ */
+static void mt76_connac_mcu_test_alloc_wtbl_req(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 0x105);
+	struct mt76_wcid *wcid = mt76_connac_mcu_test_wcid(sta);
+	struct wtbl_req_hdr *hdr;
+	struct sk_buff *skb = NULL;
+	struct tlv *sta_wtbl;
+
+	hdr = mt76_connac_mcu_alloc_wtbl_req(dev, wcid, WTBL_SET, NULL, &skb);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(hdr));
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_EXPECT_PTR_EQ(test, (void *)hdr, (void *)skb->data);
+	KUNIT_EXPECT_EQ(test, skb->len, sizeof(*hdr));
+	KUNIT_EXPECT_GE(test, skb_tailroom(skb),
+			MT76_CONNAC_WTBL_UPDATE_MAX_SIZE - sizeof(*hdr));
+	KUNIT_EXPECT_EQ(test, hdr->operation, WTBL_SET);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_lo, 0x05);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_hi, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(hdr->tlv_num), 0);
+	kfree_skb(skb);
+
+	skb = mt76_connac_mcu_test_skb(test, sizeof(struct sta_req_hdr));
+	sta_wtbl = mt76_connac_mcu_add_tlv(skb, STA_REC_WTBL,
+					   sizeof(struct tlv));
+	hdr = mt76_connac_mcu_alloc_wtbl_req(dev, wcid, WTBL_RESET_AND_SET,
+					     sta_wtbl, &skb);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(hdr));
+	KUNIT_EXPECT_PTR_EQ(test, (void *)hdr, (void *)(sta_wtbl + 1));
+	KUNIT_EXPECT_EQ(test, hdr->operation, WTBL_RESET_AND_SET);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(sta_wtbl->len),
+			sizeof(struct tlv) + sizeof(*hdr));
+	KUNIT_EXPECT_EQ(test, skb->len, sizeof(struct sta_req_hdr) +
+			sizeof(struct tlv) + sizeof(*hdr));
+}
+
+/* A nested TLV is zeroed apart from its tag and length, counted in its
+ * parent header, and grows the TLV it's nested in.
+ */
+static void mt76_connac_mcu_test_nested_tlv(struct kunit *test)
+{
+	struct sk_buff *skb = mt76_connac_mcu_test_skb(test, 8);
+	struct wtbl_smps *smps;
+	struct tlv *sta_wtbl;
+	u8 *wtbl_hdr;
+	int i;
+
+	sta_wtbl = mt76_connac_mcu_add_tlv(skb, STA_REC_WTBL,
+					   sizeof(struct tlv));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(sta_wtbl->tag), STA_REC_WTBL);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(sta_wtbl->len), sizeof(struct tlv));
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_ntlv(skb->data), 1);
+
+	wtbl_hdr = skb_put_zero(skb, sizeof(struct wtbl_req_hdr));
+	smps = (struct wtbl_smps *)mt76_connac_mcu_add_nested_tlv(skb,
+			WTBL_SMPS, sizeof(*smps), wtbl_hdr, sta_wtbl);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(smps->tag), WTBL_SMPS);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(smps->len), sizeof(*smps));
+	for (i = sizeof(struct tlv); i < sizeof(*smps); i++)
+		KUNIT_EXPECT_EQ(test, ((u8 *)smps)[i], 0);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_ntlv(wtbl_hdr), 1);
+	/* the outer count is the outer header's business */
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_ntlv(skb->data), 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(sta_wtbl->len), sizeof(struct tlv) +
+			sizeof(*smps));
+
+	/* without a parent TLV only the header count moves */
+	mt76_connac_mcu_add_nested_tlv(skb, WTBL_SPE, sizeof(struct wtbl_spe),
+				       wtbl_hdr, NULL);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_ntlv(wtbl_hdr), 2);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(sta_wtbl->len), sizeof(struct tlv) +
+			sizeof(*smps));
+}
