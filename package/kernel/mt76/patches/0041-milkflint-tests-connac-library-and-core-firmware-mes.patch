@@ -0,0 +1,2662 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for the connac firmware command builders (the station, BSS
+ * and WTBL TLVs the MT7986 sends through mt7915), firmware download and
+ * the connac2 message header. Included at the end of mt76_connac_mcu.c
+ * when CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU test build
+ * only).
+ *
+ * The device is mt76_test_dev() with the MT7986's chip id, so the code
+ * takes the mt7915-family branches (not connac v1, not "connac2", which in
+ * mt76 means the mt7921 family). A few tests switch to another chip id for
+ * branches of the same functions that other chips take.
+ */
+#include <kunit/test.h>
+#include <linux/fs.h>
+#include "fake.h"
+
+#define MT76_CONNAC_MCU_TEST_REV	0x79860000	/* MT7986 */
+#define MT76_CONNAC_MCU_TEST_V1_REV	0x76150000	/* MT7615: connac v1 */
+#define MT76_CONNAC_MCU_TEST_C2_REV	0x79610000	/* MT7921: connac2 */
+
+/* fake.h's mt76_test_hw_ops, plus the channel context ops this mac80211
+ * insists on (ieee80211_alloc_hw() refuses ops without them)
+ */
+static const struct ieee80211_ops mt76_connac_mcu_test_hw_ops = {
+	.tx = mt76_test_tx,
+	.start = mt76_test_start,
+	.stop = mt76_test_stop,
+	.add_interface = mt76_test_add_interface,
+	.remove_interface = mt76_test_remove_interface,
+	.config = mt76_test_config,
