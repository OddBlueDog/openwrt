+/* Missing or truncated images and firmware errors stop the load and leave
+ * the version alone.
+ */
+static void mt76_connac_mcu_test_load_ram_errors(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	char *ver = dev->hw->wiphy->fw_version;
+	u8 short_fw[16] = {};
+
+	mt76_connac_mcu_test_write_ram(test, MT76_CONNAC_MCU_TEST_WM,
+				       "WM_1.2.3.4", mt76_connac_mcu_test_wm,
+				       ARRAY_SIZE(mt76_connac_mcu_test_wm),
+				       NULL);
+	mt76_connac_mcu_test_write_fw(test, MT76_CONNAC_MCU_TEST_SHORT,
+				      short_fw, sizeof(short_fw));
+
+	KUNIT_EXPECT_EQ(test, mt76_connac2_load_ram(dev,
+			MT76_CONNAC_MCU_TEST_NONE, NULL), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt76_connac2_load_ram(dev,
+			MT76_CONNAC_MCU_TEST_SHORT, NULL), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 0);
+
+	mt76_connac_mcu_test_fail(MCU_CMD(TARGET_ADDRESS_LEN_REQ), 1, -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_connac2_load_ram(dev,
+			MT76_CONNAC_MCU_TEST_WM, NULL), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 0);
+
+	mt76_connac_mcu_test_fail(MCU_CMD(FW_SCATTER), 1, -ENOMEM);
+	mt76_connac_mcu_test_fw.n_fail_cmd = 0;
+	KUNIT_EXPECT_EQ(test, mt76_connac2_load_ram(dev,
+			MT76_CONNAC_MCU_TEST_WM, NULL), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 1);
+	KUNIT_EXPECT_STREQ(test, ver, "");
+
+	/* WM fine, then the WA image is missing, short, or fails to start */
+	mt76_connac_mcu_test_fail(0, 0, 0);
+	KUNIT_EXPECT_EQ(test, mt76_connac2_load_ram(dev,
+			MT76_CONNAC_MCU_TEST_WM, MT76_CONNAC_MCU_TEST_NONE),
+			-EINVAL);
+	KUNIT_EXPECT_STREQ(test, ver, "WM_1.2.3.4-20261019123456X");
+	KUNIT_EXPECT_EQ(test, mt76_connac2_load_ram(dev,
+			MT76_CONNAC_MCU_TEST_WM, MT76_CONNAC_MCU_TEST_SHORT),
+			-EINVAL);
+	mt76_connac_mcu_test_fail(MCU_CMD(FW_START_REQ), 2, -ETIMEDOUT);
+	mt76_connac_mcu_test_fw.n_fail_cmd = 0;
+	KUNIT_EXPECT_EQ(test, mt76_connac2_load_ram(dev,
+			MT76_CONNAC_MCU_TEST_WM, MT76_CONNAC_MCU_TEST_WM),
+			-ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_fw.n_fail_cmd, 2);
+}
