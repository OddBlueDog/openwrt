+/* The BA entry of a WTBL: as originator the window and start sequence (zero
+ * when the session stops); as recipient the peer and the reset rule.
+ */
+static void mt76_connac_mcu_test_wtbl_ba(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 1);
+	struct ieee80211_ampdu_params params = {
+		.sta = sta,
+		.tid = 6,
+		.ssn = 0x456,
+		.buf_size = 64,
+	};
+	struct sk_buff *skb;
+	struct tlv *sta_wtbl;
+	struct wtbl_ba *ba;
+	void *wtbl_hdr;
+
+#define BA(_enable, _tx) do {						\
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr); \
+	mt76_connac_mcu_wtbl_ba_tlv(dev, skb, &params, _enable, _tx,	\
+				    sta_wtbl, wtbl_hdr);		\
+	ba = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_BA);	\
+	KUNIT_ASSERT_NOT_NULL(test, ba);				\
+} while (0)
+
+	BA(true, true);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->len), sizeof(*ba));
+	KUNIT_EXPECT_EQ(test, ba->tid, 6);
+	KUNIT_EXPECT_EQ(test, ba->ba_type, MT_BA_TYPE_ORIGINATOR);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->sn), 0x456);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->ba_winsize), 64);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, 1);
+	KUNIT_EXPECT_EQ(test, ba->ba_winsize_idx, 0);	/* v1 only */
+
+	BA(false, true);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->sn), 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->ba_winsize), 0);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, 0);
+
+	BA(true, false);
+	KUNIT_EXPECT_EQ(test, ba->ba_type, MT_BA_TYPE_RECIPIENT);
+	KUNIT_EXPECT_MEMEQ(test, ba->peer_addr, mt76_connac_mcu_test_peer,
+			   ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, ba->rst_ba_tid, 6);
+	KUNIT_EXPECT_EQ(test, ba->rst_ba_sel, RST_BA_MAC_TID_MATCH);
+	KUNIT_EXPECT_EQ(test, ba->rst_ba_sb, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->ba_winsize), 64);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, 0);
+
+	BA(false, false);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->ba_winsize), 0);
+
+	/* connac v1 also wants the window as an index into its size table */
+	dev->rev = MT76_CONNAC_MCU_TEST_V1_REV;
+	params.buf_size = 64;
+	BA(true, true);
+	KUNIT_EXPECT_EQ(test, ba->ba_winsize_idx, 7);
+	params.buf_size = 30;
+	BA(true, true);
+	KUNIT_EXPECT_EQ(test, ba->ba_winsize_idx, 3);	/* 24 <= 30 < 36 */
+	params.buf_size = 2;
+	BA(true, true);
+	KUNIT_EXPECT_EQ(test, ba->ba_winsize_idx, 0);
+	BA(true, false);
+	KUNIT_EXPECT_EQ(test, ba->ba_winsize_idx, 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->ba_winsize), 0);
+#undef BA
+}
