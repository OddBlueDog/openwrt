+/* --- tx completion and cleanup -------------------------------------------- */
+
+/* A queue entry without a TXD is a raw frame (MCU, firmware download): it
+ * is just freed. One with a TXD is a completed tx frame: it gets a status.
+ */
+static void mt76_connac_test_tx_complete_skb(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_wcid *wcid = mt76_connac_test_reg_wcid(test, dev, 5);
+	struct mt76_queue_entry e = {};
+	struct mt76_txwi_cache t = {};
+	struct sk_buff *skb;
+
+	skb = mt76_connac_test_frame(test, MT76_CONNAC_TEST_QOS_DATA,
+				     mt76_connac_test_peer, 60);
+	atomic_set(&wcid->non_aql_packets, 3);
+
+	skb_get(skb);
+	e.skb = skb;
+	mt76_connac_tx_complete_skb(dev, &e);
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets), 3);
+
+	/* a tx frame of station 5: its non-AQL count goes down */
+	skb_get(skb);
+	e.txwi = &t;
+	e.wcid = 5;
+	mt76_connac_tx_complete_skb(dev, &e);
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets), 2);
+
+	/* its frame already gone (the TXD holds the token): nothing to do */
+	e.skb = NULL;
+	mt76_connac_tx_complete_skb(dev, &e);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets), 2);
+}
+
+static struct mt76_txwi_cache *
+mt76_connac_test_txwi(struct kunit *test, struct mt76_dev *dev, u16 wcid_idx,
+		      struct sk_buff *skb)
+{
+	struct mt76_txwi_cache *t;
+	__le32 *txwi;
+	u8 *buf;
+
+	buf = kunit_kzalloc(test, dev->drv->txwi_size + sizeof(*t),
+			    GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, buf);
+	t = (struct mt76_txwi_cache *)(buf + dev->drv->txwi_size);
+	txwi = (__le32 *)buf;
+	txwi[1] = cpu_to_le32(FIELD_PREP(MT_TXD1_WLAN_IDX, wcid_idx) |
+			      FIELD_PREP(MT_TXD1_TID, 0));
+	txwi[2] = cpu_to_le32(FIELD_PREP(MT_TXD2_FRAME_TYPE, 2) |
+			      FIELD_PREP(MT_TXD2_SUB_TYPE, 8));
+	t->skb = skb;
+	return t;
+}
+
+static bool mt76_connac_test_cached(struct mt76_dev *dev,
+				    struct mt76_txwi_cache *t)
+{
+	struct mt76_txwi_cache *c;
+
+	list_for_each_entry(c, &dev->txwi_cache, list)
+		if (c == t)
+			return true;
+	return false;
+}
+
+/* A device that can map DMA, like the real one */
+static void mt76_connac_test_dma(struct kunit *test, struct mt76_dev *dev)
+{
+	struct device *kdev = dev->dma_dev;
+
+	kdev->dma_mask = &kdev->coherent_dma_mask;
+	KUNIT_ASSERT_EQ(test, dma_set_mask_and_coherent(kdev,
+							DMA_BIT_MASK(32)), 0);
+}
+
+static dma_addr_t mt76_connac_test_map(struct kunit *test,
+				       struct mt76_dev *dev, int len)
+{
+	void *buf = kunit_kzalloc(test, len, GFP_KERNEL);
+	dma_addr_t addr;
+
+	KUNIT_ASSERT_NOT_NULL(test, buf);
+	addr = dma_map_single(dev->dma_dev, buf, len, DMA_TO_DEVICE);
+	KUNIT_ASSERT_FALSE(test, dma_mapping_error(dev->dma_dev, addr));
+	return addr;
+}
+
+/* Freeing a descriptor whose frame is done: the frame is completed
+ * (through the free list) for the station the TXD names, which is polled
+ * for its stats, and the descriptor goes back to the cache. Its buffers
+ * are real DMA mappings, unmapped on the way (not observable here: no
+ * DMA debugging in the VM).
+ */
+static void mt76_connac_test_txwi_free(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 7);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct mt76_connac_fw_txp *txp;
+	struct mt76_txwi_cache *t;
+	struct sk_buff *skb;
+	LIST_HEAD(free_list);
+
+	mt76_connac_test_dma(test, dev);
+	rcu_assign_pointer(dev->wcid[7], wcid);
+	atomic_set(&wcid->non_aql_packets, 1);
+	skb = alloc_skb(64, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	skb_put_zero(skb, 64);
+	memset(skb->cb, 0, sizeof(skb->cb));
+
+	t = mt76_connac_test_txwi(test, dev, 7, skb);
+	txp = (struct mt76_connac_fw_txp *)((u8 *)t - dev->drv->txwi_size +
+					    MT_TXD_SIZE);
+	txp->nbuf = 2;
+	txp->buf[0] = cpu_to_le32(mt76_connac_test_map(test, dev, 256));
+	txp->len[0] = cpu_to_le16(256);
+	txp->buf[1] = cpu_to_le32(mt76_connac_test_map(test, dev, 512));
+	txp->len[1] = cpu_to_le16(512);
+
+	mt76_connac2_txwi_free(dev, t, NULL, &free_list);
+
+	KUNIT_EXPECT_PTR_EQ(test, list_first_entry_or_null(&free_list,
+				struct sk_buff, list), skb);
+	KUNIT_EXPECT_NULL(test, t->skb);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_cached(dev, t));
+	KUNIT_EXPECT_FALSE(test, list_empty(&wcid->poll_list));
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets), 0);
+	/* the station has no HT: no BA session attempt */
+	KUNIT_EXPECT_EQ(test, wcid->ampdu_state, 0);
+
+	list_del(&t->list);
+	list_del_init(&wcid->poll_list);
+	rcu_assign_pointer(dev->wcid[7], NULL);
+	skb_list_del_init(skb);
+	kfree_skb(skb);
+}
+
+/* With the station given, its entry is used whatever the TXD says; EAPOL
+ * frames never start a BA session.
+ */
+static void mt76_connac_test_txwi_free_sta(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 8);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct mt76_txwi_cache *t;
+	struct sk_buff *skb;
+	LIST_HEAD(free_list);
+
+	rcu_assign_pointer(dev->wcid[8], wcid);
+	atomic_set(&wcid->non_aql_packets, 2);
+	sta->deflink.ht_cap.ht_supported = true;
+	skb = alloc_skb(64, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	skb_put_zero(skb, 64);
+	memset(skb->cb, 0, sizeof(skb->cb));
+	skb->protocol = cpu_to_be16(ETH_P_PAE);
+
+	/* the TXD names another (unregistered) entry */
+	t = mt76_connac_test_txwi(test, dev, 3, skb);
+	mt76_connac2_txwi_free(dev, t, sta, &free_list);
+
+	KUNIT_EXPECT_PTR_EQ(test, list_first_entry_or_null(&free_list,
+				struct sk_buff, list), skb);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets), 1);
+	KUNIT_EXPECT_EQ(test, wcid->ampdu_state, 0);
+	/* the caller knows the station: it's not queued for polling */
+	KUNIT_EXPECT_TRUE(test, list_empty(&wcid->poll_list));
+
+	/* no frame (already reported): only the descriptor goes back */
+	list_del(&t->list);
+	mt76_connac2_txwi_free(dev, t, sta, &free_list);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_cached(dev, t));
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets), 1);
+
+	list_del(&t->list);
+	rcu_assign_pointer(dev->wcid[8], NULL);
+	skb_list_del_init(skb);
+	kfree_skb(skb);
+}
+
+/* connac2 chips use the hardware TXP: buffer pairs up to the one marked
+ * last.
+ */
+static void mt76_connac_test_txwi_free_hw_txp(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_connac_hw_txp *txp;
+	struct mt76_txwi_cache *t;
+
+	dev->rev = MT76_CONNAC_TEST_C2_REV;
+	mt76_connac_test_dma(test, dev);
+	t = mt76_connac_test_txwi(test, dev, 0, NULL);
+	txp = (struct mt76_connac_hw_txp *)((u8 *)t - dev->drv->txwi_size +
+					    MT_TXD_SIZE);
+	txp->ptr[0].buf0 = cpu_to_le32(mt76_connac_test_map(test, dev, 128));
+	txp->ptr[0].len0 = cpu_to_le16(128);
+	txp->ptr[0].buf1 = cpu_to_le32(mt76_connac_test_map(test, dev, 256));
+	txp->ptr[0].len1 = cpu_to_le16(256 | MT_TXD_LEN_LAST);
+
+	mt76_connac2_txwi_free(dev, t, NULL, NULL);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_cached(dev, t));
+	list_del(&t->list);
+
+	/* ending on the first buffer of the second pair */
+	t = mt76_connac_test_txwi(test, dev, 0, NULL);
+	txp = (struct mt76_connac_hw_txp *)((u8 *)t - dev->drv->txwi_size +
+					    MT_TXD_SIZE);
+	txp->ptr[0].buf0 = cpu_to_le32(mt76_connac_test_map(test, dev, 128));
+	txp->ptr[0].len0 = cpu_to_le16(128);
+	txp->ptr[0].buf1 = cpu_to_le32(mt76_connac_test_map(test, dev, 128));
+	txp->ptr[0].len1 = cpu_to_le16(128);
+	txp->ptr[1].buf0 = cpu_to_le32(mt76_connac_test_map(test, dev, 128));
+	txp->ptr[1].len0 = cpu_to_le16(128 | MT_TXD_LEN_LAST);
+	mt76_connac2_txwi_free(dev, t, NULL, NULL);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_cached(dev, t));
+	list_del(&t->list);
+
+	/* MT7622 marks the last MSDU instead */
+	dev->rev = 0x76220000;
+	t = mt76_connac_test_txwi(test, dev, 0, NULL);
+	txp = (struct mt76_connac_hw_txp *)((u8 *)t - dev->drv->txwi_size +
+					    MT_TXD_SIZE);
+	txp->ptr[0].buf0 = cpu_to_le32(mt76_connac_test_map(test, dev, 128));
+	txp->ptr[0].len0 = cpu_to_le16(128 | MT_TXD_LEN_MSDU_LAST);
+	mt76_connac2_txwi_free(dev, t, NULL, NULL);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_cached(dev, t));
+	list_del(&t->list);
+}
+
+/* Giving back all tokens (on reset) completes every pending frame, empties
+ * the token table and clears the pending management frame counts.
+ */
+static void mt76_connac_test_token_put(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_txwi_cache *t[2];
+	struct sk_buff *skb[2];
+	struct mt76_phy *phy1;
+	int i;
+
+	phy1 = mt76_connac_test_band1(test, dev, &mt76_connac_test_chan_2g);
+	atomic_set(&dev->phy.mgmt_tx_pending, 2);
+	atomic_set(&phy1->mgmt_tx_pending, 1);
+	for (i = 0; i < 2; i++) {
+		skb[i] = mt76_connac_test_frame(test,
+						MT76_CONNAC_TEST_QOS_DATA,
+						mt76_connac_test_peer, 40);
+		skb_get(skb[i]);
+		t[i] = mt76_connac_test_txwi(test, dev, 0, skb[i]);
+		KUNIT_ASSERT_GE(test, idr_alloc(&dev->token, t[i], 0, 64,
+						GFP_KERNEL), 0);
+	}
+	dev->token_count = 2;
+
+	mt76_connac2_tx_token_put(dev);
+
+	KUNIT_EXPECT_EQ(test, dev->token_count, 0);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&dev->token));
+	for (i = 0; i < 2; i++) {
+		KUNIT_EXPECT_EQ(test, refcount_read(&skb[i]->users), 1);
+		KUNIT_EXPECT_TRUE(test, mt76_connac_test_cached(dev, t[i]));
+		list_del(&t[i]->list);
+	}
+	KUNIT_EXPECT_EQ(test, atomic_read(&dev->phy.mgmt_tx_pending), 0);
+	KUNIT_EXPECT_EQ(test, atomic_read(&phy1->mgmt_tx_pending), 0);
+}
