+/* Group-addressed robust management frames protected with BIP: the
+ * hardware adds the MIC, so the frame itself isn't marked protected.
+ */
+static void mt76_connac_test_txwi_bip(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct ieee80211_key_conf cmac = {
+		.cipher = WLAN_CIPHER_SUITE_AES_CMAC,
+	};
+	struct ieee80211_key_conf ccmp = { .cipher = WLAN_CIPHER_SUITE_CCMP };
+	struct sk_buff *skb;
+	__le32 txwi[16];
+
+	skb = mt76_connac_test_frame(test, IEEE80211_FTYPE_MGMT |
+				     IEEE80211_STYPE_DEAUTH,
+				     mt76_connac_test_bcast, 26);
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, &cmac,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_dw(txwi, 2) & MT_TXD2_BIP);
+	KUNIT_EXPECT_FALSE(test, mt76_connac_test_dw(txwi, 3) &
+			   MT_TXD3_PROTECT_FRAME);
+
+	/* another cipher: protected as usual */
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, &ccmp,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_FALSE(test, mt76_connac_test_dw(txwi, 2) & MT_TXD2_BIP);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_dw(txwi, 3) &
+			  MT_TXD3_PROTECT_FRAME);
+
+	/* unicast deauth: no BIP */
+	skb = mt76_connac_test_frame(test, IEEE80211_FTYPE_MGMT |
+				     IEEE80211_STYPE_DEAUTH,
+				     mt76_connac_test_peer, 26);
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, &cmac,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_FALSE(test, mt76_connac_test_dw(txwi, 2) & MT_TXD2_BIP);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_dw(txwi, 3) &
+			  MT_TXD3_PROTECT_FRAME);
+}
+
+/* ADDBA requests and BARs are sent on the TID they're about, and an ADDBA
+ * request tells the hardware a BA session is starting.
+ */
+static void mt76_connac_test_txwi_ba(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct ieee80211_mgmt *mgmt;
+	struct ieee80211_bar *bar;
+	struct sk_buff *skb;
+	__le32 txwi[16];
+	int len;
+
+	len = offsetofend(struct ieee80211_mgmt, u.action.u.addba_req.capab);
+	skb = mt76_connac_test_frame(test, IEEE80211_FTYPE_MGMT |
+				     IEEE80211_STYPE_ACTION,
+				     mt76_connac_test_peer, len);
+	mgmt = (struct ieee80211_mgmt *)skb->data;
+	mgmt->u.action.category = WLAN_CATEGORY_BACK;
+	mgmt->u.action.u.addba_req.action_code = WLAN_ACTION_ADDBA_REQ;
+	mgmt->u.action.u.addba_req.capab = cpu_to_le16(6 << 2 | BIT(1));
+	skb->priority = 1;
+
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_dw(txwi, 5) &
+			  MT_TXD5_ADD_BA);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_TID,
+					mt76_connac_test_dw(txwi, 1)), 6);
+
+	/* an ADDBA response is just an action frame */
+	mgmt->u.action.u.addba_req.action_code = WLAN_ACTION_ADDBA_RESP;
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_FALSE(test, mt76_connac_test_dw(txwi, 5) &
+			   MT_TXD5_ADD_BA);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_TID,
+					mt76_connac_test_dw(txwi, 1)), 1);
+
+	/* too short to hold the capabilities */
+	mgmt->u.action.u.addba_req.action_code = WLAN_ACTION_ADDBA_REQ;
+	skb_trim(skb, len - 1);
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_FALSE(test, mt76_connac_test_dw(txwi, 5) &
+			   MT_TXD5_ADD_BA);
+
+	skb = mt76_connac_test_frame(test, IEEE80211_FTYPE_CTL |
+				     IEEE80211_STYPE_BACK_REQ,
+				     mt76_connac_test_peer, sizeof(*bar));
+	bar = (struct ieee80211_bar *)skb->data;
+	bar->control = cpu_to_le16(FIELD_PREP(IEEE80211_BAR_CTRL_TID_INFO_MASK,
+					      3));
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_TID,
+					mt76_connac_test_dw(txwi, 1)), 3);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD2_FRAME_TYPE,
+					mt76_connac_test_dw(txwi, 2)), 1);
+}
+
+static u32 mt76_connac_test_frag(struct kunit *test, struct mt76_dev *dev,
+				 struct mt76_wcid *wcid, bool more, u16 frag)
+{
+	struct ieee80211_hdr *hdr;
+	struct sk_buff *skb;
+	__le32 txwi[16];
+
+	skb = mt76_connac_test_frame(test, MT76_CONNAC_TEST_QOS_DATA |
+				     (more ? IEEE80211_FCTL_MOREFRAGS : 0),
+				     mt76_connac_test_peer, 60);
+	hdr = (struct ieee80211_hdr *)skb->data;
+	hdr->seq_ctrl = cpu_to_le16(0x120 | frag);
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	return FIELD_GET(MT_TXD2_FRAG, mt76_connac_test_dw(txwi, 2));
+}
+
+/* Fragments are marked first, middle or last; whole frames are neither. */
+static void mt76_connac_test_txwi_frag(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_wcid *wcid;
+
+	wcid = mt76_connac_test_wcid(mt76_connac_test_sta(test, 1));
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_frag(test, dev, wcid, false, 0),
+			MT_TX_FRAG_NONE);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_frag(test, dev, wcid, true, 0),
+			MT_TX_FRAG_FIRST);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_frag(test, dev, wcid, true, 1),
+			MT_TX_FRAG_MID);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_frag(test, dev, wcid, false, 2),
+			MT_TX_FRAG_LAST);
+}
+
+/* Injected frames keep their own sequence number (a BAR's is its start
+ * sequence) and aren't aggregated into A-MSDUs.
+ */
+static void mt76_connac_test_txwi_injected(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct ieee80211_hdr *hdr;
+	struct ieee80211_bar *bar;
+	struct sk_buff *skb;
+	__le32 txwi[16];
+	u32 dw;
+
+	wcid->amsdu = 1;
+	skb = mt76_connac_test_frame(test, MT76_CONNAC_TEST_QOS_DATA,
+				     mt76_connac_test_peer, 60);
+	hdr = (struct ieee80211_hdr *)skb->data;
+	hdr->seq_ctrl = cpu_to_le16(IEEE80211_SN_TO_SEQ(0x345));
+	IEEE80211_SKB_CB(skb)->flags = IEEE80211_TX_CTL_INJECTED;
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	dw = mt76_connac_test_dw(txwi, 3);
+	KUNIT_EXPECT_TRUE(test, dw & MT_TXD3_SN_VALID);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD3_SEQ, dw), 0x345);
+	KUNIT_EXPECT_FALSE(test, mt76_connac_test_dw(txwi, 7) &
+			   MT_TXD7_HW_AMSDU);
+
+	skb = mt76_connac_test_frame(test, IEEE80211_FTYPE_CTL |
+				     IEEE80211_STYPE_BACK_REQ,
+				     mt76_connac_test_peer, sizeof(*bar));
+	bar = (struct ieee80211_bar *)skb->data;
+	bar->start_seq_num = cpu_to_le16(IEEE80211_SN_TO_SEQ(0x678));
+	IEEE80211_SKB_CB(skb)->flags = IEEE80211_TX_CTL_INJECTED;
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD3_SEQ,
+					mt76_connac_test_dw(txwi, 3)), 0x678);
+}
+
+/* A frame the stack already encapsulated as 802.3: the hardware builds
+ * the 802.11 header, so the TXD says QoS data for WMM stations, plain data
+ * otherwise, and whether there's an Ethernet type.
+ */
+static void mt76_connac_test_txwi_8023(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 0x44);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct ieee80211_tx_info *info;
+	struct ethhdr *eth;
+	struct sk_buff *skb;
+	__le32 txwi[16];
+	u32 dw;
+
+	skb = mt76_connac_test_frame(test, 0, NULL, 80);
+	eth = (struct ethhdr *)skb->data;
+	eth->h_proto = htons(ETH_P_IP);
+	skb->priority = 6;
+	skb_set_queue_mapping(skb, IEEE80211_AC_VO);
+	info = IEEE80211_SKB_CB(skb);
+	info->flags = IEEE80211_TX_CTL_HW_80211_ENCAP;
+	wcid->amsdu = 1;
+
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_SKB, MT_TXQ_VO, 0);
+	dw = mt76_connac_test_dw(txwi, 1);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_HDR_FORMAT, dw),
+			MT_HDR_FORMAT_802_3);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_TID, dw), 6);
+	KUNIT_EXPECT_TRUE(test, dw & MT_TXD1_ETH_802_3);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_WLAN_IDX, dw), 0x44);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 2),
+			FIELD_PREP(MT_TXD2_FRAME_TYPE, 2) |
+			FIELD_PREP(MT_TXD2_SUB_TYPE, 8));
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 7),
+			MT_TXD7_HW_AMSDU | FIELD_PREP(MT_TXD7_TYPE, 2) |
+			FIELD_PREP(MT_TXD7_SUB_TYPE, 8));
+	/* no fixed rate for 802.3 frames */
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 6), 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_Q_IDX,
+					mt76_connac_test_dw(txwi, 0)), 3);
+
+	/* a non-WMM station, and an 802.3 length instead of a type */
+	sta->wme = false;
+	eth->h_proto = htons(80);
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_SKB, MT_TXQ_VO, 0);
+	KUNIT_EXPECT_FALSE(test, mt76_connac_test_dw(txwi, 1) &
+			   MT_TXD1_ETH_802_3);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 2),
+			FIELD_PREP(MT_TXD2_FRAME_TYPE, 2));
+
+	/* no station at all: plain data */
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+	sta->wme = true;
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_SKB, MT_TXQ_VO, 0);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 2),
+			FIELD_PREP(MT_TXD2_FRAME_TYPE, 2));
+}
+
+/* On SDIO and USB the TXD is longer, frames go store-and-forward, and the
+ * frame type goes in dword 8.
+ */
+static void mt76_connac_test_txwi_sdio(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct mt76_bus_ops *bus;
+	struct sk_buff *skb;
+	__le32 txwi[16];
+
+	bus = kunit_kmalloc(test, sizeof(*bus), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, bus);
+	*bus = mt76_test_bus_ops;
+	bus->type = MT76_BUS_SDIO;
+	dev->bus = bus;
+	dev->rev = MT76_CONNAC_TEST_C2_REV;
+
+	skb = mt76_connac_test_frame(test, MT76_CONNAC_TEST_QOS_DATA,
+				     mt76_connac_test_peer, 50);
+	memset(txwi, 0, sizeof(txwi));
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_SKB, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_TX_BYTES,
+					mt76_connac_test_dw(txwi, 0)),
+			50 + MT_SDIO_TXD_SIZE);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_PKT_FMT,
+					mt76_connac_test_dw(txwi, 0)),
+			MT_TX_TYPE_SF);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 8),
+			FIELD_PREP(MT_TXD8_L_TYPE, 2) |
+			FIELD_PREP(MT_TXD8_L_SUB_TYPE, 8));
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 7), 0);
+	/* connac2 has neither VTA nor software power management here */
+	KUNIT_EXPECT_FALSE(test, mt76_connac_test_dw(txwi, 1) & MT_TXD1_VTA);
+	KUNIT_EXPECT_FALSE(test, mt76_connac_test_dw(txwi, 3) &
+			   MT_TXD3_SW_POWER_MGMT);
+
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_SKB, MT_TXQ_PSD, 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_PKT_FMT,
+					mt76_connac_test_dw(txwi, 0)),
+			MT_TX_TYPE_SF);
+}
+
+/* --- tx status ------------------------------------------------------------ */
+
+static __le32 mt76_connac_test_txs(u8 mode, u8 mcs, u8 nss, u8 bw, u32 extra)
+{
+	u32 txrate = FIELD_PREP(MT_TX_RATE_MODE, mode) |
+		     FIELD_PREP(MT_TX_RATE_IDX, mcs) |
+		     FIELD_PREP(MT_TX_RATE_NSS, nss - 1);
+
+	return cpu_to_le32(FIELD_PREP(MT_TXS0_TX_RATE, txrate) |
+			   FIELD_PREP(MT_TXS0_BW, bw) | extra);
+}
+
+/* Legacy rates are reported in the band's own terms: CCK on 2.4 GHz
+ * (short preamble or not), OFDM on 5 and 6 GHz, band 1 for band 1's
+ * stations.
+ */
+static void mt76_connac_test_txs_legacy(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_wcid *wcid;
+	__le32 txs[8] = {};
+
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+
+	/* 5 GHz, 54 Mbps (hw rate 12) */
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_OFDM, 12, 1, 0, 0);
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.legacy, 540);
+	KUNIT_EXPECT_EQ(test, wcid->rate.mcs, 7);
+	KUNIT_EXPECT_EQ(test, wcid->rate.flags, 0);
+	KUNIT_EXPECT_EQ(test, wcid->rate.bw, RATE_INFO_BW_20);
+	KUNIT_EXPECT_EQ(test, wcid->stats.tx_mode[MT_PHY_TYPE_OFDM], 1);
+	KUNIT_EXPECT_EQ(test, wcid->stats.tx_bw[0], 1);
+	KUNIT_EXPECT_EQ(test, wcid->stats.tx_nss[0], 1);
+
+	/* 6 GHz, 6 Mbps */
+	dev->phy.chandef.chan = &mt76_connac_test_chan_6g;
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_OFDM, 11, 1, 0, 0);
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.legacy, 60);
+
+	/* 2.4 GHz: 11 Mbps CCK, long and short preamble */
+	dev->phy.chandef.chan = &mt76_connac_test_chan_2g;
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_CCK, 3, 1, 0, 0);
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.legacy, 110);
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_CCK, 3 | BIT(2), 1, 0, 0);
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.legacy, 110);
+	KUNIT_EXPECT_EQ(test, wcid->stats.tx_mode[MT_PHY_TYPE_CCK], 2);
+	/* and OFDM there skips the CCK rates: 6 Mbps */
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_OFDM, 11, 1, 0, 0);
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.legacy, 60);
+
+	/* band 1's station: band 1's channel (5 GHz), 48 Mbps */
+	mt76_connac_test_band1(test, dev, &mt76_connac_test_chan_5g);
+	wcid->phy_idx = MT_BAND1;
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_OFDM, 8, 1, 0, 0);
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.legacy, 480);
+}
+
+/* HT, VHT and HE rates with the flags the reported rate needs; MCSs the
+ * mode can't have and unknown modes are rejected without touching the
+ * rate.
+ */
+static void mt76_connac_test_txs_modes(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_wcid *wcid;
+	__le32 txs[8] = {};
+
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+
+	/* HT MCS 15 at 40 MHz, short GI known from the station's rate */
+	wcid->rate.flags = RATE_INFO_FLAGS_SHORT_GI;
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_HT, 15, 1,
+				      IEEE80211_STA_RX_BW_40, 0);
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.flags,
+			RATE_INFO_FLAGS_MCS | RATE_INFO_FLAGS_SHORT_GI);
+	KUNIT_EXPECT_EQ(test, wcid->rate.mcs, 15);
+	KUNIT_EXPECT_EQ(test, wcid->rate.bw, RATE_INFO_BW_40);
+	KUNIT_EXPECT_EQ(test, wcid->stats.tx_bw[1], 1);
+	/* without it, a long GI */
+	wcid->rate.flags = 0;
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_HT_GF, 7, 1, 0, 0);
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.flags, RATE_INFO_FLAGS_MCS);
+	KUNIT_EXPECT_EQ(test, wcid->stats.tx_mode[MT_PHY_TYPE_HT_GF], 1);
+	KUNIT_EXPECT_FALSE(test, mt76_connac2_mac_fill_txs(dev, wcid,
+		(__le32[8]){ mt76_connac_test_txs(MT_PHY_TYPE_HT, 32, 1, 0,
+						  0) }));
+
+	/* VHT MCS 9, 3 streams, 160 MHz */
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_VHT, 9, 3,
+				      IEEE80211_STA_RX_BW_160, 0);
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.flags, RATE_INFO_FLAGS_VHT_MCS);
+	KUNIT_EXPECT_EQ(test, wcid->rate.nss, 3);
+	KUNIT_EXPECT_EQ(test, wcid->rate.bw, RATE_INFO_BW_160);
+	KUNIT_EXPECT_EQ(test, wcid->stats.tx_bw[3], 1);
+	KUNIT_EXPECT_EQ(test, wcid->stats.tx_nss[2], 1);
+	KUNIT_EXPECT_FALSE(test, mt76_connac2_mac_fill_txs(dev, wcid,
+		(__le32[8]){ mt76_connac_test_txs(MT_PHY_TYPE_VHT, 10, 1, 0,
+						  0) }));
+
+	/* HE: the GI comes from the station (the status has none) */
+	wcid->rate.he_gi = NL80211_RATE_INFO_HE_GI_1_6;
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_HE_MU, 3, 1,
+				      IEEE80211_STA_RX_BW_20, 0);
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.flags, RATE_INFO_FLAGS_HE_MCS);
+	KUNIT_EXPECT_EQ(test, wcid->rate.mcs, 3);
+	KUNIT_EXPECT_EQ(test, wcid->rate.he_dcm, 0);
+	KUNIT_EXPECT_EQ(test, wcid->rate.he_gi, NL80211_RATE_INFO_HE_GI_1_6);
+	KUNIT_EXPECT_EQ(test, wcid->stats.tx_mode[MT_PHY_TYPE_HE_MU], 1);
+	KUNIT_EXPECT_FALSE(test, mt76_connac2_mac_fill_txs(dev, wcid,
+		(__le32[8]){ mt76_connac_test_txs(MT_PHY_TYPE_HE_SU, 12, 1, 0,
+						  0) }));
+
+	/* modes outside the table, e.g. EHT */
+	KUNIT_EXPECT_FALSE(test, mt76_connac2_mac_fill_txs(dev, wcid,
+		(__le32[8]){ mt76_connac_test_txs(MT_PHY_TYPE_EHT_SU, 1, 1, 0,
+						  0) }));
+	KUNIT_EXPECT_FALSE(test, mt76_connac2_mac_fill_txs(dev, wcid,
+		(__le32[8]){ mt76_connac_test_txs(5, 1, 1, 0, 0) }));
+	/* the rejected ones didn't change the rate */
+	KUNIT_EXPECT_EQ(test, wcid->rate.flags, RATE_INFO_FLAGS_HE_MCS);
+	KUNIT_EXPECT_EQ(test, wcid->rate.mcs, 3);
+}
+
+/* An HE frame sent with DCM: MCS 3, DCM on. MT_TX_RATE_IDX includes the
+ * DCM bit (bit 4), so the MCS reads as 19, the status is rejected as an
+ * invalid HE MCS, and rate.he_dcm can never be set.
+ */
+static void mt76_connac_test_txs_he_dcm(struct kunit *test)
+{
+	struct mt76_dev *dev;
+	struct mt76_wcid *wcid;
+	__le32 txs[8] = {};
+
+	kunit_skip(test, "driver bug: HE txs with DCM rejected, MCS includes the DCM bit");
+
+	dev = mt76_connac_test_dev(test);
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_HE_SU, 3 | MT_TX_RATE_DCM,
+				      1, IEEE80211_STA_RX_BW_20, 0);
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.mcs, 3);
+	KUNIT_EXPECT_EQ(test, wcid->rate.he_dcm, 1);
+}
