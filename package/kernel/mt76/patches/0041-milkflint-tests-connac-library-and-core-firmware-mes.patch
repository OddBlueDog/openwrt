+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_start_patch(dev), 0);
+	req = mt76_connac_mcu_test_req(test, MCU_CMD(PATCH_FINISH_REQ), 4);
+	KUNIT_EXPECT_EQ(test, req[0], 0);
+
+	mt76_test_fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_start_patch(dev), -EIO);
+}
