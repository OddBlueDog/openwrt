+/* --- rx rate -------------------------------------------------------------- */
+
+/* P-RXV dword 0 as the MT7986 reports it */
+static __le32 mt76_connac_test_prxv(u8 mode, u8 rate, u8 nsts, u8 bw, u8 gi,
+				    u8 stbc, bool dcm)
+{
+	return cpu_to_le32(FIELD_PREP(MT_PRXV_TX_MODE, mode) |
+			   FIELD_PREP(MT_PRXV_TX_RATE, rate) |
+			   FIELD_PREP(MT_PRXV_NSTS, nsts - 1) |
+			   FIELD_PREP(MT_PRXV_FRAME_MODE, bw) |
+			   FIELD_PREP(MT_PRXV_HT_SGI, gi) |
+			   FIELD_PREP(MT_PRXV_HT_STBC, stbc) |
+			   (dcm ? MT_PRXV_DCM : 0));
+}
