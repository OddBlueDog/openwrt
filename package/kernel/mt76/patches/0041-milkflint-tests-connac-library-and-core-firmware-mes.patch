+/* HT/VHT WTBL entries: LDPC only when both we and the peer do it, the
+ * A-MPDU factor (the larger of HT's and VHT's) and density.
+ */
+static void mt76_connac_mcu_test_wtbl_ht(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 1);
+	struct ieee80211_link_sta *link = &sta->deflink;
+	struct wtbl_vht *vht;
+	struct wtbl_ht *ht;
+	struct sk_buff *skb;
+	struct tlv *sta_wtbl;
+	void *wtbl_hdr;
+
+	/* legacy peer: only SMPS */
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_ht_tlv(dev, skb, sta, sta_wtbl, wtbl_hdr, true,
+				    true);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_ntlv(wtbl_hdr), 1);
+	KUNIT_EXPECT_NOT_NULL(test, mt76_connac_mcu_test_wtbl_tlv(test,
+			      sta_wtbl, WTBL_SMPS));
+
+	link->ht_cap.ht_supported = true;
+	link->ht_cap.cap = IEEE80211_HT_CAP_LDPC_CODING;
+	link->ht_cap.ampdu_factor = IEEE80211_HT_MAX_AMPDU_32K;
+	link->ht_cap.ampdu_density = IEEE80211_HT_MPDU_DENSITY_4;
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_ht_tlv(dev, skb, sta, sta_wtbl, wtbl_hdr, true,
+				    true);
+	ht = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_HT);
+	KUNIT_ASSERT_NOT_NULL(test, ht);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ht->len), sizeof(*ht));
+	KUNIT_EXPECT_EQ(test, ht->ht, 1);
+	KUNIT_EXPECT_EQ(test, ht->ldpc, 1);
+	KUNIT_EXPECT_EQ(test, ht->af, IEEE80211_HT_MAX_AMPDU_32K);
+	KUNIT_EXPECT_EQ(test, ht->mm, IEEE80211_HT_MPDU_DENSITY_4);
+	KUNIT_EXPECT_NULL(test, mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl,
+							      WTBL_VHT));
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_ntlv(wtbl_hdr), 2);
+
+	/* we don't do LDPC: off whatever the peer says */
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_ht_tlv(dev, skb, sta, sta_wtbl, wtbl_hdr, false,
+				    false);
+	ht = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_HT);
+	KUNIT_ASSERT_NOT_NULL(test, ht);
+	KUNIT_EXPECT_EQ(test, ht->ldpc, 0);
+
+	/* VHT with a larger A-MPDU exponent raises HT's */
+	link->ht_cap.cap = 0;
+	link->vht_cap.vht_supported = true;
+	link->vht_cap.cap = IEEE80211_VHT_CAP_RXLDPC |
+		FIELD_PREP(IEEE80211_VHT_CAP_MAX_A_MPDU_LENGTH_EXPONENT_MASK,
+			   7);
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_ht_tlv(dev, skb, sta, sta_wtbl, wtbl_hdr, true,
+				    true);
+	ht = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_HT);
+	vht = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_VHT);
+	KUNIT_ASSERT_NOT_NULL(test, ht);
+	KUNIT_ASSERT_NOT_NULL(test, vht);
+	KUNIT_EXPECT_EQ(test, ht->ldpc, 0);
+	KUNIT_EXPECT_EQ(test, ht->af, 7);
+	KUNIT_EXPECT_EQ(test, vht->vht, 1);
+	KUNIT_EXPECT_EQ(test, vht->ldpc, 1);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_ntlv(wtbl_hdr), 3);
+
+	/* a smaller VHT exponent doesn't lower it */
+	link->vht_cap.cap = FIELD_PREP(
+		IEEE80211_VHT_CAP_MAX_A_MPDU_LENGTH_EXPONENT_MASK, 1);
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_ht_tlv(dev, skb, sta, sta_wtbl, wtbl_hdr, true,
+				    false);
+	ht = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_HT);
+	vht = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_VHT);
+	KUNIT_ASSERT_NOT_NULL(test, ht);
+	KUNIT_ASSERT_NOT_NULL(test, vht);
+	KUNIT_EXPECT_EQ(test, ht->af, IEEE80211_HT_MAX_AMPDU_32K);
+	KUNIT_EXPECT_EQ(test, vht->ldpc, 0);
+}
+
+/* A 6 GHz peer has no HT capabilities: the A-MPDU parameters come from
+ * its HE 6 GHz capabilities, and it gets HT and VHT entries.
+ */
+static void mt76_connac_mcu_test_wtbl_ht_6g(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 1);
+	struct wtbl_vht *vht;
+	struct wtbl_ht *ht;
+	struct sk_buff *skb;
+	struct tlv *sta_wtbl;
+	void *wtbl_hdr;
+
+	sta->deflink.he_6ghz_capa.capa = cpu_to_le16(
+		FIELD_PREP(IEEE80211_HE_6GHZ_CAP_MAX_AMPDU_LEN_EXP, 5) |
+		FIELD_PREP(IEEE80211_HE_6GHZ_CAP_MIN_MPDU_START, 6));
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_ht_tlv(dev, skb, sta, sta_wtbl, wtbl_hdr, true,
+				    true);
+	ht = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_HT);
+	vht = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_VHT);
+	KUNIT_ASSERT_NOT_NULL(test, ht);
+	KUNIT_ASSERT_NOT_NULL(test, vht);
+	KUNIT_EXPECT_EQ(test, ht->af, 5);
+	KUNIT_EXPECT_EQ(test, ht->mm, 6);
+	KUNIT_EXPECT_EQ(test, ht->ht, 1);
+	KUNIT_EXPECT_EQ(test, vht->vht, 1);
+}
