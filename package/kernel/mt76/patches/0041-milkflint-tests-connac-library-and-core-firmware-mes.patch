+/* --- keys ---------------------------------------------------------------- */
+
+static struct ieee80211_key_conf *
+mt76_connac_mcu_test_key(struct kunit *test, u32 cipher, u8 idx, u8 len)
+{
+	struct ieee80211_key_conf *key;
+	int i;
+
+	key = kunit_kzalloc(test, sizeof(*key) + 32, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, key);
+	key->cipher = cipher;
+	key->keyidx = idx;
+	key->keylen = len;
+	for (i = 0; i < len; i++)
+		key->key[i] = 0x40 + i;
+	return key;
+}
+
+static struct sta_rec_sec *
+mt76_connac_mcu_test_add_key(struct kunit *test, struct mt76_dev *dev,
+			     struct mt76_connac_sta_key_conf *conf,
+			     struct ieee80211_key_conf *key,
+			     enum set_key_cmd cmd)
+{
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 0x21);
+	struct ieee80211_vif *vif;
+	struct mt76_test_msg *msg;
+	struct sta_rec_sec *sec;
+	int hdr = sizeof(struct sta_req_hdr);
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 0);
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_add_key(dev, vif, conf, key,
+			MCU_EXT_CMD(STA_REC_UPDATE),
+			mt76_connac_mcu_test_wcid(sta), cmd), 0);
+	msg = mt76_test_find_msg(mt76_test_fake, MCU_EXT_CMD(STA_REC_UPDATE));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	/* the whole TLV is sent, its length says how much is used */
+	KUNIT_ASSERT_EQ(test, msg->len, hdr + sizeof(*sec));
+	KUNIT_EXPECT_EQ(test, ((struct sta_req_hdr *)msg->data)->wlan_idx_lo,
+			0x21);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_ntlv(msg->data), 1);
+	sec = (struct sta_rec_sec *)(msg->data + hdr);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(sec->tag), STA_REC_KEY_V2);
+	KUNIT_EXPECT_EQ(test, sec->add, cmd);
+	return sec;
+}
+
+/* A pairwise CCMP key: one cipher entry with the key, and the key is kept
+ * for the BIP batch update that follows.
+ */
+static void mt76_connac_mcu_test_add_key_ccmp(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct mt76_connac_sta_key_conf conf = {};
+	struct ieee80211_key_conf *key;
+	struct sta_rec_sec *sec;
+
+	key = mt76_connac_mcu_test_key(test, WLAN_CIPHER_SUITE_CCMP, 1, 16);
+	sec = mt76_connac_mcu_test_add_key(test, dev, &conf, key, SET_KEY);
+	KUNIT_EXPECT_EQ(test, sec->n_cipher, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(sec->len),
+			sizeof(*sec) - sizeof(struct sec_key));
+	KUNIT_EXPECT_EQ(test, sec->key[0].cipher_id, MCU_CIPHER_AES_CCMP);
+	KUNIT_EXPECT_EQ(test, sec->key[0].cipher_len, sizeof(struct sec_key));
+	KUNIT_EXPECT_EQ(test, sec->key[0].key_id, 1);
+	KUNIT_EXPECT_EQ(test, sec->key[0].key_len, 16);
+	KUNIT_EXPECT_MEMEQ(test, sec->key[0].key, key->key, 16);
+	KUNIT_EXPECT_MEMEQ(test, conf.key, key->key, 16);
+	KUNIT_EXPECT_EQ(test, conf.keyidx, 1);
+}
+
+/* TKIP: the firmware wants the rx and tx MIC keys the other way round. */
+static void mt76_connac_mcu_test_add_key_tkip(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct mt76_connac_sta_key_conf conf = {};
+	struct ieee80211_key_conf *key;
+	struct sta_rec_sec *sec;
+
+	key = mt76_connac_mcu_test_key(test, WLAN_CIPHER_SUITE_TKIP, 0, 32);
+	sec = mt76_connac_mcu_test_add_key(test, dev, &conf, key, SET_KEY);
+	KUNIT_EXPECT_EQ(test, sec->key[0].cipher_id, MCU_CIPHER_TKIP);
+	KUNIT_EXPECT_EQ(test, sec->key[0].key_len, 32);
+	KUNIT_EXPECT_MEMEQ(test, sec->key[0].key, key->key, 16);
+	KUNIT_EXPECT_MEMEQ(test, sec->key[0].key + 16, key->key + 24, 8);
+	KUNIT_EXPECT_MEMEQ(test, sec->key[0].key + 24, key->key + 16, 8);
+	/* only CCMP keys are kept */
+	KUNIT_EXPECT_EQ(test, conf.keyidx, 0);
+	KUNIT_EXPECT_EQ(test, conf.key[0], 0);
+}
+
+/* BIP-CMAC goes with the stored CCMP key: two cipher entries. */
+static void mt76_connac_mcu_test_add_key_bip(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct mt76_connac_sta_key_conf conf = { .keyidx = 2 };
+	struct ieee80211_key_conf *key;
+	struct sta_rec_sec *sec;
+
+	memset(conf.key, 0x77, sizeof(conf.key));
+	key = mt76_connac_mcu_test_key(test, WLAN_CIPHER_SUITE_AES_CMAC, 4,
+				       16);
+	sec = mt76_connac_mcu_test_add_key(test, dev, &conf, key, SET_KEY);
+	KUNIT_EXPECT_EQ(test, sec->n_cipher, 2);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(sec->len), sizeof(*sec));
+	KUNIT_EXPECT_EQ(test, sec->key[0].cipher_id, MCU_CIPHER_AES_CCMP);
+	KUNIT_EXPECT_EQ(test, sec->key[0].key_id, 2);
+	KUNIT_EXPECT_EQ(test, sec->key[0].key_len, 16);
+	KUNIT_EXPECT_MEMEQ(test, sec->key[0].key, conf.key, 16);
+	KUNIT_EXPECT_EQ(test, sec->key[1].cipher_id, MCU_CIPHER_BIP_CMAC_128);
+	KUNIT_EXPECT_EQ(test, sec->key[1].cipher_len, sizeof(struct sec_key));
+	KUNIT_EXPECT_EQ(test, sec->key[1].key_len, 16);
+	KUNIT_EXPECT_MEMEQ(test, sec->key[1].key, key->key, 16);
+}
