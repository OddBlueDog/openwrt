+/* Management frames go at a fixed rate with fixed bandwidth, no BA, HTC
+ * valid, and on two antennas the duplicate spatial extension index.
+ */
+static void mt76_connac_test_txwi_mgmt(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_vif *vif = mt76_connac_test_vif(test,
+							 NL80211_IFTYPE_AP);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct ieee80211_tx_info *info;
+	struct sk_buff *skb;
+	__le32 txwi[16];
+	u32 dw;
+
+	vif->bss_conf.basic_rates = BIT(0);
+	skb = mt76_connac_test_frame(test, IEEE80211_FTYPE_MGMT |
+				     IEEE80211_STYPE_AUTH,
+				     mt76_connac_test_peer, 30);
+	info = IEEE80211_SKB_CB(skb);
+	info->control.vif = vif;
+	wcid->amsdu = 1;
+
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	dw = mt76_connac_test_dw(txwi, 2);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD2_FRAME_TYPE, dw), 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD2_SUB_TYPE, dw),
+			IEEE80211_STYPE_AUTH >> 4);
+	KUNIT_EXPECT_TRUE(test, dw & MT_TXD2_FIX_RATE);
+	KUNIT_EXPECT_TRUE(test, dw & MT_TXD2_HTC_VLD);
+	KUNIT_EXPECT_FALSE(test, dw & MT_TXD2_MULTICAST);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_dw(txwi, 3) &
+			  MT_TXD3_BA_DISABLE);
+	dw = mt76_connac_test_dw(txwi, 6);
+	KUNIT_EXPECT_EQ(test, dw, MT_TXD6_FIXED_BW |
+			FIELD_PREP(MT_TXD6_TX_RATE,
+				   mt76_connac_test_rate(MT_PHY_TYPE_OFDM,
+							 11, 0)));
+	KUNIT_EXPECT_FALSE(test, dw & MT_TXD6_SPE_ID_IDX);
+	dw = mt76_connac_test_dw(txwi, 7);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD7_SPE_IDX, dw), 24);
+	KUNIT_EXPECT_FALSE(test, dw & MT_TXD7_HW_AMSDU);
+
+	/* antenna 1 only: its own spatial extension index (1) */
+	dev->phy.antenna_mask = BIT(1);
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD7_SPE_IDX,
+					mt76_connac_test_dw(txwi, 7)), 1);
+	/* antenna 0 only: index 0 is right as it is */
+	dev->phy.antenna_mask = BIT(0);
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD7_SPE_IDX,
+					mt76_connac_test_dw(txwi, 7)), 0);
+}
