+/* No ACK, and PPDU-format statuses (WED's) don't complete frames. */
+static void mt76_connac_test_add_txs_skb_noack(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_wcid *wcid = mt76_connac_test_reg_wcid(test, dev, 13);
+	struct ieee80211_tx_info *info;
+	struct sk_buff *skb;
+	__le32 txs[8] = {};
+	int pid;
+
+	skb = mt76_connac_test_frame(test, MT76_CONNAC_TEST_QOS_DATA,
+				     mt76_connac_test_peer, 60);
+	info = IEEE80211_SKB_CB(skb);
+	info->flags = IEEE80211_TX_CTL_REQ_TX_STATUS;
+	pid = mt76_tx_status_skb_add(dev, wcid, skb);
+	KUNIT_ASSERT_GE(test, pid, MT_PACKET_ID_FIRST);
+	skb_get(skb);
+	mt76_tx_complete_skb(dev, wcid->idx, skb);
+
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_OFDM, 11, 1, 0,
+				      FIELD_PREP(MT_TXS0_TXS_FORMAT,
+						 MT_TXS_PPDU_FMT));
+	KUNIT_EXPECT_FALSE(test, mt76_connac2_mac_add_txs_skb(dev, wcid, pid,
+							      txs));
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 2);
+
+	txs[0] = mt76_connac_test_txs(MT_PHY_TYPE_OFDM, 11, 1, 0,
+				      MT_TXS0_ACK_TIMEOUT);
+	KUNIT_EXPECT_TRUE(test, mt76_connac2_mac_add_txs_skb(dev, wcid, pid,
+							     txs));
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 1);
+	KUNIT_EXPECT_FALSE(test, info->flags & IEEE80211_TX_STAT_ACK);
+	KUNIT_EXPECT_EQ(test, info->status.ampdu_ack_len, 0);
+	KUNIT_EXPECT_EQ(test, wcid->rate.legacy, 60);
+}
