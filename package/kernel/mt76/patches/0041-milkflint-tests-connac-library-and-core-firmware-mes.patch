+static struct {
+	int n, idx, n_desc;
+	u32 ring_base;
+	int ret;
+} mt76_connac_test_alloc_state;
+
+static int mt76_connac_test_alloc(struct mt76_dev *dev, struct mt76_queue *q,
+				  int idx, int n_desc, int bufsize,
+				  u32 ring_base)
+{
+	mt76_connac_test_alloc_state.n++;
+	mt76_connac_test_alloc_state.idx = idx;
+	mt76_connac_test_alloc_state.n_desc = n_desc;
+	mt76_connac_test_alloc_state.ring_base = ring_base;
+	return mt76_connac_test_alloc_state.ret;
+}
+
+static const struct mt76_queue_ops mt76_connac_test_queue_ops = {
+	.alloc = mt76_connac_test_alloc,
+};
+
+/* connac has one tx ring per band: every data AC and the PS queue share
+ * it, beacons don't.
+ */
+static void mt76_connac_test_init_tx_queues(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_phy *phy = &dev->phy;
+	int i, wed;
+
+	dev->queue_ops = &mt76_connac_test_queue_ops;
+	memset(&mt76_connac_test_alloc_state, 0,
+	       sizeof(mt76_connac_test_alloc_state));
+
+	KUNIT_ASSERT_EQ(test, mt76_connac_init_tx_queues(phy, 18, 2048,
+							 0xd4300, &wed,
+							 MT_WED_Q_TX(0)), 0);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_alloc_state.n, 1);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_alloc_state.idx, 18);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_alloc_state.n_desc, 2048);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_alloc_state.ring_base, 0xd4300);
+	KUNIT_ASSERT_NOT_NULL(test, phy->q_tx[0]);
+	KUNIT_EXPECT_PTR_EQ(test, phy->q_tx[0]->wed, (void *)&wed);
+	KUNIT_EXPECT_EQ(test, phy->q_tx[0]->flags, MT_WED_Q_TX(0));
+	for (i = 1; i <= MT_TXQ_PSD; i++)
+		KUNIT_EXPECT_PTR_EQ(test, phy->q_tx[i], phy->q_tx[0]);
+	KUNIT_EXPECT_NULL(test, phy->q_tx[MT_TXQ_BEACON]);
+
+	/* a failed ring allocation leaves the queues alone */
+	memset(phy->q_tx, 0, sizeof(phy->q_tx));
+	mt76_connac_test_alloc_state.ret = -ENOMEM;
+	KUNIT_EXPECT_EQ(test, mt76_connac_init_tx_queues(phy, 18, 2048,
+							 0xd4300, NULL, 0),
+			-ENOMEM);
+	KUNIT_EXPECT_NULL(test, phy->q_tx[0]);
+	KUNIT_EXPECT_NULL(test, phy->q_tx[MT_TXQ_PSD]);
+}
+
+/* A data frame to an HT/HE station starts a BA session on its TID once;
+ * here only the cases that don't reach mac80211 (which needs a real
+ * station): no station, no HT/HE, not QoS data, a session already on.
+ */
+static void mt76_connac_test_tx_check_aggr(struct kunit *test)
+{
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	__le32 txwi[8] = {};
+
+	txwi[1] = cpu_to_le32(FIELD_PREP(MT_TXD1_TID, 4));
+	txwi[2] = cpu_to_le32(FIELD_PREP(MT_TXD2_FRAME_TYPE, 2) |
+			      FIELD_PREP(MT_TXD2_SUB_TYPE, 8));
+
+	mt76_connac2_tx_check_aggr(NULL, txwi);
+
+	/* legacy station */
+	mt76_connac2_tx_check_aggr(sta, txwi);
+	KUNIT_EXPECT_EQ(test, wcid->ampdu_state, 0);
+
+	/* HE station, but a management / non-QoS data frame */
+	sta->deflink.he_cap.has_he = true;
+	txwi[2] = cpu_to_le32(FIELD_PREP(MT_TXD2_SUB_TYPE, 0xb));
+	mt76_connac2_tx_check_aggr(sta, txwi);
+	KUNIT_EXPECT_EQ(test, wcid->ampdu_state, 0);
+	txwi[2] = cpu_to_le32(FIELD_PREP(MT_TXD2_FRAME_TYPE, 2));
+	mt76_connac2_tx_check_aggr(sta, txwi);
+	KUNIT_EXPECT_EQ(test, wcid->ampdu_state, 0);
+
+	/* QoS data on a TID with a session (being) set up already */
+	txwi[2] = cpu_to_le32(FIELD_PREP(MT_TXD2_FRAME_TYPE, 2) |
+			      FIELD_PREP(MT_TXD2_SUB_TYPE, 8));
+	wcid->ampdu_state = BIT(4);
+	mt76_connac2_tx_check_aggr(sta, txwi);
+	KUNIT_EXPECT_EQ(test, wcid->ampdu_state, BIT(4));
+}
