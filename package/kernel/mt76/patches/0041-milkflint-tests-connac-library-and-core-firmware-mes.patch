+/* Frames for band 1 use band 1's phy (its channel and antennas) and are
+ * tagged for it.
+ */
+static void mt76_connac_test_txwi_band1(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_vif *vif = mt76_connac_test_vif(test,
+							 NL80211_IFTYPE_AP);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct ieee80211_tx_info *info;
+	struct mt76_phy *phy1;
+	struct sk_buff *skb;
+	__le32 txwi[16];
+	u32 dw;
+
+	phy1 = mt76_connac_test_band1(test, dev, &mt76_connac_test_chan_2g);
+	phy1->antenna_mask = 0xc;
+	vif->bss_conf.basic_rates = BIT(0);
+	skb = mt76_connac_test_frame(test, IEEE80211_FTYPE_MGMT |
+				     IEEE80211_STYPE_ASSOC_RESP,
+				     mt76_connac_test_peer, 30);
+	info = IEEE80211_SKB_CB(skb);
+	info->control.vif = vif;
+	info->hw_queue = FIELD_PREP(MT_TX_HW_QUEUE_PHY, MT_BAND1);
+
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_dw(txwi, 1) & MT_TXD1_TGID);
+	/* 2.4 GHz: 1 Mbps CCK */
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD6_TX_RATE,
+					mt76_connac_test_dw(txwi, 6)),
+			mt76_connac_test_rate(MT_PHY_TYPE_CCK, 0, 0));
+	/* antennas 2+3 */
+	dw = mt76_connac_test_dw(txwi, 7);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD7_SPE_IDX, dw), 16);
+
+	/* on band 0 a BSS of band 1 is tagged as well */
+	info->hw_queue = 0;
+	mt76_connac_test_mvif(vif)->band_idx = 1;
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_dw(txwi, 1) & MT_TXD1_TGID);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD6_TX_RATE,
+					mt76_connac_test_dw(txwi, 6)),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 11, 0));
+}
