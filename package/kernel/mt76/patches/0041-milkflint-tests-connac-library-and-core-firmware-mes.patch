+/* --- station TLVs --------------------------------------------------------- */
+
+static struct sta_rec_basic *
+mt76_connac_mcu_test_sta_basic(struct kunit *test, struct mt76_dev *dev,
+			       struct ieee80211_vif *vif,
+			       struct ieee80211_sta *sta, int state,
+			       bool newly)
+{
+	struct sk_buff *skb = mt76_connac_mcu_test_skb(test,
+					sizeof(struct sta_req_hdr));
+	struct sta_rec_basic *basic;
+
+	mt76_connac_mcu_sta_basic_tlv(dev, skb, &vif->bss_conf,
+				      sta ? &sta->deflink : NULL, state,
+				      newly);
+	basic = mt76_connac_mcu_test_skb_tlv(test, skb,
+					     sizeof(struct sta_req_hdr),
+					     STA_REC_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, basic);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->len), sizeof(*basic));
+	return basic;
+}
