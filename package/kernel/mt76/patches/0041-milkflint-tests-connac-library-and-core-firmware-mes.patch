+/* Multicast data goes at the multicast rate; a station asking for the
+ * minimum rate (e.g. EAPOL) gets a fixed rate too.
+ */
+static void mt76_connac_test_txwi_mcast(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_vif *vif = mt76_connac_test_vif(test,
+							 NL80211_IFTYPE_AP);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct ieee80211_tx_info *info;
+	struct sk_buff *skb;
+	__le32 txwi[16];
+	u32 dw;
+
+	vif->bss_conf.basic_rates = BIT(0);
+	vif->bss_conf.mcast_rate[NL80211_BAND_5GHZ] = 3;	/* 12 Mbps */
+	skb = mt76_connac_test_frame(test, IEEE80211_FTYPE_DATA |
+				     IEEE80211_STYPE_DATA,
+				     mt76_connac_test_bcast, 60);
+	info = IEEE80211_SKB_CB(skb);
+	info->control.vif = vif;
+
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	dw = mt76_connac_test_dw(txwi, 2);
+	KUNIT_EXPECT_TRUE(test, dw & MT_TXD2_MULTICAST);
+	KUNIT_EXPECT_TRUE(test, dw & MT_TXD2_FIX_RATE);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD6_TX_RATE,
+					mt76_connac_test_dw(txwi, 6)),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 10, 0));
+
+	/* unicast at the minimum rate: the basic rate, not the mcast one */
+	skb = mt76_connac_test_frame(test, MT76_CONNAC_TEST_QOS_DATA,
+				     mt76_connac_test_peer, 60);
+	info = IEEE80211_SKB_CB(skb);
+	info->control.vif = vif;
+	info->flags = IEEE80211_TX_CTL_USE_MINRATE;
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BE, 0);
+	dw = mt76_connac_test_dw(txwi, 2);
+	KUNIT_EXPECT_FALSE(test, dw & MT_TXD2_MULTICAST);
+	KUNIT_EXPECT_TRUE(test, dw & MT_TXD2_FIX_RATE);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD6_TX_RATE,
+					mt76_connac_test_dw(txwi, 6)),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 11, 0));
+}
