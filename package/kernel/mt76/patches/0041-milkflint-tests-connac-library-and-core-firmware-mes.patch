+static int mt76_connac_test_rx_rate(struct mt76_dev *dev,
+				    struct mt76_rx_status *status,
+				    struct ieee80211_supported_band *sband,
+				    __le32 v0, u8 *mode)
+{
+	__le32 rxv[16] = { v0 };
+
+	memset(status, 0, sizeof(*status));
+	return mt76_connac2_mac_fill_rx_rate(dev, status, sband, rxv, mode);
+}
