+/* --- HE radiotap ------------------------------------------------------- */
+
+static struct sk_buff *mt76_connac_test_rx_skb(struct kunit *test)
+{
+	struct sk_buff *skb = alloc_skb(256, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_connac_test_free_skb, skb), 0);
+	skb_reserve(skb, 128);
+	skb_put_zero(skb, 32);
+	memset(skb->cb, 0, sizeof(skb->cb));
+	return skb;
+}
+
+#define HE_BIT(f)	le16_to_cpu(HE_BITS(f))
+
+/* The fields every HE frame's radiotap header gets, from the RXV. */
+static void mt76_connac_test_he_radiotap_common(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct sk_buff *skb = mt76_connac_test_rx_skb(test);
+	struct mt76_rx_status *status = (struct mt76_rx_status *)skb->cb;
+	struct ieee80211_radiotap_he *he;
+	__le32 rxv[16] = {};
+	u8 *data = skb->data;
+
+	rxv[0] = cpu_to_le32(MT_PRXV_TXBF);
+	rxv[2] = cpu_to_le32(FIELD_PREP(MT_CRXV_HE_LTF_SIZE, 2) |
+			     MT_CRXV_HE_LDPC_EXT_SYM |
+			     MT_CRXV_HE_PE_DISAMBIG | MT_CRXV_HE_UPLINK);
+	rxv[11] = cpu_to_le32(FIELD_PREP(MT_CRXV_HE_SR_MASK, 0x9));
+	rxv[14] = cpu_to_le32(FIELD_PREP(MT_CRXV_HE_BSS_COLOR, 0x2a) |
+			      FIELD_PREP(MT_CRXV_HE_TXOP_DUR, 0x55) |
+			      MT_CRXV_HE_BEAM_CHNG | MT_CRXV_HE_DOPPLER);
+
+	mt76_connac2_mac_decode_he_radiotap(dev, skb, rxv, MT_PHY_TYPE_HE_SU);
+
+	KUNIT_EXPECT_TRUE(test, status->flag & RX_FLAG_RADIOTAP_HE);
+	KUNIT_EXPECT_FALSE(test, status->flag & RX_FLAG_RADIOTAP_HE_MU);
+	KUNIT_ASSERT_PTR_EQ(test, (u8 *)skb->data, data - (int)sizeof(*he));
+	he = (struct ieee80211_radiotap_he *)skb->data;
+
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data1),
+			HE_BIT(DATA1_DATA_MCS_KNOWN) |
+			HE_BIT(DATA1_DATA_DCM_KNOWN) |
+			HE_BIT(DATA1_STBC_KNOWN) |
+			HE_BIT(DATA1_CODING_KNOWN) |
+			HE_BIT(DATA1_LDPC_XSYMSEG_KNOWN) |
+			HE_BIT(DATA1_DOPPLER_KNOWN) |
+			HE_BIT(DATA1_SPTL_REUSE_KNOWN) |
+			HE_BIT(DATA1_BSS_COLOR_KNOWN) |
+			HE_BIT(DATA1_FORMAT_SU) |
+			HE_BIT(DATA1_UL_DL_KNOWN) |
+			HE_BIT(DATA1_BEAM_CHANGE_KNOWN) |
+			HE_BIT(DATA1_BW_RU_ALLOC_KNOWN));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data2),
+			HE_BIT(DATA2_GI_KNOWN) | HE_BIT(DATA2_TXBF_KNOWN) |
+			HE_BIT(DATA2_PE_DISAMBIG_KNOWN) |
+			HE_BIT(DATA2_TXOP_KNOWN));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data3),
+			FIELD_PREP(IEEE80211_RADIOTAP_HE_DATA3_BSS_COLOR,
+				   0x2a) |
+			IEEE80211_RADIOTAP_HE_DATA3_LDPC_XSYMSEG |
+			IEEE80211_RADIOTAP_HE_DATA3_BEAM_CHANGE |
+			IEEE80211_RADIOTAP_HE_DATA3_UL_DL);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data4),
+			FIELD_PREP(IEEE80211_RADIOTAP_HE_DATA4_SU_MU_SPTL_REUSE,
+				   0x9));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data5),
+			IEEE80211_RADIOTAP_HE_DATA5_PE_DISAMBIG |
+			FIELD_PREP(IEEE80211_RADIOTAP_HE_DATA5_LTF_SIZE, 3) |
+			IEEE80211_RADIOTAP_HE_DATA5_TXBF);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data6),
+			FIELD_PREP(IEEE80211_RADIOTAP_HE_DATA6_TXOP, 0x55) |
+			IEEE80211_RADIOTAP_HE_DATA6_DOPPLER);
+
+	/* nothing set: only the static parts */
+	skb = mt76_connac_test_rx_skb(test);
+	memset(rxv, 0, sizeof(rxv));
+	mt76_connac2_mac_decode_he_radiotap(dev, skb, rxv,
+					    MT_PHY_TYPE_HE_EXT_SU);
+	he = (struct ieee80211_radiotap_he *)skb->data;
+	KUNIT_EXPECT_TRUE(test, le16_to_cpu(he->data1) &
+			  HE_BIT(DATA1_FORMAT_EXT_SU));
+	KUNIT_EXPECT_FALSE(test, le16_to_cpu(he->data1) &
+			   HE_BIT(DATA1_BEAM_CHANGE_KNOWN));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data3), 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data5),
+			FIELD_PREP(IEEE80211_RADIOTAP_HE_DATA5_LTF_SIZE, 1));
+
+	/* an EXT SU frame carries UL/DL too */
+	skb = mt76_connac_test_rx_skb(test);
+	rxv[2] = cpu_to_le32(MT_CRXV_HE_UPLINK);
+	mt76_connac2_mac_decode_he_radiotap(dev, skb, rxv,
+					    MT_PHY_TYPE_HE_EXT_SU);
+	he = (struct ieee80211_radiotap_he *)skb->data;
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data3),
+			IEEE80211_RADIOTAP_HE_DATA3_UL_DL);
+
+	/* not an HE mode: just the common part */
+	skb = mt76_connac_test_rx_skb(test);
+	mt76_connac2_mac_decode_he_radiotap(dev, skb, rxv, MT_PHY_TYPE_VHT);
+	he = (struct ieee80211_radiotap_he *)skb->data;
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data1) &
+			IEEE80211_RADIOTAP_HE_DATA1_FORMAT_MASK, 0);
+	KUNIT_EXPECT_FALSE(test, le16_to_cpu(he->data1) &
+			   HE_BIT(DATA1_UL_DL_KNOWN));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data3), 0);
+}
+
+static void mt76_connac_test_set_ru(__le32 *rxv, u8 ru)
+{
+	rxv[0] = cpu_to_le32(FIELD_PREP(MT_PRXV_HE_RU_ALLOC_L, ru & 0xf));
+	rxv[1] = cpu_to_le32(FIELD_PREP(MT_PRXV_HE_RU_ALLOC_H, ru >> 4));
+}
+
+/* a trigger-based frame on RU @ru: the RU size and offset decoded */
+static void mt76_connac_test_tb_ru(struct kunit *test, struct mt76_dev *dev,
+				   u8 ru, int alloc, int offs)
+{
+	struct sk_buff *skb = mt76_connac_test_rx_skb(test);
+	struct mt76_rx_status *status = (struct mt76_rx_status *)skb->cb;
+	struct ieee80211_radiotap_he *he;
+	__le32 rxv[16] = {};
+
+	mt76_connac_test_set_ru(rxv, ru);
+	mt76_connac2_mac_decode_he_radiotap(dev, skb, rxv, MT_PHY_TYPE_HE_TB);
+	he = (struct ieee80211_radiotap_he *)skb->data;
+	KUNIT_EXPECT_EQ(test, (int)status->bw, RATE_INFO_BW_HE_RU);
+	KUNIT_EXPECT_EQ(test, (int)status->he_ru, alloc);
+	KUNIT_EXPECT_TRUE(test, le16_to_cpu(he->data1) &
+			  HE_BIT(DATA1_BW_RU_ALLOC_KNOWN));
+	KUNIT_EXPECT_TRUE(test, le16_to_cpu(he->data2) &
+			  HE_BIT(DATA2_RU_OFFSET_KNOWN));
+	KUNIT_EXPECT_EQ(test, FIELD_GET(IEEE80211_RADIOTAP_HE_DATA2_RU_OFFSET,
+					le16_to_cpu(he->data2)), offs);
+}
+
+/* Trigger-based PPDUs: the four spatial reuse fields and the RU the
+ * frame came in on, its size and offset.
+ */
+static void mt76_connac_test_he_radiotap_tb(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct sk_buff *skb = mt76_connac_test_rx_skb(test);
+	struct ieee80211_radiotap_he *he;
+	__le32 rxv[16] = {};
+
+	rxv[11] = cpu_to_le32(FIELD_PREP(MT_CRXV_HE_SR_MASK, 1) |
+			      FIELD_PREP(MT_CRXV_HE_SR1_MASK, 2) |
+			      FIELD_PREP(MT_CRXV_HE_SR2_MASK, 3) |
+			      FIELD_PREP(MT_CRXV_HE_SR3_MASK, 4));
+	mt76_connac2_mac_decode_he_radiotap(dev, skb, rxv, MT_PHY_TYPE_HE_TB);
+	he = (struct ieee80211_radiotap_he *)skb->data;
+	KUNIT_EXPECT_TRUE(test, le16_to_cpu(he->data1) &
+			  HE_BIT(DATA1_FORMAT_TRIG));
+	KUNIT_EXPECT_TRUE(test, le16_to_cpu(he->data1) &
+			  HE_BIT(DATA1_SPTL_REUSE4_KNOWN));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data4),
+			FIELD_PREP(IEEE80211_RADIOTAP_HE_DATA4_SU_MU_SPTL_REUSE,
+				   1) |
+			FIELD_PREP(IEEE80211_RADIOTAP_HE_DATA4_TB_SPTL_REUSE2,
+				   2) |
+			FIELD_PREP(IEEE80211_RADIOTAP_HE_DATA4_TB_SPTL_REUSE3,
+				   3) |
+			FIELD_PREP(IEEE80211_RADIOTAP_HE_DATA4_TB_SPTL_REUSE4,
+				   4));
+
+	mt76_connac_test_tb_ru(test, dev, 0, NL80211_RATE_INFO_HE_RU_ALLOC_26,
+			       0);
+	mt76_connac_test_tb_ru(test, dev, 36,
+			       NL80211_RATE_INFO_HE_RU_ALLOC_26, 36);
+	mt76_connac_test_tb_ru(test, dev, 40,
+			       NL80211_RATE_INFO_HE_RU_ALLOC_52, 3);
+	mt76_connac_test_tb_ru(test, dev, 55,
+			       NL80211_RATE_INFO_HE_RU_ALLOC_106, 2);
+	mt76_connac_test_tb_ru(test, dev, 64,
+			       NL80211_RATE_INFO_HE_RU_ALLOC_242, 3);
+	mt76_connac_test_tb_ru(test, dev, 66,
+			       NL80211_RATE_INFO_HE_RU_ALLOC_484, 1);
+	mt76_connac_test_tb_ru(test, dev, 67,
+			       NL80211_RATE_INFO_HE_RU_ALLOC_996, 0);
+	mt76_connac_test_tb_ru(test, dev, 68,
+			       NL80211_RATE_INFO_HE_RU_ALLOC_2x996, 0);
+}
+
+/* HE-MU: the station id and RU go in the HE header, the SIG-B fields in a
+ * second, HE-MU radiotap header in front of it.
+ */
+static void mt76_connac_test_he_radiotap_mu(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct sk_buff *skb = mt76_connac_test_rx_skb(test);
+	struct mt76_rx_status *status = (struct mt76_rx_status *)skb->cb;
+	struct ieee80211_radiotap_he_mu *he_mu;
+	struct ieee80211_radiotap_he *he;
+	__le32 rxv[16] = {};
+	u8 *data = skb->data;
+	u16 flags1;
+
+	mt76_connac_test_set_ru(rxv, 61);
+	rxv[2] = cpu_to_le32(FIELD_PREP(MT_CRXV_HE_NUM_USER, 5) |
+			     MT_CRXV_HE_UPLINK);
+	rxv[3] = cpu_to_le32(FIELD_PREP(MT_CRXV_HE_RU0, 0x11) |
+			     FIELD_PREP(MT_CRXV_HE_RU1, 0x22) |
+			     FIELD_PREP(MT_CRXV_HE_RU2, 0x33) |
+			     FIELD_PREP(MT_CRXV_HE_RU3, 0x44));
+	rxv[7] = cpu_to_le32(FIELD_PREP(MT_CRXV_HE_MU_AID, 0x123));
+	status->rate_idx = 7;
+	status->he_dcm = 1;
+
+	mt76_connac2_mac_decode_he_radiotap(dev, skb, rxv, MT_PHY_TYPE_HE_MU);
+
+	KUNIT_EXPECT_TRUE(test, status->flag & RX_FLAG_RADIOTAP_HE);
+	KUNIT_EXPECT_TRUE(test, status->flag & RX_FLAG_RADIOTAP_HE_MU);
+	KUNIT_EXPECT_EQ(test, (int)status->he_ru,
+			NL80211_RATE_INFO_HE_RU_ALLOC_242);
+	KUNIT_ASSERT_PTR_EQ(test, (u8 *)skb->data,
+			    data - (int)(sizeof(*he) + sizeof(*he_mu)));
+	he_mu = (struct ieee80211_radiotap_he_mu *)skb->data;
+	he = (struct ieee80211_radiotap_he *)(he_mu + 1);
+
+	KUNIT_EXPECT_TRUE(test, le16_to_cpu(he->data1) &
+			  HE_BIT(DATA1_FORMAT_MU));
+	KUNIT_EXPECT_TRUE(test, le16_to_cpu(he->data1) &
+			  HE_BIT(DATA1_BW_RU_ALLOC_KNOWN));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->data3),
+			IEEE80211_RADIOTAP_HE_DATA3_UL_DL);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(IEEE80211_RADIOTAP_HE_DATA4_MU_STA_ID,
+					le16_to_cpu(he->data4)), 0x123);
+
+	flags1 = le16_to_cpu(he_mu->flags1);
+	KUNIT_EXPECT_TRUE(test, flags1 &
+		IEEE80211_RADIOTAP_HE_MU_FLAGS1_SIG_B_MCS_KNOWN);
+	KUNIT_EXPECT_TRUE(test, flags1 &
+		IEEE80211_RADIOTAP_HE_MU_FLAGS1_SIG_B_DCM_KNOWN);
+	KUNIT_EXPECT_TRUE(test, flags1 &
+		IEEE80211_RADIOTAP_HE_MU_FLAGS1_CH1_RU_KNOWN);
+	KUNIT_EXPECT_TRUE(test, flags1 &
+		IEEE80211_RADIOTAP_HE_MU_FLAGS1_SIG_B_SYMS_USERS_KNOWN);
+	/* only connac2 knows whether SIG-B is compressed */
+	KUNIT_EXPECT_FALSE(test, flags1 &
+		IEEE80211_RADIOTAP_HE_MU_FLAGS1_SIG_B_COMP_KNOWN);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(
+		IEEE80211_RADIOTAP_HE_MU_FLAGS1_SIG_B_MCS, flags1), 7);
+	KUNIT_EXPECT_TRUE(test, flags1 &
+		IEEE80211_RADIOTAP_HE_MU_FLAGS1_SIG_B_DCM);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(
+		IEEE80211_RADIOTAP_HE_MU_FLAGS2_SIG_B_SYMS_USERS,
+		le16_to_cpu(he_mu->flags2)), 5);
+	KUNIT_EXPECT_TRUE(test, le16_to_cpu(he_mu->flags2) &
+		IEEE80211_RADIOTAP_HE_MU_FLAGS2_BW_FROM_SIG_A_BW_KNOWN);
+	KUNIT_EXPECT_EQ(test, he_mu->ru_ch1[0], 0x11);
+	KUNIT_EXPECT_EQ(test, he_mu->ru_ch2[0], 0x22);
+	KUNIT_EXPECT_EQ(test, he_mu->ru_ch1[1], 0x33);
+	KUNIT_EXPECT_EQ(test, he_mu->ru_ch2[1], 0x44);
+
+	/* no DCM */
+	skb = mt76_connac_test_rx_skb(test);
+	((struct mt76_rx_status *)skb->cb)->rate_idx = 2;
+	mt76_connac2_mac_decode_he_radiotap(dev, skb, rxv, MT_PHY_TYPE_HE_MU);
+	he_mu = (struct ieee80211_radiotap_he_mu *)skb->data;
+	KUNIT_EXPECT_FALSE(test, le16_to_cpu(he_mu->flags1) &
+			   IEEE80211_RADIOTAP_HE_MU_FLAGS1_SIG_B_DCM);
+}
+
+/* The SIG-A bandwidth in the HE-MU header should be the frame's (20, 40,
+ * 80 or 160 MHz, radiotap's 0-3); the driver encodes status->bw, which by
+ * then is RATE_INFO_BW_HE_RU (and in rate_info_bw units anyway).
+ */
+static void mt76_connac_test_he_radiotap_mu_bw(struct kunit *test)
+{
+	struct ieee80211_radiotap_he_mu *he_mu;
+	struct mt76_rx_status *status;
+	struct mt76_dev *dev;
+	struct sk_buff *skb;
+	__le32 rxv[16] = {};
+	u8 mode;
+
+	kunit_skip(test, "driver bug: HE-MU radiotap SIG-A BW is RATE_INFO_BW_HE_RU");
+
+	dev = mt76_connac_test_dev(test);
+	skb = mt76_connac_test_rx_skb(test);
+	status = (struct mt76_rx_status *)skb->cb;
+	rxv[0] = mt76_connac_test_prxv(MT_PHY_TYPE_HE_MU, 3, 1,
+				       IEEE80211_STA_RX_BW_40, 0, 0, false);
+	KUNIT_ASSERT_EQ(test, mt76_connac2_mac_fill_rx_rate(dev, status,
+			&dev->phy.sband_5g.sband, rxv, &mode), 0);
+	mt76_connac2_mac_decode_he_radiotap(dev, skb, rxv, mode);
+	he_mu = (struct ieee80211_radiotap_he_mu *)skb->data;
+	KUNIT_EXPECT_EQ(test, FIELD_GET(
+		IEEE80211_RADIOTAP_HE_MU_FLAGS2_BW_FROM_SIG_A_BW,
+		le16_to_cpu(he_mu->flags2)), 1);
+}
+
+/* The HE-MU "known" template is a static the connac2 path adds bits to,
+ * so after a connac2 device decoded one frame every other device reports
+ * them too. (For the same reason no test here decodes HE-MU on a connac2
+ * device: it would change what the later suites see.)
+ */
+static void mt76_connac_test_he_radiotap_mu_known(struct kunit *test)
+{
+	struct ieee80211_radiotap_he_mu *he_mu;
+	struct mt76_dev *dev, *c2;
+	struct sk_buff *skb;
+	__le32 rxv[16] = {};
+
+	kunit_skip(test, "driver bug: connac2 HE-MU known bits leak into a shared static");
+
+	dev = mt76_connac_test_dev(test);
+	c2 = mt76_connac_test_dev(test);
+	c2->rev = MT76_CONNAC_TEST_C2_REV;
+	mt76_connac2_mac_decode_he_radiotap(c2, mt76_connac_test_rx_skb(test),
+					    rxv, MT_PHY_TYPE_HE_MU);
+	skb = mt76_connac_test_rx_skb(test);
+	mt76_connac2_mac_decode_he_radiotap(dev, skb, rxv, MT_PHY_TYPE_HE_MU);
+	he_mu = (struct ieee80211_radiotap_he_mu *)skb->data;
+	KUNIT_EXPECT_FALSE(test, le16_to_cpu(he_mu->flags1) &
+			   IEEE80211_RADIOTAP_HE_MU_FLAGS1_SIG_B_COMP_KNOWN);
+}
+
+/* --- 802.3 -> 802.11 for mesh -------------------------------------------- */
+
+#define MT76_CONNAC_TEST_HDR_OFFS	64
+
+static const u8 mt76_connac_test_vif_addr[ETH_ALEN] = {
+	0x02, 0x00, 0x00, 0x00, 0x00, 0x01
+};
+
+static const u8 mt76_connac_test_bssid[ETH_ALEN] = {
+	0x02, 0x00, 0x00, 0x00, 0x00, 0x02
+};
+
+static const u8 mt76_connac_test_da[ETH_ALEN] = {
+	0x02, 0x0d, 0x0d, 0x0d, 0x0d, 0x0d
+};
+
+static const u8 mt76_connac_test_sa[ETH_ALEN] = {
+	0x02, 0x05, 0x05, 0x05, 0x05, 0x05
+};
+
+static const u8 mt76_connac_test_payload[4] = { 0xde, 0xad, 0xbe, 0xef };
+
+/* A received frame the hardware translated to 802.3: RXD (unicast to us,
+ * group 4 with the original header fields), the Ethernet header at the
+ * header offset, then the payload.
+ */
+static struct sk_buff *mt76_connac_test_hdr_skb(struct kunit *test,
+						struct ieee80211_sta *sta,
+						u16 fc, u16 proto)
+{
+	struct mt76_rx_status *status;
+	struct ethhdr *eth;
+	struct sk_buff *skb;
+	__le32 *rxd;
+
+	skb = mt76_connac_test_rx_skb(test);
+	skb_trim(skb, 0);
+	rxd = skb_put_zero(skb, MT76_CONNAC_TEST_HDR_OFFS);
+	rxd[1] = cpu_to_le32(MT_RXD1_NORMAL_GROUP_4);
+	rxd[3] = cpu_to_le32(FIELD_PREP(MT_RXD3_NORMAL_ADDR_TYPE,
+					MT_RXD3_NORMAL_U2M));
+	rxd[6] = cpu_to_le32(FIELD_PREP(MT_RXD6_FRAME_CONTROL, fc));
+	rxd[8] = cpu_to_le32(FIELD_PREP(MT_RXD8_SEQ_CTRL, 0x1230) |
+			     FIELD_PREP(MT_RXD8_QOS_CTL, 0x0105));
+	rxd[9] = cpu_to_le32(0xa1b2c3d4);
+	eth = skb_put(skb, sizeof(*eth));
+	ether_addr_copy(eth->h_dest, mt76_connac_test_da);
+	ether_addr_copy(eth->h_source, mt76_connac_test_sa);
+	eth->h_proto = htons(proto);
+	skb_put_data(skb, mt76_connac_test_payload,
+		     sizeof(mt76_connac_test_payload));
+
+	status = (struct mt76_rx_status *)skb->cb;
+	status->wcid = mt76_connac_test_wcid(sta);
+	return skb;
+}
+
+static struct ieee80211_vif *mt76_connac_test_mesh_vif(struct kunit *test)
+{
+	struct ieee80211_vif *vif;
+
+	vif = mt76_connac_test_vif(test, NL80211_IFTYPE_MESH_POINT);
+	ether_addr_copy(vif->addr, mt76_connac_test_vif_addr);
+	vif->bss_conf.bssid = mt76_connac_test_bssid;
+	return vif;
+}
+
+/* A frame to a mesh station, from a non-mesh DS: rebuilt with our address,
+ * the peer's, the destination; QoS control and HT control from the RXD;
+ * then RFC 1042 SNAP with the Ethernet type, then the payload.
+ */
+static void mt76_connac_test_frag0_tods(struct kunit *test)
+{
+	static const u8 rfc1042[6] = { 0xaa, 0xaa, 0x03, 0x00, 0x00, 0x00 };
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct ieee80211_vif *vif = mt76_connac_test_mesh_vif(test);
+	u16 fc = MT76_CONNAC_TEST_QOS_DATA | IEEE80211_FCTL_TODS |
+		 IEEE80211_FCTL_ORDER;
+	struct ieee80211_hdr *hdr;
+	struct sk_buff *skb;
+	u8 *p;
+
+	ether_addr_copy(sta->addr, mt76_connac_test_peer);
+	skb = mt76_connac_test_hdr_skb(test, sta, fc, ETH_P_IP);
+
+	KUNIT_ASSERT_EQ(test, mt76_connac2_reverse_frag0_hdr_trans(vif, skb,
+			MT76_CONNAC_TEST_HDR_OFFS), 0);
+	KUNIT_ASSERT_EQ(test, skb->len, 24 + 2 + 4 + 6 + 2 + 4);
+	hdr = (struct ieee80211_hdr *)skb->data;
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(hdr->frame_control), fc);
+	KUNIT_EXPECT_EQ(test, hdr->duration_id, 0);
+	KUNIT_EXPECT_MEMEQ(test, hdr->addr1, mt76_connac_test_vif_addr,
+			   ETH_ALEN);
+	KUNIT_EXPECT_MEMEQ(test, hdr->addr2, mt76_connac_test_peer, ETH_ALEN);
+	KUNIT_EXPECT_MEMEQ(test, hdr->addr3, mt76_connac_test_da, ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(hdr->seq_ctrl), 0x1230);
+	p = skb->data + 24;
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(p), 0x0105);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(p + 2), 0xa1b2c3d4);
+	KUNIT_EXPECT_MEMEQ(test, p + 6, rfc1042, sizeof(rfc1042));
+	KUNIT_EXPECT_EQ(test, get_unaligned_be16(p + 12), ETH_P_IP);
+	KUNIT_EXPECT_MEMEQ(test, p + 14, mt76_connac_test_payload,
+			   sizeof(mt76_connac_test_payload));
+}
+
+/* Four-address frames get the source as address 4; an 802.3 length
+ * instead of a type means no SNAP header at all.
+ */
+static void mt76_connac_test_frag0_4addr(struct kunit *test)
+{
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct ieee80211_vif *vif = mt76_connac_test_mesh_vif(test);
+	u16 fc = IEEE80211_FTYPE_DATA | IEEE80211_STYPE_DATA |
+		 IEEE80211_FCTL_TODS | IEEE80211_FCTL_FROMDS;
+	struct ieee80211_hdr *hdr;
+	struct sk_buff *skb;
+
+	ether_addr_copy(sta->addr, mt76_connac_test_peer);
+	skb = mt76_connac_test_hdr_skb(test, sta, fc, 4);
+
+	KUNIT_ASSERT_EQ(test, mt76_connac2_reverse_frag0_hdr_trans(vif, skb,
+			MT76_CONNAC_TEST_HDR_OFFS), 0);
+	KUNIT_ASSERT_EQ(test, skb->len, 30 + 4);
+	hdr = (struct ieee80211_hdr *)skb->data;
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(hdr->frame_control), fc);
+	KUNIT_EXPECT_MEMEQ(test, hdr->addr3, mt76_connac_test_da, ETH_ALEN);
+	KUNIT_EXPECT_MEMEQ(test, hdr->addr4, mt76_connac_test_sa, ETH_ALEN);
+	KUNIT_EXPECT_MEMEQ(test, skb->data + 30, mt76_connac_test_payload,
+			   sizeof(mt76_connac_test_payload));
+}
+
+/* No DS bits: address 3 is the BSSID; from the DS: the source. AppleTalk
+ * ARP and IPX get the bridge-tunnel SNAP header.
+ */
+static void mt76_connac_test_frag0_bridge(struct kunit *test)
+{
+	static const u8 bridge[6] = { 0xaa, 0xaa, 0x03, 0x00, 0x00, 0xf8 };
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct ieee80211_vif *vif = mt76_connac_test_mesh_vif(test);
+	u16 fc = IEEE80211_FTYPE_DATA | IEEE80211_STYPE_DATA;
+	struct ieee80211_hdr *hdr;
+	struct sk_buff *skb;
+
+	skb = mt76_connac_test_hdr_skb(test, sta, fc, ETH_P_AARP);
+	KUNIT_ASSERT_EQ(test, mt76_connac2_reverse_frag0_hdr_trans(vif, skb,
+			MT76_CONNAC_TEST_HDR_OFFS), 0);
+	KUNIT_ASSERT_EQ(test, skb->len, 24 + 6 + 2 + 4);
+	hdr = (struct ieee80211_hdr *)skb->data;
+	KUNIT_EXPECT_MEMEQ(test, hdr->addr3, mt76_connac_test_bssid,
+			   ETH_ALEN);
+	KUNIT_EXPECT_MEMEQ(test, skb->data + 24, bridge, sizeof(bridge));
+	KUNIT_EXPECT_EQ(test, get_unaligned_be16(skb->data + 30), ETH_P_AARP);
+
+	skb = mt76_connac_test_hdr_skb(test, sta, fc | IEEE80211_FCTL_FROMDS,
+				       ETH_P_IPX);
+	KUNIT_ASSERT_EQ(test, mt76_connac2_reverse_frag0_hdr_trans(vif, skb,
+			MT76_CONNAC_TEST_HDR_OFFS), 0);
+	hdr = (struct ieee80211_hdr *)skb->data;
+	KUNIT_EXPECT_MEMEQ(test, hdr->addr3, mt76_connac_test_sa, ETH_ALEN);
+	KUNIT_EXPECT_MEMEQ(test, skb->data + 24, bridge, sizeof(bridge));
+	KUNIT_EXPECT_EQ(test, get_unaligned_be16(skb->data + 30), ETH_P_IPX);
+}
+
+/* Only unicast frames with the original header fields (group 4) can be
+ * rebuilt; others are left alone.
+ */
+static void mt76_connac_test_frag0_invalid(struct kunit *test)
+{
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct ieee80211_vif *vif = mt76_connac_test_mesh_vif(test);
+	struct sk_buff *skb;
+	__le32 *rxd;
+	int len;
+
+	skb = mt76_connac_test_hdr_skb(test, sta, IEEE80211_FTYPE_DATA,
+				       ETH_P_IP);
+	len = skb->len;
+	rxd = (__le32 *)skb->data;
+	rxd[3] = cpu_to_le32(FIELD_PREP(MT_RXD3_NORMAL_ADDR_TYPE, 2));
+	KUNIT_EXPECT_EQ(test, mt76_connac2_reverse_frag0_hdr_trans(vif, skb,
+			MT76_CONNAC_TEST_HDR_OFFS), -EINVAL);
+	KUNIT_EXPECT_EQ(test, skb->len, len);
+
+	rxd[3] = cpu_to_le32(FIELD_PREP(MT_RXD3_NORMAL_ADDR_TYPE,
+					MT_RXD3_NORMAL_U2M));
+	rxd[1] = 0;
+	KUNIT_EXPECT_EQ(test, mt76_connac2_reverse_frag0_hdr_trans(vif, skb,
+			MT76_CONNAC_TEST_HDR_OFFS), -EINVAL);
+	KUNIT_EXPECT_EQ(test, skb->len, len);
+}
+
 static struct kunit_case mt76_connac_mac_test_cases[] = {
 	KUNIT_CASE(mt76_test_txs_fixed_rate_keeps_rate),
 	KUNIT_CASE(mt76_test_token_put_clears_wed_count),
+	KUNIT_CASE(mt76_connac_test_ppe_thresh),
+	KUNIT_CASE(mt76_connac_test_tx_rate_val),
+	KUNIT_CASE(mt76_connac_test_tx_rate_val_beacon),
+	KUNIT_CASE(mt76_connac_test_txwi_data),
+	KUNIT_CASE(mt76_connac_test_txwi_status),
+	KUNIT_CASE(mt76_connac_test_txwi_mgmt),
+	KUNIT_CASE(mt76_connac_test_txwi_band1),
+	KUNIT_CASE(mt76_connac_test_txwi_beacon),
+	KUNIT_CASE(mt76_connac_test_txwi_mcast),
+	KUNIT_CASE(mt76_connac_test_txwi_bip),
+	KUNIT_CASE(mt76_connac_test_txwi_ba),
+	KUNIT_CASE(mt76_connac_test_txwi_frag),
