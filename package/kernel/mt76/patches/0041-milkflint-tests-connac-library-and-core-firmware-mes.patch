+/* --- firmware download ------------------------------------------------- */
+
+#define MT76_CONNAC_MCU_TEST_FW_DIR	"/lib/firmware/"
+#define MT76_CONNAC_MCU_TEST_PATCH	"milkflint-kunit-connac-patch.bin"
+#define MT76_CONNAC_MCU_TEST_BADSEC	"milkflint-kunit-connac-badsec.bin"
+#define MT76_CONNAC_MCU_TEST_WM		"milkflint-kunit-connac-wm.bin"
+#define MT76_CONNAC_MCU_TEST_WA		"milkflint-kunit-connac-wa.bin"
+#define MT76_CONNAC_MCU_TEST_SHORT	"milkflint-kunit-connac-short.bin"
+/* request_firmware() fails at once for an empty name: no file system, no
+ * user space fallback
+ */
+#define MT76_CONNAC_MCU_TEST_NONE	""
+
+/* Put a firmware file where request_firmware() looks (the VM's root file
+ * system is a throwaway copy). Skips the test if that's not possible.
+ */
+static void mt76_connac_mcu_test_write_fw(struct kunit *test,
+					  const char *name, const void *data,
+					  size_t len)
+{
+	char path[96];
+	struct file *f;
+	loff_t pos = 0;
+	ssize_t n;
+
+	snprintf(path, sizeof(path), MT76_CONNAC_MCU_TEST_FW_DIR "%s", name);
+	f = filp_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (IS_ERR(f))
+		kunit_skip(test, "can't create %s: %ld", path, PTR_ERR(f));
+	n = kernel_write(f, data, len, &pos);
+	filp_close(f, NULL);
+	/* a kthread's fput() is deferred: until it runs the file counts as
+	 * open for writing, and request_firmware() won't read it
+	 */
+	flush_delayed_fput();
+	if (n != len)
+		kunit_skip(test, "can't write %s: %zd", path, n);
+}
+
+/* a patch image: header, sections, then the data at offset 0x100 */
+#define MT76_CONNAC_MCU_TEST_PATCH_DATA	0x100
+#define MT76_CONNAC_MCU_TEST_PATCH_LEN0	5000
+#define MT76_CONNAC_MCU_TEST_PATCH_LEN1	10
+
+static u8 *mt76_connac_mcu_test_patch_image(struct kunit *test, size_t *len,
+					    u32 key0, u32 key1)
+{
+	struct mt76_connac2_patch_hdr *hdr;
+	struct mt76_connac2_patch_sec *sec;
+	size_t size = MT76_CONNAC_MCU_TEST_PATCH_DATA +
+		      MT76_CONNAC_MCU_TEST_PATCH_LEN0 +
+		      MT76_CONNAC_MCU_TEST_PATCH_LEN1;
+	u8 *fw;
+	int i;
+
+	BUILD_BUG_ON(sizeof(*hdr) + 2 * sizeof(*sec) >
+		     MT76_CONNAC_MCU_TEST_PATCH_DATA);
+	fw = kunit_kzalloc(test, size, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, fw);
+	for (i = MT76_CONNAC_MCU_TEST_PATCH_DATA; i < size; i++)
+		fw[i] = i * 7;
+
+	hdr = (struct mt76_connac2_patch_hdr *)fw;
+	memcpy(hdr->build_date, "20261019000000ab", 16);
+	hdr->hw_sw_ver = cpu_to_be32(0x8a108a10);
+	hdr->desc.n_region = cpu_to_be32(2);
+
+	sec = (struct mt76_connac2_patch_sec *)(hdr + 1);
+	sec[0].type = cpu_to_be32(PATCH_SEC_TYPE_INFO);
+	sec[0].offs = cpu_to_be32(MT76_CONNAC_MCU_TEST_PATCH_DATA);
+	sec[0].info.addr = cpu_to_be32(0x200000);
+	sec[0].info.len = cpu_to_be32(MT76_CONNAC_MCU_TEST_PATCH_LEN0);
+	sec[0].info.sec_key_idx = cpu_to_be32(key0);
+	sec[1].type = cpu_to_be32(0x30000 | PATCH_SEC_TYPE_INFO);
+	sec[1].offs = cpu_to_be32(MT76_CONNAC_MCU_TEST_PATCH_DATA +
+				  MT76_CONNAC_MCU_TEST_PATCH_LEN0);
+	sec[1].info.addr = cpu_to_be32(0x900000);
+	sec[1].info.len = cpu_to_be32(MT76_CONNAC_MCU_TEST_PATCH_LEN1);
+	sec[1].info.sec_key_idx = cpu_to_be32(key1);
+
+	*len = size;
+	return fw;
+}
+
+static void mt76_connac_mcu_test_write_patch(struct kunit *test,
+					     const char *name, u32 key0,
+					     u32 key1, u8 **image)
+{
+	size_t len;
+	u8 *fw = mt76_connac_mcu_test_patch_image(test, &len, key0, key1);
+
+	mt76_connac_mcu_test_write_fw(test, name, fw, len);
+	if (image)
+		*image = fw;
+}
+
+/* the @i-th message, which must be @cmd */
+static struct mt76_test_msg *
+mt76_connac_mcu_test_nth(struct kunit *test, int i, int cmd)
+{
+	struct mt76_test_msg *msg = mt76_test_msg(mt76_test_fake, i);
+
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, cmd);
+	return msg;
+}
+
+static void mt76_connac_mcu_test_expect_dl(struct kunit *test, int i,
+					   int cmd, u32 addr, u32 len,
+					   u32 mode)
+{
+	struct mt76_test_msg *msg = mt76_connac_mcu_test_nth(test, i, cmd);
+	__le32 *req = (__le32 *)msg->data;
+
+	KUNIT_ASSERT_EQ(test, msg->len, 12);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req[0]), addr);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req[1]), len);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req[2]), mode);
+}
+
+static void mt76_connac_mcu_test_expect_data(struct kunit *test, int i,
+					     const u8 *data, int len)
+{
+	struct mt76_test_msg *msg;
+
+	msg = mt76_connac_mcu_test_nth(test, i, MCU_CMD(FW_SCATTER));
+	KUNIT_ASSERT_EQ(test, msg->len, len);
+	KUNIT_EXPECT_MEMEQ(test, msg->data, data, len);
+}
+
+static void mt76_connac_mcu_test_expect_sem(struct kunit *test, int i,
+					    u32 op)
+{
+	struct mt76_test_msg *msg;
+
+	msg = mt76_connac_mcu_test_nth(test, i, MCU_CMD(PATCH_SEM_CONTROL));
+	KUNIT_ASSERT_EQ(test, msg->len, 4);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data), op);
+}
+
+/* The ROM patch: semaphore, then each section announced and sent in 4 KiB
+ * chunks, the patch started and the semaphore released. On the MT7986 the
+ * sections are plain whatever their key field says.
+ */
+static void mt76_connac_mcu_test_load_patch(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	const u8 *d;
+	u8 *fw;
+
+	mt76_connac_mcu_test_write_patch(test, MT76_CONNAC_MCU_TEST_PATCH,
+		FIELD_PREP(PATCH_SEC_ENC_TYPE_MASK, PATCH_SEC_ENC_TYPE_AES) | 1,
+		PATCH_SEC_NOT_SUPPORT, &fw);
+	d = fw + MT76_CONNAC_MCU_TEST_PATCH_DATA;
+
+	KUNIT_ASSERT_EQ(test, mt76_connac2_load_patch(dev,
+			MT76_CONNAC_MCU_TEST_PATCH), 0);
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 8);
+	mt76_connac_mcu_test_expect_sem(test, 0, PATCH_SEM_GET);
+	mt76_connac_mcu_test_expect_dl(test, 1, MCU_CMD(PATCH_START_REQ),
+				       0x200000,
+				       MT76_CONNAC_MCU_TEST_PATCH_LEN0,
+				       DL_MODE_NEED_RSP);
+	mt76_connac_mcu_test_expect_data(test, 2, d, 4096);
+	mt76_connac_mcu_test_expect_data(test, 3, d + 4096,
+					 MT76_CONNAC_MCU_TEST_PATCH_LEN0 -
+					 4096);
+	mt76_connac_mcu_test_expect_dl(test, 4,
+				       MCU_CMD(TARGET_ADDRESS_LEN_REQ),
+				       0x900000,
+				       MT76_CONNAC_MCU_TEST_PATCH_LEN1,
+				       DL_MODE_NEED_RSP);
+	mt76_connac_mcu_test_expect_data(test, 5,
+					 d + MT76_CONNAC_MCU_TEST_PATCH_LEN0,
+					 MT76_CONNAC_MCU_TEST_PATCH_LEN1);
+	mt76_connac_mcu_test_nth(test, 6, MCU_CMD(PATCH_FINISH_REQ));
+	mt76_connac_mcu_test_expect_sem(test, 7, PATCH_SEM_RELEASE);
+}
+
+/* connac2 chips decode the section's encryption: AES with its key index,
+ * scrambled, plain, or not supported at all.
+ */
+static void mt76_connac_mcu_test_load_patch_encrypted(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	u32 aes = DL_MODE_NEED_RSP | DL_MODE_ENCRYPT | DL_MODE_RESET_SEC_IV |
+		  FIELD_PREP(DL_MODE_KEY_IDX, 1);
+	u32 scramble = DL_MODE_NEED_RSP | DL_MODE_ENCRYPT |
+		       DL_MODE_RESET_SEC_IV | DL_CONFIG_ENCRY_MODE_SEL;
+
+	dev->rev = MT76_CONNAC_MCU_TEST_C2_REV;
+	mt76_connac_mcu_test_write_patch(test, MT76_CONNAC_MCU_TEST_PATCH,
+		FIELD_PREP(PATCH_SEC_ENC_TYPE_MASK, PATCH_SEC_ENC_TYPE_AES) | 1,
+		FIELD_PREP(PATCH_SEC_ENC_TYPE_MASK,
+			   PATCH_SEC_ENC_TYPE_SCRAMBLE), NULL);
+	KUNIT_ASSERT_EQ(test, mt76_connac2_load_patch(dev,
+			MT76_CONNAC_MCU_TEST_PATCH), 0);
+	mt76_connac_mcu_test_expect_dl(test, 1, MCU_CMD(PATCH_START_REQ),
+				       0x200000,
+				       MT76_CONNAC_MCU_TEST_PATCH_LEN0, aes);
+	/* 0x900000 is a patch address on connac2 too */
+	mt76_connac_mcu_test_expect_dl(test, 4, MCU_CMD(PATCH_START_REQ),
+				       0x900000,
+				       MT76_CONNAC_MCU_TEST_PATCH_LEN1,
+				       scramble);
+
+	mt76_test_fake->n_msgs = 0;
+	INIT_LIST_HEAD(&mt76_test_fake->msgs);
+	mt76_connac_mcu_test_write_patch(test, MT76_CONNAC_MCU_TEST_PATCH,
+		FIELD_PREP(PATCH_SEC_ENC_TYPE_MASK, PATCH_SEC_ENC_TYPE_PLAIN),
+		PATCH_SEC_NOT_SUPPORT, NULL);
+	KUNIT_ASSERT_EQ(test, mt76_connac2_load_patch(dev,
+			MT76_CONNAC_MCU_TEST_PATCH), 0);
+	mt76_connac_mcu_test_expect_dl(test, 1, MCU_CMD(PATCH_START_REQ),
+				       0x200000,
+				       MT76_CONNAC_MCU_TEST_PATCH_LEN0,
+				       DL_MODE_NEED_RSP);
+	mt76_connac_mcu_test_expect_dl(test, 4, MCU_CMD(PATCH_START_REQ),
+				       0x900000,
+				       MT76_CONNAC_MCU_TEST_PATCH_LEN1,
+				       DL_MODE_NEED_RSP);
+
+	/* an unknown encryption type is sent as plain (and logged) */
+	mt76_test_fake->n_msgs = 0;
+	INIT_LIST_HEAD(&mt76_test_fake->msgs);
+	mt76_connac_mcu_test_write_patch(test, MT76_CONNAC_MCU_TEST_PATCH,
+		FIELD_PREP(PATCH_SEC_ENC_TYPE_MASK, 0x7f), 0, NULL);
+	KUNIT_ASSERT_EQ(test, mt76_connac2_load_patch(dev,
+			MT76_CONNAC_MCU_TEST_PATCH), 0);
+	mt76_connac_mcu_test_expect_dl(test, 1, MCU_CMD(PATCH_START_REQ),
+				       0x200000,
+				       MT76_CONNAC_MCU_TEST_PATCH_LEN0,
+				       DL_MODE_NEED_RSP);
+}
+
+/* A patch the ROM already has isn't downloaded again; a semaphore that
+ * can't be had is an error, with nothing sent but the request.
+ */
+static void mt76_connac_mcu_test_load_patch_sem(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+
+	mt76_connac_mcu_test_fw.sem_get = PATCH_IS_DL;
+	KUNIT_EXPECT_EQ(test, mt76_connac2_load_patch(dev,
+			MT76_CONNAC_MCU_TEST_NONE), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 1);
+
+	mt76_connac_mcu_test_fw.sem_get = PATCH_REL_SEM_SUCCESS;
+	KUNIT_EXPECT_EQ(test, mt76_connac2_load_patch(dev,
+			MT76_CONNAC_MCU_TEST_NONE), -EAGAIN);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 2);
+
+	/* the firmware doesn't answer */
+	mt76_test_fake->mcu_silent = true;
+	KUNIT_EXPECT_EQ(test, mt76_connac2_load_patch(dev,
+			MT76_CONNAC_MCU_TEST_NONE), -EAGAIN);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 3);
+}
+
+/* Whatever goes wrong once the semaphore is held, it's released, and the
+ * first error is what the caller sees.
+ */
+static void mt76_connac_mcu_test_load_patch_errors(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct mt76_test_msg *last;
+	u8 short_fw[16] = {};
+	size_t len;
+	u8 *fw;
+
+#define LOAD(_name, _ret) do {						\
+	mt76_connac_mcu_test_fw.n_fail_cmd = 0;				\
+	KUNIT_EXPECT_EQ(test, mt76_connac2_load_patch(dev, _name), _ret); \
+	last = list_last_entry(&mt76_test_fake->msgs,			\
+			       struct mt76_test_msg, list);		\
+	KUNIT_EXPECT_EQ(test, last->cmd, MCU_CMD(PATCH_SEM_CONTROL));	\
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(last->data),		\
+			PATCH_SEM_RELEASE);				\
+} while (0)
+
+	/* no firmware: request_firmware()'s error */
+	LOAD(MT76_CONNAC_MCU_TEST_NONE, -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 2);
+
+	/* too short for a header */
+	mt76_connac_mcu_test_write_fw(test, MT76_CONNAC_MCU_TEST_SHORT,
+				      short_fw, sizeof(short_fw));
+	LOAD(MT76_CONNAC_MCU_TEST_SHORT, -EINVAL);
+
+	/* a section that isn't a patch section */
+	fw = mt76_connac_mcu_test_patch_image(test, &len, 0, 0);
+	((struct mt76_connac2_patch_sec *)(fw +
+		sizeof(struct mt76_connac2_patch_hdr)))[1].type =
+		cpu_to_be32(PATCH_SEC_TYPE_INFO + 1);
+	mt76_connac_mcu_test_write_fw(test, MT76_CONNAC_MCU_TEST_BADSEC, fw,
+				      len);
+	mt76_test_fake->n_msgs = 0;
+	INIT_LIST_HEAD(&mt76_test_fake->msgs);
+	LOAD(MT76_CONNAC_MCU_TEST_BADSEC, -EINVAL);
+	/* the first section went, the second wasn't started */
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 5);
+
+	mt76_connac_mcu_test_write_patch(test, MT76_CONNAC_MCU_TEST_PATCH, 0,
+					 0, NULL);
+	mt76_connac_mcu_test_fail(MCU_CMD(PATCH_START_REQ), 1, -EIO);
+	LOAD(MT76_CONNAC_MCU_TEST_PATCH, -EIO);
+	mt76_connac_mcu_test_fail(MCU_CMD(FW_SCATTER), 2, -ENOMEM);
+	LOAD(MT76_CONNAC_MCU_TEST_PATCH, -ENOMEM);
+	mt76_connac_mcu_test_fail(MCU_CMD(PATCH_FINISH_REQ), 1, -ETIMEDOUT);
+	LOAD(MT76_CONNAC_MCU_TEST_PATCH, -ETIMEDOUT);
+	mt76_connac_mcu_test_fail(0, 0, 0);
+
+	/* everything sent, but the semaphore isn't given back */
+	mt76_connac_mcu_test_fw.sem_rel = PATCH_IS_DL;
+	LOAD(MT76_CONNAC_MCU_TEST_PATCH, -EAGAIN);
+#undef LOAD
+}
