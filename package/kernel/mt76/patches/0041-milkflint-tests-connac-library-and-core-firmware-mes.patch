+/* The BSS's own (broadcast) entry: a station interface points it at its
+ * AP once it has a BSSID; otherwise it's the broadcast address.
+ */
+static void mt76_connac_mcu_test_sta_basic_bc(struct kunit *test)
+{
+	static const u8 bcast[ETH_ALEN] = {
+		0xff, 0xff, 0xff, 0xff, 0xff, 0xff
+	};
+	static const u8 zero[ETH_ALEN] = {};
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_vif *vif;
+	struct sta_rec_basic *basic;
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_STATION, 0);
+	vif->cfg.aid = 42;
+	vif->bss_conf.bssid = mt76_connac_mcu_test_bssid;
+	basic = mt76_connac_mcu_test_sta_basic(test, dev, vif, NULL,
+					       CONN_STATE_PORT_SECURE, true);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(basic->conn_type),
+			CONNECTION_INFRA_BC);
+	KUNIT_EXPECT_MEMEQ(test, basic->peer_addr, mt76_connac_mcu_test_bssid,
+			   ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->aid), 42);
+
+	/* not associated yet */
+	vif->bss_conf.bssid = zero;
+	basic = mt76_connac_mcu_test_sta_basic(test, dev, vif, NULL,
+					       CONN_STATE_PORT_SECURE, true);
+	KUNIT_EXPECT_MEMEQ(test, basic->peer_addr, bcast, ETH_ALEN);
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 0);
+	vif->bss_conf.bssid = mt76_connac_mcu_test_bssid;
+	basic = mt76_connac_mcu_test_sta_basic(test, dev, vif, NULL,
+					       CONN_STATE_PORT_SECURE, true);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(basic->conn_type),
+			CONNECTION_INFRA_BC);
+	KUNIT_EXPECT_MEMEQ(test, basic->peer_addr, bcast, ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->aid), 0);
+}
