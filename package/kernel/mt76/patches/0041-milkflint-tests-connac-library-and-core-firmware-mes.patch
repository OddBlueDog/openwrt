+/* The own-MAC TLV tells the firmware what kind of BSS this is; extended
+ * BSSIDs (beyond the 4 hardware ones) share hardware BSSID 0.
+ */
+static void mt76_connac_mcu_test_bss_omac(struct kunit *test)
+{
+	struct ieee80211_vif *vif;
+	struct bss_info_omac *omac;
+	struct sk_buff *skb;
+
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_omac_type(test,
+			NL80211_IFTYPE_AP, false), CONNECTION_INFRA_AP);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_omac_type(test,
+			NL80211_IFTYPE_AP, true), CONNECTION_P2P_GO);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_omac_type(test,
+			NL80211_IFTYPE_MESH_POINT, false), CONNECTION_INFRA_AP);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_omac_type(test,
+			NL80211_IFTYPE_MONITOR, false), CONNECTION_INFRA_AP);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_omac_type(test,
+			NL80211_IFTYPE_STATION, false), CONNECTION_INFRA_STA);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_omac_type(test,
+			NL80211_IFTYPE_STATION, true), CONNECTION_P2P_GC);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_omac_type(test,
+			NL80211_IFTYPE_ADHOC, false), CONNECTION_IBSS_ADHOC);
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP,
+				       EXT_BSSID_START + 3);
+	skb = mt76_connac_mcu_test_skb(test, 4);
+	mt76_connac_mcu_bss_omac_tlv(skb, vif);
+	omac = mt76_connac_mcu_test_skb_tlv(test, skb, 4, BSS_INFO_OMAC);
+	KUNIT_ASSERT_NOT_NULL(test, omac);
+	KUNIT_EXPECT_EQ(test, omac->omac_idx, EXT_BSSID_START + 3);
+	KUNIT_EXPECT_EQ(test, omac->hw_bss_idx, HW_BSSID_0);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_ntlv(skb->data), 1);
+}
