+/* A frame whose tx status we want: reported to the host, never in an
+ * A-MSDU; no-ack and power management queue variants.
+ */
+static void mt76_connac_test_txwi_status(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 9);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct ieee80211_tx_info *info;
+	struct sk_buff *skb;
+	__le32 txwi[16];
+
+	skb = mt76_connac_test_frame(test, MT76_CONNAC_TEST_QOS_DATA,
+				     mt76_connac_test_peer, 60);
+	skb_set_queue_mapping(skb, IEEE80211_AC_BE);
+	info = IEEE80211_SKB_CB(skb);
+	info->flags = IEEE80211_TX_CTL_NO_ACK;
+	wcid->amsdu = 1;
+
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL, 7, MT_TXQ_BE,
+				    0);
+	/* no interface: own MAC 0, WMM set 0, BE is LMAC queue 1 */
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_Q_IDX,
+					mt76_connac_test_dw(txwi, 0)), 1);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_OWN_MAC,
+					mt76_connac_test_dw(txwi, 1)), 0);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 3),
+			FIELD_PREP(MT_TXD3_REM_TX_COUNT, 15) |
+			MT_TXD3_SW_POWER_MGMT | MT_TXD3_NO_ACK);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 5),
+			FIELD_PREP(MT_TXD5_PID, 7) | MT_TXD5_TX_STATUS_HOST);
+	KUNIT_EXPECT_FALSE(test, mt76_connac_test_dw(txwi, 7) &
+			   MT_TXD7_HW_AMSDU);
+
+	/* frames for the PS queue go to the ALTX queue */
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL, 7, MT_TXQ_PSD,
+				    0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_Q_IDX,
+					mt76_connac_test_dw(txwi, 0)),
+			MT_LMAC_ALTX0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_PKT_FMT,
+					mt76_connac_test_dw(txwi, 0)),
+			MT_TX_TYPE_CT);
+}
