+/* HT and VHT: MCS, streams (halved for STBC), GI and bandwidth. */
+static void mt76_connac_test_rx_rate_ht_vht(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
