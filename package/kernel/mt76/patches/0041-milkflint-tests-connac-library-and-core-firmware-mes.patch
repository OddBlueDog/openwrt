+static u32 mt76_connac_mcu_test_omac_type(struct kunit *test,
+					  enum nl80211_iftype type, bool p2p)
+{
+	struct ieee80211_vif *vif = mt76_connac_mcu_test_vif(test, type, 2);
+	struct sk_buff *skb = mt76_connac_mcu_test_skb(test, 4);
+	struct bss_info_omac *omac;
+
+	vif->p2p = p2p;
+	mt76_connac_mcu_bss_omac_tlv(skb, vif);
+	omac = mt76_connac_mcu_test_skb_tlv(test, skb, 4, BSS_INFO_OMAC);
