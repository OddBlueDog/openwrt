+/* Legacy frames: the index into the band's rate table. */
+static void mt76_connac_test_rx_rate_legacy(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_rx_status status;
+	u8 mode;
+
+	/* 5.5 Mbps CCK on 2.4 GHz */
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status,
+			&dev->phy.sband_2g.sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_CCK, 2, 1, 0, 0, 0,
+					      false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, mode, MT_PHY_TYPE_CCK);
+	KUNIT_EXPECT_EQ(test, (int)status.encoding, RX_ENC_LEGACY);
+	KUNIT_EXPECT_EQ(test, status.rate_idx, 2);
+	KUNIT_EXPECT_EQ(test, (int)status.bw, RATE_INFO_BW_20);
+
+	/* 48 Mbps OFDM on 5 GHz (hw rate 8) */
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status,
+			&dev->phy.sband_5g.sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_OFDM, 8, 1, 0, 0, 0,
+					      false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, status.rate_idx, 6);
+	KUNIT_EXPECT_EQ(test, status.enc_flags, 0);
+}
