+struct mt76_connac_test_reg {
+	struct mt76_dev *dev;
+	struct mt76_wcid wcid;
+};
+
+static void mt76_connac_test_put_wcid(void *data)
+{
+	struct mt76_connac_test_reg *reg = data;
+
+	rcu_assign_pointer(reg->dev->wcid[reg->wcid.idx], NULL);
+	idr_destroy(&reg->wcid.pktid);
+}
+
+/* a wcid registered with @dev at @idx; no mac80211 station behind it */
+static struct mt76_wcid *mt76_connac_test_reg_wcid(struct kunit *test,
+						   struct mt76_dev *dev,
+						   u16 idx)
+{
+	struct mt76_connac_test_reg *reg;
+
+	reg = kunit_kzalloc(test, sizeof(*reg), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, reg);
+	reg->dev = dev;
+	mt76_wcid_init(&reg->wcid, 0);
+	reg->wcid.idx = idx;
+	rcu_assign_pointer(dev->wcid[idx], &reg->wcid);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_connac_test_put_wcid, reg), 0);
+	return &reg->wcid;
+}
