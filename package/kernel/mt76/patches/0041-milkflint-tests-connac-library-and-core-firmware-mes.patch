+/* connac v1 also programs the peer's short GI support straight into WTBL
+ * word 5.
+ */
+static void mt76_connac_mcu_test_wtbl_ht_v1(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 1);
+	struct ieee80211_link_sta *link = &sta->deflink;
+	u32 msk = MT_WTBL_W5_SHORT_GI_20 | MT_WTBL_W5_SHORT_GI_40 |
+		  MT_WTBL_W5_SHORT_GI_80 | MT_WTBL_W5_SHORT_GI_160;
+	struct wtbl_raw *raw;
+	struct sk_buff *skb;
+	struct tlv *sta_wtbl;
+	void *wtbl_hdr;
+
+	dev->rev = MT76_CONNAC_MCU_TEST_V1_REV;
+	link->ht_cap.ht_supported = true;
+	link->ht_cap.cap = IEEE80211_HT_CAP_SGI_20 | IEEE80211_HT_CAP_SGI_40;
+	link->vht_cap.vht_supported = true;
+	link->vht_cap.cap = IEEE80211_VHT_CAP_SHORT_GI_80 |
+			    IEEE80211_VHT_CAP_SHORT_GI_160;
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_ht_tlv(dev, skb, sta, sta_wtbl, wtbl_hdr, true,
+				    true);
+	raw = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_RAW_DATA);
+	KUNIT_ASSERT_NOT_NULL(test, raw);
+	KUNIT_EXPECT_EQ(test, raw->wtbl_idx, 1);
+	KUNIT_EXPECT_EQ(test, raw->dw, 5);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(raw->msk), ~msk);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(raw->val), msk);
+
+	/* HT only, 20 MHz short GI only */
+	link->ht_cap.cap = IEEE80211_HT_CAP_SGI_20;
+	link->vht_cap.vht_supported = false;
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_ht_tlv(dev, skb, sta, sta_wtbl, wtbl_hdr, true,
+				    true);
+	raw = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_RAW_DATA);
+	KUNIT_ASSERT_NOT_NULL(test, raw);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(raw->val), MT_WTBL_W5_SHORT_GI_20);
+}
