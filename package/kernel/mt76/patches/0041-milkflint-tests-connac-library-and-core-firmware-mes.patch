+/* Beacons and in-band discovery frames go to the firmware's queues; a
+ * beacon isn't power-managed and goes at the beacon rate.
+ */
+static void mt76_connac_test_txwi_beacon(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_vif *vif = mt76_connac_test_vif(test,
+							 NL80211_IFTYPE_AP);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 1);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct ieee80211_tx_info *info;
+	struct sk_buff *skb;
+	__le32 txwi[16];
+	u32 dw;
+
+	vif->bss_conf.basic_rates = BIT(0);
+	vif->bss_conf.beacon_tx_rate.control[NL80211_BAND_5GHZ].legacy =
+		BIT(4);
+	skb = mt76_connac_test_frame(test, IEEE80211_FTYPE_MGMT |
+				     IEEE80211_STYPE_BEACON,
+				     mt76_connac_test_bcast, 80);
+	info = IEEE80211_SKB_CB(skb);
+	info->control.vif = vif;
+
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BEACON,
+				    BSS_CHANGED_BEACON);
+	dw = mt76_connac_test_dw(txwi, 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_PKT_FMT, dw), MT_TX_TYPE_FW);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_Q_IDX, dw), MT_LMAC_BCN0);
+	/* beacons: not power-managed, the remaining tx count field all set */
+	dw = mt76_connac_test_dw(txwi, 3);
+	KUNIT_EXPECT_FALSE(test, dw & MT_TXD3_SW_POWER_MGMT);
+	KUNIT_EXPECT_EQ(test, dw & MT_TXD3_REM_TX_COUNT, MT_TXD3_REM_TX_COUNT);
+	dw = mt76_connac_test_dw(txwi, 2);
+	KUNIT_EXPECT_TRUE(test, dw & MT_TXD2_MULTICAST);
+	KUNIT_EXPECT_TRUE(test, dw & MT_TXD2_FIX_RATE);
+	/* the beacon rate: 24 Mbps */
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD6_TX_RATE,
+					mt76_connac_test_dw(txwi, 6)),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 9, 0));
+
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BEACON,
+				    BSS_CHANGED_BEACON_ENABLED);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_Q_IDX,
+					mt76_connac_test_dw(txwi, 0)),
+			MT_LMAC_BCN0);
+
+	/* FILS discovery / unsolicited probe responses: ALTX, by firmware */
+	skb = mt76_connac_test_frame(test, IEEE80211_FTYPE_MGMT |
+				     IEEE80211_STYPE_PROBE_RESP,
+				     mt76_connac_test_bcast, 80);
+	IEEE80211_SKB_CB(skb)->control.vif = vif;
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BEACON,
+				    BSS_CHANGED_FILS_DISCOVERY |
+				    BSS_CHANGED_BEACON);
+	dw = mt76_connac_test_dw(txwi, 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_PKT_FMT, dw), MT_TX_TYPE_FW);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_Q_IDX, dw), MT_LMAC_ALTX0);
+	KUNIT_EXPECT_TRUE(test, mt76_connac_test_dw(txwi, 3) &
+			  MT_TXD3_SW_POWER_MGMT);
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, NULL,
+				    MT_PACKET_ID_NO_ACK, MT_TXQ_BEACON,
+				    BSS_CHANGED_UNSOL_BCAST_PROBE_RESP);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_Q_IDX,
+					mt76_connac_test_dw(txwi, 0)),
+			MT_LMAC_ALTX0);
+}
