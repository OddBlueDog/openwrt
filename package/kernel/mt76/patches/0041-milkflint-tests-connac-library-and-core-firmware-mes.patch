+/* U-APSD is only set up for our AP's WMM stations: the delivery- and
+ * trigger-enabled ACs, in the firmware's bit order (BK = bit 0).
+ */
+static void mt76_connac_mcu_test_sta_uapsd(struct kunit *test)
+{
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 1);
+	struct ieee80211_vif *vif;
+	struct sta_rec_uapsd *uapsd;
+	struct sk_buff *skb;
+	int hdr = sizeof(struct sta_req_hdr);
+
+	sta->uapsd_queues = IEEE80211_WMM_IE_STA_QOSINFO_AC_VO |
+			    IEEE80211_WMM_IE_STA_QOSINFO_AC_BE;
+	sta->max_sp = 2;
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_STATION, 0);
+	skb = mt76_connac_mcu_test_skb(test, hdr);
+	mt76_connac_mcu_sta_uapsd(skb, vif, sta);
+	KUNIT_EXPECT_EQ(test, skb->len, hdr);
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 0);
+	sta->wme = false;
+	mt76_connac_mcu_sta_uapsd(skb, vif, sta);
+	KUNIT_EXPECT_EQ(test, skb->len, hdr);
+
+	sta->wme = true;
+	mt76_connac_mcu_sta_uapsd(skb, vif, sta);
+	uapsd = mt76_connac_mcu_test_skb_tlv(test, skb, hdr, STA_REC_APPS);
+	KUNIT_ASSERT_NOT_NULL(test, uapsd);
+	KUNIT_EXPECT_EQ(test, uapsd->dac_map, BIT(3) | BIT(1));
+	KUNIT_EXPECT_EQ(test, uapsd->tac_map, BIT(3) | BIT(1));
+	KUNIT_EXPECT_EQ(test, uapsd->max_sp, 2);
+
+	skb = mt76_connac_mcu_test_skb(test, hdr);
+	sta->uapsd_queues = IEEE80211_WMM_IE_STA_QOSINFO_AC_VI |
+			    IEEE80211_WMM_IE_STA_QOSINFO_AC_BK;
+	mt76_connac_mcu_sta_uapsd(skb, vif, sta);
+	uapsd = mt76_connac_mcu_test_skb_tlv(test, skb, hdr, STA_REC_APPS);
+	KUNIT_ASSERT_NOT_NULL(test, uapsd);
+	KUNIT_EXPECT_EQ(test, uapsd->dac_map, BIT(2) | BIT(0));
+	KUNIT_EXPECT_EQ(test, uapsd->tac_map, BIT(2) | BIT(0));
+}
+
+/* BA session TLV: direction, window, start sequence, TID bit, A-MSDU. */
+static void mt76_connac_mcu_test_sta_ba_tlv(struct kunit *test)
+{
+	struct ieee80211_ampdu_params params = {
+		.tid = 5,
+		.ssn = 0x123,
+		.buf_size = 256,
+		.amsdu = true,
+	};
+	struct sk_buff *skb = mt76_connac_mcu_test_skb(test, 8);
+	struct sta_rec_ba *ba;
+
+	mt76_connac_mcu_sta_ba_tlv(skb, &params, true, true);
+	ba = mt76_connac_mcu_test_skb_tlv(test, skb, 8, STA_REC_BA);
+	KUNIT_ASSERT_NOT_NULL(test, ba);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->len), sizeof(*ba));
+	KUNIT_EXPECT_EQ(test, ba->ba_type, MT_BA_TYPE_ORIGINATOR);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->winsize), 256);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->ssn), 0x123);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, BIT(5));
+	KUNIT_EXPECT_EQ(test, ba->amsdu, 1);
+	KUNIT_EXPECT_EQ(test, ba->tid, 5);
+
+	skb = mt76_connac_mcu_test_skb(test, 8);
+	params.amsdu = false;
+	mt76_connac_mcu_sta_ba_tlv(skb, &params, false, false);
+	ba = mt76_connac_mcu_test_skb_tlv(test, skb, 8, STA_REC_BA);
+	KUNIT_ASSERT_NOT_NULL(test, ba);
+	KUNIT_EXPECT_EQ(test, ba->ba_type, MT_BA_TYPE_RECIPIENT);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, 0);
+	KUNIT_EXPECT_EQ(test, ba->amsdu, 0);
+}
+
+/* --- WTBL TLVs --------------------------------------------------------- */
+
+/* A skb with a station request holding a STA_REC_WTBL TLV and its WTBL
+ * request header, as the station commands build it.
+ */
+static struct sk_buff *mt76_connac_mcu_test_wtbl_skb(struct kunit *test,
+						     struct tlv **sta_wtbl,
+						     void **wtbl_hdr)
+{
+	struct sk_buff *skb = mt76_connac_mcu_test_skb(test,
+					sizeof(struct sta_req_hdr));
+
+	*sta_wtbl = mt76_connac_mcu_add_tlv(skb, STA_REC_WTBL,
+					    sizeof(struct tlv));
+	*wtbl_hdr = skb_put_zero(skb, sizeof(struct wtbl_req_hdr));
+	le16_add_cpu(&(*sta_wtbl)->len, sizeof(struct wtbl_req_hdr));
+	return skb;
+}
+
+/* Header translation: which DS bits frames to this peer carry, and whether
+ * received frames are translated to 802.3 for it.
+ */
+static void mt76_connac_mcu_test_wtbl_hdr_trans(struct kunit *test)
+{
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 1);
+	struct mt76_wcid *wcid = mt76_connac_mcu_test_wcid(sta);
+	struct wtbl_hdr_trans *htr;
+	struct ieee80211_vif *ap, *sta_vif;
+	struct sk_buff *skb;
+	struct tlv *sta_wtbl;
+	void *wtbl_hdr;
+
+	ap = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 0);
+	sta_vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_STATION, 0);
+
+#define HTR(_vif, _wcid) do {						\
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr); \
+	mt76_connac_mcu_wtbl_hdr_trans_tlv(skb, _vif, _wcid, sta_wtbl,	\
+					   wtbl_hdr);			\
+	htr = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_HDR_TRANS); \
+	KUNIT_ASSERT_NOT_NULL(test, htr);				\
+} while (0)
+
+	/* no peer: from our AP / to our AP, no rx translation */
+	HTR(ap, NULL);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(htr->len), sizeof(*htr));
+	KUNIT_EXPECT_EQ(test, htr->from_ds, 1);
+	KUNIT_EXPECT_EQ(test, htr->to_ds, 0);
+	KUNIT_EXPECT_EQ(test, htr->no_rx_trans, 1);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_ntlv(wtbl_hdr), 1);
+	HTR(sta_vif, NULL);
+	KUNIT_EXPECT_EQ(test, htr->from_ds, 0);
+	KUNIT_EXPECT_EQ(test, htr->to_ds, 1);
+
+	/* a peer that wants rx translation */
+	set_bit(MT_WCID_FLAG_HDR_TRANS, &wcid->flags);
+	HTR(ap, wcid);
+	KUNIT_EXPECT_EQ(test, htr->no_rx_trans, 0);
+	KUNIT_EXPECT_EQ(test, htr->from_ds, 1);
+	KUNIT_EXPECT_EQ(test, htr->to_ds, 0);
+
+	/* a 4-address (WDS) peer */
+	clear_bit(MT_WCID_FLAG_HDR_TRANS, &wcid->flags);
+	set_bit(MT_WCID_FLAG_4ADDR, &wcid->flags);
+	HTR(ap, wcid);
+	KUNIT_EXPECT_EQ(test, htr->no_rx_trans, 1);
+	KUNIT_EXPECT_EQ(test, htr->from_ds, 1);
+	KUNIT_EXPECT_EQ(test, htr->to_ds, 1);
+
+	/* a TDLS peer talks directly */
+	set_bit(MT_WCID_FLAG_TDLS_PEER, &wcid->flags);
+	HTR(sta_vif, wcid);
+	KUNIT_EXPECT_EQ(test, htr->from_ds, 0);
+	KUNIT_EXPECT_EQ(test, htr->to_ds, 0);
+#undef HTR
+}
+
+/* Updating a station's header translation is a WTBL update of that one
+ * entry with just the translation TLV.
+ */
+static void mt76_connac_mcu_test_wtbl_update_hdr_trans(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 0x1ab);
+	struct ieee80211_vif *vif;
+	struct wtbl_hdr_trans *htr;
+	struct wtbl_req_hdr *hdr;
+	struct mt76_test_msg *msg;
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 0);
+	set_bit(MT_WCID_FLAG_HDR_TRANS,
+		&mt76_connac_mcu_test_wcid(sta)->flags);
+
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_wtbl_update_hdr_trans(dev, vif,
+								    sta), 0);
+	msg = mt76_test_find_msg(mt76_test_fake, MCU_EXT_CMD(WTBL_UPDATE));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_ASSERT_EQ(test, msg->len, sizeof(*hdr) + sizeof(*htr));
+	hdr = (struct wtbl_req_hdr *)msg->data;
+	KUNIT_EXPECT_EQ(test, hdr->operation, WTBL_SET);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_lo, 0xab);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_hi, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(hdr->tlv_num), 1);
+	htr = mt76_connac_mcu_test_msg_tlv(test, msg, sizeof(*hdr),
+					   WTBL_HDR_TRANS);
+	KUNIT_ASSERT_NOT_NULL(test, htr);
+	KUNIT_EXPECT_EQ(test, htr->no_rx_trans, 0);
+	KUNIT_EXPECT_EQ(test, htr->from_ds, 1);
+
+	mt76_test_fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_wtbl_update_hdr_trans(dev, vif,
+								    sta), -EIO);
+}
+
+/* The generic WTBL entry: the peer's address, AID, own-MAC index and QoS,
+ * and the rx address checks (A1 is checked except on our AP).
+ */
+static void mt76_connac_mcu_test_wtbl_generic(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 1);
+	struct ieee80211_vif *ap, *sta_vif;
+	struct wtbl_generic *generic;
+	struct sk_buff *skb;
+	struct tlv *sta_wtbl;
+	struct wtbl_rx *rx;
+	void *wtbl_hdr;
+
+	ap = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 4);
+	sta_vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_STATION, 4);
+	sta_vif->cfg.aid = 42;
+	sta_vif->bss_conf.bssid = mt76_connac_mcu_test_bssid;
+
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_generic_tlv(dev, skb, ap, sta, sta_wtbl,
+					 wtbl_hdr);
+	generic = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_GENERIC);
+	KUNIT_ASSERT_NOT_NULL(test, generic);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(generic->len), sizeof(*generic));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(generic->partial_aid), 7);
+	KUNIT_EXPECT_MEMEQ(test, generic->peer_addr, mt76_connac_mcu_test_peer,
+			   ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, generic->muar_idx, 4);
+	KUNIT_EXPECT_EQ(test, generic->qos, 1);
+	rx = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_RX);
+	KUNIT_ASSERT_NOT_NULL(test, rx);
+	KUNIT_EXPECT_EQ(test, rx->rca1, 0);
+	KUNIT_EXPECT_EQ(test, rx->rca2, 1);
+	KUNIT_EXPECT_EQ(test, rx->rv, 1);
+	/* no SPE entry outside connac v1 */
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_ntlv(wtbl_hdr), 2);
+
+	/* our station: its AP, with our AID */
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_generic_tlv(dev, skb, sta_vif, sta, sta_wtbl,
+					 wtbl_hdr);
+	generic = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_GENERIC);
+	KUNIT_ASSERT_NOT_NULL(test, generic);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(generic->partial_aid), 42);
+	rx = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_RX);
+	KUNIT_ASSERT_NOT_NULL(test, rx);
+	KUNIT_EXPECT_EQ(test, rx->rca1, 1);
+
+	/* a non-WMM peer */
+	sta->wme = false;
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_generic_tlv(dev, skb, ap, sta, sta_wtbl,
+					 wtbl_hdr);
+	generic = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_GENERIC);
+	KUNIT_ASSERT_NOT_NULL(test, generic);
+	KUNIT_EXPECT_EQ(test, generic->qos, 0);
+
+	/* the BSS entry of a station interface points at the BSSID */
+	skb = mt76_connac_mcu_test_wtbl_skb(test, &sta_wtbl, &wtbl_hdr);
+	mt76_connac_mcu_wtbl_generic_tlv(dev, skb, sta_vif, NULL, sta_wtbl,
+					 wtbl_hdr);
