+/* --- connac2 message header ----------------------------------------------- */
+
+/* a message as mt76_mcu_msg_alloc() makes it: zeroed headroom for the TXD */
+static struct sk_buff *mt76_connac_mcu_test_cmd_skb(struct kunit *test,
+						    int len)
+{
+	struct sk_buff *skb = mt76_connac_mcu_test_skb(test, 0);
+
+	memset(skb->data, 0, skb_tailroom(skb));
+	skb_reserve(skb, sizeof(struct mt76_connac2_mcu_txd));
+	skb_put_zero(skb, len);
+	return skb;
+}
+
+/* An extended command: the TXD says how long it is and that it's a
+ * command for the MCU port, then the command ids, a set, and an ack.
+ */
+static void mt76_connac_mcu_test_fill_ext(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct sk_buff *skb = mt76_connac_mcu_test_cmd_skb(test, 10);
+	struct mt76_connac2_mcu_txd *txd;
+	int seq = -1;
+	u32 val;
+
+	KUNIT_ASSERT_EQ(test, mt76_connac2_mcu_fill_message(dev, skb,
+			MCU_EXT_CMD(PM_STATE_CTRL), &seq), 0);
+	KUNIT_ASSERT_EQ(test, skb->len, sizeof(*txd) + 10);
+	txd = (struct mt76_connac2_mcu_txd *)skb->data;
+
+	val = le32_to_cpu(txd->txd[0]);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_TX_BYTES, val), skb->len);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_PKT_FMT, val), MT_TX_TYPE_CMD);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_Q_IDX, val),
+			MT_TX_MCU_PORT_RX_Q0);
+	val = le32_to_cpu(txd->txd[1]);
+	KUNIT_EXPECT_EQ(test, val, MT_TXD1_LONG_FORMAT |
+			FIELD_PREP(MT_TXD1_HDR_FORMAT, MT_HDR_FORMAT_CMD));
+
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txd->len), skb->len - 32);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txd->pq_id), 0x8000);
+	KUNIT_EXPECT_EQ(test, txd->pkt_type, MCU_PKT_ID);
+	KUNIT_EXPECT_EQ(test, txd->cid, MCU_CMD_EXT_CID);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid, MCU_EXT_CMD_PM_STATE_CTRL);
+	KUNIT_EXPECT_EQ(test, txd->set_query, MCU_Q_SET);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid_ack, 1);
+	KUNIT_EXPECT_EQ(test, txd->s2d_index, MCU_S2D_H2N);
+	KUNIT_EXPECT_EQ(test, txd->seq, 1);
+	KUNIT_EXPECT_EQ(test, seq, 1);
+	/* the firmware can take its time */
+	KUNIT_EXPECT_EQ(test, dev->mcu.timeout, 20 * HZ);
+}
+
+/* Queries, CE and plain commands, and commands for the WA CPU differ in
+ * the set/query, ack and destination fields only.
+ */
+static void mt76_connac_mcu_test_fill_kinds(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct mt76_connac2_mcu_txd *txd;
+	struct sk_buff *skb;
+
+#define FILL(_cmd) ({							\
+	skb = mt76_connac_mcu_test_cmd_skb(test, 4);			\
+	KUNIT_ASSERT_EQ(test, mt76_connac2_mcu_fill_message(dev, skb,	\
+							    _cmd, NULL), 0); \
+	(struct mt76_connac2_mcu_txd *)skb->data;			\
+})
+	txd = FILL(MCU_EXT_QUERY(PM_STATE_CTRL));
+	KUNIT_EXPECT_EQ(test, txd->set_query, MCU_Q_QUERY);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid_ack, 1);
+
+	txd = FILL(MCU_CE_CMD(REG_WRITE));
+	KUNIT_EXPECT_EQ(test, txd->cid, MCU_CE_CMD_REG_WRITE);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid, 0);
+	KUNIT_EXPECT_EQ(test, txd->set_query, MCU_Q_SET);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid_ack, 0);
+
+	txd = FILL(MCU_CE_QUERY(REG_READ));
+	KUNIT_EXPECT_EQ(test, txd->set_query, MCU_Q_QUERY);
+
+	txd = FILL(MCU_CMD(PATCH_SEM_CONTROL));
+	KUNIT_EXPECT_EQ(test, txd->cid, MCU_CMD_PATCH_SEM_CONTROL);
+	KUNIT_EXPECT_EQ(test, txd->set_query, MCU_Q_NA);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid_ack, 0);
+	KUNIT_EXPECT_EQ(test, txd->s2d_index, MCU_S2D_H2N);
+
+	txd = FILL(MCU_WA_EXT_CMD(PM_STATE_CTRL));
+	KUNIT_EXPECT_EQ(test, txd->s2d_index, MCU_S2D_H2C);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid, MCU_EXT_CMD_PM_STATE_CTRL);
+#undef FILL
+}
