+/* Unified commands have a header of their own. */
+static void mt76_connac_mcu_test_fill_uni(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct sk_buff *skb = mt76_connac_mcu_test_cmd_skb(test, 12);
+	struct mt76_connac2_mcu_uni_txd *txd;
+	int seq;
+
+	KUNIT_ASSERT_EQ(test, mt76_connac2_mcu_fill_message(dev, skb,
+			MCU_UNI_CMD(BSS_INFO_UPDATE), &seq), 0);
+	KUNIT_ASSERT_EQ(test, skb->len, sizeof(*txd) + 12);
+	txd = (struct mt76_connac2_mcu_uni_txd *)skb->data;
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_TX_BYTES,
+					le32_to_cpu(txd->txd[0])), skb->len);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txd->len), skb->len - 32);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txd->cid),
+			MCU_UNI_CMD_BSS_INFO_UPDATE);
+	KUNIT_EXPECT_EQ(test, txd->option, MCU_CMD_UNI_EXT_ACK);
+	KUNIT_EXPECT_EQ(test, txd->s2d_index, MCU_S2D_H2N);
+	KUNIT_EXPECT_EQ(test, txd->pkt_type, MCU_PKT_ID);
+	KUNIT_EXPECT_EQ(test, txd->seq, seq);
+}
+
+/* Firmware chunks go out bare, but still use up a sequence number; the
+ * 4-bit sequence never uses 0.
+ */
+static void mt76_connac_mcu_test_fill_seq(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct sk_buff *skb = mt76_connac_mcu_test_cmd_skb(test, 8);
+	int seq;
+
+	dev->mcu.msg_seq = 0xe;
+	KUNIT_ASSERT_EQ(test, mt76_connac2_mcu_fill_message(dev, skb,
+			MCU_CMD(FW_SCATTER), &seq), 0);
+	KUNIT_EXPECT_EQ(test, skb->len, 8);
+	KUNIT_EXPECT_EQ(test, seq, 0xf);
+
+	KUNIT_ASSERT_EQ(test, mt76_connac2_mcu_fill_message(dev, skb,
+			MCU_CMD(FW_SCATTER), &seq), 0);
+	KUNIT_EXPECT_EQ(test, seq, 1);
+	KUNIT_ASSERT_EQ(test, mt76_connac2_mcu_fill_message(dev, skb,
+			MCU_CMD(FW_SCATTER), &seq), 0);
+	KUNIT_EXPECT_EQ(test, seq, 2);
+}
