From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Mon, 19 Oct 2026 05:04:22 +0100
Subject: [PATCH] milkflint tests: connac library and core firmware messages

120 KUnit tests, all on the fake hardware. In-scope coverage:
- mt76_connac_mcu.c: 0% -> 98.6%
- mt76_connac_mac.c: 8.3% -> 99.2%
- core mcu.c: 62% -> 100%

- mt76-mcu (core mcu.c):
  - allocating messages;
  - waiting for the matching reply: deadline, reset wake-up, stale seqs;
  - retries and timeouts;
  - prepare and send errors, with skb refcounts checked on every path;
  - bus_hung;
  - splitting firmware images into chunks.
- mt76-connac-mcu:
  - the payload of every simple command;
  - sta/wtbl request headers and the nested TLV accounting;
  - the BSS and STA TLVs and the WTBL TLVs (connac v1 variants too);
  - block ack and keys;
  - phy mode and HE caps;
  - ROM patch and RAM download from real firmware files written into the
    VM, with every error path;
  - the connac2 TXD header for each command type.
- mt76-connac-mac:
  - the full TXD for data, management, beacon and in-band discovery
    frames, multicast, BIP, ADDBA/BAR, fragments, injected frames and
    802.3 frames;
  - tx status in every mode, and tx completion, txwi free and tokens;
  - rx rate decoding, HE radiotap and the mesh header rebuild;
  - PPE thresholds.

fake.h: mt76_test_dev()'s default mac80211 ops now include the channel
context emulation, without which this mac80211 refuses to allocate the hw.

Four tests are skipped. Each one shows a suspected driver bug:
- HE tx status with DCM is rejected as "MCS > 11", because
  MT_TX_RATE_IDX includes the DCM bit. Those frames never reach the
  station's tx rate and stats on the MT7986.
- rx STBC is reported as RX_ENC_FLAG_STBC_MASK * stbc (radiotap only).
- HE-MU radiotap encodes the SIG-A bandwidth from status->bw after the RU
  decode has changed it (radiotap only).
- The connac2 HE-MU radiotap path ORs bits into a function-static
  template, so they leak to other devices.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mcu.c                   |    4 +
 mt76_connac_mcu.c       |    4 +
 tests/connac-mac-test.c | 2454 +++++++++++++++++++++++++++++++++++-
 tests/connac-mcu-test.c | 2662 +++++++++++++++++++++++++++++++++++++++
 tests/fake.h            |    8 +-
 tests/mcu-test.c        |  727 +++++++++++
 6 files changed, 5855 insertions(+), 4 deletions(-)
 create mode 100644 tests/connac-mcu-test.c
 create mode 100644 tests/mcu-test.c

diff --git a/mcu.c b/mcu.c
index 7149b2f7..ad44136f 100644
--- a/mcu.c
+++ b/mcu.c
@@ -163,3 +163,7 @@ int __mt76_mcu_send_firmware(struct mt76_dev *dev, int cmd, const void *data,
 	return 0;
 }
 EXPORT_SYMBOL_GPL(__mt76_mcu_send_firmware);
+
+#if IS_ENABLED(CONFIG_MT76_KUNIT_TEST)
+#include "tests/mcu-test.c"
+#endif
diff --git a/mt76_connac_mcu.c b/mt76_connac_mcu.c
index 2339ef38..3807f58b 100644
--- a/mt76_connac_mcu.c
+++ b/mt76_connac_mcu.c
@@ -3558,3 +3558,7 @@ EXPORT_SYMBOL_GPL(mt76_connac2_mcu_fill_message);
 MODULE_AUTHOR("Lorenzo Bianconi <lorenzo@kernel.org>");
 MODULE_DESCRIPTION("MediaTek MT76x connac layer helpers");
 MODULE_LICENSE("Dual BSD/GPL");
+
+#if IS_ENABLED(CONFIG_MT76_KUNIT_TEST)
+#include "tests/connac-mcu-test.c"
+#endif
diff --git a/tests/connac-mac-test.c b/tests/connac-mac-test.c
index 09d3282a..1b5500af 100644
--- a/tests/connac-mac-test.c
+++ b/tests/connac-mac-test.c
@@ -1,10 +1,18 @@
 // SPDX-License-Identifier: BSD-3-Clause-Clear
 /*
- * KUnit tests for connac2 mac helpers. Included at the end of
- * mt76_connac_mac.c when CONFIG_MT76_KUNIT_TEST is defined (milkflint's
- * QEMU test build only).
+ * KUnit tests for connac2 mac helpers: the tx descriptor (TXD) the MT7986
+ * builds for every frame, tx status and rate reporting, rx rate and
+ * radiotap decoding, the 802.3 -> 802.11 header rebuild for mesh, tx
+ * token and descriptor cleanup. Included at the end of mt76_connac_mac.c
+ * when CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU test build only).
+ *
+ * Devices get the MT7986's chip id (the mt7915 family: not "connac2",
+ * which in mt76 means the mt7921 family); a few tests switch the id to
+ * reach other chips' branches of the same functions.
  */
 #include <kunit/test.h>
+#include <linux/dma-mapping.h>
+#include "fake.h"
 
 static __le32 mt76_test_txs0(bool fixed, u8 mcs, u8 nss, u8 bw)
 {
@@ -65,9 +73,2449 @@ static void mt76_test_token_put_clears_wed_count(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, dev->token_count, 0);
 }
 
+/* --- a device ------------------------------------------------------------- */
+
+#define MT76_CONNAC_TEST_REV	0x79860000	/* MT7986 */
+#define MT76_CONNAC_TEST_C2_REV	0x79610000	/* MT7921: "connac2" */
+#define MT76_CONNAC_TEST_TXWI	(MT_TXD_SIZE + \
+				 sizeof(struct mt76_connac_txp_common))
+
+/* fake.h's mt76_test_hw_ops, plus the channel context ops this mac80211
+ * insists on (ieee80211_alloc_hw() refuses ops without them)
+ */
+static const struct ieee80211_ops mt76_connac_test_hw_ops = {
+	.tx = mt76_test_tx,
+	.start = mt76_test_start,
+	.stop = mt76_test_stop,
+	.add_interface = mt76_test_add_interface,
+	.remove_interface = mt76_test_remove_interface,
+	.config = mt76_test_config,
+	.configure_filter = mt76_test_configure_filter,
+	.wake_tx_queue = mt76_test_wake_tx_queue,
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
+};
+
+/* mt7915's tx descriptor layout: the TXD, then the firmware TXP */
+static const struct mt76_driver_ops mt76_connac_test_drv_ops = {
+	.txwi_size = MT76_CONNAC_TEST_TXWI,
+	.token_size = 64,
+};
+
+static struct ieee80211_channel mt76_connac_test_chan_2g = {
+	.band = NL80211_BAND_2GHZ,
+	.center_freq = 2437,
+	.hw_value = 6,
+};
+
+static struct ieee80211_channel mt76_connac_test_chan_5g = {
+	.band = NL80211_BAND_5GHZ,
+	.center_freq = 5180,
+	.hw_value = 36,
+};
+
+static struct ieee80211_channel mt76_connac_test_chan_6g = {
+	.band = NL80211_BAND_6GHZ,
+	.center_freq = 5955,
+	.hw_value = 1,
+};
+
+/* the bands as mt76_register_device() sets them up: CCK + OFDM on 2.4 GHz,
+ * OFDM only elsewhere
+ */
+static void mt76_connac_test_sbands(struct mt76_phy *phy)
+{
+	phy->sband_2g.sband.band = NL80211_BAND_2GHZ;
+	phy->sband_2g.sband.bitrates = mt76_rates;
+	phy->sband_2g.sband.n_bitrates = 12;
+	phy->sband_5g.sband.band = NL80211_BAND_5GHZ;
+	phy->sband_5g.sband.bitrates = mt76_rates + 4;
+	phy->sband_5g.sband.n_bitrates = 8;
+	phy->sband_6g.sband.band = NL80211_BAND_6GHZ;
+	phy->sband_6g.sband.bitrates = mt76_rates + 4;
+	phy->sband_6g.sband.n_bitrates = 8;
+}
+
+/* An MT7986 on the fakes, on a 5 GHz channel with two antennas. */
+static struct mt76_dev *mt76_connac_test_dev(struct kunit *test)
+{
+	struct mt76_dev *dev;
+
+	dev = mt76_test_dev(test, sizeof(*dev), &mt76_connac_test_hw_ops,
+			    &mt76_connac_test_drv_ops);
+	dev->rev = MT76_CONNAC_TEST_REV;
+	dev->phy.chandef.chan = &mt76_connac_test_chan_5g;
+	dev->phy.antenna_mask = 0x3;
+	mt76_connac_test_sbands(&dev->phy);
+	return dev;
+}
+
+/* a second phy as band 1, on @chan */
+static struct mt76_phy *mt76_connac_test_band1(struct kunit *test,
+					       struct mt76_dev *dev,
+					       struct ieee80211_channel *chan)
+{
+	struct mt76_phy *phy = kunit_kzalloc(test, sizeof(*phy), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	phy->dev = dev;
+	phy->hw = dev->hw;
+	phy->band_idx = MT_BAND1;
+	phy->chandef.chan = chan;
+	mt76_connac_test_sbands(phy);
+	dev->phys[MT_BAND1] = phy;
+	return phy;
+}
+
+static struct ieee80211_vif *
+mt76_connac_test_vif(struct kunit *test, enum nl80211_iftype type)
+{
+	struct mt76_vif_link *mvif;
+	struct ieee80211_vif *vif;
+
+	vif = kunit_kzalloc(test, sizeof(*vif) + sizeof(*mvif), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, vif);
+	vif->type = type;
+	vif->bss_conf.vif = vif;
+	mvif = (struct mt76_vif_link *)vif->drv_priv;
+	mvif->omac_idx = 2;
+	mvif->wmm_idx = 1;
+	return vif;
+}
+
+static struct mt76_vif_link *mt76_connac_test_mvif(struct ieee80211_vif *vif)
+{
+	return (struct mt76_vif_link *)vif->drv_priv;
+}
+
+/* a station whose drv_priv is its wcid (as in mt7915_sta), not registered */
+static struct ieee80211_sta *mt76_connac_test_sta(struct kunit *test,
+						  u16 idx)
+{
+	struct ieee80211_sta *sta;
+	struct mt76_wcid *wcid;
+
+	sta = kunit_kzalloc(test, sizeof(*sta) + sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sta);
+	wcid = (struct mt76_wcid *)sta->drv_priv;
+	mt76_wcid_init(wcid, 0);
+	wcid->idx = idx;
+	wcid->sta = 1;
+	sta->wme = true;
+	return sta;
+}
+
+static struct mt76_wcid *mt76_connac_test_wcid(struct ieee80211_sta *sta)
+{
+	return (struct mt76_wcid *)sta->drv_priv;
+}
+
+static void mt76_connac_test_free_skb(void *skb)
+{
+	kfree_skb(skb);
+}
+
+/* A frame of @len bytes starting with @fc, @addr1, freed when the test
+ * ends. Its tx info is zeroed.
+ */
+static struct sk_buff *mt76_connac_test_frame(struct kunit *test, u16 fc,
+					      const u8 *addr1, int len)
+{
+	struct ieee80211_hdr *hdr;
+	struct sk_buff *skb;
+
+	skb = alloc_skb(len, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_connac_test_free_skb, skb), 0);
+	hdr = skb_put_zero(skb, len);
+	hdr->frame_control = cpu_to_le16(fc);
+	if (addr1)
+		ether_addr_copy(hdr->addr1, addr1);
+	memset(skb->cb, 0, sizeof(skb->cb));
+	return skb;
+}
+
+static const u8 mt76_connac_test_peer[ETH_ALEN] = {
+	0x02, 0x11, 0x22, 0x33, 0x44, 0x55
+};
+
+static const u8 mt76_connac_test_bcast[ETH_ALEN] = {
+	0xff, 0xff, 0xff, 0xff, 0xff, 0xff
+};
+
+/* --- HE PPE thresholds ------------------------------------------------- */
+
+/* The PPE thresholds we advertise: NSS and RU bitmask in the first byte,
+ * then the (PPET16, PPET8) pattern for each stream and RU, the bits past
+ * the end cleared and nothing written beyond it.
+ */
+static void mt76_connac_test_ppe_thresh(struct kunit *test)
+{
+	static const u8 pattern[] = { 0x1c, 0xc7, 0x71 };
+	u8 ppet[16];
+	int i;
+
+	/* 2.4 GHz: RUs 242 and 484 only; 2 streams: 24 bits */
+	memset(ppet, 0xee, sizeof(ppet));
+	mt76_connac_gen_ppe_thresh(ppet, 2, NL80211_BAND_2GHZ);
+	KUNIT_EXPECT_EQ(test, ppet[0],
+			FIELD_PREP(IEEE80211_PPE_THRES_NSS_MASK, 1) |
+			FIELD_PREP(IEEE80211_PPE_THRES_RU_INDEX_BITMASK_MASK,
+				   0x3));
+	KUNIT_EXPECT_EQ(test, ppet[1], 0x1c);
+	KUNIT_EXPECT_EQ(test, ppet[2], 0xc7);
+	KUNIT_EXPECT_EQ(test, ppet[3], 0x71);
+	KUNIT_EXPECT_EQ(test, ppet[4], 0xee);
+
+	/* one stream: 12 bits, so only 3 bits of the second byte */
+	memset(ppet, 0xee, sizeof(ppet));
+	mt76_connac_gen_ppe_thresh(ppet, 1, NL80211_BAND_2GHZ);
+	KUNIT_EXPECT_EQ(test, ppet[0],
+			FIELD_PREP(IEEE80211_PPE_THRES_RU_INDEX_BITMASK_MASK,
+				   0x3));
+	KUNIT_EXPECT_EQ(test, ppet[1], 0x1c);
+	KUNIT_EXPECT_EQ(test, ppet[2], 0xc7 & 0x07);
+	KUNIT_EXPECT_EQ(test, ppet[3], 0xee);
+
+	/* 5 GHz: all four RUs; 4 streams: 96 bits */
+	memset(ppet, 0xee, sizeof(ppet));
+	mt76_connac_gen_ppe_thresh(ppet, 4, NL80211_BAND_5GHZ);
+	KUNIT_EXPECT_EQ(test, ppet[0],
+			FIELD_PREP(IEEE80211_PPE_THRES_NSS_MASK, 3) |
+			FIELD_PREP(IEEE80211_PPE_THRES_RU_INDEX_BITMASK_MASK,
+				   0xf));
+	for (i = 1; i < 12; i++)
+		KUNIT_EXPECT_EQ(test, ppet[i], pattern[(i - 1) % 3]);
+	KUNIT_EXPECT_EQ(test, ppet[12], 0x71 & 0x7f);
+	KUNIT_EXPECT_EQ(test, ppet[13], 0xee);
+}
+
+/* --- tx descriptor ------------------------------------------------------- */
+
+/* the tx rate for fixed-rate frames as the TXD encodes it */
+static u16 mt76_connac_test_rate(u8 mode, u8 idx, u8 nss)
+{
+	return FIELD_PREP(MT_TX_RATE_MODE, mode) |
+	       FIELD_PREP(MT_TX_RATE_IDX, idx) |
+	       FIELD_PREP(MT_TX_RATE_NSS, nss);
+}
+
+/* Fixed rates for management and multicast frames are the lowest basic
+ * rate of the band (in mt76_rates terms: CCK first on 2.4 GHz only), or
+ * the multicast rate set for the band.
+ */
+static void mt76_connac_test_tx_rate_val(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_vif *vif = mt76_connac_test_vif(test,
+							 NL80211_IFTYPE_AP);
+	struct ieee80211_bss_conf *conf = &vif->bss_conf;
+	struct ieee80211_chanctx_conf *ctx;
+	struct mt76_phy *phy = &dev->phy;
+
+	/* no interface: 1 Mbps CCK */
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, NULL, false,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_CCK, 0, 0));
+
+	/* 5 GHz, lowest basic rate 12 Mbps (hw rate 10) */
+	conf->basic_rates = BIT(2) | BIT(4);
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, false,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 10, 0));
+	/* multicast at 24 Mbps (index 4 + 1) */
+	conf->mcast_rate[NL80211_BAND_5GHZ] = 5;
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, false,
+							   true),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 9, 0));
+	/* unicast ignores it */
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, false,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 10, 0));
+	/* an index past the table falls back to the lowest OFDM rate */
+	conf->mcast_rate[NL80211_BAND_5GHZ] = 12;
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, false,
+							   true),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 11, 0));
+	/* no basic rates (hidden nodes): the lowest */
+	conf->basic_rates = 0;
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, false,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 11, 0));
+
+	/* the channel context's band wins: 2.4 GHz, 2 Mbps CCK */
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	ctx->def.chan = &mt76_connac_test_chan_2g;
+	mt76_connac_test_mvif(vif)->ctx = ctx;
+	conf->basic_rates = BIT(1);
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, false,
+							   true),
+			mt76_connac_test_rate(MT_PHY_TYPE_CCK, 1, 0));
+}
+
+/* Beacons follow the beacon rate the user set when it names exactly one
+ * rate (HE, VHT, HT or legacy, checked in that order); connac2 chips only
+ * use the basic rate.
+ */
+static void mt76_connac_test_tx_rate_val_beacon(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_vif *vif = mt76_connac_test_vif(test,
+							 NL80211_IFTYPE_AP);
+	struct ieee80211_bss_conf *conf = &vif->bss_conf;
+	struct cfg80211_bitrate_mask *mask = &conf->beacon_tx_rate;
+	int band = NL80211_BAND_5GHZ;
+	struct mt76_phy *phy = &dev->phy;
+
+	conf->basic_rates = BIT(0);
+	/* nothing set: the basic rate */
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, true,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 11, 0));
+
+	/* legacy 18 Mbps */
+	mask->control[band].legacy = BIT(3);
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, true,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 14, 0));
+	/* two legacy rates aren't a choice */
+	mask->control[band].legacy = BIT(3) | BIT(5);
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, true,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 11, 0));
+
+	/* HT MCS 11: the second stream's MCS 3 */
+	mask->control[band].ht_mcs[1] = BIT(3);
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, true,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_HT, 11, 0));
+
+	/* VHT MCS 7, 1 stream (several MCSs for stream 2 don't count) */
+	mask->control[band].vht_mcs[0] = BIT(7);
+	mask->control[band].vht_mcs[1] = BIT(1) | BIT(2);
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, true,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_VHT, 7, 1));
+
+	/* HE MCS 9, 2 streams */
+	mask->control[band].he_mcs[0] = BIT(1) | BIT(2);
+	mask->control[band].he_mcs[1] = BIT(9);
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, true,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_HE_SU, 9, 2));
+	/* not a beacon: the mask doesn't apply */
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, false,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 11, 0));
+
+	dev->rev = MT76_CONNAC_TEST_C2_REV;
+	KUNIT_EXPECT_EQ(test, mt76_connac2_mac_tx_rate_val(phy, conf, true,
+							   false),
+			mt76_connac_test_rate(MT_PHY_TYPE_OFDM, 11, 0));
+}
+
+#define MT76_CONNAC_TEST_QOS_DATA	(IEEE80211_FTYPE_DATA | \
+					 IEEE80211_STYPE_QOS_DATA)
+
+static u32 mt76_connac_test_dw(__le32 *txwi, int i)
+{
+	return le32_to_cpu(txwi[i]);
+}
+
+/* A QoS data frame from our AP: the TXD carries length, queue, station
+ * entry, own MAC, header format and TID, frame type, retries, protection
+ * and A-MSDU; data goes at the rate control's rate.
+ */
+static void mt76_connac_test_txwi_data(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_vif *vif = mt76_connac_test_vif(test,
+							 NL80211_IFTYPE_AP);
+	struct ieee80211_sta *sta = mt76_connac_test_sta(test, 0x123);
+	struct mt76_wcid *wcid = mt76_connac_test_wcid(sta);
+	struct ieee80211_key_conf key = { .cipher = WLAN_CIPHER_SUITE_CCMP };
+	struct ieee80211_tx_info *info;
+	struct sk_buff *skb;
+	__le32 txwi[16];
+	u32 dw;
+
+	skb = mt76_connac_test_frame(test, MT76_CONNAC_TEST_QOS_DATA,
+				     mt76_connac_test_peer, 100);
+	skb->priority = 5;
+	skb_set_queue_mapping(skb, IEEE80211_AC_VI);
+	info = IEEE80211_SKB_CB(skb);
+	info->control.vif = vif;
+	wcid->amsdu = 1;
+	memset(txwi, 0xff, sizeof(txwi));
+
+	mt76_connac2_mac_write_txwi(dev, txwi, skb, wcid, &key,
+				    MT_PACKET_ID_NO_SKB, MT_TXQ_VI, 0);
+
+	dw = mt76_connac_test_dw(txwi, 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_TX_BYTES, dw),
+			100 + MT_TXD_SIZE);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_PKT_FMT, dw), MT_TX_TYPE_CT);
+	/* WMM set 1, VI is LMAC queue 2 */
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_Q_IDX, dw), 1 * 4 + 2);
+
+	dw = mt76_connac_test_dw(txwi, 1);
+	KUNIT_EXPECT_TRUE(test, dw & MT_TXD1_LONG_FORMAT);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_WLAN_IDX, dw), 0x123);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_OWN_MAC, dw), 2);
+	KUNIT_EXPECT_TRUE(test, dw & MT_TXD1_VTA);
+	KUNIT_EXPECT_FALSE(test, dw & MT_TXD1_TGID);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_HDR_FORMAT, dw),
+			MT_HDR_FORMAT_802_11);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_HDR_INFO, dw), 26 / 2);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_TID, dw), 5);
+
+	dw = mt76_connac_test_dw(txwi, 2);
+	KUNIT_EXPECT_EQ(test, dw, FIELD_PREP(MT_TXD2_FRAME_TYPE, 2) |
+			FIELD_PREP(MT_TXD2_SUB_TYPE, 8));
+
+	dw = mt76_connac_test_dw(txwi, 3);
+	KUNIT_EXPECT_EQ(test, dw, FIELD_PREP(MT_TXD3_REM_TX_COUNT, 15) |
+			MT_TXD3_SW_POWER_MGMT | MT_TXD3_PROTECT_FRAME);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 4), 0);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 5),
+			FIELD_PREP(MT_TXD5_PID, MT_PACKET_ID_NO_SKB));
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 6), 0);
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 7),
+			MT_TXD7_HW_AMSDU | FIELD_PREP(MT_TXD7_TYPE, 2) |
+			FIELD_PREP(MT_TXD7_SUB_TYPE, 8));
+	/* only the 8 MMIO dwords are written */
+	KUNIT_EXPECT_EQ(test, mt76_connac_test_dw(txwi, 8), 0xffffffff);
+}
