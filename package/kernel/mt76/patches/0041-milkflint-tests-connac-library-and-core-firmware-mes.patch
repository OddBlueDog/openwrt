+
+/* The patch semaphore is taken and released with one command, waited for. */
+static void mt76_connac_mcu_test_patch_sem(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	__le32 *req;
+
+	mt76_connac_mcu_test_fw.sem_get = PATCH_IS_DL;
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_patch_sem_ctrl(dev, true),
+			PATCH_IS_DL);
+	req = mt76_connac_mcu_test_req(test, MCU_CMD(PATCH_SEM_CONTROL), 4);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(*req), PATCH_SEM_GET);
+
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_patch_sem_ctrl(dev, false),
+			PATCH_REL_SEM_SUCCESS);
+	req = mt76_connac_mcu_test_req(test, MCU_CMD(PATCH_SEM_CONTROL), 4);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(*req), PATCH_SEM_RELEASE);
+
+	/* no answer: the caller learns it */
+	mt76_test_fake->mcu_silent = true;
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_patch_sem_ctrl(dev, true),
+			-ETIMEDOUT);
+}
