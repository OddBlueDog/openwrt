+/* HE: MCS in the low bits, GI and DCM as reported; an extended-range SU
+ * frame on a 106-tone RU says so in the bandwidth.
+ */
+static void mt76_connac_test_rx_rate_he(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct ieee80211_supported_band *sband = &dev->phy.sband_5g.sband;
+	struct mt76_rx_status status;
+	u8 mode;
+
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status, sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_HE_SU, 11, 2,
+					      IEEE80211_STA_RX_BW_80,
+					      NL80211_RATE_INFO_HE_GI_3_2, 0,
+					      true), &mode), 0);
+	KUNIT_EXPECT_EQ(test, mode, MT_PHY_TYPE_HE_SU);
+	KUNIT_EXPECT_EQ(test, (int)status.encoding, RX_ENC_HE);
+	KUNIT_EXPECT_EQ(test, status.rate_idx, 11);
+	KUNIT_EXPECT_EQ(test, (int)status.nss, 2);
+	KUNIT_EXPECT_EQ(test, (int)status.he_gi, NL80211_RATE_INFO_HE_GI_3_2);
+	KUNIT_EXPECT_EQ(test, (int)status.he_dcm, 1);
+	KUNIT_EXPECT_EQ(test, (int)status.bw, RATE_INFO_BW_80);
+	/* the GI is HE's own, not the short GI flag */
+	KUNIT_EXPECT_FALSE(test, status.enc_flags & RX_ENC_FLAG_SHORT_GI);
+
+	/* an invalid GI value isn't reported; MCS bits above 3 are flags */
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status, sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_HE_MU, 0x17, 1, 0, 3,
+					      0, false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, status.rate_idx, 7);
+	KUNIT_EXPECT_EQ(test, (int)status.he_gi, 0);
+	KUNIT_EXPECT_EQ(test, (int)status.he_dcm, 0);
+
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status, sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_HE_EXT_SU,
+					      2 | MT_PRXV_TX_ER_SU_106T, 1,
+					      IEEE80211_STA_RX_BW_40, 0, 0,
+					      false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, (int)status.bw, RATE_INFO_BW_HE_RU);
+	KUNIT_EXPECT_EQ(test, (int)status.he_ru,
+			NL80211_RATE_INFO_HE_RU_ALLOC_106);
+	KUNIT_EXPECT_EQ(test, status.rate_idx, 2);
+
+	/* the full 40 MHz otherwise; TB PPDUs likewise */
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status, sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_HE_EXT_SU, 2, 1,
+					      IEEE80211_STA_RX_BW_40, 0, 0,
+					      false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, (int)status.bw, RATE_INFO_BW_40);
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status, sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_HE_TB,
+					      2 | MT_PRXV_TX_ER_SU_106T, 1,
+					      IEEE80211_STA_RX_BW_40, 0, 0,
+					      false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, (int)status.bw, RATE_INFO_BW_40);
+	KUNIT_EXPECT_EQ(test, (int)status.encoding, RX_ENC_HE);
+}
