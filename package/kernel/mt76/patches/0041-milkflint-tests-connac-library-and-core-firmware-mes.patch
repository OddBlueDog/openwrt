+/* A station connecting to our AP: it's a station to the firmware, with its
+ * AID, address and QoS; new entries are flagged as such.
+ */
+static void mt76_connac_mcu_test_sta_basic_ap(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 1);
+	struct ieee80211_vif *vif;
+	struct sta_rec_basic *basic;
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 0);
+	basic = mt76_connac_mcu_test_sta_basic(test, dev, vif, sta,
+					       CONN_STATE_PORT_SECURE, true);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(basic->conn_type),
+			CONNECTION_INFRA_STA);
+	KUNIT_EXPECT_EQ(test, basic->conn_state, CONN_STATE_PORT_SECURE);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->aid), 7);
+	KUNIT_EXPECT_MEMEQ(test, basic->peer_addr, mt76_connac_mcu_test_peer,
+			   ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, basic->qos, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->extra_info),
+			EXTRA_INFO_VER | EXTRA_INFO_NEW);
+
+	/* an update to a known station isn't new; nor is a disconnect */
+	basic = mt76_connac_mcu_test_sta_basic(test, dev, vif, sta,
+					       CONN_STATE_CONNECT, false);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->extra_info), EXTRA_INFO_VER);
+	sta->wme = false;
+	basic = mt76_connac_mcu_test_sta_basic(test, dev, vif, sta,
+					       CONN_STATE_DISCONNECT, true);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->extra_info), EXTRA_INFO_VER);
+	KUNIT_EXPECT_EQ(test, basic->conn_state, CONN_STATE_DISCONNECT);
+	KUNIT_EXPECT_EQ(test, basic->qos, 0);
+
+	/* P2P GO: the peer is a P2P client (outside the connac2 family) */
+	vif->p2p = true;
+	basic = mt76_connac_mcu_test_sta_basic(test, dev, vif, sta,
+					       CONN_STATE_CONNECT, true);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(basic->conn_type),
+			CONNECTION_P2P_GC);
+	dev->rev = MT76_CONNAC_MCU_TEST_C2_REV;
+	basic = mt76_connac_mcu_test_sta_basic(test, dev, vif, sta,
+					       CONN_STATE_CONNECT, true);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(basic->conn_type),
+			CONNECTION_INFRA_STA);
+
+	/* mesh peers are stations too */
+	dev->rev = MT76_CONNAC_MCU_TEST_REV;
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_MESH_POINT, 0);
+	basic = mt76_connac_mcu_test_sta_basic(test, dev, vif, sta,
+					       CONN_STATE_CONNECT, true);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(basic->conn_type),
+			CONNECTION_INFRA_STA);
+}
