+/* a RAM image: the regions' data, their descriptors, then the trailer */
+struct mt76_connac_mcu_test_region {
+	u32 addr, len;
+	u8 feature_set;
+};
+
+static void
+mt76_connac_mcu_test_write_ram(struct kunit *test, const char *name,
+			       const char *ver,
+			       const struct mt76_connac_mcu_test_region *r,
+			       int n, u8 **image)
+{
+	struct mt76_connac2_fw_region *region;
+	struct mt76_connac2_fw_trailer *hdr;
+	size_t data = 0, size;
+	u8 *fw;
+	int i;
+
+	for (i = 0; i < n; i++)
+		data += r[i].len;
+	size = data + n * sizeof(*region) + sizeof(*hdr);
+	fw = kunit_kzalloc(test, size, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, fw);
+	for (i = 0; i < data; i++)
+		fw[i] = i * 13;
+
+	region = (struct mt76_connac2_fw_region *)(fw + data);
+	for (i = 0; i < n; i++) {
+		region[i].addr = cpu_to_le32(r[i].addr);
+		region[i].len = cpu_to_le32(r[i].len);
+		region[i].feature_set = r[i].feature_set;
+	}
+	hdr = (struct mt76_connac2_fw_trailer *)(region + n);
+	hdr->n_region = n;
+	memcpy(hdr->fw_ver, ver, sizeof(hdr->fw_ver));
+	memcpy(hdr->build_date, "20261019123456X", sizeof(hdr->build_date));
+
+	mt76_connac_mcu_test_write_fw(test, name, fw, size);
+	if (image)
+		*image = fw;
+}
+
+static const struct mt76_connac_mcu_test_region mt76_connac_mcu_test_wm[] = {
+	{	/* encrypted with key 2 */
+		.addr = 0x800000, .len = 5000,
+		.feature_set = FW_FEATURE_SET_ENCRYPT |
+			       (2 << 1) |	/* FW_FEATURE_SET_KEY_IDX */
+			       FW_FEATURE_ENCRY_MODE,
+	}, {	/* not for downloading: skipped, but its data is there */
+		.addr = 0x810000, .len = 16,
+		.feature_set = FW_FEATURE_NON_DL,
+	}, {	/* the firmware starts here */
+		.addr = 0x820000, .len = 32,
+		.feature_set = FW_FEATURE_OVERRIDE_ADDR,
+	},
+};
+
+static const struct mt76_connac_mcu_test_region mt76_connac_mcu_test_wa[] = {
+	{ .addr = 0x830000, .len = 100, },
+};
+
+/* WM firmware: each region announced and sent (skipping the non-download
+ * one), then started at the override address; then the WA firmware, which
+ * runs on the CR4. The version shown is the last one loaded.
+ */
+static void mt76_connac_mcu_test_load_ram(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	u32 wm_mode = DL_MODE_NEED_RSP | DL_MODE_ENCRYPT |
+		      DL_MODE_RESET_SEC_IV | FIELD_PREP(DL_MODE_KEY_IDX, 2);
+	struct mt76_test_msg *msg;
+	u8 *wm, *wa;
+
+	mt76_connac_mcu_test_write_ram(test, MT76_CONNAC_MCU_TEST_WM,
+				       "WM_1.2.3.4", mt76_connac_mcu_test_wm,
+				       ARRAY_SIZE(mt76_connac_mcu_test_wm),
+				       &wm);
+	mt76_connac_mcu_test_write_ram(test, MT76_CONNAC_MCU_TEST_WA,
+				       "WA_5.6.7.8", mt76_connac_mcu_test_wa,
+				       ARRAY_SIZE(mt76_connac_mcu_test_wa),
+				       &wa);
+
+	KUNIT_ASSERT_EQ(test, mt76_connac2_load_ram(dev,
+			MT76_CONNAC_MCU_TEST_WM, NULL), 0);
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 6);
+	mt76_connac_mcu_test_expect_dl(test, 0,
+				       MCU_CMD(TARGET_ADDRESS_LEN_REQ),
+				       0x800000, 5000, wm_mode);
+	mt76_connac_mcu_test_expect_data(test, 1, wm, 4096);
+	mt76_connac_mcu_test_expect_data(test, 2, wm + 4096, 5000 - 4096);
+	mt76_connac_mcu_test_expect_dl(test, 3,
+				       MCU_CMD(TARGET_ADDRESS_LEN_REQ),
+				       0x820000, 32, DL_MODE_NEED_RSP);
+	mt76_connac_mcu_test_expect_data(test, 4, wm + 5000 + 16, 32);
+	msg = mt76_connac_mcu_test_nth(test, 5, MCU_CMD(FW_START_REQ));
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data),
+			FW_START_OVERRIDE);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data + 4), 0x820000);
+	KUNIT_EXPECT_STREQ(test, dev->hw->wiphy->fw_version,
+			   "WM_1.2.3.4-20261019123456X");
+
+	KUNIT_ASSERT_EQ(test, mt76_connac2_load_ram(dev,
+			MT76_CONNAC_MCU_TEST_WM, MT76_CONNAC_MCU_TEST_WA), 0);
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 6 + 6 + 3);
+	mt76_connac_mcu_test_expect_dl(test, 12,
+				       MCU_CMD(TARGET_ADDRESS_LEN_REQ),
+				       0x830000, 100,
+				       DL_MODE_NEED_RSP |
+				       DL_MODE_WORKING_PDA_CR4);
+	mt76_connac_mcu_test_expect_data(test, 13, wa, 100);
+	msg = mt76_connac_mcu_test_nth(test, 14, MCU_CMD(FW_START_REQ));
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data),
+			FW_START_WORKING_PDA_CR4);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data + 4), 0);
+	KUNIT_EXPECT_STREQ(test, dev->hw->wiphy->fw_version,
+			   "WA_5.6.7.8-20261019123456X");
+}
