+
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_start_firmware(dev, 0x1000,
+							     FW_START_OVERRIDE),
+			0);
+	req = mt76_connac_mcu_test_req(test, MCU_CMD(FW_START_REQ), 8);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req[0]), FW_START_OVERRIDE);
