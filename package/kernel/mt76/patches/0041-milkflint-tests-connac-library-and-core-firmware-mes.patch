diff --git a/tests/mcu-test.c b/tests/mcu-test.c
new file mode 100644
index 00000000..a367ef14
--- /dev/null
+++ b/tests/mcu-test.c
@@ -0,0 +1,727 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for the core firmware message layer (mcu.c): building
+ * messages, sending them, waiting for the matching reply, retrying and
+ * timing out, and splitting firmware images into chunks. The firmware is
+ * the fake of fake.h, wrapped so the tests can count and break things.
+ * Included at the end of mcu.c when CONFIG_MT76_KUNIT_TEST is defined
+ * (milkflint's QEMU test build only).
+ */
+#include <kunit/test.h>
+#include "fake.h"
+
+#define MT76_MCU_TEST_HEADROOM	16
+#define MT76_MCU_TEST_TAILROOM	8
+#define MT76_MCU_TEST_HDR	0x5a	/* what prepare_msg puts in front */
+
+static struct mt76_mcu_test_state {
+	int n_prepare, n_send, n_parse, n_cleanup;
+	int prepare_ret;
+	int fail_at, fail_ret;		/* send number fail_at fails */
+	int silent_sends;		/* the first ones get no reply */
+	int parse_ret;			/* parse result once the seq matched */
+	int parse_seq;			/* the seq the last parse waited for */
+	bool seq_null;			/* the last send had no seq to fill */
+	unsigned int headroom, tailroom; /* of the last skb sent */
+	struct mt76_queue *cleanup_q;
+	bool cleanup_flush;
+	/* mcu_send_msg */
+	int msg_cmd, msg_len, msg_ret;
+	const void *msg_data;
+	bool msg_wait;
+} mt76_mcu_test_state;
+
+static int mt76_mcu_test_prepare(struct mt76_dev *dev, struct sk_buff *skb,
+				 int cmd, int *seq)
+{
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+
+	st->n_prepare++;
+	if (st->prepare_ret)
+		return st->prepare_ret;
+
+	*(u8 *)skb_push(skb, 1) = MT76_MCU_TEST_HDR;
+	*seq = 0;
+	return 0;
+}
+
+static int mt76_mcu_test_send(struct mt76_dev *dev, struct sk_buff *skb,
+			      int cmd, int *seq)
+{
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	st->n_send++;
+	st->seq_null = !seq;
+	st->headroom = skb_headroom(skb);
+	st->tailroom = skb_tailroom(skb);
+	if (st->n_send == st->fail_at) {
+		dev_kfree_skb(skb);
+		return st->fail_ret;
+	}
+	fake->mcu_silent = st->n_send <= st->silent_sends;
+
+	return mt76_test_mcu_send(dev, skb, cmd, seq);
+}
+
+static int mt76_mcu_test_parse(struct mt76_dev *dev, int cmd,
+			       struct sk_buff *skb, int seq)
+{
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	int ret;
+
+	st->n_parse++;
+	st->parse_seq = seq;
+	ret = mt76_test_mcu_parse(dev, cmd, skb, seq);
+
+	return ret ?: st->parse_ret;
+}
+
+static int mt76_mcu_test_send_msg(struct mt76_dev *dev, int cmd,
+				  const void *data, int len, bool wait_resp)
+{
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+
+	st->msg_cmd = cmd;
+	st->msg_data = data;
+	st->msg_len = len;
+	st->msg_wait = wait_resp;
+	return st->msg_ret;
+}
+
+/* plain skb path, no prepare step: no retries possible */
+static const struct mt76_mcu_ops mt76_mcu_test_ops = {
+	.headroom = MT76_MCU_TEST_HEADROOM,
+	.tailroom = MT76_MCU_TEST_TAILROOM,
+	.mcu_skb_send_msg = mt76_mcu_test_send,
+	.mcu_parse_response = mt76_mcu_test_parse,
+};
+
+/* like mt7915: a prepare step, so a lost reply is retried */
+static const struct mt76_mcu_ops mt76_mcu_test_retry_ops = {
+	.max_retry = 2,
+	.headroom = MT76_MCU_TEST_HEADROOM,
+	.mcu_skb_prepare_msg = mt76_mcu_test_prepare,
+	.mcu_skb_send_msg = mt76_mcu_test_send,
+	.mcu_parse_response = mt76_mcu_test_parse,
+};
+
+/* a bus with a send_msg of its own (USB/SDIO style) */
+static const struct mt76_mcu_ops mt76_mcu_test_msg_ops = {
+	.mcu_send_msg = mt76_mcu_test_send_msg,
+	.mcu_skb_send_msg = mt76_mcu_test_send,
+	.mcu_parse_response = mt76_mcu_test_parse,
+};
+
+static void mt76_mcu_test_cleanup(struct mt76_dev *dev, struct mt76_queue *q,
+				  bool flush)
+{
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+
+	st->n_cleanup++;
+	st->cleanup_q = q;
+	st->cleanup_flush = flush;
+}
+
+static const struct mt76_queue_ops mt76_mcu_test_queue_ops = {
+	.tx_cleanup = mt76_mcu_test_cleanup,
+};
+
+static const struct mt76_queue_ops mt76_mcu_test_no_cleanup_ops = {};
+
+/* the fake firmware's answer: one byte, 0xa0 + the message's length */
+static void mt76_mcu_test_reply(struct mt76_test_fake *fake,
+				const struct mt76_test_msg *msg,
+				struct sk_buff *reply)
+{
+	skb_put_u8(reply, 0xa0 + msg->len);
+}
+
+/* fake.h's mt76_test_hw_ops, plus the channel context ops this mac80211
+ * insists on (ieee80211_alloc_hw() refuses ops without them)
+ */
+static const struct ieee80211_ops mt76_mcu_test_hw_ops = {
+	.tx = mt76_test_tx,
+	.start = mt76_test_start,
+	.stop = mt76_test_stop,
+	.add_interface = mt76_test_add_interface,
+	.remove_interface = mt76_test_remove_interface,
+	.config = mt76_test_config,
+	.configure_filter = mt76_test_configure_filter,
+	.wake_tx_queue = mt76_test_wake_tx_queue,
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
+};
+
+static struct mt76_dev *mt76_mcu_test_dev(struct kunit *test,
+					  const struct mt76_mcu_ops *ops)
+{
+	struct mt76_dev *dev;
+
+	dev = mt76_test_dev(test, sizeof(*dev), &mt76_mcu_test_hw_ops, NULL);
+	memset(&mt76_mcu_test_state, 0, sizeof(mt76_mcu_test_state));
+	dev->mcu_ops = ops;
+	dev->queue_ops = &mt76_mcu_test_queue_ops;
+	mt76_test_fake->reply = mt76_mcu_test_reply;
+	return dev;
+}
+
+/* a reply as the bus would deliver it: header with @seq, then @payload */
+static struct sk_buff *mt76_mcu_test_event(struct kunit *test, u8 seq,
+					   u8 payload)
+{
+	struct sk_buff *skb = alloc_skb(16, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	skb_put_zero(skb, mt76_test_fake->reply_hdr);
+	skb->data[mt76_test_fake->reply_seq_off] = seq;
+	skb_put_u8(skb, payload);
+	return skb;
+}
+
+/* an skb for the skb send path, @len bytes of 0x11 */
+static struct sk_buff *mt76_mcu_test_skb(struct kunit *test,
+					 struct mt76_dev *dev, int len)
+{
+	struct sk_buff *skb;
+
+	skb = mt76_mcu_msg_alloc(dev, NULL, len);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	memset(skb_put(skb, len), 0x11, len);
+	return skb;
+}
+
+/* --- building messages --------------------------------------------------- */
+
+/* A message gets the bus's head- and tailroom, the payload copied in, and
+ * zeroed room up to @len for the TLVs the caller appends.
+ */
+static void mt76_mcu_test_msg_alloc(struct kunit *test)
+{
+	static const u8 data[4] = { 1, 2, 3, 4 };
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct sk_buff *skb;
+	u8 *tail;
+	int i;
+
+	skb = __mt76_mcu_msg_alloc(dev, data, 32, sizeof(data), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_EXPECT_EQ(test, skb->len, sizeof(data));
+	KUNIT_EXPECT_MEMEQ(test, skb->data, data, sizeof(data));
+	KUNIT_EXPECT_GE(test, skb_headroom(skb), MT76_MCU_TEST_HEADROOM);
+	KUNIT_EXPECT_GE(test, skb_tailroom(skb),
+			32 - sizeof(data) + MT76_MCU_TEST_TAILROOM);
+	tail = skb_put(skb, 32 - sizeof(data));
+	for (i = 0; i < 32 - sizeof(data); i++)
+		KUNIT_EXPECT_EQ(test, tail[i], 0);
+	kfree_skb(skb);
+
+	/* a payload longer than @len wins */
+	skb = __mt76_mcu_msg_alloc(dev, data, 1, sizeof(data), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_EXPECT_EQ(test, skb->len, sizeof(data));
+	kfree_skb(skb);
+
+	/* no payload: an empty message with room for @len */
+	skb = __mt76_mcu_msg_alloc(dev, NULL, 24, 24, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_EXPECT_EQ(test, skb->len, 0);
+	KUNIT_EXPECT_GE(test, skb_tailroom(skb), 24 + MT76_MCU_TEST_TAILROOM);
+	kfree_skb(skb);
+}
+
+static const struct mt76_mcu_ops mt76_mcu_test_oom_ops = {
+	.headroom = SZ_1G,	/* more than any allocation can get */
+	.mcu_skb_send_msg = mt76_mcu_test_send,
+	.mcu_parse_response = mt76_mcu_test_parse,
+};
+
+/* A message that can't be allocated isn't sent: -ENOMEM. */
+static void mt76_mcu_test_msg_alloc_fails(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_oom_ops);
+	u8 data[4] = {};
+
+	KUNIT_EXPECT_NULL(test, __mt76_mcu_msg_alloc(dev, data, 8,
+						     sizeof(data),
+						     GFP_KERNEL));
+	KUNIT_EXPECT_EQ(test, mt76_mcu_send_msg(dev, 1, data, sizeof(data),
+						true), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt76_mcu_test_state.n_send, 0);
+}
+
+/* --- replies ------------------------------------------------------------ */
+
+/* Events are queued in order; a reply is only taken before its deadline. */
+static void mt76_mcu_test_get_response(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct sk_buff *a, *b;
+
+	a = mt76_mcu_test_event(test, 1, 0);
+	b = mt76_mcu_test_event(test, 2, 0);
+	mt76_mcu_rx_event(dev, a);
+	mt76_mcu_rx_event(dev, b);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->mcu.res_q), 2);
+
+	/* past the deadline: nothing is taken off the queue */
+	KUNIT_EXPECT_NULL(test, mt76_mcu_get_response(dev, jiffies - 1));
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->mcu.res_q), 2);
+
+	/* oldest first, without waiting */
+	KUNIT_EXPECT_PTR_EQ(test, mt76_mcu_get_response(dev, jiffies + HZ), a);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_mcu_get_response(dev, jiffies + HZ), b);
+	kfree_skb(a);
+	kfree_skb(b);
+
+	/* empty queue: NULL once the (short) deadline passes */
+	KUNIT_EXPECT_NULL(test, mt76_mcu_get_response(dev, jiffies + 1));
+}
+
+/* A firmware reset wakes a waiter at once instead of letting it sleep out
+ * the whole timeout.
+ */
+static void mt76_mcu_test_get_response_reset(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	unsigned long start = jiffies;
+
+	set_bit(MT76_MCU_RESET, &dev->phy.state);
+	KUNIT_EXPECT_NULL(test, mt76_mcu_get_response(dev, jiffies + 5 * HZ));
+	KUNIT_EXPECT_LT(test, jiffies - start, HZ / 2);
+	clear_bit(MT76_MCU_RESET, &dev->phy.state);
+}
+
+static bool mt76_mcu_test_woken;
+
+static int mt76_mcu_test_wake_fn(struct wait_queue_entry *wq_entry,
+				 unsigned int mode, int flags, void *key)
+{
+	mt76_mcu_test_woken = true;
+	return 0;
+}
+
+/* An event wakes whoever waits for a reply. */
+static void mt76_mcu_test_rx_event_wakes(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct wait_queue_entry wait;
+	struct sk_buff *skb = mt76_mcu_test_event(test, 1, 0);
+
+	init_waitqueue_func_entry(&wait, mt76_mcu_test_wake_fn);
+	mt76_mcu_test_woken = false;
+	add_wait_queue(&dev->mcu.wait, &wait);
+	mt76_mcu_rx_event(dev, skb);
+	remove_wait_queue(&dev->mcu.wait, &wait);
+
+	KUNIT_EXPECT_TRUE(test, mt76_mcu_test_woken);
+	KUNIT_EXPECT_PTR_EQ(test, skb_peek(&dev->mcu.res_q), skb);
+}
+
+/* --- sending ------------------------------------------------------------ */
+
+/* A buffer is copied into a message with the bus's headroom, sent, and the
+ * matching reply handed back without its header.
+ */
+static void mt76_mcu_test_send_and_get(struct kunit *test)
+{
+	static const u8 data[6] = { 6, 5, 4, 3, 2, 1 };
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	struct mt76_test_msg *msg;
+	struct sk_buff *reply;
+
+	KUNIT_ASSERT_EQ(test, mt76_mcu_send_and_get_msg(dev, 0x1234, data,
+							sizeof(data), true,
+							&reply), 0);
+	KUNIT_ASSERT_NOT_NULL(test, reply);
+	KUNIT_EXPECT_EQ(test, reply->len, 1);
+	KUNIT_EXPECT_EQ(test, reply->data[0], 0xa0 + sizeof(data));
+	kfree_skb(reply);
+
+	msg = mt76_test_msg(mt76_test_fake, 0);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, 0x1234);
+	KUNIT_EXPECT_EQ(test, msg->len, sizeof(data));
+	KUNIT_EXPECT_MEMEQ(test, msg->data, data, sizeof(data));
+	KUNIT_EXPECT_GE(test, st->headroom, MT76_MCU_TEST_HEADROOM);
+	KUNIT_EXPECT_GE(test, st->tailroom, MT76_MCU_TEST_TAILROOM);
+	/* the reply was matched against the seq the send picked */
+	KUNIT_EXPECT_EQ(test, st->parse_seq, mt76_test_fake->seq);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->mcu.res_q), 0);
+}
+
+/* Without a caller for the reply, it's consumed here. */
+static void mt76_mcu_test_send_wait_no_ret_skb(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	u8 data[2] = {};
+
+	KUNIT_EXPECT_EQ(test, mt76_mcu_send_msg(dev, 7, data, sizeof(data),
+						true), 0);
+	KUNIT_EXPECT_EQ(test, st->n_parse, 1);
+	KUNIT_EXPECT_FALSE(test, st->seq_null);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->mcu.res_q), 0);
+}
+
+/* A bus with its own send_msg gets the call as is. */
+static void mt76_mcu_test_send_msg_op(struct kunit *test)
+{
+	static const u8 data[3] = { 9, 8, 7 };
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_msg_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+
+	st->msg_ret = -EBUSY;
+	KUNIT_EXPECT_EQ(test, mt76_mcu_send_msg(dev, 0x42, data, sizeof(data),
+						true), -EBUSY);
+	KUNIT_EXPECT_EQ(test, st->msg_cmd, 0x42);
+	KUNIT_EXPECT_PTR_EQ(test, st->msg_data, (const void *)data);
+	KUNIT_EXPECT_EQ(test, st->msg_len, sizeof(data));
+	KUNIT_EXPECT_TRUE(test, st->msg_wait);
+	/* the skb path wasn't taken */
+	KUNIT_EXPECT_EQ(test, st->n_send, 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 0);
+}
+
+/* Fire and forget: no seq to fill in, no reply parsed. */
+static void mt76_mcu_test_send_no_wait(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	struct sk_buff *reply = (void *)1;
+
+	KUNIT_EXPECT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev,
+			mt76_mcu_test_skb(test, dev, 4), 3, false, &reply), 0);
+	KUNIT_EXPECT_NULL(test, reply);
+	KUNIT_EXPECT_EQ(test, st->n_send, 1);
+	KUNIT_EXPECT_TRUE(test, st->seq_null);
+	KUNIT_EXPECT_EQ(test, st->n_parse, 0);
+}
+
+/* A reply with another message's seq is dropped and the wait goes on until
+ * the right one arrives.
+ */
+static void mt76_mcu_test_skips_stale_reply(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	struct sk_buff *reply;
+
+	/* left over from an earlier message (the fake's next seq is 1) */
+	mt76_mcu_rx_event(dev, mt76_mcu_test_event(test, 9, 0x55));
+
+	KUNIT_ASSERT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev,
+			mt76_mcu_test_skb(test, dev, 2), 5, true, &reply), 0);
+	KUNIT_ASSERT_NOT_NULL(test, reply);
+	KUNIT_EXPECT_EQ(test, reply->data[0], 0xa2);
+	kfree_skb(reply);
+	KUNIT_EXPECT_EQ(test, st->n_parse, 2);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->mcu.res_q), 0);
+}
+
+/* Only stale replies and no answer: the caller gets a timeout. */
+static void mt76_mcu_test_stale_then_timeout(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	struct sk_buff *reply = (void *)1;
+
+	dev->mcu.timeout = 2;
+	st->silent_sends = 1;
+	mt76_mcu_rx_event(dev, mt76_mcu_test_event(test, 9, 0x55));
+
+	KUNIT_EXPECT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev,
+			mt76_mcu_test_skb(test, dev, 2), 5, true, &reply),
+			-ETIMEDOUT);
+	KUNIT_EXPECT_NULL(test, reply);
+	/* the stale reply, then the timeout */
+	KUNIT_EXPECT_EQ(test, st->n_parse, 2);
+	/* without a prepare step there's nothing to resend */
+	KUNIT_EXPECT_EQ(test, st->n_send, 1);
+}
+
+/* A reply the parser rejects is dropped and its error returned. */
+static void mt76_mcu_test_parse_error(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct sk_buff *reply = (void *)1;
+
+	mt76_mcu_test_state.parse_ret = -EINVAL;
+	KUNIT_EXPECT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev,
+			mt76_mcu_test_skb(test, dev, 2), 5, true, &reply),
+			-EINVAL);
+	KUNIT_EXPECT_NULL(test, reply);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&dev->mcu.res_q), 0);
+}
+
+/* A lost reply is retried with the same prepared message (not prepared
+ * again), up to max_retry times, and the message is freed in the end.
+ */
+static void mt76_mcu_test_retry_then_timeout(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test,
+						 &mt76_mcu_test_retry_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	struct mt76_test_msg *msg;
+	struct sk_buff *skb;
+	int i;
+
+	dev->mcu.timeout = 1;
+	st->silent_sends = 100;
+	skb = mt76_mcu_test_skb(test, dev, 3);
+	skb_get(skb);
+
+	KUNIT_EXPECT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev, skb, 5, true,
+							    NULL),
+			-ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, st->n_prepare, 1);
+	KUNIT_EXPECT_EQ(test, st->n_send, 1 + 2);
+	KUNIT_EXPECT_EQ(test, st->n_parse, 1);
+	for (i = 0; i < 3; i++) {
+		msg = mt76_test_msg(mt76_test_fake, i);
+		KUNIT_ASSERT_NOT_NULL(test, msg);
+		KUNIT_EXPECT_EQ(test, msg->len, 4);
+		KUNIT_EXPECT_EQ(test, msg->data[0], MT76_MCU_TEST_HDR);
+		KUNIT_EXPECT_EQ(test, msg->data[3], 0x11);
+	}
+	/* only our reference is left */
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 1);
+	kfree_skb(skb);
+}
+
+/* A retry that gets an answer succeeds. */
+static void mt76_mcu_test_retry_then_reply(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test,
+						 &mt76_mcu_test_retry_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	struct sk_buff *reply;
+
+	dev->mcu.timeout = 1;
+	st->silent_sends = 1;
+
+	KUNIT_ASSERT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev,
+			mt76_mcu_test_skb(test, dev, 3), 5, true, &reply), 0);
+	KUNIT_ASSERT_NOT_NULL(test, reply);
+	KUNIT_EXPECT_EQ(test, reply->data[0], 0xa4);	/* header + 3 */
+	kfree_skb(reply);
+	KUNIT_EXPECT_EQ(test, st->n_send, 2);
+	KUNIT_EXPECT_EQ(test, st->n_parse, 1);
+}
+
+/* While the firmware is being reset, a lost reply isn't retried and the
+ * wait doesn't last the whole timeout.
+ */
+static void mt76_mcu_test_no_retry_in_reset(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test,
+						 &mt76_mcu_test_retry_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	unsigned long start = jiffies;
+
+	dev->mcu.timeout = 5 * HZ;
+	st->silent_sends = 100;
+	set_bit(MT76_MCU_RESET, &dev->phy.state);
+
+	KUNIT_EXPECT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev,
+			mt76_mcu_test_skb(test, dev, 3), 5, true, NULL),
+			-ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, st->n_send, 1);
+	KUNIT_EXPECT_LT(test, jiffies - start, HZ / 2);
+	clear_bit(MT76_MCU_RESET, &dev->phy.state);
+}
+
+/* A failing prepare step stops the message before it's sent, and frees it. */
+static void mt76_mcu_test_prepare_error(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test,
+						 &mt76_mcu_test_retry_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	struct sk_buff *skb = mt76_mcu_test_skb(test, dev, 3);
+
+	st->prepare_ret = -ENOSPC;
+	skb_get(skb);
+	KUNIT_EXPECT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev, skb, 5, true,
+							    NULL), -ENOSPC);
+	KUNIT_EXPECT_EQ(test, st->n_send, 0);
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 1);
+	kfree_skb(skb);
+}
+
+/* A send error is returned without waiting; the message isn't leaked. */
+static void mt76_mcu_test_send_error(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test,
+						 &mt76_mcu_test_retry_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	struct sk_buff *skb = mt76_mcu_test_skb(test, dev, 3);
+
+	st->fail_at = 1;
+	st->fail_ret = -ENOMEM;
+	skb_get(skb);
+	KUNIT_EXPECT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev, skb, 5, true,
+							    NULL), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, st->n_parse, 0);
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 1);
+	kfree_skb(skb);
+}
+
+/* Once the bus has hung (an MMIO read returned all ones), nothing more is
+ * sent to the firmware.
+ */
+static void mt76_mcu_test_bus_hung_mmio(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct sk_buff *skb = mt76_mcu_test_skb(test, dev, 3);
+
+	atomic_set(&dev->bus_hung, 1);
+	skb_get(skb);
+	KUNIT_EXPECT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev, skb, 5, true,
+							    NULL), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_mcu_test_state.n_send, 0);
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 1);
+	kfree_skb(skb);
+
+	/* and it's the only thing that stops it */
+	atomic_set(&dev->bus_hung, 0);
+	KUNIT_EXPECT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev,
+			mt76_mcu_test_skb(test, dev, 3), 5, true, NULL), 0);
+	KUNIT_EXPECT_EQ(test, mt76_mcu_test_state.n_send, 1);
+}
+
+/* On SDIO a hung bus only blocks messages during a reset. */
+static void mt76_mcu_test_bus_hung_sdio(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct mt76_bus_ops *bus;
+
+	bus = kunit_kmalloc(test, sizeof(*bus), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, bus);
+	*bus = mt76_test_bus_ops;
+	bus->type = MT76_BUS_SDIO;
+	dev->bus = bus;
+	atomic_set(&dev->bus_hung, 1);
+
+	KUNIT_EXPECT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev,
+			mt76_mcu_test_skb(test, dev, 3), 5, true, NULL), 0);
+	KUNIT_EXPECT_EQ(test, mt76_mcu_test_state.n_send, 1);
+
+	set_bit(MT76_RESET, &dev->phy.state);
+	KUNIT_EXPECT_EQ(test, mt76_mcu_skb_send_and_get_msg(dev,
+			mt76_mcu_test_skb(test, dev, 3), 5, true, NULL), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_mcu_test_state.n_send, 1);
+	clear_bit(MT76_RESET, &dev->phy.state);
+}
+
+/* --- firmware download ------------------------------------------------ */
+
+/* An image is sent in max_len chunks, in order and without waiting, and
+ * the download queue is cleaned after each one.
+ */
+static void mt76_mcu_test_send_firmware(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	static const int len = 2 * 100 + 37;
+	struct mt76_test_msg *msg;
+	struct mt76_queue fwdl = {};
+	u8 *fw;
+	int i;
+
+	fw = kunit_kmalloc(test, len, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, fw);
+	for (i = 0; i < len; i++)
+		fw[i] = i;
+	dev->q_mcu[MT_MCUQ_FWDL] = &fwdl;
+
+	KUNIT_ASSERT_EQ(test, __mt76_mcu_send_firmware(dev, 0x99, fw, len,
+						       100), 0);
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 3);
+	for (i = 0; i < 3; i++) {
+		int exp = i < 2 ? 100 : 37;
+
+		msg = mt76_test_msg(mt76_test_fake, i);
+		KUNIT_EXPECT_EQ(test, msg->cmd, 0x99);
+		KUNIT_ASSERT_EQ(test, msg->len, exp);
+		KUNIT_EXPECT_MEMEQ(test, msg->data, fw + 100 * i, exp);
+	}
+	KUNIT_EXPECT_TRUE(test, st->seq_null);
+	KUNIT_EXPECT_EQ(test, st->n_cleanup, 3);
+	KUNIT_EXPECT_PTR_EQ(test, st->cleanup_q, &fwdl);
+	KUNIT_EXPECT_FALSE(test, st->cleanup_flush);
+
+	/* the inline wrapper leaves room for the bus header in each chunk */
+	KUNIT_ASSERT_EQ(test, mt76_mcu_send_firmware(dev, 0x98, fw, len), 0);
+	msg = mt76_test_msg(mt76_test_fake, 3);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->len, len);	/* fits in one */
+
+	/* nothing to send */
+	KUNIT_EXPECT_EQ(test, __mt76_mcu_send_firmware(dev, 0x99, fw, 0, 100),
+			0);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 4);
+}
+
+/* A failed chunk aborts the download with its error. */
+static void mt76_mcu_test_send_firmware_error(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	struct mt76_mcu_test_state *st = &mt76_mcu_test_state;
+	u8 fw[300] = {};
+
+	st->fail_at = 2;
+	st->fail_ret = -ETIMEDOUT;
+	KUNIT_EXPECT_EQ(test, __mt76_mcu_send_firmware(dev, 0x99, fw,
+						       sizeof(fw), 100),
+			-ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, st->n_send, 2);
+	KUNIT_EXPECT_EQ(test, st->n_cleanup, 1);
+}
+
+/* Buses without a queue cleanup hook download all the same. */
+static void mt76_mcu_test_send_firmware_no_cleanup(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_mcu_test_dev(test, &mt76_mcu_test_ops);
+	u8 fw[250] = {};
+
+	dev->queue_ops = &mt76_mcu_test_no_cleanup_ops;
+	KUNIT_EXPECT_EQ(test, __mt76_mcu_send_firmware(dev, 0x99, fw,
+						       sizeof(fw), 100), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 3);
+}
