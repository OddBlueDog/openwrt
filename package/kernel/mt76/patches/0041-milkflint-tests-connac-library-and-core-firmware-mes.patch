+/* The hardware reports space-time streams; with STBC the data streams are
+ * half of those.
+ */
+static void mt76_connac_test_txs_stbc(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_wcid *wcid;
+	__le32 txs[8] = {};
+
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+
+	txs[0] = cpu_to_le32(le32_to_cpu(mt76_connac_test_txs(MT_PHY_TYPE_VHT,
+					4, 2, 0, 0)) |
+			     FIELD_PREP(MT_TXS0_TX_RATE, MT_TX_RATE_STBC));
+	KUNIT_ASSERT_TRUE(test, mt76_connac2_mac_fill_txs(dev, wcid, txs));
+	KUNIT_EXPECT_EQ(test, wcid->rate.nss, 1);
