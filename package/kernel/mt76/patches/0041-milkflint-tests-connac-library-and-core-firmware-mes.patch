+	.wake_tx_queue = mt76_test_wake_tx_queue,
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
+};
+
+/* --- fake firmware ------------------------------------------------------ */
+
+static struct mt76_connac_mcu_test_fw {
+	u8 sem_get, sem_rel;	/* PATCH_SEM_CONTROL answers */
+	int fail_cmd, fail_nth;	/* the fail_nth-th fail_cmd send fails */
+	int fail_ret, n_fail_cmd;
+	bool oom_after_send;	/* message allocations fail after a send */
+} mt76_connac_mcu_test_fw;
+
+static const struct mt76_mcu_ops mt76_connac_mcu_test_oom_ops;
+
+static int mt76_connac_mcu_test_send(struct mt76_dev *dev,
+				     struct sk_buff *skb, int cmd, int *seq)
+{
+	struct mt76_connac_mcu_test_fw *fw = &mt76_connac_mcu_test_fw;
+
+	if (fw->oom_after_send)
+		dev->mcu_ops = &mt76_connac_mcu_test_oom_ops;
+	if (cmd == fw->fail_cmd && ++fw->n_fail_cmd == fw->fail_nth) {
+		dev_kfree_skb(skb);
+		return fw->fail_ret;
+	}
+
+	return mt76_test_mcu_send(dev, skb, cmd, seq);
+}
+
+/* like mt7915_mcu_parse_response(): the semaphore status is the payload */
+static int mt76_connac_mcu_test_parse(struct mt76_dev *dev, int cmd,
+				      struct sk_buff *skb, int seq)
+{
+	int ret = mt76_test_mcu_parse(dev, cmd, skb, seq);
+
+	if (ret || cmd != MCU_CMD(PATCH_SEM_CONTROL))
+		return ret;
+
+	return skb->len ? skb->data[0] : 0;
+}
+
+static void mt76_connac_mcu_test_reply(struct mt76_test_fake *fake,
+				       const struct mt76_test_msg *msg,
+				       struct sk_buff *reply)
+{
+	struct mt76_connac_mcu_test_fw *fw = &mt76_connac_mcu_test_fw;
+
+	if (msg->cmd == MCU_CMD(PATCH_SEM_CONTROL))
+		skb_put_u8(reply, msg->data[0] == PATCH_SEM_GET ?
+				  fw->sem_get : fw->sem_rel);
+}
+
+static const struct mt76_mcu_ops mt76_connac_mcu_test_mcu_ops = {
+	.mcu_skb_send_msg = mt76_connac_mcu_test_send,
+	.mcu_parse_response = mt76_connac_mcu_test_parse,
+};
+
+/* A headroom no allocation can satisfy: every message allocation fails
+ * (quietly: skb heads are allocated with __GFP_NOWARN first).
+ */
+static const struct mt76_mcu_ops mt76_connac_mcu_test_oom_ops = {
+	.headroom = SZ_1G,
+	.mcu_skb_send_msg = mt76_connac_mcu_test_send,
+	.mcu_parse_response = mt76_connac_mcu_test_parse,
+};
+
+static const struct mt76_queue_ops mt76_connac_mcu_test_queue_ops = {};
+
+static struct mt76_dev *mt76_connac_mcu_test_dev(struct kunit *test)
+{
+	struct mt76_dev *dev;
+
+	dev = mt76_test_dev(test, sizeof(*dev), &mt76_connac_mcu_test_hw_ops,
+			    NULL);
+	dev->rev = MT76_CONNAC_MCU_TEST_REV;
+	dev->mcu_ops = &mt76_connac_mcu_test_mcu_ops;
+	dev->queue_ops = &mt76_connac_mcu_test_queue_ops;
+	/* nothing here waits for an answer that doesn't come */
+	dev->mcu.timeout = 2;
+	mt76_test_fake->reply = mt76_connac_mcu_test_reply;
+	memset(&mt76_connac_mcu_test_fw, 0, sizeof(mt76_connac_mcu_test_fw));
+	mt76_connac_mcu_test_fw.sem_get = PATCH_NOT_DL_SEM_SUCCESS;
+	mt76_connac_mcu_test_fw.sem_rel = PATCH_REL_SEM_SUCCESS;
+	return dev;
+}
+
+static void mt76_connac_mcu_test_fail(int cmd, int nth, int ret)
+{
+	mt76_connac_mcu_test_fw.fail_cmd = cmd;
+	mt76_connac_mcu_test_fw.fail_nth = nth;
+	mt76_connac_mcu_test_fw.fail_ret = ret;
+}
