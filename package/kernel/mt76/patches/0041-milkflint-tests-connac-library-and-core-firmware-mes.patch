+/* Starting a BA session takes two station updates with the same command:
+ * one with the WTBL BA entry, then one with the station BA TLV.
+ */
+static void mt76_connac_mcu_test_sta_ba(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 0x10a);
+	struct ieee80211_ampdu_params params = {
+		.sta = sta,
+		.tid = 2,
+		.ssn = 100,
+		.buf_size = 256,
+	};
+	int cmd = MCU_EXT_CMD(STA_REC_UPDATE);
+	int hdr = sizeof(struct sta_req_hdr);
+	struct ieee80211_vif *vif;
+	struct sta_req_hdr *req;
+	struct mt76_test_msg *msg;
+	struct tlv *sta_wtbl;
+	struct wtbl_req_hdr *wtbl_hdr;
+	struct wtbl_ba *wba;
+	struct sta_rec_ba *ba;
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 1);
+	KUNIT_ASSERT_EQ(test, mt76_connac_mcu_sta_ba(dev,
+			mt76_connac_mcu_test_mvif(vif), &params, cmd, true,
+			true), 0);
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 2);
+
+	msg = mt76_test_msg(mt76_test_fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, cmd);
+	req = (struct sta_req_hdr *)msg->data;
+	KUNIT_EXPECT_EQ(test, req->wlan_idx_lo, 0x0a);
+	KUNIT_EXPECT_EQ(test, req->wlan_idx_hi, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->tlv_num), 1);
+	sta_wtbl = mt76_connac_mcu_test_msg_tlv(test, msg, hdr, STA_REC_WTBL);
+	KUNIT_ASSERT_NOT_NULL(test, sta_wtbl);
+	wtbl_hdr = (struct wtbl_req_hdr *)(sta_wtbl + 1);
+	KUNIT_EXPECT_EQ(test, wtbl_hdr->operation, WTBL_SET);
+	KUNIT_EXPECT_EQ(test, wtbl_hdr->wlan_idx_lo, 0x0a);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(wtbl_hdr->tlv_num), 1);
+	wba = mt76_connac_mcu_test_wtbl_tlv(test, sta_wtbl, WTBL_BA);
+	KUNIT_ASSERT_NOT_NULL(test, wba);
+	KUNIT_EXPECT_EQ(test, wba->tid, 2);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(wba->sn), 100);
+	KUNIT_EXPECT_EQ(test, wba->ba_en, 1);
+
+	msg = mt76_test_msg(mt76_test_fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->cmd, cmd);
+	KUNIT_EXPECT_EQ(test, msg->len, hdr + sizeof(*ba));
+	ba = mt76_connac_mcu_test_msg_tlv(test, msg, hdr, STA_REC_BA);
+	KUNIT_ASSERT_NOT_NULL(test, ba);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, BIT(2));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->winsize), 256);
+}
