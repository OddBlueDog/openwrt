+	KUNIT_CASE(mt76_connac_mcu_test_wtbl_smps),
+	KUNIT_CASE(mt76_connac_mcu_test_wtbl_ht),
+	KUNIT_CASE(mt76_connac_mcu_test_wtbl_ht_6g),
+	KUNIT_CASE(mt76_connac_mcu_test_wtbl_ht_v1),
+	KUNIT_CASE(mt76_connac_mcu_test_wtbl_ba),
+	KUNIT_CASE(mt76_connac_mcu_test_sta_ba),
+	KUNIT_CASE(mt76_connac_mcu_test_sta_ba_error),
+	KUNIT_CASE(mt76_connac_mcu_test_sta_wed_update),
+	KUNIT_CASE(mt76_connac_mcu_test_add_key_ccmp),
+	KUNIT_CASE(mt76_connac_mcu_test_add_key_tkip),
+	KUNIT_CASE(mt76_connac_mcu_test_add_key_bip),
+	KUNIT_CASE(mt76_connac_mcu_test_add_key_remove),
+	KUNIT_CASE(mt76_connac_mcu_test_add_key_errors),
+	KUNIT_CASE(mt76_connac_mcu_test_alloc_fails),
+	KUNIT_CASE(mt76_connac_mcu_test_load_patch),
+	KUNIT_CASE(mt76_connac_mcu_test_load_patch_encrypted),
+	KUNIT_CASE(mt76_connac_mcu_test_load_patch_sem),
+	KUNIT_CASE(mt76_connac_mcu_test_load_patch_errors),
+	KUNIT_CASE(mt76_connac_mcu_test_load_ram),
+	KUNIT_CASE(mt76_connac_mcu_test_load_ram_errors),
+	KUNIT_CASE(mt76_connac_mcu_test_fill_ext),
+	KUNIT_CASE(mt76_connac_mcu_test_fill_kinds),
+	KUNIT_CASE(mt76_connac_mcu_test_fill_uni),
+	KUNIT_CASE(mt76_connac_mcu_test_fill_seq),
+	{}
+};
+
+static struct kunit_suite mt76_connac_mcu_test_suite = {
+	.name = "mt76-connac-mcu",
+	.test_cases = mt76_connac_mcu_test_cases,
+};
+
+kunit_test_suites(&mt76_connac_mcu_test_suite);
