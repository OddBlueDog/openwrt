+/* Extended BSSs get their beacons spread out: each one's TSF is offset by
+ * a beacon's airtime. The hardware BSSIDs get no such TLV.
+ */
+static void mt76_connac_mcu_test_bss_ext(struct kunit *test)
+{
+	struct ieee80211_vif *vif;
+	struct bss_info_ext_bss *ext;
+	struct sk_buff *skb;
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, HW_BSSID_1);
+	skb = mt76_connac_mcu_test_skb(test, 4);
+	mt76_connac_mcu_bss_ext_tlv(skb, mt76_connac_mcu_test_mvif(vif));
+	KUNIT_EXPECT_EQ(test, skb->len, 4);
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP,
+				       EXT_BSSID_START + 2);
+	mt76_connac_mcu_bss_ext_tlv(skb, mt76_connac_mcu_test_mvif(vif));
+	ext = mt76_connac_mcu_test_skb_tlv(test, skb, 4, BSS_INFO_EXT_BSS);
+	KUNIT_ASSERT_NOT_NULL(test, ext);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ext->len), sizeof(*ext));
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ext->mbss_tsf_offset),
+			2 * (4096 + 20));
+}
