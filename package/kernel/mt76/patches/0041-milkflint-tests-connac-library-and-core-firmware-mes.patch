+/* --- TLVs ----------------------------------------------------------------- */
+
+static void mt76_connac_mcu_test_free_skb(void *skb)
+{
+	kfree_skb(skb);
+}
+
+/* An skb to build TLVs in, starting with a zeroed @hdr_len byte request
+ * header; the room after it is filled with garbage, so a TLV that isn't
+ * zeroed shows.
+ */
+static struct sk_buff *mt76_connac_mcu_test_skb(struct kunit *test,
+						int hdr_len)
+{
+	struct sk_buff *skb = alloc_skb(1024, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_connac_mcu_test_free_skb, skb), 0);
+	memset(skb->data, 0xa5, skb_tailroom(skb));
+	skb_put_zero(skb, hdr_len);
+	return skb;
+}
+
+/* The first TLV tagged @tag in the @len bytes at @buf, or NULL. Every TLV
+ * on the way must be well formed.
+ */
+static void *mt76_connac_mcu_test_find(struct kunit *test, const void *buf,
+				       int len, int tag)
+{
+	while (len > 0) {
+		const struct tlv *tlv = buf;
+		int tlen;
+
+		KUNIT_ASSERT_GE(test, len, (int)sizeof(*tlv));
+		tlen = le16_to_cpu(tlv->len);
+		KUNIT_ASSERT_GE(test, tlen, (int)sizeof(*tlv));
+		KUNIT_ASSERT_LE(test, tlen, len);
+		if (le16_to_cpu(tlv->tag) == tag)
+			return (void *)tlv;
+		buf += tlen;
+		len -= tlen;
+	}
+	return NULL;
+}
+
+/* the TLV tagged @tag after the request header of @skb */
+static void *mt76_connac_mcu_test_skb_tlv(struct kunit *test,
+					  struct sk_buff *skb, int hdr_len,
+					  int tag)
+{
+	return mt76_connac_mcu_test_find(test, skb->data + hdr_len,
+					 skb->len - hdr_len, tag);
+}
+
+/* the TLV tagged @tag in message @msg after its @hdr_len byte header */
+static void *mt76_connac_mcu_test_msg_tlv(struct kunit *test,
+					  struct mt76_test_msg *msg,
+					  int hdr_len, int tag)
+{
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_ASSERT_GE(test, msg->len, hdr_len);
+	return mt76_connac_mcu_test_find(test, msg->data + hdr_len,
+					 msg->len - hdr_len, tag);
+}
+
+/* the WTBL TLV tagged @tag inside a STA_REC_WTBL TLV */
+static void *mt76_connac_mcu_test_wtbl_tlv(struct kunit *test,
+					   struct tlv *sta_wtbl, int tag)
+{
+	int hdr = sizeof(struct tlv) + sizeof(struct wtbl_req_hdr);
+
+	KUNIT_ASSERT_NOT_NULL(test, sta_wtbl);
+	return mt76_connac_mcu_test_find(test, (u8 *)sta_wtbl + hdr,
+					 le16_to_cpu(sta_wtbl->len) - hdr,
+					 tag);
+}
+
+static u16 mt76_connac_mcu_test_ntlv(const void *hdr)
+{
+	return le16_to_cpu(((const struct sta_ntlv_hdr *)hdr)->tlv_num);
+}
+
+/* --- simple commands ----------------------------------------------------- */
+
+/* the payload of the last @cmd message, at least @len bytes */
+static void *mt76_connac_mcu_test_req(struct kunit *test, int cmd, int len)
+{
+	struct mt76_test_msg *msg = mt76_test_find_msg(mt76_test_fake, cmd);
+
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_ASSERT_EQ(test, msg->len, len);
+	return msg->data;
+}
