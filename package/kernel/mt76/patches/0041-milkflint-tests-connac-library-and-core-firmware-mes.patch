+/* With STBC, mac80211 wants the number of STBC streams in enc_flags
+ * (RX_ENC_FLAG_STBC_SHIFT); the driver puts in RX_ENC_FLAG_STBC_MASK *
+ * stbc, i.e. 3 for one, and for two it spills into RX_ENC_FLAG_LDPC.
+ */
+static void mt76_connac_test_rx_rate_stbc_flags(struct kunit *test)
+{
+	struct mt76_dev *dev;
+	struct mt76_rx_status status;
+	u8 mode;
+
+	kunit_skip(test, "driver bug: rx STBC reported as RX_ENC_FLAG_STBC_MASK * stbc");
+
+	dev = mt76_connac_test_dev(test);
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status,
+			&dev->phy.sband_5g.sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_HT, 1, 2, 0, 0, 1,
+					      false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, status.enc_flags, 1 << RX_ENC_FLAG_STBC_SHIFT);
+	KUNIT_ASSERT_EQ(test, mt76_connac_test_rx_rate(dev, &status,
+			&dev->phy.sband_5g.sband,
+			mt76_connac_test_prxv(MT_PHY_TYPE_HT, 1, 3, 0, 0, 2,
+					      false), &mode), 0);
+	KUNIT_EXPECT_EQ(test, status.enc_flags, 2 << RX_ENC_FLAG_STBC_SHIFT);
+}
