+	KUNIT_EXPECT_EQ(test, le32_to_cpu(bss->network_type), NETWORK_INFRA);
+	KUNIT_EXPECT_MEMEQ(test, bss->bssid, mt76_connac_mcu_test_bssid,
+			   ETH_ALEN);
+
+	/* monitor: our own address, no beacons */
+	eth_random_addr(dev->phy.macaddr);
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_MONITOR, 0);
+	vif->bss_conf.beacon_int = 100;
+	bss = mt76_connac_mcu_test_bss_basic(test, dev, vif, NULL, 9, true,
+					     &ret);
+	KUNIT_EXPECT_MEMEQ(test, bss->bssid, dev->phy.macaddr, ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(bss->bcn_interval), 0);
+	KUNIT_EXPECT_EQ(test, bss->phy_mode, 0);
+}
