+/* wiphy bands for the phy-mode lookups: 2.4 GHz HT+HE and 5 GHz
+ * HT+VHT+HE, HE for AP interfaces only.
+ */
+static struct ieee80211_sband_iftype_data mt76_connac_mcu_test_he = {
+	.types_mask = BIT(NL80211_IFTYPE_AP),
+	.he_cap = {
+		.has_he = true,
+		.he_mcs_nss_supp = {
+			.tx_mcs_80 = cpu_to_le16(0xfffa),
+		},
+	},
+};
+
+static struct ieee80211_channel mt76_connac_mcu_test_chan_2g = {
+	.band = NL80211_BAND_2GHZ,
+	.center_freq = 2437,
+	.hw_value = 6,
+};
+
+static struct ieee80211_channel mt76_connac_mcu_test_chan_5g = {
+	.band = NL80211_BAND_5GHZ,
+	.center_freq = 5180,
+	.hw_value = 36,
+};
+
+static void mt76_connac_mcu_test_bands(struct kunit *test, struct mt76_dev *dev)
+{
+	struct wiphy *wiphy = dev->hw->wiphy;
+	struct ieee80211_supported_band *sband;
+
+	sband = kunit_kcalloc(test, 2, sizeof(*sband), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sband);
+	sband[0].band = NL80211_BAND_2GHZ;
+	sband[0].ht_cap.ht_supported = true;
+	_ieee80211_set_sband_iftype_data(&sband[0], &mt76_connac_mcu_test_he,
+					 1);
+	sband[1].band = NL80211_BAND_5GHZ;
+	sband[1].ht_cap.ht_supported = true;
+	sband[1].vht_cap.vht_supported = true;
+	_ieee80211_set_sband_iftype_data(&sband[1], &mt76_connac_mcu_test_he,
+					 1);
+	wiphy->bands[NL80211_BAND_2GHZ] = &sband[0];
+	wiphy->bands[NL80211_BAND_5GHZ] = &sband[1];
+	dev->phy.chandef.chan = &mt76_connac_mcu_test_chan_5g;
+}
+
+/* The phy modes of a peer come from its capabilities; with no peer, from
+ * what our own band supports for this interface type.
+ */
+static void mt76_connac_mcu_test_phy_mode(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_vif *ap, *sta_vif;
+	struct ieee80211_sta *sta;
+	struct ieee80211_link_sta *link;
+	struct mt76_phy *phy = &dev->phy;
+
+	mt76_connac_mcu_test_bands(test, dev);
+	ap = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 0);
+	sta_vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_STATION, 0);
+	sta = mt76_connac_mcu_test_sta(test, 1);
+	link = &sta->deflink;
+
+	/* a legacy-only peer */
+	KUNIT_EXPECT_EQ(test, mt76_connac_get_phy_mode(phy, ap,
+			NL80211_BAND_2GHZ, link), PHY_MODE_B | PHY_MODE_G);
+	KUNIT_EXPECT_EQ(test, mt76_connac_get_phy_mode(phy, ap,
+			NL80211_BAND_5GHZ, link), PHY_MODE_A);
+
+	link->ht_cap.ht_supported = true;
+	link->vht_cap.vht_supported = true;
+	link->he_cap.has_he = true;
+	KUNIT_EXPECT_EQ(test, mt76_connac_get_phy_mode(phy, ap,
+			NL80211_BAND_2GHZ, link),
+			PHY_MODE_B | PHY_MODE_G | PHY_MODE_GN |
+			PHY_MODE_AX_24G);
+	KUNIT_EXPECT_EQ(test, mt76_connac_get_phy_mode(phy, ap,
+			NL80211_BAND_5GHZ, link),
+			PHY_MODE_A | PHY_MODE_AN | PHY_MODE_AC |
+			PHY_MODE_AX_5G);
+	/* 6 GHz implies everything up to HE */
+	KUNIT_EXPECT_EQ(test, mt76_connac_get_phy_mode(phy, ap,
+			NL80211_BAND_6GHZ, link),
+			PHY_MODE_A | PHY_MODE_AN | PHY_MODE_AC |
+			PHY_MODE_AX_5G);
+
+	/* our own capabilities: HE is only there for AP interfaces */
+	KUNIT_EXPECT_EQ(test, mt76_connac_get_phy_mode(phy, ap,
+			NL80211_BAND_5GHZ, NULL),
+			PHY_MODE_A | PHY_MODE_AN | PHY_MODE_AC |
+			PHY_MODE_AX_5G);
+	KUNIT_EXPECT_EQ(test, mt76_connac_get_phy_mode(phy, sta_vif,
+			NL80211_BAND_5GHZ, NULL),
+			PHY_MODE_A | PHY_MODE_AN | PHY_MODE_AC);
+	KUNIT_EXPECT_EQ(test, mt76_connac_get_phy_mode(phy, sta_vif,
+			NL80211_BAND_2GHZ, NULL),
+			PHY_MODE_B | PHY_MODE_G | PHY_MODE_GN);
+
+	/* connac v1 firmware takes a fixed value */
+	dev->rev = MT76_CONNAC_MCU_TEST_V1_REV;
+	KUNIT_EXPECT_EQ(test, mt76_connac_get_phy_mode(phy, ap,
+			NL80211_BAND_2GHZ, link), 0x38);
+}
+
+/* Our HE capabilities for an interface are those of the band it's on:
+ * its channel context's, or the phy's channel without one.
+ */
+static void mt76_connac_mcu_test_he_phy_cap(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_chanctx_conf *ctx;
+	struct ieee80211_vif *vif;
+	struct wiphy *wiphy;
+
+	mt76_connac_mcu_test_bands(test, dev);
+	wiphy = dev->hw->wiphy;
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 0);
+
+	KUNIT_EXPECT_PTR_EQ(test, mt76_connac_get_he_phy_cap(&dev->phy, vif),
+			    &mt76_connac_mcu_test_he.he_cap);
+
+	/* the context's band, not the phy's */
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	ctx->def.chan = &mt76_connac_mcu_test_chan_2g;
+	mt76_connac_mcu_test_mvif(vif)->ctx = ctx;
+	wiphy->bands[NL80211_BAND_5GHZ] = NULL;
+	KUNIT_EXPECT_PTR_EQ(test, mt76_connac_get_he_phy_cap(&dev->phy, vif),
+			    &mt76_connac_mcu_test_he.he_cap);
+
+	/* no HE for stations */
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_STATION, 0);
+	mt76_connac_mcu_test_mvif(vif)->ctx = ctx;
+	KUNIT_EXPECT_NULL(test, mt76_connac_get_he_phy_cap(&dev->phy, vif));
+}
