+/* When no message can be allocated the station commands fail with
+ * -ENOMEM and send nothing; a BA session whose second message can't be
+ * allocated has sent only the first.
+ */
+static void mt76_connac_mcu_test_alloc_fails(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 2);
+	struct mt76_wcid *wcid = mt76_connac_mcu_test_wcid(sta);
+	struct ieee80211_ampdu_params params = { .sta = sta, .tid = 1 };
+	struct mt76_connac_sta_key_conf conf = {};
+	struct ieee80211_key_conf *key;
+	struct ieee80211_vif *vif;
+	struct mt76_vif_link *mvif;
+	struct sk_buff *skb = NULL;
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 1);
+	mvif = mt76_connac_mcu_test_mvif(vif);
+	key = mt76_connac_mcu_test_key(test, WLAN_CIPHER_SUITE_CCMP, 1, 16);
+
+	mt76_connac_mcu_test_fw.oom_after_send = true;
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_sta_ba(dev, mvif, &params,
+			MCU_EXT_CMD(STA_REC_UPDATE), true, true), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 1);
+
+	/* from here on, nothing can be allocated */
+	KUNIT_EXPECT_PTR_EQ(test, dev->mcu_ops, &mt76_connac_mcu_test_oom_ops);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_sta_ba(dev, mvif, &params,
+			MCU_EXT_CMD(STA_REC_UPDATE), true, true), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_add_key(dev, vif, &conf, key,
+			MCU_EXT_CMD(STA_REC_UPDATE), wcid, SET_KEY), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_wtbl_update_hdr_trans(dev, vif,
+								    sta),
+			-ENOMEM);
+	KUNIT_EXPECT_EQ(test, PTR_ERR(mt76_connac_mcu_alloc_sta_req(dev, mvif,
+								    wcid)),
+			-ENOMEM);
+	KUNIT_EXPECT_EQ(test, PTR_ERR(mt76_connac_mcu_alloc_wtbl_req(dev, wcid,
+			WTBL_SET, NULL, &skb)), -ENOMEM);
+	KUNIT_EXPECT_NULL(test, skb);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 1);
+}
