+/* If the WTBL update fails, the station update isn't sent; a failing
+ * second update is reported too.
+ */
+static void mt76_connac_mcu_test_sta_ba_error(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 3);
+	struct ieee80211_ampdu_params params = { .sta = sta, .tid = 1 };
+	int cmd = MCU_EXT_CMD(STA_REC_UPDATE);
+	struct ieee80211_vif *vif;
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 1);
+	mt76_connac_mcu_test_fail(cmd, 1, -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_sta_ba(dev,
+			mt76_connac_mcu_test_mvif(vif), &params, cmd, false,
+			false), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_fw.n_fail_cmd, 1);
+
+	mt76_connac_mcu_test_fail(cmd, 2, -ETIMEDOUT);
+	mt76_connac_mcu_test_fw.n_fail_cmd = 0;
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_sta_ba(dev,
+			mt76_connac_mcu_test_mvif(vif), &params, cmd, false,
+			false), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_fw.n_fail_cmd, 2);
+}
