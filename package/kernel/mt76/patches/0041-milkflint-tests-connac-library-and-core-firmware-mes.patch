+/* MT7915 reports mode, GI, STBC and bandwidth in C-RXV dword 2. */
+static void mt76_connac_test_rx_rate_mt7915(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_rx_status status = {};
+	__le32 rxv[16] = {};
+	u8 mode;
+
+	dev->rev = 0x79150000;
+	rxv[0] = cpu_to_le32(FIELD_PREP(MT_PRXV_TX_RATE, 7) |
+			     FIELD_PREP(MT_PRXV_NSTS, 1));
+	rxv[2] = cpu_to_le32(FIELD_PREP(MT_CRXV_TX_MODE, MT_PHY_TYPE_VHT) |
+			     FIELD_PREP(MT_CRXV_FRAME_MODE,
+					IEEE80211_STA_RX_BW_80) |
+			     FIELD_PREP(MT_CRXV_HT_SHORT_GI, 1));
+	KUNIT_ASSERT_EQ(test, mt76_connac2_mac_fill_rx_rate(dev, &status,
+			&dev->phy.sband_5g.sband, rxv, &mode), 0);
+	KUNIT_EXPECT_EQ(test, mode, MT_PHY_TYPE_VHT);
+	KUNIT_EXPECT_EQ(test, status.rate_idx, 7);
+	KUNIT_EXPECT_EQ(test, (int)status.nss, 2);
+	KUNIT_EXPECT_EQ(test, (int)status.bw, RATE_INFO_BW_80);
+	KUNIT_EXPECT_TRUE(test, status.enc_flags & RX_ENC_FLAG_SHORT_GI);
+}
