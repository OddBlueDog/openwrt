diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
index 6eb752cd..411faabb 100644
--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -1931,11 +1931,64 @@ static const struct file_operations fops_sta_tx_tries = {
 	.llseek = default_llseek,
 };
 
+/* The station's pacing (mt76_tx_pace_*() in mt76's tx.c): the share of the
+ * time, in 1/1000, its best effort and background frames may be sent for
+ * while a station that isn't paced has frames waiting; 0 (the default): not
+ * paced. Reads back the share, whether it is paced right now, how many
+ * times it was held and for how many microseconds in all. For user space
+ * that judges links (MilkFlint's airtime service).
+ */
+static ssize_t
+mt7915_sta_tx_pace_read(struct file *file, char __user *ubuf, size_t count,
+			loff_t *ppos)
+{
+	struct ieee80211_sta *sta = file->private_data;
+	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
+	struct mt76_wcid *wcid = &msta->wcid;
+	char buf[64];
+	int n;
+
+	n = scnprintf(buf, sizeof(buf), "%u %u %u %llu\n",
+		      READ_ONCE(wcid->tx_pace), READ_ONCE(wcid->pace_on),
+		      READ_ONCE(wcid->pace_holds), READ_ONCE(wcid->pace_held));
+
+	return simple_read_from_buffer(ubuf, count, ppos, buf, n);
+}
+
+static ssize_t
+mt7915_sta_tx_pace_write(struct file *file, const char __user *ubuf,
+			 size_t count, loff_t *ppos)
+{
+	struct ieee80211_sta *sta = file->private_data;
+	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
+	u16 val;
+	int ret;
+
+	ret = kstrtou16_from_user(ubuf, count, 0, &val);
+	if (ret)
+		return ret;
+	if (val > 1000)
+		return -EINVAL;
+
+	WRITE_ONCE(msta->wcid.tx_pace, val);
+
+	return count;
+}
+
+static const struct file_operations fops_sta_tx_pace = {
+	.read = mt7915_sta_tx_pace_read,
+	.write = mt7915_sta_tx_pace_write,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
+
 void mt7915_sta_add_debugfs(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 			    struct ieee80211_sta *sta, struct dentry *dir)
 {
 	debugfs_create_file("fixed_rate", 0600, dir, sta, &fops_fixed_rate);
 	debugfs_create_file("tx_tries", 0600, dir, sta, &fops_sta_tx_tries);
+	debugfs_create_file("tx_pace", 0600, dir, sta, &fops_sta_tx_pace);
 	debugfs_create_file("hw-queues", 0400, dir, sta, &mt7915_queues_fops);
 	debugfs_create_file("ps", 0400, dir, sta, &mt7915_sta_ps_fops);
 	debugfs_create_file("tx_attempts", 0400, dir, sta,
diff --git a/tests/ps-sim-test.c b/tests/ps-sim-test.c
index f3323eae..a4b643ef 100644
--- a/tests/ps-sim-test.c
+++ b/tests/ps-sim-test.c
@@ -220,6 +220,8 @@ struct psim {
 	unsigned int n_ps_burst_late;
 	unsigned long tim_warn;		/* an AC held with nothing in the fw */
 	unsigned long events_lost;
+	/* mac80211's airtime estimates of what each station was handed, us */
+	u64 est[PSIM_MAX_STA];
 };
 
 static struct psim *psim_ctx;
@@ -386,6 +388,7 @@ static int psim_queue_skb(struct mt76_phy *phy, struct mt76_queue *q,
 		return -ENOMEM;
 	}
 	f->state = PF_HW;
+	s->est[f->sta] += ieee80211_info_get_tx_time_est(IEEE80211_SKB_CB(skb));
 	if (f->poll && qid == MT_TXQ_PSD) {
 		/*
 		 * The PS queue: the firmware sends it on ALTX, at once, without
@@ -1805,9 +1808,266 @@ static const void *psim_seed_params(const void *prev, char *desc)
 	return cfg;
 }
 
+/* --- pacing (mt76_tx_pace_*() in tx.c) on mac80211's stations and queues --- */
+
+static unsigned long psim_txq_depth(struct psim_sta *ps, u8 tid)
+{
+	unsigned long frames;
+
+	ieee80211_txq_get_depth(ps->si->sta.txq[tid], &frames, NULL);
+
+	return frames;
+}
+
+static void psim_pace_workers(struct psim *s)
+{
+	int n;
+
+	for (n = 0; n < 100 && psim_worker(s); n++)
+		;
+	KUNIT_ASSERT_LT(s->test, n, 100);
+}
+
+/* A millisecond: best effort frames for the two stations until @fast and
+ * @slow of them wait in their queues, the worker, the air (everything in the
+ * hardware goes out), the pacing timer if a station waits for it, the worker.
+ */
+static void psim_pace_ms(struct psim *s, unsigned int fast, unsigned int slow)
+{
+	struct mt76_dev *dev = s->dev;
+
+	mt76_tx_pace_test_now += USEC_PER_MSEC;
+	s->step++;
+	while (psim_txq_depth(&s->sta[0], 0) < fast &&
+	       s->n_frames < PSIM_MAX_FRAMES)
+		psim_enqueue(s, &s->sta[0], 0);
+	while (psim_txq_depth(&s->sta[1], 0) < slow &&
+	       s->n_frames < PSIM_MAX_FRAMES)
+		psim_enqueue(s, &s->sta[1], 0);
+	psim_pace_workers(s);
+	psim_transmit(s);
+	if (!bitmap_empty(dev->pace_wait, MT76_N_WCIDS))
+		mt76_tx_pace_timer(&dev->pace_timer);
+	psim_pace_workers(s);
+}
+
+/* A millisecond of the other kind of wait: the fast station's queue is
+ * emptied at every turn (it has @total frames in all, queued or in the
+ * hardware), but only @air of them go out, so that its airtime in the
+ * hardware never runs out: a TCP sender on the router itself.
+ */
+static void psim_pace_ms_hw(struct psim *s, unsigned int total,
+			    unsigned int air, unsigned int slow)
+{
+	struct mt76_dev *dev = s->dev;
+
+	mt76_tx_pace_test_now += USEC_PER_MSEC;
+	s->step++;
+	while (s->sta[0].backlog < total && s->n_frames < PSIM_MAX_FRAMES)
+		psim_enqueue(s, &s->sta[0], 0);
+	while (psim_txq_depth(&s->sta[1], 0) < slow &&
+	       s->n_frames < PSIM_MAX_FRAMES)
+		psim_enqueue(s, &s->sta[1], 0);
+	psim_pace_workers(s);
+	KUNIT_EXPECT_EQ(s->test, psim_txq_depth(&s->sta[0], 0), 0);
+	psim_air(s, &s->sta[0], air);
+	psim_air(s, &s->sta[1], 1024);
+	psim_dma(s);
+	psim_tx_free_done(s);
+	if (!bitmap_empty(dev->pace_wait, MT76_N_WCIDS))
+		mt76_tx_pace_timer(&dev->pace_timer);
+	psim_pace_workers(s);
+}
+
+/* the AP's channel: without one mac80211 has no band to look a station's
+ * rate up in, and its airtime estimates are a few microseconds a frame
+ */
+static struct ieee80211_chanctx_conf psim_pace_chanctx;
+
+static void psim_pace_reset(void *data)
+{
+	struct psim *s = data;
+
+	RCU_INIT_POINTER(s->sdata->vif.bss_conf.chanctx_conf, NULL);
+	mt76_tx_pace_test_now = 0;
+}
+
+/* A paced station beside one that isn't. Alone, or beside light traffic to
+ * the other, the paced one is sent to as it comes. While the other has
+ * frames left after its turns, the paced one gets its share of the time by
+ * mac80211's estimates, its voice frames still go at once, and the other
+ * keeps going. Once the other's queue has run dry for a while, the paced one
+ * is free again. The same share while the other's queue is emptied at every
+ * turn but its airtime in the hardware never runs out; and nothing is left
+ * waiting at the end.
+ */
+static void mt76_psim_test_pace(struct kunit *test)
+{
+	static const struct psim_cfg cfg = {
+		.seed = 7, .ps_sync = true,
+		.kinds = { PSIM_LAPTOP, PSIM_LAPTOP }, .n_sta = 2,
+	};
+	const unsigned int share = 250, ms = 400;
+	struct psim_sta *fast, *slow;
+	struct mt76_wcid *wcid;
+	struct mt76_dev *dev;
+	struct psim *s;
+	u64 est, est_fast;
+	u32 holds;
+	int i, ac;
+
+	skb_queue_head_init(&psim_skbs);
+	s = psim_init(test, &cfg);
+	dev = s->dev;
+	fast = &s->sta[0];
+	slow = &s->sta[1];
+	wcid = psim_wcid(slow);
+
+	/* no traffic or dozing of the simulation's own, and no real time:
+	 * the test moves the clock and runs the timer's function
+	 */
+	s->quiesce = true;
+	dev->pace_timer_set = false;
+	mt76_tx_pace_test_now = 10 * USEC_PER_SEC;
+	psim_pace_chanctx.def.chan = &psim_chan;
+	psim_pace_chanctx.def.width = NL80211_CHAN_WIDTH_20;
+	psim_pace_chanctx.def.center_freq1 = psim_chan.center_freq;
+	rcu_assign_pointer(s->sdata->vif.bss_conf.chanctx_conf,
+			   &psim_pace_chanctx);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, psim_pace_reset,
+							s), 0);
+	/* the fast one: little at a time in the hardware, so that frames are
+	 * left in its queue after its turn, as in a download
+	 */
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+		fast->si->airtime[ac].aql_limit_low = 1000;
+		fast->si->airtime[ac].aql_limit_high = 1000;
+	}
+	/* the rates their frames are reported at, for mac80211's estimates:
+	 * 54 and 6 Mbit/s (a full-size frame at 6 is 2 ms of air)
+	 */
+	psim_wcid(fast)->rate.legacy = 540;
+	wcid->rate.legacy = 60;
+	WRITE_ONCE(wcid->tx_pace, share);
+
+	/* alone: never held */
+	for (i = 0; i < 50; i++)
+		psim_pace_ms(s, 0, 8);
+	KUNIT_EXPECT_EQ(test, wcid->pace_holds, 0);
+	KUNIT_EXPECT_FALSE(test, wcid->pace_on);
+	KUNIT_EXPECT_GT(test, slow->acked, 100);
+	/* the estimates are those of 6 Mbit/s: a millisecond a frame or so */
+	KUNIT_ASSERT_GT(test, s->est[1], slow->acked * 300);
+	kunit_info(test, "alone: %lu frames in 50 ms, %llu us of airtime by estimate\n",
+		   slow->acked, s->est[1]);
+
+	/* light traffic to the other (a frame a millisecond, out before the
+	 * next): still never held
+	 */
+	for (i = 0; i < 30; i++)
+		psim_pace_ms(s, 1, 8);
+	KUNIT_EXPECT_EQ(test, wcid->pace_holds, 0);
+	KUNIT_EXPECT_FALSE(test, wcid->pace_on);
+
+	/* beside the other's backlog: its share, a turn more or less */
+	psim_pace_ms(s, 16, 8);
+	est = s->est[1];
+	est_fast = s->est[0];
+	holds = wcid->pace_holds;
+	for (i = 0; i < ms; i++) {
+		psim_pace_ms(s, 16, 8);
+		if (i != ms / 2)
+			continue;
+		/* voice for it in the middle of a wait: out at once */
+		KUNIT_EXPECT_NE(test, wcid->pace_since, 0);
+		psim_enqueue(s, slow, 6);
+		psim_enqueue(s, slow, 6);
+		psim_pace_workers(s);
+		KUNIT_EXPECT_EQ(test, psim_txq_depth(slow, 6), 0);
+	}
+	est = s->est[1] - est;
+	kunit_info(test, "paced at %u/1000 for %u ms: %llu us of airtime by estimate, held %u times; the other %llu us\n",
+		   share, ms, est, wcid->pace_holds - holds,
+		   s->est[0] - est_fast);
+	KUNIT_EXPECT_LE(test, est, (u64)ms * share + 6000);
+	KUNIT_EXPECT_GE(test, est, (u64)ms * share / 2);
+	KUNIT_EXPECT_TRUE(test, wcid->pace_on);
+	KUNIT_EXPECT_GT(test, wcid->pace_holds, holds + 10);
+	KUNIT_EXPECT_GT(test, s->est[0] - est_fast, (u64)ms * 500);
+
+	/* the other's queue has run dry for longer than MT76_PACE_BUSY_US */
+	for (i = 0; i < 70; i++)
+		psim_pace_ms(s, 0, 8);
+	holds = wcid->pace_holds;
+	est = s->est[1];
+	for (i = 0; i < 30; i++)
+		psim_pace_ms(s, 0, 8);
+	KUNIT_EXPECT_EQ(test, wcid->pace_holds, holds);
+	KUNIT_EXPECT_FALSE(test, wcid->pace_on);
+	KUNIT_EXPECT_EQ(test, wcid->pace_since, 0);
+	KUNIT_EXPECT_GT(test, wcid->pace_held, 0);
+	KUNIT_EXPECT_GT(test, s->est[1] - est, (u64)30 * share);
+
+	/* held again, then no longer paced: everything goes */
+	for (i = 0; i < 20; i++)
+		psim_pace_ms(s, 16, 8);
+	KUNIT_EXPECT_TRUE(test, wcid->pace_on);
+	WRITE_ONCE(wcid->tx_pace, 0);
+	for (i = 0; i < 20; i++)
+		psim_pace_ms(s, 0, 0);
+	KUNIT_EXPECT_FALSE(test, psim_busy(s));
+	KUNIT_EXPECT_EQ(test, wcid->pace_since, 0);
+
+	/* The other kind of wait: the fast one's queue is emptied at every
+	 * turn (mac80211's own limits again: 12 frames fit), half of what it
+	 * has goes out each millisecond, the rest stays in the hardware.
+	 */
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+		fast->si->airtime[ac].aql_limit_low = 5000;
+		fast->si->airtime[ac].aql_limit_high = 12000;
+	}
+	WRITE_ONCE(wcid->tx_pace, share);
+	for (i = 0; i < 60; i++)
+		psim_pace_ms(s, 0, 8);
+	KUNIT_EXPECT_FALSE(test, wcid->pace_on);
+	for (i = 0; i < 5; i++)
+		psim_pace_ms_hw(s, 12, 6, 8);
+	est = s->est[1];
+	holds = wcid->pace_holds;
+	for (i = 0; i < ms / 2; i++)
+		psim_pace_ms_hw(s, 12, 6, 8);
+	est = s->est[1] - est;
+	kunit_info(test, "paced beside a queue in the hardware for %u ms: %llu us of airtime by estimate, held %u times\n",
+		   ms / 2, est, wcid->pace_holds - holds);
+	KUNIT_EXPECT_LE(test, est, (u64)ms / 2 * share + 6000);
+	KUNIT_EXPECT_GE(test, est, (u64)ms / 2 * share / 2);
+	KUNIT_EXPECT_TRUE(test, wcid->pace_on);
+	KUNIT_EXPECT_GT(test, wcid->pace_holds, holds + 5);
+	WRITE_ONCE(wcid->tx_pace, 0);
+	for (i = 0; i < 20; i++)
+		psim_pace_ms(s, 0, 0);
+
+	KUNIT_EXPECT_FALSE(test, psim_busy(s));
+	KUNIT_EXPECT_TRUE(test, bitmap_empty(dev->pace_wait, MT76_N_WCIDS));
+	KUNIT_EXPECT_EQ(test, wcid->pace_since, 0);
+	for (i = 0; i < cfg.n_sta; i++) {
+		KUNIT_EXPECT_EQ(test, s->sta[i].backlog, 0);
+		for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
+			KUNIT_EXPECT_EQ(test,
+				atomic_read(&s->sta[i].si->airtime[ac].aql_tx_pending),
+				0);
+	}
+	KUNIT_EXPECT_EQ(test, atomic_read(&s->local->aql_total_pending_airtime),
+			0);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&psim_skbs));
+	skb_queue_purge(&psim_skbs);
+	dev->pace_timer_set = true;
+}
+
 static struct kunit_case mt76_psim_test_cases[] = {
 	KUNIT_CASE_PARAM(mt76_psim_test_run, psim_gen_params),
 	KUNIT_CASE_PARAM(mt76_psim_test_run, psim_seed_params),
+	KUNIT_CASE(mt76_psim_test_pace),
 	{}
 };
 
diff --git a/tests/tx-test.c b/tests/tx-test.c
index 088d24a1..1ce38862 100644
--- a/tests/tx-test.c
+++ b/tests/tx-test.c
@@ -1572,6 +1572,154 @@ static void mt76_tx_test_set_tx_blocked(struct kunit *test)
 	dev->phys[MT_BAND2] = NULL;
 }
 
+/* --- pacing (mt76_tx_pace_*()) -------------------------------------------- */
+
+/* How long a paced station's next frame waits: nothing while the air is
+ * free or it isn't paced, then each frame's estimate divided by the share,
+ * whatever the times it is looked at; no time saved up, and never longer
+ * than MT76_PACE_MAX_US.
+ */
+static void mt76_tx_test_pace_wait(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_wcid *wcid = mt76_tx_test_wcid(t, 1, 0, true, true);
+	u64 now = 1000000;
+	u32 wait;
+	int i;
+
+	/* not paced: no wait, nothing counted */
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now, true), 0);
+	mt76_wcid_pace_charge(wcid, now, 1400);
+	KUNIT_EXPECT_EQ(test, wcid->pace_tokens, 0);
+	KUNIT_EXPECT_FALSE(test, wcid->pace_on);
+
+	/* paced, the air free: no wait, and nothing owed for what goes out */
+	wcid->tx_pace = 250;
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now, false), 0);
+	KUNIT_EXPECT_FALSE(test, wcid->pace_on);
+	mt76_wcid_pace_charge(wcid, now, 1400);
+	KUNIT_EXPECT_EQ(test, wcid->pace_tokens, 0);
+
+	/* others wait: a first frame goes, the next after 4 times its airtime */
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now, true), 0);
+	KUNIT_EXPECT_TRUE(test, wcid->pace_on);
+	mt76_wcid_pace_charge(wcid, now, 1400);
+	KUNIT_EXPECT_EQ(test, wcid->pace_tokens, -1400);
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now, true), 5600);
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now + 2800, true), 2800);
+	wait = mt76_wcid_pace_wait(wcid, now + 5599, true);
+	KUNIT_EXPECT_TRUE(test, wait > 0 && wait <= 4);
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now + 5600, true), 0);
+
+	/* looked at every 3 us, it waits the same 5600 us */
+	for (i = 0; i < 5600; i += 3)
+		KUNIT_ASSERT_NE(test, mt76_wcid_pace_wait(wcid, now + i, true), 0);
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now + 5600, true), 0);
+
+	/* no time saved up: a second later, one frame and the same wait */
+	now += 1000000;
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now, true), 0);
+	mt76_wcid_pace_charge(wcid, now, 1400);
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now, true), 5600);
+
+	/* a frame taken while it owes (voice: not held) adds to it */
+	mt76_wcid_pace_charge(wcid, now + 2800, 1400);
+	KUNIT_EXPECT_EQ(test, wcid->pace_tokens, -2100);
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now + 2800, true), 8400);
+
+	/* the air free again: what it owed is dropped, and a clean start */
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now + 2800, false), 0);
+	KUNIT_EXPECT_FALSE(test, wcid->pace_on);
+	KUNIT_EXPECT_EQ(test, wcid->pace_tokens, 0);
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now + 2900, true), 0);
+
+	/* never more owed than the longest wait pays off */
+	mt76_wcid_pace_charge(wcid, now + 2900, 260000);
+	KUNIT_EXPECT_EQ(test, wcid->pace_tokens, -25000);
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now + 2900, true),
+			MT76_PACE_MAX_US);
+
+	/* a share above the whole is the whole */
+	wcid->tx_pace = 5000;
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now + 2900, true), 25000);
+
+	/* switched off while it owes */
+	wcid->tx_pace = 0;
+	KUNIT_EXPECT_EQ(test, mt76_wcid_pace_wait(wcid, now + 2900, true), 0);
+	KUNIT_EXPECT_EQ(test, wcid->pace_tokens, 0);
+	KUNIT_EXPECT_FALSE(test, wcid->pace_on);
+}
