+/*
+ * Pacing a station whose link is poor.
+ *
+ * The firmware takes turns between the stations it has frames for, a
+ * transmission each, whatever their rates: one at a low rate then holds the
+ * air most of the time, and one at a high rate beside it carries a fraction
+ * of what it could. A lower airtime weight doesn't change that (mac80211
+ * only orders stations that are ready at the same moment), and a lower AQL
+ * limit only as far as one frame a turn.
+ *
+ * So the frames are held here, by time. A station with a share
+ * (wcid->tx_pace, in 1/1000; user space that judges links sets it) may be
+ * sent to for that part of the time, counted by mac80211's estimate of each
+ * frame's airtime as the frame is taken from its queue: after a frame, the
+ * next one waits until estimate / share has passed. Only its best effort and
+ * background queues wait (voice and video go at once, and count), and only
+ * while a station that isn't paced waits for the air: frames left in its
+ * queue after its turn, or a turn that adds to MT76_PACE_WANT_US or more of
+ * its airtime still in the hardware (a TCP sender on the router itself keeps
+ * its queue that short, so nothing is ever left in it). Alone, or beside
+ * light traffic, a paced station is sent to as before.
+ *
+ * A queue that waits isn't returned to mac80211's list (at its head it would
+ * end every round before the others' turn): the timer puts it back.
+ */
+#define MT76_PACE_BUSY_US	50000	/* others count as waiting this long */
+#define MT76_PACE_WANT_US	500	/* airtime in the hardware that is a wait */
+#define MT76_PACE_MAX_US	100000	/* the longest wait, whatever is owed */
+/* A turn ends once this much airtime is owed: one frame at a low rate,
+ * several short ones for a single transmission (and fewer timer runs).
+ */
+#define MT76_PACE_BURST_US	1000
+
+#if IS_ENABLED(CONFIG_MT76_KUNIT_TEST)
+static u64 mt76_tx_pace_test_now;	/* the tests' clock, when set */
+#endif
+
+static u64 mt76_tx_pace_now(void)
+{
+#if IS_ENABLED(CONFIG_MT76_KUNIT_TEST)
+	if (mt76_tx_pace_test_now)
+		return mt76_tx_pace_test_now;
+#endif
+	return div_u64(ktime_get_ns(), NSEC_PER_USEC);
+}
+
+static bool mt76_tx_pace_qid(enum mt76_txq_id qid)
+{
+	return qid == MT_TXQ_BE || qid == MT_TXQ_BK;
+}
+
+/* the airtime @wcid owes at @now (<= 0): what it owed, less the time since */
+static s64 mt76_wcid_pace_tokens(struct mt76_wcid *wcid, u64 now, u32 share)
+{
+	s64 tokens = wcid->pace_tokens;
+
+	if (now > wcid->pace_stamp)
+		tokens += div_u64((now - wcid->pace_stamp) * share, 1000);
+
+	return min_t(s64, tokens, 0);
+}
+
+/* How long (us) @wcid's next frame waits at @now; 0: it may go. @busy: a
+ * station that isn't paced has frames waiting. Nothing is owed for what went
+ * out while none had, and no time is saved up for later.
+ */
+static u32 mt76_wcid_pace_wait(struct mt76_wcid *wcid, u64 now, bool busy)
+{
+	u32 share = min_t(u32, READ_ONCE(wcid->tx_pace), 1000);
+	s64 tokens;
+
+	if (!share || !busy || !wcid->pace_on) {
+		wcid->pace_on = share && busy;
+		wcid->pace_tokens = 0;
+		wcid->pace_stamp = now;
+		return 0;
+	}
+
+	tokens = mt76_wcid_pace_tokens(wcid, now, share);
+	if (tokens >= 0)
+		return 0;
+
+	return min_t(u64, div_u64(-tokens * 1000 + share - 1, share),
+		     MT76_PACE_MAX_US);
+}
+
+/* a frame of @us of airtime was taken from @wcid's queue at @now */
+static void mt76_wcid_pace_charge(struct mt76_wcid *wcid, u64 now, u32 us)
+{
+	u32 share = min_t(u32, READ_ONCE(wcid->tx_pace), 1000);
+	s64 tokens;
+
+	if (!share || !wcid->pace_on)
+		return;
+
+	/* never more owed than the longest wait pays off */
+	tokens = mt76_wcid_pace_tokens(wcid, now, share) - us;
+	wcid->pace_tokens = max_t(s64, tokens,
+				  -(s64)MT76_PACE_MAX_US * share / 1000);
+	wcid->pace_stamp = now;
+}
+
+static void mt76_tx_pace_charge_skb(struct mt76_wcid *wcid, u64 now,
+				    struct sk_buff *skb)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+
+	mt76_wcid_pace_charge(wcid, now, ieee80211_info_get_tx_time_est(info));
+}
+
+/* @wcid's frames on @qid wait: its queues come back when the timer runs */
+static void mt76_tx_pace_arm(struct mt76_dev *dev, struct mt76_wcid *wcid,
+			     u32 wait)
+{
+	ktime_t t = ns_to_ktime((u64)wait * NSEC_PER_USEC);
+
+	set_bit(wcid->idx, dev->pace_wait);
+	if (!dev->pace_timer_set)
+		return;
+
+	/* queued for sooner: it returns this station's queues as well, and a
+	 * station returned early is held again. (Not hrtimer_active(): a
+	 * timer whose function runs may already be past this station.)
+	 */
+	if (hrtimer_is_queued(&dev->pace_timer) &&
+	    ktime_compare(hrtimer_get_remaining(&dev->pace_timer), t) <= 0)
+		return;
+
+	hrtimer_start(&dev->pace_timer, t, HRTIMER_MODE_REL_SOFT);
+}
+
+/* Whether @wcid's frames on @qid have to wait now. */
+static bool mt76_tx_pace_hold(struct mt76_phy *phy, struct mt76_wcid *wcid,
+			      enum mt76_txq_id qid)
+{
+	u64 now = mt76_tx_pace_now();
+	u32 wait;
+
+	WRITE_ONCE(phy->pace_seen, jiffies | 1);
+	wait = mt76_wcid_pace_wait(wcid, now, now < READ_ONCE(phy->pace_busy));
+	if (!mt76_tx_pace_qid(qid))
+		return false;
+
+	if (!wait) {
+		if (wcid->pace_since) {
+			wcid->pace_held += now - wcid->pace_since;
+			wcid->pace_since = 0;
+		}
+		return false;
+	}
+
+	if (!wcid->pace_since) {
+		wcid->pace_since = now;
+		wcid->pace_holds++;
+	}
+	mt76_tx_pace_arm(phy->dev, wcid, wait);
+
+	return true;
+}
+
+/* Whether @txq's turn is one to learn from: a station's that isn't paced,
+ * while pacing is in use (a paced station was looked at in the last second).
+ */
+static bool mt76_tx_pace_asks(struct mt76_phy *phy, struct mt76_wcid *wcid,
+			      struct ieee80211_txq *txq)
+{
+	unsigned long seen = READ_ONCE(phy->pace_seen);
+
+	return seen && !time_after(jiffies, seen + HZ) && txq->sta &&
+	       !READ_ONCE(wcid->tx_pace);
+}
+
+/* The turn of a station that isn't paced is over: @n_frames went to the
+ * hardware, which still had @pending us of its airtime from before. If that
+ * was a wait already, or frames are left in the queue, the station wants more
+ * of the air than it gets.
+ */
+static void mt76_tx_pace_mark(struct mt76_phy *phy, struct ieee80211_txq *txq,
+			      u32 pending, int n_frames)
+{
+	unsigned long frames = 0;
+
+	if (pending < MT76_PACE_WANT_US || n_frames <= 0) {
+		ieee80211_txq_get_depth(txq, &frames, NULL);
+		if (!frames)
+			return;
+	}
+
+	WRITE_ONCE(phy->pace_busy, mt76_tx_pace_now() + MT76_PACE_BUSY_US);
+}
+
+/* The queues of the stations that waited, back on mac80211's list. One
+ * whose time hasn't come is held again (mt76_tx_pace_hold()).
+ */
+static enum hrtimer_restart mt76_tx_pace_timer(struct hrtimer *timer)
+{
+	struct mt76_dev *dev = container_of(timer, struct mt76_dev, pace_timer);
+	unsigned int idx;
+	int i;
+
+	rcu_read_lock();
+	for_each_set_bit(idx, dev->pace_wait, MT76_N_WCIDS) {
+		struct ieee80211_sta *sta;
+		struct mt76_wcid *wcid;
+		struct ieee80211_hw *hw;
+
+		clear_bit(idx, dev->pace_wait);
+		wcid = __mt76_wcid_ptr(dev, idx);
+		sta = wcid ? wcid_to_sta(wcid) : NULL;
+		if (!sta)
+			continue;
+
+		hw = mt76_phy_hw(dev, wcid->phy_idx);
+		for (i = 0; i < ARRAY_SIZE(sta->txq); i++)
+			if (sta->txq[i] &&
+			    mt76_tx_pace_qid(mt76_txq_get_qid(sta->txq[i])))
+				ieee80211_schedule_txq(hw, sta->txq[i]);
+	}
+	rcu_read_unlock();
+
+	mt76_worker_schedule(&dev->tx_worker);
+
+	return HRTIMER_NORESTART;
+}
+
+void mt76_tx_pace_init(struct mt76_dev *dev)
+{
+	hrtimer_setup(&dev->pace_timer, mt76_tx_pace_timer, CLOCK_MONOTONIC,
+		      HRTIMER_MODE_REL_SOFT);
+	dev->pace_timer_set = true;
+}
+
+void mt76_tx_pace_stop(struct mt76_dev *dev)
+{
+	if (dev->pace_timer_set)
+		hrtimer_cancel(&dev->pace_timer);
+}
