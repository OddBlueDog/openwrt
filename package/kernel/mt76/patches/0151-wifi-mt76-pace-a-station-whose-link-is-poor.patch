+/* Holding a paced station: only its best effort and background queues, only
+ * while others wait; the wait bit and the timer, the counters, and the timer
+ * giving the queues back (a station that left among them).
+ */
+static void mt76_tx_test_pace_hold(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_phy *phy = &dev->phy;
+	struct mt76_wcid *wcid = mt76_tx_test_wcid(t, 5, 0, true, true);
+	u64 now = 5000000;
+
+	mt76_tx_pace_test_now = now;
+	wcid->tx_pace = 200;
+
+	/* nobody else waits */
+	KUNIT_EXPECT_FALSE(test, mt76_tx_pace_hold(phy, wcid, MT_TXQ_BE));
+	KUNIT_EXPECT_NE(test, phy->pace_seen, 0);
+	KUNIT_EXPECT_TRUE(test, bitmap_empty(dev->pace_wait, MT76_N_WCIDS));
+
+	/* others wait: the first look passes, and after a frame it is held
+	 * (20 ms of airtime at a fifth: the longest wait, 100 ms)
+	 */
+	phy->pace_busy = now + 10 * MT76_PACE_MAX_US;
+	KUNIT_EXPECT_FALSE(test, mt76_tx_pace_hold(phy, wcid, MT_TXQ_BE));
+	mt76_wcid_pace_charge(wcid, now, 20000);
+	KUNIT_EXPECT_TRUE(test, mt76_tx_pace_hold(phy, wcid, MT_TXQ_BE));
+	KUNIT_EXPECT_TRUE(test, test_bit(5, dev->pace_wait));
+	KUNIT_EXPECT_TRUE(test, hrtimer_is_queued(&dev->pace_timer));
+	KUNIT_EXPECT_EQ(test, wcid->pace_holds, 1);
+	KUNIT_EXPECT_EQ(test, wcid->pace_since, now);
+
+	/* voice and video go; background waits like best effort */
+	KUNIT_EXPECT_FALSE(test, mt76_tx_pace_hold(phy, wcid, MT_TXQ_VO));
+	KUNIT_EXPECT_FALSE(test, mt76_tx_pace_hold(phy, wcid, MT_TXQ_VI));
+	KUNIT_EXPECT_TRUE(test, mt76_tx_pace_hold(phy, wcid, MT_TXQ_BK));
+
+	/* later, still held: counted once */
+	mt76_tx_pace_test_now = now + 60000;
+	KUNIT_EXPECT_TRUE(test, mt76_tx_pace_hold(phy, wcid, MT_TXQ_BE));
+	KUNIT_EXPECT_EQ(test, wcid->pace_holds, 1);
+
+	/* its time has come */
+	mt76_tx_pace_test_now = now + 100000;
+	KUNIT_EXPECT_FALSE(test, mt76_tx_pace_hold(phy, wcid, MT_TXQ_BE));
+	KUNIT_EXPECT_EQ(test, wcid->pace_since, 0);
+	KUNIT_EXPECT_EQ(test, wcid->pace_held, 100000);
+
+	/* it owes again, and the others stop waiting: not held */
+	mt76_wcid_pace_charge(wcid, mt76_tx_pace_test_now, 20000);
+	KUNIT_EXPECT_TRUE(test, mt76_tx_pace_hold(phy, wcid, MT_TXQ_BE));
+	KUNIT_EXPECT_EQ(test, wcid->pace_holds, 2);
+	mt76_tx_pace_test_now = phy->pace_busy;
+	KUNIT_EXPECT_FALSE(test, mt76_tx_pace_hold(phy, wcid, MT_TXQ_BE));
+	KUNIT_EXPECT_FALSE(test, wcid->pace_on);
+	KUNIT_EXPECT_EQ(test, wcid->pace_tokens, 0);
+
+	/* the timer: every waiting station's turn again, one that left too */
+	hrtimer_cancel(&dev->pace_timer);
+	set_bit(5, dev->pace_wait);
+	set_bit(6, dev->pace_wait);
+	mt76_tx_test_worker_scheduled(dev);
+	KUNIT_EXPECT_EQ(test, mt76_tx_pace_timer(&dev->pace_timer),
+			HRTIMER_NORESTART);
+	KUNIT_EXPECT_TRUE(test, bitmap_empty(dev->pace_wait, MT76_N_WCIDS));
+	KUNIT_EXPECT_TRUE(test, mt76_tx_test_worker_scheduled(dev));
+
+	mt76_tx_pace_test_now = 0;
+}
