From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Fri, 20 Nov 2026 15:38:34 +0000
Subject: [PATCH] wifi: mt76: tests: BA and key updates a WED's WO refuses

With a WED, mt76_connac_mcu_sta_ba() and mt76_connac_mcu_add_key()
mirror each update to its WO first; one it refuses must not reach the
firmware. mt76_connac_mcu_test_wed_refused: the BA session's WTBL
update, its station update once the WTBL one went, and a key. The fake
WED can fail only the n-th WO message now (msg_fail_at).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/connac-mcu-test.c | 49 +++++++++++++++++++++++++++++++++++++++++
 tests/wed-fake.h        |  5 +++++
 2 files changed, 54 insertions(+)

diff --git a/tests/connac-mcu-test.c b/tests/connac-mcu-test.c
index 8c222715..b68d68c4 100644
--- a/tests/connac-mcu-test.c
+++ b/tests/connac-mcu-test.c
@@ -14,6 +14,7 @@
 #include <kunit/test.h>
 #include <linux/fs.h>
 #include "fake.h"
+#include "wed-fake.h"
 
 #define MT76_CONNAC_MCU_TEST_REV	0x79860000	/* MT7986 */
 #define MT76_CONNAC_MCU_TEST_V1_REV	0x76150000	/* MT7615: connac v1 */
@@ -1746,6 +1747,51 @@ static void mt76_connac_mcu_test_sta_ba_error(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_test_fw.n_fail_cmd, 2);
 }
 
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+static struct ieee80211_key_conf *
+mt76_connac_mcu_test_key(struct kunit *test, u32 cipher, u8 idx, u8 len);
+
+/* With a WED, BA and key updates are mirrored to its WO first; one it
+ * refuses is not sent to the firmware: the BA session's WTBL update, or
+ * (once that went) its station update; a key.
+ */
+static void mt76_connac_mcu_test_wed_refused(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_mcu_test_dev(test);
+	struct ieee80211_sta *sta = mt76_connac_mcu_test_sta(test, 3);
+	struct ieee80211_ampdu_params params = { .sta = sta, .tid = 1 };
+	struct mt76_connac_sta_key_conf conf = {};
+	int cmd = MCU_EXT_CMD(STA_REC_UPDATE);
+	struct ieee80211_key_conf *key;
+	struct ieee80211_vif *vif;
+	struct mt76_test_wed *w;
+
+	vif = mt76_connac_mcu_test_vif(test, NL80211_IFTYPE_AP, 1);
+	w = mt76_test_wed_init(test, &dev->mmio.wed);
+	w->msg_ret = -EIO;
+
+	w->msg_fail_at = 1;
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_sta_ba(dev,
+			mt76_connac_mcu_test_mvif(vif), &params, cmd, true,
+			true), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 0);
+
+	w->n_msg = 0;
+	w->msg_fail_at = 2;
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_sta_ba(dev,
+			mt76_connac_mcu_test_mvif(vif), &params, cmd, true,
+			true), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 1);
+	KUNIT_EXPECT_EQ(test, w->n_msg, 2);
+
+	w->msg_fail_at = 0;
+	key = mt76_connac_mcu_test_key(test, WLAN_CIPHER_SUITE_CCMP, 1, 16);
+	KUNIT_EXPECT_EQ(test, mt76_connac_mcu_add_key(dev, vif, &conf, key,
+			cmd, mt76_connac_mcu_test_wcid(sta), SET_KEY), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 1);
+}
+#endif
+
 /* Without a WED (the MT7986 here) station records aren't mirrored to it.
  * Called through a pointer, as mt7915 does: in this file the compiler
  * folds the inlined copies away.
@@ -2753,6 +2799,9 @@ static struct kunit_case mt76_connac_mcu_test_cases[] = {
 	KUNIT_CASE(mt76_connac_mcu_test_sta_ba),
 	KUNIT_CASE(mt76_connac_mcu_test_sta_ba_error),
 	KUNIT_CASE(mt76_connac_mcu_test_sta_wed_update),
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+	KUNIT_CASE(mt76_connac_mcu_test_wed_refused),
+#endif
 	KUNIT_CASE(mt76_connac_mcu_test_add_key_ccmp),
 	KUNIT_CASE(mt76_connac_mcu_test_add_key_tkip),
 	KUNIT_CASE(mt76_connac_mcu_test_add_key_bip),
diff --git a/tests/wed-fake.h b/tests/wed-fake.h
index bb2d0cae..919b6f8b 100644
--- a/tests/wed-fake.h
+++ b/tests/wed-fake.h
@@ -48,6 +48,9 @@ struct mt76_test_wed {
 	int attach_ret;
 	int tx_ring_ret, rx_ring_ret, txfree_ret;
 	int msg_ret, setup_tc_ret;
+	int msg_fail_at;		/* only this msg_update (1: the first)
+					 * returns msg_ret; 0: every one
+					 */
 	u32 irq_pending;		/* what irq_get reports, then clears */
 
 	/* what attach hands the WLAN driver */
@@ -138,6 +141,8 @@ static inline int mt76_test_wed_msg(struct mtk_wed_device *wed, int cmd_id,
 
 	w->n_msg++;
 	w->last_msg = cmd_id;
+	if (w->msg_fail_at && w->n_msg != w->msg_fail_at)
+		return 0;
 	return w->msg_ret;
 }
 
