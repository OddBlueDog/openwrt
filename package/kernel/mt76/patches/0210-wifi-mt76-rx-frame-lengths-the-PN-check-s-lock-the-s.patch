+/* mt76_tx_silent_unlisted() stand-in: the station's frames fail again, as
+ * many as start a hold, just as the poll found it released
+ */
+static void psim_silent_rehold(struct mt76_dev *dev, struct mt76_wcid *wcid)
+{
+	int i;
+
+	for (i = 0; wcid && i < MT76_SILENT_FAILS &&
+		    !test_bit(MT_WCID_FLAG_SILENT, &wcid->flags); i++)
+		mt76_tx_result(dev, wcid, false);
+}
+
+/* A station heard again leaves its bit in silent_wait for the poll to clear.
+ * Held again just as the poll finds it released, it stays listed: with its
+ * bit cleared nothing would probe it, and it stayed held until it sent
+ * something of its own.
+ */
+static void mt76_psim_test_silent_rehold(struct kunit *test)
+{
+	static const struct psim_cfg cfg = {
+		.seed = 23, .ps_sync = true, .silent = true,
+		.kinds = { PSIM_PHONE }, .n_sta = 1,
+	};
+	struct psim_sta *phone;
+	struct mt76_wcid *wcid;
+	struct mt76_dev *dev;
+	struct psim *s;
+
+	skb_queue_head_init(&psim_skbs);
+	s = psim_init(test, &cfg);
+	dev = s->dev;
+	phone = &s->sta[0];
+	wcid = psim_wcid(phone);
+
+	psim_mute(s, phone);
+	psim_silent_ticks(s, 40);
+	psim_silent_send(s, phone, 1);
+	psim_silent_tick(s);
+	KUNIT_ASSERT_TRUE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	psim_unmute(s, phone);
+	KUNIT_ASSERT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	KUNIT_ASSERT_TRUE(test, test_bit(wcid->idx, dev->silent_wait));
+
+	kunit_activate_static_stub(test, mt76_tx_silent_unlisted,
+				   psim_silent_rehold);
+	mt76_tx_silent_poll(dev);
+	kunit_deactivate_static_stub(test, mt76_tx_silent_unlisted);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	KUNIT_EXPECT_TRUE(test, test_bit(wcid->idx, dev->silent_wait));
+	KUNIT_EXPECT_EQ(test, wcid->silent_holds, 2);
+
+	/* and probed when its time comes */
+	psim_silent_ticks(s, 10);
+	KUNIT_EXPECT_GE(test, wcid->silent_probes, 1);
+
+	psim_heard(s, phone);
+	psim_silent_ticks(s, 4);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	KUNIT_EXPECT_TRUE(test, bitmap_empty(dev->silent_wait, MT76_N_WCIDS));
+	skb_queue_purge(&psim_skbs);
+}
+
+static struct mt76_wcid *psim_silent_new_wcid;
+
+/* mt76_tx_silent_unlisted() stand-in: a new station is added at the slot
+ * the poll found empty, and held at once
+ */
+static void psim_silent_reuse(struct mt76_dev *dev, struct mt76_wcid *wcid)
+{
+	struct mt76_wcid *w = psim_silent_new_wcid;
+
+	rcu_assign_pointer(dev->wcid[w->idx], w);
+	psim_silent_rehold(dev, w);
+}
+
+/* A slot whose station went keeps its bit in silent_wait for the poll to
+ * clear. A new station added there and held just as the poll finds the slot
+ * empty stays listed: the poll looks at the slot's station again, not the
+ * one it read before.
+ */
+static void mt76_psim_test_silent_rehold_reuse(struct kunit *test)
+{
+	static const struct psim_cfg cfg = {
+		.seed = 29, .ps_sync = true, .silent = true,
+		.kinds = { PSIM_PHONE }, .n_sta = 1,
+	};
+	struct psim_sta *phone;
+	struct mt76_wcid *wcid;
+	struct mt76_dev *dev;
+	struct psim *s;
+
+	skb_queue_head_init(&psim_skbs);
+	s = psim_init(test, &cfg);
+	dev = s->dev;
+	phone = &s->sta[0];
+	wcid = psim_wcid(phone);
+	psim_silent_ticks(s, 40);
+
+	/* gone, its bit left over (a hold it had) */
+	set_bit(wcid->idx, dev->silent_wait);
+	rcu_assign_pointer(dev->wcid[wcid->idx], NULL);
+	synchronize_rcu();
+
+	psim_silent_new_wcid = wcid;
+	kunit_activate_static_stub(test, mt76_tx_silent_unlisted,
+				   psim_silent_reuse);
+	mt76_tx_silent_poll(dev);
+	kunit_deactivate_static_stub(test, mt76_tx_silent_unlisted);
+	KUNIT_EXPECT_PTR_EQ(test, rcu_access_pointer(dev->wcid[wcid->idx]),
+			    wcid);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_SILENT, &wcid->flags));
+	KUNIT_EXPECT_TRUE(test, test_bit(wcid->idx, dev->silent_wait));
+
+	psim_heard(s, phone);
+	psim_silent_ticks(s, 4);
+	KUNIT_EXPECT_TRUE(test, bitmap_empty(dev->silent_wait, MT76_N_WCIDS));
+	skb_queue_purge(&psim_skbs);
+}
