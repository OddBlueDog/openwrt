 	KUNIT_CASE(mt76_connac_test_rx_rate_stbc_flags),
 	KUNIT_CASE(mt76_connac_test_he_radiotap_common),
diff --git a/tests/core-test.c b/tests/core-test.c
index 79b28379..2e76a466 100644
--- a/tests/core-test.c
+++ b/tests/core-test.c
@@ -2250,6 +2250,48 @@ static void mt76_test_rx_amsdu_bad_first_subframe(struct kunit *test)
 	skb_queue_purge(&dev->rx_skb[MT_RXQ_MAIN]);
