+ * can't show the source fix under KASAN: it pins the P-RXV-only decode.)
+ */
+static void mt76_connac_test_rx_rate_prxv_only(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_connac_test_dev(test);
+	struct mt76_rx_status status = {};
