@@ -2799,6 +2825,7 @@ static struct kunit_case mt76_connac_mac_test_cases[] = {
 	KUNIT_CASE(mt76_connac_test_rx_rate_he),
 	KUNIT_CASE(mt76_connac_test_rx_rate_invalid),
