+/* What fills the buffer can be a new device's first record (its name),
+ * which goes before the record asked for: that one isn't added after the
+ * stop note either (a mark would fit in the room the note left), and both
+ * are counted as dropped.
+ */
+static void mt76_record_test_full_new_dev(struct kunit *test)
+{
+	struct mt76_record_test_hw hw = {};
+	const struct mt76_rec_hdr *h, *last = NULL;
+	struct mt76_dev *dev, *other;
+	struct mt76_record *rec;
+	size_t off = 0, len;
+	const void *body;
+	u32 blen;
+	void *data;
+
+	dev = mt76_record_test_dev(test, &hw);
+	other = kunit_kzalloc(test, sizeof(*other), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, other);
+	rec = mt76_record_test_start(test, 512, 0);
+
+	/* to less than the stop note's room and a nameless device record */
+	while (rec->len + 16 + 64 <= rec->size)
+		__mt76_wr(dev, 0x10, 0);
+	if (rec->size - rec->len >= 64 + 8)
+		__mt76_record_mark(dev, "%s", "");
+	KUNIT_ASSERT_NE(test, rec->state, MT76_REC_STOPPED);
+	KUNIT_ASSERT_LT(test, rec->size - rec->len, 64 + 8);
+	KUNIT_ASSERT_EQ(test, rec->dropped, 0);
+
+	__mt76_record_mark(other, "x");
+	KUNIT_EXPECT_EQ(test, rec->state, MT76_REC_STOPPED);
+	KUNIT_EXPECT_EQ(test, rec->dropped, 2);
+
+	data = mt76_record_test_take(test, rec, &len);
+	while ((h = mt76_replay_next(data, &off, &body, &blen)))
+		last = h;
+	KUNIT_ASSERT_NOT_NULL(test, last);
+	KUNIT_EXPECT_EQ(test, last->type, MT76_REC_MARK);
+	KUNIT_EXPECT_MEMEQ(test, last + 1, "stopped: buffer full",
+			   le16_to_cpu(last->len));
+}
