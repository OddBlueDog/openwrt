+	rxv[0] = mt76_connac_test_prxv(MT_PHY_TYPE_HE_SU, 5, 2,
+				       IEEE80211_STA_RX_BW_80, 0, 0, false);
+	rxv[1] = 0;
+	KUNIT_ASSERT_EQ(test, mt76_connac2_mac_fill_rx_rate(dev, &status,
+			&dev->phy.sband_5g.sband, rxv, &mode), 0);
+	KUNIT_EXPECT_EQ(test, mode, MT_PHY_TYPE_HE_SU);
+	KUNIT_EXPECT_EQ(test, status.rate_idx, 5);
