+/* the TID's last PN moves on to the frame's */
+static void mt76_rx_pn_update(u8 *rx_pn, const u8 *pn)
+{
+	KUNIT_STATIC_STUB_REDIRECT(mt76_rx_pn_update, rx_pn, pn);
+	memcpy(rx_pn, pn, IEEE80211_CCMP_PN_LEN);
+}
+
 void mt76_check_ccmp_pn(struct sk_buff *skb)
 {
 	struct mt76_rx_status *status = (struct mt76_rx_status *)skb->cb;
@@ -1507,12 +1525,43 @@ skip_hdr_check:
 		return;
 	}
 
-	memcpy(wcid->rx_key_pn[security_idx], status->iv, sizeof(status->iv));
+	mt76_rx_pn_update(wcid->rx_key_pn[security_idx], status->iv);
 
 	if (status->flag & RX_FLAG_IV_STRIPPED)
 		status->flag |= RX_FLAG_PN_VALIDATED;
 }
 
+/*
+ * mt76_rx_complete()'s PN check, under rx_lock. A BA session checks the
+ * frames it releases under its own lock (mt76_rx_aggr_pn_check(), from the
+ * rx path or its reorder timeout work) against the same per-TID counter as
+ * the frames of that TID it doesn't take (no-ack policy, sent before the
+ * session started, while it stops), which come here: take its lock for them.
+ */
+static void mt76_rx_check_pn(struct sk_buff *skb)
+{
+	struct mt76_rx_status *status = (struct mt76_rx_status *)skb->cb;
+	struct mt76_wcid *wcid = status->wcid;
+	struct mt76_rx_tid *tid = NULL;
+
+	if (wcid && wcid->rx_check_pn && !status->skip_pn_check &&
+	    (status->flag & RX_FLAG_DECRYPTED)) {
+		u8 tidno = status->qos_ctl & IEEE80211_QOS_CTL_TID_MASK;
+
+		/* the session mt76_rx_aggr_reorder() looks up */
+		if (wcid->def_wcid)
+			tid = rcu_dereference(wcid->def_wcid->aggr[tidno]);
+		else
+			tid = rcu_dereference(wcid->aggr[tidno]);
+	}
+
+	if (tid)
+		spin_lock_bh(&tid->lock);
+	mt76_check_ccmp_pn(skb);
+	if (tid)
+		spin_unlock_bh(&tid->lock);
+}
+
 static void
 mt76_airtime_report(struct mt76_dev *dev, struct mt76_rx_status *status,
 		    int len)
@@ -1742,7 +1791,7 @@ void mt76_rx_complete(struct mt76_dev *dev, struct sk_buff_head *frames,
 		struct sk_buff *nskb = skb_shinfo(skb)->frag_list;
 		bool only_monitor;
 
-		mt76_check_ccmp_pn(skb);
+		mt76_rx_check_pn(skb);
 		only_monitor = status->flag & RX_FLAG_ONLY_MONITOR;
 		if (only_monitor)
 			mt76_rx_count_drop(dev, status);
