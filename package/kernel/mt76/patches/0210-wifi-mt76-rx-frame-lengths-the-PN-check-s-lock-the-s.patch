+/* A request cut after its 16-byte header has no BAR control or starting
+ * sequence to act on: it moves nothing.
+ */
+static void mt76_test_aggr_bar_short(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, true, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+	struct sk_buff *skb;
+
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 102));
+	mt76_test_aggr_rx(a, mt76_test_aggr_skb(test, a->wcid, 103));
+
+	skb = mt76_test_aggr_bar(test, a->wcid, 0, 104);
+	skb_trim(skb, 16);
+	mt76_test_aggr_status(skb)->qos_ctl = 7;
+	mt76_test_aggr_rx(a, skb);
+	KUNIT_EXPECT_EQ(test, mt76_test_aggr_status(skb)->qos_ctl, 7);
+	MT76_TEST_AGGR_EXPECT(test, a, 0xfff);
+	KUNIT_EXPECT_EQ(test, tid->head, 100);
+	KUNIT_EXPECT_EQ(test, tid->nframes, 2);
+}
+
+struct mt76_test_aggr_stop_work {
+	struct work_struct work;
+	struct completion done;
+	struct mt76_test_aggr *a;
+};
+
+static void mt76_test_aggr_stop_fn(struct work_struct *work)
+{
+	struct mt76_test_aggr_stop_work *w =
+		container_of(work, struct mt76_test_aggr_stop_work, work);
+
+	mutex_lock(&w->a->dev->mutex);
+	mt76_rx_aggr_stop(w->a->dev, w->a->wcid, 0);
+	mutex_unlock(&w->a->dev->mutex);
+	complete(&w->done);
+}
+
+/* A session stopping while its lock is held (its reorder work releasing
+ * frames, their PN checked under it) stays listed until it is drained: a
+ * frame of the TID the session doesn't take still finds the lock for its
+ * own PN check meanwhile (mt76_rx_check_pn()).
+ */
+static void mt76_test_aggr_stop_listed(struct kunit *test)
+{
+	struct mt76_test_aggr *a = mt76_test_aggr(test, false, 100, 8);
+	struct mt76_rx_tid *tid = mt76_test_aggr_tid(a, 0);
+	struct mt76_test_aggr_stop_work *w;
+	bool listed, waited;
+	int cpu;
+
+	w = kunit_kzalloc(test, sizeof(*w), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, w);
+	w->a = a;
+	init_completion(&w->done);
+	INIT_WORK(&w->work, mt76_test_aggr_stop_fn);
+
+	spin_lock_bh(&tid->lock);
+	cpu = cpumask_any_but(cpu_online_mask, smp_processor_id());
+	if (cpu >= nr_cpu_ids) {
+		spin_unlock_bh(&tid->lock);
+		kunit_skip(test, "needs a second CPU");
+	}
+	queue_work_on(cpu, system_wq, &w->work);
+	mdelay(100);
+	listed = rcu_access_pointer(a->wcid->aggr[0]) == tid;
+	waited = !completion_done(&w->done);
+	spin_unlock_bh(&tid->lock);
+	flush_work(&w->work);
+
+	KUNIT_EXPECT_TRUE(test, waited);
+	KUNIT_EXPECT_TRUE(test, listed);
+	KUNIT_EXPECT_NULL(test, rcu_access_pointer(a->wcid->aggr[0]));
+}
+
 /* A block ack request moves the window to its start: frames before it
  * are given up on, the waiting ones after it are released.
  */
@@ -855,6 +933,8 @@ static struct kunit_case mt76_agg_rx_test_cases[] = {
