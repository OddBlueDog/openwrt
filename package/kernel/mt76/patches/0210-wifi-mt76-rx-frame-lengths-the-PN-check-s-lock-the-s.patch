+/* A first subframe (of an A-MSDU of more than one frame) too short for the
+ * subframe header it has to start with: dropped, rather than its start
+ * compared with an LLC/SNAP header past the end of the frame.
+ */
+static void mt76_test_rx_amsdu_short_first_subframe(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_hwt_dev(test, &mt76_test_drv_ops);
+	struct sk_buff_head *rxq = &dev->rx_skb[MT_RXQ_MAIN];
+	static const u32 flags[] = { 0, RX_FLAG_8023 };
+	struct sk_buff *a, *b;
+	int i;
+
+	set_bit(MT76_STATE_RUNNING, &dev->phy.state);
+	for (i = 0; i < ARRAY_SIZE(flags); i++) {
+		a = mt76_test_amsdu(test, 1, 5, true, false, mt76_hwt_addr);
+		b = mt76_test_amsdu(test, 2, 5, false, true, mt76_hwt_addr);
+		/* 5 bytes of the subframe header: after the QoS data
+		 * header, or translated to 802.3 at the start
+		 */
+		skb_trim(a, (flags[i] ? 0 : 26) + ETH_ALEN - 1);
+		mt76_test_status(a)->flag = flags[i];
+		mt76_test_status(b)->flag = flags[i];
+		mt76_rx(dev, MT_RXQ_MAIN, a);
+		mt76_rx(dev, MT_RXQ_MAIN, b);
+		KUNIT_EXPECT_TRUE(test, skb_queue_empty(rxq));
+		skb_queue_purge(rxq);
+	}
+
+	/* 802.11 cut inside its header */
+	a = mt76_test_amsdu(test, 1, 5, true, false, mt76_hwt_addr);
+	b = mt76_test_amsdu(test, 2, 5, false, true, mt76_hwt_addr);
+	skb_trim(a, 1);
+	mt76_rx(dev, MT_RXQ_MAIN, a);
+	mt76_rx(dev, MT_RXQ_MAIN, b);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(rxq));
+	skb_queue_purge(rxq);
+
+	/* the whole subframe header: kept */
+	KUNIT_EXPECT_TRUE(test, mt76_test_amsdu_kept(test, dev, 26,
+						     mt76_hwt_addr, 0));
+}
+
 /* With WED's RRO 3.0, frames of an RRO data queue complete in the context
  * of the indication queue, so they are queued there.
  */
@@ -2966,6 +3008,84 @@ static void mt76_test_rx_complete_one(struct mt76_dev *dev, struct sk_buff *skb)
 	local_bh_enable();
 }
 
+static spinlock_t *mt76_test_pn_tid_lock;
+static int mt76_test_pn_updates, mt76_test_pn_locked;
+
+static void mt76_test_pn_update(u8 *rx_pn, const u8 *pn)
+{
+	mt76_test_pn_updates++;
+	if (spin_is_locked(mt76_test_pn_tid_lock))
+		mt76_test_pn_locked++;
+	memcpy(rx_pn, pn, IEEE80211_CCMP_PN_LEN);
+}
+
+/* A frame of a TID with a BA session that the reorder buffer didn't take
+ * (no-ack policy here) has its PN checked in mt76_rx_complete(), under
+ * rx_lock. The session checks the frames it releases under its own lock, in
+ * the rx path or in its timeout work on another CPU, against the same
+ * counter: its lock is taken for this one too.
+ */
+static void mt76_test_rx_pn_session_lock(struct kunit *test)
+{
+	struct mt76_hwt *hwt = mt76_hwt_new(test, &mt76_test_drv_ops);
+	struct mt76_dev *dev = hwt->dev;
+	struct mt76_rx_status *status;
+	struct mt76_rx_tid *tid;
+	struct mt76_wcid *wcid;
+	struct sk_buff *skb;
+
+	/* mac80211 takes frames only while an interface is up */
+	mt76_hwt_iface(hwt, "monitor");
+	set_bit(MT76_STATE_RUNNING, &dev->phy.state);
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+	wcid->rx_check_pn = true;
+	wcid->idx = 5;
+	rcu_assign_pointer(dev->wcid[5], wcid);
+	mt76_test_set_pn(wcid->rx_key_pn[3], 6);
+	mutex_lock(&dev->mutex);
+	KUNIT_ASSERT_EQ(test, mt76_rx_aggr_start(dev, wcid, 3, 100, 8), 0);
+	mutex_unlock(&dev->mutex);
+	tid = rcu_access_pointer(wcid->aggr[3]);
+	mt76_test_pn_tid_lock = &tid->lock;
+	mt76_test_pn_updates = 0;
+	mt76_test_pn_locked = 0;
+
+	kunit_activate_static_stub(test, mt76_rx_pn_update,
+				   mt76_test_pn_update);
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 8);
+	status = mt76_test_status(skb);
+	status->wcid = wcid;
+	status->flag = MT76_TEST_DEC;
+	status->qos_ctl = 3 | IEEE80211_QOS_CTL_ACK_POLICY_NOACK;
+	mt76_test_set_pn(status->iv, 7);
+	mt76_test_rx_complete_one(dev, skb);
+
+	/* without a session on its TID, nothing to take */
+	mt76_test_pn_tid_lock = &dev->rx_lock;
+	skb = mt76_test_rx_skb(test, MT76_TEST_QOS_DATA, mt76_hwt_addr, 1, 8);
+	status = mt76_test_status(skb);
+	status->wcid = wcid;
+	status->flag = MT76_TEST_DEC;
+	status->qos_ctl = 2;
+	mt76_test_set_pn(status->iv, 1);
+	mt76_test_rx_complete_one(dev, skb);
+	kunit_deactivate_static_stub(test, mt76_rx_pn_update);
+
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_updates, 2);
+	/* the session's lock for the first, rx_lock (only) for the second */
+	KUNIT_EXPECT_EQ(test, mt76_test_pn_locked, 2);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[3]), 7);
+	KUNIT_EXPECT_EQ(test, mt76_test_get_pn(wcid->rx_key_pn[2]), 1);
+	KUNIT_EXPECT_FALSE(test, spin_is_locked(&tid->lock));
+
+	mutex_lock(&dev->mutex);
+	mt76_rx_aggr_stop(dev, wcid, 3);
+	mutex_unlock(&dev->mutex);
+	RCU_INIT_POINTER(dev->wcid[5], NULL);
+	synchronize_rcu();
+}
