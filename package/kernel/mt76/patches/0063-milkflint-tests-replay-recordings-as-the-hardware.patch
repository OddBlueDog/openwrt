diff --git a/mt7915/tests/replay-test.c b/mt7915/tests/replay-test.c
new file mode 100644
index 00000000..7eebf12c
--- /dev/null
+++ b/mt7915/tests/replay-test.c
@@ -0,0 +1,748 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests that replay a recording of an MT7986 (../../tests/replay.h)
+ * through what no fake could answer before: the firmware boot
+ * (mt7915_mcu_init_firmware()), mt7915_init_hardware() with DMA and the
+ * driver's own firmware path, and the whole of mt7915_register_device().
+ *
+ * Until there's a capture from the router, the recording is synthetic: the
+ * flow runs once on fake.h with a small model of the firmware answering
+ * (below) and the recorder attached, then a second device that has nothing
+ * but the recording replays it, and must make the same accesses, send the
+ * same commands and end up in the same state. A capture in the VM's
+ * /lib/firmware/milkflint/mt7986-capture.rec (see the README) is replayed
+ * through mt7915_register_device() by the last test, which is skipped
+ * without one.
+ *
+ * With the driver's own firmware path, commands go to the DMA rings: the
+ * device's queue ops are wrapped so that what's sent to the MCU queues
+ * goes to the fake instead, its command read back from the descriptor.
+ *
+ * Included at the end of mt7915/init.c, after tests/init-test.c, whose
+ * helpers it uses, when CONFIG_MT76_KUNIT_TEST is defined (milkflint's
+ * QEMU test build only).
+ */
+#include <linux/file.h>
+#include <linux/mount.h>
+#include <linux/namei.h>
+#include "../../tests/replay.h"
+
+#define MT7915_REPLAY_CAPTURE	"milkflint/mt7986-capture.rec"
+
+/* --- firmware files --------------------------------------------------------- */
+
+static void mt7915_replay_test_mkdir(struct kunit *test, const char *path)
+{
+	struct dentry *d;
+	struct path parent;
+	int ret;
+
+	d = kern_path_create(AT_FDCWD, path, &parent, LOOKUP_DIRECTORY);
+	if (IS_ERR(d)) {
+		if (PTR_ERR(d) != -EEXIST)
+			kunit_skip(test, "can't create %s: %ld", path,
+				   PTR_ERR(d));
+		return;
+	}
+	ret = vfs_mkdir(mnt_idmap(parent.mnt), d_inode(parent.dentry), d,
+			0755);
+	done_path_create(&parent, d);
+	if (ret && ret != -EEXIST)
+		kunit_skip(test, "can't create %s: %d", path, ret);
+}
+
+/* /lib/firmware/@name, for request_firmware() (the VM's root file system
+ * is a throwaway copy)
+ */
+static void mt7915_replay_test_write(struct kunit *test, const char *name,
+				     const void *data, size_t len)
+{
+	char path[96];
+	struct file *f;
+	loff_t pos = 0;
+	ssize_t n;
+
+	snprintf(path, sizeof(path), "/lib/firmware/%s", name);
+	f = filp_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (IS_ERR(f))
+		kunit_skip(test, "can't create %s: %ld", path, PTR_ERR(f));
+	n = kernel_write(f, data, len, &pos);
+	filp_close(f, NULL);
+	/* until the deferred fput() runs, the file is still being written
+	 * and request_firmware() won't read it
+	 */
+	flush_delayed_fput();
+	if (n != len)
+		kunit_skip(test, "can't write %s: %zd", path, n);
+}
+
+#define MT7915_REPLAY_PATCH_DATA	0x100
+#define MT7915_REPLAY_PATCH_LEN		300
+#define MT7915_REPLAY_RAM_LEN		5000	/* two chunks */
+
+/* A ROM patch and WM/WA images the MT7986 loader takes: a section or
+ * region each, of made-up data.
+ */
+static void mt7915_replay_test_firmware(struct kunit *test)
+{
+	size_t plen = MT7915_REPLAY_PATCH_DATA + MT7915_REPLAY_PATCH_LEN;
+	size_t rlen = MT7915_REPLAY_RAM_LEN +
+		      sizeof(struct mt76_connac2_fw_region) +
+		      sizeof(struct mt76_connac2_fw_trailer);
+	struct mt76_connac2_fw_trailer *tr;
+	struct mt76_connac2_fw_region *reg;
+	struct mt76_connac2_patch_hdr *hdr;
+	struct mt76_connac2_patch_sec *sec;
+	u8 *patch, *ram;
+	int i;
+
+	mt7915_replay_test_mkdir(test, "/lib/firmware/mediatek");
+
+	patch = kunit_kzalloc(test, plen, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, patch);
+	for (i = MT7915_REPLAY_PATCH_DATA; i < plen; i++)
+		patch[i] = i * 3;
+	hdr = (struct mt76_connac2_patch_hdr *)patch;
+	memcpy(hdr->build_date, "20261019000000rf", 16);
+	hdr->hw_sw_ver = cpu_to_be32(0x8a108a10);
+	hdr->desc.n_region = cpu_to_be32(1);
+	sec = (struct mt76_connac2_patch_sec *)(hdr + 1);
+	sec->type = cpu_to_be32(PATCH_SEC_TYPE_INFO);
+	sec->offs = cpu_to_be32(MT7915_REPLAY_PATCH_DATA);
+	sec->info.addr = cpu_to_be32(0x200000);	/* MCU_PATCH_ADDRESS */
+	sec->info.len = cpu_to_be32(MT7915_REPLAY_PATCH_LEN);
+	mt7915_replay_test_write(test, MT7986_ROM_PATCH, patch, plen);
+
+	ram = kunit_kzalloc(test, rlen, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ram);
+	for (i = 0; i < MT7915_REPLAY_RAM_LEN; i++)
+		ram[i] = i * 5;
+	reg = (struct mt76_connac2_fw_region *)(ram + MT7915_REPLAY_RAM_LEN);
+	reg->addr = cpu_to_le32(0x900000);
+	reg->len = cpu_to_le32(MT7915_REPLAY_RAM_LEN);
+	tr = (struct mt76_connac2_fw_trailer *)(reg + 1);
+	tr->n_region = 1;
+	memcpy(tr->fw_ver, "rf-kunit-1", 10);
+	memcpy(tr->build_date, "20261019000000r", 15);
+	mt7915_replay_test_write(test, MT7986_FIRMWARE_WM, ram, rlen);
+	memcpy(tr->fw_ver, "rf-kunit-2", 10);
+	mt7915_replay_test_write(test, MT7986_FIRMWARE_WA, ram, rlen);
+}
+
+/* --- a model of the firmware, for making the recording ----------------------- */
+
+struct mt7915_replay_model {
+	u32 top_misc;		/* where MT_TOP_MISC is on the bus */
+	const u8 *eeprom;	/* what the efuse holds */
+	int starts;		/* FW_START_REQs seen */
+};
+
+static void mt7915_replay_test_fw_state(struct mt76_test_fake *fake,
+					u32 state)
+{
+	struct mt7915_replay_model *m = fake->priv;
+
+	mt76_test_set_reg(fake, m->top_misc,
+			  FIELD_PREP(MT_TOP_MISC_FW_STATE, state));
+}
+
+/* the firmware's state follows its restarts and starts: download mode
+ * after a restart, ready once WM and WA have both been started
+ */
+static int mt7915_replay_test_model_mcu(struct mt76_test_fake *fake,
+					const struct mt76_test_msg *msg)
+{
+	struct mt7915_replay_model *m = fake->priv;
+
+	if (msg->cmd == MCU_CMD(NIC_POWER_CTRL)) {
+		m->starts = 0;
+		mt7915_replay_test_fw_state(fake, FW_STATE_FW_DOWNLOAD);
+	} else if (msg->cmd == MCU_CMD(FW_START_REQ) && ++m->starts == 2) {
+		mt7915_replay_test_fw_state(fake, FW_STATE_RDY);
+	}
+	return 0;
+}
+
+static void mt7915_replay_test_model_reply(struct mt76_test_fake *fake,
+					   const struct mt76_test_msg *msg,
+					   struct sk_buff *reply)
+{
+	struct mt7915_replay_model *m = fake->priv;
+	struct mt7915_mcu_eeprom_info *info;
+	u32 addr;
+
+	if (msg->cmd == MCU_CMD(PATCH_SEM_CONTROL)) {
+		/* the status is the header's last word */
+		reply->data[sizeof(struct mt76_connac2_mcu_rxd) - 4] =
+			get_unaligned_le32(msg->data) == PATCH_SEM_GET ?
+			PATCH_NOT_DL_SEM_SUCCESS : PATCH_REL_SEM_SUCCESS;
+	} else if (msg->cmd == MCU_EXT_QUERY(EFUSE_FREE_BLOCK)) {
+		skb_put_u8(reply, 10);
+	} else if (msg->cmd == MCU_EXT_QUERY(EFUSE_ACCESS)) {
+		addr = get_unaligned_le32(msg->data);
+		info = skb_put_zero(reply, sizeof(*info));
+		info->addr = cpu_to_le32(addr);
+		info->valid = cpu_to_le32(1);
+		if (m->eeprom && addr + 16 <= MT7916_EEPROM_SIZE)
+			memcpy(info->data, m->eeprom + addr, 16);
+	}
+}
+
+/* --- the driver's firmware path, into the fake -------------------------------- */
+
+struct mt7915_replay_qops {
+	struct mt76_queue_ops ops;
+	const struct mt76_queue_ops *orig;
+};
+
+static struct mt7915_replay_qops mt7915_replay_qops;
+
+/* the command a connac2 descriptor says (mt76_connac2_mcu_fill_message()
+ * backwards)
+ */
+static int mt7915_replay_test_cmd(const struct mt76_connac2_mcu_txd *txd)
+{
+	int cmd = txd->cid;
+
+	if (txd->ext_cid)
+		cmd |= FIELD_PREP(__MCU_CMD_FIELD_EXT_ID, txd->ext_cid);
+	if (txd->set_query == MCU_Q_QUERY)
+		cmd |= __MCU_CMD_FIELD_QUERY;
+	if (!txd->ext_cid && txd->set_query != MCU_Q_NA)
+		cmd |= __MCU_CMD_FIELD_CE;
+	if (txd->s2d_index == MCU_S2D_H2C)
+		cmd |= __MCU_CMD_FIELD_WA;
+	return cmd;
+}
+
+static int mt7915_replay_test_tx_raw(struct mt76_dev *mdev,
+				     struct mt76_queue *q,
+				     struct sk_buff *skb, u32 tx_info)
+{
+	const struct mt76_connac2_mcu_txd *txd;
+	int cmd, seq;
+
+	if (q == mdev->q_mcu[MT_MCUQ_FWDL]) {
+		cmd = MCU_CMD(FW_SCATTER);
+	} else if (q == mdev->q_mcu[MT_MCUQ_WM] ||
+		   q == mdev->q_mcu[MT_MCUQ_WA]) {
+		txd = (const void *)skb->data;
+		cmd = mt7915_replay_test_cmd(txd);
+		/* the reply carries the descriptor's sequence number */
+		mt76_test_fake->seq = (txd->seq - 1) & 0xf;
+		skb_pull(skb, sizeof(*txd));
+	} else {
+		return mt7915_replay_qops.orig->tx_queue_skb_raw(mdev, q, skb,
+								 tx_info);
+	}
+
+	return mt76_test_mcu_send(mdev, skb, cmd, &seq);
+}
+
+/* once mt76_dma_attach() has set the device's queue ops: wrap them */
+static void mt7915_replay_test_wrap(struct mt76_dev *mdev)
+{
+	struct mt7915_replay_qops *w = &mt7915_replay_qops;
+
+	if (!mdev->queue_ops || mdev->queue_ops == &w->ops ||
+	    !mdev->queue_ops->tx_queue_skb_raw)
+		return;
+	w->orig = mdev->queue_ops;
+	w->ops = *mdev->queue_ops;
+	w->ops.tx_queue_skb_raw = mt7915_replay_test_tx_raw;
+	mdev->queue_ops = &w->ops;
+}
+
+/* every register access goes by here */
+static u32 mt7915_replay_test_rr_model(struct mt76_test_fake *fake, u32 addr,
+				       u32 val)
+{
+	mt7915_replay_test_wrap(fake->dev);
+	return val;
+}
+
+static u32 mt7915_replay_test_rr_replay(struct mt76_test_fake *fake,
+					u32 addr, u32 val)
+{
+	mt7915_replay_test_wrap(fake->dev);
+	return mt76_replay_rr(fake, addr, val);
+}
+
+/* --- devices ---------------------------------------------------------------- */
+
+static void mt7915_replay_test_tx_cleanup(struct mt76_dev *dev,
+					  struct mt76_queue *q, bool flush)
+{
+}
+
+/* without DMA: the firmware download still cleans up its queue */
+static const struct mt76_queue_ops mt7915_replay_test_no_dma = {
+	.tx_cleanup = mt7915_replay_test_tx_cleanup,
+};
+
+/* Enabling interrupts schedules the IRQ tasklet, which would then run
+ * whenever, against an interrupt source the fake says is all pending. The
+ * fake has no interrupts to give: replies go to the driver directly.
+ */
+static void mt7915_replay_test_irq_tasklet(struct tasklet_struct *t)
+{
+}
+
+static void mt7915_replay_test_setup(struct kunit *test,
+				     struct mt7915_dev *dev, bool dma)
+{
+	mt7915_init_test_soc(test, dev);
+	tasklet_setup(&dev->mt76.irq_tasklet, mt7915_replay_test_irq_tasklet);
+	if (dma)
+		KUNIT_ASSERT_EQ(test, dma_coerce_mask_and_coherent(
+				dev->mt76.dma_dev, DMA_BIT_MASK(32)), 0);
+	else
+		dev->mt76.queue_ops = &mt7915_replay_test_no_dma;
+	ieee80211_hw_set(dev->mt76.hw, NO_AUTO_VIF);
+}
+
+static void mt7915_replay_test_free(void *rec)
+{
+	mt76_record_free(rec);
+}
+
+static void mt7915_replay_test_kvfree(void *p)
+{
+	kvfree(p);
+}
+
+static struct mt76_record *mt7915_replay_test_record(struct kunit *test)
+{
+	struct mt76_record *rec = mt76_record_alloc(SZ_1M, 0);
+
+	KUNIT_ASSERT_NOT_NULL(test, rec);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_replay_test_free, rec), 0);
+	mt76_record_attach(rec);
+	return rec;
+}
+
+static void *mt7915_replay_test_take(struct kunit *test,
+				     struct mt76_record *rec, size_t *len)
+{
+	void *data;
+
+	mt76_record_detach(rec);
+	data = mt76_record_copy(rec, len);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_replay_test_kvfree, data), 0);
+	return data;
+}
+
+/* An MT7986 like the GL-MT6000's (one MT7976 doing both bands) to make the
+ * recording on, the firmware model answering. Its EEPROM image is the
+ * efuse's content.
+ */
+static struct mt7915_dev *mt7915_replay_test_model(struct kunit *test,
+						   bool dma)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_replay_model *m;
+
+	m = kunit_kzalloc(test, sizeof(*m), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, m);
+	m->eeprom = dev->mt76.eeprom.data;
+	m->top_misc = mt7915_init_test_addr(dev, MT_TOP_MISC);
+	mt7915_replay_test_setup(test, dev, dma);
+
+	fake->priv = m;
+	fake->mcu_hook = mt7915_replay_test_model_mcu;
+	fake->reply = mt7915_replay_test_model_reply;
+	fake->rr_hook = mt7915_replay_test_rr_model;
+	mt7915_replay_test_fw_state(fake, FW_STATE_FW_DOWNLOAD);
+
+	return dev;
+}
+
+/* The windows of the MT7986's register space that replays need keyed by
+ * a selector: the L2 remap (also the one probing uses before it knows the
+ * chip) and each A-die's SPI data register.
+ */
+static void mt7915_replay_test_windows(struct mt76_replay *r)
+{
+	mt76_replay_window(r, 0x400000 + MT_HIF_REMAP_L2_MT7916,
+			   0x400000 + MT_HIF_REMAP_BASE_L2_MT7916, SZ_64K);
+	mt76_replay_window(r, MT_HIF_REMAP_L2_MT7916,
+			   MT_HIF_REMAP_BASE_L2_MT7916, SZ_64K);
+	mt76_replay_window(r, MT_CONN_INFRA_OFFSET(MT_TOP_SPI_ADDR_CR(0)),
+			   MT_CONN_INFRA_OFFSET(MT_TOP_SPI_READ_DATA_CR(0)), 4);
+	mt76_replay_window(r, MT_CONN_INFRA_OFFSET(MT_TOP_SPI_ADDR_CR(1)),
+			   MT_CONN_INFRA_OFFSET(MT_TOP_SPI_READ_DATA_CR(1)), 4);
+}
+
+/* An MT7986 that knows nothing but @rec: the A-die SKU and everything
+ * else it reads come from there, as do the firmware's replies.
+ */
+static struct mt7915_dev *mt7915_replay_test_replayed(struct kunit *test,
+						      const void *rec,
+						      size_t len,
+						      struct mt76_replay **rp,
+						      bool dma)
+{
+	struct mt7915_dev *dev = __mt7915_test_dev(test, "mt7915e-replay");
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt76_replay *r;
+
+	mt7915_replay_test_setup(test, dev, dma);
+
+	r = mt76_replay_new(test, fake, rec, len);
+	mt7915_replay_test_windows(r);
+	r->strict = true;
+	mt76_replay_start(r, 0);
+	fake->rr_hook = mt7915_replay_test_rr_replay;
+	*rp = r;
+
+	return dev;
+}
+
+/* The two runs did the same: the same register accesses with the same
+ * values and the same commands with the same payloads, in the same order.
+ * (Replies can differ in number: the fake answers commands nobody waits
+ * for, the replay doesn't.)
+ */
+static bool mt7915_replay_test_io(const struct mt76_rec_hdr *h)
+{
+	return h->type != MT76_REC_DEV && h->type != MT76_REC_MARK &&
+	       h->type != MT76_REC_MCU_RESP && h->type != MT76_REC_MCU_RET;
+}
+
+/* records @from to @to of what mt7915_replay_test_same() compares */
+static void mt7915_replay_test_show(struct kunit *test, const char *what,
+				    const void *rec, int from, int to)
+{
+	const struct mt76_rec_hdr *h;
+	const void *body;
+	size_t off = 0;
+	int i = 0;
+	u32 blen;
+
+	while ((h = mt76_replay_next(rec, &off, &body, &blen)) && i <= to) {
+		if (!mt7915_replay_test_io(h))
+			continue;
+		if (i >= from)
+			kunit_info(test, "%s %d: type %u %*ph\n", what, i,
+				   h->type, min_t(u32, blen, 20), body);
+		i++;
+	}
+}
+
+static void mt7915_replay_test_same(struct kunit *test, const void *a,
+				    const void *b)
+{
+	const struct mt76_rec_hdr *x = NULL, *y = NULL;
+	const void *bx, *by;
+	size_t ox = 0, oy = 0;
+	u32 lx, ly;
+	int i = 0;
+
+	for (;;) {
+		do {
+			x = mt76_replay_next(a, &ox, &bx, &lx);
+		} while (x && !mt7915_replay_test_io(x));
+		do {
+			y = mt76_replay_next(b, &oy, &by, &ly);
+		} while (y && !mt7915_replay_test_io(y));
+		if (!x || !y)
+			break;
+		if (x->type != y->type || lx != ly || memcmp(bx, by, lx)) {
+			KUNIT_FAIL(test, "access %d differs", i);
+			mt7915_replay_test_show(test, "recorded", a, i - 6, i + 2);
+			mt7915_replay_test_show(test, "replayed", b, i - 6, i + 2);
+			return;
+		}
+		i++;
+	}
+	KUNIT_EXPECT_NULL(test, x);
+	KUNIT_EXPECT_NULL(test, y);
+	kunit_info(test, "the replay made the same %d accesses\n", i);
+}
+
+static void mt7915_replay_test_same_msgs(struct kunit *test,
+					 struct mt76_test_fake *a,
+					 struct mt76_test_fake *b)
+{
+	struct mt76_test_msg *x, *y;
+	int i;
+
+	KUNIT_EXPECT_EQ(test, a->n_msgs, b->n_msgs);
+	for (i = 0; i < min(a->n_msgs, b->n_msgs); i++) {
+		x = mt76_test_msg(a, i);
+		y = mt76_test_msg(b, i);
+		KUNIT_ASSERT_NOT_NULL(test, x);
+		KUNIT_ASSERT_NOT_NULL(test, y);
+		KUNIT_EXPECT_EQ_MSG(test, x->cmd, y->cmd, "message %d", i);
+		KUNIT_EXPECT_EQ_MSG(test, x->len, y->len, "message %d", i);
+		if (x->len == y->len)
+			KUNIT_EXPECT_MEMEQ_MSG(test, x->data, y->data, x->len,
+					       "message %d", i);
+	}
+}
+
+static void mt7915_replay_test_expect_clean(struct kunit *test,
+					    struct mt76_replay *r)
+{
+	mt76_replay_report(test, r);
+	KUNIT_EXPECT_TRUE(test, mt76_replay_covered(r));
+	KUNIT_EXPECT_FALSE(test, r->diverged);
+	KUNIT_EXPECT_EQ(test, r->beyond_mcu, 0);
+	KUNIT_EXPECT_EQ(test, r->pos, r->n_evs);
+}
+
+/* mt7915_unregister_device(), which frees the device: what would free it
+ * again goes, and what its fake still holds
+ */
+static void mt7915_replay_test_unregister(struct kunit *test,
+					  struct mt7915_dev *dev,
+					  struct mt76_test_fake *fake)
+{
+	kunit_remove_action(test, mt76_test_free_device, &dev->mt76);
+	kunit_remove_action(test, mt76_test_fake_free, fake);
+	mt7915_unregister_device(dev);
+	xa_destroy(&fake->regs);
+	if (mt76_test_fake == fake)
+		mt76_test_fake = NULL;
+}
+
+/* --- the tests ---------------------------------------------------------------- */
+
+/* The firmware boot (ROM patch, WM and WA download, firmware logging off,
+ * WTBL reset, MWDS, MU/RU platform type, rx airtime and RED), replayed:
+ * the device boots its firmware from the recording alone.
+ */
+static void mt7915_replay_test_init_firmware(struct kunit *test)
+{
+	struct mt76_test_fake *model_fake;
+	struct mt7915_dev *dev, *model;
+	struct mt76_record *rec;
+	struct mt76_replay *r;
+	void *data, *again;
+	size_t len, len2;
+
+	mt7915_replay_test_firmware(test);
+	model = mt7915_replay_test_model(test, false);
+	model_fake = mt76_test_fake;
+	rec = mt7915_replay_test_record(test);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_init_firmware(model), 0);
+	data = mt7915_replay_test_take(test, rec, &len);
+	KUNIT_ASSERT_TRUE(test, test_bit(MT76_STATE_MCU_RUNNING,
+					 &model->mphy.state));
+
+	dev = mt7915_replay_test_replayed(test, data, len, &r, false);
+	rec = mt7915_replay_test_record(test);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_init_firmware(dev), 0);
+	again = mt7915_replay_test_take(test, rec, &len2);
+
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_MCU_RUNNING,
+					 &dev->mphy.state));
+	KUNIT_EXPECT_STREQ(test, dev->mt76.hw->wiphy->fw_version,
+			   "rf-kunit-2-20261019000000r");
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(mt76_test_fake,
+						   MCU_CMD(FW_START_REQ)), 2);
+	mt7915_replay_test_expect_clean(test, r);
+	mt7915_replay_test_same_msgs(test, model_fake, mt76_test_fake);
+	mt7915_replay_test_same(test, data, again);
+}
+
+/* mt7915_init_hardware(): interrupts masked, DMA up, the firmware booted
+ * through the driver's own DMA path, the EEPROM read from efuse, wcid 0
+ * for the global wcid; then stopped again. Replayed, with the teardown.
+ */
+static void mt7915_replay_test_init_hardware(struct kunit *test)
+{
+	struct mt7915_phy *phy2, *phy2_model;
+	struct mt76_test_fake *model_fake;
+	struct mt7915_dev *dev, *model;
+	struct mt76_record *rec;
+	struct mt76_replay *r;
+	void *data, *again;
+	size_t len, len2;
+	u8 eeprom[16];
+
+	mt7915_replay_test_firmware(test);
+	rcu_expedite_gp();
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_init_test_unexpedite, NULL), 0);
+
+	model = mt7915_replay_test_model(test, true);
+	model_fake = mt76_test_fake;
+	memcpy(eeprom, model->mt76.eeprom.data, sizeof(eeprom));
+	rec = mt7915_replay_test_record(test);
+	model->dbdc_support = mt7915_band_config(model);
+	phy2_model = mt7915_alloc_ext_phy(model);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(phy2_model));
+	KUNIT_ASSERT_EQ(test, mt7915_init_hardware(model, phy2_model), 0);
+	mt7915_stop_hardware(model);
+	data = mt7915_replay_test_take(test, rec, &len);
+	ieee80211_free_hw(phy2_model->mt76->hw);
+
+	dev = mt7915_replay_test_replayed(test, data, len, &r, true);
+	rec = mt7915_replay_test_record(test);
+	dev->dbdc_support = mt7915_band_config(dev);
+	KUNIT_EXPECT_TRUE(test, dev->dbdc_support);
+	phy2 = mt7915_alloc_ext_phy(dev);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(phy2));
+	KUNIT_EXPECT_EQ(test, mt7915_init_hardware(dev, phy2), 0);
+
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_INITIALIZED,
+					 &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_MCU_RUNNING,
+					 &dev->mphy.state));
+	KUNIT_EXPECT_PTR_EQ(test, dev->mt76.queue_ops,
+			    &mt7915_replay_qops.ops);
+	/* the EEPROM came from "efuse": the model's image */
+	KUNIT_EXPECT_FALSE(test, dev->flash_mode);
+	KUNIT_EXPECT_MEMEQ(test, dev->mt76.eeprom.data, eeprom,
+			   sizeof(eeprom));
+	KUNIT_EXPECT_MEMEQ(test, dev->mphy.macaddr, mt7915_init_test_mac,
+			   ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, dev->mphy.chainmask, 0xf);
+	KUNIT_EXPECT_TRUE(test, dev->mphy.cap.has_2ghz);
+	KUNIT_EXPECT_PTR_EQ(test, rcu_access_pointer(dev->mt76.wcid[0]),
+			    &dev->mt76.global_wcid);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(mt76_test_fake,
+				MCU_EXT_QUERY(EFUSE_ACCESS)),
+			MT7916_EEPROM_SIZE / MT7915_EEPROM_BLOCK_SIZE);
+
+	mt7915_stop_hardware(dev);
+	again = mt7915_replay_test_take(test, rec, &len2);
+	ieee80211_free_hw(phy2->mt76->hw);
+
+	mt7915_replay_test_expect_clean(test, r);
+	mt7915_replay_test_same_msgs(test, model_fake, mt76_test_fake);
+	mt7915_replay_test_same(test, data, again);
+}
+
+/* All of mt7915_register_device(), the init work it queues and
+ * mt7915_unregister_device(), replayed: both bands registered with
+ * mac80211, the init work's commands answered, the debugfs and coredump
+ * set up, then everything taken down again.
+ */
+static void mt7915_replay_test_register_device(struct kunit *test)
+{
+	struct mt76_test_fake *model_fake, *fake;
+	struct mt7915_dev *dev, *model;
+	struct mt76_record *rec;
+	struct mt76_replay *r;
+	void *data, *again;
+	size_t len, len2;
+	struct mt7915_phy *phy2;
+
+	mt7915_replay_test_firmware(test);
+	rcu_expedite_gp();
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_init_test_unexpedite, NULL), 0);
+
+	model = mt7915_replay_test_model(test, true);
+	model_fake = mt76_test_fake;
+	rec = mt7915_replay_test_record(test);
+	KUNIT_ASSERT_EQ(test, mt7915_register_device(model), 0);
+	flush_work(&model->init_work);
+	mt7915_replay_test_unregister(test, model, model_fake);
+	data = mt7915_replay_test_take(test, rec, &len);
+
+	dev = mt7915_replay_test_replayed(test, data, len, &r, true);
+	fake = mt76_test_fake;
+	rec = mt7915_replay_test_record(test);
+	KUNIT_ASSERT_EQ(test, mt7915_register_device(dev), 0);
+	flush_work(&dev->init_work);
+
+	phy2 = mt7915_ext_phy(dev);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_REGISTERED,
+					 &dev->mphy.state));
+	KUNIT_EXPECT_NOT_NULL(test, phy2);
+	if (phy2)
+		KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_REGISTERED,
+						 &phy2->mt76->state));
+	KUNIT_EXPECT_TRUE(test, dev->recovery.hw_init_done);
+	KUNIT_EXPECT_TRUE(test, dev->dbdc_support);
+	KUNIT_EXPECT_STREQ(test, dev->mt76.hw->wiphy->fw_version,
+			   "rf-kunit-2-20261019000000r");
+	KUNIT_EXPECT_NOT_NULL(test, dev->debugfs_dir);
+	/* the init work's commands came last: the EEPROM mode first */
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+				MCU_EXT_CMD(EFUSE_BUFFER_MODE)), 1);
+
+	mt7915_replay_test_unregister(test, dev, fake);
+	again = mt7915_replay_test_take(test, rec, &len2);
+
+	mt7915_replay_test_expect_clean(test, r);
+	mt7915_replay_test_same_msgs(test, model_fake, fake);
+	mt7915_replay_test_same(test, data, again);
+}
+
+/* A capture from the router (wifi/capture.sh), if the VM has one, through
+ * mt7915_register_device(). The router reads its EEPROM from flash, which
+ * the VM hasn't got: the EEPROM recorded at registration stands in, as the
+ * default image the driver falls back to. What the capture doesn't cover
+ * (the VM's probe isn't the router's) is reported, not failed.
+ */
+static void mt7915_replay_test_capture(struct kunit *test)
+{
+	const struct mt76_rec_hdr *h;
+	struct mt7915_dev *dev;
+	struct mt76_replay *r;
+	const void *body;
+	size_t len, off = 0;
+	void *data;
+	u32 blen;
+	int ret;
+
+	dev = mt7915_init_test_chip(test, MT7976_ONE_ADIE_DBDC);
+	data = mt76_replay_request(test, dev->mt76.dev, MT7915_REPLAY_CAPTURE,
+				   &len);
+	if (!data)
+		kunit_skip(test, "no capture in /lib/firmware/%s",
+			   MT7915_REPLAY_CAPTURE);
+	KUNIT_ASSERT_NOT_NULL_MSG(test, mt76_replay_hdr(data, len),
+				  "%s isn't a recording",
+				  MT7915_REPLAY_CAPTURE);
+
+	mt7915_replay_test_firmware(test);
+	while ((h = mt76_replay_next(data, &off, &body, &blen)))
+		if (h->type == MT76_REC_BLOB && blen > 16 &&
+		    !strcmp(body, "eeprom"))
+			break;
+	if (h)
+		mt7915_replay_test_write(test,
+					 MT7986_EEPROM_MT7976_DEFAULT_DBDC,
+					 body + 16, blen - 16);
+
+	/* the first device was only for request_firmware() */
+	dev = mt7915_replay_test_replayed(test, data, len, &r, true);
+	r->strict = false;
+	rcu_expedite_gp();
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_init_test_unexpedite, NULL), 0);
+
+	ret = mt7915_register_device(dev);
+	mt76_replay_report(test, r);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	flush_work(&dev->init_work);
+	kunit_info(test, "capture: firmware %s, chainmask %#x, MAC %pM\n",
+		   dev->mt76.hw->wiphy->fw_version, dev->mt76.phy.chainmask,
+		   dev->mphy.macaddr);
+	mt7915_replay_test_unregister(test, dev, mt76_test_fake);
+}
+
+static struct kunit_case mt7915_replay_test_cases[] = {
+	KUNIT_CASE(mt7915_replay_test_init_firmware),
+	KUNIT_CASE(mt7915_replay_test_init_hardware),
+	KUNIT_CASE(mt7915_replay_test_register_device),
+	KUNIT_CASE(mt7915_replay_test_capture),
+	{}
+};
+
+static struct kunit_suite mt7915_replay_test_suite = {
+	.name = "mt7915-replay",
+	.test_cases = mt7915_replay_test_cases,
+};
+
+kunit_test_suites(&mt7915_replay_test_suite);
