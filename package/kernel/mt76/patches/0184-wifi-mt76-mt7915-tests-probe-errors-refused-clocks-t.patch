+		.run_main = true, .run_ext = true,
+	};
+
+	mt7915_test_mac_restart_run_fails(test, &c);
+}
+
+static void mt7915_test_mac_restart_ext_run_fails(struct kunit *test)
+{
+	static const struct mt7915_test_restart_chip c = { .run_ext = true };
+
+	mt7915_test_mac_restart_run_fails(test, &c);
+}
