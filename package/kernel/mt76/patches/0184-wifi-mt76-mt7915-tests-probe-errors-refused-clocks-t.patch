+/* A band that was running and can't be run again (its firmware refuses
+ * the power state) fails the restart, to be retried, and stays stopped:
+ * the main band first, the second band when only it ran.
+ */
+static void mt7915_test_mac_restart_run_fails(struct kunit *test,
+					      const struct mt7915_test_restart_chip *c)
+{
+	struct mt7915_dev *dev;
+
+	KUNIT_EXPECT_EQ(test, __mt7915_test_mac_restart_boot(test,
+			MCU_EXT_CMD(PM_STATE_CTRL), &dev, c), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(mt76_test_fake,
+			MCU_EXT_CMD(PM_STATE_CTRL)), 1);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_RUNNING, &dev->mphy.state));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_RUNNING,
+					  &dev->mt76.phys[MT_BAND1]->state));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_RESET, &dev->mphy.state));
+}
