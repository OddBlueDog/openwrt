+/* The firmware's switches are the band's, the settings a BSS's: an interface
+ * whose BSS doesn't use spatial reuse (a station, a mesh) leaves alone what an
+ * AP on the same radio set up, in any mode and whichever comes first. With no
+ * interface using it, the band's switches follow the last one asked as before.
+ */
+static void mt7915_test_obss_spr_other_vif_on_band(struct kunit *test)
+{
+	static const u8 modes[] = { MT7915_SPR_FIXED, MT7915_SPR_OFF, MT7915_SPR_AUTO };
+	struct ieee80211_he_obss_pd ap = {
+		.enable = true,
+		.sr_ctrl = IEEE80211_HE_SPR_NON_SRG_OFFSET_PRESENT,
+		.non_srg_max_offset = 10,
+	};
+	struct ieee80211_he_obss_pd none = {};
+	struct ieee80211_vif *sta;
+	struct mt7915_test_ctx c;
+	unsigned int sent;
+	int i;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_scene_detect(test, true);
+	c.phy->mt76->band_idx = 1;
+	sta = mt7915_test_vif(test, c.phy, NL80211_IFTYPE_STATION, HW_BSSID_1);
+	((struct mt7915_vif *)sta->drv_priv)->mt76.idx = 1;
+	c.mvif->mt76.idx = 0;
+
+	for (i = 0; i < ARRAY_SIZE(modes); i++) {
+		c.phy->spr_mode = modes[i];
+
+		/* the AP, then the station */
+		KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &ap), 0);
+		sent = c.fake->n_msgs;
+		KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, sta, &none), 0);
+		KUNIT_EXPECT_EQ_MSG(test, c.fake->n_msgs, sent, "mode %d", modes[i]);
+	}
+
+	/* the same interface changing its mind still counts */
+	c.phy->spr_mode = MT7915_SPR_FIXED;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &ap), 0);
+	ap.enable = false;
+	sent = c.fake->n_msgs;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &ap), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs - sent, 2);
+	mt7915_test_expect_spr(test, c.fake, sent, SPR_ENABLE_SD, 0, 1);
+	mt7915_test_expect_spr(test, c.fake, sent + 1, SPR_ENABLE, 0, 1);
+
+	/* nothing left using it: the station's turn */
+	sent = c.fake->n_msgs;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, sta, &none), 0);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs - sent, 2);
+}
