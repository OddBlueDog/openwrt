+/* A fixed threshold turns firmware's own adjustment off, and nothing else
+ * turns it back on: going back to auto has to, once, or scene detection
+ * would be left unable to move the threshold. Off in between changes nothing.
+ */
+static void mt7915_test_obss_spr_fixed_then_auto(struct kunit *test)
+{
+	struct ieee80211_he_obss_pd pd = {
+		.enable = true,
+		.sr_ctrl = IEEE80211_HE_SPR_NON_SRG_OFFSET_PRESENT,
+		.non_srg_max_offset = 10,
+	};
+	struct mt7915_test_ctx c;
+	unsigned int sent;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_scene_detect(test, true);
+	c.phy->mt76->band_idx = 1;
+
+	c.phy->spr_mode = MT7915_SPR_FIXED;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+
+	c.phy->spr_mode = MT7915_SPR_OFF;
+	sent = c.fake->n_msgs;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs - sent, 2);
+
+	c.phy->spr_mode = MT7915_SPR_AUTO;
+	sent = c.fake->n_msgs;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs - sent, 3);
+	mt7915_test_expect_spr(test, c.fake, sent, SPR_ENABLE_SD, 1, 1);
+	mt7915_test_expect_spr(test, c.fake, sent + 1, SPR_ENABLE_DPD, 1, 1);
+	mt7915_test_expect_spr(test, c.fake, sent + 2, SPR_ENABLE, 1, 1);
+
+	sent = c.fake->n_msgs;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs - sent, 2);
+	mt7915_test_expect_spr(test, c.fake, sent, SPR_ENABLE_SD, 1, 1);
+	mt7915_test_expect_spr(test, c.fake, sent + 1, SPR_ENABLE, 1, 1);
+}
