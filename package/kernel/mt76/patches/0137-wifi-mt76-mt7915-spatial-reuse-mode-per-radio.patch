+/* Off, or a fixed threshold on a BSS without spatial reuse, turns the band's
+ * switch off, and with scene detection nothing else turns it back on: going
+ * back to auto has to, once, or the radio stays without it until the firmware
+ * restarts.
+ */
+static void mt7915_test_obss_spr_back_to_auto_disabled_bss(struct kunit *test)
+{
+	static const u8 modes[] = { MT7915_SPR_OFF, MT7915_SPR_FIXED };
+	struct ieee80211_he_obss_pd pd = {};
+	struct mt7915_test_ctx c;
+	unsigned int sent;
+	int i;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_scene_detect(test, true);
+	c.phy->mt76->band_idx = 1;
+
+	/* never touched: auto sends what it always has */
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 1);
+
+	for (i = 0; i < ARRAY_SIZE(modes); i++) {
+		c.phy->spr_mode = modes[i];
+		sent = c.fake->n_msgs;
+		KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+		KUNIT_ASSERT_EQ(test, c.fake->n_msgs - sent, 2);
+		mt7915_test_expect_spr(test, c.fake, sent, SPR_ENABLE_SD, 0, 1);
+		mt7915_test_expect_spr(test, c.fake, sent + 1, SPR_ENABLE, 0, 1);
+
+		c.phy->spr_mode = MT7915_SPR_AUTO;
+		sent = c.fake->n_msgs;
+		KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+		KUNIT_ASSERT_EQ(test, c.fake->n_msgs - sent, 2);
+		mt7915_test_expect_spr(test, c.fake, sent, SPR_ENABLE_SD, 1, 1);
+		mt7915_test_expect_spr(test, c.fake, sent + 1, SPR_ENABLE, 1, 1);
+
+		/* once */
+		sent = c.fake->n_msgs;
+		KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+		KUNIT_ASSERT_EQ(test, c.fake->n_msgs - sent, 1);
+		mt7915_test_expect_spr(test, c.fake, sent, SPR_ENABLE_SD, 1, 1);
+	}
+}
