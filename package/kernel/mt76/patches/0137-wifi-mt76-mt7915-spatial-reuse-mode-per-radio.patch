+/* A firmware restart loses spatial reuse's settings and mac80211 doesn't send
+ * BSS_CHANGED_HE_OBSS_PD for it, so the driver has to; only for a restart.
+ */
+static void mt7915_main_test_spr_after_restart(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw = dev->mt76.hw;
+
+	mt7915_main_test_spr_applied = 0;
+	mt7915_main_test_spr_apply_ret = 0;
+	kunit_activate_static_stub(test, mt7915_spr_apply,
+				   mt7915_main_test_spr_apply_stub);
+
+	mt7915_reconfig_complete(hw, IEEE80211_RECONFIG_TYPE_SUSPEND);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_spr_applied, 0);
+	mt7915_reconfig_complete(hw, IEEE80211_RECONFIG_TYPE_RESTART);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_spr_applied, 1);
+	KUNIT_EXPECT_FALSE(test, mt7915_hw_phy(hw)->spr_unapplied);
+
+	/* refused after a restart: the next write of the same mode tries again */
+	mt7915_main_test_spr_apply_ret = -EIO;
+	mt7915_reconfig_complete(hw, IEEE80211_RECONFIG_TYPE_RESTART);
+	KUNIT_EXPECT_TRUE(test, mt7915_hw_phy(hw)->spr_unapplied);
+	mt7915_main_test_spr_apply_ret = 0;
+	wiphy_lock(hw->wiphy);
+	KUNIT_EXPECT_EQ(test, mt7915_spr_set_mode(mt7915_hw_phy(hw), "auto"), 0);
+	wiphy_unlock(hw->wiphy);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_spr_applied, 3);
+	KUNIT_EXPECT_FALSE(test, mt7915_hw_phy(hw)->spr_unapplied);
+}
