+/* The MT7986's DMA with a WED attached (version 2: it takes rx too): both
+ * bands' data rings and both rx data rings are WED's, set up through it
+ * (their registers WED's from then on), the rx rings' buffers registered as
+ * rx tokens; band 0's tx-free events come from WED. The firmware rings stay
+ * the host's. A reset resets WED's DMA too; the teardown detaches it.
+ */
+static void mt7915_dma_test_init_wed(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_dev(test);
+	struct mt76_dev *mdev = &dev->mt76;
+	struct mt76_test_wed *w;
+	struct mt76_queue *q;
+	u16 token_size = mdev->rx_token_size;
+
+	w = mt76_test_wed_init(test, &mdev->mmio.wed);
+	__mt7915_dma_test_init(test, dev, true);
+
+	KUNIT_EXPECT_EQ(test, w->n_tx_ring, 2);
+	q = dev->mphy.q_tx[MT_TXQ_BE];
+	KUNIT_EXPECT_EQ(test, q->flags,
+			MT_WED_Q_TX(0) | MT_QFLAG_TX_NO_ENTRY);
+	KUNIT_EXPECT_EQ(test, q->wed_regs, MT76_TEST_WED_TX_REGS(0));
+	KUNIT_EXPECT_EQ(test, mt76_test_wed_reg(w, MT76_TEST_WED_TX_REGS(0) +
+			offsetof(struct mt76_queue_regs, ring_size)),
+			MT7915_TX_RING_SIZE);
+	q = mdev->phys[MT_BAND1]->q_tx[MT_TXQ_BE];
+	KUNIT_EXPECT_EQ(test, q->wed_regs, MT76_TEST_WED_TX_REGS(1));
+	KUNIT_EXPECT_FALSE(test, mdev->q_mcu[MT_MCUQ_WM]->flags & MT_QFLAG_WED);
+
+	KUNIT_EXPECT_EQ(test, w->n_rx_ring, 2);
+	KUNIT_EXPECT_EQ(test, mdev->q_rx[MT_RXQ_MAIN].flags,
+			MT_WED_Q_RX(MT7915_RXQ_BAND0));
+	KUNIT_EXPECT_EQ(test, mdev->q_rx[MT_RXQ_BAND1].flags,
+			MT_WED_Q_RX(MT7915_RXQ_BAND1));
+	KUNIT_EXPECT_EQ(test, mdev->rx_token_size,
+			token_size + 2 * MT7915_RX_RING_SIZE);
+	KUNIT_EXPECT_FALSE(test, idr_is_empty(&mdev->rx_token));
+	KUNIT_EXPECT_EQ(test, w->n_txfree, 1);
+	KUNIT_EXPECT_TRUE(test,
+			  mt76_queue_is_wed_tx_free(&mdev->q_rx[MT_RXQ_MAIN_WA]));
+	KUNIT_EXPECT_FALSE(test, mdev->q_rx[MT_RXQ_MCU].flags & MT_QFLAG_WED);
+
+	mt7915_dma_test_run_reset(dev, false);
+	KUNIT_EXPECT_EQ(test, w->n_reset_dma, 1);
+	/* emptied and handed to WED again */
+	KUNIT_EXPECT_EQ(test, w->n_txfree, 2);
+
+	mt7915_dma_test_teardown(dev);
+	KUNIT_EXPECT_EQ(test, w->n_detach, 1);
+	KUNIT_EXPECT_FALSE(test, mtk_wed_device_active(&mdev->mmio.wed));
+}
