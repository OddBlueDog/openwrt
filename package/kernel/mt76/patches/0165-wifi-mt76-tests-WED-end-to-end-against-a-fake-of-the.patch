+/* The WED setup of the MT7986's platform probe, when no WED attaches (the
+ * Ethernet driver has none, or refuses): every parameter for WED filled in
+ * from the WMAC's register window, the device's own interrupt kept, and
+ * the probe goes on without WED. Without a register window, nothing.
+ */
+static void mt7915_mmio_test_wed_init_no_attach(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
+	struct mt76_test_wed *w;
+	int irq = 42;
+
+	mt7915_mmio_test_wed_on(test);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_wed_init(dev,
+			mt7915_mmio_test_pdev(test, false), false, &irq), 0);
+	KUNIT_EXPECT_NULL(test, wed->wlan.base);
+
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_wed_init(dev,
+			mt7915_mmio_test_pdev(test, true), false, &irq), 0);
+	KUNIT_EXPECT_EQ(test, irq, 42);
+	KUNIT_EXPECT_FALSE(test, mtk_wed_device_active(wed));
+	KUNIT_EXPECT_EQ(test, wed->wlan.bus_type, MTK_WED_BUS_AXI);
+	KUNIT_EXPECT_NOT_NULL(test, wed->wlan.base);
+	KUNIT_EXPECT_EQ(test, wed->wlan.phy_base, MT7915_MMIO_TEST_WMAC_BASE);
+	KUNIT_EXPECT_EQ(test, wed->wlan.wpdma_int,
+			MT7915_MMIO_TEST_WMAC_BASE + MT_INT_SOURCE_CSR);
+	KUNIT_EXPECT_EQ(test, wed->wlan.wpdma_mask,
+			MT7915_MMIO_TEST_WMAC_BASE + MT_INT_MASK_CSR);
+	KUNIT_EXPECT_EQ(test, wed->wlan.wpdma_tx,
+			MT7915_MMIO_TEST_WMAC_BASE + MT_TXQ_WED_RING_BASE);
+	KUNIT_EXPECT_EQ(test, wed->wlan.wpdma_txfree,
+			MT7915_MMIO_TEST_WMAC_BASE + MT_RXQ_WED_RING_BASE);
+	KUNIT_EXPECT_EQ(test, wed->wlan.wpdma_rx[0],
+			MT7915_MMIO_TEST_WMAC_BASE + MT_RXQ_WED_DATA_RING_BASE);
+	/* the MT7986's interrupt bits and token split */
+	KUNIT_EXPECT_EQ(test, wed->wlan.tx_tbit[0], 30);
+	KUNIT_EXPECT_EQ(test, wed->wlan.tx_tbit[1], 31);
+	KUNIT_EXPECT_EQ(test, wed->wlan.txfree_tbit, 2);
+	KUNIT_EXPECT_EQ(test, wed->wlan.rx_tbit[0], 22);
+	KUNIT_EXPECT_EQ(test, wed->wlan.rx_tbit[1], 23);
+	KUNIT_EXPECT_EQ(test, wed->wlan.nbuf, MT7915_HW_TOKEN_SIZE);
+	KUNIT_EXPECT_EQ(test, wed->wlan.token_start,
+			MT7915_TOKEN_SIZE - MT7915_HW_TOKEN_SIZE);
+	KUNIT_EXPECT_TRUE(test, wed->wlan.wcid_512);
+	KUNIT_EXPECT_TRUE(test, wed->wlan.init_buf == mt7915_wed_init_buf);
+	KUNIT_EXPECT_TRUE(test, wed->wlan.reset == mt7915_mmio_wed_reset);
+
+	/* a WED that refuses */
+	w = mt76_test_wed_new(test);
+	w->attach_ret = -EBUSY;
+	mt76_test_wed_publish(w);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_wed_init(dev,
+			mt7915_mmio_test_pdev(test, true), false, &irq), 0);
+	KUNIT_EXPECT_EQ(test, w->n_attach, 1);
+	KUNIT_EXPECT_FALSE(test, mtk_wed_device_active(wed));
+	KUNIT_EXPECT_EQ(test, irq, 42);
+}
+
+/* A WED attaches: its interrupt replaces the device's, DMA goes through
+ * its device (32-bit addresses), and the probe takes the WED path. A WED
+ * device that can't do 32-bit DMA fails the probe.
+ */
+static void mt7915_mmio_test_wed_init_attach(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
+	struct device *eth, *no_dma;
+	struct mt76_test_wed *w;
+	int irq = 42;
+
+	mt7915_mmio_test_wed_on(test);
+	eth = kunit_device_register(test, "mt7915-wed-eth");
+	no_dma = kunit_device_register(test, "mt7915-wed-no-dma");
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(eth));
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(no_dma));
+	KUNIT_ASSERT_EQ(test, dma_coerce_mask_and_coherent(eth,
+			DMA_BIT_MASK(64)), 0);
+	no_dma->dma_mask = NULL;
+
+	w = mt76_test_wed_new(test);
+	w->dev = eth;
+	w->irq = 99;
+	mt76_test_wed_publish(w);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_wed_init(dev,
+			mt7915_mmio_test_pdev(test, true), false, &irq), 1);
+	KUNIT_EXPECT_TRUE(test, mtk_wed_device_active(wed));
+	KUNIT_EXPECT_EQ(test, irq, 99);
+	KUNIT_EXPECT_PTR_EQ(test, dev->mt76.dma_dev, eth);
+	KUNIT_EXPECT_EQ(test, *eth->dma_mask, DMA_BIT_MASK(32));
+	KUNIT_EXPECT_EQ(test, dev->mt76.rx_token_size,
+			MT7915_WED_RX_TOKEN_SIZE);
+
+	wed->ops = NULL;
+	w->dev = no_dma;
+	KUNIT_EXPECT_LT(test, mt7915_mmio_wed_init(dev,
+			mt7915_mmio_test_pdev(test, true), false, &irq), 0);
+	KUNIT_EXPECT_EQ(test, w->n_attach, 2);
+}
+
+/* the fake firmware: the SER trigger of a WED reset done at once */
+static int mt7915_mmio_test_wed_ser(struct mt76_test_fake *fake,
+				    const struct mt76_test_msg *msg)
+{
+	struct mt76_dev *mdev = fake->dev;
+
+	if (msg->cmd == MCU_EXT_CMD(SET_SER_TRIGGER))
+		complete(&mdev->mmio.wed_reset);
+	return 0;
+}
+
+/* The Ethernet driver's WED reset (under RTNL) runs an L1 recovery of the
+ * WLAN side: the firmware is told to start it, and the reset waits, without
+ * RTNL, for the host's DMA reset to say it's done. One at a time; a
+ * firmware that refuses ends it.
+ */
+static void mt7915_mmio_test_wed_reset(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt76_mmio *mmio = &dev->mt76.mmio;
+	struct mt76_test_msg *msg;
+	int ret;
+
+	init_completion(&mmio->wed_reset);
+	init_completion(&mmio->wed_reset_complete);
+	fake->mcu_hook = mt7915_mmio_test_wed_ser;
+
+	rtnl_lock();
+	ret = mt7915_mmio_wed_reset(&mmio->wed);
+	KUNIT_EXPECT_TRUE(test, rtnl_is_locked());
+	rtnl_unlock();
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_WED_RESET,
+					  &dev->mphy.state));
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(SET_SER_TRIGGER));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->data[0], SER_RECOVER);
+	KUNIT_EXPECT_EQ(test, msg->data[1], SER_SET_RECOVER_L1);
+
+	/* another one already on */
+	set_bit(MT76_STATE_WED_RESET, &dev->mphy.state);
+	rtnl_lock();
+	ret = mt7915_mmio_wed_reset(&mmio->wed);
+	rtnl_unlock();
+	KUNIT_EXPECT_EQ(test, ret, -EBUSY);
+	clear_bit(MT76_STATE_WED_RESET, &dev->mphy.state);
+
+	fake->mcu_ret = -EIO;
+	rtnl_lock();
+	ret = mt7915_mmio_wed_reset(&mmio->wed);
+	rtnl_unlock();
+	KUNIT_EXPECT_EQ(test, ret, -EIO);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_WED_RESET,
+					  &dev->mphy.state));
+}
+
+/* What the WO counted a station receiving goes to that station's counters;
+ * a station that isn't there (gone, or an index past the table) is skipped.
+ */
+static void mt7915_mmio_test_wed_rx_stats(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
+	struct mtk_wed_wo_rx_stats st = {
+		.wlan_idx = cpu_to_le16(5),
+		.rx_pkt_cnt = cpu_to_le32(10),
+		.rx_byte_cnt = cpu_to_le32(1500),
+		.rx_err_cnt = cpu_to_le32(2),
+		.rx_drop_cnt = cpu_to_le32(1),
+	};
+	struct mt76_wcid *wcid;
+
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+	wcid->idx = 5;
+	rcu_assign_pointer(dev->mt76.wcid[5], wcid);
+
+	mt7915_mmio_wed_update_rx_stats(wed, &st);
+	mt7915_mmio_wed_update_rx_stats(wed, &st);
+	KUNIT_EXPECT_EQ(test, wcid->stats.rx_packets, 20);
+	KUNIT_EXPECT_EQ(test, wcid->stats.rx_bytes, 3000);
+	KUNIT_EXPECT_EQ(test, wcid->stats.rx_errors, 4);
+	KUNIT_EXPECT_EQ(test, wcid->stats.rx_drops, 2);
+
+	st.wlan_idx = cpu_to_le16(6);
+	mt7915_mmio_wed_update_rx_stats(wed, &st);
+	st.wlan_idx = cpu_to_le16(0xffff);
+	mt7915_mmio_wed_update_rx_stats(wed, &st);
+	KUNIT_EXPECT_EQ(test, wcid->stats.rx_packets, 20);
+
+	RCU_INIT_POINTER(dev->mt76.wcid[5], NULL);
+	synchronize_rcu();
+}
+
+/* With a WED, the interrupt mask goes to WED as well, which raises the
+ * host's interrupts for it.
+ */
+static void mt7915_mmio_test_wed_irq_mask(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_wed *w;
+
+	w = mt76_test_wed_init(test, &dev->mt76.mmio.wed);
+	mt7915_dual_hif_set_irq_mask(dev, true, 0, MT_INT_MCU_CMD);
+	KUNIT_EXPECT_EQ(test, w->n_set_mask, 1);
+	KUNIT_EXPECT_EQ(test, w->irq_mask, dev->mt76.mmio.irqmask);
+	KUNIT_EXPECT_NE(test, w->irq_mask & MT_INT_MCU_CMD, 0);
+}
