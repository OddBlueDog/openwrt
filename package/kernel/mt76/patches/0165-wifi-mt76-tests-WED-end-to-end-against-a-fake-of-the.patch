+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+/* With a WED, each station record goes to its WO too (so it can count the
+ * station's rx), before the firmware gets it; a record the WO refuses isn't
+ * sent at all. A station in four-address mode from the start gets a wcid of
+ * the range WED keeps for those (MT76_WED_WDS_MIN on).
+ */
+static void mt7915_main_test_wed_sta_add(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw2 = mt7915_main_test_hw2(dev);
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	struct mt76_test_wed *w;
+
+	vif = mt7915_main_test_ap(test, hw2, 1);
+	w = mt76_test_wed_init(test, &dev->mt76.mmio.wed);
+	mt7915_main_test_clear(fake);
+
+	sta = mt7915_main_test_sta(test, vif, 1);
+	KUNIT_ASSERT_EQ(test, mt7915_mac_sta_add(&dev->mt76, vif, sta), 0);
+	KUNIT_EXPECT_EQ(test, w->n_msg, 1);
+	KUNIT_EXPECT_EQ(test, w->last_msg, WED_WO_STA_REC);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(STA_REC_UPDATE)), 1);
+	KUNIT_EXPECT_LT(test, mt7915_main_test_msta(sta)->wcid.idx,
+			MT76_WED_WDS_MIN);
+
+	sta = mt7915_main_test_sta(test, vif, 2);
+	msta = mt7915_main_test_msta(sta);
+	set_bit(MT_WCID_FLAG_4ADDR, &msta->wcid.flags);
+	mt7915_main_test_clear(fake);
+	w->msg_ret = -EIO;
+	KUNIT_ASSERT_EQ(test, mt7915_mac_sta_add(&dev->mt76, vif, sta), 0);
+	KUNIT_EXPECT_GE(test, msta->wcid.idx, MT76_WED_WDS_MIN);
+	KUNIT_EXPECT_LT(test, msta->wcid.idx, MT76_WED_WDS_MAX);
+	KUNIT_EXPECT_EQ(test, w->n_msg, 2);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(STA_REC_UPDATE)), 0);
+}
+
+/* Four-address mode switched on later, with a WED: the MT7986 keeps the
+ * station's wcid (only the MT7915 moves it to the WDS range), and the mode
+ * is in its flags.
+ */
+static void mt7915_main_test_wed_set_4addr(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw2 = mt7915_main_test_hw2(dev);
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	u16 idx;
+
+	vif = mt7915_main_test_ap(test, hw2, 1);
+	sta = mt7915_main_test_sta(test, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	KUNIT_ASSERT_EQ(test, mt7915_mac_sta_add(&dev->mt76, vif, sta), 0);
+	idx = msta->wcid.idx;
+	mt76_test_wed_init(test, &dev->mt76.mmio.wed);
+
+	MT7915_MAIN_TEST_OP(sta_set_4addr)(hw2, vif, sta, true);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_4ADDR, &msta->wcid.flags));
+	KUNIT_EXPECT_EQ(test, msta->wcid.idx, idx);
+	MT7915_MAIN_TEST_OP(sta_set_4addr)(hw2, vif, sta, false);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_4ADDR,
+					  &msta->wcid.flags));
+}
+
+/* The path the Ethernet driver offloads a flow along, to a station of an
+ * interface: WED's DMA ring, the interface's BSS and the station's band.
+ * The MT7986 names no station (0x3ff: WED finds it by address) unless it
+ * is a four-address one; the path ends there. No WED, no path; a wcid WED
+ * can't address, an error.
+ */
+static void mt7915_main_test_wed_forward_path(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw2 = mt7915_main_test_hw2(dev);
+	struct net_device_path_ctx ctx = {};
+	struct net_device_path path = {};
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	struct net_device *ndev;
+	u16 idx;
+
+	ndev = kunit_kzalloc(test, sizeof(*ndev), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ndev);
+	vif = mt7915_main_test_ap(test, hw2, 1);
+	mt7915_main_test_ap(test, hw2, 2);
+	vif = mt7915_main_test_ap(test, hw2, 3);
+	sta = mt7915_main_test_sta(test, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	KUNIT_ASSERT_EQ(test, mt7915_mac_sta_add(&dev->mt76, vif, sta), 0);
+
+	ctx.dev = ndev;
+	KUNIT_EXPECT_EQ(test, mt7915_net_fill_forward_path(hw2, vif, sta,
+			&ctx, &path), -ENODEV);
+	KUNIT_EXPECT_PTR_EQ(test, ctx.dev, ndev);
+
+	mt76_test_wed_init(test, &dev->mt76.mmio.wed)->wed->wdma_idx = 1;
+	KUNIT_EXPECT_EQ(test, mt7915_net_fill_forward_path(hw2, vif, sta,
+			&ctx, &path), 0);
+	KUNIT_EXPECT_EQ(test, path.type, DEV_PATH_MTK_WDMA);
+	KUNIT_EXPECT_PTR_EQ(test, path.dev, ndev);
+	KUNIT_EXPECT_EQ(test, path.mtk_wdma.wdma_idx, 1);
+	KUNIT_EXPECT_EQ(test, path.mtk_wdma.bss,
+			mt7915_main_test_mvif(vif)->mt76.idx);
+	KUNIT_EXPECT_EQ(test, path.mtk_wdma.queue, MT_BAND1);
+	KUNIT_EXPECT_EQ(test, path.mtk_wdma.wcid, 0x3ff);
+	KUNIT_EXPECT_NULL(test, ctx.dev);
+
+	ctx.dev = ndev;
+	set_bit(MT_WCID_FLAG_4ADDR, &msta->wcid.flags);
+	KUNIT_EXPECT_EQ(test, mt7915_net_fill_forward_path(hw2, vif, sta,
+			&ctx, &path), 0);
+	KUNIT_EXPECT_EQ(test, path.mtk_wdma.wcid, msta->wcid.idx);
+
+	ctx.dev = ndev;
+	idx = msta->wcid.idx;
+	msta->wcid.idx = MT7915_WTBL_STA + 1;
+	KUNIT_EXPECT_EQ(test, mt7915_net_fill_forward_path(hw2, vif, sta,
+			&ctx, &path), -EIO);
+	KUNIT_EXPECT_PTR_EQ(test, ctx.dev, ndev);
+	msta->wcid.idx = idx;
+}
