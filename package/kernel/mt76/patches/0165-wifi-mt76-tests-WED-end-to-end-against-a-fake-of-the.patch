 static struct kunit_case mt76_wed_test_cases[] = {
 	KUNIT_CASE(mt76_wed_test_no_wed),
 	KUNIT_CASE(mt76_wed_test_offload_enable),
 	KUNIT_CASE(mt76_wed_test_offload_enable_busy),
+	KUNIT_CASE(mt76_wed_test_rx_buf),
+	KUNIT_CASE(mt76_wed_test_rx_buf_no_tokens),
+	KUNIT_CASE(mt76_wed_test_dma_setup_none),
+	KUNIT_CASE(mt76_wed_test_dma_setup_rings),
+	KUNIT_CASE(mt76_wed_test_dma_setup_rro),
+	KUNIT_CASE(mt76_wed_test_dma_reset),
+	KUNIT_CASE(mt76_wed_test_setup_tc),
+	KUNIT_CASE(mt76_wed_test_tokens),
+	KUNIT_CASE(mt76_wed_test_status_id),
 	{}
 };
 
