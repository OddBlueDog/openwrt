new file mode 100644
index 00000000..bb2d0cae
--- /dev/null
+++ b/tests/wed-fake.h
@@ -0,0 +1,312 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/*
+ * A fake WED (Wireless Ethernet Dispatch) for mt76's KUnit tests
+ * (milkflint's QEMU test build only; included by the tests' *-test.c files).
+ *
+ * mtk_wed_device_active() only asks whether a WED device has ops: with this
+ * file's, the driver takes its WED paths against a model of the Ethernet
+ * driver's side (drivers/net/ethernet/mediatek/mtk_wed.c) that records what
+ * it is asked and answers as the test says:
+ *
+ * - attach, as mtk_wed_attach() does: drops the RCU read lock
+ *   mtk_wed_device_attach() took, then hands the WLAN driver the WED's
+ *   device (for DMA), interrupt, index and version;
+ * - detach clears the whole WED device, as __mtk_wed_detach() does;
+ * - a ring setup gives the ring its register base in the WED's own register
+ *   file (regs), which the ring's Q_READ()/Q_WRITE() then reach through
+ *   reg_read/reg_write;
+ * - everything else is counted.
+ *
+ * mt76_test_wed_init() gives a WED device the fake's ops directly (attached,
+ * as far as the driver can tell); mt76_test_wed_publish() registers them
+ * where mtk_wed_device_attach() looks, mtk_soc_wed_ops (tests/wed-test.c
+ * defines it, standing in for the Ethernet driver). One fake at a time, one
+ * global per file, gone when the test ends.
+ */
+#ifndef __MT76_TEST_WED_FAKE_H
+#define __MT76_TEST_WED_FAKE_H
+
+#include <kunit/test.h>
+#include <linux/soc/mediatek/mtk_wed.h>
+#include <linux/xarray.h>
+
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+
+/* where a ring's registers start in the WED's register file */
+#define MT76_TEST_WED_TX_REGS(n)	(0x300 + (n) * 0x10)
+#define MT76_TEST_WED_RX_REGS(n)	(0x500 + (n) * 0x10)
+#define MT76_TEST_WED_TXFREE_REGS	0x700
+
+struct mt76_test_wed {
+	struct kunit *test;
+	struct mtk_wed_device *wed;
+	struct mtk_wed_ops ops;		/* the WED's: a test may swap one */
+	struct xarray regs;		/* register offset -> value */
+	bool published;
+
+	/* what the calls return */
+	int attach_ret;
+	int tx_ring_ret, rx_ring_ret, txfree_ret;
+	int msg_ret, setup_tc_ret;
+	u32 irq_pending;		/* what irq_get reports, then clears */
+
+	/* what attach hands the WLAN driver */
+	struct device *dev;
+	int irq;
+	u8 version;
+	int wdma_idx;
+
+	/* what was asked */
+	int n_attach, n_detach, n_tx_ring, n_rx_ring, n_txfree;
+	int n_msg, n_start, n_stop, n_reset_dma, n_irq_get, n_set_mask;
+	int n_setup_tc, n_ppe_check, n_rro_rx, n_msdu_pg, n_ind;
+	int last_tx_ring, last_rx_ring, last_msg;
+	bool last_reset;
+	u32 start_mask, irq_mask;
+};
+
+static struct mt76_test_wed *mt76_test_wed __maybe_unused;
+
+static inline int mt76_test_wed_attach(struct mtk_wed_device *wed)
+	__releases(RCU)
+{
+	struct mt76_test_wed *w = mt76_test_wed;
+
+	rcu_read_unlock();
+	w->n_attach++;
+	if (w->attach_ret)
+		return w->attach_ret;
+
+	w->wed = wed;
+	wed->dev = w->dev;
+	wed->irq = w->irq;
+	wed->wdma_idx = w->wdma_idx;
+	wed->version = w->version;
+	return 0;
+}
+
+static inline void mt76_test_wed_detach(struct mtk_wed_device *wed)
+{
+	mt76_test_wed->n_detach++;
+	memset(wed, 0, sizeof(*wed));
+}
+
+static inline int mt76_test_wed_tx_ring(struct mtk_wed_device *wed, int ring,
+					void __iomem *regs, bool reset)
+{
+	struct mt76_test_wed *w = mt76_test_wed;
+
+	w->n_tx_ring++;
+	w->last_tx_ring = ring;
+	w->last_reset = reset;
+	if (w->tx_ring_ret)
+		return w->tx_ring_ret;
+	wed->tx_ring[ring].reg_base = MT76_TEST_WED_TX_REGS(ring);
+	return 0;
+}
+
+static inline int mt76_test_wed_rx_ring(struct mtk_wed_device *wed, int ring,
+					void __iomem *regs, bool reset)
+{
+	struct mt76_test_wed *w = mt76_test_wed;
+
+	w->n_rx_ring++;
+	w->last_rx_ring = ring;
+	w->last_reset = reset;
+	if (w->rx_ring_ret)
+		return w->rx_ring_ret;
+	wed->rx_ring[ring].reg_base = MT76_TEST_WED_RX_REGS(ring);
+	return 0;
+}
+
+static inline int mt76_test_wed_txfree_ring(struct mtk_wed_device *wed,
+					    void __iomem *regs)
+{
+	struct mt76_test_wed *w = mt76_test_wed;
+
+	w->n_txfree++;
+	if (w->txfree_ret)
+		return w->txfree_ret;
+	wed->txfree_ring.reg_base = MT76_TEST_WED_TXFREE_REGS;
+	return 0;
+}
+
+static inline int mt76_test_wed_msg(struct mtk_wed_device *wed, int cmd_id,
+				    void *data, int len)
+{
+	struct mt76_test_wed *w = mt76_test_wed;
+
+	w->n_msg++;
+	w->last_msg = cmd_id;
+	return w->msg_ret;
+}
+
+static inline void mt76_test_wed_ppe_check(struct mtk_wed_device *wed,
+					   struct sk_buff *skb, u32 reason,
+					   u32 hash)
+{
+	mt76_test_wed->n_ppe_check++;
+}
+
+static inline void mt76_test_wed_stop(struct mtk_wed_device *wed)
+{
+	mt76_test_wed->n_stop++;
+}
+
+static inline void mt76_test_wed_start(struct mtk_wed_device *wed, u32 mask)
+{
+	mt76_test_wed->n_start++;
+	mt76_test_wed->start_mask = mask;
+}
+
+static inline void mt76_test_wed_reset_dma(struct mtk_wed_device *wed)
+{
+	mt76_test_wed->n_reset_dma++;
+}
+
+static inline u32 mt76_test_wed_reg_read(struct mtk_wed_device *wed, u32 reg)
+{
+	void *v = xa_load(&mt76_test_wed->regs, reg);
+
+	return v ? xa_to_value(v) : 0;
+}
+
+static inline void mt76_test_wed_reg_write(struct mtk_wed_device *wed,
+					   u32 reg, u32 val)
+{
+	struct xarray *regs = &mt76_test_wed->regs;
+	unsigned long flags;
+
+	/* from any context, as fake.h's register file (same lock class) */
+	xa_lock_irqsave(regs, flags);
+	__xa_store(regs, reg, xa_mk_value(val), GFP_ATOMIC);
+	xa_unlock_irqrestore(regs, flags);
+}
+
+static inline u32 mt76_test_wed_irq_get(struct mtk_wed_device *wed, u32 mask)
+{
+	struct mt76_test_wed *w = mt76_test_wed;
+	u32 val = w->irq_pending & mask;
+
+	w->n_irq_get++;
+	w->irq_pending &= ~val;
+	return val;
+}
+
+static inline void mt76_test_wed_irq_set_mask(struct mtk_wed_device *wed,
+					      u32 mask)
+{
+	mt76_test_wed->n_set_mask++;
+	mt76_test_wed->irq_mask = mask;
+}
+
+static inline int mt76_test_wed_setup_tc(struct mtk_wed_device *wed,
+					 struct net_device *dev,
+					 enum tc_setup_type type,
+					 void *type_data)
+{
+	mt76_test_wed->n_setup_tc++;
+	return mt76_test_wed->setup_tc_ret;
+}
+
+static inline void mt76_test_wed_rro_rx_ring(struct mtk_wed_device *wed,
+					     int ring, void __iomem *regs)
+{
+	mt76_test_wed->n_rro_rx++;
+}
+
+static inline void mt76_test_wed_msdu_pg_ring(struct mtk_wed_device *wed,
+					      int ring, void __iomem *regs)
+{
+	mt76_test_wed->n_msdu_pg++;
+}
+
+static inline int mt76_test_wed_ind_ring(struct mtk_wed_device *wed,
+					 void __iomem *regs)
+{
+	mt76_test_wed->n_ind++;
+	return 0;
+}
+
+static inline void mt76_test_wed_free(void *data)
+{
+	struct mt76_test_wed *w = data;
+
+	if (w->published) {
+		RCU_INIT_POINTER(mtk_soc_wed_ops, NULL);
+		synchronize_rcu();
+	}
+	/* still attached: the driver doesn't see the fake's ops any more */
+	if (w->wed && w->wed->ops == &w->ops)
+		w->wed->ops = NULL;
+	xa_destroy(&w->regs);
+	if (mt76_test_wed == w)
+		mt76_test_wed = NULL;
+}
+
+/* a fresh fake WED, a version 2 one (the MT7986's), not attached yet */
+static inline struct mt76_test_wed *mt76_test_wed_new(struct kunit *test)
+{
+	struct mt76_test_wed *w;
+
+	w = kunit_kzalloc(test, sizeof(*w), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, w);
+	w->test = test;
+	w->version = 2;
+	w->irq = 77;
+	xa_init_flags(&w->regs, XA_FLAGS_LOCK_IRQ);
+	w->ops = (struct mtk_wed_ops) {
+		.attach = mt76_test_wed_attach,
+		.tx_ring_setup = mt76_test_wed_tx_ring,
+		.rx_ring_setup = mt76_test_wed_rx_ring,
+		.txfree_ring_setup = mt76_test_wed_txfree_ring,
+		.msg_update = mt76_test_wed_msg,
+		.detach = mt76_test_wed_detach,
+		.ppe_check = mt76_test_wed_ppe_check,
+		.stop = mt76_test_wed_stop,
+		.start = mt76_test_wed_start,
+		.reset_dma = mt76_test_wed_reset_dma,
+		.reg_read = mt76_test_wed_reg_read,
+		.reg_write = mt76_test_wed_reg_write,
+		.irq_get = mt76_test_wed_irq_get,
+		.irq_set_mask = mt76_test_wed_irq_set_mask,
+		.setup_tc = mt76_test_wed_setup_tc,
+		.rro_rx_ring_setup = mt76_test_wed_rro_rx_ring,
+		.msdu_pg_rx_ring_setup = mt76_test_wed_msdu_pg_ring,
+		.ind_rx_ring_setup = mt76_test_wed_ind_ring,
+	};
+	mt76_test_wed = w;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_test_wed_free, w), 0);
+	return w;
+}
+
+/* @wed attached to the fake, as far as the driver can tell */
+static inline struct mt76_test_wed *
+mt76_test_wed_init(struct kunit *test, struct mtk_wed_device *wed)
+{
+	struct mt76_test_wed *w = mt76_test_wed_new(test);
+
+	w->wed = wed;
+	wed->ops = &w->ops;
+	wed->version = w->version;
+	wed->irq = w->irq;
+	return w;
+}
+
+/* the fake, where mtk_wed_device_attach() finds a WED */
+static inline void mt76_test_wed_publish(struct mt76_test_wed *w)
+{
+	rcu_assign_pointer(mtk_soc_wed_ops, &w->ops);
+	w->published = true;
+}
+
+/* a value in the WED's register file */
+static inline u32 mt76_test_wed_reg(struct mt76_test_wed *w, u32 reg)
+{
+	return mt76_test_wed_reg_read(w->wed, reg);
+}
+
+#endif /* CONFIG_NET_MEDIATEK_SOC_WED */
+
+#endif
