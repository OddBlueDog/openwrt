+/* --- the rx buffers WED keeps for the host --------------------------------- */
+
+/* The device's DMA setup, as a test needs it for page pools */
+static void mt76_wed_test_dma(struct kunit *test, struct mt76_dev *dev)
+{
+	KUNIT_ASSERT_EQ(test, dma_coerce_mask_and_coherent(dev->dma_dev,
+			DMA_BIT_MASK(32)), 0);
+}
+
+static void mt76_wed_test_pool_destroy(void *data)
+{
+	struct mt76_queue *q = data;
+
+	page_pool_destroy(q->page_pool);
+	q->page_pool = NULL;
+}
+
+/* rx queue @qid with a page pool of buffers of @buf_size bytes and its NAPI
+ * parked, as netif_napi_add() leaves it (the pool links to it)
+ */
+static struct mt76_queue *mt76_wed_test_rxq(struct kunit *test,
+					    struct mt76_dev *dev,
+					    enum mt76_rxq_id qid, int buf_size)
+{
+	struct mt76_queue *q = &dev->q_rx[qid];
+	struct napi_struct *napi = &dev->napi[qid];
+
+	set_bit(NAPI_STATE_SCHED, &napi->state);
+	WRITE_ONCE(napi->list_owner, -1);
+	q->ndesc = 8;
+	q->buf_size = buf_size;
+	KUNIT_ASSERT_EQ(test, mt76_create_page_pool(dev, q), 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_wed_test_pool_destroy, q), 0);
+	return q;
+}
+
+/* the page pool rx buffer @buf came from */
+static struct page_pool *mt76_wed_test_pool(void *buf)
+{
+	return virt_to_head_page(buf)->pp;
+}
+
+/* the token in WED rx buffer descriptor @d */
+static int mt76_wed_test_desc_token(const struct mtk_wed_bm_desc *d)
+{
+	return FIELD_GET(MT_DMA_CTL_TOKEN, le32_to_cpu(d->token));
+}
+
+/* WED's rx buffer ring, filled by the host: a buffer of the main rx queue's
+ * page pool per descriptor, registered as an rx token, its address and token
+ * in the descriptor. Released, every token goes and every buffer is back in
+ * its pool, the rxwi with them. On WED version 2 with the main phy on band 1
+ * the buffers come from band 1's queue.
+ */
+static void mt76_wed_test_rx_buf(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_wed_test_dev(test);
+	struct mtk_wed_device *wed = &dev->mmio.wed;
+	struct mtk_wed_bm_desc *desc;
+	struct mt76_queue *q, *q1;
+	int i;
+
+	mt76_wed_test_dma(test, dev);
+	mt76_test_wed_init(test, wed);
+	q = mt76_wed_test_rxq(test, dev, MT_RXQ_MAIN, 2048);
+	q1 = mt76_wed_test_rxq(test, dev, MT_RXQ_BAND1, 2048);
+	dev->rx_token_size = 16;
+	desc = kunit_kcalloc(test, 8, sizeof(*desc), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, desc);
+	wed->rx_buf_ring.desc = desc;
+
+	KUNIT_ASSERT_EQ(test, mt76_wed_init_rx_buf(wed, 8), 0);
+	for (i = 0; i < 8; i++) {
+		struct mt76_txwi_cache *t;
+
+		t = idr_find(&dev->rx_token, mt76_wed_test_desc_token(&desc[i]));
+		KUNIT_ASSERT_NOT_NULL_MSG(test, t, "descriptor %d", i);
+		KUNIT_ASSERT_NOT_NULL(test, t->ptr);
+		KUNIT_EXPECT_PTR_EQ(test, mt76_wed_test_pool(t->ptr),
+				    q->page_pool);
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(desc[i].buf0),
+				lower_32_bits(t->dma_addr));
+	}
+
+	mt76_wed_release_rx_buf(wed);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&dev->rx_token));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->rxwi_cache));
+
+	memset(desc, 0, 8 * sizeof(*desc));
+	dev->phy.band_idx = MT_BAND1;
+	KUNIT_ASSERT_EQ(test, mt76_wed_init_rx_buf(wed, 2), 0);
+	for (i = 0; i < 2; i++) {
+		struct mt76_txwi_cache *t;
+
+		t = idr_find(&dev->rx_token, mt76_wed_test_desc_token(&desc[i]));
+		KUNIT_ASSERT_NOT_NULL(test, t);
+		KUNIT_EXPECT_PTR_EQ(test, mt76_wed_test_pool(t->ptr),
+				    q1->page_pool);
+	}
+	mt76_wed_release_rx_buf(wed);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&dev->rx_token));
+}
+
+/* More buffers asked for than there are rx tokens: the fill fails, and
+ * what it had registered is released again, nothing kept.
+ */
+static void mt76_wed_test_rx_buf_no_tokens(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_wed_test_dev(test);
+	struct mtk_wed_device *wed = &dev->mmio.wed;
+
+	mt76_wed_test_dma(test, dev);
+	mt76_test_wed_init(test, wed);
+	mt76_wed_test_rxq(test, dev, MT_RXQ_MAIN, 2048);
+	dev->rx_token_size = 4;
+	wed->rx_buf_ring.desc = kunit_kcalloc(test, 8,
+					      sizeof(*wed->rx_buf_ring.desc),
+					      GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wed->rx_buf_ring.desc);
+
+	KUNIT_EXPECT_EQ(test, mt76_wed_init_rx_buf(wed, 8), -ENOMEM);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&dev->rx_token));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->rxwi_cache));
+}
+
+/* --- rings ------------------------------------------------------------------ */
+
+/* a queue of @ndesc descriptors in memory, flagged @flags, on the device's
+ * WED
+ */
+static struct mt76_queue *mt76_wed_test_queue(struct kunit *test,
+					      struct mt76_dev *dev, u16 flags)
+{
+	struct mt76_queue *q = kunit_kzalloc(test, sizeof(*q), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, q);
+	q->ndesc = 4;
+	q->desc = kunit_kcalloc(test, q->ndesc, sizeof(*q->desc), GFP_KERNEL);
+	q->entry = kunit_kcalloc(test, q->ndesc, sizeof(*q->entry), GFP_KERNEL);
+	q->regs = (void __force __iomem *)kunit_kzalloc(test,
+			sizeof(struct mt76_queue_regs), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, q->desc);
+	KUNIT_ASSERT_NOT_NULL(test, q->entry);
+	KUNIT_ASSERT_NOT_NULL(test, (void __force *)q->regs);
+	q->flags = flags;
+	q->wed = &dev->mmio.wed;
+	return q;
+}
+
+/* A queue WED doesn't take: none there, no WED attached, or no WED flag; it
+ * is the host's, its WED flag dropped.
+ */
+static void mt76_wed_test_dma_setup_none(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_wed_test_dev(test);
+	struct mt76_queue *q = mt76_wed_test_queue(test, dev, MT_WED_Q_TX(0));
+	struct mt76_queue empty = {};
+
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, NULL, false), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, &empty, false), -EINVAL);
+
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, q, false), 0);
+	KUNIT_EXPECT_FALSE(test, q->flags & MT_QFLAG_WED);
+
+	mt76_test_wed_init(test, &dev->mmio.wed);
+	q->flags = MT_WED_Q_TX(0);
+	q->wed = NULL;
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, q, false), 0);
+	KUNIT_EXPECT_FALSE(test, q->flags & MT_QFLAG_WED);
+}
+
+/* WED takes a tx or rx ring over by its number: the queue's registers are
+ * WED's from then on; a ring WED refuses keeps none. A type WED doesn't
+ * have is refused.
+ */
+static void mt76_wed_test_dma_setup_rings(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_wed_test_dev(test);
+	struct mt76_test_wed *w = mt76_test_wed_init(test, &dev->mmio.wed);
+	struct mt76_queue *q;
+
+	q = mt76_wed_test_queue(test, dev, MT_WED_Q_TX(1));
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, q, true), 0);
+	KUNIT_EXPECT_EQ(test, w->n_tx_ring, 1);
+	KUNIT_EXPECT_EQ(test, w->last_tx_ring, 1);
+	KUNIT_EXPECT_TRUE(test, w->last_reset);
+	KUNIT_EXPECT_EQ(test, q->wed_regs, MT76_TEST_WED_TX_REGS(1));
+	KUNIT_EXPECT_EQ(test, q->flags, MT_WED_Q_TX(1));
+	/* its registers are WED's now */
+	Q_WRITE(q, cpu_idx, 3);
+	KUNIT_EXPECT_EQ(test, mt76_test_wed_reg(w, MT76_TEST_WED_TX_REGS(1) +
+			offsetof(struct mt76_queue_regs, cpu_idx)), 3);
+	KUNIT_EXPECT_EQ(test, readl(&q->regs->cpu_idx), 0);
+
+	q = mt76_wed_test_queue(test, dev, MT_WED_Q_TX(0));
+	w->tx_ring_ret = -ENOMEM;
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, q, false), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, q->wed_regs, 0);
+
+	q = mt76_wed_test_queue(test, dev, MT_WED_Q_RX(1));
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, q, false), 0);
+	KUNIT_EXPECT_EQ(test, w->last_rx_ring, 1);
+	KUNIT_EXPECT_FALSE(test, w->last_reset);
+	KUNIT_EXPECT_EQ(test, q->wed_regs, MT76_TEST_WED_RX_REGS(1));
+
+	q = mt76_wed_test_queue(test, dev, MT_WED_Q_RX(0));
+	w->rx_ring_ret = -EBUSY;
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, q, false), -EBUSY);
+	KUNIT_EXPECT_EQ(test, q->wed_regs, 0);
+
+	q = mt76_wed_test_queue(test, dev, __MT_WED_Q(7, 0));
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, q, false), -EINVAL);
+	KUNIT_EXPECT_EQ(test, q->flags, __MT_WED_Q(7, 0));
+}
+
+/* WED version 3's reorder rings (not the MT7986's): the host resets them
+ * itself, as full rings handed to the hardware, and WED is told where they
+ * are.
+ */
+static void mt76_wed_test_dma_setup_rro(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_wed_test_dev(test);
+	struct mt76_test_wed *w = mt76_test_wed_init(test, &dev->mmio.wed);
+	struct mt76_queue *q;
+	u16 flags;
+
+	flags = MT_WED_RRO_Q_DATA(1);
+	q = mt76_wed_test_queue(test, dev, flags);
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, q, false), 0);
+	KUNIT_EXPECT_EQ(test, w->n_rro_rx, 1);
+	KUNIT_EXPECT_EQ(test, q->head, q->ndesc - 1);
+	KUNIT_EXPECT_EQ(test, q->queued, q->ndesc - 1);
+	KUNIT_EXPECT_EQ(test, q->flags, flags);
+	/* written by the host, not through WED */
+	KUNIT_EXPECT_EQ(test, readl(&q->regs->ring_size), q->ndesc);
+
+	flags = MT_WED_RRO_Q_MSDU_PG(2);
+	q = mt76_wed_test_queue(test, dev, flags);
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, q, false), 0);
+	KUNIT_EXPECT_EQ(test, w->n_msdu_pg, 1);
+	KUNIT_EXPECT_EQ(test, q->head, q->ndesc - 1);
+	KUNIT_EXPECT_EQ(test, q->flags, flags);
+}
+
+/* --- reset, offload ----------------------------------------------------------- */
+
+/* The DMA reset handshake with the Ethernet driver's WED reset: only while
+ * one is on (MT76_STATE_WED_RESET), the host says its DMA is reset and waits
+ * for WED to say it's done (mt76_wed_reset_complete()).
+ */
+static void mt76_wed_test_dma_reset(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_wed_test_dev(test);
+	struct mt76_mmio *mmio = &dev->mmio;
+
+	init_completion(&mmio->wed_reset);
+	init_completion(&mmio->wed_reset_complete);
+
+	mt76_wed_dma_reset(dev);
+	KUNIT_EXPECT_FALSE(test, completion_done(&mmio->wed_reset));
+
+	set_bit(MT76_STATE_WED_RESET, &dev->phy.state);
+	mt76_wed_reset_complete(&mmio->wed);
+	mt76_wed_dma_reset(dev);
+	KUNIT_EXPECT_TRUE(test, completion_done(&mmio->wed_reset));
+	/* the one completion consumed by the wait */
+	KUNIT_EXPECT_FALSE(test, completion_done(&mmio->wed_reset_complete));
+	clear_bit(MT76_STATE_WED_RESET, &dev->phy.state);
+}
+
+/* A traffic control (flow offload) setup goes to WED, or is refused when
+ * there's none.
+ */
+static void mt76_wed_test_setup_tc(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_wed_test_dev(test);
+	struct mt76_test_wed *w;
+
+	KUNIT_EXPECT_EQ(test, mt76_wed_net_setup_tc(dev->hw, NULL, NULL,
+			TC_SETUP_BLOCK, NULL), -EOPNOTSUPP);
+
+	w = mt76_test_wed_init(test, &dev->mmio.wed);
+	KUNIT_EXPECT_EQ(test, mt76_wed_net_setup_tc(dev->hw, NULL, NULL,
+			TC_SETUP_BLOCK, NULL), 0);
+	w->setup_tc_ret = -EBUSY;
+	KUNIT_EXPECT_EQ(test, mt76_wed_net_setup_tc(dev->hw, NULL, NULL,
+			TC_SETUP_BLOCK, NULL), -EBUSY);
+	KUNIT_EXPECT_EQ(test, w->n_setup_tc, 2);
+}
+
+/* --- tokens and tx status ----------------------------------------------------- */
+
+static struct mt76_txwi_cache *mt76_wed_test_txwi(struct kunit *test)
+{
+	struct mt76_txwi_cache *t = kunit_kzalloc(test, sizeof(*t), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, t);
+	t->qid = MT_TXQ_BE;
+	return t;
+}
+
+/* With a WED attached the host counts the frames it sent with tokens of
+ * WED's half (from token_start on), for mt76_wed_offload_enable() to wait
+ * until the last of them is back.
+ */
+static void mt76_wed_test_tokens(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_wed_test_dev(test);
+	struct mt76_txwi_cache *t[2];
+	int token[2];
+
+	mt76_test_wed_init(test, &dev->mmio.wed);
+	t[0] = mt76_wed_test_txwi(test);
+	t[1] = mt76_wed_test_txwi(test);
+
+	/* the host's half: not counted */
+	token[0] = mt76_token_consume(dev, &t[0]);
+	KUNIT_EXPECT_EQ(test, token[0], 0);
+	KUNIT_EXPECT_EQ(test, dev->wed_token_count, 0);
+
+	/* one of WED's (the host's own half all taken) */
+	dev->token_start = MT76_WED_TEST_START;
+	token[1] = mt76_token_consume(dev, &t[1]);
+	KUNIT_EXPECT_EQ(test, token[1], MT76_WED_TEST_START);
+	KUNIT_EXPECT_EQ(test, dev->wed_token_count, 1);
+	KUNIT_EXPECT_EQ(test, dev->token_count, 2);
+
+	KUNIT_EXPECT_PTR_EQ(test, mt76_token_release(dev, token[1], NULL),
+			    t[1]);
+	KUNIT_EXPECT_EQ(test, dev->wed_token_count, 0);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_token_release(dev, token[0], NULL),
+			    t[0]);
+	KUNIT_EXPECT_EQ(test, dev->wed_token_count, 0);
+	KUNIT_EXPECT_EQ(test, dev->token_count, 0);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&dev->token));
+}
+
+/* A data frame without a status request goes through WED without a packet
+ * id the host tracks: MT_PACKET_ID_WED, whether 802.3 or 802.11; anything
+ * else without a request gets none at all.
+ */
+static void mt76_wed_test_status_id(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_wed_test_dev(test);
+	struct mt76_wcid wcid = {};
+	struct ieee80211_hdr *hdr;
+	struct sk_buff *skb;
+
+	skb = alloc_skb(64, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	hdr = skb_put_zero(skb, 24);
+	hdr->frame_control = cpu_to_le16(IEEE80211_FTYPE_DATA |
+					 IEEE80211_STYPE_QOS_DATA);
+
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, &wcid, skb),
+			MT_PACKET_ID_NO_SKB);
+	mt76_test_wed_init(test, &dev->mmio.wed);
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, &wcid, skb),
+			MT_PACKET_ID_WED);
+
+	hdr->frame_control = cpu_to_le16(IEEE80211_FTYPE_MGMT |
+					 IEEE80211_STYPE_ACTION);
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, &wcid, skb),
+			MT_PACKET_ID_NO_SKB);
+	IEEE80211_SKB_CB(skb)->flags |= IEEE80211_TX_CTL_HW_80211_ENCAP;
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, &wcid, skb),
+			MT_PACKET_ID_WED);
+	kfree_skb(skb);
+}
