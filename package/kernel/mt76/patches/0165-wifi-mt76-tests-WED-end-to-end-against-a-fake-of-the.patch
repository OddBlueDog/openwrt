+/* The tx buffers WED sends from on the host's behalf (its token half): one
+ * cut-through 802.3 descriptor each, its single buffer right after the
+ * descriptor and the txp, tagged with the WED's token. The rest of both is
+ * zeroed.
+ */
+static void mt7915_test_wed_init_buf(struct kunit *test)
+{
+	struct mt76_connac_fw_txp *txp;
+	dma_addr_t phys = 0x40001000;
+	__le32 *txwi;
+	u8 *buf;
+	u32 len;
+
+	buf = kunit_kmalloc(test, 256, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, buf);
+	memset(buf, 0xff, 256);
+	txwi = (__le32 *)buf;
+	txp = (void *)(buf + MT_TXD_SIZE);
+
+	len = mt7915_wed_init_buf(buf, phys, 4097);
+	KUNIT_EXPECT_EQ(test, len, MT_TXD_SIZE + sizeof(*txp));
+	KUNIT_EXPECT_EQ(test, le32_get_bits(txwi[0], MT_TXD0_TX_BYTES),
+			MT_TXD_SIZE);
+	KUNIT_EXPECT_EQ(test, le32_get_bits(txwi[0], MT_TXD0_PKT_FMT),
+			MT_TX_TYPE_CT);
+	KUNIT_EXPECT_TRUE(test, le32_to_cpu(txwi[1]) & MT_TXD1_LONG_FORMAT);
+	KUNIT_EXPECT_EQ(test, le32_get_bits(txwi[1], MT_TXD1_HDR_FORMAT),
+			MT_HDR_FORMAT_802_3);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txp->token), 4097);
+	KUNIT_EXPECT_EQ(test, txp->nbuf, 1);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(txp->buf[0]), phys + len);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(txwi[2]), 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txp->len[0]), 0);
+	/* nothing past them touched */
+	KUNIT_EXPECT_EQ(test, buf[len], 0xff);
+}
+
