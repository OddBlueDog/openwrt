+	KUNIT_CASE(mt7915_dma_test_start_hif2),
+	KUNIT_CASE(mt7915_dma_test_enable),
+	KUNIT_CASE(mt7915_dma_test_mt7915),
+	KUNIT_CASE(mt7915_dma_test_lifecycle),
+	KUNIT_CASE(mt7915_dma_test_dbdc_reset),
+	KUNIT_CASE(mt7915_dma_test_reset_force),
+	{}
+};
+
+static struct kunit_suite mt7915_dma_test_suite = {
+	.name = "mt7915-dma",
+	.test_cases = mt7915_dma_test_cases,
+};
+
+kunit_test_suites(&mt7915_dma_test_suite);
diff --git a/mt7915/tests/eeprom-test.c b/mt7915/tests/eeprom-test.c
new file mode 100644
index 00000000..ab90c254
--- /dev/null
+++ b/mt7915/tests/eeprom-test.c
@@ -0,0 +1,738 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for the mt7915 EEPROM code on the MT7986: loading it from
+ * efuse (through firmware queries) or the device tree, checking it, and
+ * parsing the bands, antennas and tx power out of it. Included at the end of
+ * mt7915/eeprom.c when CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU
+ * test build only).
+ *
+ * The efuse is an image behind the fake firmware: EFUSE_FREE_BLOCK and
+ * EFUSE_ACCESS queries are answered from it. The few chip checks that only
+ * look at dev->mt76.rev are also run for the other chips, by switching the
+ * revision for the duration of the call.
+ */
+#include <kunit/test.h>
+#include <linux/of.h>
+#include "../mcu.h"
+#include "fake.h"
+
+/* MT_CONNINFRA_SKU_DEC_ADDR, where the A-die SKU lives, in the window */
+#define MT7915_EEPROM_TEST_SKU	(MT_CONNINFRA_SKU_DEC_ADDR - MT_INFRA_BASE)
+
+struct mt7915_eeprom_test {
+	u8 efuse[MT7916_EEPROM_SIZE];
+	u8 free_blocks;
+	int bad_addr_at;	/* answer this block read (1: first) out of range */
+	int n_reads;
+};
+
+static void mt7915_eeprom_test_reply(struct mt76_test_fake *fake,
+				     const struct mt76_test_msg *msg,
+				     struct sk_buff *reply)
+{
+	struct mt7915_eeprom_test *e = fake->priv;
+	const struct mt7915_mcu_eeprom_info *req;
+	struct mt7915_mcu_eeprom_info *res;
+	u32 addr;
+
+	if (msg->cmd == MCU_EXT_QUERY(EFUSE_FREE_BLOCK)) {
+		skb_put_u8(reply, e->free_blocks);
+		return;
+	}
+	if (msg->cmd != MCU_EXT_QUERY(EFUSE_ACCESS) ||
+	    msg->len < sizeof(*req))
+		return;
+
+	req = (const void *)msg->data;
+	addr = le32_to_cpu(req->addr);
+	res = skb_put_zero(reply, sizeof(*res));
+	res->addr = req->addr;
+	res->valid = cpu_to_le32(1);
+	if (addr + sizeof(res->data) <= sizeof(e->efuse))
+		memcpy(res->data, e->efuse + addr, sizeof(res->data));
+	if (++e->n_reads == e->bad_addr_at)
+		res->addr = cpu_to_le32(MT7916_EEPROM_SIZE);
+}
+
+/* An MT7986 with an efuse holding a valid MT7986 EEPROM image (chip id,
+ * a MAC address and a recognizable pattern) and room to spare.
+ */
+static struct mt7915_eeprom_test *
+mt7915_eeprom_test_init(struct kunit *test, struct mt7915_dev **pdev)
+{
+	static const u8 mac[ETH_ALEN] = { 0x00, 0x11, 0x22, 0x33, 0x44, 0x55 };
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_eeprom_test *e;
+	int i;
+
+	e = kunit_kzalloc(test, sizeof(*e), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, e);
+	for (i = 0; i < sizeof(e->efuse); i++)
+		e->efuse[i] = i * 7;
+	put_unaligned_le16(0x7986, e->efuse + MT_EE_CHIP_ID);
+	memcpy(e->efuse + MT_EE_MAC_ADDR, mac, ETH_ALEN);
+	/* band 0: 2.4 GHz, 4 tx and rx paths; no precal, no TSSI */
+	e->efuse[MT_EE_WIFI_CONF] = FIELD_PREP(MT_EE_WIFI_CONF0_TX_PATH, 4) |
+				    FIELD_PREP(MT_EE_WIFI_CONF0_RX_PATH, 4);
+	e->efuse[MT_EE_DO_PRE_CAL_V2] = 0;
+	e->efuse[MT_EE_WIFI_CONF + 7] = 0;
+	e->free_blocks = 10;
+
+	fake->priv = e;
+	fake->reply = mt7915_eeprom_test_reply;
+	*pdev = dev;
+	return e;
+}
+
+/* an EEPROM buffer to parse, filled with @fill */
+static u8 *mt7915_eeprom_test_buf(struct kunit *test, struct mt7915_dev *dev,
+				  u8 fill)
+{
+	KUNIT_ASSERT_GE(test, mt76_eeprom_init(&dev->mt76, MT7916_EEPROM_SIZE),
+			0);
+	memset(dev->mt76.eeprom.data, fill, MT7916_EEPROM_SIZE);
+	return dev->mt76.eeprom.data;
+}
+
+static void mt7915_eeprom_test_no_of_node(void *data)
+{
+	struct device *dev = data;
+
+	dev->of_node = NULL;
+}
+
+/* give the device a device-tree node carrying @len bytes of EEPROM data */
+static void mt7915_eeprom_test_dt_eeprom(struct kunit *test,
+					 struct mt7915_dev *dev,
+					 const void *data, int len)
+{
+	struct device_node *np = kunit_kzalloc(test, sizeof(*np), GFP_KERNEL);
+	struct property *pp = kunit_kzalloc(test, sizeof(*pp), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, np);
+	KUNIT_ASSERT_NOT_NULL(test, pp);
+	pp->value = kunit_kzalloc(test, len, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, pp->value);
+	memcpy(pp->value, data, len);
+	pp->length = len;
+	pp->name = "mediatek,eeprom-data";
+	np->name = "wifi";
+	np->full_name = "wifi";
+	np->properties = pp;
+
+	dev->mt76.dev->of_node = np;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_eeprom_test_no_of_node, dev->mt76.dev), 0);
+}
+
+/* --- loading -------------------------------------------------------------- */
+
+/* The chip id at the start of the EEPROM must be the chip's. */
+static void mt7915_eeprom_test_check(struct kunit *test)
+{
+	static const struct {
+		u16 chip, id;
+	} chips[] = {
+		{ 0x7915, 0x7915 }, { 0x7906, 0x7916 },
+		{ 0x7981, 0x7981 }, { 0x7986, 0x7986 },
+	};
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u32 rev = dev->mt76.rev;
+	u8 *eep = mt7915_eeprom_test_buf(test, dev, 0);
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(chips); i++) {
+		dev->mt76.rev = chips[i].chip << 16;
+		for (j = 0; j < ARRAY_SIZE(chips); j++) {
+			put_unaligned_le16(chips[j].id, eep);
+			KUNIT_EXPECT_EQ_MSG(test, mt7915_check_eeprom(dev),
+					    i == j ? 0 : -EINVAL,
+					    "chip %x, id %x", chips[i].chip,
+					    chips[j].id);
+		}
+		put_unaligned_le16(0x1234, eep);
+		KUNIT_EXPECT_EQ(test, mt7915_check_eeprom(dev), -EINVAL);
+	}
+	dev->mt76.rev = rev;
+}
+
+/* The default EEPROM file follows the chip and, on the MT7986, the A-dies
+ * the SKU says are fitted; an unknown SKU has none.
+ */
+static void mt7915_eeprom_test_name(struct kunit *test)
+{
+	static const struct {
+		u32 sku;
+		const char *name;
+	} skus[] = {
+		{ MT7976_ONE_ADIE_DBDC, MT7986_EEPROM_MT7976_DEFAULT_DBDC },
+		{ MT7975_ONE_ADIE, MT7986_EEPROM_MT7975_DEFAULT },
+		{ MT7976_ONE_ADIE, MT7986_EEPROM_MT7976_DEFAULT },
+		{ MT7975_DUAL_ADIE, MT7986_EEPROM_MT7975_DUAL_DEFAULT },
+		{ MT7976_DUAL_ADIE, MT7986_EEPROM_MT7976_DUAL_DEFAULT },
+	};
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u32 rev = dev->mt76.rev;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(skus); i++) {
+		/* the SKU's other bits don't matter */
+		mt76_test_set_reg(fake, MT7915_EEPROM_TEST_SKU,
+				  skus[i].sku | 0xabc0000);
+		KUNIT_EXPECT_STREQ(test, mt7915_eeprom_name(dev), skus[i].name);
+	}
+	mt76_test_set_reg(fake, MT7915_EEPROM_TEST_SKU, 0x3);
+	KUNIT_EXPECT_NULL(test, mt7915_eeprom_name(dev));
+
+	dev->mt76.rev = 0x79150000;
+	KUNIT_EXPECT_STREQ(test, mt7915_eeprom_name(dev), MT7915_EEPROM_DEFAULT);
+	dev->dbdc_support = true;
+	KUNIT_EXPECT_STREQ(test, mt7915_eeprom_name(dev),
+			   MT7915_EEPROM_DEFAULT_DBDC);
+	dev->mt76.rev = 0x79810000;
+	KUNIT_EXPECT_STREQ(test, mt7915_eeprom_name(dev),
+			   MT7981_EEPROM_MT7976_DEFAULT_DBDC);
+	dev->mt76.rev = 0x79060000;
+	KUNIT_EXPECT_STREQ(test, mt7915_eeprom_name(dev), MT7916_EEPROM_DEFAULT);
+	dev->mt76.rev = rev;
+}
+
+/* Without a default file for the SKU nothing is loaded. */
+static void mt7915_eeprom_test_load_default(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 *eep = mt7915_eeprom_test_buf(test, dev, 0x5a);
+
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_load_default(dev), -EINVAL);
+	KUNIT_EXPECT_FALSE(test, dev->flash_mode);
+	KUNIT_EXPECT_EQ(test, eep[0], 0x5a);
+}
+
+/* Without an EEPROM in the device tree it is read from efuse: the free
+ * block count first, then every 16-byte block in order.
+ */
+static void mt7915_eeprom_test_load_efuse(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_eeprom_test *e = mt7915_eeprom_test_init(test, &dev);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	const struct mt7915_mcu_eeprom_info *req;
+	struct mt76_test_msg *msg;
+	int i;
+
+	KUNIT_ASSERT_EQ(test, mt7915_eeprom_load(dev), 0);
+	KUNIT_EXPECT_FALSE(test, dev->flash_mode);
+	KUNIT_EXPECT_EQ(test, dev->mt76.eeprom.size, MT7916_EEPROM_SIZE);
+	KUNIT_EXPECT_MEMEQ(test, dev->mt76.eeprom.data, e->efuse,
+			   MT7916_EEPROM_SIZE);
+
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 1 + MT7916_EEPROM_SIZE / 16);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_QUERY(EFUSE_FREE_BLOCK));
+	KUNIT_ASSERT_EQ(test, msg->len, 4);
+	KUNIT_EXPECT_EQ(test, msg->data[1], 1);	/* version */
+	for (i = 1; i < fake->n_msgs; i++) {
+		msg = mt76_test_msg(fake, i);
+		KUNIT_ASSERT_EQ(test, msg->cmd, MCU_EXT_QUERY(EFUSE_ACCESS));
+		req = mt7915_test_payload(msg, struct mt7915_mcu_eeprom_info);
+		KUNIT_ASSERT_NOT_NULL(test, req);
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(req->addr), (i - 1) * 16);
+	}
+}
+
+/* Reading efuse fails if it isn't programmed enough, if the firmware
+ * fails, if it answers for an address past the EEPROM, or if what it holds
+ * isn't an MT7986 EEPROM.
+ */
+static void mt7915_eeprom_test_load_efuse_errors(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_eeprom_test *e = mt7915_eeprom_test_init(test, &dev);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	e->free_blocks = 29;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_load(dev), -EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+	e->free_blocks = 10;
+
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_load(dev), -EIO);
+	fake->mcu_ret = 0;
+
+	fake->n_msgs = 0;
+	e->bad_addr_at = 3;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_load(dev), -EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1 + 3);
+	e->bad_addr_at = 0;
+
+	put_unaligned_le16(0x7981, e->efuse);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_load(dev), -EINVAL);
+}
+
+/* An EEPROM in the device tree is used as is (flash mode), with no
+ * firmware queries.
+ */
+static void mt7915_eeprom_test_load_dt(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_eeprom_test *e = mt7915_eeprom_test_init(test, &dev);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	mt7915_eeprom_test_dt_eeprom(test, dev, e->efuse, sizeof(e->efuse));
+	KUNIT_ASSERT_EQ(test, mt7915_eeprom_load(dev), 0);
+	KUNIT_EXPECT_TRUE(test, dev->flash_mode);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	KUNIT_EXPECT_MEMEQ(test, dev->mt76.eeprom.data, e->efuse,
+			   MT7916_EEPROM_SIZE);
+}
+
+/* Init loads the EEPROM, takes band 0's capabilities and the MAC address
+ * from it.
+ */
+static void mt7915_eeprom_test_init_efuse(struct kunit *test)
+{
+	static const u8 mac[ETH_ALEN] = { 0x00, 0x11, 0x22, 0x33, 0x44, 0x55 };
+	struct mt7915_dev *dev;
+
+	mt7915_eeprom_test_init(test, &dev);
+	KUNIT_ASSERT_EQ(test, mt7915_eeprom_init(dev), 0);
+	KUNIT_EXPECT_MEMEQ(test, dev->mphy.macaddr, mac, ETH_ALEN);
+	KUNIT_EXPECT_TRUE(test, dev->mphy.cap.has_2ghz);
+	KUNIT_EXPECT_FALSE(test, dev->mphy.cap.has_5ghz);
+	KUNIT_EXPECT_EQ(test, dev->mphy.chainmask, 0xf);
+	KUNIT_EXPECT_EQ(test, dev->mphy.antenna_mask, 0xf);
+	KUNIT_EXPECT_NULL(test, dev->cal);
+}
+
+/* An EEPROM without a usable MAC address gets a random valid one. */
+static void mt7915_eeprom_test_init_no_mac(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_eeprom_test *e = mt7915_eeprom_test_init(test, &dev);
+
+	eth_zero_addr(e->efuse + MT_EE_MAC_ADDR);
+	KUNIT_ASSERT_EQ(test, mt7915_eeprom_init(dev), 0);
+	KUNIT_EXPECT_TRUE(test, is_valid_ether_addr(dev->mphy.macaddr));
+}
+
+/* A firmware error fails init as is; an unusable efuse falls back to the
+ * default file, which fails here (no file for an unknown SKU).
+ */
+static void mt7915_eeprom_test_init_errors(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_eeprom_test *e = mt7915_eeprom_test_init(test, &dev);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_init(dev), -EIO);
+	fake->mcu_ret = 0;
+
+	e->free_blocks = 29;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_init(dev), -EINVAL);
+	KUNIT_EXPECT_FALSE(test, dev->flash_mode);
+	KUNIT_EXPECT_FALSE(test, is_valid_ether_addr(dev->mphy.macaddr));
+}
+
+/* Pre-calibration data is only looked for with a flash EEPROM that asks
+ * for it; if it can't be found (no MTD or NVMEM here) none is kept.
+ */
+static void mt7915_eeprom_test_precal(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 *eep = mt7915_eeprom_test_buf(test, dev, 0);
+
+	eep[MT_EE_DO_PRE_CAL_V2] = MT_EE_WIFI_CAL_GROUP;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_load_precal(dev), 0);
+	KUNIT_EXPECT_NULL(test, dev->cal);
+
+	dev->flash_mode = true;
+	eep[MT_EE_DO_PRE_CAL_V2] = 0;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_load_precal(dev), 0);
+	KUNIT_EXPECT_NULL(test, dev->cal);
+
+	eep[MT_EE_DO_PRE_CAL_V2] = MT_EE_WIFI_CAL_GROUP | MT_EE_WIFI_CAL_DPD;
+	KUNIT_EXPECT_LT(test, mt7915_eeprom_load_precal(dev), 0);
+	KUNIT_EXPECT_NULL(test, dev->cal);
+}
+
+/* --- parsing -------------------------------------------------------------- */
+
+/* A phy for band 1 (the MT7986's 5 GHz band) */
+static struct mt7915_phy *mt7915_eeprom_test_phy1(struct kunit *test,
+						  struct mt7915_dev *dev)
+{
+	struct mt7915_phy *phy = kunit_kzalloc(test, sizeof(*phy), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	phy->mt76 = kunit_kzalloc(test, sizeof(*phy->mt76), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, phy->mt76);
+	phy->mt76->band_idx = 1;
+	phy->mt76->dev = &dev->mt76;
+	phy->dev = dev;
+	return phy;
+}
+
+static void mt7915_eeprom_test_clear_cap(struct mt76_phy *mphy)
+{
+	mphy->cap.has_2ghz = false;
+	mphy->cap.has_5ghz = false;
+	mphy->cap.has_6ghz = false;
+}
+
+/* The MT7986 has one band select per band: 2.4, 5 or 6 GHz; on hardware
+ * that does both 5 and 6 GHz the module parameter picks one, the EEPROM is
+ * rewritten to match and kept in RAM (flash mode) for the firmware.
+ */
+static void mt7915_eeprom_test_band_config(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_phy *phy1 = mt7915_eeprom_test_phy1(test, dev);
+	u8 *eep = mt7915_eeprom_test_buf(test, dev, 0);
+	struct mt76_phy *mphy = phy1->mt76;
+	u8 *conf = &eep[MT_EE_WIFI_CONF + 1];
+
+	*conf = FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL, MT_EE_V2_BAND_SEL_2GHZ);
+	mt7915_eeprom_parse_band_config(phy1);
+	KUNIT_EXPECT_TRUE(test, mphy->cap.has_2ghz);
+	KUNIT_EXPECT_FALSE(test, mphy->cap.has_5ghz || mphy->cap.has_6ghz);
+
+	mt7915_eeprom_test_clear_cap(mphy);
+	*conf = FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL, MT_EE_V2_BAND_SEL_5GHZ);
+	mt7915_eeprom_parse_band_config(phy1);
+	KUNIT_EXPECT_TRUE(test, mphy->cap.has_5ghz);
+	KUNIT_EXPECT_FALSE(test, mphy->cap.has_2ghz || mphy->cap.has_6ghz);
+
+	mt7915_eeprom_test_clear_cap(mphy);
+	*conf = FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL, MT_EE_V2_BAND_SEL_6GHZ);
+	mt7915_eeprom_parse_band_config(phy1);
+	KUNIT_EXPECT_TRUE(test, mphy->cap.has_6ghz);
+	KUNIT_EXPECT_FALSE(test, mphy->cap.has_2ghz || mphy->cap.has_5ghz);
+	KUNIT_EXPECT_FALSE(test, dev->flash_mode);
+
+	/* 5+6 GHz hardware: 5 GHz unless asked for 6 */
+	mt7915_eeprom_test_clear_cap(mphy);
+	*conf = FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL,
+			   MT_EE_V2_BAND_SEL_5GHZ_6GHZ) | 0x12;
+	mt7915_eeprom_parse_band_config(phy1);
+	KUNIT_EXPECT_TRUE(test, mphy->cap.has_5ghz);
+	KUNIT_EXPECT_FALSE(test, mphy->cap.has_6ghz);
+	KUNIT_EXPECT_EQ(test, *conf, FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL,
+			MT_EE_V2_BAND_SEL_5GHZ) | 0x12);
+	KUNIT_EXPECT_TRUE(test, dev->flash_mode);
+
+	dev->flash_mode = false;
+	mt7915_eeprom_test_clear_cap(mphy);
+	*conf = FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL,
+			   MT_EE_V2_BAND_SEL_5GHZ_6GHZ);
+	enable_6ghz = true;
+	mt7915_eeprom_parse_band_config(phy1);
+	enable_6ghz = false;
+	KUNIT_EXPECT_TRUE(test, mphy->cap.has_6ghz);
+	KUNIT_EXPECT_FALSE(test, mphy->cap.has_5ghz);
+	KUNIT_EXPECT_EQ(test, *conf, FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL,
+			MT_EE_V2_BAND_SEL_6GHZ));
+	KUNIT_EXPECT_TRUE(test, dev->flash_mode);
+	/* band 0's select is separate */
+	KUNIT_EXPECT_EQ(test, eep[MT_EE_WIFI_CONF], 0);
+}
+
+/* The MT7915 (not the MT7986) has one band select for both bands: by
+ * default 2.4 GHz on band 0 and 5 GHz on band 1 with DBDC, both otherwise.
+ */
+static void mt7915_eeprom_test_band_config_mt7915(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_phy *phy1 = mt7915_eeprom_test_phy1(test, dev);
+	u8 *eep = mt7915_eeprom_test_buf(test, dev, 0);
+	struct mt76_phy *mphy0 = &dev->mphy, *mphy1 = phy1->mt76;
+	u32 rev = dev->mt76.rev;
+
+	dev->mt76.rev = 0x79150000;
+	eep[MT_EE_WIFI_CONF] = FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL,
+					  MT_EE_BAND_SEL_DEFAULT);
+	eep[MT_EE_WIFI_CONF + 1] = FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL,
+					      MT_EE_BAND_SEL_DEFAULT);
+	mt7915_eeprom_parse_band_config(&dev->phy);
+	KUNIT_EXPECT_TRUE(test, mphy0->cap.has_2ghz && mphy0->cap.has_5ghz);
+
+	dev->dbdc_support = true;
+	mt7915_eeprom_test_clear_cap(mphy0);
+	mt7915_eeprom_parse_band_config(&dev->phy);
+	mt7915_eeprom_parse_band_config(phy1);
+	KUNIT_EXPECT_TRUE(test, mphy0->cap.has_2ghz);
+	KUNIT_EXPECT_FALSE(test, mphy0->cap.has_5ghz);
+	KUNIT_EXPECT_TRUE(test, mphy1->cap.has_5ghz);
+	KUNIT_EXPECT_FALSE(test, mphy1->cap.has_2ghz);
+
+	mt7915_eeprom_test_clear_cap(mphy1);
+	eep[MT_EE_WIFI_CONF + 1] = FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL,
+					      MT_EE_BAND_SEL_2GHZ);
+	mt7915_eeprom_parse_band_config(phy1);
+	KUNIT_EXPECT_TRUE(test, mphy1->cap.has_2ghz);
+	KUNIT_EXPECT_FALSE(test, mphy1->cap.has_5ghz);
+
+	mt7915_eeprom_test_clear_cap(mphy1);
+	eep[MT_EE_WIFI_CONF + 1] = FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL,
+					      MT_EE_BAND_SEL_DUAL);
+	mt7915_eeprom_parse_band_config(phy1);
+	KUNIT_EXPECT_TRUE(test, mphy1->cap.has_2ghz && mphy1->cap.has_5ghz);
+	dev->mt76.rev = rev;
+}
+
+/* The MT7986's paths and streams per band: tx paths from the band's
+ * config (anything outside 1-4 means 4), streams too unless DBDC gives a
+ * stream count (0: all paths), never more streams than paths; band 1's
+ * chains sit above band 0's.
+ */
+static void mt7915_eeprom_test_hw_cap(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_phy *phy1 = mt7915_eeprom_test_phy1(test, dev);
+	u8 *eep = mt7915_eeprom_test_buf(test, dev, 0);
+	static const u8 paths[] = { 0, 1, 2, 3, 4, 5, 7 };
+	static const u8 chains[] = { 4, 1, 2, 3, 4, 4, 4 };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(paths); i++) {
+		eep[MT_EE_WIFI_CONF] =
+			FIELD_PREP(MT_EE_WIFI_CONF0_TX_PATH, paths[i]);
+		dev->chainmask = 0;
+		mt7915_eeprom_parse_hw_cap(dev, &dev->phy);
+		KUNIT_EXPECT_EQ_MSG(test, dev->mphy.chainmask,
+				    BIT(chains[i]) - 1, "path %d", paths[i]);
+		KUNIT_EXPECT_EQ(test, dev->mphy.antenna_mask,
+				BIT(chains[i]) - 1);
+		KUNIT_EXPECT_EQ(test, dev->chainmask, BIT(chains[i]) - 1);
+		KUNIT_EXPECT_EQ(test, dev->chainshift, chains[i]);
+	}
+
+	/* DBDC: band 0 4T2SS, band 1 4T4SS; MT7986 allows up to 4 streams */
+	dev->dbdc_support = true;
+	dev->chainmask = 0;
+	eep[MT_EE_WIFI_CONF] = FIELD_PREP(MT_EE_WIFI_CONF0_TX_PATH, 4);
+	eep[MT_EE_WIFI_CONF + 1] = FIELD_PREP(MT_EE_WIFI_CONF0_TX_PATH, 4);
+	eep[MT_EE_WIFI_CONF + 2] = FIELD_PREP(MT_EE_WIFI_CONF_STREAM_NUM, 2);
+	eep[MT_EE_WIFI_CONF + 3] = FIELD_PREP(MT_EE_WIFI_CONF_STREAM_NUM, 4);
+	mt7915_eeprom_parse_hw_cap(dev, &dev->phy);
+	mt7915_eeprom_parse_hw_cap(dev, phy1);
+	KUNIT_EXPECT_EQ(test, dev->mphy.chainmask, 0xf);
+	KUNIT_EXPECT_EQ(test, dev->mphy.antenna_mask, 0x3);
+	KUNIT_EXPECT_EQ(test, phy1->mt76->chainmask, 0xf0);
+	KUNIT_EXPECT_EQ(test, phy1->mt76->antenna_mask, 0xf);
+	KUNIT_EXPECT_EQ(test, dev->chainmask, 0xff);
+
+	/* no stream count: as many as paths; more streams than paths: paths */
+	eep[MT_EE_WIFI_CONF + 1] = FIELD_PREP(MT_EE_WIFI_CONF0_TX_PATH, 2);
+	eep[MT_EE_WIFI_CONF + 2] = 0;
+	mt7915_eeprom_parse_hw_cap(dev, &dev->phy);
+	mt7915_eeprom_parse_hw_cap(dev, phy1);
+	KUNIT_EXPECT_EQ(test, dev->mphy.antenna_mask, 0xf);
+	KUNIT_EXPECT_EQ(test, phy1->mt76->chainmask, 0x30);
+	KUNIT_EXPECT_EQ(test, phy1->mt76->antenna_mask, 0x3);
+}
+
+/* The MT7915 (not the MT7986): one path count for the chip, at most two
+ * paths and two streams per band with DBDC, streams from config 3.
+ */
+static void mt7915_eeprom_test_hw_cap_mt7915(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_phy *phy1 = mt7915_eeprom_test_phy1(test, dev);
+	u8 *eep = mt7915_eeprom_test_buf(test, dev, 0);
+	u32 rev = dev->mt76.rev;
+
+	dev->mt76.rev = 0x79150000;
+	dev->dbdc_support = true;
+	eep[MT_EE_WIFI_CONF] = FIELD_PREP(MT_EE_WIFI_CONF0_TX_PATH, 4);
+	eep[MT_EE_WIFI_CONF + 1] = FIELD_PREP(MT_EE_WIFI_CONF0_TX_PATH, 1);
+	eep[MT_EE_WIFI_CONF + 3] = FIELD_PREP(MT_EE_WIFI_CONF3_TX_PATH_B0, 1) |
+				   FIELD_PREP(MT_EE_WIFI_CONF3_TX_PATH_B1, 3);
+	mt7915_eeprom_parse_hw_cap(dev, &dev->phy);
+	mt7915_eeprom_parse_hw_cap(dev, phy1);
+	dev->mt76.rev = rev;
+
+	KUNIT_EXPECT_EQ(test, dev->mphy.chainmask, 0x3);
+	KUNIT_EXPECT_EQ(test, dev->mphy.antenna_mask, 0x1);
+	KUNIT_EXPECT_EQ(test, phy1->mt76->chainmask, 0xc);
+	KUNIT_EXPECT_EQ(test, phy1->mt76->antenna_mask, 0x3);
+}
+
+/* --- tx power ------------------------------------------------------------- */
+
+static int mt7915_eeprom_test_target(struct mt7915_dev *dev,
+				     enum nl80211_band band, u16 ch, u8 chain)
+{
+	struct ieee80211_channel chan = {
+		.band = band,
+		.hw_value = ch,
+	};
+
+	return mt7915_eeprom_get_target_power(dev, &chan, chain);
+}
+
+/* MT7976 A-dies: one target power per chain on 2.4 GHz, per chain and
+ * channel group on 5 and 6 GHz; there's no fifth chain.
+ */
+static void mt7915_eeprom_test_target_power_7976(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 *eep = mt7915_eeprom_test_buf(test, dev, 0);
+
+	mt76_test_set_reg(mt76_test_fake, MT7915_EEPROM_TEST_SKU,
+			  MT_ADIE_TYPE_MASK);
+	eep[MT_EE_TX0_POWER_2G_V2 + 1] = 30;
+	eep[MT_EE_TX0_POWER_5G_V2 + 2 * 5 + 2] = 28;	/* ch 100: group 2 */
+	eep[MT_EE_TX0_POWER_5G_V2 + 2 * 5 + 4] = 26;	/* ch 149: group 4 */
+	eep[MT_EE_TX0_POWER_6G_V2 + 3 * 8 + 1] = 24;	/* ch 37: group 1 */
+	/* TSSI doesn't change MT7976 targets */
+	eep[MT_EE_WIFI_CONF + 7] = MT_EE_WIFI_CONF7_TSSI0_2G;
+
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_test_target(dev, NL80211_BAND_2GHZ,
+			6, 1), 30);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_test_target(dev, NL80211_BAND_5GHZ,
+			100, 2), 28);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_test_target(dev, NL80211_BAND_5GHZ,
+			149, 2), 26);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_test_target(dev, NL80211_BAND_6GHZ,
+			37, 3), 24);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_test_target(dev, NL80211_BAND_2GHZ,
+			6, 4), -EINVAL);
+}
+
+/* MT7975 A-dies: per chain targets with a delta that only applies without
+ * TSSI; no 6 GHz.
+ */
+static void mt7915_eeprom_test_target_power_7975(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 *eep = mt7915_eeprom_test_buf(test, dev, 0);
+	int idx;
+
+	idx = MT_EE_TX0_POWER_2G + 1 * 3;
+	eep[idx] = 30;
+	eep[idx + 1] = 2;
+	idx = MT_EE_TX0_POWER_5G + 2 * 12;
+	eep[idx + 1] = 26;	/* ch 36: group 1 */
+	eep[idx + 8] = 3;
+
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_test_target(dev, NL80211_BAND_2GHZ,
+			1, 1), 32);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_test_target(dev, NL80211_BAND_5GHZ,
+			36, 2), 29);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_test_target(dev, NL80211_BAND_6GHZ,
+			37, 0), 0);
+
+	eep[MT_EE_WIFI_CONF + 7] = MT_EE_WIFI_CONF7_TSSI0_2G |
+				   MT_EE_WIFI_CONF7_TSSI0_5G;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_test_target(dev, NL80211_BAND_2GHZ,
+			1, 1), 30);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_test_target(dev, NL80211_BAND_5GHZ,
+			36, 2), 26);
+	/* with DBDC, 5 GHz TSSI is the second path's bit */
+	dev->dbdc_support = true;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_test_target(dev, NL80211_BAND_5GHZ,
+			36, 2), 29);
+}
+
+/* The rate power delta: enabled or not, its sign, per band and A-die. */
+static void mt7915_eeprom_test_power_delta(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 *eep = mt7915_eeprom_test_buf(test, dev, 0);
+	u8 en = MT_EE_RATE_DELTA_EN, sign = MT_EE_RATE_DELTA_SIGN;
+
+	/* MT7975 */
+	eep[MT_EE_RATE_DELTA_2G] = en | sign | 5;
+	eep[MT_EE_RATE_DELTA_5G] = en | 7;
+	eep[MT_EE_RATE_DELTA_6G_V2] = en | 3;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_get_power_delta(dev,
+			NL80211_BAND_2GHZ), 5);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_get_power_delta(dev,
+			NL80211_BAND_5GHZ), -7);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_get_power_delta(dev,
+			NL80211_BAND_6GHZ), 0);
+	eep[MT_EE_RATE_DELTA_2G] = sign | 5;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_get_power_delta(dev,
+			NL80211_BAND_2GHZ), 0);
+
+	/* MT7976 */
+	mt76_test_set_reg(mt76_test_fake, MT7915_EEPROM_TEST_SKU,
+			  MT_ADIE_TYPE_MASK);
+	eep[MT_EE_RATE_DELTA_2G_V2] = en | 1;
+	eep[MT_EE_RATE_DELTA_5G_V2] = en | sign | 2;
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_get_power_delta(dev,
+			NL80211_BAND_2GHZ), -1);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_get_power_delta(dev,
+			NL80211_BAND_5GHZ), 2);
+	KUNIT_EXPECT_EQ(test, mt7915_eeprom_get_power_delta(dev,
+			NL80211_BAND_6GHZ), -3);
+}
+
+/* Background radar: never on the MT7986, always on the MT7915, and on the
+ * MT7916 only for a 5 GHz band 1 with two tx and two rx paths in efuse.
+ */
+static void mt7915_eeprom_test_background_radar(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_eeprom_test *e = mt7915_eeprom_test_init(test, &dev);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u32 rev = dev->mt76.rev;
+	u8 *conf = &e->efuse[MT_EE_WIFI_CONF + 1];
+	bool mt7916_5g, mt7916_3t, mt7916_err;
+
+	KUNIT_EXPECT_FALSE(test, mt7915_eeprom_has_background_radar(dev));
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	dev->mt76.rev = 0x79150000;
+	KUNIT_EXPECT_TRUE(test, mt7915_eeprom_has_background_radar(dev));
+
+	dev->mt76.rev = 0x79060000;
+	*conf = FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL, MT_EE_V2_BAND_SEL_5GHZ) |
+		FIELD_PREP(MT_EE_WIFI_CONF0_TX_PATH, 2) |
+		FIELD_PREP(MT_EE_WIFI_CONF0_RX_PATH, 2);
+	mt7916_5g = mt7915_eeprom_has_background_radar(dev);
+	*conf = FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL, MT_EE_V2_BAND_SEL_5GHZ) |
+		FIELD_PREP(MT_EE_WIFI_CONF0_TX_PATH, 3) |
+		FIELD_PREP(MT_EE_WIFI_CONF0_RX_PATH, 3);
+	mt7916_3t = mt7915_eeprom_has_background_radar(dev);
+	fake->mcu_ret = -EIO;
+	mt7916_err = mt7915_eeprom_has_background_radar(dev);
+	fake->mcu_ret = 0;
+	dev->mt76.rev = rev;
+
+	KUNIT_EXPECT_TRUE(test, mt7916_5g);
+	KUNIT_EXPECT_FALSE(test, mt7916_3t);
+	KUNIT_EXPECT_FALSE(test, mt7916_err);
+}
+
+static struct kunit_case mt7915_eeprom_test_cases[] = {
+	KUNIT_CASE(mt7915_eeprom_test_check),
+	KUNIT_CASE(mt7915_eeprom_test_name),
+	KUNIT_CASE(mt7915_eeprom_test_load_default),
+	KUNIT_CASE(mt7915_eeprom_test_load_efuse),
+	KUNIT_CASE(mt7915_eeprom_test_load_efuse_errors),
+	KUNIT_CASE(mt7915_eeprom_test_load_dt),
+	KUNIT_CASE(mt7915_eeprom_test_init_efuse),
+	KUNIT_CASE(mt7915_eeprom_test_init_no_mac),
+	KUNIT_CASE(mt7915_eeprom_test_init_errors),
+	KUNIT_CASE(mt7915_eeprom_test_precal),
+	KUNIT_CASE(mt7915_eeprom_test_band_config),
+	KUNIT_CASE(mt7915_eeprom_test_band_config_mt7915),
+	KUNIT_CASE(mt7915_eeprom_test_hw_cap),
+	KUNIT_CASE(mt7915_eeprom_test_hw_cap_mt7915),
+	KUNIT_CASE(mt7915_eeprom_test_target_power_7976),
+	KUNIT_CASE(mt7915_eeprom_test_target_power_7975),
+	KUNIT_CASE(mt7915_eeprom_test_power_delta),
+	KUNIT_CASE(mt7915_eeprom_test_background_radar),
+	{}
+};
+
+static struct kunit_suite mt7915_eeprom_test_suite = {
+	.name = "mt7915-eeprom",
+	.test_cases = mt7915_eeprom_test_cases,
+};
+
+kunit_test_suites(&mt7915_eeprom_test_suite);
diff --git a/mt7915/tests/mmio-test.c b/mt7915/tests/mmio-test.c
index ff7d7c3b..a35d6b7c 100644
--- a/mt7915/tests/mmio-test.c
+++ b/mt7915/tests/mmio-test.c
@@ -47,10 +47,556 @@ static void mt7915_test_reg_conn_infra(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_HIF_REMAP_L1), 0);
 }
 
+
+/* CONN_INFRA as the MCU sees it (0x7c000000) is the same block: the MT7986
+ * reaches it at the same window offsets, for reads, writes and
+ * read-modify-writes.
+ */
+static void mt7915_mmio_test_infra_mcu(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	mt76_wr(dev, MT_INFRA_MCU_START + 0x1000, 5);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, 0x1000), 5);
+	KUNIT_EXPECT_EQ(test, mt76_rmw(dev, MT_INFRA_MCU_START + 0x1000,
+				       0xf0, 0x30), 0x35);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, 0x1000), 0x35);
+	mt76_rmw(dev, MT_INFRA_BASE + 0x2000, 0xff00, 0x1200);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, 0x2000), 0x1200);
+}
+
+/* Without a register map, bus addresses go out untranslated (and an error is
+ * logged) instead of landing at some other block's offset.
+ */
+static void mt7915_mmio_test_no_map(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	const struct mt76_connac_reg_map *map = dev->reg.map;
+
+	dev->reg.map = NULL;
+	mt76_wr(dev, 0x820e0010, 9);
+	dev->reg.map = map;
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, 0x820e0010), 9);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, 0x420010), 0);
+}
+
+/* --- probing each chip ---------------------------------------------------- */
+
+/* A zeroed 8 MiB window that @test frees */
+static void *mt7915_mmio_test_window(struct kunit *test)
+{
+	void *mem = vzalloc(SZ_8M);
+
+	KUNIT_ASSERT_NOT_NULL(test, mem);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_vfree, mem), 0);
+	return mem;
+}
+
+/* Probing picks each chip's register layout; afterwards the chip revision
+ * is read through that chip's own layer 2 window, and the PCIe chips reach
+ * CONN_INFRA through their layer 1 remap register, the MT798x directly.
+ */
+static void mt7915_mmio_test_probe_chips(struct kunit *test)
+{
+	static const struct {
+		u32 chip;
+		u32 int_src;	/* MT_INT_SOURCE_CSR in its layout */
+		u32 l2, l2_val;	/* L2 remap register, aimed at MT_HW_REV */
+		u32 rev;	/* where MT_HW_REV lands in the window */
+		u32 l1;		/* L1 remap register, 0: none */
+		u32 infra;	/* where MT_INFRA_BASE + 0x1234 lands */
+	} chips[] = {
+		{ 0x7915, 0xd7010, MT_HIF_REMAP_L2, 0x70010, 0x204,
+		  MT_HIF_REMAP_L1, MT_HIF_REMAP_BASE_L1 + 0x1234 },
+		{ 0x7906, 0xd4200, MT_HIF_REMAP_L2_MT7916, 0x70010000,
+		  MT_HIF_REMAP_BASE_L2_MT7916 + 0x204,
+		  MT_HIF_REMAP_L1_MT7916, MT_HIF_REMAP_BASE_L1 + 0x1234 },
+		{ 0x7981, 0x24200, MT_HIF_REMAP_L2_MT7916 + 0x400000,
+		  0x70010000, 0x400000 + MT_HIF_REMAP_BASE_L2_MT7916 + 0x204,
+		  0, 0x1234 },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(chips); i++) {
+		struct mt7915_dev *dev;
+		struct device *kdev;
+		char name[24];
+		void *mem;
+
+		snprintf(name, sizeof(name), "mt7915e-%04x", chips[i].chip);
+		kdev = kunit_device_register(test, name);
+		KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(kdev));
+		mem = mt7915_mmio_test_window(test);
+		writel(0x5a, mem + chips[i].rev);
+
+		dev = mt7915_mmio_probe(kdev, mem, chips[i].chip);
+		KUNIT_ASSERT_FALSE(test, IS_ERR(dev));
+		KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+				mt76_test_free_device, &dev->mt76), 0);
+
+		KUNIT_EXPECT_EQ(test, mt76_chip(&dev->mt76), chips[i].chip);
+		KUNIT_EXPECT_EQ(test, MT_INT_SOURCE_CSR, chips[i].int_src);
+		KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_HW_REV), 0x5a);
+		KUNIT_EXPECT_EQ(test, readl(mem + chips[i].l2), chips[i].l2_val);
+
+		mt76_wr(dev, MT_INFRA_BASE + 0x1234, 0xabcd);
+		KUNIT_EXPECT_EQ(test, readl(mem + chips[i].infra), 0xabcd);
+		if (chips[i].l1)
+			KUNIT_EXPECT_EQ(test, readl(mem + chips[i].l1), 0x1800);
+	}
+}
+
+/* The revision the probe stores should come from the chip's own L2 window,
+ * and the probe shouldn't touch registers that belong to other chips'
+ * layouts.
+ */
+static void mt7915_mmio_test_probe_rev(struct kunit *test)
+{
+	struct device *kdev = kunit_device_register(test, "mt7915e-rev");
+	struct mt7915_dev *dev;
+	void *mem;
+
+	kunit_skip(test, "driver bug: mt7915_mmio_init() reads MT_HW_REV before mdev->rev is set, so the MT7986 goes through the MT7916 L2 remap (rmw of window offset 0x1b8, revision from 0x40204)");
+
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(kdev));
+	mem = mt7915_mmio_test_window(test);
+	writel(0x5a, mem + 0x400000 + MT_HIF_REMAP_BASE_L2_MT7916 + 0x204);
+	dev = mt7915_mmio_probe(kdev, mem, 0x7986);
+	KUNIT_ASSERT_FALSE(test, IS_ERR(dev));
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_test_free_device, &dev->mt76), 0);
+	KUNIT_EXPECT_EQ(test, dev->mt76.rev, 0x7986005a);
+	KUNIT_EXPECT_EQ(test, readl(mem + MT_HIF_REMAP_L2_MT7916), 0);
+}
+
+/* A chip the driver doesn't know is refused, and the device freed. */
+static void mt7915_mmio_test_probe_unknown(struct kunit *test)
+{
+	struct device *kdev = kunit_device_register(test, "mt7915e-unknown");
+	struct mt7915_dev *dev;
+
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(kdev));
+	dev = mt7915_mmio_probe(kdev, mt7915_mmio_test_window(test), 0x7990);
+	KUNIT_EXPECT_EQ(test, PTR_ERR_OR_ZERO(dev), -EINVAL);
+}
+
+/* Without WED support, WED setup reports it unused, so the platform probe
+ * falls back to the device's own interrupt.
+ */
+static void mt7915_mmio_test_wed_init(struct kunit *test)
+{
+	int (*wed_init)(struct mt7915_dev *dev, void *pdev, bool pci,
+			int *irq) = mt7915_mmio_wed_init;
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	int irq = 42;
+
+	/* called out of line, as from the probe */
+	OPTIMIZER_HIDE_VAR(wed_init);
+	KUNIT_EXPECT_EQ(test, wed_init(dev, NULL, false, &irq), 0);
+	KUNIT_EXPECT_EQ(test, irq, 42);
+}
+
+/* --- interrupts ----------------------------------------------------------- */
+
+/* the rx queues the interrupt tasklet schedules */
+static const int mt7915_mmio_test_rxqs[] = {
+	MT_RXQ_MAIN, MT_RXQ_MCU, MT_RXQ_MCU_WA,
+	MT_RXQ_BAND1, MT_RXQ_BAND1_WA, MT_RXQ_MAIN_WA,
+};
+
+static struct {
+	struct mt7915_dev *dev;
+	int polls[__MT_RXQ_MAX];
+	int tx_polls;
+	int tasklet_runs;
+	int works;
+} mt7915_mmio_test_irq;
+
+static int mt7915_mmio_test_poll(struct napi_struct *napi, int budget)
+{
+	struct mt7915_dev *dev = mt7915_mmio_test_irq.dev;
+
+	if (napi == &dev->mt76.tx_napi)
+		mt7915_mmio_test_irq.tx_polls++;
+	else
+		mt7915_mmio_test_irq.polls[napi - dev->mt76.napi]++;
+	napi_complete_done(napi, 0);
+
+	return 0;
+}
+
+static void mt7915_mmio_test_tasklet_stub(struct tasklet_struct *t)
+{
+	mt7915_mmio_test_irq.tasklet_runs++;
+}
+
+static void mt7915_mmio_test_work_stub(struct work_struct *work)
+{
+	mt7915_mmio_test_irq.works++;
+}
+
+static void mt7915_mmio_test_irq_del(void *data)
+{
+	struct mt7915_dev *dev = data;
+	int i;
+
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	dev->hif2 = NULL;
+	if (!dev->mt76.napi_dev)
+		return;
+
+	napi_disable(&dev->mt76.tx_napi);
+	__netif_napi_del(&dev->mt76.tx_napi);
+	for (i = 0; i < ARRAY_SIZE(mt7915_mmio_test_rxqs); i++) {
+		struct napi_struct *napi;
+
+		napi = &dev->mt76.napi[mt7915_mmio_test_rxqs[i]];
+		napi_disable(napi);
+		__netif_napi_del(napi);
+	}
+	/* one (expedited) grace period for all of them */
+	rtnl_lock();
+	synchronize_net();
+	rtnl_unlock();
+	free_netdev(dev->mt76.napi_dev);
+	free_netdev(dev->mt76.tx_napi_dev);
+	dev->mt76.napi_dev = NULL;
+	dev->mt76.tx_napi_dev = NULL;
+}
+
+/* An MT7986 with the interrupt bits mt7915_dma_config() gives its queues,
+ * and, with @napi, NAPI contexts that count their polls.
+ */
+static struct mt7915_dev *mt7915_mmio_test_irq_dev(struct kunit *test,
+						   bool napi)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	int i;
+
+	memset(&mt7915_mmio_test_irq, 0, sizeof(mt7915_mmio_test_irq));
+	mt7915_mmio_test_irq.dev = dev;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_mmio_test_irq_del, dev), 0);
+
+	dev->q_int_mask[MT_MCUQ_WM] = MT_INT_TX_DONE_MCU_WM;
+	dev->q_int_mask[MT_MCUQ_WA] = MT_INT_TX_DONE_MCU_WA_MT7916;
+	dev->q_int_mask[MT_MCUQ_FWDL] = MT_INT_TX_DONE_FWDL;
+	dev->q_int_mask[__RXQ(MT_RXQ_MAIN)] = MT_INT_RX_DONE_BAND0_MT7916;
+	dev->q_int_mask[__RXQ(MT_RXQ_MCU)] = MT_INT_RX_DONE_WM;
+	dev->q_int_mask[__RXQ(MT_RXQ_MCU_WA)] = MT_INT_RX_DONE_WA;
+	dev->q_int_mask[__RXQ(MT_RXQ_BAND1)] = MT_INT_RX_DONE_BAND1_MT7916;
+	dev->q_int_mask[__RXQ(MT_RXQ_BAND1_WA)] = MT_INT_RX_DONE_WA_EXT_MT7916;
+	dev->q_int_mask[__RXQ(MT_RXQ_MAIN_WA)] = MT_INT_RX_DONE_WA_MAIN_MT7916;
+	if (!napi)
+		return dev;
+
+	dev->mt76.napi_dev = alloc_netdev_dummy(0);
+	KUNIT_ASSERT_NOT_NULL(test, dev->mt76.napi_dev);
+	dev->mt76.tx_napi_dev = alloc_netdev_dummy(0);
+	if (!dev->mt76.tx_napi_dev) {
+		free_netdev(dev->mt76.napi_dev);
+		dev->mt76.napi_dev = NULL;
+	}
+	KUNIT_ASSERT_NOT_NULL(test, dev->mt76.tx_napi_dev);
+
+	netif_napi_add_tx(dev->mt76.tx_napi_dev, &dev->mt76.tx_napi,
+			  mt7915_mmio_test_poll);
+	napi_enable(&dev->mt76.tx_napi);
+	for (i = 0; i < ARRAY_SIZE(mt7915_mmio_test_rxqs); i++) {
+		struct napi_struct *n;
+
+		n = &dev->mt76.napi[mt7915_mmio_test_rxqs[i]];
+		netif_napi_add(dev->mt76.napi_dev, n, mt7915_mmio_test_poll);
+		napi_enable(n);
+	}
+
+	return dev;
+}
+
+/* Run the interrupt tasklet as softirq context would, then wait for the NAPI
+ * polls it scheduled to finish.
+ */
+static void mt7915_mmio_test_run_tasklet(struct mt7915_dev *dev)
+{
+	int i;
+
+	local_bh_disable();
+	mt7915_irq_tasklet(&dev->mt76.irq_tasklet);
+	local_bh_enable();
+	if (!dev->mt76.napi_dev)
+		return;
+
+	/* napi_disable() returns once a scheduled poll has completed */
+	napi_disable(&dev->mt76.tx_napi);
+	napi_enable(&dev->mt76.tx_napi);
+	for (i = 0; i < ARRAY_SIZE(mt7915_mmio_test_rxqs); i++) {
+		struct napi_struct *napi;
+
+		napi = &dev->mt76.napi[mt7915_mmio_test_rxqs[i]];
+		napi_disable(napi);
+		napi_enable(napi);
+	}
+}
+
+/* The tasklet masks the device's interrupts, acks only the pending sources
+ * that are enabled, turns off the ones it hands to NAPI, and schedules NAPI
+ * for exactly those: a masked source (band 1 here) is left alone.
+ */
+static void mt7915_mmio_test_tasklet_rx_tx(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_mmio_test_irq_dev(test, true);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u32 rx0 = MT_INT_RX(MT_RXQ_MAIN), band1 = MT_INT_RX(MT_RXQ_BAND1);
+	u32 mask = rx0 | MT_INT_RX_DONE_MCU | MT_INT_TX_DONE_MCU |
+		   MT_INT_MCU_CMD;
+
+	dev->mt76.mmio.irqmask = mask;
+	mt76_test_set_reg(fake, MT_INT_MASK_CSR, mask);
+	mt76_test_set_reg(fake, MT_INT_SOURCE_CSR,
+			  rx0 | band1 | MT_INT_TX_DONE_MCU_WM);
+
+	mt7915_mmio_test_run_tasklet(dev);
+
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_INT_MASK_CSR), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_INT_SOURCE_CSR),
+			rx0 | MT_INT_TX_DONE_MCU_WM);
+	/* all of the MCU tx done bits go off with any of them */
+	KUNIT_EXPECT_EQ(test, dev->mt76.mmio.irqmask,
+			MT_INT_RX_DONE_MCU | MT_INT_MCU_CMD);
+	KUNIT_EXPECT_EQ(test, readl(dev->mt76.mmio.regs + MT_INT_MASK_CSR),
+			MT_INT_RX_DONE_MCU | MT_INT_MCU_CMD);
+
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.tx_polls, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.polls[MT_RXQ_MAIN], 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.polls[MT_RXQ_BAND1], 0);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.polls[MT_RXQ_MCU], 0);
+}
+
+/* Each rx queue's done bit schedules that queue's NAPI, once. */
+static void mt7915_mmio_test_tasklet_rx_queues(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_mmio_test_irq_dev(test, true);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	int i;
+
+	dev->mt76.mmio.irqmask = MT_INT_RX_DONE_ALL;
+	mt76_test_set_reg(fake, MT_INT_SOURCE_CSR, MT_INT_RX_DONE_ALL);
+
+	mt7915_mmio_test_run_tasklet(dev);
+
+	for (i = 0; i < ARRAY_SIZE(mt7915_mmio_test_rxqs); i++)
+		KUNIT_EXPECT_EQ_MSG(test, mt7915_mmio_test_irq.polls[
+				    mt7915_mmio_test_rxqs[i]], 1,
+				    "rx queue %d", mt7915_mmio_test_rxqs[i]);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.tx_polls, 0);
+	KUNIT_EXPECT_EQ(test, dev->mt76.mmio.irqmask, 0);
+}
+
+/* MT_MCU_CMD reads hand out the pending firmware events once, so what's left
+ * in the register afterwards is what the driver wrote back to ack them.
+ */
+static u32 mt7915_mmio_test_mcu_cmd_rr(struct mt76_test_fake *fake, u32 addr,
+				       u32 val)
+{
+	struct mt7915_dev *dev = mt7915_mmio_test_irq.dev;
+
+	if (addr == MT_MCU_CMD)
+		mt76_test_set_reg(fake, addr, 0);
+	return val;
+}
+
+/* Run the tasklet on a firmware event @cmd. */
+static struct mt7915_dev *mt7915_mmio_test_mcu_cmd(struct kunit *test, u32 cmd)
+{
+	struct mt7915_dev *dev = mt7915_mmio_test_irq_dev(test, false);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	dev->recovery.hw_init_done = true;
+	INIT_WORK(&dev->reset_work, mt7915_mmio_test_work_stub);
+	INIT_WORK(&dev->dump_work, mt7915_mmio_test_work_stub);
+	dev->mt76.mmio.irqmask = MT_INT_MCU_CMD | MT_INT_RX_DONE_MCU;
+	mt76_test_set_reg(fake, MT_INT_SOURCE_CSR, MT_INT_MCU_CMD);
+	mt76_test_set_reg(fake, MT_MCU_CMD, cmd);
+	fake->rr_hook = mt7915_mmio_test_mcu_cmd_rr;
+
+	mt7915_mmio_test_run_tasklet(dev);
+	flush_work(&dev->reset_work);
+	flush_work(&dev->dump_work);
+
+	/* acked, and no NAPI work for a firmware event */
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_MCU_CMD), cmd);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.polls[MT_RXQ_MCU], 0);
+
+	return dev;
+}
+
+/* A firmware request to stop DMA starts the SER recovery: the reset work
+ * runs and MCU commands are held off.
+ */
+static void mt7915_mmio_test_tasklet_ser(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+
+	dev = mt7915_mmio_test_mcu_cmd(test, MT_MCU_CMD_STOP_DMA);
+	KUNIT_EXPECT_EQ(test, dev->recovery.state, MT_MCU_CMD_STOP_DMA);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_MCU_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.works, 1);
+	KUNIT_EXPECT_FALSE(test, dev->recovery.restart);
+	/* the event interrupt stays on for the rest of the handshake */
+	KUNIT_EXPECT_TRUE(test, dev->mt76.mmio.irqmask & MT_INT_MCU_CMD);
+}
+
+/* A firmware watchdog asks for a full restart: the crash dump work runs and
+ * further firmware events are masked.
+ */
+static void mt7915_mmio_test_tasklet_wdt(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+
+	dev = mt7915_mmio_test_mcu_cmd(test, MT_MCU_CMD_WM_WDT);
+	KUNIT_EXPECT_EQ(test, dev->recovery.state, MT_MCU_CMD_WM_WDT);
+	KUNIT_EXPECT_TRUE(test, dev->recovery.restart);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.works, 1);
+	KUNIT_EXPECT_FALSE(test, dev->mt76.mmio.irqmask & MT_INT_MCU_CMD);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_MCU_RESET, &dev->mphy.state));
+}
+
+/* An event that is neither an error nor a watchdog is acked and nothing
+ * else happens.
+ */
+static void mt7915_mmio_test_tasklet_mcu_event(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+
+	dev = mt7915_mmio_test_mcu_cmd(test, BIT(8));
+	KUNIT_EXPECT_EQ(test, dev->recovery.state, 0);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.works, 0);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_MCU_RESET, &dev->mphy.state));
+}
+
+/* With a second PCIe interface (not on the MT7986), its sources are read,
+ * acked and handled with the first's, and both mask registers follow.
+ */
+static void mt7915_mmio_test_tasklet_hif2(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_mmio_test_irq_dev(test, true);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u32 rx0 = MT_INT_RX(MT_RXQ_MAIN), band1 = MT_INT_RX(MT_RXQ_BAND1);
+
+	dev->hif2 = kunit_kzalloc(test, sizeof(*dev->hif2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev->hif2);
+	dev->mt76.mmio.irqmask = rx0 | band1 | MT_INT_MCU_CMD;
+	mt76_test_set_reg(fake, MT_INT_SOURCE_CSR, rx0);
+	mt76_test_set_reg(fake, MT_INT1_SOURCE_CSR, band1 | BIT(31));
+
+	mt7915_mmio_test_run_tasklet(dev);
+
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_INT1_SOURCE_CSR), band1);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.polls[MT_RXQ_MAIN], 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.polls[MT_RXQ_BAND1], 1);
+	KUNIT_EXPECT_EQ(test, dev->mt76.mmio.irqmask, MT_INT_MCU_CMD);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_INT_MASK_CSR),
+			MT_INT_MCU_CMD);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_INT1_MASK_CSR),
+			MT_INT_MCU_CMD);
+}
+
+/* The hard irq handler masks the device and defers to the tasklet, but only
+ * once the device is initialized: before that the interrupt isn't ours.
+ */
+static void mt7915_mmio_test_irq_handler(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_mmio_test_irq_dev(test, false);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	tasklet_setup(&dev->mt76.irq_tasklet, mt7915_mmio_test_tasklet_stub);
+
+	mt76_test_set_reg(fake, MT_INT_MASK_CSR, ~0);
+	KUNIT_EXPECT_EQ(test, mt7915_irq_handler(0, dev), IRQ_NONE);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_INT_MASK_CSR), 0);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.tasklet_runs, 0);
+
+	set_bit(MT76_STATE_INITIALIZED, &dev->mphy.state);
+	mt76_test_set_reg(fake, MT_INT_MASK_CSR, ~0);
+	KUNIT_EXPECT_EQ(test, mt7915_irq_handler(0, dev), IRQ_HANDLED);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_INT_MASK_CSR), 0);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.tasklet_runs, 1);
+	clear_bit(MT76_STATE_INITIALIZED, &dev->mphy.state);
+
+	/* with a second interface, its mask goes off too */
+	dev->hif2 = kunit_kzalloc(test, sizeof(*dev->hif2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev->hif2);
+	mt76_test_set_reg(fake, MT_INT1_MASK_CSR, ~0);
+	KUNIT_EXPECT_EQ(test, mt7915_irq_handler(0, dev), IRQ_NONE);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_INT1_MASK_CSR), 0);
+}
+
+/* When NAPI has drained an rx queue, its interrupt goes back on and the
+ * tasklet runs to catch anything that came in meanwhile.
+ */
+static void mt7915_mmio_test_rx_poll_complete(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_mmio_test_irq_dev(test, false);
+
+	tasklet_setup(&dev->mt76.irq_tasklet, mt7915_mmio_test_tasklet_stub);
+	dev->mt76.mmio.irqmask = MT_INT_MCU_CMD;
+
+	/* as the DMA core calls it */
+	dev->mt76.drv->rx_poll_complete(&dev->mt76, MT_RXQ_MAIN);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+
+	KUNIT_EXPECT_EQ(test, dev->mt76.mmio.irqmask,
+			MT_INT_MCU_CMD | MT_INT_RX(MT_RXQ_MAIN));
+	KUNIT_EXPECT_EQ(test, mt7915_mmio_test_irq.tasklet_runs, 1);
+}
+
+/* The dual interface mask helper keeps one mask for both interfaces and
+ * writes it to both, only when asked to.
+ */
+static void mt7915_mmio_test_dual_hif_mask(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	unsigned int n_wr;
+
+	dev->mt76.mmio.irqmask = BIT(0) | BIT(1);
+	n_wr = fake->n_wr;
+	mt7915_dual_hif_set_irq_mask(dev, false, BIT(0), BIT(4));
+	KUNIT_EXPECT_EQ(test, dev->mt76.mmio.irqmask, BIT(1) | BIT(4));
+	KUNIT_EXPECT_EQ(test, fake->n_wr, n_wr);
+
+	mt7915_dual_hif_set_irq_mask(dev, true, BIT(1), BIT(2));
+	KUNIT_EXPECT_EQ(test, dev->mt76.mmio.irqmask, BIT(2) | BIT(4));
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_INT_MASK_CSR),
+			BIT(2) | BIT(4));
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_INT1_MASK_CSR),
+			BIT(2) | BIT(4));
+}
+
 static struct kunit_case mt7915_mmio_test_cases[] = {
 	KUNIT_CASE(mt7915_test_reg_direct),
 	KUNIT_CASE(mt7915_test_reg_fixed_map),
 	KUNIT_CASE(mt7915_test_reg_conn_infra),
+	KUNIT_CASE(mt7915_mmio_test_infra_mcu),
+	KUNIT_CASE(mt7915_mmio_test_no_map),
+	KUNIT_CASE(mt7915_mmio_test_probe_chips),
+	KUNIT_CASE(mt7915_mmio_test_probe_rev),
+	KUNIT_CASE(mt7915_mmio_test_probe_unknown),
+	KUNIT_CASE(mt7915_mmio_test_wed_init),
+	KUNIT_CASE(mt7915_mmio_test_tasklet_rx_tx),
+	KUNIT_CASE(mt7915_mmio_test_tasklet_rx_queues),
+	KUNIT_CASE(mt7915_mmio_test_tasklet_ser),
+	KUNIT_CASE(mt7915_mmio_test_tasklet_wdt),
+	KUNIT_CASE(mt7915_mmio_test_tasklet_mcu_event),
+	KUNIT_CASE(mt7915_mmio_test_tasklet_hif2),
+	KUNIT_CASE(mt7915_mmio_test_irq_handler),
+	KUNIT_CASE(mt7915_mmio_test_rx_poll_complete),
+	KUNIT_CASE(mt7915_mmio_test_dual_hif_mask),
 	{}
 };
 
diff --git a/mt7915/tests/soc-test.c b/mt7915/tests/soc-test.c
new file mode 100644
index 00000000..7f507afe
--- /dev/null
+++ b/mt7915/tests/soc-test.c
@@ -0,0 +1,1520 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for the MT7986's WMAC bring-up (mt7915/soc.c): the A-die SPI
+ * bridge and efuse reads, the A-die calibration and patch sequences, the
+ * PLL/clock/bus setup, the WiFi subsystem power-up and the SKU decoding.
+ * Included at the end of mt7915/soc.c when CONFIG_MT76_KUNIT_TEST is defined
+ * (milkflint's QEMU test build only).
+ *
+ * The device-tree half of the platform probe (clocks, resets, reserved
+ * memory) can't run here; the register sequences can. Behind the fake
+ * register file sits a model of the two A-dies: a transfer the driver sets
+ * up in the SPI bridge's address/data registers completes when it polls the
+ * busy register, and an efuse read completes when it is kicked. The SKU and
+ * INFRACFG windows (dev->sku, dev->dcm) are plain memory.
+ */
+#include <kunit/test.h>
+#include <linux/clk-provider.h>
+#include <linux/clkdev.h>
+#include <linux/pinctrl/machine.h>
+#include "../mcu.h"
+#include "../eeprom.h"
+#include "fake.h"
+
+/* CONN_INFRA addresses land at their offset from MT_INFRA_BASE */
+#define MT7915_SOC_TEST_REG(a)		((a) - MT_INFRA_BASE)
+/* an A-die type word: the chip id of A-die 0, then of A-die 1 */
+#define MT7915_SOC_TEST_ADIE(a0, a1)	((a0) | (a1) << 16)
+
+struct mt7915_soc_test_wr {
+	u8 adie;
+	u16 addr;
+	u32 val;
+};
+
+struct mt7915_soc_test {
+	struct {
+		u32 regs[SZ_4K / 4];	/* SPI registers, by address / 4 */
+		u32 efuse[0x400];
+		DECLARE_BITMAP(efuse_valid, 0x400);
+	} adie[2];
+	int spi_ok;		/* SPI busy polls that succeed, < 0: all */
+	bool efuse_stuck;	/* efuse reads never complete */
+	bool pwr_ack;		/* WFSYS reset status follows its power enable */
+	unsigned int n_locks;
+	struct mt7915_soc_test_wr wr[256];	/* A-die writes, in order */
+	unsigned int n_wr;
+	struct {
+		u32 addr, val;
+	} rd[1024];		/* register reads (not the SPI bridge's) */
+	unsigned int n_rd;
+	u32 sku[0x100];		/* the TOP POS window, dev->sku */
+	u32 dcm[0x40];		/* the INFRACFG window, dev->dcm */
+};
+
+static void mt7915_soc_test_adie_wr(struct mt7915_soc_test *t, int a,
+				    u32 addr, u32 val)
+{
+	u32 stored = val;
+
+	if (t->n_wr < ARRAY_SIZE(t->wr)) {
+		t->wr[t->n_wr].adie = a;
+		t->wr[t->n_wr].addr = addr;
+		t->wr[t->n_wr].val = val;
+		t->n_wr++;
+	}
+
+	/* kicked, the A-die latches the efuse word and says if it's valid */
+	if (addr == MT_ADIE_EFUSE2_CTRL && (val & MT_ADIE_EFUSE_KICK_MASK) &&
+	    !t->efuse_stuck) {
+		u32 ea = FIELD_GET(MT_ADIE_EFUSE_ADDR_MASK, val);
+
+		stored &= ~(MT_ADIE_EFUSE_KICK_MASK | MT_ADIE_EFUSE_VALID_MASK);
+		if (ea < 0x400 && test_bit(ea, t->adie[a].efuse_valid)) {
+			stored |= MT_ADIE_EFUSE_VALID_MASK;
+			t->adie[a].regs[MT_ADIE_EFUSE_RDATA0 / 4] =
+				t->adie[a].efuse[ea];
+		}
+	}
+	t->adie[a].regs[(addr % SZ_4K) / 4] = stored;
+}
+
+/* a poll of the SPI busy register completes the transfer set up before it */
+static u32 mt7915_soc_test_spi_poll(struct mt76_test_fake *fake,
+				    struct mt7915_soc_test *t, int a)
+{
+	u32 addr_cr = MT7915_SOC_TEST_REG(MT_TOP_SPI_ADDR_CR(a));
+	u32 cr = mt76_test_reg(fake, addr_cr);
+	u32 addr = cr & GENMASK(11, 0);
+
+	if (!t->spi_ok)
+		return MT_TOP_SPI_POLLING_BIT;
+	if (t->spi_ok > 0)
+		t->spi_ok--;
+
+	if ((cr & MT_TOP_SPI_READ_ADDR_FORMAT) == MT_TOP_SPI_READ_ADDR_FORMAT)
+		mt76_test_set_reg(fake,
+			MT7915_SOC_TEST_REG(MT_TOP_SPI_READ_DATA_CR(a)),
+			t->adie[a].regs[addr / 4]);
+	else if ((cr & MT_TOP_SPI_WRITE_ADDR_FORMAT) ==
+		 MT_TOP_SPI_WRITE_ADDR_FORMAT)
+		mt7915_soc_test_adie_wr(t, a, addr, mt76_test_reg(fake,
+			MT7915_SOC_TEST_REG(MT_TOP_SPI_WRITE_DATA_CR(a))));
+	mt76_test_set_reg(fake, addr_cr, 0);
+
+	return 0;
+}
+
+static u32 mt7915_soc_test_rr(struct mt76_test_fake *fake, u32 addr, u32 val)
+{
+	struct mt7915_soc_test *t = fake->priv;
+	int a;
+
+	for (a = 0; a < 2; a++)
+		if (addr == MT7915_SOC_TEST_REG(MT_TOP_SPI_BUSY_CR(a)))
+			return mt7915_soc_test_spi_poll(fake, t, a);
+
+	if (t->n_rd < ARRAY_SIZE(t->rd)) {
+		t->rd[t->n_rd].addr = addr;
+		t->rd[t->n_rd].val = val;
+		t->n_rd++;
+	}
+
+	switch (addr) {
+	case MT7915_SOC_TEST_REG(MT_SEMA_RFSPI_STATUS):
+		/* the semaphore is free; taking it clears the last release */
+		t->n_locks++;
+		mt76_test_set_reg(fake,
+			MT7915_SOC_TEST_REG(MT_SEMA_RFSPI_RELEASE), 0);
+		return MT_SEMA_RFSPI_STATUS_MASK;
+	case MT7915_SOC_TEST_REG(MT_TOP_WFSYS_RESET_STATUS):
+		if (!t->pwr_ack)
+			return val;
+		val = mt76_test_reg(fake,
+			MT7915_SOC_TEST_REG(MT_TOP_WFSYS_PWR));
+		return FIELD_PREP(MT_TOP_WFSYS_RESET_STATUS_MASK,
+				  !!(val & MT_TOP_PWR_EN_MASK));
+	case MT7915_SOC_TEST_REG(MT_CONN_INFRA_WF_SLP_PROT_RDY):
+		/* the bus protection acks what was asked for */
+		val = mt76_test_reg(fake,
+			MT7915_SOC_TEST_REG(MT_CONN_INFRA_WF_SLP_PROT));
+		return val & MT_CONN_INFRA_WF_SLP_PROT_MASK ?
+		       MT_CONN_INFRA_CONN : 0;
+	}
+
+	return val;
+}
+
+static u32 mt7915_soc_test_reg(u32 addr)
+{
+	return mt76_test_reg(mt76_test_fake, MT7915_SOC_TEST_REG(addr));
+}
+
+static void mt7915_soc_test_set_reg(u32 addr, u32 val)
+{
+	mt76_test_set_reg(mt76_test_fake, MT7915_SOC_TEST_REG(addr), val);
+}
+
+/* the SPI semaphore was released after the last time it was taken */
+static bool mt7915_soc_test_unlocked(void)
+{
+	return mt7915_soc_test_reg(MT_SEMA_RFSPI_RELEASE) == 1;
+}
+
+static void mt7915_soc_test_efuse(struct mt7915_soc_test *t, int a, u32 addr,
+				  u32 val)
+{
+	t->adie[a].efuse[addr] = val;
+	set_bit(addr, t->adie[a].efuse_valid);
+}
+
+/* every efuse word of A-die @a programmed, to zero */
+static void mt7915_soc_test_efuse_zero(struct mt7915_soc_test *t, int a)
+{
+	memset(t->adie[a].efuse, 0, sizeof(t->adie[a].efuse));
+	bitmap_fill(t->adie[a].efuse_valid, 0x400);
+}
+
+/* how many times the driver wrote A-die @a's register @addr */
+static int mt7915_soc_test_n_wr(struct mt7915_soc_test *t, int a, u32 addr)
+{
+	int i, n = 0;
+
+	for (i = 0; i < t->n_wr; i++)
+		n += t->wr[i].adie == a && t->wr[i].addr == addr;
+	return n;
+}
+
+/* the first value the driver wrote to A-die @a's register @addr */
+static u32 mt7915_soc_test_first_wr(struct mt7915_soc_test *t, int a,
+				    u32 addr)
+{
+	int i;
+
+	for (i = 0; i < t->n_wr; i++)
+		if (t->wr[i].adie == a && t->wr[i].addr == addr)
+			return t->wr[i].val;
+	return 0xdeadbeef;
+}
+
+/* how many register reads of @addr returned all of @bits set */
+static int mt7915_soc_test_n_rd(struct mt7915_soc_test *t, u32 addr, u32 bits)
+{
+	int i, n = 0;
+
+	for (i = 0; i < t->n_rd; i++)
+		n += t->rd[i].addr == MT7915_SOC_TEST_REG(addr) &&
+		     (t->rd[i].val & bits) == bits;
+	return n;
+}
+
+/* An MT7986 with the A-die model, its SKU/INFRACFG windows, no reset line,
+ * and conninfra, the WiFi subsystem and its ROM reporting ready.
+ */
+static struct mt7915_soc_test *
+mt7915_soc_test_init(struct kunit *test, struct mt7915_dev **pdev)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_soc_test *t;
+
+	t = kunit_kzalloc(test, sizeof(*t), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, t);
+	t->spi_ok = -1;
+	t->pwr_ack = true;
+	dev->sku = (void __force __iomem *)t->sku;
+	dev->dcm = (void __force __iomem *)t->dcm;
+	dev->rstc = NULL;
+	fake->priv = t;
+	fake->rr_hook = mt7915_soc_test_rr;
+
+	mt7915_soc_test_set_reg(MT_CONN_INFRA_BASE, MT7986_CON_INFRA_VERSION);
+	mt7915_soc_test_set_reg(MT_TOP_CFG_IP_VERSION_ADDR, 0x02060000);
+	mt7915_soc_test_set_reg(MT_TOP_CFG_ON_ROM_IDX, 0x1d1e);
+
+	*pdev = dev;
+	return t;
+}
+
+/* --- the A-die SPI bridge ------------------------------------------------- */
+
+/* Reads and writes reach the A-die they name, in the bridge's read and
+ * write formats; a read-modify-write only changes the masked bits.
+ */
+static void mt7915_soc_test_spi_access(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 val = 0;
+
+	KUNIT_EXPECT_EQ(test, mt76_wmac_spi_write(dev, 1, MT_ADIE_XTAL_C1,
+						  0xa5a5), 0);
+	KUNIT_EXPECT_EQ(test, t->adie[1].regs[MT_ADIE_XTAL_C1 / 4], 0xa5a5);
+	KUNIT_EXPECT_EQ(test, t->adie[0].regs[MT_ADIE_XTAL_C1 / 4], 0);
+
+	t->adie[0].regs[MT_ADIE_CHIP_ID / 4] = 0x79768a00;
+	KUNIT_EXPECT_EQ(test, mt76_wmac_spi_read(dev, 0, MT_ADIE_CHIP_ID, &val),
+			0);
+	KUNIT_EXPECT_EQ(test, val, 0x79768a00);
+
+	KUNIT_EXPECT_EQ(test, mt76_wmac_spi_rmw(dev, 1, MT_ADIE_XTAL_C1,
+						0xff00, 0x1200), 0);
+	KUNIT_EXPECT_EQ(test, t->adie[1].regs[MT_ADIE_XTAL_C1 / 4], 0x12a5);
+	/* the write and the rmw wrote, the reads didn't */
+	KUNIT_EXPECT_EQ(test, t->n_wr, 2);
+}
+
+/* A bridge that stays busy fails the transfer with a timeout, before or
+ * after the transfer is set up, and a failed read is never written back.
+ */
+static void mt7915_soc_test_spi_busy(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 val = 0x1234;
+
+	t->spi_ok = 0;
+	KUNIT_EXPECT_EQ(test, mt76_wmac_spi_read(dev, 0, MT_ADIE_CHIP_ID, &val),
+			-ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, val, 0x1234);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_TOP_SPI_ADDR_CR(0)), 0);
+	KUNIT_EXPECT_EQ(test, mt76_wmac_spi_write(dev, 0, MT_ADIE_XTAL_C1, 1),
+			-ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, t->n_wr, 0);
+
+	/* busy once the read is set up: its data isn't used */
+	t->spi_ok = 1;
+	t->adie[0].regs[MT_ADIE_CHIP_ID / 4] = 0x7976;
+	KUNIT_EXPECT_EQ(test, mt76_wmac_spi_read(dev, 0, MT_ADIE_CHIP_ID, &val),
+			-ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, val, 0x1234);
+	/* (a failing read-modify-write: see mt7915_soc_test_adie_cfg_other) */
+}
+
+/* An efuse read puts the A-die in efuse mode, kicks a read of that word
+ * and returns it only if the A-die says it's valid.
+ */
+static void mt7915_soc_test_efuse_read(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 data = 0, kick;
+	int i;
+
+	mt7915_soc_test_efuse(t, 1, MT_ADIE_THADC_ANALOG, 0x95);
+	mt7915_soc_test_efuse(t, 1, MT_ADIE_THADC_SLOP, 0x17);
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_efuse_read(dev, 1,
+			MT_ADIE_THADC_ANALOG, &data), 0);
+	KUNIT_EXPECT_EQ(test, data, 0x95);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_first_wr(t, 1, MT_ADIE_EFUSE_CFG),
+			MT_ADIE_EFUSE_CTRL_MASK);
+	for (i = t->n_wr - 1; i >= 0; i--)
+		if (t->wr[i].addr == MT_ADIE_EFUSE2_CTRL)
+			break;
+	KUNIT_ASSERT_GE(test, i, 0);
+	kick = t->wr[i].val;
+	KUNIT_EXPECT_TRUE(test, kick & MT_ADIE_EFUSE_KICK_MASK);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_ADIE_EFUSE_ADDR_MASK, kick),
+			MT_ADIE_THADC_ANALOG);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_ADIE_EFUSE_MODE_MASK, kick), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0, MT_ADIE_EFUSE2_CTRL), 0);
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_efuse_read(dev, 1,
+			MT_ADIE_THADC_SLOP, &data), 0);
+	KUNIT_EXPECT_EQ(test, data, 0x17);
+
+	/* a word that isn't valid is not returned */
+	data = 0xdead;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_efuse_read(dev, 1,
+			MT_ADIE_XO_TRIM_FLOW, &data), 0);
+	KUNIT_EXPECT_EQ(test, data, 0xdead);
+}
+
+/* --- A-die calibration ---------------------------------------------------- */
+
+/* Thermal sensor trims programmed in efuse go to the thermal ADC's
+ * registers, leaving their other bits alone.
+ */
+static void mt7915_soc_test_thermal_cal(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 *bg = &t->adie[0].regs[MT_ADIE_RG_TOP_THADC_BG / 4];
+	u32 *thadc = &t->adie[0].regs[MT_ADIE_RG_TOP_THADC / 4];
+
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_THADC_ANALOG, MT_ADIE_ANA_EN_MASK |
+			      FIELD_PREP(MT_ADIE_VRPI_SEL_EFUSE_MASK, 5) |
+			      FIELD_PREP(MT_ADIE_PGA_GAIN_EFUSE_MASK, 3));
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_THADC_SLOP, MT_ADIE_ANA_EN_MASK |
+			      FIELD_PREP(MT_ADIE_LDO_CTRL_EFUSE_MASK, 2));
+	*bg = (u32)~MT_ADIE_VRPI_SEL_CR_MASK;
+	*thadc = (u32)~(MT_ADIE_PGA_GAIN_MASK | MT_ADIE_LDO_CTRL_MASK);
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_thermal_cal(dev, 0), 0);
+	KUNIT_EXPECT_EQ(test, *bg, (u32)~MT_ADIE_VRPI_SEL_CR_MASK |
+			FIELD_PREP(MT_ADIE_VRPI_SEL_CR_MASK, 5));
+	KUNIT_EXPECT_EQ(test, *thadc,
+			(u32)~(MT_ADIE_PGA_GAIN_MASK | MT_ADIE_LDO_CTRL_MASK) |
+			FIELD_PREP(MT_ADIE_PGA_GAIN_MASK, 3) |
+			FIELD_PREP(MT_ADIE_LDO_CTRL_MASK, 2));
+}
+
+/* Efuse words without their enable bit leave the thermal ADC as it is. */
+static void mt7915_soc_test_thermal_cal_unset(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+
+	mt7915_soc_test_efuse(t, 1, MT_ADIE_THADC_ANALOG,
+			      FIELD_PREP(MT_ADIE_VRPI_SEL_EFUSE_MASK, 5));
+	mt7915_soc_test_efuse(t, 1, MT_ADIE_THADC_SLOP,
+			      FIELD_PREP(MT_ADIE_LDO_CTRL_EFUSE_MASK, 2));
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_thermal_cal(dev, 1), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 1,
+			MT_ADIE_RG_TOP_THADC_BG), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 1, MT_ADIE_RG_TOP_THADC),
+			0);
+}
+
+/* SPI polls one valid efuse read takes: efuse mode, two control updates,
+ * waiting for the kick, the status and the data
+ */
+#define MT7915_SOC_TEST_EFUSE_POLLS	(2 + 4 + 4 + 2 + 2 + 2)
+
+/* A failure in a crystal trim (here the first trim word's read, on an
+ * MT7975 and an MT7976) ends the A-die configuration there: no patch.
+ */
+static void mt7915_soc_test_adie_cfg_trim_error(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+
+	mt7915_soc_test_efuse_zero(t, 0);
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_7975_XTAL_EN, BIT(1));
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_XO_TRIM_FLOW, BIT(1));
+
+	/* clocks and co-clock, thermal (two words), the trim enable word */
+	t->spi_ok = 2 + 4 + 3 * MT7915_SOC_TEST_EFUSE_POLLS;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_cfg(dev, 0,
+			MT7915_SOC_TEST_ADIE(0x7975, 0)), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0, 0x348), 0);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+
+	/* clocks, thermal, the trim flow word */
+	t->spi_ok = 2 + 3 * MT7915_SOC_TEST_EFUSE_POLLS;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_cfg(dev, 0,
+			MT7915_SOC_TEST_ADIE(0x7976, 0)), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0, MT_ADIE_RG_XO_01), 0);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+}
+
+/* A failed or invalid efuse read must not be taken for a calibration. */
+static void mt7915_soc_test_thermal_cal_no_efuse(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t;
+
+	kunit_skip(test, "driver bug: mt7986_wmac_adie_thermal_cal() applies its trims on an efuse read error (ret || ...) and tests an uninitialized word when the efuse word isn't valid");
+
+	t = mt7915_soc_test_init(test, &dev);
+	t->efuse_stuck = true;
+	KUNIT_EXPECT_NE(test, mt7986_wmac_adie_thermal_cal(dev, 0), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0,
+			MT_ADIE_RG_TOP_THADC_BG), 0);
+}
+
+/* The MT7976's crystal trim: 64 unless the efuse enables it; else the
+ * coarse trim adjusted up or down by the fine one, kept within 0..127.
+ */
+static void mt7915_soc_test_xo_trim_7976(struct kunit *test)
+{
+	static const struct {
+		u32 axm, trim1;
+		int result;
+	} cases[] = {
+		{ 0x40, MT_ADIE_XO_TRIM_EN_MASK | 0x10, 64 },
+		{ MT_ADIE_XO_TRIM_EN_MASK | 0x40,
+		  MT_ADIE_XO_TRIM_EN_MASK | 0x10, 0x50 },
+		{ MT_ADIE_XO_TRIM_EN_MASK | 0x40, MT_ADIE_XO_TRIM_EN_MASK |
+		  MT_ADIE_XTAL_DECREASE_MASK | 0x10, 0x30 },
+		{ MT_ADIE_XO_TRIM_EN_MASK | 0x40, 0x10, 0x40 },
+		{ MT_ADIE_XO_TRIM_EN_MASK | 0x7f,
+		  MT_ADIE_XO_TRIM_EN_MASK | 0x20, 127 },
+		{ MT_ADIE_XO_TRIM_EN_MASK | 0x05, MT_ADIE_XO_TRIM_EN_MASK |
+		  MT_ADIE_XTAL_DECREASE_MASK | 0x20, 0 },
+	};
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	int i, result;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		mt7915_soc_test_efuse(t, 0, MT_ADIE_XTAL_AXM_80M_OSC,
+				      cases[i].axm);
+		mt7915_soc_test_efuse(t, 0, MT_ADIE_XTAL_TRIM1_80M_OSC,
+				      cases[i].trim1);
+		result = -1;
+		KUNIT_EXPECT_EQ(test, mt7986_read_efuse_xo_trim_7976(dev, 0,
+				false, &result), 0);
+		KUNIT_EXPECT_EQ_MSG(test, result, cases[i].result, "case %d", i);
+	}
+
+	/* the 40 MHz trims are separate words */
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_XTAL_AXM_40M_OSC,
+			      MT_ADIE_XO_TRIM_EN_MASK | 0x20);
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_XTAL_TRIM1_40M_OSC,
+			      MT_ADIE_XO_TRIM_EN_MASK | 0x01);
+	KUNIT_EXPECT_EQ(test, mt7986_read_efuse_xo_trim_7976(dev, 0, true,
+			&result), 0);
+	KUNIT_EXPECT_EQ(test, result, 0x21);
+}
+
+/* With the trim flow enabled, an 80 MHz-strapped MT7976 gets its 80 MHz
+ * trim in both crystal load capacitors; without it nothing is touched.
+ */
+static void mt7915_soc_test_xtal_trim_7976(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+
+	mt7915_soc_test_efuse_zero(t, 0);
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_xtal_trim_7976(dev, 0), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0, MT_ADIE_XTAL_C1), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0, MT_ADIE_XTAL_C2), 0);
+
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_XO_TRIM_FLOW, BIT(1));
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_XTAL_AXM_80M_OSC,
+			      MT_ADIE_XO_TRIM_EN_MASK | 0x40);
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_XTAL_TRIM1_80M_OSC,
+			      MT_ADIE_XO_TRIM_EN_MASK |
+			      MT_ADIE_XTAL_DECREASE_MASK | 0x10);
+	t->adie[0].regs[MT_ADIE_XTAL_C1 / 4] = 0x00ffffff;
+	t->adie[0].regs[MT_ADIE_XTAL_C2 / 4] = 0x00123456;
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_xtal_trim_7976(dev, 0), 0);
+	KUNIT_EXPECT_EQ(test, t->adie[0].regs[MT_ADIE_XTAL_C1 / 4], 0x30ffffff);
+	KUNIT_EXPECT_EQ(test, t->adie[0].regs[MT_ADIE_XTAL_C2 / 4], 0x30123456);
+}
