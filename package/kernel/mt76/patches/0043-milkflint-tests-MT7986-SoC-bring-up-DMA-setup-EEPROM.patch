+/* AFE calibration on an MT7975 (band 0's AFE): enable the WBG calibration,
+ * pulse the RC calibration, bring the PLLs up, run the tx calibrations for
+ * BT and the four WiFi paths, then everything off again.
+ */
+static void mt7915_soc_test_afe_cal(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 txcal = MT_AFE_RG_WBG_EN_TXCAL_BT | MT_AFE_RG_WBG_EN_TXCAL_WF0 |
+		    MT_AFE_RG_WBG_EN_TXCAL_WF1 | MT_AFE_RG_WBG_EN_TXCAL_WF2 |
+		    MT_AFE_RG_WBG_EN_TXCAL_WF3;
+
+	mt7915_soc_test_set_reg(MT_AFE_DIG_EN_01(0), BIT(9));
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_afe_cal(dev, 0, false,
+			MT7915_SOC_TEST_ADIE(0x7975, 0)), 0);
+
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_first_wr(t, 0,
+			MT_AFE_RG_ENCAL_WBTAC_IF_SW), 0x80000000);
+	KUNIT_EXPECT_EQ(test, t->wr[t->n_wr - 1].addr,
+			MT_AFE_RG_ENCAL_WBTAC_IF_SW);
+	KUNIT_EXPECT_EQ(test, t->wr[t->n_wr - 1].val, 0x5);
+
+	KUNIT_EXPECT_GE(test, mt7915_soc_test_n_rd(t, MT_AFE_DIG_EN_01(0),
+			MT_AFE_RG_WBG_EN_RCK_MASK), 1);
+	KUNIT_EXPECT_GE(test, mt7915_soc_test_n_rd(t, MT_AFE_DIG_EN_01(0),
+			txcal), 1);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT_AFE_DIG_EN_01(0),
+			MT_AFE_RG_WBG_EN_TXCAL_WF4), 0);
+	KUNIT_EXPECT_GE(test, mt7915_soc_test_n_rd(t, MT_AFE_DIG_EN_03(0),
+			MT_AFE_RG_WBG_EN_PLL_UP_MASK), 1);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_AFE_DIG_EN_01(0)), BIT(9));
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_AFE_DIG_EN_03(0)), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT_AFE_DIG_EN_01(1), 0),
+			0);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+
+	/* the MT7981 calibrates a fifth WiFi path */
+	t->n_rd = 0;
+	dev->mt76.rev = 0x79810000;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_afe_cal(dev, 0, false,
+			MT7915_SOC_TEST_ADIE(0x7975, 0)), 0);
+	dev->mt76.rev = 0x79860000;
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT_AFE_DIG_EN_01(0),
+			txcal | MT_AFE_RG_WBG_EN_TXCAL_WF4), 1);
+
+	/* if the WBG calibration can't be enabled nothing else is done */
+	t->n_rd = 0;
+	t->spi_ok = 0;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_afe_cal(dev, 0, false,
+			MT7915_SOC_TEST_ADIE(0x7975, 0)), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT_AFE_DIG_EN_01(0), 0),
+			0);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+}
