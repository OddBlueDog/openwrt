+	MT76_EEPROM_TEST_S8S(test, lo, "rates-ru",
+			     7, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10);
+	MT76_EEPROM_TEST_S8S(test, lo, "paths-ofdm", 70, 54, 70, 70);
+	MT76_EEPROM_TEST_S8S(test, lo, "paths-ofdm-bf", 40, 100, 100, 45);
