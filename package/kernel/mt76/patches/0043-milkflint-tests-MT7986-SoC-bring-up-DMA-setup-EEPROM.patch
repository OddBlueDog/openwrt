+/* An A-die that is neither only gets its clocks; an SPI failure ends the
+ * configuration where it happens, with the error and the semaphore
+ * released.
+ */
+static void mt7915_soc_test_adie_cfg_other(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_cfg(dev, 0, 0x1234), 0);
+	KUNIT_EXPECT_EQ(test, t->n_wr, 1);
+	KUNIT_EXPECT_EQ(test, t->wr[0].addr, MT_ADIE_CLK_EN);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+
+	t->spi_ok = 0;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_cfg(dev, 0,
+			MT7915_SOC_TEST_ADIE(0x7976, 0)), -ETIMEDOUT);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+
+	/* failing after the clocks: an MT7975's co-clock, an MT7976's DBDC
+	 * clock select; nothing after them is written
+	 */
+	t->n_wr = 0;
+	t->spi_ok = 2;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_cfg(dev, 0,
+			MT7915_SOC_TEST_ADIE(0x7975, 0)), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, t->n_wr, 1);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+
+	t->n_wr = 0;
+	t->spi_ok = 2;
+	t->sku[MT_TOP_POS_SKU / 4] = MT_TOP_POS_SKU_ADIE_DBDC_MASK;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_cfg(dev, 0,
+			MT7915_SOC_TEST_ADIE(0x7976, 0)), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, t->n_wr, 1);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+}
