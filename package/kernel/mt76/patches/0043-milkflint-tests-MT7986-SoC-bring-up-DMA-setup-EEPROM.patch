+/* The limits come from the node of the country (case-insensitive, any of
+ * its list), else of the DFS region, else the last node naming neither.
+ */
+static void mt76_eeprom_test_limits_node(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	struct device_node *np = mt76_eeprom_test_of(test, dev);
+	struct device_node *pl, *us, *fcc, *etsi, *any2;
+
+	KUNIT_EXPECT_NULL(test, mt76_find_power_limits_node(dev));
+
+	pl = mt76_eeprom_test_node(test, np, "power-limits");
+	us = mt76_eeprom_test_node(test, pl, "us");
+	MT76_EEPROM_TEST_STRS(test, us, "country", "US\0CA");
+	fcc = mt76_eeprom_test_node(test, pl, "fcc");
+	MT76_EEPROM_TEST_STRS(test, fcc, "regdomain", "FCC");
+	mt76_eeprom_test_node(test, pl, "any1");
+	etsi = mt76_eeprom_test_node(test, pl, "etsi");
+	MT76_EEPROM_TEST_STRS(test, etsi, "regdomain", "etsi\0jp");
+	any2 = mt76_eeprom_test_node(test, pl, "any2");
+
+	mt76_eeprom_test_region(dev, "ca", NL80211_DFS_FCC);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_find_power_limits_node(dev), us);
+	mt76_eeprom_test_region(dev, "XX", NL80211_DFS_FCC);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_find_power_limits_node(dev), fcc);
+	mt76_eeprom_test_region(dev, "XX", NL80211_DFS_ETSI);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_find_power_limits_node(dev), etsi);
+	mt76_eeprom_test_region(dev, "XX", NL80211_DFS_JP);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_find_power_limits_node(dev), etsi);
+	mt76_eeprom_test_region(dev, "XX", NL80211_DFS_UNSET);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_find_power_limits_node(dev), any2);
+	mt76_eeprom_test_region(dev, "", 99);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_find_power_limits_node(dev), any2);
+
+	/* no fallback: nothing */
+	fcc->sibling = etsi;
+	etsi->sibling = NULL;
+	mt76_eeprom_test_region(dev, "XX", NL80211_DFS_UNSET);
+	KUNIT_EXPECT_NULL(test, mt76_find_power_limits_node(dev));
+}
