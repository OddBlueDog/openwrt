+/* The MT7975's crystal trim: the coarse trim adjusted by up to three fine
+ * trims, each only if enabled.
+ */
+static void mt7915_soc_test_xo_trim_7975(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 result = 0x40;
+
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_7975_XO_TRIM2,
+			      MT_ADIE_XO_TRIM_EN_MASK | 0x10);
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_7975_XO_TRIM3,
+			      MT_ADIE_XO_TRIM_EN_MASK |
+			      MT_ADIE_XTAL_DECREASE_MASK | 0x08);
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_7975_XO_TRIM4, 0x3f);
+
+	KUNIT_EXPECT_EQ(test, mt7986_read_efuse_xo_trim_7975(dev, 0,
+			MT_ADIE_7975_XO_TRIM2, &result), 0);
+	KUNIT_EXPECT_EQ(test, result, 0x50);
+	KUNIT_EXPECT_EQ(test, mt7986_read_efuse_xo_trim_7975(dev, 0,
+			MT_ADIE_7975_XO_TRIM3, &result), 0);
+	KUNIT_EXPECT_EQ(test, result, 0x48);
+	KUNIT_EXPECT_EQ(test, mt7986_read_efuse_xo_trim_7975(dev, 0,
+			MT_ADIE_7975_XO_TRIM4, &result), 0);
+	KUNIT_EXPECT_EQ(test, result, 0x48);
+}
