+/* --- A-die configuration -------------------------------------------------- */
+
+/* An MT7975: clocks on, the co-clock bit, its calibrations and its patch,
+ * all on that A-die and under the SPI semaphore.
+ */
+static void mt7915_soc_test_adie_cfg_7975(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 type = MT7915_SOC_TEST_ADIE(0, 0x7975);
+
+	mt7915_soc_test_efuse_zero(t, 1);
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_cfg(dev, 1, type), 0);
+	KUNIT_ASSERT_GT(test, t->n_wr, 0);
+	KUNIT_EXPECT_EQ(test, t->wr[0].addr, MT_ADIE_CLK_EN);
+	KUNIT_EXPECT_EQ(test, t->wr[0].val, 0xffffffff);
+	/* the co-clock bit right after the clocks (the patch rewrites it) */
+	KUNIT_EXPECT_EQ(test, t->wr[1].addr, MT_ADIE_7975_COCLK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 1, MT_ADIE_7975_COCLK), 2);
+	KUNIT_EXPECT_EQ(test, t->wr[t->n_wr - 1].addr, 0x2c8);
+	KUNIT_EXPECT_EQ(test, t->wr[t->n_wr - 1].val, 0x72);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0, MT_ADIE_CLK_EN), 0);
+	KUNIT_EXPECT_EQ(test, t->n_locks, 1);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+}
