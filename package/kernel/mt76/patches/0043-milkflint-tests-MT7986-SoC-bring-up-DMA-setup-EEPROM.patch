+/* A channel's limits are in the first node whose ranges include it;
+ * "channels" with less than a range is ignored. The stream delta is the
+ * entry for the number of streams, 0 if there's none.
+ */
+static void mt76_eeprom_test_channel_node(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	struct device_node *np = mt76_eeprom_test_of(test, dev);
+	struct ieee80211_channel chan = { .band = NL80211_BAND_5GHZ };
+	struct device_node *a, *b, *c;
+
+	a = mt76_eeprom_test_node(test, np, "a");
+	MT76_EEPROM_TEST_CELLS(test, a, "channels", 36, 48, 52, 64);
+	MT76_EEPROM_TEST_CELLS(test, a, "txs-delta", 6, 4, 2);
+	b = mt76_eeprom_test_node(test, np, "b");
+	MT76_EEPROM_TEST_CELLS(test, b, "channels", 100);
+	c = mt76_eeprom_test_node(test, np, "c");
+	MT76_EEPROM_TEST_CELLS(test, c, "channels", 100, 144);
+	mt76_eeprom_test_node(test, np, "d");
+
+	chan.hw_value = 36;
+	KUNIT_EXPECT_PTR_EQ(test, mt76_find_channel_node(np, &chan), a);
+	chan.hw_value = 60;
+	KUNIT_EXPECT_PTR_EQ(test, mt76_find_channel_node(np, &chan), a);
+	chan.hw_value = 50;
+	KUNIT_EXPECT_NULL(test, mt76_find_channel_node(np, &chan));
+	chan.hw_value = 100;
+	KUNIT_EXPECT_PTR_EQ(test, mt76_find_channel_node(np, &chan), c);
+	chan.hw_value = 149;
+	KUNIT_EXPECT_NULL(test, mt76_find_channel_node(np, &chan));
+
+	KUNIT_EXPECT_EQ(test, mt76_get_txs_delta(a, 1), 6);
+	KUNIT_EXPECT_EQ(test, mt76_get_txs_delta(a, 3), 2);
+	KUNIT_EXPECT_EQ(test, mt76_get_txs_delta(a, 4), 0);
+	KUNIT_EXPECT_EQ(test, mt76_get_txs_delta(c, 1), 0);
+}
