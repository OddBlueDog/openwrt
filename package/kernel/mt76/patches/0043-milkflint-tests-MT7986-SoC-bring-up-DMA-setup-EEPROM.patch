+/* The band's own node (matched by "reg") gives its address; a band without
+ * one, or with an invalid one, gets the device's.
+ */
+static void mt76_eeprom_test_override_dt(struct kunit *test)
+{
+	static const u8 dev_mac[ETH_ALEN] = { 0x00, 0xaa, 0xbb, 0xcc, 0xdd, 1 };
+	static const u8 band_mac[ETH_ALEN] = { 0x00, 0xaa, 0xbb, 0xcc, 0xdd, 2 };
+	static const u8 bad_mac[ETH_ALEN] = { 0x01, 0xaa, 0xbb, 0xcc, 0xdd, 3 };
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	struct device_node *np = mt76_eeprom_test_of(test, dev);
+	struct mt76_phy *phy = &dev->phy;
+	struct device_node *band;
+
+	mt76_eeprom_test_prop(test, np, "local-mac-address", dev_mac, ETH_ALEN);
+	/* not a band: no "reg" */
+	band = mt76_eeprom_test_node(test, np, "led");
+	mt76_eeprom_test_prop(test, band, "local-mac-address", band_mac,
+			      ETH_ALEN);
+	band = mt76_eeprom_test_node(test, np, "band@0");
+	MT76_EEPROM_TEST_CELLS(test, band, "reg", 0);
+	band = mt76_eeprom_test_node(test, np, "band@1");
+	MT76_EEPROM_TEST_CELLS(test, band, "reg", 1);
+	mt76_eeprom_test_prop(test, band, "local-mac-address", band_mac,
+			      ETH_ALEN);
+	band = mt76_eeprom_test_node(test, np, "band@2");
+	MT76_EEPROM_TEST_CELLS(test, band, "reg", 2);
+	mt76_eeprom_test_prop(test, band, "local-mac-address", bad_mac,
+			      ETH_ALEN);
+
+	phy->band_idx = 0;
+	KUNIT_EXPECT_EQ(test, mt76_eeprom_override(phy), 0);
+	mt76_eeprom_test_strip(np);
+	KUNIT_EXPECT_MEMEQ(test, phy->macaddr, dev_mac, ETH_ALEN);
+
+	phy->band_idx = 1;
+	KUNIT_EXPECT_EQ(test, mt76_eeprom_override(phy), 0);
+	mt76_eeprom_test_strip(np);
+	KUNIT_EXPECT_MEMEQ(test, phy->macaddr, band_mac, ETH_ALEN);
+
+	phy->band_idx = 2;
+	KUNIT_EXPECT_EQ(test, mt76_eeprom_override(phy), 0);
+	mt76_eeprom_test_strip(np);
+	KUNIT_EXPECT_MEMEQ(test, phy->macaddr, dev_mac, ETH_ALEN);
+}
