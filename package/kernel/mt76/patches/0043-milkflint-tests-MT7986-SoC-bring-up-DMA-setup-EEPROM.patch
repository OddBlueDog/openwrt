+/* give the device a pin state @name (no pins), for mt7986_wmac_gpio_setup() */
+static void mt7915_soc_test_pinctrl(struct kunit *test, struct mt7915_dev *dev,
+				    const char *name)
+{
+	struct pinctrl_map *map = kunit_kzalloc(test, sizeof(*map), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, map);
+	map->dev_name = dev_name(dev->mt76.dev);
+	map->name = name;
+	map->type = PIN_MAP_TYPE_DUMMY_STATE;
+	KUNIT_ASSERT_EQ(test, pinctrl_register_mappings(map, 1), 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_soc_test_unmap, map), 0);
+}
+
+/* The A-die pins: "default" for a single-band A-die, "dbdc" for the DBDC
+ * one, as the SKU says.
+ */
+static void mt7915_soc_test_gpio_setup(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+
+	mt7915_soc_test_pinctrl(test, dev, "default");
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_gpio_setup(dev), 0);
+	t->sku[MT_TOP_POS_SKU / 4] = MT_TOP_POS_SKU_ADIE_DBDC_MASK;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_gpio_setup(dev), -EINVAL);
+}
+
+/* The consys reset: released with the fast power-on control set in the SKU
+ * window, asserted without touching it; no reset line is not an error.
+ */
+static void mt7915_soc_test_consys_reset(struct kunit *test)
+{
+	int (*reset)(struct mt7915_dev *dev, bool enable) =
+		mt7986_wmac_consys_reset;
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+
+	OPTIMIZER_HIDE_VAR(reset);
+	t->sku[MT_TOP_POS_FAST_CTRL / 4] = BIT(1);
+	KUNIT_EXPECT_EQ(test, reset(dev, false), 0);
+	KUNIT_EXPECT_EQ(test, t->sku[MT_TOP_POS_FAST_CTRL / 4], BIT(1));
+	KUNIT_EXPECT_EQ(test, reset(dev, true), 0);
+	KUNIT_EXPECT_EQ(test, t->sku[MT_TOP_POS_FAST_CTRL / 4],
+			BIT(1) | MT_TOP_POS_FAST_EN_MASK);
+}
+
+/* Without its pin states the bring-up stops after the consys reset, before
+ * touching the bus protection.
+ */
+static void mt7915_soc_test_enable_no_pins(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 slpprot = MT_INFRACFG_RX_EN_MASK | MT_INFRACFG_TX_EN_MASK;
+
+	t->dcm[MT_INFRACFG_AP2CONN_SLPPROT / 4] = slpprot;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_enable(dev), -EINVAL);
+	KUNIT_EXPECT_EQ(test, t->sku[MT_TOP_POS_FAST_CTRL / 4],
+			MT_TOP_POS_FAST_EN_MASK);
+	KUNIT_EXPECT_EQ(test, t->dcm[MT_INFRACFG_AP2CONN_SLPPROT / 4], slpprot);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT_CONN_INFRA_BASE, 0), 0);
+}
+
+/* With its pins the bring-up drops the AP/conninfra bus protection both
+ * ways, checks conninfra, and (no reserved memory here) stops at the
+ * conninfra setup.
+ */
+static void mt7915_soc_test_enable(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 slpprot = MT_INFRACFG_RX_EN_MASK | MT_INFRACFG_TX_EN_MASK;
+
+	mt7915_soc_test_pinctrl(test, dev, "dbdc");
+	t->sku[MT_TOP_POS_SKU / 4] = MT_TOP_POS_SKU_ADIE_DBDC_MASK;
+	t->dcm[MT_INFRACFG_AP2CONN_SLPPROT / 4] = slpprot | BIT(8);
+	t->dcm[MT_INFRACFG_CONN2AP_SLPPROT / 4] = slpprot;
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_enable(dev), -EINVAL);
+	KUNIT_EXPECT_EQ(test, t->dcm[MT_INFRACFG_AP2CONN_SLPPROT / 4], BIT(8));
+	KUNIT_EXPECT_EQ(test, t->dcm[MT_INFRACFG_CONN2AP_SLPPROT / 4], 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT_CONN_INFRA_BASE, 0), 1);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_INFRA_BUS_EMI_START), 0);
+}
+
+/* Shutting the WiFi subsystem down: woken first, bus protection raised and
+ * acked, power off, PLLs back to their defaults, the EMI and infra requests
+ * pulsed, allowed to sleep, then the AP side protected and the consys reset.
+ */
+static void mt7915_soc_test_disable(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 val;
+
+	mt7915_soc_test_set_reg(MT_TOP_WFSYS_PWR, MT_TOP_PWR_EN_MASK);
+
+	mt7986_wmac_disable(dev);
+
+	KUNIT_EXPECT_GE(test, mt7915_soc_test_n_rd(t, MT_TOP_WFSYS_WAKEUP,
+			MT_TOP_WFSYS_WAKEUP_MASK), 1);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_TOP_WFSYS_WAKEUP), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_CONN_INFRA_WF_SLP_PROT),
+			MT_CONN_INFRA_WF_SLP_PROT_MASK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_TOP_WFSYS_PWR),
+			MT_TOP_PWR_KEY);
+
+	val = mt7915_soc_test_reg(MT_AFE_DIG_EN_02(0));
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_AFE_MCU_BPLL_CFG_MASK, val), 2);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_AFE_WPLL_CFG_MASK, val), 2);
+
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT_CONN_INFRA_EMI_REQ,
+			MT_CONN_INFRA_EMI_REQ_MASK), 1);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT_CONN_INFRA_EMI_REQ,
+			MT_CONN_INFRA_INFRA_REQ_MASK), 1);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_CONN_INFRA_EMI_REQ), 0);
+
+	/* the AP side protection was asked for */
+	KUNIT_EXPECT_TRUE(test, t->dcm[MT_INFRACFG_AP2CONN_SLPPROT / 4] &
+			  MT_INFRACFG_RX_EN_MASK);
+}
+
+/* --- platform probe ------------------------------------------------------- */
+
+static void mt7915_soc_test_pdev_put(void *pdev)
+{
+	platform_device_unregister(pdev);
+}
+
+/* A platform device with @n register windows from @res. The windows are in
+ * QEMU virt's (empty) platform bus range: they get mapped, never accessed.
+ */
+static struct platform_device *
+mt7915_soc_test_pdev(struct kunit *test, const struct resource *res, int n)
+{
+	struct platform_device *pdev;
+
+	pdev = platform_device_register_simple("mt7915e-soc-test",
+					       PLATFORM_DEVID_AUTO, res, n);
+	KUNIT_ASSERT_FALSE(test, IS_ERR(pdev));
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_soc_test_pdev_put, pdev), 0);
+	return pdev;
+}
+
+/* A WMAC without its register window is refused before anything is set
+ * up.
+ */
+static int mt7915_soc_test_probe(struct platform_device *pdev)
+{
+	int ret;
+
+	/* as if matched to the driver (for its OF match data) */
+	pdev->dev.driver = &mt798x_wmac_driver.driver;
+	ret = mt798x_wmac_probe(pdev);
+	pdev->dev.driver = NULL;
+
+	return ret;
+}
+
+static void mt7915_soc_test_probe_no_window(struct kunit *test)
+{
+	struct platform_device *pdev = mt7915_soc_test_pdev(test, NULL, 0);
+
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_probe(pdev), -EINVAL);
+}
+
+/* A WMAC that isn't an MT798x (no device-tree match here) is refused once
+ * its window is mapped, before anything touches it, and nothing is left
+ * bound.
+ */
+static void mt7915_soc_test_probe_unknown_chip(struct kunit *test)
+{
+	static const struct resource res[] = {
+		DEFINE_RES_MEM(0x0c000000, SZ_8M),
+	};
+	struct platform_device *pdev;
+
+	pdev = mt7915_soc_test_pdev(test, res, ARRAY_SIZE(res));
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_probe(pdev), -EINVAL);
+	KUNIT_EXPECT_NULL(test, platform_get_drvdata(pdev));
+}
+
+/* Without the INFRACFG window the SoC setup fails (missing clocks are only
+ * reported).
+ */
+static void mt7915_soc_test_wmac_init(struct kunit *test)
+{
+	struct platform_device *pdev = mt7915_soc_test_pdev(test, NULL, 0);
+	struct mt7915_dev *dev;
+	struct device *kdev;
+	int ret;
+
+	mt7915_soc_test_init(test, &dev);
+	kdev = dev->mt76.dev;
+	dev->sku = NULL;
+	dev->mt76.dev = &pdev->dev;
+	ret = mt798x_wmac_init(dev);
+	dev->mt76.dev = kdev;
+
+	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	KUNIT_EXPECT_TRUE(test, IS_ERR(dev->dcm));
+	KUNIT_EXPECT_NULL(test, dev->sku);
+	dev->dcm = NULL;
+}
+
+#define MT7915_SOC_TEST_PDEV_ID		7986
+
+struct mt7915_soc_test_clk {
+	struct clk_hw *hw;
+	struct clk_lookup *cl;
+};
+
+static void mt7915_soc_test_clk_del(void *data)
+{
+	struct mt7915_soc_test_clk *c = data;
+	struct clk *clk = clk_hw_get_clk(c->hw, NULL);
+
+	/* what the driver enabled */
+	while (!IS_ERR(clk) && clk_hw_is_enabled(c->hw))
+		clk_disable_unprepare(clk);
+	if (!IS_ERR(clk))
+		clk_put(clk);
+	clkdev_drop(c->cl);
+	clk_hw_unregister_fixed_rate(c->hw);
+}
+
+/* a fixed clock @con_id for the platform device MT7915_SOC_TEST_PDEV_ID */
+static struct clk_hw *mt7915_soc_test_clk(struct kunit *test,
+					  const char *name, const char *con_id)
+{
+	struct mt7915_soc_test_clk *c = kunit_kzalloc(test, sizeof(*c),
+						      GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, c);
+	c->hw = clk_hw_register_fixed_rate(NULL, name, NULL, 0, 40000000);
+	KUNIT_ASSERT_FALSE(test, IS_ERR(c->hw));
+	c->cl = clkdev_hw_create(c->hw, con_id, "mt7915e-soc-test.%d",
+				 MT7915_SOC_TEST_PDEV_ID);
+	if (!c->cl)
+		clk_hw_unregister_fixed_rate(c->hw);
+	KUNIT_ASSERT_NOT_NULL(test, c->cl);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_soc_test_clk_del, c), 0);
+	return c->hw;
+}
+
+/* With its clocks and its INFRACFG and SKU windows the SoC setup enables
+ * the clocks, maps both windows, then needs its consys reset line (none
+ * here).
+ */
+static void mt7915_soc_test_wmac_init_windows(struct kunit *test)
+{
+	static const struct resource res[] = {
+		DEFINE_RES_MEM(0x0c000000, SZ_4K),
+		DEFINE_RES_MEM(0x0c001000, SZ_4K),
+		DEFINE_RES_MEM(0x0c002000, SZ_4K),
+	};
+	struct clk_hw *mcu, *ap2conn;
+	struct platform_device *pdev;
+	struct mt7915_soc_test *t;
+	struct mt7915_dev *dev;
+	struct device *kdev;
+	int ret;
+
+	/* before the device: removed after it */
+	mcu = mt7915_soc_test_clk(test, "mt7915e-soc-test-mcu", "mcu");
+	ap2conn = mt7915_soc_test_clk(test, "mt7915e-soc-test-ap2conn",
+				      "ap2conn");
+	pdev = platform_device_register_simple("mt7915e-soc-test",
+					       MT7915_SOC_TEST_PDEV_ID, res,
+					       ARRAY_SIZE(res));
+	KUNIT_ASSERT_FALSE(test, IS_ERR(pdev));
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_soc_test_pdev_put, pdev), 0);
+	t = mt7915_soc_test_init(test, &dev);
+	kdev = dev->mt76.dev;
+	dev->mt76.dev = &pdev->dev;
+	ret = mt798x_wmac_init(dev);
+	dev->mt76.dev = kdev;
+
+	KUNIT_EXPECT_EQ(test, ret, -ENOENT);
+	KUNIT_EXPECT_TRUE(test, clk_hw_is_enabled(mcu));
+	KUNIT_EXPECT_TRUE(test, clk_hw_is_enabled(ap2conn));
+	KUNIT_EXPECT_FALSE(test, IS_ERR_OR_NULL(dev->dcm));
+	KUNIT_EXPECT_FALSE(test, IS_ERR_OR_NULL(dev->sku));
+	KUNIT_EXPECT_PTR_NE(test, (void __force *)dev->dcm,
+			    (void __force *)dev->sku);
+	KUNIT_EXPECT_TRUE(test, IS_ERR(dev->rstc));
+	dev->dcm = (void __force __iomem *)t->dcm;
+	dev->sku = (void __force __iomem *)t->sku;
+	dev->rstc = NULL;
+}
+
+static struct kunit_case mt7915_soc_test_cases[] = {
+	KUNIT_CASE(mt7915_soc_test_spi_access),
+	KUNIT_CASE(mt7915_soc_test_spi_busy),
+	KUNIT_CASE(mt7915_soc_test_efuse_read),
+	KUNIT_CASE(mt7915_soc_test_thermal_cal),
+	KUNIT_CASE(mt7915_soc_test_thermal_cal_unset),
+	KUNIT_CASE(mt7915_soc_test_thermal_cal_no_efuse),
+	KUNIT_CASE(mt7915_soc_test_xo_trim_7976),
+	KUNIT_CASE(mt7915_soc_test_xtal_trim_7976),
+	KUNIT_CASE(mt7915_soc_test_xtal_trim_7976_40m),
+	KUNIT_CASE(mt7915_soc_test_patch_7976),
+	KUNIT_CASE(mt7915_soc_test_xo_trim_7975),
+	KUNIT_CASE(mt7915_soc_test_xtal_trim_7975),
+	KUNIT_CASE(mt7915_soc_test_xtal_trim_7975_value),
+	KUNIT_CASE(mt7915_soc_test_patch_7975),
+	KUNIT_CASE(mt7915_soc_test_adie_cfg_7975),
+	KUNIT_CASE(mt7915_soc_test_adie_cfg_7976),
+	KUNIT_CASE(mt7915_soc_test_adie_cfg_other),
+	KUNIT_CASE(mt7915_soc_test_adie_cfg_trim_error),
+	KUNIT_CASE(mt7915_soc_test_afe_cal),
+	KUNIT_CASE(mt7915_soc_test_afe_cal_dbdc),
+	KUNIT_CASE(mt7915_soc_test_adie_setup),
+	KUNIT_CASE(mt7915_soc_test_sku_setup),
+	KUNIT_CASE(mt7915_soc_test_sku_setup_error),
+	KUNIT_CASE(mt7915_soc_test_sku_update),
+	KUNIT_CASE(mt7915_soc_test_subsys_setting),
+	KUNIT_CASE(mt7915_soc_test_subsys_powerup),
+	KUNIT_CASE(mt7915_soc_test_subsys_powerup_no_infra),
+	KUNIT_CASE(mt7915_soc_test_top_wfsys_wakeup),
+	KUNIT_CASE(mt7915_soc_test_wfsys_powerup),
+	KUNIT_CASE(mt7915_soc_test_wfsys_powerup_no_ack),
+	KUNIT_CASE(mt7915_soc_test_coninfra_setup),
+	KUNIT_CASE(mt7915_soc_test_consys_reset),
+	KUNIT_CASE(mt7915_soc_test_gpio_setup),
+	KUNIT_CASE(mt7915_soc_test_enable_no_pins),
+	KUNIT_CASE(mt7915_soc_test_enable),
+	KUNIT_CASE(mt7915_soc_test_disable),
+	KUNIT_CASE(mt7915_soc_test_probe_no_window),
+	KUNIT_CASE(mt7915_soc_test_probe_unknown_chip),
+	KUNIT_CASE(mt7915_soc_test_wmac_init),
+	KUNIT_CASE(mt7915_soc_test_wmac_init_windows),
+	{}
+};
+
+static struct kunit_suite mt7915_soc_test_suite = {
+	.name = "mt7915-soc",
+	.test_cases = mt7915_soc_test_cases,
+};
+
+kunit_test_suites(&mt7915_soc_test_suite);
diff --git a/tests/eeprom-test.c b/tests/eeprom-test.c
new file mode 100644
index 00000000..e3512290
--- /dev/null
+++ b/tests/eeprom-test.c
@@ -0,0 +1,831 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for mt76's EEPROM and device-tree helpers (eeprom.c): where
+ * the EEPROM comes from, the MAC address override and the per-country tx
+ * power limits. Included at the end of eeprom.c when CONFIG_MT76_KUNIT_TEST
+ * is defined (milkflint's QEMU test build only).
+ *
+ * The device-tree nodes are built in memory and hung off the test device's
+ * of_node. They aren't part of the live tree, so a phandle can only point at
+ * a node of the VM's own device tree.
+ */
+#include <kunit/test.h>
+#include <linux/nvmem-provider.h>
+#include "fake.h"
+
+/* --- an in-memory device tree --------------------------------------------- */
+
+#ifdef CONFIG_OF_DYNAMIC
+static void mt76_eeprom_test_node_release(struct kobject *kobj)
+{
+}
+
+static const struct kobj_type mt76_eeprom_test_ktype = {
+	.release = mt76_eeprom_test_node_release,
+};
+#endif
+
+/* a node @name, the last child of @parent (if any) */
+static struct device_node *
+mt76_eeprom_test_node(struct kunit *test, struct device_node *parent,
+		      const char *name)
+{
+	struct device_node *np, **last;
+
+	np = kunit_kzalloc(test, sizeof(*np), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, np);
+	np->name = name;
+	np->full_name = name;
+#ifdef CONFIG_OF_DYNAMIC
+	kobject_init(&np->kobj, &mt76_eeprom_test_ktype);
+#endif
+	if (parent) {
+		np->parent = parent;
+		for (last = &parent->child; *last; last = &(*last)->sibling)
+			;
+		*last = np;
+	}
+
+	return np;
+}
+
+static void mt76_eeprom_test_prop(struct kunit *test, struct device_node *np,
+				  const char *name, const void *val, int len)
+{
+	struct property *pp = kunit_kzalloc(test, sizeof(*pp), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, pp);
+	pp->value = kunit_kzalloc(test, len ?: 1, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, pp->value);
+	memcpy(pp->value, val, len);
+	pp->length = len;
+	pp->name = (char *)name;
+	pp->next = np->properties;
+	np->properties = pp;
+}
+
+static void mt76_eeprom_test_u32s(struct kunit *test, struct device_node *np,
+				  const char *name, const u32 *val, int n)
+{
+	__be32 *be = kunit_kcalloc(test, n, sizeof(*be), GFP_KERNEL);
+	int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, be);
+	for (i = 0; i < n; i++)
+		be[i] = cpu_to_be32(val[i]);
+	mt76_eeprom_test_prop(test, np, name, be, n * sizeof(*be));
+}
+
+/* a property of cells / of bytes, e.g. MT76_EEPROM_TEST_CELLS(.., 36, 64) */
+#define MT76_EEPROM_TEST_CELLS(test, np, name, ...)			\
+	mt76_eeprom_test_u32s(test, np, name, (const u32[]){ __VA_ARGS__ }, \
+			      sizeof((const u32[]){ __VA_ARGS__ }) / sizeof(u32))
+#define MT76_EEPROM_TEST_S8S(test, np, name, ...)			\
+	mt76_eeprom_test_prop(test, np, name, (const s8[]){ __VA_ARGS__ }, \
+			      sizeof((const s8[]){ __VA_ARGS__ }))
+/* a string list property, e.g. "DE\0AT" */
+#define MT76_EEPROM_TEST_STRS(test, np, name, str)			\
+	mt76_eeprom_test_prop(test, np, name, str, sizeof(str))
+
+/* of_get_mac_address() records the address it found as a "mac-address"
+ * property of the node (an OpenWrt patch). These tests never create one, so
+ * drop what it added: kunit owns the rest.
+ */
+static void mt76_eeprom_test_strip(struct device_node *np)
+{
+	struct property **pp = &np->properties;
+	struct device_node *child;
+
+	while (*pp) {
+		struct property *p = *pp;
+
+		if (strcmp(p->name, "mac-address")) {
+			pp = &p->next;
+			continue;
+		}
+		*pp = p->next;
+		kfree(p->value);
+		kfree(p);
+	}
+	for (child = np->child; child; child = child->sibling)
+		mt76_eeprom_test_strip(child);
+}
+
+static void mt76_eeprom_test_of_reset(void *data)
+{
+	struct device *dev = data;
+
+	if (dev->of_node)
+		mt76_eeprom_test_strip(dev->of_node);
+	dev->of_node = NULL;
+}
+
+/* the device's own (empty) device-tree node, until @test ends */
+static struct device_node *mt76_eeprom_test_of(struct kunit *test,
+					       struct mt76_dev *dev)
+{
+	struct device_node *np = mt76_eeprom_test_node(test, NULL, "wifi");
+
+	dev->dev->of_node = np;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_eeprom_test_of_reset, dev->dev), 0);
+	return np;
+}
+
+/* a node of the VM's live device tree that has a phandle */
+static struct device_node *mt76_eeprom_test_live(struct kunit *test)
+{
+	struct device_node *np = of_find_node_with_property(NULL, "phandle");
+
+	if (!np || !np->phandle)
+		kunit_skip(test, "no device-tree node with a phandle");
+	of_node_put(np);
+	return np;
+}
+
+/* fake.h's mt76_test_hw_ops without the channel context emulation, which
+ * mac80211 6.18's ieee80211_alloc_hw_nm() requires (it WARNs and fails)
+ */
+static const struct ieee80211_ops mt76_eeprom_test_hw_ops = {
+	.tx = mt76_test_tx,
+	.start = mt76_test_start,
+	.stop = mt76_test_stop,
+	.add_interface = mt76_test_add_interface,
+	.remove_interface = mt76_test_remove_interface,
+	.config = mt76_test_config,
+	.configure_filter = mt76_test_configure_filter,
+	.wake_tx_queue = mt76_test_wake_tx_queue,
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
+};
+
+static struct mt76_dev *mt76_eeprom_test_dev(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_test_dev(test, sizeof(*dev),
+					     &mt76_eeprom_test_hw_ops, NULL);
+
+	dev->rev = 0x79860000;
+	return dev;
+}
+
+/* --- where the EEPROM comes from ------------------------------------------ */
+
+/* Without a device tree there's no EEPROM there: a zeroed buffer of the
+ * size asked for, for the driver to fill from efuse.
+ */
+static void mt76_eeprom_test_init_no_dt(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+
+	KUNIT_EXPECT_EQ(test, mt76_eeprom_init(dev, 64), 0);
+	KUNIT_EXPECT_EQ(test, dev->eeprom.size, 64);
+	KUNIT_ASSERT_NOT_NULL(test, dev->eeprom.data);
+	KUNIT_EXPECT_NULL(test, memchr_inv(dev->eeprom.data, 0, 64));
+}
+
+/* EEPROM data in the device tree is copied in and reported as found; data
+ * larger than the EEPROM is ignored.
+ */
+static void mt76_eeprom_test_init_dt_data(struct kunit *test)
+{
+	static const u8 data[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	struct device_node *np = mt76_eeprom_test_of(test, dev);
+	u8 *eep;
+
+	mt76_eeprom_test_prop(test, np, "mediatek,eeprom-data", data,
+			      sizeof(data));
+	KUNIT_EXPECT_EQ(test, mt76_eeprom_init(dev, 16), 1);
+	eep = dev->eeprom.data;
+	KUNIT_EXPECT_MEMEQ(test, eep, data, sizeof(data));
+	KUNIT_EXPECT_NULL(test, memchr_inv(eep + 8, 0, 8));
+
+	KUNIT_EXPECT_EQ(test, mt76_eeprom_init(dev, 4), 0);
+	KUNIT_EXPECT_NULL(test, memchr_inv(dev->eeprom.data, 0, 4));
+}
+
+/* An EEPROM in an MTD partition needs a phandle to an existing node naming
+ * an MTD device; otherwise it isn't there.
+ */
+static void mt76_eeprom_test_mtd(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	struct device_node *np, *live;
+	u8 buf[16];
+
+	KUNIT_EXPECT_EQ(test, mt76_get_of_data_from_mtd(dev, buf, 0,
+			sizeof(buf)), -ENOENT);
+
+	np = mt76_eeprom_test_of(test, dev);
+	KUNIT_EXPECT_EQ(test, mt76_get_of_data_from_mtd(dev, buf, 0,
+			sizeof(buf)), -ENOENT);
+
+	MT76_EEPROM_TEST_CELLS(test, np, "mediatek,mtd-eeprom", 0, 0x1000);
+	KUNIT_EXPECT_EQ(test, mt76_get_of_data_from_mtd(dev, buf, 0,
+			sizeof(buf)), -ENOENT);
+
+	np->properties = NULL;
+	MT76_EEPROM_TEST_CELLS(test, np, "mediatek,mtd-eeprom", 0x7ffffff0,
+			       0x1000);
+	KUNIT_EXPECT_EQ(test, mt76_get_of_data_from_mtd(dev, buf, 0,
+			sizeof(buf)), -EINVAL);
+
+	/* a real node, but no MTD device of its name */
+	live = mt76_eeprom_test_live(test);
+	np->properties = NULL;
+	MT76_EEPROM_TEST_CELLS(test, np, "mediatek,mtd-eeprom", live->phandle,
+			       0x1000);
+	KUNIT_EXPECT_EQ(test, mt76_get_of_data_from_mtd(dev, buf, 0,
+			sizeof(buf)), -ENODEV);
+}
+
+/* An EEPROM in an NVMEM cell: none without the cell; a cell whose provider
+ * hasn't probed yet says to try again later.
+ */
+static void mt76_eeprom_test_nvmem(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	struct device_node *np = mt76_eeprom_test_of(test, dev);
+	struct device_node *live;
+	u8 buf[16];
+
+	KUNIT_EXPECT_EQ(test, mt76_get_of_data_from_nvmem(dev, buf, "eeprom",
+			sizeof(buf)), -ENOENT);
+
+	live = mt76_eeprom_test_live(test);
+	MT76_EEPROM_TEST_CELLS(test, np, "nvmem-cells", live->phandle);
+	MT76_EEPROM_TEST_STRS(test, np, "nvmem-cell-names", "eeprom");
+	KUNIT_EXPECT_EQ(test, mt76_get_of_data_from_nvmem(dev, buf, "eeprom",
+			sizeof(buf)), -EPROBE_DEFER);
+	/* nothing by another name */
+	KUNIT_EXPECT_EQ(test, mt76_get_of_data_from_nvmem(dev, buf, "precal",
+			sizeof(buf)), -ENOENT);
+}
+
+static int mt76_eeprom_test_nvmem_read(void *priv, unsigned int offset,
+				       void *val, size_t bytes)
+{
+	memcpy(val, priv + offset, bytes);
+	return 0;
+}
+
+static void mt76_eeprom_test_nvmem_unregister(void *nvmem)
+{
+	nvmem_unregister(nvmem);
+}
+
+/* An NVMEM provider (for the device tree: @cell's parent) holding @data,
+ * with @cell its cell of @bytes at offset 0, until @test ends.
+ */
+static void mt76_eeprom_test_provider(struct kunit *test, struct mt76_dev *dev,
+				      struct device_node *cell, u8 *data,
+				      int size, int bytes)
+{
+	struct nvmem_config config = {
+		.dev = dev->dev,
+		.name = "mt76-eeprom-test",
+		.id = NVMEM_DEVID_AUTO,
+		.owner = THIS_MODULE,
+		.of_node = of_get_parent(cell),
+		.ignore_wp = true,
+		.read_only = true,
+		.reg_read = mt76_eeprom_test_nvmem_read,
+		.size = size,
+		.word_size = 1,
+		.stride = 1,
+		.priv = data,
+	};
+	struct nvmem_cell_info info = {
+		.name = "mt76-eeprom-test",
+		.bytes = bytes,
+		.np = cell,
+	};
+	struct nvmem_device *nvmem;
+
+	of_node_put(config.of_node);
+	KUNIT_ASSERT_NOT_NULL(test, config.of_node);
+	nvmem = nvmem_register(&config);
+	KUNIT_ASSERT_FALSE(test, IS_ERR(nvmem));
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_eeprom_test_nvmem_unregister, nvmem), 0);
+	KUNIT_ASSERT_EQ(test, nvmem_add_one_cell(nvmem, &info), 0);
+}
