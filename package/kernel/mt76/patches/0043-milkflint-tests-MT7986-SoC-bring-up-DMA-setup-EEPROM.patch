+/* With the trim flow enabled the MT7975's oscillator is set up: load
+ * capacitors, the fixed-trim enable dropped if the crystal is enabled, the
+ * trim latched; without it nothing is touched.
+ */
+static void mt7915_soc_test_xtal_trim_7975(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 *regs = t->adie[0].regs;
+
+	mt7915_soc_test_efuse_zero(t, 0);
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_xtal_trim_7975(dev, 0), 0);
+	/* only the efuse read of the flow word: mode, clear, kick */
+	KUNIT_EXPECT_EQ(test, t->n_wr, 3);
+
+	t->n_wr = 0;
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_7975_XTAL_EN, BIT(1));
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_7975_XTAL_CAL,
+			      MT_ADIE_XO_TRIM_EN_MASK | 0x40);
+	regs[MT_ADIE_7975_XTAL / 4] = MT_ADIE_7975_XTAL_EN_MASK;
+	regs[MT_ADIE_7975_XO_2 / 4] = MT_ADIE_7975_XO_2_FIX_EN | 0x5;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_xtal_trim_7975(dev, 0), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0, MT_ADIE_7975_XO_CTRL2),
+			1);
+	KUNIT_EXPECT_EQ(test, regs[MT_ADIE_7975_XO_2 / 4], 0x5);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0, MT_ADIE_7975_XO_CTRL6),
+			1);
+
+	/* crystal not enabled: the fixed trim stays */
+	t->n_wr = 0;
+	regs[MT_ADIE_7975_XTAL / 4] = 0;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_xtal_trim_7975(dev, 0), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0, MT_ADIE_7975_XO_2), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0, MT_ADIE_7975_XO_CTRL6),
+			1);
+}
+
+/* The trim computed from efuse must end up in the C1/C2 fields. */
+static void mt7915_soc_test_xtal_trim_7975_value(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t;
+
+	kunit_skip(test, "driver bug: mt7986_wmac_adie_xtal_trim_7975() builds the XO_CTRL2 value with FIELD_GET(C1/C2 mask, trim), which is always 0 for a 7-bit trim, so the efuse trim is never applied");
+
+	t = mt7915_soc_test_init(test, &dev);
+	mt7915_soc_test_efuse_zero(t, 0);
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_7975_XTAL_EN, BIT(1));
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_7975_XTAL_CAL,
+			      MT_ADIE_XO_TRIM_EN_MASK | 0x40);
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_xtal_trim_7975(dev, 0), 0);
+	KUNIT_EXPECT_EQ(test, t->adie[0].regs[MT_ADIE_7975_XO_CTRL2 / 4],
+			FIELD_PREP(MT_ADIE_7975_XO_CTRL2_C1_MASK, 0x40) |
+			FIELD_PREP(MT_ADIE_7975_XO_CTRL2_C2_MASK, 0x40));
+}
