+/* A 40 MHz-strapped MT7976 gets its 40 MHz trim in bits 23:16. */
+static void mt7915_soc_test_xtal_trim_7976_40m(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t;
+
+	kunit_skip(test, "driver bug: mt7986_wmac_adie_xtal_trim_7976() decodes the strap mode with FIELD_PREP(GENMASK(6, 4), val) instead of FIELD_GET, so the 40 MHz modes (3, 4, 6) never match and nothing is trimmed");
+
+	t = mt7915_soc_test_init(test, &dev);
+	mt7915_soc_test_efuse_zero(t, 0);
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_XO_TRIM_FLOW, BIT(1));
+	mt7915_soc_test_efuse(t, 0, MT_ADIE_XTAL_AXM_40M_OSC,
+			      MT_ADIE_XO_TRIM_EN_MASK | 0x22);
+	t->adie[0].regs[MT_ADIE_RG_STRAP_PIN_IN / 4] = FIELD_PREP(GENMASK(6, 4),
+								  3);
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_xtal_trim_7976(dev, 0), 0);
+	KUNIT_EXPECT_EQ(test, t->adie[0].regs[MT_ADIE_XTAL_C1 / 4],
+			0x22 << 16);
+}
