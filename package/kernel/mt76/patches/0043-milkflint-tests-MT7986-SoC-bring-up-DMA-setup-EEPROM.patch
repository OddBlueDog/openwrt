+/* The SKU is read from both A-dies' chip ids, after taking them out of
+ * reset.
+ */
+static void mt7915_soc_test_sku_setup(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 type = 0;
+
+	t->adie[0].regs[MT_ADIE_CHIP_ID / 4] = 0x79768a00;
+	t->adie[1].regs[MT_ADIE_CHIP_ID / 4] = 0x79751234;
+
+	KUNIT_EXPECT_EQ(test, mt798x_wmac_sku_setup(dev, &type), 0);
+	KUNIT_EXPECT_EQ(test, type, MT7915_SOC_TEST_ADIE(0x7976, 0x7975));
+	KUNIT_EXPECT_TRUE(test, is_7976(dev, 0, type));
+	KUNIT_EXPECT_TRUE(test, is_7975(dev, 1, type));
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_CONN_INFRA_ADIE_RESET),
+			MT_CONN_INFRA_ADIE1_RESET_MASK |
+			MT_CONN_INFRA_ADIE2_RESET_MASK);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+}
+
+/* An A-die that can't be read must fail the bring-up, not leave the SKU
+ * undefined.
+ */
+static void mt7915_soc_test_sku_setup_error(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t;
+	u32 type = 0;
+
+	kunit_skip(test, "driver bug: mt798x_wmac_sku_setup() returns 0 when an A-die chip id read fails, and mt7986_wmac_enable() goes on with its uninitialized adie_type");
+
+	t = mt7915_soc_test_init(test, &dev);
+	t->spi_ok = 0;
+	KUNIT_EXPECT_EQ(test, mt798x_wmac_sku_setup(dev, &type), -ETIMEDOUT);
+}
+
+/* The SKU code (in the TOP POS SKU field and for the firmware) follows the
+ * A-dies present; any other combination is refused.
+ */
+static void mt7915_soc_test_sku_update(struct kunit *test)
+{
+	static const struct {
+		u32 type, sku;
+	} cases[] = {
+		{ MT7915_SOC_TEST_ADIE(0x7976, 0x7976), MT7976_DUAL_ADIE },
+		{ MT7915_SOC_TEST_ADIE(0x7975, 0x7975), MT7975_DUAL_ADIE },
+		{ MT7915_SOC_TEST_ADIE(0x7976, 0), MT7976_ONE_ADIE_DBDC },
+		{ MT7915_SOC_TEST_ADIE(0, 0x7975), MT7975_ONE_ADIE },
+		{ MT7915_SOC_TEST_ADIE(0, 0x7976), MT7976_ONE_ADIE },
+	};
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		t->sku[MT_TOP_POS_SKU / 4] = 0x0fffffff;
+		KUNIT_EXPECT_EQ(test, mt7986_wmac_sku_update(dev,
+				cases[i].type), 0);
+		KUNIT_EXPECT_EQ_MSG(test, t->sku[MT_TOP_POS_SKU / 4],
+				    0x0fffffff | cases[i].sku << 28,
+				    "case %d", i);
+		KUNIT_EXPECT_EQ(test, mt7915_check_adie(dev, true),
+				cases[i].sku);
+	}
+
+	mt7915_soc_test_set_reg(MT_CONNINFRA_SKU_DEC_ADDR, 0x55);
+	t->sku[MT_TOP_POS_SKU / 4] = 0;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_sku_update(dev,
+			MT7915_SOC_TEST_ADIE(0x7975, 0)), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_sku_update(dev, 0), -EINVAL);
+	KUNIT_EXPECT_EQ(test, t->sku[MT_TOP_POS_SKU / 4], 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_CONNINFRA_SKU_DEC_ADDR),
+			0x55);
+}
+
+/* --- PLLs, clocks and buses ----------------------------------------------- */
+
+/* Both bands' subsystem PLLs get their stable time and configuration, the
+ * legacy oscillator its stable time, and the WiFi power key is set with the
+ * ack cleared; the registers' other bits are kept.
+ */
+static void mt7915_soc_test_subsys_setting(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	int b;
+
+	mt7915_soc_test_init(test, &dev);
+	for (b = 0; b < 2; b++) {
+		mt7915_soc_test_set_reg(MT_AFE_PLL_STB_TIME(b), 0xffffffff);
+		mt7915_soc_test_set_reg(MT_AFE_DIG_EN_02(b), 0);
+	}
+	mt7915_soc_test_set_reg(MT_CONN_INFRA_OSC_RC_EN, 0xffffffff);
+	mt7915_soc_test_set_reg(MT_TOP_WFSYS_PWR, MT_TOP_PWR_ACK_MASK | BIT(0));
+
+	mt7986_wmac_subsys_setting(dev);
+
+	for (b = 0; b < 2; b++) {
+		KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_AFE_PLL_STB_TIME(b)),
+				(u32)~MT_AFE_PLL_STB_TIME_MASK |
+				MT_AFE_PLL_STB_TIME_VAL);
+		KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_AFE_DIG_EN_02(b)),
+				MT_AFE_PLL_CFG_VAL);
+		KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_AFE_DIG_TOP_01(b)),
+				MT_AFE_DIG_TOP_01_VAL);
+	}
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_CONN_INFRA_OSC_RC_EN),
+			(u32)~MT_CONN_INFRA_OSC_RC_EN_MASK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_CONN_INFRA_OSC_CTRL),
+			0x80706);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_TOP_WFSYS_PWR),
+			MT_TOP_PWR_KEY | BIT(0));
+}
+
+/* Bring-up of the subsystem: the infra bus timeouts are armed and, once
+ * conninfra answers, the WiFi PLL dividers and the SPI clock are enabled,
+ * conninfra woken for the A-die sleep controllers and let sleep again.
+ */
+static void mt7915_soc_test_subsys_powerup(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 val;
+
+	mt7915_soc_test_set_reg(MT_INFRA_CKGEN_BUS,
+				MT_INFRA_CKGEN_BUS_CLK_SEL_MASK);
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_subsys_powerup(dev,
+			MT7915_SOC_TEST_ADIE(0x7976, 0x7975)), 0);
+
+	val = mt7915_soc_test_reg(MT_INFRA_BUS_OFF_TIMEOUT);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_INFRA_BUS_TIMEOUT_LIMIT_MASK, val), 2);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_INFRA_BUS_TIMEOUT_EN_MASK, val), 0xf);
+	val = mt7915_soc_test_reg(MT_INFRA_BUS_ON_TIMEOUT);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_INFRA_BUS_TIMEOUT_LIMIT_MASK, val),
+			0xc);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_INFRA_BUS_TIMEOUT_EN_MASK, val), 0xf);
+
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_INFRA_CKGEN_BUS_WPLL_DIV_1),
+			FIELD_PREP(MT_INFRA_CKGEN_DIV_SEL_MASK, 1) |
+			MT_INFRA_CKGEN_DIV_EN_MASK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_INFRA_CKGEN_BUS_WPLL_DIV_2),
+			FIELD_PREP(MT_INFRA_CKGEN_DIV_SEL_MASK, 1) |
+			MT_INFRA_CKGEN_DIV_EN_MASK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_INFRA_CKGEN_RFSPI_WPLL_DIV),
+			FIELD_PREP(MT_INFRA_CKGEN_DIV_SEL_MASK, 8) |
+			MT_INFRA_CKGEN_DIV_EN_MASK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_INFRA_CKGEN_BUS), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_CONN_INFRA_HW_CTRL),
+			MT_CONN_INFRA_HW_CTRL_MASK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_ADIE_SLP_CTRL_CK0(0)),
+			MT_SLP_CTRL_EN_MASK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_ADIE_SLP_CTRL_CK0(1)),
+			MT_SLP_CTRL_EN_MASK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT_TOP_CONN_INFRA_WAKEUP,
+			MT_TOP_CONN_INFRA_WAKEUP_MASK), 1);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_TOP_CONN_INFRA_WAKEUP), 0);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+
+	/* only the A-dies present get their sleep controller */
+	mt7915_soc_test_set_reg(MT_ADIE_SLP_CTRL_CK0(1), 0);
+	mt7986_wmac_clock_enable(dev, MT7915_SOC_TEST_ADIE(0x7976, 0));
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_ADIE_SLP_CTRL_CK0(1)), 0);
+}
+
+/* If conninfra never reports its version the bring-up stops before the
+ * clocks.
+ */
+static void mt7915_soc_test_subsys_powerup_no_infra(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+
+	mt7915_soc_test_init(test, &dev);
+	mt7915_soc_test_set_reg(MT_CONN_INFRA_BASE, 0);
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_subsys_powerup(dev,
+			MT7915_SOC_TEST_ADIE(0x7976, 0)), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_INFRA_CKGEN_BUS_WPLL_DIV_1),
+			0);
+}
+
+/* Waking the WiFi subsystem waits for conninfra; letting it sleep doesn't. */
+static void mt7915_soc_test_top_wfsys_wakeup(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_top_wfsys_wakeup(dev, true), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_TOP_WFSYS_WAKEUP),
+			MT_TOP_WFSYS_WAKEUP_MASK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT_CONN_INFRA_BASE, 0), 1);
+
+	mt7915_soc_test_set_reg(MT_CONN_INFRA_BASE, 0);
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_top_wfsys_wakeup(dev, false), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_TOP_WFSYS_WAKEUP), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT_CONN_INFRA_BASE, 0), 1);
+}
+
+/* WiFi subsystem power-up: the WM MCU held in reset, the bus protection
+ * dropped, power on with the key and the ack awaited, the bus timeouts set,
+ * then the MCU released until its ROM is up.
+ */
+static void mt7915_soc_test_wfsys_powerup(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 mask, val;
+
+	mt7915_soc_test_set_reg(MT7986_TOP_WM_RESET, MT7986_TOP_WM_RESET_MASK);
+	mt7915_soc_test_set_reg(MT_CONNINFRA_SKU_DEC_ADDR, 0xf);
+	mt7915_soc_test_set_reg(MT_CONN_INFRA_WF_SLP_PROT,
+				MT_CONN_INFRA_WF_SLP_PROT_MASK);
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_wfsys_powerup(dev), 0);
+
+	/* the reset went low before it was released */
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_rd(t, MT7986_TOP_WM_RESET,
+			MT7986_TOP_WM_RESET_MASK), 1);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT7986_TOP_WM_RESET),
+			MT7986_TOP_WM_RESET_MASK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_CONNINFRA_SKU_DEC_ADDR), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_CONN_INFRA_WF_SLP_PROT), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_TOP_WFSYS_PWR),
+			MT_TOP_PWR_KEY | MT_TOP_PWR_EN_MASK);
+
+	mask = MT_MCU_BUS_TIMEOUT_SET_MASK | MT_MCU_BUS_TIMEOUT_CG_EN_MASK |
+	       MT_MCU_BUS_TIMEOUT_EN_MASK;
+	val = mt7915_soc_test_reg(MT_MCU_BUS_TIMEOUT);
+	KUNIT_EXPECT_EQ(test, val & mask,
+			FIELD_PREP(MT_MCU_BUS_TIMEOUT_SET_MASK, 1) |
+			MT_MCU_BUS_TIMEOUT_CG_EN_MASK |
+			MT_MCU_BUS_TIMEOUT_EN_MASK);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_MCU_BUS_REMAP), 0x810f0000);
+	val = mt7915_soc_test_reg(MT_MCU_BUS_DBG_TIMEOUT);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_MCU_BUS_DBG_TIMEOUT_SET_MASK, val),
+			0x3aa);
+	KUNIT_EXPECT_TRUE(test, val & MT_MCU_BUS_DBG_TIMEOUT_CK_EN_MASK);
+	KUNIT_EXPECT_TRUE(test, val & MT_MCU_BUS_DBG_TIMEOUT_EN_MASK);
+}
+
+/* If power-on is never acked the MCU stays in reset. */
+static void mt7915_soc_test_wfsys_powerup_no_ack(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+
+	t->pwr_ack = false;
+	mt7915_soc_test_set_reg(MT7986_TOP_WM_RESET, MT7986_TOP_WM_RESET_MASK);
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_wfsys_powerup(dev), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT7986_TOP_WM_RESET), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_MCU_BUS_REMAP), 0);
+}
+
+/* Without the reserved memory for the WM firmware (none in the VM's device
+ * tree) conninfra setup fails before programming the EMI window.
+ */
+static void mt7915_soc_test_no_of_node(void *data)
+{
+	struct device *dev = data;
+
+	dev->of_node = NULL;
+}
+
+static void mt7915_soc_test_coninfra_setup(struct kunit *test)
+{
+	struct device_node *np, *live;
+	struct mt7915_dev *dev;
+	struct property *pp;
+	static __be32 phandle;
+
+	mt7915_soc_test_init(test, &dev);
+	KUNIT_EXPECT_EQ(test, mt798x_wmac_coninfra_setup(dev), -EINVAL);
+
+	/* a memory region that isn't reserved memory is no better */
+	np = kunit_kzalloc(test, sizeof(*np), GFP_KERNEL);
+	pp = kunit_kzalloc(test, sizeof(*pp), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, np);
+	KUNIT_ASSERT_NOT_NULL(test, pp);
+	live = of_find_node_with_property(NULL, "phandle");
+	of_node_put(live);
+	if (!live)
+		kunit_skip(test, "no device-tree node with a phandle");
+	phandle = cpu_to_be32(live->phandle);
+	pp->name = "memory-region";
+	pp->value = &phandle;
+	pp->length = sizeof(phandle);
+	np->name = "wifi";
+	np->full_name = "wifi";
+	np->properties = pp;
+	dev->mt76.dev->of_node = np;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_soc_test_no_of_node, dev->mt76.dev), 0);
+	KUNIT_EXPECT_EQ(test, mt798x_wmac_coninfra_setup(dev), -EINVAL);
+
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_INFRA_BUS_EMI_START), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_reg(MT_TOP_MCU_EMI_BASE), 0);
+}
