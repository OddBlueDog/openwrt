+/* The per-rate limits of a channel in the country's table, and the highest
+ * power any of them allows.
+ */
+static void mt76_eeprom_test_rate_power_limits(struct kunit *test)
+{
+	static const s8 ofdm[] = { 32, 34, 36, 38, 40, 52, 22, 12 };
+	static const s8 path_ofdm[] = { 66, 56, 57, 54 };
+	static const s8 path_ofdm_bf[] = { 42, 57, 54, 47 };
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	struct device_node *np = mt76_eeprom_test_of(test, dev);
+	struct ieee80211_channel chan = {
+		.band = NL80211_BAND_5GHZ,
+		.hw_value = 40,
+	};
+	struct mt76_power_limits *limits;
+	int i, j;
+
+	limits = kunit_kzalloc(test, sizeof(*limits), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, limits);
+	mt76_eeprom_test_limits_dt(test, dev, np);
+
+	/*
+	 * rates: min(60, limit + 2); max 52 so far. Backoff for 2 chains
+	 * (own delta 6): min(60 + 6 - delta(entry chains), limit + 2), the
+	 * 2-chain entries counting: paths-ofdm's 56 is the max.
+	 */
+	KUNIT_EXPECT_EQ(test, mt76_get_rate_power_limits(&dev->phy, &chan,
+			limits, 60), 56);
+	for (i = 0; i < ARRAY_SIZE(limits->cck); i++)
+		KUNIT_EXPECT_EQ(test, limits->cck[i], 60);
+	KUNIT_EXPECT_MEMEQ(test, limits->ofdm, ofdm, sizeof(ofdm));
+	for (i = 0; i < 10; i++) {
+		KUNIT_EXPECT_EQ(test, limits->mcs[0][i], 22 + i);
+		for (j = 1; j < 4; j++)
+			KUNIT_EXPECT_EQ(test, limits->mcs[j][i], 42 + i);
+	}
+	for (j = 0; j < ARRAY_SIZE(limits->ru); j++)
+		for (i = 0; i < ARRAY_SIZE(limits->ru[0]); i++)
+			KUNIT_EXPECT_EQ(test, limits->ru[j][i], 12);
+	KUNIT_EXPECT_EQ(test, limits->eht[15][15], 60);
+	for (i = 0; i < ARRAY_SIZE(limits->path.cck); i++)
+		KUNIT_EXPECT_EQ(test, limits->path.cck[i], 0);
+	KUNIT_EXPECT_MEMEQ(test, limits->path.ofdm, path_ofdm,
+			   sizeof(path_ofdm));
+	KUNIT_EXPECT_MEMEQ(test, limits->path.ofdm_bf, path_ofdm_bf,
+			   sizeof(path_ofdm_bf));
+	for (j = 0; j < ARRAY_SIZE(limits->path.ru); j++)
+		for (i = 0; i < ARRAY_SIZE(limits->path.ru[0]); i++) {
+			KUNIT_EXPECT_EQ(test, limits->path.ru[j][i], 32);
+			KUNIT_EXPECT_EQ(test, limits->path.ru_bf[j][i], 22);
+		}
+}
+
+/* Without a table for the country, band or channel, every rate gets the
+ * target, the path backoffs none, and the target is the max power.
+ */
+static void mt76_eeprom_test_rate_power_no_limits(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	struct device_node *np = mt76_eeprom_test_of(test, dev);
+	struct ieee80211_channel chan = {
+		.band = NL80211_BAND_5GHZ,
+		.hw_value = 40,
+	};
+	struct mt76_power_limits *limits;
+	int i;
+
+	limits = kunit_kzalloc(test, sizeof(*limits), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, limits);
+
+	/* no power-limits node at all */
+	memset(limits, 0x55, sizeof(*limits));
+	KUNIT_EXPECT_EQ(test, mt76_get_rate_power_limits(&dev->phy, &chan,
+			limits, 44), 44);
+	for (i = 0; i < ARRAY_SIZE(limits->ofdm); i++)
+		KUNIT_EXPECT_EQ(test, limits->ofdm[i], 44);
+	KUNIT_EXPECT_EQ(test, limits->mcs[3][9], 44);
+	KUNIT_EXPECT_EQ(test, limits->path.ofdm[0], 0);
+	KUNIT_EXPECT_EQ(test, limits->path.ru_bf[6][9], 0);
+
+	mt76_eeprom_test_limits_dt(test, dev, np);
+	/* a band without a table */
+	chan.band = NL80211_BAND_2GHZ;
+	chan.hw_value = 6;
+	KUNIT_EXPECT_EQ(test, mt76_get_rate_power_limits(&dev->phy, &chan,
+			limits, 44), 44);
+	chan.band = NL80211_BAND_6GHZ;
+	KUNIT_EXPECT_EQ(test, mt76_get_rate_power_limits(&dev->phy, &chan,
+			limits, 44), 44);
+	chan.band = NL80211_BAND_60GHZ;
+	KUNIT_EXPECT_EQ(test, mt76_get_rate_power_limits(&dev->phy, &chan,
+			limits, 44), 44);
+	/* a channel without one */
+	chan.band = NL80211_BAND_5GHZ;
+	chan.hw_value = 149;
+	KUNIT_EXPECT_EQ(test, mt76_get_rate_power_limits(&dev->phy, &chan,
+			limits, 44), 44);
+	KUNIT_EXPECT_EQ(test, limits->ofdm[5], 44);
+}
