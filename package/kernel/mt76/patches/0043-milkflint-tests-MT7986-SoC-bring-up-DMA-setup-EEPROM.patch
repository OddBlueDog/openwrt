+/* The MT7975 patch for the MT7986: LDOs, clock buffers, thermal sensor
+ * offsets, in order.
+ */
+static void mt7915_soc_test_patch_7975(struct kunit *test)
+{
+	static const struct {
+		u16 addr;
+		u32 val;
+	} seq[] = {
+		{ 0x348, 0x00000002 }, { 0x378, 0x00000002 },
+		{ 0x3a8, 0x00000002 }, { 0x3d8, 0x00000002 },
+		{ 0xa1c, 0x30000aaa }, { 0xa84, 0x8470008a },
+		{ 0x074, 0x00000002 }, { 0xaa4, 0x01001fc0 },
+		{ 0x070, 0x00000005 }, { 0x344, 0x00000088 },
+		{ 0x374, 0x00000088 }, { 0x3a4, 0x00000088 },
+		{ 0x3d4, 0x00000088 }, { 0xa80, 0x44d07000 },
+		{ 0xa88, 0x3900aaaa }, { 0x2c4, 0x00000000 },
+		{ 0x2c8, 0x00000072 },
+	};
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	int i;
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_patch_7975(dev, 1), 0);
+	KUNIT_ASSERT_EQ(test, t->n_wr, ARRAY_SIZE(seq));
+	for (i = 0; i < ARRAY_SIZE(seq); i++) {
+		KUNIT_EXPECT_EQ(test, t->wr[i].adie, 1);
+		KUNIT_EXPECT_EQ_MSG(test, t->wr[i].addr, seq[i].addr, "#%d", i);
+		KUNIT_EXPECT_EQ_MSG(test, t->wr[i].val, seq[i].val, "#%d", i);
+	}
+
+	/* the MT7981 drives SX0's LTBUF harder and has no CKB setting */
+	t->n_wr = 0;
+	dev->mt76.rev = 0x79810000;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_patch_7975(dev, 1), 0);
+	dev->mt76.rev = 0x79860000;
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_first_wr(t, 1, 0x074), 0x7);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 1, 0x2c8), 0);
+	KUNIT_EXPECT_EQ(test, t->n_wr, ARRAY_SIZE(seq) - 1);
+
+	/* a failing write stops the sequence there */
+	t->n_wr = 0;
+	t->spi_ok = 2;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_patch_7975(dev, 1), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, t->n_wr, 1);
+}
