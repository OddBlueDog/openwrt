+/* An EEPROM in an NVMEM cell is read from it; a cell shorter than the
+ * EEPROM isn't used. The EEPROM then counts as found in the device tree.
+ */
+static void mt76_eeprom_test_nvmem_cell(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	struct device_node *np = mt76_eeprom_test_of(test, dev);
+	struct device_node *live = mt76_eeprom_test_live(test);
+	u8 data[32], buf[24];
+	int i;
+
+	for (i = 0; i < sizeof(data); i++)
+		data[i] = 0xa0 + i;
+	mt76_eeprom_test_provider(test, dev, live, data, sizeof(data), 16);
+	MT76_EEPROM_TEST_CELLS(test, np, "nvmem-cells", live->phandle);
+	MT76_EEPROM_TEST_STRS(test, np, "nvmem-cell-names", "eeprom");
+
+	memset(buf, 0, sizeof(buf));
+	KUNIT_EXPECT_EQ(test, mt76_get_of_data_from_nvmem(dev, buf, "eeprom",
+			16), 0);
+	KUNIT_EXPECT_MEMEQ(test, buf, data, 16);
+	KUNIT_EXPECT_EQ(test, buf[16], 0);
+
+	KUNIT_EXPECT_EQ(test, mt76_get_of_data_from_nvmem(dev, buf, "eeprom",
+			24), -EINVAL);
+
+	KUNIT_EXPECT_EQ(test, mt76_eeprom_init(dev, 12), 1);
+	KUNIT_EXPECT_MEMEQ(test, dev->eeprom.data, data, 12);
+}
