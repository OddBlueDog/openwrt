diff --git a/mt7915/tests/dma-test.c b/mt7915/tests/dma-test.c
new file mode 100644
index 00000000..3d880901
--- /dev/null
+++ b/mt7915/tests/dma-test.c
@@ -0,0 +1,756 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for the MT7986's WFDMA setup: the queue layout, the prefetch
+ * SRAM split, enabling, stopping and resetting DMA, and the tx NAPI. Included
+ * at the end of mt7915/dma.c when CONFIG_MT76_KUNIT_TEST is defined
+ * (milkflint's QEMU test build only).
+ *
+ * Two register stores are involved: what the driver writes with mt76_wr()
+ * lands in the fake register file (fake->regs, keyed by window offset), while
+ * the ring registers the DMA core programs and the interrupt mask written by
+ * mt76_set_irq_mask() go straight to the probe's MMIO window,
+ * dev->mt76.mmio.regs.
+ */
+#include <kunit/test.h>
+#include <linux/dma-mapping.h>
+#include <linux/rtnetlink.h>
+#include "../mcu.h"
+#include "fake.h"
+
+/* The MT7986's WFDMA0 block, where all of its rings live */
+#define MT7915_DMA_TEST_WFDMA0		0x24000
+#define MT7915_DMA_TEST_TX_RING(i)	(MT7915_DMA_TEST_WFDMA0 + 0x300 + (i) * 16)
+#define MT7915_DMA_TEST_RX_RING(i)	(MT7915_DMA_TEST_WFDMA0 + 0x500 + (i) * 16)
+/* the second PCIe interface's copy of WFDMA0 (not on the MT7986) */
+#define MT7915_DMA_TEST_HIF1_OFS	(0x28000 - 0x24000)
+/* MT_WFDMA_HOST_CONFIG is a CONN_INFRA address: where it lands */
+#define MT7915_DMA_TEST_HOST_CONFIG	(MT_WFDMA_HOST_CONFIG - MT_INFRA_BASE)
+
+#define MT7915_DMA_TEST_GLO_EN		(MT_WFDMA0_GLO_CFG_TX_DMA_EN |	\
+					 MT_WFDMA0_GLO_CFG_RX_DMA_EN)
+#define MT7915_DMA_TEST_GLO_ALL		(MT7915_DMA_TEST_GLO_EN |		\
+					 MT_WFDMA0_GLO_CFG_OMIT_TX_INFO |	\
+					 MT_WFDMA0_GLO_CFG_OMIT_RX_INFO |	\
+					 MT_WFDMA0_GLO_CFG_OMIT_RX_INFO_PFET2)
+#define MT7915_DMA_TEST_RST		(MT_WFDMA0_RST_DMASHDL_ALL_RST |	\
+					 MT_WFDMA0_RST_LOGIC_RST)
+
+/* the values the driver read from MT_WFDMA0_RST, in order */
+static struct {
+	u32 rst[8];
+	int n_rst;
+} mt7915_dma_test_log;
+
+static u32 mt7915_dma_test_rr(struct mt76_test_fake *fake, u32 addr, u32 val)
+{
+	if (addr == MT7915_DMA_TEST_WFDMA0 + 0x100 &&
+	    mt7915_dma_test_log.n_rst < ARRAY_SIZE(mt7915_dma_test_log.rst))
+		mt7915_dma_test_log.rst[mt7915_dma_test_log.n_rst++] = val;
+	return val;
+}
+
+/* An MT7986 that can do DMA: a DMA mask on its device, the register log, and
+ * the SoC register windows a forced reset (mt7915_wfsys_reset()) touches.
+ */
+static struct mt7915_dev *mt7915_dma_test_dev(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	void *sku, *dcm;
+
+	KUNIT_ASSERT_EQ(test, dma_coerce_mask_and_coherent(dev->mt76.dma_dev,
+			DMA_BIT_MASK(32)), 0);
+	memset(&mt7915_dma_test_log, 0, sizeof(mt7915_dma_test_log));
+	fake->rr_hook = mt7915_dma_test_rr;
+
+	sku = kunit_kzalloc(test, SZ_4K, GFP_KERNEL);
+	dcm = kunit_kzalloc(test, SZ_4K, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sku);
+	KUNIT_ASSERT_NOT_NULL(test, dcm);
+	dev->sku = (void __force __iomem *)sku;
+	dev->dcm = (void __force __iomem *)dcm;
+	/* conninfra answers with its version, the bus protection acks */
+	mt76_test_set_reg(fake, MT_CONN_INFRA_BASE - MT_INFRA_BASE, 0x02070000);
+	mt76_test_set_reg(fake, MT_CONN_INFRA_WF_SLP_PROT_RDY - MT_INFRA_BASE,
+			  MT_CONN_INFRA_CONN);
+
+	return dev;
+}
+
+static u32 mt7915_dma_test_ring(struct mt7915_dev *dev, u32 ring, u32 field)
+{
+	return readl(dev->mt76.mmio.regs + ring + field);
+}
+
+#define MT7915_DMA_TEST_RING(dev, ring, field)				\
+	mt7915_dma_test_ring(dev, ring, offsetof(struct mt76_queue_regs, field))
+
+/* A queue's ring registers describe it: size, descriptors, indexes. */
+static void mt7915_dma_test_expect_ring(struct kunit *test,
+					struct mt7915_dev *dev,
+					struct mt76_queue *q, u32 ring,
+					int ndesc)
+{
+	KUNIT_ASSERT_NOT_NULL(test, q);
+	KUNIT_EXPECT_EQ(test, q->ndesc, ndesc);
+	KUNIT_EXPECT_EQ(test, (uintptr_t)q->regs,
+			(uintptr_t)(dev->mt76.mmio.regs + ring));
+	KUNIT_EXPECT_EQ(test, MT7915_DMA_TEST_RING(dev, ring, ring_size), ndesc);
+	KUNIT_EXPECT_EQ(test, MT7915_DMA_TEST_RING(dev, ring, desc_base),
+			lower_32_bits(q->desc_dma));
+	KUNIT_EXPECT_EQ(test, MT7915_DMA_TEST_RING(dev, ring, dma_idx), 0);
+}
+
+/* The production teardown order: rx NAPI off, then the DMA cleanup. Under
+ * RTNL only so that its NAPI deletions use expedited RCU grace periods and
+ * keep the suite fast; nothing in it takes RTNL.
+ */
+static void mt7915_dma_test_teardown(struct mt7915_dev *dev)
+{
+	int i;
+
+	mt76_for_each_q_rx(&dev->mt76, i)
+		napi_disable(&dev->mt76.napi[i]);
+	rtnl_lock();
+	mt7915_dma_cleanup(dev);
+	rtnl_unlock();
+	dev->mt76.napi_dev = NULL;
+}
+
+static void mt7915_dma_test_release(void *data)
+{
+	struct mt7915_dev *dev = data;
+
+	if (dev->mt76.napi_dev)
+		mt7915_dma_test_teardown(dev);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	dev->mt76.phys[MT_BAND1] = NULL;
+}
+
+/* An MT7986 with its DMA set up by the driver (and torn down after @test);
+ * with DBDC, with band 1's phy as mt7915_register_device() makes it.
+ */
+static struct mt7915_dev *mt7915_dma_test_init(struct kunit *test, bool dbdc)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_dev(test);
+	struct mt7915_phy *phy2 = NULL;
+
+	dev->dbdc_support = dbdc;
+	if (dbdc) {
+		phy2 = kunit_kzalloc(test, sizeof(*phy2), GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, phy2);
+		phy2->mt76 = kunit_kzalloc(test, sizeof(*phy2->mt76),
+					   GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, phy2->mt76);
+		phy2->mt76->dev = &dev->mt76;
+		phy2->mt76->band_idx = MT_BAND1;
+		phy2->mt76->priv = phy2;
+		phy2->dev = dev;
+	}
+	KUNIT_ASSERT_EQ(test, mt7915_dma_init(dev, phy2), 0);
+	if (phy2)
+		dev->mt76.phys[MT_BAND1] = phy2->mt76;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_dma_test_release, dev), 0);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+
+	return dev;
+}
+
+/* --- queue layout --------------------------------------------------------- */
+
+/* The MT7986 has a single WFDMA (WFDMA0) and its own ring numbering and
+ * interrupt bits, not the MT7915's.
+ */
+static void mt7915_dma_test_config(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+
+	mt7915_dma_config(dev);
+
+	KUNIT_EXPECT_EQ(test, dev->wfdma_mask, 0);
+
+	KUNIT_EXPECT_EQ(test, MT_MCUQ_ID(MT_MCUQ_FWDL), 16);
+	KUNIT_EXPECT_EQ(test, MT_MCUQ_ID(MT_MCUQ_WM), 17);
+	KUNIT_EXPECT_EQ(test, MT_TXQ_ID(0), 18);
+	KUNIT_EXPECT_EQ(test, MT_TXQ_ID(1), 19);
+	KUNIT_EXPECT_EQ(test, MT_MCUQ_ID(MT_MCUQ_WA), 20);
+	KUNIT_EXPECT_EQ(test, MT_RXQ_ID(MT_RXQ_MCU), 0);
+	KUNIT_EXPECT_EQ(test, MT_RXQ_ID(MT_RXQ_MCU_WA), 1);
+	KUNIT_EXPECT_EQ(test, MT_RXQ_ID(MT_RXQ_MAIN_WA), 2);
+	KUNIT_EXPECT_EQ(test, MT_RXQ_ID(MT_RXQ_BAND1_WA), 3);
+	KUNIT_EXPECT_EQ(test, MT_RXQ_ID(MT_RXQ_MAIN), 4);
+	KUNIT_EXPECT_EQ(test, MT_RXQ_ID(MT_RXQ_BAND1), 5);
+
+	KUNIT_EXPECT_EQ(test, MT_INT_TX_MCU(MT_MCUQ_FWDL), BIT(26));
+	KUNIT_EXPECT_EQ(test, MT_INT_TX_MCU(MT_MCUQ_WM), BIT(27));
+	KUNIT_EXPECT_EQ(test, MT_INT_TX_MCU(MT_MCUQ_WA), BIT(25));
+	KUNIT_EXPECT_EQ(test, dev->q_int_mask[__TXQ(0)], BIT(30));
+	KUNIT_EXPECT_EQ(test, dev->q_int_mask[__TXQ(1)], BIT(31));
+	KUNIT_EXPECT_EQ(test, MT_INT_RX(MT_RXQ_MCU), BIT(0));
+	KUNIT_EXPECT_EQ(test, MT_INT_RX(MT_RXQ_MCU_WA), BIT(1));
+	KUNIT_EXPECT_EQ(test, MT_INT_RX(MT_RXQ_MAIN_WA), BIT(2));
+	KUNIT_EXPECT_EQ(test, MT_INT_RX(MT_RXQ_BAND1_WA), BIT(3));
+	KUNIT_EXPECT_EQ(test, MT_INT_RX(MT_RXQ_MAIN), BIT(22));
+	KUNIT_EXPECT_EQ(test, MT_INT_RX(MT_RXQ_BAND1), BIT(23));
+
+	KUNIT_EXPECT_EQ(test, MT_TXQ_RING_BASE(0), MT7915_DMA_TEST_TX_RING(0));
+	KUNIT_EXPECT_EQ(test, MT_RXQ_RING_BASE(MT_RXQ_MAIN),
+			MT7915_DMA_TEST_RX_RING(0));
+}
+
+/* Each ring gets its own 0x40 of prefetch SRAM, depth 4, in ring order. */
+static void mt7915_dma_test_prefetch(struct kunit *test)
+{
+	static const struct {
+		u32 reg, val;
+	} ext[] = {
+		{ 0x640, 0x00000004 },	/* FWDL (ring 16) */
+		{ 0x644, 0x00400004 },	/* WM (17) */
+		{ 0x648, 0x00800004 },	/* band 0 data (18) */
+		{ 0x64c, 0x00c00004 },	/* band 1 data (19) */
+		{ 0x650, 0x01000004 },	/* WA (20) */
+		{ 0x680, 0x01400004 },	/* rx WM events (rx ring 0) */
+		{ 0x684, 0x01800004 },	/* rx WA events (1) */
+		{ 0x688, 0x01c00004 },	/* rx band 0 tx-free (2) */
+		{ 0x68c, 0x02000004 },	/* rx band 1 tx-free (3) */
+		{ 0x690, 0x02400004 },	/* rx band 0 data (4) */
+		{ 0x694, 0x02800004 },	/* rx band 1 data (5) */
+	};
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	int i;
+
+	mt7915_dma_config(dev);
+	mt7915_dma_prefetch(dev);
+
+	for (i = 0; i < ARRAY_SIZE(ext); i++)
+		KUNIT_EXPECT_EQ_MSG(test, mt76_test_reg(fake,
+				    MT7915_DMA_TEST_WFDMA0 + ext[i].reg),
+				    ext[i].val, "reg %x", ext[i].reg);
+	/* the MT7915's "ring after the last" entries aren't needed here */
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake,
+			MT7915_DMA_TEST_WFDMA0 + 0x654), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake,
+			MT7915_DMA_TEST_WFDMA0 + 0x698), 0);
+
+	/* a second PCIe interface (not on the MT7986) gets the same split */
+	dev->hif2 = kunit_kzalloc(test, sizeof(*dev->hif2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev->hif2);
+	mt7915_dma_prefetch(dev);
+	dev->hif2 = NULL;
+	for (i = 0; i < ARRAY_SIZE(ext); i++)
+		KUNIT_EXPECT_EQ_MSG(test, mt76_test_reg(fake,
+				    MT7915_DMA_TEST_WFDMA0 +
+				    MT7915_DMA_TEST_HIF1_OFS + ext[i].reg),
+				    ext[i].val, "hif1 reg %x", ext[i].reg);
+}
+
+/* --- stop and start ------------------------------------------------------- */
+
+/* Stopping DMA clears the enables and the info-omit bits and nothing else;
+ * a reset also pulses the DMA logic and scheduler resets (low, then high).
+ */
+static void mt7915_dma_test_disable(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	mt76_test_set_reg(fake, MT_WFDMA0_GLO_CFG, ~0);
+	mt76_test_set_reg(fake, MT_WFDMA0_RST, MT7915_DMA_TEST_RST);
+	mt7915_dma_disable(dev, false);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_GLO_CFG),
+			(u32)~MT7915_DMA_TEST_GLO_ALL);
+	KUNIT_EXPECT_EQ(test, mt7915_dma_test_log.n_rst, 0);
+
+	mt76_test_set_reg(fake, MT_WFDMA0_GLO_CFG, ~0);
+	mt7915_dma_disable(dev, true);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_GLO_CFG),
+			(u32)~MT7915_DMA_TEST_GLO_ALL);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_RST),
+			MT7915_DMA_TEST_RST);
+	KUNIT_ASSERT_EQ(test, mt7915_dma_test_log.n_rst, 2);
+	KUNIT_EXPECT_EQ(test, mt7915_dma_test_log.rst[1] & MT7915_DMA_TEST_RST,
+			0);
+	/* no WFDMA1 on the MT7986 */
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA1_GLO_CFG), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA1_RST), 0);
+}
+
+/* With a second PCIe interface (not on the MT7986) its WFDMA is stopped and
+ * reset the same way.
+ */
+static void mt7915_dma_test_disable_hif2(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u32 ofs = MT7915_DMA_TEST_HIF1_OFS;
+
+	dev->hif2 = kunit_kzalloc(test, sizeof(*dev->hif2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev->hif2);
+	mt76_test_set_reg(fake, MT_WFDMA0_GLO_CFG + ofs, ~0);
+	mt7915_dma_disable(dev, true);
+	dev->hif2 = NULL;
+
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_GLO_CFG + ofs),
+			(u32)~MT7915_DMA_TEST_GLO_ALL);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_RST + ofs),
+			MT7915_DMA_TEST_RST);
+}
+
+/* Starting DMA turns on tx/rx with the MT7986's info-omit settings, and the
+ * interrupts of the queues band 0 uses; band 1's only with DBDC.
+ */
+static void mt7915_dma_test_start(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u32 mask;
+
+	mt7915_dma_config(dev);
+	mask = MT_INT_RX_DONE_MCU | MT_INT_TX_DONE_MCU | MT_INT_MCU_CMD |
+	       MT_INT_BAND0_RX_DONE;
+
+	KUNIT_EXPECT_EQ(test, mt7915_dma_start(dev, false, false), 0);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_GLO_CFG),
+			MT7915_DMA_TEST_GLO_EN |
+			MT_WFDMA0_GLO_CFG_OMIT_TX_INFO |
+			MT_WFDMA0_GLO_CFG_OMIT_RX_INFO_PFET2);
+	KUNIT_EXPECT_EQ(test, dev->mt76.mmio.irqmask, mask);
+	KUNIT_EXPECT_EQ(test, readl(dev->mt76.mmio.regs + MT_INT_MASK_CSR),
+			mask);
+	KUNIT_EXPECT_FALSE(test, dev->mt76.mmio.irqmask &
+			   MT_INT_RX(MT_RXQ_BAND1));
+	KUNIT_EXPECT_FALSE(test, dev->mt76.mmio.irqmask &
+			   MT_INT_RX(MT_RXQ_BAND1_WA));
+	/* one interface: no band split */
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT7915_DMA_TEST_HOST_CONFIG),
+			0);
+
+	dev->dbdc_support = true;
+	dev->mt76.mmio.irqmask = 0;
+	mt7915_dma_start(dev, false, false);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	KUNIT_EXPECT_EQ(test, dev->mt76.mmio.irqmask,
+			mask | MT_INT_BAND1_RX_DONE);
+}
+
+/* Restarting after a reset leaves the DMA enables to the firmware handshake
+ * and only adds the firmware event interrupt.
+ */
+static void mt7915_dma_test_start_reset(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	mt7915_dma_config(dev);
+	dev->mt76.mmio.irqmask = BIT(0);
+	KUNIT_EXPECT_EQ(test, mt7915_dma_start(dev, true, false), 0);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_GLO_CFG), 0);
+	KUNIT_EXPECT_EQ(test, dev->mt76.mmio.irqmask, BIT(0) | MT_INT_MCU_CMD);
+	KUNIT_EXPECT_EQ(test, readl(dev->mt76.mmio.regs + MT_INT_MASK_CSR),
+			BIT(0) | MT_INT_MCU_CMD);
+}
+
+/* With a second PCIe interface (not on the MT7986) its WFDMA is started too
+ * and the host told to split the bands between the two.
+ */
+static void mt7915_dma_test_start_hif2(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u32 ofs = MT7915_DMA_TEST_HIF1_OFS;
+
+	mt7915_dma_config(dev);
+	dev->hif2 = kunit_kzalloc(test, sizeof(*dev->hif2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev->hif2);
+	mt7915_dma_start(dev, false, false);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	dev->hif2 = NULL;
+
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_GLO_CFG + ofs),
+			MT7915_DMA_TEST_GLO_EN |
+			MT_WFDMA0_GLO_CFG_OMIT_TX_INFO |
+			MT_WFDMA0_GLO_CFG_OMIT_RX_INFO_PFET2);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT7915_DMA_TEST_HOST_CONFIG),
+			MT_WFDMA_HOST_CONFIG_PDMA_BAND);
+}
+
+/* Enabling (after setup or a reset) resets the DMA indexes, turns off the
+ * delayed interrupts, programs the prefetch split, makes the host wait for
+ * idle FIFOs, and starts DMA. On a second PCIe interface the same.
+ */
+static void mt7915_dma_test_enable(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u32 busy = MT_WFDMA0_BUSY_ENA_TX_FIFO0 | MT_WFDMA0_BUSY_ENA_TX_FIFO1 |
+		   MT_WFDMA0_BUSY_ENA_RX_FIFO;
+	u32 ofs = MT7915_DMA_TEST_HIF1_OFS;
+	int i;
+
+	mt7915_dma_config(dev);
+	for (i = 0; i < 2; i++) {
+		mt76_test_set_reg(fake, MT_WFDMA0_PRI_DLY_INT_CFG0 + i * ofs, ~0);
+		mt76_test_set_reg(fake, MT_WFDMA0_PRI_DLY_INT_CFG1 + i * ofs, ~0);
+		mt76_test_set_reg(fake, MT_WFDMA0_PRI_DLY_INT_CFG2 + i * ofs, ~0);
+	}
+	dev->hif2 = kunit_kzalloc(test, sizeof(*dev->hif2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev->hif2);
+	KUNIT_EXPECT_EQ(test, mt7915_dma_enable(dev, false), 0);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	dev->hif2 = NULL;
+
+	for (i = 0; i < 2; i++) {
+		KUNIT_EXPECT_EQ(test, mt76_test_reg(fake,
+				MT_WFDMA0_RST_DTX_PTR + i * ofs), ~0);
+		KUNIT_EXPECT_EQ(test, mt76_test_reg(fake,
+				MT_WFDMA0_PRI_DLY_INT_CFG0 + i * ofs), 0);
+		KUNIT_EXPECT_EQ(test, mt76_test_reg(fake,
+				MT_WFDMA0_PRI_DLY_INT_CFG1 + i * ofs), 0);
+		KUNIT_EXPECT_EQ(test, mt76_test_reg(fake,
+				MT_WFDMA0_PRI_DLY_INT_CFG2 + i * ofs), 0);
+		KUNIT_EXPECT_EQ(test, mt76_test_reg(fake,
+				MT_WFDMA0_BUSY_ENA + i * ofs), busy);
+		KUNIT_EXPECT_EQ(test, mt76_test_reg(fake,
+				MT7915_DMA_TEST_WFDMA0 + 0x644 + i * ofs),
+				0x00400004);
+		KUNIT_EXPECT_EQ(test, mt76_test_reg(fake,
+				MT_WFDMA0_GLO_CFG + i * ofs) &
+				MT7915_DMA_TEST_GLO_EN, MT7915_DMA_TEST_GLO_EN);
+	}
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA1_RST_DTX_PTR), 0);
+}
+
+/* The MT7915 (not the MT7986) has two WFDMAs: firmware and tx rings on
+ * WFDMA1 with its own ring numbers, rx data on WFDMA0. Each is stopped,
+ * reset, enabled and started; its prefetch split also initializes the ring
+ * after the last of each block. With a second PCIe interface, its copies
+ * too.
+ */
+static void mt7915_dma_test_mt7915(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u32 ofs = MT_WFDMA1_PCIE1_BASE - MT_WFDMA1_BASE;
+	u32 rev = dev->mt76.rev, hif, rst_dtx, glo, dly, busy;
+	u32 base1;
+	int i;
+
+	dev->mt76.rev = 0x79150000;
+	mt7915_dma_config(dev);
+	base1 = MT_MCUQ_RING_BASE(MT_MCUQ_WM);
+	hif = MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0);
+	KUNIT_EXPECT_EQ(test, MT_Q_BASE(MT_MCUQ_FWDL), MT_WFDMA1_BASE);
+	KUNIT_EXPECT_EQ(test, MT_Q_BASE(__TXQ(0)), MT_WFDMA1_BASE);
+	KUNIT_EXPECT_EQ(test, MT_Q_BASE(__RXQ(MT_RXQ_MCU)), MT_WFDMA1_BASE);
+	KUNIT_EXPECT_EQ(test, MT_Q_BASE(__RXQ(MT_RXQ_MAIN)), MT_WFDMA0_BASE);
+	KUNIT_EXPECT_EQ(test, MT_Q_BASE(__RXQ(MT_RXQ_BAND1)), MT_WFDMA0_BASE);
+	KUNIT_EXPECT_EQ(test, MT_RXQ_ID(MT_RXQ_BAND1_WA), MT7915_RXQ_MCU_WA_EXT);
+	KUNIT_EXPECT_EQ(test, MT_INT_RX(MT_RXQ_MAIN), MT_INT_RX_DONE_BAND0);
+
+	mt7915_dma_prefetch(dev);
+	/* band 0's tx ring on WFDMA1, band 0's rx ring on WFDMA0 */
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA1(0x648)), 0x00800004);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT7915_DMA_TEST_WFDMA0 +
+			0x680), 0x02000004);
+	/* the rings after WA, the band 1 tx-free and band 1 rx rings */
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA1(0x654)), 0x01400000);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA1(0x68c)), 0x02000000);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT7915_DMA_TEST_WFDMA0 +
+			0x688), 0x02800000);
+
+	dev->hif2 = kunit_kzalloc(test, sizeof(*dev->hif2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev->hif2);
+	for (i = 0; i < 2; i++) {
+		mt76_test_set_reg(fake, MT_WFDMA1_GLO_CFG + i * ofs, ~0);
+		mt76_test_set_reg(fake, MT_WFDMA1_RST + i * ofs,
+				  MT7915_DMA_TEST_RST);
+		mt76_test_set_reg(fake, MT_WFDMA1_PRI_DLY_INT_CFG0 + i * ofs, ~0);
+	}
+	mt7915_dma_disable(dev, true);
+	for (i = 0; i < 2; i++) {
+		KUNIT_EXPECT_EQ(test, mt76_test_reg(fake,
+				MT_WFDMA1_GLO_CFG + i * ofs),
+				(u32)~MT7915_DMA_TEST_GLO_ALL);
+		KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA1_RST + i * ofs),
+				MT7915_DMA_TEST_RST);
+	}
+
+	KUNIT_EXPECT_EQ(test, mt7915_dma_enable(dev, false), 0);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	dev->hif2 = NULL;
+	dev->mt76.rev = rev;
+
+	for (i = 0; i < 2; i++) {
+		rst_dtx = mt76_test_reg(fake, MT_WFDMA1_RST_DTX_PTR + i * ofs);
+		glo = mt76_test_reg(fake, MT_WFDMA1_GLO_CFG + i * ofs);
+		dly = mt76_test_reg(fake, MT_WFDMA1_PRI_DLY_INT_CFG0 + i * ofs);
+		busy = mt76_test_reg(fake, MT_WFDMA1_BUSY_ENA + i * ofs);
+		KUNIT_EXPECT_EQ(test, rst_dtx, ~0);
+		KUNIT_EXPECT_EQ(test, dly, 0);
+		KUNIT_EXPECT_EQ(test, busy, MT_WFDMA1_BUSY_ENA_TX_FIFO0 |
+				MT_WFDMA1_BUSY_ENA_TX_FIFO1 |
+				MT_WFDMA1_BUSY_ENA_RX_FIFO);
+		KUNIT_EXPECT_EQ(test, glo & (MT7915_DMA_TEST_GLO_EN |
+				MT_WFDMA1_GLO_CFG_OMIT_TX_INFO |
+				MT_WFDMA1_GLO_CFG_OMIT_RX_INFO),
+				MT7915_DMA_TEST_GLO_EN |
+				MT_WFDMA1_GLO_CFG_OMIT_TX_INFO |
+				MT_WFDMA1_GLO_CFG_OMIT_RX_INFO);
+	}
+	/* the second interface's WFDMA0 prefetch, at its own offset */
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT7915_DMA_TEST_WFDMA0 + hif +
+			0x680), 0x02000004);
+	KUNIT_EXPECT_EQ(test, base1, MT_WFDMA1_BASE + 0x300);
+}
+
+/* --- setup and teardown --------------------------------------------------- */
+
+/* A raw frame on ring @q, as mt7915_mcu_send_message() queues firmware
+ * frames
+ */
+static void mt7915_dma_test_queue_raw(struct kunit *test,
+				      struct mt7915_dev *dev,
+				      struct mt76_queue *q)
+{
+	struct sk_buff *skb = alloc_skb(64, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	skb_put_zero(skb, 64);
+	KUNIT_ASSERT_EQ(test, dev->mt76.queue_ops->tx_queue_skb_raw(&dev->mt76,
+			q, skb, 0), 0);
+	KUNIT_ASSERT_EQ(test, q->queued, 1);
+	KUNIT_ASSERT_EQ(test, q->head, 1);
+}
+
+/* Setup gives the MT7986 its tx, firmware and rx rings at its own ring
+ * numbers, programs their registers, posts rx buffers, and starts DMA;
+ * without DBDC there are no band 1 rx rings. Then, on that device: the tx
+ * NAPI reclaims the firmware frames the hardware has sent and turns the
+ * firmware tx interrupts back on, and teardown stops and resets DMA before
+ * freeing the rings.
+ */
+static void mt7915_dma_test_lifecycle(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt76_dev *mdev = &dev->mt76;
+	struct mt76_queue *q;
+	int i;
+
+	mt76_test_set_reg(fake, MT7915_DMA_TEST_HOST_CONFIG,
+			  MT_WFDMA_HOST_CONFIG_WED | BIT(4));
+	KUNIT_ASSERT_EQ(test, mt7915_dma_init(dev, NULL), 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_dma_test_release, dev), 0);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+
+	q = dev->mphy.q_tx[MT_TXQ_BE];
+	mt7915_dma_test_expect_ring(test, dev, q, MT7915_DMA_TEST_TX_RING(18),
+				    MT7915_TX_RING_SIZE);
+	/* every access category shares band 0's data ring */
+	for (i = 0; i <= MT_TXQ_PSD; i++)
+		KUNIT_EXPECT_PTR_EQ(test, dev->mphy.q_tx[i], q);
+
+	mt7915_dma_test_expect_ring(test, dev, mdev->q_mcu[MT_MCUQ_FWDL],
+				    MT7915_DMA_TEST_TX_RING(16),
+				    MT7915_TX_FWDL_RING_SIZE);
+	mt7915_dma_test_expect_ring(test, dev, mdev->q_mcu[MT_MCUQ_WM],
+				    MT7915_DMA_TEST_TX_RING(17),
+				    MT7915_TX_MCU_RING_SIZE);
+	mt7915_dma_test_expect_ring(test, dev, mdev->q_mcu[MT_MCUQ_WA],
+				    MT7915_DMA_TEST_TX_RING(20),
+				    MT7915_TX_MCU_RING_SIZE);
+
+	mt7915_dma_test_expect_ring(test, dev, &mdev->q_rx[MT_RXQ_MCU],
+				    MT7915_DMA_TEST_RX_RING(0),
+				    MT7915_RX_MCU_RING_SIZE);
+	mt7915_dma_test_expect_ring(test, dev, &mdev->q_rx[MT_RXQ_MCU_WA],
+				    MT7915_DMA_TEST_RX_RING(1),
+				    MT7915_RX_MCU_RING_SIZE);
+	mt7915_dma_test_expect_ring(test, dev, &mdev->q_rx[MT_RXQ_MAIN_WA],
+				    MT7915_DMA_TEST_RX_RING(2),
+				    MT7915_RX_MCU_RING_SIZE);
+	mt7915_dma_test_expect_ring(test, dev, &mdev->q_rx[MT_RXQ_MAIN],
+				    MT7915_DMA_TEST_RX_RING(4),
+				    MT7915_RX_RING_SIZE);
+	KUNIT_EXPECT_EQ(test, mdev->q_rx[MT_RXQ_BAND1].ndesc, 0);
+	KUNIT_EXPECT_EQ(test, mdev->q_rx[MT_RXQ_BAND1_WA].ndesc, 0);
+
+	/* rx rings are full of buffers, one slot short, and the hardware told */
+	q = &mdev->q_rx[MT_RXQ_MAIN];
+	KUNIT_EXPECT_EQ(test, q->queued, q->ndesc - 1);
+	KUNIT_EXPECT_EQ(test, MT7915_DMA_TEST_RING(dev,
+			MT7915_DMA_TEST_RX_RING(4), cpu_idx), q->ndesc - 1);
+	/* tx rings start empty */
+	KUNIT_EXPECT_EQ(test, dev->mphy.q_tx[MT_TXQ_BE]->queued, 0);
+
+	/* no WED on this build: the host config must not route through it */
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT7915_DMA_TEST_HOST_CONFIG),
+			BIT(4));
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_GLO_CFG) &
+			MT7915_DMA_TEST_GLO_EN, MT7915_DMA_TEST_GLO_EN);
+	KUNIT_EXPECT_EQ(test, mdev->mmio.irqmask,
+			MT_INT_RX_DONE_MCU | MT_INT_TX_DONE_MCU |
+			MT_INT_MCU_CMD | MT_INT_BAND0_RX_DONE);
+	/* setup started with a DMA logic reset */
+	KUNIT_EXPECT_EQ(test, mt7915_dma_test_log.n_rst, 2);
+
+	/* tx NAPI */
+	q = mdev->q_mcu[MT_MCUQ_WM];
+	mt7915_dma_test_queue_raw(test, dev, q);
+	writel(1, &q->regs->dma_idx);	/* the hardware is done with it */
+	mdev->mmio.irqmask &= ~MT_INT_TX_DONE_MCU;
+
+	local_bh_disable();
+	napi_schedule(&mdev->tx_napi);
+	local_bh_enable();
+	/* returns once the poll has completed */
+	napi_disable(&mdev->tx_napi);
+	napi_enable(&mdev->tx_napi);
+	tasklet_kill(&mdev->irq_tasklet);
+
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, q->tail, 1);
+	KUNIT_EXPECT_EQ(test, mdev->mmio.irqmask & MT_INT_TX_DONE_MCU,
+			MT_INT_TX_DONE_MCU);
+
+	/* teardown */
+	mt7915_dma_test_log.n_rst = 0;
+	mt7915_dma_test_teardown(dev);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_GLO_CFG) &
+			MT7915_DMA_TEST_GLO_ALL, 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_RST),
+			MT7915_DMA_TEST_RST);
+	KUNIT_EXPECT_EQ(test, mt7915_dma_test_log.n_rst, 2);
+}
+
+/* Reset as the SER recovery runs it (NAPI off around it). */
+static void mt7915_dma_test_run_reset(struct mt7915_dev *dev, bool force)
+{
+	int i;
+
+	mt76_for_each_q_rx(&dev->mt76, i)
+		napi_disable(&dev->mt76.napi[i]);
+	napi_disable(&dev->mt76.tx_napi);
+
+	mt7915_dma_reset(dev, force);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+
+	mt76_for_each_q_rx(&dev->mt76, i)
+		napi_enable(&dev->mt76.napi[i]);
+	napi_enable(&dev->mt76.tx_napi);
+}
+
+/* With DBDC, band 1 gets its tx ring, its rx data and tx-free rings and
+ * their interrupts. Then a DMA reset (the SER handshake, not forced) drops
+ * what the hardware never sent, on both bands, puts every ring back at index
+ * 0 and refills rx, and leaves DMA stopped for the firmware to restart.
+ */
+static void mt7915_dma_test_dbdc_reset(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_init(test, true);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt76_dev *mdev = &dev->mt76;
+	struct mt76_queue *mcu = mdev->q_mcu[MT_MCUQ_WM];
+	struct mt76_queue *rx = &mdev->q_rx[MT_RXQ_BAND1];
+	struct mt76_queue *tx1 = mdev->phys[MT_BAND1]->q_tx[MT_TXQ_BE];
+	u32 ring = MT7915_DMA_TEST_RX_RING(5);
+
+	mt7915_dma_test_expect_ring(test, dev, &mdev->q_rx[MT_RXQ_BAND1],
+				    ring, MT7915_RX_RING_SIZE);
+	mt7915_dma_test_expect_ring(test, dev, &mdev->q_rx[MT_RXQ_BAND1_WA],
+				    MT7915_DMA_TEST_RX_RING(3),
+				    MT7915_RX_MCU_RING_SIZE);
+	KUNIT_EXPECT_EQ(test, rx->queued, MT7915_RX_RING_SIZE - 1);
+	KUNIT_EXPECT_TRUE(test, mdev->mmio.irqmask & MT_INT_RX(MT_RXQ_BAND1));
+	KUNIT_EXPECT_TRUE(test, mdev->mmio.irqmask &
+			  MT_INT_RX(MT_RXQ_BAND1_WA));
+	/* band 1's data ring, after band 0's */
+	mt7915_dma_test_expect_ring(test, dev, tx1, MT7915_DMA_TEST_TX_RING(19),
+				    MT7915_TX_RING_SIZE);
+	KUNIT_EXPECT_PTR_EQ(test, mdev->phys[MT_BAND1]->q_tx[MT_TXQ_VO], tx1);
+	KUNIT_EXPECT_PTR_NE(test, dev->mphy.q_tx[MT_TXQ_BE], tx1);
+
+	mt7915_dma_test_queue_raw(test, dev, mcu);
+	mt7915_dma_test_queue_raw(test, dev, tx1);
+	writel(100, &rx->regs->dma_idx);
+	mt7915_dma_test_log.n_rst = 0;
+
+	mt7915_dma_test_run_reset(dev, false);
+
+	KUNIT_EXPECT_EQ(test, mcu->queued, 0);
+	KUNIT_EXPECT_EQ(test, mcu->head, 0);
+	KUNIT_EXPECT_EQ(test, mcu->tail, 0);
+	KUNIT_EXPECT_EQ(test, MT7915_DMA_TEST_RING(dev,
+			MT7915_DMA_TEST_TX_RING(17), cpu_idx), 0);
+	KUNIT_EXPECT_EQ(test, tx1->queued, 0);
+	KUNIT_EXPECT_EQ(test, tx1->head, 0);
+	KUNIT_EXPECT_EQ(test, MT7915_DMA_TEST_RING(dev,
+			MT7915_DMA_TEST_TX_RING(19), cpu_idx), 0);
+	KUNIT_EXPECT_EQ(test, MT7915_DMA_TEST_RING(dev, ring, dma_idx), 0);
+	KUNIT_EXPECT_EQ(test, rx->queued, rx->ndesc - 1);
+	KUNIT_EXPECT_EQ(test, MT7915_DMA_TEST_RING(dev, ring, cpu_idx),
+			rx->ndesc - 1);
+	KUNIT_EXPECT_EQ(test, MT7915_DMA_TEST_RING(dev, ring, ring_size),
+			rx->ndesc);
+
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_GLO_CFG) &
+			MT7915_DMA_TEST_GLO_EN, 0);
+	KUNIT_EXPECT_EQ(test, mt7915_dma_test_log.n_rst, 0);
+	KUNIT_EXPECT_TRUE(test, mdev->mmio.irqmask & MT_INT_MCU_CMD);
+}
+
+/* A forced reset also resets the WiFi subsystem and the DMA logic, then
+ * starts DMA again itself.
+ */
+static void mt7915_dma_test_reset_force(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_init(test, false);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	mt76_test_set_reg(fake, MT_WFDMA0_GLO_CFG, 0);
+	mt7915_dma_test_log.n_rst = 0;
+
+	mt7915_dma_test_run_reset(dev, true);
+
+	/* mt7986_wmac_disable() raised the bus protection, enable reset the
+	 * consys
+	 */
+	KUNIT_EXPECT_TRUE(test, mt76_test_reg(fake, MT_CONN_INFRA_WF_SLP_PROT -
+			  MT_INFRA_BASE) & MT_CONN_INFRA_WF_SLP_PROT_MASK);
+	KUNIT_EXPECT_TRUE(test, readl(dev->sku + 0x114) & BIT(3));
+	KUNIT_ASSERT_EQ(test, mt7915_dma_test_log.n_rst, 2);
+	KUNIT_EXPECT_EQ(test, mt7915_dma_test_log.rst[1] & MT7915_DMA_TEST_RST,
+			0);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, MT_WFDMA0_GLO_CFG) &
+			MT7915_DMA_TEST_GLO_EN, MT7915_DMA_TEST_GLO_EN);
+	KUNIT_EXPECT_EQ(test, dev->mt76.q_rx[MT_RXQ_MAIN].queued,
+			MT7915_RX_RING_SIZE - 1);
+}
