+/* --- MAC address ---------------------------------------------------------- */
+
+/* Without a device-tree address, a valid EEPROM address is kept and an
+ * invalid one replaced by a random valid address.
+ */
+static void mt76_eeprom_test_override_no_dt(struct kunit *test)
+{
+	static const u8 mac[ETH_ALEN] = { 0x02, 0x00, 0x00, 0x00, 0x00, 0x01 };
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	struct mt76_phy *phy = &dev->phy;
+
+	memcpy(phy->macaddr, mac, ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, mt76_eeprom_override(phy), 0);
+	KUNIT_EXPECT_MEMEQ(test, phy->macaddr, mac, ETH_ALEN);
+
+	eth_zero_addr(phy->macaddr);
+	KUNIT_EXPECT_EQ(test, mt76_eeprom_override(phy), 0);
+	KUNIT_EXPECT_TRUE(test, is_valid_ether_addr(phy->macaddr));
+
+	eth_broadcast_addr(phy->macaddr);
+	KUNIT_EXPECT_EQ(test, mt76_eeprom_override(phy), 0);
+	KUNIT_EXPECT_TRUE(test, is_valid_ether_addr(phy->macaddr));
+}
