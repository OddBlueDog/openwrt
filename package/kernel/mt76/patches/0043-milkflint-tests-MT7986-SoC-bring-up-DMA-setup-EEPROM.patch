+			     3, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
+			     4, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30);
+	MT76_EEPROM_TEST_S8S(test, lo, "paths-ru-bf",
