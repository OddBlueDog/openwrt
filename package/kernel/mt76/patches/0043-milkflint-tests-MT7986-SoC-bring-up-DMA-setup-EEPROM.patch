+/* The chain count of each backoff entry: connac2 (the MT7986) tables go up
+ * to 4T4SS, connac3 ones to 5T5SS; past the table there's none.
+ */
+static void mt76_eeprom_test_backoff_chains(struct kunit *test)
+{
+	static const u8 connac2[] = { 1, 2, 3, 4, 2, 3, 4, 3, 4, 4,
+				      0, 0, 0, 0, 0, 0 };
+	static const u8 connac3[] = { 1, 2, 3, 4, 5, 2, 3, 4, 5, 3,
+				      4, 5, 4, 5, 5, 0 };
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(connac2); i++)
+		KUNIT_EXPECT_EQ_MSG(test, mt76_backoff_n_chains(dev, i),
+				    connac2[i], "idx %d", i);
+	dev->rev = 0x79900000;
+	for (i = 0; i < ARRAY_SIZE(connac3); i++)
+		KUNIT_EXPECT_EQ_MSG(test, mt76_backoff_n_chains(dev, i),
+				    connac3[i], "idx %d", i);
+}
+
+/* Rate limits: the lower of the target and the limit plus the stream delta;
+ * the highest result is the max power, padding (126, 127) aside. Backoff
+ * limits are relative to the target for their chain count (the beamforming
+ * table starts at 2 chains), and only the entries for the configured chain
+ * count set the max power.
+ */
+static void mt76_eeprom_test_array_limit(struct kunit *test)
+{
+	static const s8 rates[4] = { 20, 30, 127, 10 };
+	static const s8 paths[4] = { 40, 40, 40, 40 };
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	s8 pwr[4], max;
+
+	max = -127;
+	mt76_apply_array_limit(dev, pwr, 4, rates, 40, 0, &max, 2,
+			       MT76_SKU_RATE);
+	KUNIT_EXPECT_EQ(test, pwr[0], 20);
+	KUNIT_EXPECT_EQ(test, pwr[1], 30);
+	KUNIT_EXPECT_EQ(test, pwr[2], 40);
+	KUNIT_EXPECT_EQ(test, pwr[3], 10);
+	KUNIT_EXPECT_EQ(test, max, 30);
+
+	max = -127;
+	mt76_apply_array_limit(dev, pwr, 4, rates, 24, 3, &max, 2,
+			       MT76_SKU_RATE);
+	KUNIT_EXPECT_EQ(test, pwr[0], 23);
+	KUNIT_EXPECT_EQ(test, pwr[1], 24);
+	KUNIT_EXPECT_EQ(test, max, 24);
+
+	/* 2 chains: deltas 0, 6, 9, 12 for 1-4 chains, own delta 6 */
+	max = -127;
+	mt76_apply_array_limit(dev, pwr, 4, paths, 30, 0, &max, 2,
+			       MT76_SKU_BACKOFF);
+	KUNIT_EXPECT_EQ(test, pwr[0], 36);
+	KUNIT_EXPECT_EQ(test, pwr[1], 30);
+	KUNIT_EXPECT_EQ(test, pwr[2], 27);
+	KUNIT_EXPECT_EQ(test, pwr[3], 24);
+	KUNIT_EXPECT_EQ(test, max, 30);
+
+	max = -127;
+	mt76_apply_array_limit(dev, pwr, 4, paths, 30, 0, &max, 3,
+			       MT76_SKU_BACKOFF_BF_OFFSET);
+	/* 3 chains (delta 9) against entries for 2, 3, 4, 2 chains */
+	KUNIT_EXPECT_EQ(test, pwr[0], 33);
+	KUNIT_EXPECT_EQ(test, pwr[1], 30);
+	KUNIT_EXPECT_EQ(test, pwr[2], 27);
+	KUNIT_EXPECT_EQ(test, pwr[3], 33);
+	KUNIT_EXPECT_EQ(test, max, 30);
+
+	/* no table, or an unknown kind of table: nothing changes */
+	memset(pwr, 99, sizeof(pwr));
+	max = -127;
+	mt76_apply_array_limit(dev, pwr, 4, NULL, 30, 0, &max, 2,
+			       MT76_SKU_RATE);
+	mt76_apply_array_limit(dev, pwr, 4, paths, 30, 0, &max, 2,
+			       (enum mt76_sku_type)7);
+	KUNIT_EXPECT_EQ(test, pwr[0], 99);
+	KUNIT_EXPECT_EQ(test, max, -127);
+}
+
+/* Multi-entry tables: each block (a repeat count, then one entry) fills as
+ * many entries as it says; a short table stops where it ends. On connac2
+ * the backoff entries after the third (BW20 on) have no 1T1SS column.
+ */
+static void mt76_eeprom_test_multi_limit(struct kunit *test)
+{
+	static const s8 data[] = { 2, 10, 11, 12, 1, 20, 21, 22 };
+	static const s8 backoff[] = { 4, 40, 40, 40 };
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	s8 pwr[4][3], max = -127;
+	int i;
+
+	memset(pwr, 99, sizeof(pwr));
+	mt76_apply_multi_array_limit(dev, pwr[0], 3, 4, data, sizeof(data), 50,
+				     0, &max, 2, MT76_SKU_RATE);
+	for (i = 0; i < 3; i++) {
+		KUNIT_EXPECT_EQ(test, pwr[0][i], 10 + i);
+		KUNIT_EXPECT_EQ(test, pwr[1][i], 10 + i);
+		KUNIT_EXPECT_EQ(test, pwr[2][i], 20 + i);
+		KUNIT_EXPECT_EQ(test, pwr[3][i], 99);
+	}
+	KUNIT_EXPECT_EQ(test, max, 22);
+
+	memset(pwr, 99, sizeof(pwr));
+	mt76_apply_multi_array_limit(dev, pwr[0], 3, 4, data, 3, 50, 0, &max,
+				     2, MT76_SKU_RATE);
+	KUNIT_EXPECT_EQ(test, pwr[0][0], 99);
+
+	/* 1 chain: entries 0-2 against 1, 2, 3 chains, entry 3 against 2, 3, 4 */
+	mt76_apply_multi_array_limit(dev, pwr[0], 3, 4, backoff,
+				     sizeof(backoff), 30, 0, &max, 1,
+				     MT76_SKU_BACKOFF);
+	KUNIT_EXPECT_EQ(test, pwr[2][0], 30);
+	KUNIT_EXPECT_EQ(test, pwr[2][1], 24);
+	KUNIT_EXPECT_EQ(test, pwr[2][2], 21);
+	KUNIT_EXPECT_EQ(test, pwr[3][0], 24);
+	KUNIT_EXPECT_EQ(test, pwr[3][1], 21);
+	KUNIT_EXPECT_EQ(test, pwr[3][2], 18);
+
+	/* connac3 keeps the 1T1SS column */
+	dev->rev = 0x79900000;
+	mt76_apply_multi_array_limit(dev, pwr[0], 3, 4, backoff,
+				     sizeof(backoff), 30, 0, &max, 1,
+				     MT76_SKU_BACKOFF);
+	KUNIT_EXPECT_EQ(test, pwr[3][0], 30);
+}
