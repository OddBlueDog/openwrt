+/* Setting up an A-die configures and calibrates it; A-die 0 of a DBDC SKU
+ * is calibrated for both bands; an absent A-die is skipped.
+ */
+static void mt7915_soc_test_adie_setup(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt7915_soc_test *t = mt7915_soc_test_init(test, &dev);
+	u32 type = MT7915_SOC_TEST_ADIE(0x7976, 0x7976);
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_setup(dev, 1,
+			MT7915_SOC_TEST_ADIE(0x7976, 0)), 0);
+	KUNIT_EXPECT_EQ(test, t->n_wr, 0);
+	KUNIT_EXPECT_EQ(test, t->n_locks, 0);
+
+	mt7915_soc_test_efuse_zero(t, 0);
+	mt7915_soc_test_efuse_zero(t, 1);
+	t->sku[MT_TOP_POS_SKU / 4] = MT_TOP_POS_SKU_ADIE_DBDC_MASK;
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_setup(dev, 0, type), 0);
+	/* two calibrations, two WBG writes each */
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 0,
+			MT_AFE_RG_ENCAL_WBTAC_IF_SW), 4);
+	KUNIT_EXPECT_GE(test, mt7915_soc_test_n_rd(t, MT_AFE_DIG_EN_01(1), 0),
+			1);
+
+	KUNIT_EXPECT_EQ(test, mt7986_wmac_adie_setup(dev, 1, type), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_n_wr(t, 1,
+			MT_AFE_RG_ENCAL_WBTAC_IF_SW), 2);
+	KUNIT_EXPECT_TRUE(test, mt7915_soc_test_unlocked());
+}
