From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Fri, 20 Nov 2026 15:25:56 +0000
Subject: [PATCH] wifi: mt76: mt7915: tests: WED, interrupts and DMA on the
 PCIe chips

The MT7915's and MT7916's halves of the WED and DMA code had no test:
the WED parameters from a PCIe BAR (WED's own interrupt registers, each
chip's interrupt bits and wcid range), WED's ring control in the host
config, the WA rings WED takes as its tx-free ring (the MT7915's WA
event ring, the MT7916's band 0 tx-free ring), the second PCIe
interface's band 1 rings, the interrupt handler and tasklet masking at
WED, and the CBTOP register ranges a PCIe card remaps.

mt7915_mmio_test_wed_init_pcie, mt7915_mmio_test_wed_irq,
mt7915_mmio_test_remap_cbtop_pcie, mt7915_dma_test_init_wed_mt7915,
mt7915_dma_test_init_wed_mt7916.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mt7915/tests/dma-test.c  |  53 +++++++++++++++++
 mt7915/tests/mmio-test.c | 122 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 175 insertions(+)

diff --git a/mt7915/tests/dma-test.c b/mt7915/tests/dma-test.c
index 51e56458..3f733f57 100644
--- a/mt7915/tests/dma-test.c
+++ b/mt7915/tests/dma-test.c
@@ -509,6 +509,57 @@ static void mt7915_dma_test_init_wed(struct kunit *test)
 
 #endif
 
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+/* The PCIe chips' DMA with a WED: WED told which rings it takes in the
+ * host config (MT7915's own ring control), both data rings at WED's
+ * ring base, the WA event ring on the MT7915 and band 0's tx-free ring on
+ * the MT7916 taken by WED as its tx-free ring; a reset resets WED too.
+ * The MT7916 here has its second PCIe interface, for band 1's rings.
+ */
+static void mt7915_dma_test_init_wed_chip(struct kunit *test, u32 rev,
+					  bool hif2)
+{
+	struct mt7915_dev *dev = mt7915_dma_test_dev(test);
+	struct mt76_dev *mdev = &dev->mt76;
+	struct mt76_test_wed *w;
+	struct mt76_queue *wa;
+
+	dev->mt76.rev = rev;
+	if (hif2) {
+		dev->hif2 = kunit_kzalloc(test, sizeof(*dev->hif2), GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, dev->hif2);
+	}
+	w = mt76_test_wed_init(test, &mdev->mmio.wed);
+	__mt7915_dma_test_init(test, dev, true);
+
+	KUNIT_EXPECT_TRUE(test, mt76_rr(dev, MT_WFDMA_HOST_CONFIG) &
+			  MT_WFDMA_HOST_CONFIG_WED);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_WFDMA_WED_RING_CONTROL_RX1,
+			mt76_rr(dev, MT_WFDMA_WED_RING_CONTROL)),
+			is_mt7915(mdev) ? 1 : 2);
+	KUNIT_EXPECT_EQ(test, w->n_tx_ring, 2);
+	KUNIT_EXPECT_EQ(test, w->n_txfree, 1);
+	wa = is_mt7915(mdev) ? &mdev->q_rx[MT_RXQ_MCU_WA] :
+			       &mdev->q_rx[MT_RXQ_MAIN_WA];
+	KUNIT_EXPECT_TRUE(test, mt76_queue_is_wed_tx_free(wa));
+
+	mt7915_dma_test_run_reset(dev, false);
+	KUNIT_EXPECT_EQ(test, w->n_reset_dma, 1);
+	mt7915_dma_test_teardown(dev);
+	KUNIT_EXPECT_EQ(test, w->n_detach, 1);
+}
+
+static void mt7915_dma_test_init_wed_mt7915(struct kunit *test)
+{
+	mt7915_dma_test_init_wed_chip(test, 0x79150000, false);
+}
+
+static void mt7915_dma_test_init_wed_mt7916(struct kunit *test)
+{
+	mt7915_dma_test_init_wed_chip(test, 0x79060000, true);
+}
+#endif
+
 /* With a second PCIe interface (not on the MT7986) its WFDMA is started too
  * and the host told to split the bands between the two.
  */
@@ -913,6 +964,8 @@ static struct kunit_case mt7915_dma_test_cases[] = {
 #ifdef CONFIG_NET_MEDIATEK_SOC_WED
 	KUNIT_CASE(mt7915_dma_test_start_wed),
 	KUNIT_CASE(mt7915_dma_test_init_wed),
+	KUNIT_CASE(mt7915_dma_test_init_wed_mt7915),
+	KUNIT_CASE(mt7915_dma_test_init_wed_mt7916),
 #endif
 	KUNIT_CASE(mt7915_dma_test_start_hif2),
 	KUNIT_CASE(mt7915_dma_test_enable),
diff --git a/mt7915/tests/mmio-test.c b/mt7915/tests/mmio-test.c
index 31c3421b..4a2719da 100644
--- a/mt7915/tests/mmio-test.c
+++ b/mt7915/tests/mmio-test.c
