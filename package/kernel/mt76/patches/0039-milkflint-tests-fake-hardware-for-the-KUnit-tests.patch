+/* An mt76_dev of @size bytes (the driver's struct, mt76_dev first) on a
+ * KUnit device, with the fake bus and firmware. @ops and @drv_ops may be
+ * NULL for mt76_test_hw_ops and empty driver ops.
+ */
+static inline struct mt76_dev *
+mt76_test_dev(struct kunit *test, unsigned int size,
+	      const struct ieee80211_ops *ops,
+	      const struct mt76_driver_ops *drv_ops)
+{
+	static const struct mt76_driver_ops no_drv_ops = {};
+	struct mt76_test_fake *fake;
+	struct mt76_dev *dev;
+	struct device *kdev;
+
+	kdev = kunit_device_register(test, "mt76-test");
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(kdev));
+	dev = mt76_alloc_device(kdev, size, ops ?: &mt76_test_hw_ops,
+				drv_ops ?: &no_drv_ops);
+	KUNIT_ASSERT_NOT_NULL(test, dev);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_test_free_device, dev), 0);
+	fake = mt76_test_fake_attach(test, dev);
+	fake->reply_hdr = 4;
+	fake->reply_seq_off = 0;
+	dev->bus = &mt76_test_bus_ops;
+	dev->mcu_ops = &mt76_test_mcu_ops;
+	return dev;
+}
