From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Sun, 18 Oct 2026 22:47:24 +0100
Subject: [PATCH] wifi: mt76: mt7915: factor out the reset token reclaim

Both reset paths give back all tx tokens, re-initialise the token idr
and unblock tx. Do it in one helper, so the two can't drift apart and
the sequence can be unit tested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mt7915/mac.c | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/mt7915/mac.c b/mt7915/mac.c
index 03041106..a76ab4b2 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1321,6 +1321,16 @@ mt7915_update_beacons(struct mt7915_dev *dev)
 		mt7915_update_vif_beacon, mphy_ext->hw);
 }
 
+/* Give back every tx token after the DMA rings were reset. No tx-free event
+ * will arrive for them anymore, so tx has to be unblocked here.
+ */
+static void mt7915_mac_reset_tokens(struct mt7915_dev *dev)
+{
+	mt76_connac2_tx_token_put(&dev->mt76);
+	idr_init(&dev->mt76.token);
+	mt76_set_tx_blocked(&dev->mt76, false);
+}
+
 static int
 mt7915_mac_restart(struct mt7915_dev *dev)
 {
@@ -1368,9 +1378,7 @@ mt7915_mac_restart(struct mt7915_dev *dev)
 	napi_disable(&dev->mt76.tx_napi);
 
 	/* token reinit */
-	mt76_connac2_tx_token_put(&dev->mt76);
-	idr_init(&dev->mt76.token);
-	mt76_set_tx_blocked(&dev->mt76, false);
+	mt7915_mac_reset_tokens(dev);
 
 	mt7915_dma_reset(dev, true);
 
@@ -1614,9 +1622,7 @@ void mt7915_mac_reset_work(struct work_struct *work)
 	if (mt7915_wait_reset_state(dev, MT_MCU_CMD_RESET_DONE)) {
 		mt7915_dma_reset(dev, false);
 
-		mt76_connac2_tx_token_put(&dev->mt76);
-		idr_init(&dev->mt76.token);
-		mt76_set_tx_blocked(&dev->mt76, false);
+		mt7915_mac_reset_tokens(dev);
 
 		mt76_wr(dev, MT_MCU_INT_EVENT, MT_MCU_INT_EVENT_DMA_INIT);
 		mt7915_wait_reset_state(dev, MT_MCU_CMD_RECOVERY_DONE);
