 	struct sk_buff_head tx_offchannel;
@@ -1026,6 +1040,11 @@ struct mt76_dev {
 	bool pace_timer_set;
 	unsigned long pace_wait[BITS_TO_LONGS(MT76_N_WCIDS)];
 
+	/* the stations held for not answering, and the work that probes them */
+	struct delayed_work silent_work;
+	bool silent_work_set;
+	unsigned long silent_wait[BITS_TO_LONGS(MT76_N_WCIDS)];
+
 	spinlock_t token_lock;
 	struct idr token;
 	u16 wed_token_count;
@@ -1604,6 +1623,19 @@ void mt76_txq_schedule_pending(struct mt76_phy *phy);
 void mt76_tx_worker_run(struct mt76_dev *dev);
 void mt76_tx_pace_init(struct mt76_dev *dev);
 void mt76_tx_pace_stop(struct mt76_dev *dev);
+#if IS_ENABLED(CONFIG_MT76_KUNIT_TEST)
+/* the tests set the clock (mt76_tx_silent_test_now) */
+unsigned long mt76_tx_silent_now(void);
+#else
+static inline unsigned long mt76_tx_silent_now(void)
+{
+	return jiffies;
+}
+#endif
