+	unsigned long heard;		/* its last frame, ACK or PS report */
+	unsigned long silent_since;
+	unsigned long silent_probe;	/* when the next probe goes */
+	u8 silent_probes_sent;		/* in this hold */
+	u8 silent_fails;		/* frames given up on since the last ACK */
+	u32 silent_holds;		/* times it was held */
+	u32 silent_probes;		/* probes sent in all */
