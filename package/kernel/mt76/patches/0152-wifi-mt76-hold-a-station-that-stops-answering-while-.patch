 		}
 
 		if (v3 && (info & MT_TX_FREE_MPDU_HEADER_V3))
diff --git a/tx.c b/tx.c
index 4545b775..34dce473 100644
--- a/tx.c
+++ b/tx.c
@@ -657,6 +657,293 @@ void mt76_tx_pace_stop(struct mt76_dev *dev)
 		hrtimer_cancel(&dev->pace_timer);
 }
 
+/*
+ * A station that stops answering while the hardware has it awake.
+ *
+ * A phone asleep sends its keepalives from its Wi-Fi chip: a null frame to
+ * say it's awake, the keepalive, a null frame to say it dozes again. Now
+ * and then the last one never arrives. The firmware then has the phone
+ * awake for as long as it stays silent (seconds, until it next has
+ * something to send), and every frame handed to the hardware for it in
+ * that time is lost: the first is sent its full count of times with no
+ * ACK, later ones can come back without having been sent at all (count 0,
+ * failed). The firmware reports no power-save change.
+ *
+ * So the driver does what the firmware doesn't: once a frame to a station
+ * comes back failed and nothing has been heard from that station for
+ * MT76_SILENT_IDLE_MS (no frame, no ACK, no power-save report), or
+ * MT76_SILENT_FAILS frames in a row come back failed however recently it
+ * was heard, the station is held as a dozing one is, with nothing at all
+ * handed to the hardware. Its frames wait in its queues. It is released by
+ * the next frame received from it, the next power-save report about it, or
+ * an ACK:
+ * of a frame that was in flight, or of a probe, a null frame the driver
+ * sends it at growing intervals for the case that it does listen and just
+ * had nothing to say (a failed frame can also be a moment's interference).
+ * The frame that found it silent, and what was in the hardware by then, is
+ * lost as before; what waits here is delayed instead, by no more than the
+ * station's silence.
+ *
+ * Only for a station of an AP interface, and with PS buffering in the
+ * hardware (where the firmware, not mac80211, tracks power save).
+ */
+static bool silent_hold = true;
+module_param(silent_hold, bool, 0644);
+MODULE_PARM_DESC(silent_hold, "Hold back a station's frames once it stops answering while the firmware has it awake, until it is heard again (default on; off: hand them to the hardware, as stock mt76 does)");
+
+#define MT76_SILENT_IDLE_MS	100	/* nothing heard for this long */
+#define MT76_SILENT_FAILS	3	/* or this many frames failed in a row */
+#define MT76_SILENT_PROBE_MS	20	/* the first probe; doubles each time */
+#define MT76_SILENT_PROBE_MAX_MS 1000	/* the longest gap between probes */
+
+#if IS_ENABLED(CONFIG_MT76_KUNIT_TEST)
+static unsigned long mt76_tx_silent_test_now;	/* the tests' clock, when set */
+
+unsigned long mt76_tx_silent_now(void)
+{
+	return mt76_tx_silent_test_now ?: jiffies;
+}
+EXPORT_SYMBOL_GPL(mt76_tx_silent_now);
+#endif
+
+/* the interface a station is on, by way of its queues */
+static struct ieee80211_vif *mt76_sta_vif(struct ieee80211_sta *sta)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(sta->txq); i++)
+		if (sta->txq[i])
+			return sta->txq[i]->vif;
+
+	return NULL;
+}
+
+static void mt76_tx_silent_arm(struct mt76_dev *dev, unsigned long delay)
+{
+	if (!dev->silent_work_set)
+		return;
+#if IS_ENABLED(CONFIG_MT76_KUNIT_TEST)
+	/* the tests run the work's function themselves */
+	if (mt76_tx_silent_test_now)
+		return;
+#endif
+	if (!delayed_work_pending(&dev->silent_work) ||
+	    time_before(jiffies + delay, dev->silent_work.timer.expires))
+		mod_delayed_work(dev->wq, &dev->silent_work, delay);
+}
+
+/* The station is heard again, or isn't to be held any more: its queues go
+ * back on mac80211's list.
+ */
+void mt76_tx_silent_release(struct mt76_dev *dev, struct mt76_wcid *wcid)
+{
+	struct ieee80211_sta *sta;
+	struct ieee80211_hw *hw;
+	int i;
+
+	if (!test_and_clear_bit(MT_WCID_FLAG_SILENT, &wcid->flags))
+		return;
+
+	wcid->silent_ms += jiffies_to_msecs(mt76_tx_silent_now() -
+					    wcid->silent_since);
+
+	sta = wcid_to_sta(wcid);
+	if (!sta)
+		return;
+
+	hw = mt76_phy_hw(dev, wcid->phy_idx);
+	for (i = 0; i < ARRAY_SIZE(sta->txq); i++)
+		if (sta->txq[i])
+			ieee80211_schedule_txq(hw, sta->txq[i]);
+	mt76_worker_schedule(&dev->tx_worker);
+}
+EXPORT_SYMBOL_GPL(mt76_tx_silent_release);
+
+/* something came from the station: a frame, an ACK, a power-save report */
+static void mt76_tx_heard(struct mt76_dev *dev, struct mt76_wcid *wcid)
+{
+	WRITE_ONCE(wcid->heard, mt76_tx_silent_now());
+	if (unlikely(test_bit(MT_WCID_FLAG_SILENT, &wcid->flags)))
+		mt76_tx_silent_release(dev, wcid);
+}
+
+/* How a frame the hardware was handed for a station ended, from its tx-free
+ * report: acked, or given up on (sent in vain, or not sent at all).
+ */
+void mt76_tx_result(struct mt76_dev *dev, struct mt76_wcid *wcid, bool acked)
+{
+	unsigned long now = mt76_tx_silent_now();
+	struct ieee80211_sta *sta;
+	struct ieee80211_vif *vif;
+	struct mt76_phy *phy;
+
+	if (acked) {
+		wcid->silent_fails = 0;
+		mt76_tx_heard(dev, wcid);
+		return;
+	}
+
+	if (!READ_ONCE(silent_hold) ||
+	    !(dev->drv->drv_flags & MT_DRV_HW_PS_BUFFERING))
+		return;
+
+	/* held already; or dozing, as far as the firmware says: its frames
+	 * are the firmware's to buffer
+	 */
+	if (test_bit(MT_WCID_FLAG_SILENT, &wcid->flags) ||
+	    test_bit(MT_WCID_FLAG_PS, &wcid->flags))
+		return;
+
+	if (wcid->silent_fails < U8_MAX)
+		wcid->silent_fails++;
+	if (wcid->silent_fails < MT76_SILENT_FAILS &&
+	    time_before(now, READ_ONCE(wcid->heard) +
+			     msecs_to_jiffies(MT76_SILENT_IDLE_MS)))
+		return;
+
+	/* frames fail for other reasons while the radio is away or resets */
+	phy = mt76_dev_phy(dev, wcid->phy_idx);
+	if (!phy || test_bit(MT76_RESET, &phy->state) || phy->offchannel)
+		return;
+
+	sta = wcid_to_sta(wcid);
+	vif = sta ? mt76_sta_vif(sta) : NULL;
+	if (!vif || vif->type != NL80211_IFTYPE_AP)
+		return;
+
+	wcid->silent_since = now;
+	wcid->silent_fails = 0;
+	wcid->silent_probes_sent = 0;
+	wcid->silent_probe = now + msecs_to_jiffies(MT76_SILENT_PROBE_MS);
+	wcid->silent_holds++;
+	set_bit(MT_WCID_FLAG_SILENT, &wcid->flags);
+	set_bit(wcid->idx, dev->silent_wait);
+	mt76_tx_silent_arm(dev, msecs_to_jiffies(MT76_SILENT_PROBE_MS));
+}
+EXPORT_SYMBOL_GPL(mt76_tx_result);
+
+/* A null frame for a held station, as hostapd's inactivity poll is one:
+ * its tx-free report says whether the station answers (mt76_tx_result()).
+ * It isn't a frame anything waits for, so losing it costs nothing.
+ */
+static void mt76_tx_silent_probe(struct mt76_dev *dev, struct mt76_wcid *wcid)
+{
+	struct ieee80211_sta *sta = wcid_to_sta(wcid);
+	struct mt76_phy *phy = mt76_dev_phy(dev, wcid->phy_idx);
+	struct ieee80211_tx_info *info;
+	struct ieee80211_qos_hdr *hdr;
+	struct ieee80211_vif *vif;
+	struct sk_buff *skb;
+	bool qos;
+	int len;
+
+	vif = sta ? mt76_sta_vif(sta) : NULL;
+	if (!vif || !phy || !phy->chandef.chan)
+		return;
+
+	qos = sta->wme;
+	len = qos ? sizeof(*hdr) : sizeof(struct ieee80211_hdr_3addr);
+	skb = dev_alloc_skb(phy->hw->extra_tx_headroom + len);
+	if (!skb)
+		return;
+
+	skb_reserve(skb, phy->hw->extra_tx_headroom);
+	hdr = skb_put_zero(skb, len);
+	hdr->frame_control = cpu_to_le16(IEEE80211_FTYPE_DATA |
+					 (qos ? IEEE80211_STYPE_QOS_NULLFUNC :
+						IEEE80211_STYPE_NULLFUNC) |
+					 IEEE80211_FCTL_FROMDS);
+	memcpy(hdr->addr1, sta->addr, ETH_ALEN);
+	memcpy(hdr->addr2, vif->addr, ETH_ALEN);
+	memcpy(hdr->addr3, vif->addr, ETH_ALEN);
+	if (qos)
+		hdr->qos_ctrl = cpu_to_le16(7);
+	skb->priority = 7;
+	skb_set_queue_mapping(skb, IEEE80211_AC_VO);
+
+	info = IEEE80211_SKB_CB(skb);
+	memset(info, 0, sizeof(*info));
+	info->band = phy->chandef.chan->band;
+	info->hw_queue = vif->hw_queue[IEEE80211_AC_VO];
+	info->control.vif = vif;
+
+	wcid->silent_probes++;
+	mt76_tx(phy, sta, wcid, skb);
+}
+
+/* The held stations' probes whose time has come. Returns the jiffies until
+ * the next one is due, 0 with no station held.
+ */
+static unsigned long mt76_tx_silent_poll(struct mt76_dev *dev)
+{
+	unsigned long now = mt76_tx_silent_now(), next = 0;
+	bool any = false;
+	unsigned int idx;
+
+	rcu_read_lock();
+	for_each_set_bit(idx, dev->silent_wait, MT76_N_WCIDS) {
+		struct mt76_wcid *wcid = __mt76_wcid_ptr(dev, idx);
+		struct mt76_phy *phy;
+		unsigned int ms;
+
+		if (!wcid || !test_bit(MT_WCID_FLAG_SILENT, &wcid->flags)) {
+			clear_bit(idx, dev->silent_wait);
+			continue;
+		}
+
+		if (!READ_ONCE(silent_hold)) {
+			mt76_tx_silent_release(dev, wcid);
+			clear_bit(idx, dev->silent_wait);
+			continue;
+		}
+
+		phy = mt76_dev_phy(dev, wcid->phy_idx);
+		if (!time_before(now, wcid->silent_probe) && phy &&
+		    !test_bit(MT76_RESET, &phy->state) && !phy->offchannel) {
+			mt76_tx_silent_probe(dev, wcid);
+			ms = MT76_SILENT_PROBE_MS <<
+			     min_t(unsigned int, wcid->silent_probes_sent + 1, 6);
+			ms = min_t(unsigned int, ms, MT76_SILENT_PROBE_MAX_MS);
+			wcid->silent_probe = now + msecs_to_jiffies(ms);
+			if (wcid->silent_probes_sent < U8_MAX)
+				wcid->silent_probes_sent++;
+		} else if (!time_before(now, wcid->silent_probe)) {
+			/* the radio is away: look again shortly */
+			wcid->silent_probe = now +
+				msecs_to_jiffies(MT76_SILENT_PROBE_MS);
+		}
+
+		if (!any || time_before(wcid->silent_probe, now + next))
+			next = max_t(long, wcid->silent_probe - now, 1);
+		any = true;
+	}
+	rcu_read_unlock();
+
+	return any ? next : 0;
+}
+
+static void mt76_tx_silent_work(struct work_struct *work)
+{
+	struct mt76_dev *dev = container_of(work, struct mt76_dev,
+					    silent_work.work);
