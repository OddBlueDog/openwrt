+
 	if (status->flag & RX_FLAG_8023)
 		return;
 
@@ -1879,6 +1891,9 @@ void mt76_wcid_init(struct mt76_wcid *wcid, u8 band_idx)
 	 * (mt76_tx_ps_busy()), for as long as it stays associated.
 	 */
 	atomic_set(&wcid->non_aql_packets, 0);
+	/* it has just been heard from: it is being added */
+	wcid->heard = mt76_tx_silent_now();
+	clear_bit(MT_WCID_FLAG_SILENT, &wcid->flags);
 
