diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
index 411faabb..f300c4b1 100644
--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -1843,20 +1843,36 @@ DEFINE_SHOW_ATTRIBUTE(mt7915_queues);
 
 /* The station's power save as the firmware reports it (PS sync events),
  * since it was added: dozing now and for how long, how often it dozed, its
- * dozing time in all (the current doze included) and its longest doze.
+ * dozing time in all (the current doze included) and its longest doze. And
+ * what the firmware doesn't report: whether the driver holds the station
+ * now because it stopped answering while awake to the firmware
+ * (mt76_tx_result()), how often it has, for how long in all (this hold
+ * included) and how many probes it sent meanwhile.
  */
 static int
 mt7915_sta_ps_show(struct seq_file *s, void *data)
 {
 	struct ieee80211_sta *sta = s->private;
+	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
+	struct mt76_wcid *wcid = &msta->wcid;
 	struct mt7915_sta_ps_stats st;
+	bool silent = test_bit(MT_WCID_FLAG_SILENT, &wcid->flags);
+	u64 silent_ms = READ_ONCE(wcid->silent_ms);
+
+	if (silent)
+		silent_ms += jiffies_to_msecs(mt76_tx_silent_now() -
+					      READ_ONCE(wcid->silent_since));
 
-	mt7915_sta_ps_stats((struct mt7915_sta *)sta->drv_priv, &st);
+	mt7915_sta_ps_stats(msta, &st);
 	seq_printf(s, "dozing %d\n", st.dozing);
 	seq_printf(s, "since_ms %u\n", st.since_ms);
 	seq_printf(s, "dozes %u\n", st.dozes);
 	seq_printf(s, "dozing_ms %llu\n", st.dozing_ms);
 	seq_printf(s, "longest_ms %u\n", st.longest_ms);
+	seq_printf(s, "silent %d\n", silent);
+	seq_printf(s, "silent_holds %u\n", READ_ONCE(wcid->silent_holds));
+	seq_printf(s, "silent_ms %llu\n", silent_ms);
+	seq_printf(s, "silent_probes %u\n", READ_ONCE(wcid->silent_probes));
 
 	return 0;
 }
