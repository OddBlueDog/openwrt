From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Wed, 28 Oct 2026 13:23:55 +0100
Subject: [PATCH] wifi: mt76: mt7915: upload the CSA beacon only once

At the start of a CSA, __ieee80211_channel_switch() reports
BSS_CHANGED_BEACON with csa_active set and then calls
.channel_switch_beacon. mt7915_bss_info_changed() and
mt7915_channel_switch_beacon() thus both upload the same CSA beacon,
and each upload passes the initial count of the template to the
firmware.

Drop mt7915_channel_switch_beacon(). mac80211 calls it only after a
BSS_CHANGED_BEACON report, so mt7915_bss_info_changed() already uploads
the CSA beacon, like mt7996 does.

Fixes: e57b7901469f ("mt76: add mac80211 driver for MT7915 PCIe-based chipsets")
Link: https://patch.msgid.link/20261028122403.796394-17-nbd@nbd.name
Signed-off-by: Felix Fietkau <nbd@nbd.name>
(cherry picked from commit 2356292ae38faa6dc9e88330107459b50e924bf9)
[milkflint: the ops table keeps .post_channel_switch next to it; the mesh
beacon test no longer calls the dropped op, and the channel switch test
checks it is gone.]
---
 mt7915/main.c            | 13 -------------
 mt7915/tests/main-test.c |  7 +++++--
 2 files changed, 5 insertions(+), 15 deletions(-)

diff --git a/mt7915/main.c b/mt7915/main.c
index d75bd793..72787ef8 100644
--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -741,18 +741,6 @@ mt7915_stop_ap(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 	mutex_unlock(&dev->mt76.mutex);
 }
 
-static void
-mt7915_channel_switch_beacon(struct ieee80211_hw *hw,
-			     struct ieee80211_vif *vif,
-			     struct cfg80211_chan_def *chandef)
-{
-	struct mt7915_dev *dev = mt7915_hw_dev(hw);
-
-	mutex_lock(&dev->mt76.mutex);
-	mt7915_mcu_add_beacon(hw, vif, true, BSS_CHANGED_BEACON);
-	mutex_unlock(&dev->mt76.mutex);
-}
-
 static void
 mt7915_sta_vow_set_airtime_weight(struct mt7915_dev *dev,
 				  struct mt7915_sta *msta, u16 weight)
@@ -1988,7 +1976,6 @@ const struct ieee80211_ops mt7915_ops = {
 	.release_buffered_frames = mt76_release_buffered_frames,
 	.get_txpower = mt76_get_txpower,
 	.set_sar_specs = mt7915_set_sar_specs,
-	.channel_switch_beacon = mt7915_channel_switch_beacon,
 	.post_channel_switch = mt7915_post_channel_switch,
 	.get_stats = mt7915_get_stats,
 	.get_et_sset_count = mt7915_get_et_sset_count,
diff --git a/mt7915/tests/main-test.c b/mt7915/tests/main-test.c
index ba178279..fbd52aef 100644
--- a/mt7915/tests/main-test.c
+++ b/mt7915/tests/main-test.c
@@ -1499,7 +1499,6 @@ static void mt7915_main_test_bss_mesh_beacon(struct kunit *test)
 	mt7915_bss_info_changed(hw, vif, &vif->bss_conf,
 				BSS_CHANGED_FILS_DISCOVERY |
 				BSS_CHANGED_UNSOL_BCAST_PROBE_RESP);
-	mt7915_channel_switch_beacon(hw, vif, &dev->mphy.chandef);
 	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
 }
 
@@ -2694,7 +2693,9 @@ static void mt7915_main_test_chan44_160(struct kunit *test,
 
 /* After a channel switch the BSS gets its new channel: its RF_CH record
  * alone in a BSS_INFO_UPDATE, sent under the device mutex. A failed update
- * is only logged, so mac80211 doesn't stop the AP over it.
+ * is only logged, so mac80211 doesn't stop the AP over it. The switch's
+ * beacon goes up once, with the BSS_CHANGED_BEACON mac80211 reports as it
+ * starts: no .channel_switch_beacon uploads it again.
  */
 static void mt7915_main_test_post_channel_switch(struct kunit *test)
 {
@@ -2707,6 +2708,8 @@ static void mt7915_main_test_post_channel_switch(struct kunit *test)
 	struct ieee80211_vif *vif;
 	struct mt76_test_msg *msg;
 
+	KUNIT_EXPECT_NULL(test, MT7915_MAIN_TEST_OP(channel_switch_beacon));
+
 	vif = mt7915_main_test_ap(test, hw, 1);
 	mt7915_main_test_clear(fake);
 	mt7915_main_test_chan44_160(test, phy2);
