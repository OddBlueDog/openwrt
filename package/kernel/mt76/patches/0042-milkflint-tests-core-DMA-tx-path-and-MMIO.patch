 dma.c             |    4 +
 mmio.c            |    4 +
 tests/dma-test.c  | 2234 +++++++++++++++++++++++++++++++++++++++++++++
 tests/mmio-test.c |  221 +++++
 tests/tx-test.c   | 1534 +++++++++++++++++++++++++++++++
 tx.c              |    4 +
 6 files changed, 4001 insertions(+)
 create mode 100644 tests/dma-test.c
 create mode 100644 tests/mmio-test.c
 create mode 100644 tests/tx-test.c

