+/* Queue init sets up the NAPI devices and a NAPI context for each rx
+ * queue in use (not for RRO queues, nor unused ones), and fills the rings;
+ * cleanup completes what is still queued, empties the rings and frees the
+ * caches.
+ */
+static void mt76_dma_test_init_cleanup(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	u16 rro = __MT_WED_RRO_Q(MT76_WED_RRO_Q_IND, 0);
+	struct mt76_queue *rxq, *rroq, *txq, *mcuq;
+	struct mt76_dev *dev = t->dev;
+	struct napi_struct *napi;
+	struct sk_buff *skb;
+
+	rxq = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, 0);
+	rroq = mt76_dma_test_rx_queue(t, MT_RXQ_RRO_IND, 4, rro);
+	txq = mt76_dma_test_tx_queue(t, 0, 8);
+	mcuq = mt76_dma_test_tx_queue(t, 1, 8);
+	dev->phy.q_tx[MT_TXQ_BE] = txq;
+	dev->q_mcu[MT_MCUQ_WM] = mcuq;
+	skb = mt76_dma_test_skb(t, 40, 0);
+	KUNIT_ASSERT_GE(test, dev->queue_ops->tx_queue_skb(&dev->phy, txq,
+			MT_TXQ_BE, skb, NULL, NULL), 0);
+	skb = mt76_dma_test_skb(t, 40, 0);
+	KUNIT_ASSERT_EQ(test, dev->queue_ops->tx_queue_skb_raw(dev, mcuq, skb,
+			0), 0);
+	mt76_put_txwi(dev, mt76_get_txwi(dev));
+	mt76_put_rxwi(dev, mt76_get_rxwi(dev));
+
+	KUNIT_ASSERT_EQ(test, dev->queue_ops->init(dev, mt76_dma_rx_poll), 0);
+
+	KUNIT_ASSERT_NOT_NULL(test, dev->napi_dev);
+	KUNIT_ASSERT_NOT_NULL(test, dev->tx_napi_dev);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_priv(dev->napi_dev), dev);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_priv(dev->tx_napi_dev), dev);
+	KUNIT_EXPECT_STREQ(test, dev->napi_dev->name,
+			   wiphy_name(dev->hw->wiphy));
+	KUNIT_EXPECT_TRUE(test, dev->napi_dev->threaded);
+
+	napi = &dev->napi[MT_RXQ_MAIN];
+	KUNIT_EXPECT_PTR_EQ(test, (void *)napi->poll, (void *)mt76_dma_rx_poll);
+	KUNIT_EXPECT_PTR_EQ(test, napi->dev, dev->napi_dev);
+	KUNIT_EXPECT_FALSE(test, test_bit(NAPI_STATE_SCHED, &napi->state));
+	KUNIT_EXPECT_EQ(test, rxq->queued, 7);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(rxq)->cpu_idx, 7);
+	/* the RRO queue is left alone: not filled, NAPI not taken over */
+	napi = &dev->napi[MT_RXQ_RRO_IND];
+	KUNIT_EXPECT_NULL(test, (void *)napi->poll);
+	KUNIT_EXPECT_FALSE(test, test_bit(NAPI_STATE_LISTED, &napi->state));
+	KUNIT_EXPECT_EQ(test, rroq->queued, 0);
+	/* unused queues get none */
+	KUNIT_EXPECT_NULL(test, (void *)dev->napi[MT_RXQ_BAND1].poll);
+
+	/* what the driver does before the cleanup */
+	netif_napi_add_tx(dev->tx_napi_dev, &dev->tx_napi,
+			  mt76_dma_test_tx_poll);
+	napi_enable(&dev->tx_napi);
+	napi_disable(&dev->napi[MT_RXQ_MAIN]);
+
+	mt76_dma_cleanup(dev);
+	t->dma_cleaned = true;
+
+	KUNIT_EXPECT_EQ(test, t->n_done, 2);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 2);
+	KUNIT_EXPECT_EQ(test, txq->queued, 0);
+	KUNIT_EXPECT_EQ(test, mcuq->queued, 0);
+	KUNIT_EXPECT_EQ(test, rxq->queued, 0);
+	KUNIT_EXPECT_NULL(test, rxq->entry[0].buf);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->txwi_cache));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->rxwi_cache));
+	rxq->page_pool = NULL;
+	rroq->page_pool = NULL;
+}
+
+/* --- WED RRO rings (MT7988/MT7992 WED v3, not the MT7986) ------------------ */
+
+/* RRO indication commands are the ring itself: a new ring has every
+ * command at the last magic count, a command is new only once it carries
+ * the ring's current count, and the count advances with each lap.
+ */
+static void mt76_dma_test_rro_ind(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	u16 flags = __MT_WED_RRO_Q(MT76_WED_RRO_Q_IND, 0);
+	struct mt76_wed_rro_desc *ring;
+	struct mt76_dev *dev = t->dev;
+	struct mt76_wed_rro_ind *cmd;
+	struct mt76_queue *q;
+	int i;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_RRO_IND, 4, flags);
+	ring = (struct mt76_wed_rro_desc *)q->desc;
+	for (i = 0; i < 4; i++) {
+		cmd = (struct mt76_wed_rro_ind *)&ring[i];
+		KUNIT_EXPECT_EQ(test, FIELD_GET(RRO_IND_DATA1_MAGIC_CNT_MASK,
+						le32_to_cpu(cmd->data1)),
+				MT_DMA_WED_IND_CMD_CNT - 1);
+	}
+	KUNIT_EXPECT_EQ(test, q->magic_cnt, 0);
+
+	/* the "buffers" are the commands, no page is taken */
+	KUNIT_EXPECT_EQ(test, mt76_dma_rx_fill(dev, q, false), 3);
+	KUNIT_EXPECT_PTR_EQ(test, q->entry[1].buf, (void *)&ring[1]);
+
+	/* nothing new yet */
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 0);
+
+	cmd = (struct mt76_wed_rro_ind *)&ring[0];
+	cmd->data1 = cpu_to_le32(FIELD_PREP(RRO_IND_DATA1_MAGIC_CNT_MASK, 0));
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 1);
+	KUNIT_EXPECT_EQ(test, t->n_rro_ind, 1);
+	KUNIT_EXPECT_PTR_EQ(test, t->rro_ind, (void *)cmd);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&t->rx), 0);
+
+	/* to the end of the lap: the count moves on */
+	for (i = 1; i < 4; i++) {
+		cmd = (struct mt76_wed_rro_ind *)&ring[i];
+		cmd->data1 = cpu_to_le32(FIELD_PREP(RRO_IND_DATA1_MAGIC_CNT_MASK,
+						    0));
+	}
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 3);
+	KUNIT_EXPECT_EQ(test, q->magic_cnt, 1);
+	KUNIT_EXPECT_EQ(test, q->tail, 0);
+
+	/* slot 0 still has last lap's count: not new */
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 0);
+	cmd = (struct mt76_wed_rro_ind *)&ring[0];
+	cmd->data1 = cpu_to_le32(FIELD_PREP(RRO_IND_DATA1_MAGIC_CNT_MASK, 1));
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 1);
+	KUNIT_EXPECT_EQ(test, t->n_rro_ind, 5);
+
+	/* a reset keeps the command layout and restarts the count */
+	dev->queue_ops->reset_q(dev, q, true);
+	KUNIT_EXPECT_EQ(test, q->magic_cnt, 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(RRO_IND_DATA1_MAGIC_CNT_MASK,
+					le32_to_cpu(cmd->data1)),
+			MT_DMA_WED_IND_CMD_CNT - 1);
+	q->queued = 0;
+}
+
+/* RXDMAD_C descriptors point at RRO data buffers by rx token: the frame is
+ * built from the token's buffer with the descriptor's length, repeated or
+ * old packets are dropped, and an unknown token is skipped.
+ */
+static void mt76_dma_test_rro_rxdmad_c(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_rro_rxdmad_c *dmad;
+	struct mt76_queue *data, *q;
+	struct sk_buff *skb;
+	void *buf2;
+	int i;
+
+	data = mt76_dma_test_rx_queue(t, MT_RXQ_RRO_BAND0, 8,
+			__MT_WED_RRO_Q(MT76_WED_RRO_Q_DATA, 0));
+	KUNIT_ASSERT_EQ(test, mt76_dma_rx_fill(dev, data, false), 7);
+	/* RRO data buffers get tokens too */
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_TOKEN,
+					le32_to_cpu(data->desc[2].buf1)), 2);
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_RRO_RXDMAD_C, 4,
+			__MT_WED_RRO_Q(MT76_WED_RRO_Q_RXDMAD_C, 0));
+	dmad = (struct mt76_rro_rxdmad_c *)q->desc;
+	for (i = 0; i < 4; i++)
+		KUNIT_EXPECT_EQ(test, FIELD_GET(RRO_RXDMAD_DATA3_MAGIC_CNT_MASK,
+						le32_to_cpu(dmad[i].data3)),
+				MT_DMA_MAGIC_CNT - 1);
+	KUNIT_EXPECT_EQ(test, mt76_dma_rx_fill(dev, q, false), 3);
+	KUNIT_EXPECT_PTR_EQ(test, q->entry[0].buf, (void *)&dmad[0]);
+
+	buf2 = data->entry[2].buf;
+	memset(buf2, 0x2c, 120);
+	dma_sync_single_for_device(dev->dma_dev, data->entry[2].dma_addr[0],
+				   120, DMA_FROM_DEVICE);
+	dmad[0].data1 = cpu_to_le32(FIELD_PREP(RRO_RXDMAD_DATA1_SDL0_MASK,
+					       120) | RRO_RXDMAD_DATA1_LS_MASK);
+	dmad[0].data2 = cpu_to_le32(FIELD_PREP(RRO_RXDMAD_DATA2_RX_TOKEN_ID_MASK,
+					       2));
+	/* a repeated packet in token 4's buffer */
+	dmad[1].data1 = dmad[0].data1;
+	dmad[1].data2 = cpu_to_le32(FIELD_PREP(RRO_RXDMAD_DATA2_RX_TOKEN_ID_MASK,
+					       4) |
+				    FIELD_PREP(RRO_RXDMAD_DATA2_IND_REASON_MASK,
+					       MT_DMA_WED_IND_REASON_REPEAT));
+	/* a token nobody holds */
+	dmad[2].data1 = dmad[0].data1;
+	dmad[2].data2 = cpu_to_le32(FIELD_PREP(RRO_RXDMAD_DATA2_RX_TOKEN_ID_MASK,
+					       50));
+	for (i = 0; i < 3; i++)
+		dmad[i].data3 = cpu_to_le32(FIELD_PREP(RRO_RXDMAD_DATA3_MAGIC_CNT_MASK,
+						       0));
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 3);
+
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&t->rx), 1);
+	skb = skb_peek(&t->rx);
+	KUNIT_EXPECT_PTR_EQ(test, (void *)skb->head, buf2);
+	KUNIT_EXPECT_EQ(test, skb->len, 120);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_skb_filled(skb, 0, 120, 0x2c));
+	KUNIT_EXPECT_EQ(test, t->rx_qid, MT_RXQ_RRO_RXDMAD_C);
+	/* there is no descriptor info for these */
+	KUNIT_EXPECT_EQ(test, t->rx_info, 0);
+	/* both tokens were released, their rxwis cached */
+	KUNIT_EXPECT_NULL(test, idr_find(&dev->rx_token, 2));
+	KUNIT_EXPECT_NULL(test, idr_find(&dev->rx_token, 4));
+	KUNIT_EXPECT_NOT_NULL(test, idr_find(&dev->rx_token, 3));
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->rxwi_cache), 2);
+	/* their buffers left the data ring's token list */
+	data->entry[2].buf = NULL;
+	data->entry[4].buf = NULL;
+}
+
+/* With hardware RRO (WED_RRO_EN) the ring size register carries the RRO
+ * enable bit, each buffer is stamped with the lap's magic count, and rx
+ * only runs up to the hardware's dma_idx, which a dead bus can't move.
+ */
+static void mt76_dma_test_rro_en(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue_regs *regs;
+	struct mt76_queue *q;
+	int i;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 4, MT_QFLAG_WED_RRO_EN);
+	regs = mt76_dma_test_qregs(q);
+	KUNIT_EXPECT_EQ(test, regs->ring_size, MT_DMA_RRO_EN | 4);
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_rx_fill(dev, q, false), 3);
+	for (i = 0; i < 3; i++)
+		KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_MAGIC_MASK,
+					le32_to_cpu(q->desc[i].info)), 0);
+
+	for (i = 0; i < 3; i++)
+		mt76_dma_test_rx_frame(t, q, i, 50, i);
+	regs->dma_idx = 0xffffffff;
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 0);
+
+	regs->dma_idx = 1;
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 1);
+	KUNIT_EXPECT_EQ(test, q->tail, 1);
+	/* slot 3 closed the lap: slot 0 gets the next count */
+	KUNIT_EXPECT_EQ(test, q->magic_cnt, 1);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_MAGIC_MASK,
+					le32_to_cpu(q->desc[3].info)), 0);
+
+	regs->dma_idx = 3;
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 2);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&t->rx), 3);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_MAGIC_MASK,
+					le32_to_cpu(q->desc[0].info)), 1);
+}
+
+/* MSDU page rings register each buffer with the driver; a buffer the
+ * driver can't take stops the fill.
+ */
+static void mt76_dma_test_rro_msdu_page(struct kunit *test)
+{
+	u16 flags = __MT_WED_RRO_Q(MT76_WED_RRO_Q_MSDU_PG, 0);
+	struct mt76_dma_test *t;
+	struct mt76_queue *q;
+	struct mt76_dev *dev;
+
+	t = mt76_dma_test_init(test, &mt76_dma_test_drv_msdu_page);
+	dev = t->dev;
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MSDU_PAGE_BAND0, 4, flags);
+
+	t->msdu_page_ret = -ENOMEM;
+	KUNIT_EXPECT_EQ(test, mt76_dma_rx_fill(dev, q, false), 0);
+	KUNIT_EXPECT_EQ(test, t->n_msdu_page, 1);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+
+	t->msdu_page_ret = 0;
+	KUNIT_EXPECT_EQ(test, mt76_dma_rx_fill(dev, q, false), 3);
+	KUNIT_EXPECT_EQ(test, t->n_msdu_page, 4);
+	KUNIT_EXPECT_EQ(test, t->msdu_page_addr, q->entry[2].dma_addr[0]);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[2].buf0),
+			lower_32_bits(q->entry[2].dma_addr[0]));
+}
+
