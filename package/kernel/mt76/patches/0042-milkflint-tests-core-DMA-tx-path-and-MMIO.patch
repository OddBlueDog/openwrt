@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for mt76's MMIO bus ops: mt76_mmio_init() and the register
+ * accessors it installs, run on a plain buffer standing in for the MMIO
+ * window. Included at the end of mmio.c when CONFIG_MT76_KUNIT_TEST is
+ * defined (milkflint's QEMU test build only).
+ */
+#include <kunit/test.h>
+#include "fake.h"
+
+#define MT76_MMIO_TEST_SIZE	0x100
+
+/* fake.h's mt76_test_hw_ops, plus the channel context ops mac80211 (6.9+)
+ * insists on: without them mt76_test_dev() can't allocate the hw.
+ */
+static const struct ieee80211_ops mt76_mmio_test_hw_ops = {
+	.tx = mt76_test_tx,
+	.start = mt76_test_start,
+	.stop = mt76_test_stop,
+	.add_interface = mt76_test_add_interface,
+	.remove_interface = mt76_test_remove_interface,
+	.config = mt76_test_config,
+	.configure_filter = mt76_test_configure_filter,
+	.wake_tx_queue = mt76_test_wake_tx_queue,
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
+};
+
+/* A device whose bus is MMIO on a zeroed buffer, returned in @regs. */
+static struct mt76_dev *mt76_mmio_test_dev(struct kunit *test, u32 **regs)
+{
+	struct mt76_dev *dev;
+
+	dev = mt76_test_dev(test, sizeof(*dev), &mt76_mmio_test_hw_ops, NULL);
+	*regs = kunit_kzalloc(test, MT76_MMIO_TEST_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, *regs);
+	mt76_mmio_init(dev, (void __iomem *)*regs);
+
+	return dev;
+}
+
+/* Init installs the MMIO ops on the window it's given: plain register
+ * reads and writes hit the window at the register's offset.
+ */
+static void mt76_mmio_test_init_rr_wr(struct kunit *test)
+{
+	struct mt76_dev *dev;
+	u32 *regs;
+
+	dev = mt76_mmio_test_dev(test, &regs);
+
+	KUNIT_EXPECT_EQ(test, dev->bus->type, MT76_BUS_MMIO);
+	KUNIT_EXPECT_PTR_EQ(test, (void *)dev->mmio.regs, (void *)regs);
+	KUNIT_EXPECT_TRUE(test, mt76_is_mmio(dev));
+
+	__mt76_wr(dev, 0x10, 0xdeadbeef);
+	KUNIT_EXPECT_EQ(test, regs[0x10 / 4], 0xdeadbeef);
+	KUNIT_EXPECT_EQ(test, regs[0x0c / 4], 0);
+	KUNIT_EXPECT_EQ(test, regs[0x14 / 4], 0);
+
+	regs[0x24 / 4] = 0x01234567;
+	KUNIT_EXPECT_EQ(test, __mt76_rr(dev, 0x24), 0x01234567);
+	KUNIT_EXPECT_EQ(test, __mt76_rr(dev, 0x10), 0xdeadbeef);
+}
+
+/* Read-modify-write replaces only the masked bits and returns the value
+ * written.
+ */
+static void mt76_mmio_test_rmw(struct kunit *test)
+{
+	struct mt76_dev *dev;
+	u32 *regs;
+
+	dev = mt76_mmio_test_dev(test, &regs);
+	regs[0x40 / 4] = 0xaabbccdd;
+
+	KUNIT_EXPECT_EQ(test, __mt76_rmw(dev, 0x40, 0x0000ff00, 0x1200),
+			0xaabb12dd);
+	KUNIT_EXPECT_EQ(test, regs[0x40 / 4], 0xaabb12dd);
+
+	/* bits outside the mask in @val are still set (callers' contract) */
+	KUNIT_EXPECT_EQ(test, __mt76_rmw(dev, 0x40, 0xff000000, 0x5a000000),
+			0x5abb12dd);
+	KUNIT_EXPECT_EQ(test, regs[0x40 / 4], 0x5abb12dd);
+	KUNIT_EXPECT_EQ(test, regs[0x44 / 4], 0);
+}
+
+/* Copies to registers go in 32-bit little-endian words; a tail shorter
+ * than a word is zero-padded and the register after it is left alone.
+ */
+static void mt76_mmio_test_write_copy(struct kunit *test)
+{
+	static const u8 data[] = { 0x11, 0x22, 0x33, 0x44, 0x55, 0x66 };
+	struct mt76_dev *dev;
+	u32 *regs;
+
+	dev = mt76_mmio_test_dev(test, &regs);
+	regs[0x84 / 4] = 0xffffffff;
+	regs[0x88 / 4] = 0xcafef00d;
+
+	__mt76_wr_copy(dev, 0x80, data, sizeof(data));
+
+	KUNIT_EXPECT_EQ(test, regs[0x80 / 4], 0x44332211);
+	KUNIT_EXPECT_EQ(test, regs[0x84 / 4], 0x00006655);
+	KUNIT_EXPECT_EQ(test, regs[0x88 / 4], 0xcafef00d);
+
+	/* whole words only: nothing past them */
+	__mt76_wr_copy(dev, 0x88, data, 4);
+	KUNIT_EXPECT_EQ(test, regs[0x88 / 4], 0x44332211);
+	KUNIT_EXPECT_EQ(test, regs[0x8c / 4], 0);
+}
+
+/* Copies from registers fill exactly @len bytes, the tail from the low
+ * bytes of the last register.
+ */
+static void mt76_mmio_test_read_copy(struct kunit *test)
+{
+	struct mt76_dev *dev;
+	u8 buf[8];
+	u32 *regs;
+
+	dev = mt76_mmio_test_dev(test, &regs);
+	regs[0x90 / 4] = 0x44332211;
+	regs[0x94 / 4] = 0x88776655;
+
+	memset(buf, 0xee, sizeof(buf));
+	__mt76_rr_copy(dev, 0x90, buf, 7);
+
+	KUNIT_EXPECT_EQ(test, buf[0], 0x11);
+	KUNIT_EXPECT_EQ(test, buf[3], 0x44);
+	KUNIT_EXPECT_EQ(test, buf[4], 0x55);
+	KUNIT_EXPECT_EQ(test, buf[6], 0x77);
+	/* nothing written past @len */
+	KUNIT_EXPECT_EQ(test, buf[7], 0xee);
+
+	memset(buf, 0xee, sizeof(buf));
+	__mt76_rr_copy(dev, 0x94, buf, 4);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(buf), 0x88776655);
+	KUNIT_EXPECT_EQ(test, buf[4], 0xee);
+}
+
+/* Register pair lists are written and read at the registers' own offsets:
+ * on MMIO the base (the MCU window on USB) plays no part.
+ */
+static void mt76_mmio_test_reg_pairs(struct kunit *test)
+{
+	struct mt76_reg_pair wr[] = {
+		{ .reg = 0x20, .value = 0x1111 },
+		{ .reg = 0x28, .value = 0x2222 },
+		{ .reg = 0x30, .value = 0x3333 },
+	};
+	struct mt76_reg_pair rd[] = {
+		{ .reg = 0x28 },
+		{ .reg = 0x20 },
+		{ .reg = 0x34 },
+	};
+	struct mt76_dev *dev;
+	u32 *regs;
+
+	dev = mt76_mmio_test_dev(test, &regs);
+	regs[0x34 / 4] = 0x4444;
+
+	/* only the first two pairs */
+	KUNIT_EXPECT_EQ(test, dev->bus->wr_rp(dev, 0x80, wr, 2), 0);
+	KUNIT_EXPECT_EQ(test, regs[0x20 / 4], 0x1111);
+	KUNIT_EXPECT_EQ(test, regs[0x28 / 4], 0x2222);
+	KUNIT_EXPECT_EQ(test, regs[0x30 / 4], 0);
+	KUNIT_EXPECT_EQ(test, regs[0xa0 / 4], 0);
+
+	KUNIT_EXPECT_EQ(test, dev->bus->rd_rp(dev, 0x80, rd, ARRAY_SIZE(rd)),
+			0);
+	KUNIT_EXPECT_EQ(test, rd[0].value, 0x2222);
+	KUNIT_EXPECT_EQ(test, rd[1].value, 0x1111);
+	KUNIT_EXPECT_EQ(test, rd[2].value, 0x4444);
+	KUNIT_EXPECT_EQ(test, rd[0].reg, 0x28);
+}
+
+/* The interrupt mask is kept in software and written to the mask
+ * register; without a register address only the cached copy changes.
+ */
+static void mt76_mmio_test_irq_mask(struct kunit *test)
+{
+	struct mt76_dev *dev;
+	u32 *regs;
+
+	dev = mt76_mmio_test_dev(test, &regs);
+
+	mt76_set_irq_mask(dev, 0x50, 0, BIT(0) | BIT(4) | BIT(9));
+	KUNIT_EXPECT_EQ(test, dev->mmio.irqmask, BIT(0) | BIT(4) | BIT(9));
+	KUNIT_EXPECT_EQ(test, regs[0x50 / 4], BIT(0) | BIT(4) | BIT(9));
+
+	/* clear and set in one call */
+	mt76_set_irq_mask(dev, 0x50, BIT(4), BIT(12));
+	KUNIT_EXPECT_EQ(test, dev->mmio.irqmask, BIT(0) | BIT(9) | BIT(12));
+	KUNIT_EXPECT_EQ(test, regs[0x50 / 4], BIT(0) | BIT(9) | BIT(12));
+
+	/* no register: the hardware isn't touched */
+	mt76_set_irq_mask(dev, 0, BIT(0), 0);
+	KUNIT_EXPECT_EQ(test, dev->mmio.irqmask, BIT(9) | BIT(12));
+	KUNIT_EXPECT_EQ(test, regs[0x50 / 4], BIT(0) | BIT(9) | BIT(12));
+	KUNIT_EXPECT_EQ(test, regs[0], 0);
+}
+
+static struct kunit_case mt76_mmio_test_cases[] = {
+	KUNIT_CASE(mt76_mmio_test_init_rr_wr),
+	KUNIT_CASE(mt76_mmio_test_rmw),
+	KUNIT_CASE(mt76_mmio_test_write_copy),
+	KUNIT_CASE(mt76_mmio_test_read_copy),
+	KUNIT_CASE(mt76_mmio_test_reg_pairs),
+	KUNIT_CASE(mt76_mmio_test_irq_mask),
+	{}
+};
+
+static struct kunit_suite mt76_mmio_test_suite = {
+	.name = "mt76-mmio",
+	.test_cases = mt76_mmio_test_cases,
+};
+
+kunit_test_suites(&mt76_mmio_test_suite);
diff --git a/tests/tx-test.c b/tests/tx-test.c
new file mode 100644
index 00000000..06efa373
--- /dev/null
+++ b/tests/tx-test.c
@@ -0,0 +1,1534 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for mt76's tx path (tx.c): queueing and scheduling of
+ * pending frames, tx status tracking, non-AQL accounting, power save and
+ * tokens. Included at the end of tx.c when CONFIG_MT76_KUNIT_TEST is
+ * defined (milkflint's QEMU test build only).
+ *
+ * The hardware queues are a test queue_ops that records what it is given.
+ * mac80211 isn't registered, so there are no mac80211 stations or txqs:
+ * stations here are bare ieee80211_sta structs carrying the wcid in
+ * drv_priv, and nothing hands them to a mac80211 function that would look
+ * at its own part of the station (tx status reports go without one).
+ * The tx worker is parked, so scheduling it only sets its flag.
+ */
+#include <kunit/test.h>
+#include "fake.h"
+
+#define MT76_TX_TEST_NDESC	64
+#define MT76_TX_TEST_MAX_WCID	8
+
+struct mt76_tx_test_rec {
+	struct mt76_phy *phy;
+	struct mt76_queue *q;
+	enum mt76_txq_id qid;
+	struct sk_buff *skb;
+	struct mt76_wcid *wcid;
+	struct ieee80211_sta *sta;
+};
+
+struct mt76_tx_test {
+	struct kunit *test;
+	struct mt76_dev *dev;
+
+	struct mt76_tx_test_rec rec[16];	/* tx_queue_skb calls */
+	int n_queued;
+	struct sk_buff_head queued;
+	int queue_ret;
+	int n_kick;
+	struct mt76_queue *kick_q;
+	int n_cleanup;
+
+	int n_complete;
+	struct mt76_queue_entry complete;
+
+	struct mt76_wcid *wcids[MT76_TX_TEST_MAX_WCID];
+	int n_wcids;
+	int n_freed;
+};
+
+static struct mt76_tx_test *mt76_tx_test_ctx;
+
+/* fake.h's mt76_test_hw_ops, plus the channel context ops mac80211 (6.9+)
+ * insists on: without them mt76_test_dev() can't allocate the hw.
+ */
+static const struct ieee80211_ops mt76_tx_test_hw_ops = {
+	.tx = mt76_test_tx,
+	.start = mt76_test_start,
+	.stop = mt76_test_stop,
+	.add_interface = mt76_test_add_interface,
+	.remove_interface = mt76_test_remove_interface,
+	.config = mt76_test_config,
+	.configure_filter = mt76_test_configure_filter,
+	.wake_tx_queue = mt76_test_wake_tx_queue,
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
+};
+
+static int mt76_tx_test_queue_skb(struct mt76_phy *phy, struct mt76_queue *q,
+				  enum mt76_txq_id qid, struct sk_buff *skb,
+				  struct mt76_wcid *wcid,
+				  struct ieee80211_sta *sta)
+{
+	struct mt76_tx_test *t = mt76_tx_test_ctx;
+	int idx;
+
+	if (t->queue_ret) {
+		ieee80211_free_txskb(phy->hw, skb);
+		return t->queue_ret;
+	}
+
+	if (t->n_queued < ARRAY_SIZE(t->rec)) {
+		struct mt76_tx_test_rec *r = &t->rec[t->n_queued];
+
+		r->phy = phy;
+		r->q = q;
+		r->qid = qid;
+		r->skb = skb;
+		r->wcid = wcid;
+		r->sta = sta;
+	}
+	t->n_queued++;
+	skb_queue_tail(&t->queued, skb);
+
+	idx = q->head;
+	q->head = (q->head + 1) % q->ndesc;
+	q->queued++;
+	q->entry[idx].wcid = 0xffff;
+
+	return idx;
+}
+
+static void mt76_tx_test_kick(struct mt76_dev *dev, struct mt76_queue *q)
+{
+	struct mt76_tx_test *t = mt76_tx_test_ctx;
+
+	t->n_kick++;
+	t->kick_q = q;
+}
+
+static void mt76_tx_test_cleanup(struct mt76_dev *dev, struct mt76_queue *q,
+				 bool flush)
+{
+	mt76_tx_test_ctx->n_cleanup++;
+}
+
+static const struct mt76_queue_ops mt76_tx_test_queue_ops = {
+	.tx_queue_skb = mt76_tx_test_queue_skb,
+	.tx_cleanup = mt76_tx_test_cleanup,
+	.kick = mt76_tx_test_kick,
+};
+
+static void mt76_tx_test_complete(struct mt76_dev *dev,
+				  struct mt76_queue_entry *e)
+{
+	struct mt76_tx_test *t = mt76_tx_test_ctx;
+
+	t->n_complete++;
+	t->complete = *e;
+}
+
+static const struct mt76_driver_ops mt76_tx_test_drv = {
+	.tx_complete_skb = mt76_tx_test_complete,
+};
+
+/* the mt7915's: management frames have a hardware queue */
+static const struct mt76_driver_ops mt76_tx_test_drv_mgmt_txq = {
+	.drv_flags = MT_DRV_HW_MGMT_TXQ,
+	.tx_complete_skb = mt76_tx_test_complete,
+};
+
+static const struct mt76_driver_ops mt76_tx_test_drv_hw_ps = {
+	.drv_flags = MT_DRV_HW_PS_BUFFERING,
+	.tx_complete_skb = mt76_tx_test_complete,
+};
+
+static const struct mt76_driver_ops mt76_tx_test_drv_ignore_txs = {
+	.drv_flags = MT_DRV_IGNORE_TXS_FAILED,
+	.tx_complete_skb = mt76_tx_test_complete,
+};
+
+static void mt76_tx_test_teardown(void *data)
+{
+	struct mt76_tx_test *t = data;
+	int i;
+
+	for (i = 0; i < t->n_wcids; i++) {
+		struct mt76_wcid *wcid = t->wcids[i];
+		struct sk_buff *skb;
+		int id;
+
+		/* as if their DMA completed, so the flush reports them */
+		idr_for_each_entry(&wcid->pktid, skb, id)
+			mt76_tx_skb_cb(skb)->flags |= MT_TX_CB_DMA_DONE;
+		/* report what's left without a station */
+		wcid->sta = 0;
+		wcid->def_wcid = NULL;
+		mt76_wcid_cleanup(t->dev, wcid);
+		if (rcu_access_pointer(t->dev->wcid[wcid->idx]) == wcid)
+			RCU_INIT_POINTER(t->dev->wcid[wcid->idx], NULL);
+	}
+	skb_queue_purge(&t->queued);
+	mt76_tx_test_ctx = NULL;
+}
+
+/* A hardware queue as the scheduler sees it. */
+static struct mt76_queue *mt76_tx_test_hwq(struct mt76_tx_test *t)
+{
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+
+	/* device-managed: the teardown runs after kunit allocations go */
+	q = devm_kzalloc(dev->dev, sizeof(*q), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(t->test, q);
+	q->entry = devm_kcalloc(dev->dev, MT76_TX_TEST_NDESC,
+				sizeof(*q->entry), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(t->test, q->entry);
+	q->ndesc = MT76_TX_TEST_NDESC;
+	spin_lock_init(&q->lock);
+	spin_lock_init(&q->cleanup_lock);
+
+	return q;
+}
+
+static void mt76_tx_test_phy_init(struct mt76_tx_test *t,
+				  struct mt76_phy *phy)
+{
+	int i;
+
+	INIT_LIST_HEAD(&phy->tx_list);
+	spin_lock_init(&phy->tx_lock);
+	for (i = 0; i < __MT_TXQ_MAX; i++)
+		phy->q_tx[i] = mt76_tx_test_hwq(t);
+}
+
+static struct mt76_tx_test *
+mt76_tx_test_init(struct kunit *test, const struct mt76_driver_ops *drv)
+{
+	struct mt76_tx_test *t;
+	struct mt76_dev *dev;
+
+	t = kunit_kzalloc(test, sizeof(*t), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, t);
+	t->test = test;
+	skb_queue_head_init(&t->queued);
+
+	dev = mt76_test_dev(test, sizeof(*dev), &mt76_tx_test_hw_ops,
+			    drv ?: &mt76_tx_test_drv);
+	t->dev = dev;
+	dev->queue_ops = &mt76_tx_test_queue_ops;
+	mt76_tx_test_phy_init(t, &dev->phy);
+
+	/* a parked worker: mt76_worker_schedule() only sets its flag */
+	KUNIT_ASSERT_EQ(test, mt76_worker_setup(dev->hw, &dev->tx_worker,
+			NULL, "test"), 0);
+	mt76_worker_disable(&dev->tx_worker);
+
+	mt76_tx_test_ctx = t;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_tx_test_teardown, t), 0);
+	return t;
+}
+
+/* whether the tx worker was scheduled since the last call */
+static bool mt76_tx_test_worker_scheduled(struct mt76_dev *dev)
+{
+	return test_and_clear_bit(MT76_WORKER_SCHEDULED,
+				  &dev->tx_worker.state);
+}
+
+/* A wcid at index @idx on band @band, published in dev->wcid[] (if
+ * @publish), with a station around it (if @sta). Its rates are set, as
+ * mt76_tx() would otherwise ask mac80211's rate control for some.
+ */
+static struct mt76_wcid *
+mt76_tx_test_wcid(struct mt76_tx_test *t, u16 idx, u8 band, bool sta,
+		  bool publish)
+{
+	struct mt76_dev *dev = t->dev;
+	struct mt76_wcid *wcid;
+
+	KUNIT_ASSERT_LT(t->test, t->n_wcids, MT76_TX_TEST_MAX_WCID);
+	if (sta) {
+		struct ieee80211_sta *s;
+
+		s = devm_kzalloc(dev->dev, sizeof(*s) + sizeof(*wcid),
+				 GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(t->test, s);
+		wcid = (struct mt76_wcid *)s->drv_priv;
+	} else {
+		wcid = devm_kzalloc(dev->dev, sizeof(*wcid), GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(t->test, wcid);
+	}
+	mt76_wcid_init(wcid, band);
+	wcid->idx = idx;
+	wcid->sta = sta;
+	wcid->tx_info = MT_WCID_TX_INFO_SET;
+	if (publish)
+		rcu_assign_pointer(dev->wcid[idx], wcid);
+	t->wcids[t->n_wcids++] = wcid;
+
+	return wcid;
+}
+
+static void mt76_tx_test_skb_destructor(struct sk_buff *skb)
+{
+	if (mt76_tx_test_ctx)
+		mt76_tx_test_ctx->n_freed++;
+}
+
+/* An 802.11 frame of type @fc on access category @ac. */
+static struct sk_buff *mt76_tx_test_frame(struct mt76_tx_test *t, u16 fc,
+					  int ac)
+{
+	struct ieee80211_hdr *hdr;
+	struct sk_buff *skb;
+
+	skb = alloc_skb(128, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(t->test, skb);
+	skb_reserve(skb, 32);
+	hdr = skb_put_zero(skb, 64);
+	hdr->frame_control = cpu_to_le16(fc);
+	skb_set_queue_mapping(skb, ac);
+	skb->destructor = mt76_tx_test_skb_destructor;
+
+	return skb;
+}
+
+#define MT76_TX_TEST_DATA	(IEEE80211_FTYPE_DATA | IEEE80211_STYPE_DATA)
+#define MT76_TX_TEST_QOS	(IEEE80211_FTYPE_DATA | IEEE80211_STYPE_QOS_DATA)
+#define MT76_TX_TEST_MGMT(s)	(IEEE80211_FTYPE_MGMT | IEEE80211_STYPE_##s)
+
+static struct sk_buff *mt76_tx_test_data(struct mt76_tx_test *t, int ac)
+{
+	return mt76_tx_test_frame(t, MT76_TX_TEST_DATA, ac);
+}
+
+/* queue @skb on @wcid's @head the way mt76_tx() does */
+static void mt76_tx_test_pend(struct mt76_phy *phy, struct mt76_wcid *wcid,
+			      struct sk_buff *skb, struct sk_buff_head *head)
+{
+	__skb_queue_tail(head, skb);
+	if (list_empty(&wcid->tx_list))
+		list_add_tail(&wcid->tx_list, &phy->tx_list);
+}
+
+/* --- mt76_tx() and the pending lists -------------------------------------- */
+
+/* mt76_tx() queues a frame on its station's pending list, tagged with the
+ * phy's band, puts the station on the phy's tx list (once) and kicks the
+ * tx worker.
+ */
+static void mt76_tx_test_tx_pending(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_phy *phy = &dev->phy;
+	struct sk_buff *a, *b;
+	struct mt76_wcid *wcid;
+
+	wcid = mt76_tx_test_wcid(t, 5, 0, false, true);
+	phy->band_idx = MT_BAND1;
+	a = mt76_tx_test_data(t, IEEE80211_AC_VI);
+	b = mt76_tx_test_data(t, IEEE80211_AC_BE);
+
+	mt76_tx(phy, NULL, wcid, a);
+
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&wcid->tx_pending), 1);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&wcid->tx_offchannel), 0);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&phy->tx_list), 1);
+	KUNIT_EXPECT_PTR_EQ(test, list_first_entry(&phy->tx_list,
+			struct mt76_wcid, tx_list), wcid);
+	KUNIT_EXPECT_EQ(test, IEEE80211_SKB_CB(a)->hw_queue &
+			      MT_TX_HW_QUEUE_PHY,
+			FIELD_PREP(MT_TX_HW_QUEUE_PHY, MT_BAND1));
+	KUNIT_EXPECT_TRUE(test, mt76_tx_test_worker_scheduled(dev));
+
+	mt76_tx(phy, NULL, wcid, b);
+
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&wcid->tx_pending), 2);
+	KUNIT_EXPECT_PTR_EQ(test, skb_peek(&wcid->tx_pending), a);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&phy->tx_list), 1);
+	KUNIT_EXPECT_TRUE(test, mt76_tx_test_worker_scheduled(dev));
+	/* nothing reaches the hardware before the worker runs */
+	KUNIT_EXPECT_EQ(test, t->n_queued, 0);
+	phy->band_idx = MT_BAND0;
+}
+
+/* Off-channel frames, and probe requests that ignore the rate mask (scan
+ * probes), go on the off-channel list, which can be sent while the phy is
+ * away from its operating channel.
+ */
+static void mt76_tx_test_tx_offchannel(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_phy *phy = &t->dev->phy;
+	struct sk_buff *off, *probe, *probe2, *data;
+	struct mt76_wcid *wcid;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, false, true);
+	off = mt76_tx_test_data(t, IEEE80211_AC_BE);
+	IEEE80211_SKB_CB(off)->flags |= IEEE80211_TX_CTL_TX_OFFCHAN;
+	probe = mt76_tx_test_frame(t, MT76_TX_TEST_MGMT(PROBE_REQ),
+				   IEEE80211_AC_VO);
+	IEEE80211_SKB_CB(probe)->control.flags |=
+		IEEE80211_TX_CTRL_DONT_USE_RATE_MASK;
+	probe2 = mt76_tx_test_frame(t, MT76_TX_TEST_MGMT(PROBE_REQ),
+				    IEEE80211_AC_VO);
+	data = mt76_tx_test_data(t, IEEE80211_AC_BE);
+	IEEE80211_SKB_CB(data)->control.flags |=
+		IEEE80211_TX_CTRL_DONT_USE_RATE_MASK;
+
+	mt76_tx(phy, NULL, wcid, off);
+	mt76_tx(phy, NULL, wcid, probe);
+	mt76_tx(phy, NULL, wcid, probe2);
+	mt76_tx(phy, NULL, wcid, data);
+
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&wcid->tx_offchannel), 2);
+	KUNIT_EXPECT_PTR_EQ(test, skb_peek(&wcid->tx_offchannel), off);
+	KUNIT_EXPECT_PTR_EQ(test, skb_peek_tail(&wcid->tx_offchannel), probe);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&wcid->tx_pending), 2);
+	KUNIT_EXPECT_PTR_EQ(test, skb_peek(&wcid->tx_pending), probe2);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&phy->tx_list), 1);
+}
+
+/* Scheduling sends each station's pending frames in order to the hardware
+ * queue of their access category, kicking it, station by station; drained
+ * stations leave the tx list. Frames for a station are recorded on its
+ * ring entry and count as non-AQL until they complete.
+ */
+static void mt76_tx_test_schedule_pending(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_phy *phy = &t->dev->phy;
+	struct sk_buff *a1, *a2, *b1;
+	struct mt76_wcid *a, *b;
+	struct mt76_queue *q;
+
+	a = mt76_tx_test_wcid(t, 1, 0, true, true);
+	b = mt76_tx_test_wcid(t, 2, 0, false, true);
+	a1 = mt76_tx_test_data(t, IEEE80211_AC_VI);
+	a2 = mt76_tx_test_data(t, IEEE80211_AC_BE);
+	b1 = mt76_tx_test_data(t, IEEE80211_AC_VO);
+	mt76_tx(phy, wcid_to_sta(a), a, a1);
+	mt76_tx(phy, NULL, b, b1);
+	mt76_tx(phy, wcid_to_sta(a), a, a2);
+
+	mt76_txq_schedule_pending(phy);
+
+	KUNIT_ASSERT_EQ(test, t->n_queued, 3);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].skb, a1);
+	KUNIT_EXPECT_EQ(test, t->rec[0].qid, MT_TXQ_VI);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].q, phy->q_tx[MT_TXQ_VI]);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].wcid, a);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].sta, wcid_to_sta(a));
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].phy, phy);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[1].skb, a2);
+	KUNIT_EXPECT_EQ(test, t->rec[1].qid, MT_TXQ_BE);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[2].skb, b1);
+	KUNIT_EXPECT_EQ(test, t->rec[2].qid, MT_TXQ_VO);
+	KUNIT_EXPECT_NULL(test, t->rec[2].sta);
+	KUNIT_EXPECT_EQ(test, t->n_kick, 3);
+	KUNIT_EXPECT_PTR_EQ(test, t->kick_q, phy->q_tx[MT_TXQ_VO]);
+
+	KUNIT_EXPECT_TRUE(test, list_empty(&phy->tx_list));
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&a->tx_pending));
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&b->tx_pending));
+
+	q = phy->q_tx[MT_TXQ_VI];
+	KUNIT_EXPECT_EQ(test, q->entry[0].wcid, 1);
+	KUNIT_EXPECT_EQ(test, phy->q_tx[MT_TXQ_VO]->entry[0].wcid, 0xffff);
+	KUNIT_EXPECT_EQ(test, atomic_read(&a->non_aql_packets), 2);
+	KUNIT_EXPECT_EQ(test, atomic_read(&b->non_aql_packets), 0);
+
+	/* nothing left: nothing happens */
+	mt76_txq_schedule_pending(phy);
+	KUNIT_EXPECT_EQ(test, t->n_queued, 3);
+}
+
+/* Off-channel frames go out first. While the phy is off its channel, only
+ * those are sent, and the station stays on the tx list for the others.
+ */
+static void mt76_tx_test_schedule_offchannel(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_phy *phy = &t->dev->phy;
+	struct sk_buff *data, *off;
+	struct mt76_wcid *wcid;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, false, true);
+	data = mt76_tx_test_data(t, IEEE80211_AC_BE);
+	off = mt76_tx_test_data(t, IEEE80211_AC_BE);
+	IEEE80211_SKB_CB(off)->flags |= IEEE80211_TX_CTL_TX_OFFCHAN;
+	mt76_tx(phy, NULL, wcid, data);
+	mt76_tx(phy, NULL, wcid, off);
+	phy->offchannel = true;
+
+	mt76_txq_schedule_pending(phy);
+
+	KUNIT_ASSERT_EQ(test, t->n_queued, 1);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].skb, off);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&wcid->tx_pending), 1);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&phy->tx_list), 1);
+
+	phy->offchannel = false;
+	mt76_txq_schedule_pending(phy);
+
+	KUNIT_ASSERT_EQ(test, t->n_queued, 2);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[1].skb, data);
+	KUNIT_EXPECT_TRUE(test, list_empty(&phy->tx_list));
+}
+
+/* A stopped hardware queue ends the pass. The stations keep their frames
+ * and stay on the tx list, even with only pending (not off-channel) frames
+ * left, so they aren't stranded: the next pass sends them.
+ */
+static void mt76_tx_test_schedule_stopped(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_phy *phy = &t->dev->phy;
+	struct mt76_wcid *a, *b;
+
+	a = mt76_tx_test_wcid(t, 1, 0, false, true);
+	b = mt76_tx_test_wcid(t, 2, 0, false, true);
+	mt76_tx(phy, NULL, a, mt76_tx_test_data(t, IEEE80211_AC_BE));
+	mt76_tx(phy, NULL, a, mt76_tx_test_data(t, IEEE80211_AC_BE));
+	mt76_tx(phy, NULL, b, mt76_tx_test_data(t, IEEE80211_AC_VI));
+	phy->q_tx[MT_TXQ_BE]->stopped = true;
+
+	mt76_txq_schedule_pending(phy);
+
+	KUNIT_EXPECT_EQ(test, t->n_queued, 0);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&a->tx_pending), 2);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&b->tx_pending), 1);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&phy->tx_list), 2);
+
+	phy->q_tx[MT_TXQ_BE]->stopped = false;
+	mt76_txq_schedule_pending(phy);
+
+	KUNIT_EXPECT_EQ(test, t->n_queued, 3);
+	KUNIT_EXPECT_TRUE(test, list_empty(&phy->tx_list));
+}
+
+/* A blocked queue, a queue too full to take MT_TXQ_FREE_THR more frames
+ * and a phy in reset all hold the frames back too.
+ */
+static void mt76_tx_test_schedule_held(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_phy *phy = &t->dev->phy;
+	struct mt76_queue *q = phy->q_tx[MT_TXQ_BE];
+	struct mt76_wcid *wcid;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, false, true);
+	mt76_tx(phy, NULL, wcid, mt76_tx_test_data(t, IEEE80211_AC_BE));
+
+	q->blocked = true;
+	mt76_txq_schedule_pending(phy);
+	KUNIT_EXPECT_EQ(test, t->n_queued, 0);
+	q->blocked = false;
+
+	q->queued = q->ndesc - MT_TXQ_FREE_THR;
+	mt76_txq_schedule_pending(phy);
+	KUNIT_EXPECT_EQ(test, t->n_queued, 0);
+	q->queued = q->ndesc - MT_TXQ_FREE_THR - 1;
+
+	set_bit(MT76_RESET, &phy->state);
+	mt76_txq_schedule_pending(phy);
+	KUNIT_EXPECT_EQ(test, t->n_queued, 0);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&phy->tx_list), 1);
+	clear_bit(MT76_RESET, &phy->state);
+
+	mt76_txq_schedule_pending(phy);
+	KUNIT_EXPECT_EQ(test, t->n_queued, 1);
+}
+
+/* With a hardware management queue (the mt7915), management frames go to
+ * the PSD queue unless they are bufferable ones for a station with its
+ * rates set, still on the normal pending list; deauths always do, data and
+ * 802.3-offloaded frames never.
+ */
+static void mt76_tx_test_schedule_mgmt_txq(struct kunit *test)
+{
+	struct mt76_tx_test *t;
+	struct sk_buff *data, *action, *deauth, *resp, *off, *encap, *norate;
+	struct mt76_wcid *wcid, *wcid2;
+	struct mt76_phy *phy;
+
+	t = mt76_tx_test_init(test, &mt76_tx_test_drv_mgmt_txq);
+	phy = &t->dev->phy;
+	wcid = mt76_tx_test_wcid(t, 1, 0, false, true);
+	wcid2 = mt76_tx_test_wcid(t, 2, 0, false, true);
+	wcid2->tx_info = 0;
+
+	data = mt76_tx_test_data(t, IEEE80211_AC_BE);
+	action = mt76_tx_test_frame(t, MT76_TX_TEST_MGMT(ACTION),
+				    IEEE80211_AC_VO);
+	deauth = mt76_tx_test_frame(t, MT76_TX_TEST_MGMT(DEAUTH),
+				    IEEE80211_AC_VO);
+	resp = mt76_tx_test_frame(t, MT76_TX_TEST_MGMT(PROBE_RESP),
+				  IEEE80211_AC_VO);
+	off = mt76_tx_test_frame(t, MT76_TX_TEST_MGMT(ACTION),
+				 IEEE80211_AC_VO);
+	encap = mt76_tx_test_frame(t, MT76_TX_TEST_MGMT(ACTION),
+				   IEEE80211_AC_VI);
+	IEEE80211_SKB_CB(encap)->flags |= IEEE80211_TX_CTL_HW_80211_ENCAP;
+	norate = mt76_tx_test_frame(t, MT76_TX_TEST_MGMT(ACTION),
+				    IEEE80211_AC_VO);
+
+	mt76_tx_test_pend(phy, wcid, data, &wcid->tx_pending);
+	mt76_tx_test_pend(phy, wcid, action, &wcid->tx_pending);
+	mt76_tx_test_pend(phy, wcid, deauth, &wcid->tx_pending);
+	mt76_tx_test_pend(phy, wcid, resp, &wcid->tx_pending);
+	mt76_tx_test_pend(phy, wcid, encap, &wcid->tx_pending);
+	mt76_tx_test_pend(phy, wcid, off, &wcid->tx_offchannel);
+	mt76_tx_test_pend(phy, wcid2, norate, &wcid2->tx_pending);
+
+	mt76_txq_schedule_pending(phy);
+
+	KUNIT_ASSERT_EQ(test, t->n_queued, 7);
+	/* off-channel list first */
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].skb, off);
+	KUNIT_EXPECT_EQ(test, t->rec[0].qid, MT_TXQ_PSD);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[1].skb, data);
+	KUNIT_EXPECT_EQ(test, t->rec[1].qid, MT_TXQ_BE);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[2].skb, action);
+	KUNIT_EXPECT_EQ(test, t->rec[2].qid, MT_TXQ_VO);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[3].skb, deauth);
+	KUNIT_EXPECT_EQ(test, t->rec[3].qid, MT_TXQ_PSD);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[4].skb, resp);
+	KUNIT_EXPECT_EQ(test, t->rec[4].qid, MT_TXQ_PSD);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[4].q, phy->q_tx[MT_TXQ_PSD]);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[5].skb, encap);
+	KUNIT_EXPECT_EQ(test, t->rec[5].qid, MT_TXQ_VI);
+	/* no rates yet: not a station to buffer for */
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[6].skb, norate);
+	KUNIT_EXPECT_EQ(test, t->rec[6].qid, MT_TXQ_PSD);
+}
+
+/* Without a hardware management queue, management frames stay on the
+ * queue of their access category.
+ */
+static void mt76_tx_test_schedule_no_mgmt_txq(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_phy *phy = &t->dev->phy;
+	struct mt76_wcid *wcid;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, false, true);
+	mt76_tx(phy, NULL, wcid, mt76_tx_test_frame(t,
+			MT76_TX_TEST_MGMT(DEAUTH), IEEE80211_AC_VO));
+
+	mt76_txq_schedule_pending(phy);
+
+	KUNIT_ASSERT_EQ(test, t->n_queued, 1);
+	KUNIT_EXPECT_EQ(test, t->rec[0].qid, MT_TXQ_VO);
+}
