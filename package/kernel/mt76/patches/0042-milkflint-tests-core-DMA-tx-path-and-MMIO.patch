+/* Cleanup takes every buffer back from the ring and drops a frame left
+ * half assembled.
+ */
+static void mt76_dma_test_rx_cleanup(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+	int i;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, 0);
+	mt76_dma_rx_fill(dev, q, false);
+	q->rx_head = mt76_dma_test_skb(t, 10, 0);
+
+	dev->queue_ops->rx_cleanup(dev, q);
+
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, q->tail, q->head);
+	for (i = 0; i < q->ndesc; i++)
+		KUNIT_EXPECT_NULL(test, q->entry[i].buf);
+	KUNIT_EXPECT_NULL(test, q->rx_head);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&t->rx), 0);
+
+	/* an unallocated queue */
+	dev->queue_ops->rx_cleanup(dev, &dev->q_rx[MT_RXQ_BAND2]);
+}
+
+/* On a WED ring, cleanup releases every buffer's token. */
+static void mt76_dma_test_rx_wed_cleanup(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, MT_WED_Q_RX(0));
+	mt76_dma_rx_fill(dev, q, false);
+
+	dev->queue_ops->rx_cleanup(dev, q);
+
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&dev->rx_token));
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->rxwi_cache), 7);
