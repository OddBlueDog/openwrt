+/* An rx reset empties the ring, resyncs it to the hardware's position and
+ * refills it from there.
+ */
+static void mt76_dma_test_rx_reset(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue_regs *regs;
+	struct mt76_queue *q;
+	int i;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, 0);
+	regs = mt76_dma_test_qregs(q);
+	mt76_dma_rx_fill(dev, q, false);
+	/* a half-received frame, a completed one, the hardware at slot 3 */
+	q->rx_head = mt76_dma_test_skb(t, 10, 0);
+	mt76_dma_test_rx_frame(t, q, 0, 60, 0);
+	regs->dma_idx = 3;
+	regs->ring_size = 0;
+
+	dev->queue_ops->rx_reset(dev, MT_RXQ_MAIN);
+
+	KUNIT_EXPECT_NULL(test, q->rx_head);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&t->rx), 0);
+	KUNIT_EXPECT_EQ(test, regs->ring_size, 8);
+	KUNIT_EXPECT_EQ(test, q->tail, 3);
+	KUNIT_EXPECT_EQ(test, q->queued, 7);
+	KUNIT_EXPECT_EQ(test, q->head, 2);
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 2);
+	KUNIT_EXPECT_NULL(test, q->entry[2].buf);
+	for (i = 3; i < 3 + 7; i++)
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[i % 8].ctrl),
+				FIELD_PREP(MT_DMA_CTL_SD_LEN0,
+				SKB_WITH_OVERHEAD(MT76_DMA_TEST_BUF_SIZE)));
+
+	/* a queue never allocated is left alone */
+	dev->queue_ops->rx_reset(dev, MT_RXQ_BAND2);
+	KUNIT_EXPECT_EQ(test, dev->q_rx[MT_RXQ_BAND2].queued, 0);
