+/* The tx worker sends the pending frames of the main phy and of the other
+ * phys (here a second radio on the same hw), each to its own queues.
+ */
+static void mt76_tx_test_worker(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_wcid *a, *b;
+	struct mt76_phy *phy2;
+	u32 hwq;
+
+	phy2 = devm_kzalloc(dev->dev, sizeof(*phy2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, phy2);
+	phy2->dev = dev;
+	phy2->hw = dev->hw;
+	phy2->band_idx = MT_BAND1;
+	mt76_tx_test_phy_init(t, phy2);
+	dev->phys[MT_BAND1] = phy2;
+
+	a = mt76_tx_test_wcid(t, 1, MT_BAND0, false, true);
+	b = mt76_tx_test_wcid(t, 2, MT_BAND1, false, true);
+	mt76_tx(&dev->phy, NULL, a, mt76_tx_test_data(t, IEEE80211_AC_BE));
+	mt76_tx(phy2, NULL, b, mt76_tx_test_data(t, IEEE80211_AC_BE));
+
+	KUNIT_ASSERT_PTR_EQ(test, (void *)dev->tx_worker.fn,
+			    (void *)mt76_tx_worker);
+	dev->tx_worker.fn(&dev->tx_worker);
+
+	KUNIT_ASSERT_EQ(test, t->n_queued, 2);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].phy, &dev->phy);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].q, dev->phy.q_tx[MT_TXQ_BE]);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[1].phy, phy2);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[1].q, phy2->q_tx[MT_TXQ_BE]);
+	hwq = IEEE80211_SKB_CB(t->rec[1].skb)->hw_queue;
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TX_HW_QUEUE_PHY, hwq), MT_BAND1);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->phy.tx_list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&phy2->tx_list));
+
+	/* the txq scheduler has nothing for mac80211-less phys */
+	mt76_txq_schedule_all(phy2);
+	mt76_txq_schedule(&dev->phy, MT_TXQ_PSD);
+	KUNIT_EXPECT_EQ(test, t->n_queued, 2);
+}
+
+/* mac80211 waking a txq just kicks the tx worker. */
+static void mt76_tx_test_wake_tx_queue(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+
+	KUNIT_EXPECT_FALSE(test, mt76_tx_test_worker_scheduled(t->dev));
+	mt76_wake_tx_queue(t->dev->hw, NULL);
+	KUNIT_EXPECT_TRUE(test, mt76_tx_test_worker_scheduled(t->dev));
+}
+
+/* An ieee80211_txq whose driver area is an mt76_txq, for the band-0 BE AC.
+ * Enough for mt76_txq_send_burst()'s early-return branches, which read only
+ * txq->sta/ac and the wcid; it must not be driven into ieee80211_tx_dequeue(),
+ * which needs a txq backed by mac80211's internal fq state.
+ */
+static struct mt76_txq *mt76_tx_test_mtxq(struct mt76_tx_test *t)
+{
+	struct ieee80211_txq *txq;
+
+	txq = devm_kzalloc(t->dev->dev, sizeof(*txq) + sizeof(struct mt76_txq),
+			   GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(t->test, txq);
+	txq->ac = IEEE80211_AC_BE;
+
+	return (struct mt76_txq *)txq->drv_priv;
+}
+
+/* A burst isn't started for a station already at the non-AQL limit: the
+ * scheduler must leave it be rather than queue more.
+ */
+static void mt76_tx_test_send_burst_non_aql_limit(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_phy *phy = &t->dev->phy;
+	struct mt76_queue *q = phy->q_tx[MT_TXQ_BE];
+	struct mt76_wcid *wcid;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, true, true);
+	atomic_set(&wcid->non_aql_packets, MT_MAX_NON_AQL_PKT);
+
+	KUNIT_EXPECT_EQ(test, mt76_txq_send_burst(phy, q, mt76_tx_test_mtxq(t),
+						  wcid), 0);
+	KUNIT_EXPECT_EQ(test, t->n_queued, 0);
+	KUNIT_EXPECT_EQ(test, t->n_kick, 0);
+}
+
+/* A power-save station is not served at all unless the driver buffers for
+ * it in hardware.
+ */
+static void mt76_tx_test_send_burst_ps_no_buffering(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_phy *phy = &t->dev->phy;
+	struct mt76_queue *q = phy->q_tx[MT_TXQ_BE];
+	struct mt76_wcid *wcid;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, true, true);
+	set_bit(MT_WCID_FLAG_PS, &wcid->flags);
+
+	/* the default test driver has no MT_DRV_HW_PS_BUFFERING */
+	KUNIT_EXPECT_EQ(test, mt76_txq_send_burst(phy, q, mt76_tx_test_mtxq(t),
+						  wcid), 0);
+	KUNIT_EXPECT_EQ(test, t->n_queued, 0);
+}
+
+/* A hardware-buffering driver skips a power-save station while it still
+ * has AQL airtime pending (nothing queued is NULL here, so it isn't).
+ */
+static void mt76_tx_test_send_burst_ps_aql(struct kunit *test)
+{
+	struct mt76_tx_test *t;
+	struct mt76_phy *phy;
+	struct mt76_queue *q;
+	struct mt76_wcid *wcid;
+
+	t = mt76_tx_test_init(test, &mt76_tx_test_drv_hw_ps);
+	phy = &t->dev->phy;
+	q = phy->q_tx[MT_TXQ_BE];
+	wcid = mt76_tx_test_wcid(t, 1, 0, true, true);
+	set_bit(MT_WCID_FLAG_PS, &wcid->flags);
+	/* with no registered airtime, aql pending is 0, so it falls through
+	 * the PS gate to the non-AQL gate, which the limit then closes
+	 */
+	atomic_set(&wcid->non_aql_packets, MT_MAX_NON_AQL_PKT);
+
+	KUNIT_EXPECT_EQ(test, mt76_txq_send_burst(phy, q, mt76_tx_test_mtxq(t),
+						  wcid), 0);
+	KUNIT_EXPECT_EQ(test, t->n_queued, 0);
+}
+
+/* --- non-AQL accounting ------------------------------------------------------ */
+
+/* __mt76_tx_queue_skb() counts frames without an airtime estimate as
+ * non-AQL on the primary link's wcid and says to stop the burst at
+ * MT_MAX_NON_AQL_PKT; frames with an estimate, frames without a station
+ * and frames the queue refused don't count.
+ */
+static void mt76_tx_test_queue_skb_non_aql(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_phy *phy = &t->dev->phy;
+	struct mt76_wcid *wcid, *link, *nosta;
+	struct ieee80211_sta *sta;
+	struct sk_buff *skb;
+	bool stop = false;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, true, true);
+	link = mt76_tx_test_wcid(t, 2, 0, true, true);
+	nosta = mt76_tx_test_wcid(t, 3, 0, false, true);
+	link->def_wcid = wcid;
+	sta = wcid_to_sta(wcid);
+	atomic_set(&wcid->non_aql_packets, MT_MAX_NON_AQL_PKT - 2);
+
+	KUNIT_EXPECT_EQ(test, __mt76_tx_queue_skb(phy, MT_TXQ_BE,
+			mt76_tx_test_data(t, 0), link, sta, &stop), 0);
+	KUNIT_EXPECT_FALSE(test, stop);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets),
+			MT_MAX_NON_AQL_PKT - 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&link->non_aql_packets), 0);
+	/* the entry records the link the frame went out on */
+	KUNIT_EXPECT_EQ(test, phy->q_tx[MT_TXQ_BE]->entry[0].wcid, 2);
+
+	skb = mt76_tx_test_data(t, 0);
+	ieee80211_info_set_tx_time_est(IEEE80211_SKB_CB(skb), 100);
+	KUNIT_EXPECT_EQ(test, __mt76_tx_queue_skb(phy, MT_TXQ_BE, skb, wcid,
+			sta, &stop), 1);
+	KUNIT_EXPECT_FALSE(test, stop);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets),
+			MT_MAX_NON_AQL_PKT - 1);
+
+	KUNIT_EXPECT_EQ(test, __mt76_tx_queue_skb(phy, MT_TXQ_BE,
+			mt76_tx_test_data(t, 0), nosta, NULL, &stop), 2);
+	KUNIT_EXPECT_FALSE(test, stop);
+	KUNIT_EXPECT_EQ(test, phy->q_tx[MT_TXQ_BE]->entry[2].wcid, 0xffff);
+
+	KUNIT_EXPECT_EQ(test, __mt76_tx_queue_skb(phy, MT_TXQ_BE,
+			mt76_tx_test_data(t, 0), wcid, sta, &stop), 3);
+	KUNIT_EXPECT_TRUE(test, stop);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets),
+			MT_MAX_NON_AQL_PKT);
+
+	/* refused by the queue */
+	t->queue_ret = -ENOMEM;
+	stop = false;
+	KUNIT_EXPECT_EQ(test, __mt76_tx_queue_skb(phy, MT_TXQ_BE,
+			mt76_tx_test_data(t, 0), wcid, sta, &stop), -ENOMEM);
+	KUNIT_EXPECT_FALSE(test, stop);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets),
+			MT_MAX_NON_AQL_PKT);
+	KUNIT_EXPECT_EQ(test, phy->q_tx[MT_TXQ_BE]->entry[4].wcid, 0);
+	t->queue_ret = 0;
+}
+
+/* Completion takes a non-AQL frame off the primary link's count, which
+ * never goes below zero; frames with an airtime estimate aren't counted.
+ */
+static void mt76_tx_test_check_non_aql(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_wcid *wcid, *link;
+	struct sk_buff *skb;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, true, true);
+	link = mt76_tx_test_wcid(t, 2, 0, true, true);
+	link->def_wcid = wcid;
+	atomic_set(&wcid->non_aql_packets, 2);
+	skb = mt76_tx_test_data(t, 0);
+
+	mt76_tx_check_non_aql(t->dev, link, skb);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets), 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&link->non_aql_packets), 0);
+
+	/* back below the limit: the station's txqs (none here) get scheduled */
+	atomic_set(&wcid->non_aql_packets, MT_MAX_NON_AQL_PKT);
+	mt76_tx_check_non_aql(t->dev, wcid, skb);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets),
+			MT_MAX_NON_AQL_PKT - 1);
+
+	atomic_set(&wcid->non_aql_packets, 0);
+	mt76_tx_check_non_aql(t->dev, wcid, skb);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets), 0);
+
+	atomic_set(&wcid->non_aql_packets, 2);
+	ieee80211_info_set_tx_time_est(IEEE80211_SKB_CB(skb), 100);
+	mt76_tx_check_non_aql(t->dev, wcid, skb);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets), 2);
+	mt76_tx_check_non_aql(t->dev, NULL, skb);
+	kfree_skb(skb);
+}
+
+/* --- tx status ---------------------------------------------------------------- */
+
+/* Frames that want a tx status get a packet id (from 3) in their station's
+ * idr; the others a fixed id that tells the firmware there's nothing to
+ * report (no ack wanted, or no wcid) or no frame to look up.
+ */
+static void mt76_tx_test_status_skb_add(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct sk_buff *plain, *noack, *req, *probe;
+	struct mt76_tx_cb *cb;
+	struct mt76_wcid *wcid;
+
+	wcid = mt76_tx_test_wcid(t, 3, 0, false, true);
+	plain = mt76_tx_test_data(t, 0);
+	noack = mt76_tx_test_data(t, 0);
+	req = mt76_tx_test_data(t, 0);
+	probe = mt76_tx_test_data(t, 0);
+	IEEE80211_SKB_CB(noack)->flags = IEEE80211_TX_CTL_NO_ACK |
+					 IEEE80211_TX_CTL_REQ_TX_STATUS;
+	IEEE80211_SKB_CB(req)->flags = IEEE80211_TX_CTL_REQ_TX_STATUS;
+	IEEE80211_SKB_CB(probe)->flags = IEEE80211_TX_CTL_RATE_CTRL_PROBE;
+
+	cb = mt76_tx_skb_cb(plain);
+	cb->pktid = 0x55;
+	cb->flags = MT_TX_CB_DMA_DONE;
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, wcid, plain),
+			MT_PACKET_ID_NO_SKB);
+	KUNIT_EXPECT_EQ(test, cb->pktid, 0);
+	KUNIT_EXPECT_EQ(test, cb->flags, 0);
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, wcid, noack),
+			MT_PACKET_ID_NO_ACK);
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, NULL, req),
+			MT_PACKET_ID_NO_ACK);
+	KUNIT_EXPECT_TRUE(test, list_empty(&wcid->list));
+
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, wcid, req),
+			MT_PACKET_ID_FIRST);
+	cb = mt76_tx_skb_cb(req);
+	KUNIT_EXPECT_EQ(test, cb->wcid, 3);
+	KUNIT_EXPECT_EQ(test, cb->pktid, MT_PACKET_ID_FIRST);
+	KUNIT_EXPECT_PTR_EQ(test, idr_find(&wcid->pktid, MT_PACKET_ID_FIRST),
+			    req);
+	/* the station is now polled for stale frames */
+	KUNIT_EXPECT_PTR_EQ(test, list_first_entry(&dev->wcid_list,
+			struct mt76_wcid, list), wcid);
+
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, wcid, probe),
+			MT_PACKET_ID_FIRST + 1);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->wcid_list), 1);
+
+	kfree_skb(plain);
+	kfree_skb(noack);
+}
+
+/* A wcid that isn't the one published at its index (removed, or the
+ * index reused by another station) gets no packet id, and isn't put back
+ * on the wcid list.
+ */
+static void mt76_tx_test_status_skb_add_stale(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_wcid *old, *new;
+	struct sk_buff *skb;
+
+	old = mt76_tx_test_wcid(t, 4, 0, false, false);
+	skb = mt76_tx_test_data(t, 0);
+	IEEE80211_SKB_CB(skb)->flags = IEEE80211_TX_CTL_REQ_TX_STATUS;
+
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, old, skb),
+			MT_PACKET_ID_NO_ACK);
+
+	new = mt76_tx_test_wcid(t, 4, 0, false, true);
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, old, skb),
+			MT_PACKET_ID_NO_ACK);
+	KUNIT_EXPECT_TRUE(test, list_empty(&old->list));
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&old->pktid));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->wcid_list));
+
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, new, skb),
+			MT_PACKET_ID_FIRST);
+}
+
+/* Packet ids run out at MT_PACKET_ID_MASK: the next frame still goes out,
+ * without a status to wait for.
+ */
+static void mt76_tx_test_status_skb_add_full(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_wcid *wcid;
+	struct sk_buff *skb;
+	int i;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, false, true);
+	for (i = MT_PACKET_ID_FIRST; i < MT_PACKET_ID_MASK; i++) {
+		skb = mt76_tx_test_data(t, 0);
+		IEEE80211_SKB_CB(skb)->flags = IEEE80211_TX_CTL_REQ_TX_STATUS;
+		KUNIT_ASSERT_EQ(test, mt76_tx_status_skb_add(dev, wcid, skb), i);
+		mt76_tx_skb_cb(skb)->flags |= MT_TX_CB_DMA_DONE;
+	}
+
+	skb = mt76_tx_test_data(t, 0);
+	IEEE80211_SKB_CB(skb)->flags = IEEE80211_TX_CTL_REQ_TX_STATUS;
+	KUNIT_EXPECT_EQ(test, mt76_tx_status_skb_add(dev, wcid, skb),
+			MT_PACKET_ID_NO_SKB);
+	kfree_skb(skb);
+
+	/* a flush reports them all and forgets the station */
+	mt76_tx_status_check(dev, true);
+	KUNIT_EXPECT_EQ(test, t->n_freed, MT_PACKET_ID_MASK -
+					  MT_PACKET_ID_FIRST + 1);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&wcid->pktid));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->wcid_list));
+}
+
+/* A frame with a packet id is reported once both its DMA completion and
+ * its tx status are in, whichever comes first.
+ */
+static void mt76_tx_test_status_dma_then_txs(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct sk_buff_head list;
+	struct mt76_wcid *wcid;
+	struct sk_buff *skb;
+	int pid;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, false, true);
+	skb = mt76_tx_test_data(t, 0);
+	IEEE80211_SKB_CB(skb)->flags = IEEE80211_TX_CTL_REQ_TX_STATUS;
+	pid = mt76_tx_status_skb_add(dev, wcid, skb);
+
+	/* DMA done: still waiting for the status */
+	mt76_tx_complete_skb(dev, wcid->idx, skb);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 0);
+	KUNIT_EXPECT_TRUE(test, mt76_tx_skb_cb(skb)->flags &
+				MT_TX_CB_DMA_DONE);
+	KUNIT_EXPECT_PTR_EQ(test, idr_find(&wcid->pktid, pid), skb);
+
+	/* the status: reported */
+	mt76_tx_status_lock(dev, &list);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_tx_status_skb_get(dev, wcid, pid,
+							 &list), skb);
+	mt76_tx_status_skb_done(dev, skb, &list);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&list), 1);
+	mt76_tx_status_unlock(dev, &list);
+
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&wcid->pktid));
+	KUNIT_EXPECT_TRUE(test, list_empty(&wcid->list));
+}
+
+static void mt76_tx_test_status_txs_then_dma(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct sk_buff_head list;
+	struct mt76_wcid *wcid;
+	struct sk_buff *skb;
+	int pid;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, false, true);
+	skb = mt76_tx_test_data(t, 0);
+	IEEE80211_SKB_CB(skb)->flags = IEEE80211_TX_CTL_REQ_TX_STATUS;
+	pid = mt76_tx_status_skb_add(dev, wcid, skb);
+
+	mt76_tx_status_lock(dev, &list);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_tx_status_skb_get(dev, wcid, pid,
+							 &list), skb);
+	mt76_tx_status_skb_done(dev, skb, &list);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&list), 0);
+	mt76_tx_status_unlock(dev, &list);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 0);
+
+	mt76_tx_complete_skb(dev, wcid->idx, skb);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+}
+
+/* Frames whose DMA completed over MT_TX_STATUS_SKB_TIMEOUT ago without a
+ * tx status are given up on and reported as failed; newer ones and ones
+ * still in DMA keep waiting, until a flush stops waiting for any status:
+ * the ones still in DMA are then reported when their DMA completes.
+ */
+static void mt76_tx_test_status_timeout(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct sk_buff *skb[3], *s;
+	struct sk_buff_head list;
+	struct mt76_wcid *wcid;
+	int i;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, false, true);
+	for (i = 0; i < 3; i++) {
+		skb[i] = mt76_tx_test_data(t, 0);
+		IEEE80211_SKB_CB(skb[i])->flags =
+			IEEE80211_TX_CTL_REQ_TX_STATUS;
+		mt76_tx_status_skb_add(dev, wcid, skb[i]);
+	}
+	mt76_tx_skb_cb(skb[0])->flags = MT_TX_CB_DMA_DONE;
+	mt76_tx_skb_cb(skb[0])->jiffies = jiffies - 2 * MT_TX_STATUS_SKB_TIMEOUT;
+	mt76_tx_skb_cb(skb[1])->flags = MT_TX_CB_DMA_DONE;
+	mt76_tx_skb_cb(skb[1])->jiffies = jiffies;
+
+	/* looking up an id that isn't there sweeps the stale ones */
+	mt76_tx_status_lock(dev, &list);
+	KUNIT_EXPECT_NULL(test, mt76_tx_status_skb_get(dev, wcid, 100, &list));
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&list), 1);
+	s = skb_peek(&list);
+	KUNIT_EXPECT_PTR_EQ(test, s, skb[0]);
+	KUNIT_EXPECT_TRUE(test, mt76_tx_skb_cb(s)->flags & MT_TX_CB_TXS_FAILED);
+	/* not acked: the status really is missing */
+	KUNIT_EXPECT_FALSE(test, IEEE80211_SKB_CB(s)->flags &
+				 IEEE80211_TX_STAT_ACK);
+	mt76_tx_status_unlock(dev, &list);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+	KUNIT_EXPECT_FALSE(test, list_empty(&wcid->list));
+
+	mt76_tx_status_check(dev, false);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+
+	mt76_tx_status_check(dev, true);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 2);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&wcid->pktid));
+	KUNIT_EXPECT_TRUE(test, list_empty(&wcid->list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->wcid_list));
+
+	mt76_tx_complete_skb(dev, wcid->idx, skb[2]);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 3);
+}
+
+/* Drivers whose tx status is unreliable report a timed-out frame as acked
+ * rather than lost, with no rate.
+ */
+static void mt76_tx_test_status_ignore_failed(struct kunit *test)
+{
+	struct mt76_tx_test *t;
+	struct ieee80211_tx_info *info;
+	struct sk_buff_head list;
+	struct mt76_wcid *wcid;
+	struct mt76_dev *dev;
+	struct sk_buff *skb;
+
+	t = mt76_tx_test_init(test, &mt76_tx_test_drv_ignore_txs);
+	dev = t->dev;
+	wcid = mt76_tx_test_wcid(t, 1, 0, false, true);
+	skb = mt76_tx_test_data(t, 0);
+	info = IEEE80211_SKB_CB(skb);
+	info->flags = IEEE80211_TX_CTL_REQ_TX_STATUS;
+	mt76_tx_status_skb_add(dev, wcid, skb);
+	mt76_tx_skb_cb(skb)->flags = MT_TX_CB_DMA_DONE;
+	info->status.rates[0].idx = 3;
+	info->status.rates[0].count = 2;
+
+	mt76_tx_status_lock(dev, &list);
+	mt76_tx_status_skb_get(dev, wcid, -1, &list);
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&list), 1);
+	KUNIT_EXPECT_TRUE(test, info->flags & IEEE80211_TX_STAT_ACK);
+	KUNIT_EXPECT_EQ(test, info->status.rates[0].idx, -1);
+	KUNIT_EXPECT_EQ(test, (int)info->status.rates[0].count, 0);
+	mt76_tx_status_unlock(dev, &list);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+}
+
+/* Frames without a packet id are reported when their DMA completes, onto
+ * the caller's free list if there is one, with or without a known wcid;
+ * the wcid's non-AQL count drops.
+ */
+static void mt76_tx_test_complete_no_pktid(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct sk_buff *skb, *tmp;
+	struct mt76_wcid *wcid;
+	LIST_HEAD(free_list);
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, false, true);
+	atomic_set(&wcid->non_aql_packets, 2);
+
+	skb = mt76_tx_test_data(t, 0);
+	KUNIT_ASSERT_EQ(test, mt76_tx_status_skb_add(dev, wcid, skb),
+			MT_PACKET_ID_NO_SKB);
+	__mt76_tx_complete_skb(dev, wcid->idx, skb, &free_list);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 0);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&free_list), 1);
+	KUNIT_EXPECT_PTR_EQ(test, list_first_entry(&free_list, struct sk_buff,
+						   list), skb);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets), 1);
+	list_for_each_entry_safe(skb, tmp, &free_list, list) {
+		skb_list_del_init(skb);
+		kfree_skb(skb);
+	}
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+
+	skb = mt76_tx_test_data(t, 0);
+	mt76_tx_complete_skb(dev, wcid->idx, skb);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 2);
+	KUNIT_EXPECT_EQ(test, atomic_read(&wcid->non_aql_packets), 0);
+
+	skb = mt76_tx_test_data(t, 0);
+	mt76_tx_complete_skb(dev, 0xffff, skb);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 3);
+}
+
+/* --- power save ------------------------------------------------------------------- */
+
+/* Going to sleep marks the station and kicks the worker; waking clears it
+ * and, for a station, schedules its txqs and the worker.
+ */
+static void mt76_tx_test_sta_ps_transition(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_wcid *wcid, *nosta;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, true, true);
+	nosta = mt76_tx_test_wcid(t, 2, 0, false, true);
+
+	mt76_sta_ps_transition(dev, wcid, true);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_PS, &wcid->flags));
+	KUNIT_EXPECT_TRUE(test, mt76_tx_test_worker_scheduled(dev));
+
+	mt76_sta_ps_transition(dev, wcid, false);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &wcid->flags));
+	KUNIT_EXPECT_TRUE(test, mt76_tx_test_worker_scheduled(dev));
+
+	set_bit(MT_WCID_FLAG_PS, &nosta->flags);
+	mt76_sta_ps_transition(dev, nosta, false);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &nosta->flags));
+	KUNIT_EXPECT_FALSE(test, mt76_tx_test_worker_scheduled(dev));
+}
+
+/* After a frame of a sleeping station completes, drivers that buffer in
+ * hardware get its txqs re-armed and the worker kicked (or the wakeup is
+ * lost); other drivers, awake or station-less wcids don't.
+ */
+static void mt76_tx_test_ps_rearm(struct kunit *test)
+{
+	struct mt76_tx_test *t;
+	struct mt76_wcid *wcid, *nosta;
+	struct mt76_dev *dev;
+
+	t = mt76_tx_test_init(test, &mt76_tx_test_drv_hw_ps);
+	dev = t->dev;
+	wcid = mt76_tx_test_wcid(t, 1, 0, true, true);
+	nosta = mt76_tx_test_wcid(t, 2, 0, false, true);
+
+	mt76_tx_ps_rearm(dev, wcid);
+	KUNIT_EXPECT_FALSE(test, mt76_tx_test_worker_scheduled(dev));
+
+	set_bit(MT_WCID_FLAG_PS, &wcid->flags);
+	mt76_tx_ps_rearm(dev, wcid);
+	KUNIT_EXPECT_TRUE(test, mt76_tx_test_worker_scheduled(dev));
+
+	set_bit(MT_WCID_FLAG_PS, &nosta->flags);
+	mt76_tx_ps_rearm(dev, nosta);
+	mt76_tx_ps_rearm(dev, NULL);
+	KUNIT_EXPECT_FALSE(test, mt76_tx_test_worker_scheduled(dev));
+
+	/* the completion path re-arms too */
+	mt76_tx_complete_skb(dev, nosta->idx, mt76_tx_test_data(t, 0));
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+}
+
+static void mt76_tx_test_ps_rearm_sw(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_wcid *wcid;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, true, true);
+	set_bit(MT_WCID_FLAG_PS, &wcid->flags);
+	mt76_tx_ps_rearm(t->dev, wcid);
+	KUNIT_EXPECT_FALSE(test, mt76_tx_test_worker_scheduled(t->dev));
+}
+
+/* Frames released for a sleeping station go to the PSD queue as
+ * power-save responses. All but the last carry MOREDATA; the last ends the
+ * service period: EOSP and a tx status, and for U-APSD QoS data the EOSP
+ * bit in its QoS header.
+ */
+static void mt76_tx_test_queue_ps_skb(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_phy *phy = &t->dev->phy;
+	struct sk_buff *mid, *last, *pspoll, *plain;
+	struct ieee80211_tx_info *info;
+	struct ieee80211_hdr *hdr;
+	struct ieee80211_sta *sta;
+	struct mt76_wcid *wcid;
+
+	wcid = mt76_tx_test_wcid(t, 1, 0, true, true);
+	sta = wcid_to_sta(wcid);
+	mid = mt76_tx_test_frame(t, MT76_TX_TEST_QOS, 0);
+	last = mt76_tx_test_frame(t, MT76_TX_TEST_QOS |
+				     IEEE80211_FCTL_MOREDATA, 0);
+	pspoll = mt76_tx_test_frame(t, MT76_TX_TEST_QOS, 0);
+	plain = mt76_tx_test_data(t, 0);
+
+	mt76_queue_ps_skb(phy, sta, mid, false, IEEE80211_FRAME_RELEASE_UAPSD);
+	mt76_queue_ps_skb(phy, sta, last, true, IEEE80211_FRAME_RELEASE_UAPSD);
+	mt76_queue_ps_skb(phy, sta, pspoll, true,
+			  IEEE80211_FRAME_RELEASE_PSPOLL);
+	mt76_queue_ps_skb(phy, sta, plain, true,
+			  IEEE80211_FRAME_RELEASE_UAPSD);
+
+	KUNIT_ASSERT_EQ(test, t->n_queued, 4);
+	KUNIT_EXPECT_EQ(test, t->rec[0].qid, MT_TXQ_PSD);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].q, phy->q_tx[MT_TXQ_PSD]);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].wcid, wcid);
+	KUNIT_EXPECT_PTR_EQ(test, t->rec[0].sta, sta);
+
+	hdr = (struct ieee80211_hdr *)mid->data;
+	info = IEEE80211_SKB_CB(mid);
+	KUNIT_EXPECT_TRUE(test, info->control.flags &
+				IEEE80211_TX_CTRL_PS_RESPONSE);
+	KUNIT_EXPECT_TRUE(test, ieee80211_has_moredata(hdr->frame_control));
+	KUNIT_EXPECT_FALSE(test, info->flags & (IEEE80211_TX_STATUS_EOSP |
+						IEEE80211_TX_CTL_REQ_TX_STATUS));
+	KUNIT_EXPECT_FALSE(test, *ieee80211_get_qos_ctl(hdr) &
+				 IEEE80211_QOS_CTL_EOSP);
+
+	hdr = (struct ieee80211_hdr *)last->data;
+	info = IEEE80211_SKB_CB(last);
+	KUNIT_EXPECT_TRUE(test, info->control.flags &
+				IEEE80211_TX_CTRL_PS_RESPONSE);
+	KUNIT_EXPECT_FALSE(test, ieee80211_has_moredata(hdr->frame_control));
+	KUNIT_EXPECT_TRUE(test, info->flags & IEEE80211_TX_STATUS_EOSP);
+	KUNIT_EXPECT_TRUE(test, info->flags & IEEE80211_TX_CTL_REQ_TX_STATUS);
+	KUNIT_EXPECT_TRUE(test, *ieee80211_get_qos_ctl(hdr) &
+				IEEE80211_QOS_CTL_EOSP);
+
+	/* PS-Poll responses end with EOSP but leave the QoS header alone */
+	hdr = (struct ieee80211_hdr *)pspoll->data;
+	KUNIT_EXPECT_TRUE(test, IEEE80211_SKB_CB(pspoll)->flags &
+				IEEE80211_TX_STATUS_EOSP);
+	KUNIT_EXPECT_FALSE(test, *ieee80211_get_qos_ctl(hdr) &
+				 IEEE80211_QOS_CTL_EOSP);
+
+	/* no QoS header to mark in non-QoS data */
+	KUNIT_EXPECT_TRUE(test, IEEE80211_SKB_CB(plain)->flags &
+				IEEE80211_TX_STATUS_EOSP);
+	KUNIT_EXPECT_EQ(test, plain->data[24], 0);
+	KUNIT_EXPECT_EQ(test, plain->data[25], 0);
+}
+
+/* --- queues, blocking and tokens ------------------------------------------------- */
+
+/* Completing a ring entry hands its frame to the driver and moves the
+ * tail on, wrapping at the end of the ring.
+ */
+static void mt76_tx_test_queue_tx_complete(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_queue *q = t->dev->phy.q_tx[MT_TXQ_BE];
+	struct mt76_queue_entry e = {};
+	struct sk_buff *skb;
+
+	q->tail = q->ndesc - 1;
+	q->queued = 2;
+	skb = mt76_tx_test_data(t, 0);
+	e.skb = skb;
+	e.wcid = 7;
+
+	mt76_queue_tx_complete(t->dev, q, &e);
+	KUNIT_EXPECT_EQ(test, t->n_complete, 1);
+	KUNIT_EXPECT_PTR_EQ(test, t->complete.skb, skb);
+	KUNIT_EXPECT_EQ(test, t->complete.wcid, 7);
+	KUNIT_EXPECT_EQ(test, q->tail, 0);
+	KUNIT_EXPECT_EQ(test, q->queued, 1);
+
+	e.skb = NULL;
+	mt76_queue_tx_complete(t->dev, q, &e);
+	KUNIT_EXPECT_EQ(test, t->n_complete, 1);
+	KUNIT_EXPECT_EQ(test, q->tail, 1);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	kfree_skb(skb);
+}
+
+/* Blocking tx marks the first queue of every band; unblocking clears them
+ * and restarts the tx worker. Setting the state it already has does
+ * nothing.
+ */
+static void mt76_tx_test_set_tx_blocked(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_phy *phy1, *phy2;
+
+	phy1 = devm_kzalloc(dev->dev, sizeof(*phy1), GFP_KERNEL);
+	phy2 = devm_kzalloc(dev->dev, sizeof(*phy2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, phy1);
+	KUNIT_ASSERT_NOT_NULL(test, phy2);
+	phy1->q_tx[0] = mt76_tx_test_hwq(t);
+	phy2->q_tx[0] = mt76_tx_test_hwq(t);
+	dev->phys[MT_BAND1] = phy1;
+	dev->phys[MT_BAND2] = phy2;
+
+	mt76_set_tx_blocked(dev, true);
+	KUNIT_EXPECT_TRUE(test, dev->phy.q_tx[0]->blocked);
+	KUNIT_EXPECT_TRUE(test, phy1->q_tx[0]->blocked);
+	KUNIT_EXPECT_TRUE(test, phy2->q_tx[0]->blocked);
+	KUNIT_EXPECT_FALSE(test, dev->phy.q_tx[1]->blocked);
+	KUNIT_EXPECT_FALSE(test, mt76_tx_test_worker_scheduled(dev));
+
+	phy1->q_tx[0]->blocked = false;
+	mt76_set_tx_blocked(dev, true);
+	KUNIT_EXPECT_FALSE(test, phy1->q_tx[0]->blocked);
+	phy1->q_tx[0]->blocked = true;
+
+	mt76_set_tx_blocked(dev, false);
+	KUNIT_EXPECT_FALSE(test, dev->phy.q_tx[0]->blocked);
+	KUNIT_EXPECT_FALSE(test, phy1->q_tx[0]->blocked);
+	KUNIT_EXPECT_FALSE(test, phy2->q_tx[0]->blocked);
+	KUNIT_EXPECT_TRUE(test, mt76_tx_test_worker_scheduled(dev));
+
+	dev->phys[MT_BAND1] = NULL;
+	dev->phys[MT_BAND2] = NULL;
+}
+
+/* Tx tokens come from [token_start, token_start + token_size) and count
+ * against the device's in-flight limit: within MT76_TOKEN_FREE_THR of it
+ * tx is blocked, and releasing below it again asks for a wakeup.
+ * Management (PSD) frames are also counted per phy.
+ */
+static void mt76_tx_test_token(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_txwi_cache *txwi, *p, *mgmt;
+	struct mt76_dev *dev = t->dev;
+	struct mt76_phy *phy1;
+	bool wake = false;
+	int i, tok[4];
+
+	txwi = kunit_kcalloc(test, 4, sizeof(*txwi), GFP_KERNEL);
+	mgmt = kunit_kzalloc(test, sizeof(*mgmt), GFP_KERNEL);
+	phy1 = devm_kzalloc(dev->dev, sizeof(*phy1), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, txwi);
+	KUNIT_ASSERT_NOT_NULL(test, mgmt);
+	KUNIT_ASSERT_NOT_NULL(test, phy1);
+	phy1->q_tx[0] = mt76_tx_test_hwq(t);
+	dev->phys[MT_BAND1] = phy1;
+	dev->token_start = 100;
+	dev->token_size = MT76_TOKEN_FREE_THR + 5;
+
+	for (i = 0; i < 4; i++) {
+		p = &txwi[i];
+		p->qid = MT_TXQ_BE;
+		tok[i] = mt76_token_consume(dev, &p);
+		KUNIT_EXPECT_EQ(test, tok[i], 100 + i);
+		KUNIT_EXPECT_FALSE(test, dev->phy.q_tx[0]->blocked);
+	}
+	KUNIT_EXPECT_EQ(test, dev->token_count, 4);
+	KUNIT_EXPECT_EQ(test, atomic_read(&dev->phy.mgmt_tx_pending), 0);
+
+	/* the fifth reaches the threshold */
+	p = mgmt;
+	mgmt->qid = MT_TXQ_PSD;
+	mgmt->phy_idx = MT_BAND1;
+	KUNIT_EXPECT_EQ(test, mt76_token_consume(dev, &p), 104);
+	KUNIT_EXPECT_TRUE(test, dev->phy.q_tx[0]->blocked);
+	KUNIT_EXPECT_EQ(test, atomic_read(&phy1->mgmt_tx_pending), 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&dev->phy.mgmt_tx_pending), 0);
+
+	KUNIT_EXPECT_TRUE(test, phy1->q_tx[0]->blocked);
+
+	/* a used-up range */
+	dev->token_size = 5;
+	KUNIT_EXPECT_LT(test, mt76_token_consume(dev, &p), 0);
+	KUNIT_EXPECT_EQ(test, dev->token_count, 5);
+	KUNIT_EXPECT_EQ(test, atomic_read(&phy1->mgmt_tx_pending), 1);
+	dev->token_size = MT76_TOKEN_FREE_THR + 5;
+
+	KUNIT_EXPECT_PTR_EQ(test, mt76_token_release(dev, 104, &wake), mgmt);
+	KUNIT_EXPECT_EQ(test, atomic_read(&phy1->mgmt_tx_pending), 0);
+	KUNIT_EXPECT_TRUE(test, wake);
+	KUNIT_EXPECT_EQ(test, dev->token_count, 4);
+
+	/* unknown token: nothing changes */
+	KUNIT_EXPECT_NULL(test, mt76_token_release(dev, 104, NULL));
+	KUNIT_EXPECT_EQ(test, dev->token_count, 4);
+
+	/* no wakeup asked for while tx isn't blocked */
+	dev->phy.q_tx[0]->blocked = false;
+	wake = false;
+	KUNIT_EXPECT_PTR_EQ(test, mt76_token_release(dev, tok[2], &wake),
+			    &txwi[2]);
+	KUNIT_EXPECT_FALSE(test, wake);
+	KUNIT_EXPECT_EQ(test, dev->token_count, 3);
+
+	for (i = 0; i < 4; i++)
+		mt76_token_release(dev, tok[i], NULL);
+	KUNIT_EXPECT_EQ(test, dev->token_count, 0);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&dev->token));
+	dev->phys[MT_BAND1] = NULL;
+}
+
+/* rx tokens map to an rxwi holding the buffer and its DMA address, below
+ * rx_token_size; releasing one hands the rxwi back once.
+ */
+static void mt76_tx_test_rx_token(struct kunit *test)
+{
+	struct mt76_tx_test *t = mt76_tx_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_txwi_cache *r;
+	int buf, tok;
+
+	r = kunit_kcalloc(test, 3, sizeof(*r), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, r);
+	dev->rx_token_size = 2;
+
+	tok = mt76_rx_token_consume(dev, &buf, &r[0], 0x1000);
+	KUNIT_EXPECT_EQ(test, tok, 0);
+	KUNIT_EXPECT_PTR_EQ(test, r[0].ptr, (void *)&buf);
+	KUNIT_EXPECT_EQ(test, r[0].dma_addr, 0x1000);
+	KUNIT_EXPECT_EQ(test, mt76_rx_token_consume(dev, &buf, &r[1], 0x2000),
+			1);
+	KUNIT_EXPECT_LT(test, mt76_rx_token_consume(dev, &buf, &r[2], 0x3000),
+			0);
+	KUNIT_EXPECT_NULL(test, r[2].ptr);
+	KUNIT_EXPECT_EQ(test, r[2].dma_addr, 0);
+
+	KUNIT_EXPECT_PTR_EQ(test, mt76_rx_token_release(dev, 1), &r[1]);
+	KUNIT_EXPECT_NULL(test, mt76_rx_token_release(dev, 1));
+	KUNIT_EXPECT_PTR_EQ(test, mt76_rx_token_release(dev, 0), &r[0]);
+	KUNIT_EXPECT_TRUE(test, idr_is_empty(&dev->rx_token));
+}
+
+static struct kunit_case mt76_tx_test_cases[] = {
+	KUNIT_CASE(mt76_tx_test_tx_pending),
+	KUNIT_CASE(mt76_tx_test_tx_offchannel),
+	KUNIT_CASE(mt76_tx_test_schedule_pending),
+	KUNIT_CASE(mt76_tx_test_schedule_offchannel),
+	KUNIT_CASE(mt76_tx_test_schedule_stopped),
+	KUNIT_CASE(mt76_tx_test_schedule_held),
+	KUNIT_CASE(mt76_tx_test_schedule_mgmt_txq),
+	KUNIT_CASE(mt76_tx_test_schedule_no_mgmt_txq),
+	KUNIT_CASE(mt76_tx_test_worker),
+	KUNIT_CASE(mt76_tx_test_wake_tx_queue),
+	KUNIT_CASE(mt76_tx_test_send_burst_non_aql_limit),
+	KUNIT_CASE(mt76_tx_test_send_burst_ps_no_buffering),
+	KUNIT_CASE(mt76_tx_test_send_burst_ps_aql),
+	KUNIT_CASE(mt76_tx_test_queue_skb_non_aql),
+	KUNIT_CASE(mt76_tx_test_check_non_aql),
+	KUNIT_CASE(mt76_tx_test_status_skb_add),
+	KUNIT_CASE(mt76_tx_test_status_skb_add_stale),
+	KUNIT_CASE(mt76_tx_test_status_skb_add_full),
+	KUNIT_CASE(mt76_tx_test_status_dma_then_txs),
+	KUNIT_CASE(mt76_tx_test_status_txs_then_dma),
+	KUNIT_CASE(mt76_tx_test_status_timeout),
+	KUNIT_CASE(mt76_tx_test_status_ignore_failed),
+	KUNIT_CASE(mt76_tx_test_complete_no_pktid),
+	KUNIT_CASE(mt76_tx_test_sta_ps_transition),
+	KUNIT_CASE(mt76_tx_test_ps_rearm),
+	KUNIT_CASE(mt76_tx_test_ps_rearm_sw),
+	KUNIT_CASE(mt76_tx_test_queue_ps_skb),
+	KUNIT_CASE(mt76_tx_test_queue_tx_complete),
+	KUNIT_CASE(mt76_tx_test_set_tx_blocked),
+	KUNIT_CASE(mt76_tx_test_token),
+	KUNIT_CASE(mt76_tx_test_rx_token),
+	{}
+};
+
+static struct kunit_suite mt76_tx_test_suite = {
+	.name = "mt76-tx",
+	.test_cases = mt76_tx_test_cases,
+};
+
+kunit_test_suites(&mt76_tx_test_suite);
