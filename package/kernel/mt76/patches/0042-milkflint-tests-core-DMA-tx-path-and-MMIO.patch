diff --git a/tests/dma-test.c b/tests/dma-test.c
new file mode 100644
index 00000000..d2201d24
--- /dev/null
+++ b/tests/dma-test.c
@@ -0,0 +1,2234 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for mt76's DMA rings (dma.c). Included at the end of dma.c
+ * when CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU test build only).
+ *
+ * The rings are real: descriptors in coherent DMA memory of the KUnit
+ * device, rx buffers from real page pools, tx buffers DMA-mapped. Only the
+ * queue registers (q->regs) sit in a plain buffer standing in for the MMIO
+ * window, so a test plays the hardware by moving dma_idx, setting DMA_DONE
+ * on descriptors and writing frames into rx buffers.
+ */
+#include <kunit/test.h>
+#include <linux/dma-direct.h>
+#include "fake.h"
+
+#define MT76_DMA_TEST_TXWI_SIZE		32
+#define MT76_DMA_TEST_BUF_SIZE		2048
+#define MT76_DMA_TEST_REGS		0x400
+#define MT76_DMA_TEST_RX_RING		0x200
+#define MT76_DMA_TEST_MAX_TXQ		4
+
+struct mt76_dma_test {
+	struct kunit *test;
+	struct mt76_dev *dev;
+	u32 *regs;			/* the MMIO window */
+	struct net_device *napi_dev;	/* for the rx queues' NAPI */
+	unsigned long napi_added, napi_enabled;
+	struct mt76_queue *txq[MT76_DMA_TEST_MAX_TXQ];
+	int n_txq;
+	bool dma_cleaned;		/* mt76_dma_cleanup() did the teardown */
+
+	/* tx_prepare_skb */
+	int n_prepare;
+	int prepare_ret;
+	enum mt76_txq_id prepare_qid;
+	struct mt76_wcid *prepare_wcid;
+	struct ieee80211_sta *prepare_sta;
+	void *prepare_txwi;
+	int prepare_nbuf;
+	u32 tx_info;			/* what prepare puts in tx_info->info */
+
+	/* tx_complete_skb */
+	struct mt76_queue_entry done[8];
+	int n_done;
+	struct mt76_queue *bump_q;	/* the hardware finishes more frames */
+	u32 bump_dma_idx;		/* ...while the first one completes */
+
+	/* rx */
+	struct sk_buff_head rx;		/* frames passed to rx_skb */
+	enum mt76_rxq_id rx_qid;
+	u32 rx_info;
+	int n_rx_check;
+	bool rx_check_drop;
+	void *rx_check_data;
+	int rx_check_len;
+	int n_poll_complete;
+	enum mt76_rxq_id poll_qid;
+	int n_rro_ind;
+	void *rro_ind;
+	int n_msdu_page;
+	int msdu_page_ret;
+	dma_addr_t msdu_page_addr;
+
+	int n_freed;			/* test skbs freed */
+};
+
+static struct mt76_dma_test *mt76_dma_test_ctx;
+
+/* fake.h's mt76_test_hw_ops, plus the channel context ops mac80211 (6.9+)
+ * insists on: without them mt76_test_dev() can't allocate the hw.
+ */
+static const struct ieee80211_ops mt76_dma_test_hw_ops = {
+	.tx = mt76_test_tx,
+	.start = mt76_test_start,
+	.stop = mt76_test_stop,
+	.add_interface = mt76_test_add_interface,
+	.remove_interface = mt76_test_remove_interface,
+	.config = mt76_test_config,
+	.configure_filter = mt76_test_configure_filter,
+	.wake_tx_queue = mt76_test_wake_tx_queue,
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
+};
+
+/* --- the driver ------------------------------------------------------------ */
+
+static int mt76_dma_test_prepare(struct mt76_dev *dev, void *txwi_ptr,
+				 enum mt76_txq_id qid, struct mt76_wcid *wcid,
+				 struct ieee80211_sta *sta,
+				 struct mt76_tx_info *tx_info)
+{
+	struct mt76_dma_test *t = mt76_dma_test_ctx;
+
+	t->n_prepare++;
+	t->prepare_qid = qid;
+	t->prepare_wcid = wcid;
+	t->prepare_sta = sta;
+	t->prepare_txwi = txwi_ptr;
+	t->prepare_nbuf = tx_info->nbuf;
+	if (t->prepare_ret)
+		return t->prepare_ret;
+
+	memset(txwi_ptr, 0xa5, MT76_DMA_TEST_TXWI_SIZE);
+	tx_info->info = t->tx_info;
+	return 0;
+}
+
+static void mt76_dma_test_tx_complete(struct mt76_dev *dev,
+				      struct mt76_queue_entry *e)
+{
+	struct mt76_dma_test *t = mt76_dma_test_ctx;
+
+	if (t->n_done < ARRAY_SIZE(t->done))
+		t->done[t->n_done] = *e;
+	t->n_done++;
+	if (t->bump_q) {
+		struct mt76_queue_regs *regs = (void __force *)t->bump_q->regs;
+
+		WRITE_ONCE(regs->dma_idx, t->bump_dma_idx);
+		t->bump_q = NULL;
+	}
+	if (e->skb && e->skb != DMA_DUMMY_DATA)
+		dev_kfree_skb_any(e->skb);
+}
+
+static bool mt76_dma_test_rx_check(struct mt76_dev *dev, void *data, int len)
+{
+	struct mt76_dma_test *t = mt76_dma_test_ctx;
+
+	t->n_rx_check++;
+	t->rx_check_data = data;
+	t->rx_check_len = len;
+	return !t->rx_check_drop;
+}
+
+static void mt76_dma_test_rx_skb(struct mt76_dev *dev, enum mt76_rxq_id q,
+				 struct sk_buff *skb, u32 *info)
+{
+	struct mt76_dma_test *t = mt76_dma_test_ctx;
+
+	t->rx_qid = q;
+	t->rx_info = *info;
+	skb_queue_tail(&t->rx, skb);
+}
+
+static void mt76_dma_test_poll_complete(struct mt76_dev *dev,
+					enum mt76_rxq_id q)
+{
+	struct mt76_dma_test *t = mt76_dma_test_ctx;
+
+	t->n_poll_complete++;
+	t->poll_qid = q;
+}
+
+static void mt76_dma_test_rro_ind_cb(struct mt76_dev *dev, void *data)
+{
+	struct mt76_dma_test *t = mt76_dma_test_ctx;
+
+	t->n_rro_ind++;
+	t->rro_ind = data;
+}
+
+static int mt76_dma_test_msdu_page(struct mt76_dev *dev, struct mt76_queue *q,
+				   dma_addr_t p, void *data)
+{
+	struct mt76_dma_test *t = mt76_dma_test_ctx;
+
+	t->n_msdu_page++;
+	t->msdu_page_addr = p;
+	return t->msdu_page_ret;
+}
+
+#define MT76_DMA_TEST_DRV						\
+	.txwi_size = MT76_DMA_TEST_TXWI_SIZE,				\
+	.tx_prepare_skb = mt76_dma_test_prepare,			\
+	.tx_complete_skb = mt76_dma_test_tx_complete,			\
+	.rx_check = mt76_dma_test_rx_check,				\
+	.rx_skb = mt76_dma_test_rx_skb,					\
+	.rx_poll_complete = mt76_dma_test_poll_complete,		\
+	.rx_rro_ind_process = mt76_dma_test_rro_ind_cb
+
+static const struct mt76_driver_ops mt76_dma_test_drv = {
+	MT76_DMA_TEST_DRV,
+};
+
+/* like the mt7915: txwis belong to tx tokens, not to the ring */
+static const struct mt76_driver_ops mt76_dma_test_drv_no_free = {
+	MT76_DMA_TEST_DRV,
+	.drv_flags = MT_DRV_TXWI_NO_FREE,
+};
+
+static const struct mt76_driver_ops mt76_dma_test_drv_aligned = {
+	MT76_DMA_TEST_DRV,
+	.drv_flags = MT_DRV_TX_ALIGNED4_SKBS,
+};
+
+static const struct mt76_driver_ops mt76_dma_test_drv_msdu_page = {
+	MT76_DMA_TEST_DRV,
+	.rx_rro_add_msdu_page = mt76_dma_test_msdu_page,
+};
+
+/* --- the fixture ----------------------------------------------------------- */
+
+static void mt76_dma_test_teardown(void *data)
+{
+	struct mt76_dma_test *t = data;
+	struct mt76_dev *dev = t->dev;
+	struct mt76_txwi_cache *r;
+	int i, id;
+
+	skb_queue_purge(&t->rx);
+
+	if (!t->dma_cleaned) {
+		for (i = 0; i < t->n_txq; i++)
+			mt76_dma_tx_cleanup(dev, t->txq[i], true);
+
+		for_each_set_bit(i, &t->napi_enabled, __MT_RXQ_MAX)
+			napi_disable(&dev->napi[i]);
+
+		for (i = 0; i < ARRAY_SIZE(dev->q_rx); i++) {
+			struct mt76_queue *q = &dev->q_rx[i];
+
+			/* RRO data buffers are owned by their rx tokens */
+			if (!q->ndesc || mt76_queue_is_wed_rro_data(q))
+				continue;
+			mt76_dma_rx_cleanup(dev, q);
+		}
+	}
+
+	/* buffers still held by rx tokens */
+	idr_for_each_entry(&dev->rx_token, r, id) {
+		if (r->ptr)
+			mt76_put_page_pool_buf(r->ptr, false);
+		kfree(r);
+	}
+	idr_destroy(&dev->rx_token);
+
+	if (!t->dma_cleaned) {
+		for (i = 0; i < ARRAY_SIZE(dev->q_rx); i++) {
+			page_pool_destroy(dev->q_rx[i].page_pool);
+			dev->q_rx[i].page_pool = NULL;
+		}
+		for_each_set_bit(i, &t->napi_added, __MT_RXQ_MAX)
+			netif_napi_del(&dev->napi[i]);
+		mt76_free_pending_txwi(dev);
+		mt76_free_pending_rxwi(dev);
+	}
+	free_netdev(t->napi_dev);
+	mt76_dma_test_ctx = NULL;
+}
+
+/* An mt76 device with DMA queue ops and an MMIO window, on @drv (NULL: the
+ * plain test driver).
+ */
+static struct mt76_dma_test *
+mt76_dma_test_init(struct kunit *test, const struct mt76_driver_ops *drv)
+{
+	struct mt76_dma_test *t;
+	struct mt76_dev **priv;
+	struct mt76_dev *dev;
+
+	t = kunit_kzalloc(test, sizeof(*t), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, t);
+	t->test = test;
+	skb_queue_head_init(&t->rx);
+
+	dev = mt76_test_dev(test, sizeof(*dev), &mt76_dma_test_hw_ops,
+			    drv ?: &mt76_dma_test_drv);
+	t->dev = dev;
+	KUNIT_ASSERT_EQ(test, dma_coerce_mask_and_coherent(dev->dma_dev,
+			DMA_BIT_MASK(32)), 0);
+	t->regs = kunit_kzalloc(test, MT76_DMA_TEST_REGS, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, t->regs);
+	dev->mmio.regs = (void __iomem *)t->regs;
+	dev->rx_token_size = 64;
+	mt76_dma_attach(dev);
+
+	t->napi_dev = alloc_netdev_dummy(sizeof(struct mt76_dev *));
+	KUNIT_ASSERT_NOT_NULL(test, t->napi_dev);
+	priv = netdev_priv(t->napi_dev);
+	*priv = dev;
+
+	mt76_dma_test_ctx = t;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt76_dma_test_teardown, t), 0);
+	return t;
+}
+
+static struct mt76_queue_regs *mt76_dma_test_qregs(struct mt76_queue *q)
+{
+	return (struct mt76_queue_regs __force *)q->regs;
+}
+
+/* A tx queue of @ndesc descriptors on ring @idx, flushed at the end. */
+static struct mt76_queue *
+mt76_dma_test_tx_queue(struct mt76_dma_test *t, int idx, int ndesc)
+{
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+
+	KUNIT_ASSERT_LT(t->test, t->n_txq, MT76_DMA_TEST_MAX_TXQ);
+	/* device-managed: the teardown still needs it */
+	q = devm_kzalloc(dev->dev, sizeof(*q), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(t->test, q);
+	KUNIT_ASSERT_EQ(t->test, dev->queue_ops->alloc(dev, q, idx, ndesc, 0,
+						       0), 0);
+	t->txq[t->n_txq++] = q;
+	return q;
+}
+
+/* rx queue @qid with @flags, its ring at MT76_DMA_TEST_RX_RING + qid. Its
+ * page pool links to the queue's NAPI context, which must look disabled
+ * when the pool goes (as netif_napi_add() leaves it): unless the test adds
+ * a real one, it is parked that way here. That saves an RCU grace period
+ * per queue in netif_napi_del().
+ */
+static struct mt76_queue *
+mt76_dma_test_rx_queue(struct mt76_dma_test *t, enum mt76_rxq_id qid,
+		       int ndesc, u16 flags)
+{
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q = &dev->q_rx[qid];
+	struct napi_struct *napi = &dev->napi[qid];
+
+	if (!test_bit(NAPI_STATE_LISTED, &napi->state)) {
+		set_bit(NAPI_STATE_SCHED, &napi->state);
+		WRITE_ONCE(napi->list_owner, -1);
+	}
+	q->flags = flags;
+	KUNIT_ASSERT_EQ(t->test, dev->queue_ops->alloc(dev, q, qid, ndesc,
+			MT76_DMA_TEST_BUF_SIZE, MT76_DMA_TEST_RX_RING), 0);
+	return q;
+}
+
+/* a real NAPI context for rx queue @qid, polling with mt76_dma_rx_poll() */
+static struct napi_struct *mt76_dma_test_napi(struct mt76_dma_test *t,
+					      enum mt76_rxq_id qid)
+{
+	struct napi_struct *napi = &t->dev->napi[qid];
+
+	netif_napi_add(t->napi_dev, napi, mt76_dma_rx_poll);
+	t->napi_added |= BIT(qid);
+	napi_enable(napi);
+	t->napi_enabled |= BIT(qid);
+
+	return napi;
+}
+
+static void mt76_dma_test_skb_destructor(struct sk_buff *skb)
+{
+	if (mt76_dma_test_ctx)
+		mt76_dma_test_ctx->n_freed++;
+}
+
+/* A frame of @len bytes of @fill, counted in t->n_freed when freed. */
+static struct sk_buff *mt76_dma_test_skb(struct mt76_dma_test *t, int len,
+					 u8 fill)
+{
+	struct sk_buff *skb;
+
+	skb = alloc_skb(len + 32, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(t->test, skb);
+	skb_reserve(skb, 32);
+	memset(skb_put(skb, len), fill, len);
+	skb->destructor = mt76_dma_test_skb_destructor;
+	return skb;
+}
+
+/* @skb with @n fragments of @len bytes on its frag_list */
+static void mt76_dma_test_add_frags(struct mt76_dma_test *t,
+				    struct sk_buff *skb, int n, int len)
+{
+	struct sk_buff **next = &skb_shinfo(skb)->frag_list;
+	int i;
+
+	for (i = 0; i < n; i++) {
+		struct sk_buff *frag = alloc_skb(len, GFP_KERNEL);
+
+		KUNIT_ASSERT_NOT_NULL(t->test, frag);
+		memset(skb_put(frag, len), 0x10 + i, len);
+		*next = frag;
+		next = &frag->next;
+		skb->len += len;
+		skb->data_len += len;
+	}
+}
+
+static bool mt76_dma_test_maps(struct mt76_dev *dev, dma_addr_t addr,
+			       const void *ptr)
+{
+	return dma_to_phys(dev->dma_dev, addr) == virt_to_phys(ptr);
+}
+
+/* Plays the hardware: puts @len bytes of @fill into the rx buffer of ring
+ * slot @idx and completes its descriptor, with @ctrl and @info.
+ */
+static void mt76_dma_test_rx_desc(struct mt76_dma_test *t,
+				  struct mt76_queue *q, int idx, int len,
+				  u8 fill, u32 ctrl, u32 info)
+{
+	struct mt76_queue_entry *e = &q->entry[idx];
+	struct mt76_desc *desc = &q->desc[idx];
+	int room = SKB_WITH_OVERHEAD(q->buf_size) - q->buf_offset;
+
+	if (e->buf) {
+		memset(e->buf + q->buf_offset, fill, min(len, room));
+		dma_sync_single_for_device(t->dev->dma_dev, e->dma_addr[0],
+					   min(len, room), DMA_FROM_DEVICE);
+	}
+	desc->info = cpu_to_le32(info);
+	dma_wmb();
+	desc->ctrl = cpu_to_le32(ctrl | MT_DMA_CTL_DMA_DONE |
+				 FIELD_PREP(MT_DMA_CTL_SD_LEN0, len));
+}
+
+/* a single-buffer frame */
+static void mt76_dma_test_rx_frame(struct mt76_dma_test *t,
+				   struct mt76_queue *q, int idx, int len,
+				   u8 fill)
+{
+	mt76_dma_test_rx_desc(t, q, idx, len, fill, MT_DMA_CTL_LAST_SEC0, 0);
+}
+
+/* rx processing as NAPI runs it: in softirq context */
+static int mt76_dma_test_poll(struct mt76_dma_test *t, struct mt76_queue *q,
+			      int budget)
+{
+	int done;
+
+	local_bh_disable();
+	done = mt76_dma_rx_process(t->dev, q, budget);
+	local_bh_enable();
+
+	return done;
+}
+
+static bool mt76_dma_test_skb_filled(struct sk_buff *skb, int off, int len,
+				     u8 fill)
+{
+	return !memchr_inv(skb->data + off, fill, len);
+}
+
+/* --- queue setup ---------------------------------------------------------- */
+
+/* A new tx ring is programmed into its own register block (ring_base plus
+ * 16 bytes per ring), starts empty at index 0 and has every descriptor
+ * marked done, i.e. owned by the host.
+ */
+static void mt76_dma_test_alloc_tx_queue(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue_regs *regs;
+	struct mt76_queue *q;
+	int i;
+
+	q = devm_kzalloc(dev->dev, sizeof(*q), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, q);
+	/* stale state from before a reset */
+	t->regs[(0x100 + 3 * MT_RING_SIZE) / 4 + 2] = 5;	/* cpu_idx */
+	t->regs[(0x100 + 3 * MT_RING_SIZE) / 4 + 3] = 6;	/* dma_idx */
+
+	KUNIT_ASSERT_EQ(test, dev->queue_ops->alloc(dev, q, 3, 16, 0, 0x100),
+			0);
+	t->txq[t->n_txq++] = q;
+
+	KUNIT_EXPECT_PTR_EQ(test, (void *)q->regs,
+			    (void *)&t->regs[(0x100 + 3 * MT_RING_SIZE) / 4]);
+	regs = mt76_dma_test_qregs(q);
+	KUNIT_EXPECT_EQ(test, q->ndesc, 16);
+	KUNIT_EXPECT_EQ(test, q->hw_idx, 3);
+	KUNIT_EXPECT_PTR_EQ(test, q->dev, dev);
+	KUNIT_ASSERT_NOT_NULL(test, q->desc);
+	KUNIT_ASSERT_NOT_NULL(test, q->entry);
+	KUNIT_EXPECT_EQ(test, regs->desc_base, lower_32_bits(q->desc_dma));
+	KUNIT_EXPECT_EQ(test, regs->ring_size, 16);
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 0);
+	KUNIT_EXPECT_EQ(test, regs->dma_idx, 0);
+	KUNIT_EXPECT_EQ(test, q->head, 0);
+	KUNIT_EXPECT_EQ(test, q->tail, 0);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	for (i = 0; i < q->ndesc; i++)
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[i].ctrl),
+				MT_DMA_CTL_DMA_DONE);
+	/* tx rings take no page pool */
+	KUNIT_EXPECT_NULL(test, q->page_pool);
+	/* the ring before it is untouched */
+	KUNIT_EXPECT_EQ(test, t->regs[(0x100 + 2 * MT_RING_SIZE) / 4 + 1], 0);
+}
+
+/* An rx ring gets a page pool for its buffers, but no buffers yet. */
+static void mt76_dma_test_alloc_rx_queue(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_queue *q;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_BAND1, 8, 0);
+
+	KUNIT_EXPECT_NOT_NULL(test, q->page_pool);
+	KUNIT_EXPECT_EQ(test, q->buf_size, MT76_DMA_TEST_BUF_SIZE);
+	KUNIT_EXPECT_EQ(test, q->hw_idx, MT_RXQ_BAND1);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(q)->ring_size, 8);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_NULL(test, q->entry[0].buf);
+}
+
+/* A queue reset hands every descriptor back to the host and restarts the
+ * ring at index 0, or, without resetting the indices, where the hardware
+ * stands.
+ */
+static void mt76_dma_test_queue_reset(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue_regs *regs;
+	struct mt76_queue *q;
+	int i;
+
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	regs = mt76_dma_test_qregs(q);
+
+	for (i = 0; i < q->ndesc; i++)
+		q->desc[i].ctrl = 0;
+	regs->cpu_idx = 4;
+	regs->dma_idx = 3;
+	regs->ring_size = 0;
+	regs->desc_base = 0;
+	q->head = 4;
+	q->tail = 3;
+
+	/* without resetting the indices: resync to the hardware's position */
+	dev->queue_ops->reset_q(dev, q, false);
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 4);
+	KUNIT_EXPECT_EQ(test, regs->dma_idx, 3);
+	KUNIT_EXPECT_EQ(test, q->head, 3);
+	KUNIT_EXPECT_EQ(test, q->tail, 3);
+	KUNIT_EXPECT_EQ(test, regs->ring_size, 8);
+	KUNIT_EXPECT_EQ(test, regs->desc_base, lower_32_bits(q->desc_dma));
+	for (i = 0; i < q->ndesc; i++)
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[i].ctrl),
+				MT_DMA_CTL_DMA_DONE);
+
+	/* with: both indices back to 0 */
+	dev->queue_ops->reset_q(dev, q, true);
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 0);
+	KUNIT_EXPECT_EQ(test, regs->dma_idx, 0);
+	KUNIT_EXPECT_EQ(test, q->head, 0);
+	KUNIT_EXPECT_EQ(test, q->tail, 0);
+
+	/* no queue, or a queue never allocated: nothing to do */
+	dev->queue_ops->reset_q(dev, NULL, true);
+	q->ndesc = 0;
+	regs->cpu_idx = 7;
+	dev->queue_ops->reset_q(dev, q, true);
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 7);
+	q->ndesc = 8;
+	regs->cpu_idx = 0;
+}
+
+/* A dead bus reads 0xffffffff from every register: syncing to it must not
+ * put the ring indices out of range.
+ */
+static void mt76_dma_test_queue_reset_dead_bus(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	q->head = 5;
+	q->tail = 5;
+	mt76_dma_test_qregs(q)->dma_idx = 0xffffffff;
+
+	dev->queue_ops->reset_q(dev, q, false);
+
+	KUNIT_EXPECT_EQ(test, q->head, 0);
+	KUNIT_EXPECT_EQ(test, q->tail, 0);
+	mt76_dma_test_qregs(q)->dma_idx = 0;
+}
+
+/* EMI queues take their cpu index from host memory, not the register: a
+ * new one is left for the driver to reset; resets and kicks go to memory.
+ */
+static void mt76_dma_test_emi_queue(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue_regs *regs;
+	struct mt76_queue *q;
+	__le16 *emi;
+
+	emi = devm_kzalloc(dev->dev, sizeof(*emi), GFP_KERNEL);
+	q = devm_kzalloc(dev->dev, sizeof(*q), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, emi);
+	KUNIT_ASSERT_NOT_NULL(test, q);
+	t->regs[2] = 9;		/* ring 0's cpu_idx */
+	t->regs[3] = 2;		/* ring 0's dma_idx */
+	q->flags = MT_QFLAG_EMI_EN;
+
+	KUNIT_ASSERT_EQ(test, dev->queue_ops->alloc(dev, q, 0, 8, 0, 0), 0);
+	t->txq[t->n_txq++] = q;
+	regs = mt76_dma_test_qregs(q);
+
+	/* not reset: the indices stay as they were */
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 9);
+	KUNIT_EXPECT_EQ(test, regs->dma_idx, 2);
+	KUNIT_EXPECT_EQ(test, q->head, 2);
+	KUNIT_EXPECT_EQ(test, regs->ring_size, 8);
+
+	q->emi_cpu_idx = emi;
+	*emi = cpu_to_le16(6);
+	dev->queue_ops->reset_q(dev, q, true);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(*emi), 0);
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 9);
+	KUNIT_EXPECT_EQ(test, regs->dma_idx, 0);
+
+	q->head = 5;
+	dev->queue_ops->kick(dev, q);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(*emi), 5);
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 9);
+	q->head = 0;
+}
+
+/* --- txwi and rxwi caches -------------------------------------------------- */
+
+/* A txwi comes from the cache when there is one; a new one is DMA-mapped,
+ * with its descriptor txwi_size bytes in front of the cache entry.
+ */
+static void mt76_dma_test_txwi_cache(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_txwi_cache *a, *b;
+
+	a = mt76_get_txwi(dev);
+	b = mt76_get_txwi(dev);
+	KUNIT_ASSERT_NOT_NULL(test, a);
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	KUNIT_EXPECT_PTR_NE(test, a, b);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_maps(dev, a->dma_addr,
+						   mt76_get_txwi_ptr(dev, a)));
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_maps(dev, b->dma_addr,
+						   mt76_get_txwi_ptr(dev, b)));
+
+	mt76_put_txwi(dev, a);
+	mt76_put_txwi(dev, b);
+	mt76_put_txwi(dev, NULL);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->txwi_cache), 2);
+
+	/* newest first, without a new allocation */
+	KUNIT_EXPECT_PTR_EQ(test, mt76_get_txwi(dev), b);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_get_txwi(dev), a);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->txwi_cache));
+
+	mt76_put_txwi(dev, a);
+	mt76_put_txwi(dev, b);
+	mt76_free_pending_txwi(dev);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->txwi_cache));
+}
+
+/* rxwis work the same way, start without a buffer, and freeing the cache
+ * gives back the buffers they still hold.
+ */
+static void mt76_dma_test_rxwi_cache(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_txwi_cache *a, *b;
+	struct mt76_queue *q;
+	u32 offset;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 4, 0);
+
+	a = mt76_get_rxwi(dev);
+	b = mt76_get_rxwi(dev);
+	KUNIT_ASSERT_NOT_NULL(test, a);
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	KUNIT_EXPECT_PTR_NE(test, a, b);
+	KUNIT_EXPECT_NULL(test, a->ptr);
+
+	mt76_put_rxwi(dev, a);
+	mt76_put_rxwi(dev, NULL);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->rxwi_cache), 1);
+	KUNIT_EXPECT_PTR_EQ(test, mt76_get_rxwi(dev), a);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->rxwi_cache));
+
+	a->ptr = mt76_get_page_pool_buf(q, &offset, q->buf_size);
+	KUNIT_ASSERT_NOT_NULL(test, a->ptr);
+	mt76_put_rxwi(dev, a);
+	mt76_put_rxwi(dev, b);
+	mt76_free_pending_rxwi(dev);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->rxwi_cache));
+}
+
+/* --- tx -------------------------------------------------------------------------- */
+
+/* A linear frame takes one descriptor: the txwi in buf0, the frame in buf1.
+ * The driver gets the txwi to fill; the hardware is only told about the
+ * frame once the queue is kicked.
+ */
+static void mt76_dma_test_tx_queue_skb(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue_entry *e;
+	struct mt76_txwi_cache *txwi;
+	struct ieee80211_sta *sta;
+	struct mt76_wcid *wcid;
+	struct mt76_queue *q;
+	struct sk_buff *skb;
+	struct mt76_desc *d;
+	u32 ctrl;
+	u8 *ptr;
+
+	q = mt76_dma_test_tx_queue(t, 1, 16);
+	wcid = kunit_kzalloc(test, sizeof(*wcid), GFP_KERNEL);
+	sta = kunit_kzalloc(test, sizeof(*sta), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, wcid);
+	KUNIT_ASSERT_NOT_NULL(test, sta);
+	skb = mt76_dma_test_skb(t, 100, 0x77);
+	dev->phy.band_idx = MT_BAND1;
+	t->tx_info = 0xc0000a50;
+
+	KUNIT_ASSERT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+			MT_TXQ_VI, skb, wcid, sta), 0);
+
+	KUNIT_EXPECT_EQ(test, t->n_prepare, 1);
+	KUNIT_EXPECT_EQ(test, t->prepare_qid, MT_TXQ_VI);
+	KUNIT_EXPECT_PTR_EQ(test, t->prepare_wcid, wcid);
+	KUNIT_EXPECT_PTR_EQ(test, t->prepare_sta, sta);
+	KUNIT_EXPECT_EQ(test, t->prepare_nbuf, 2);
+
+	e = &q->entry[0];
+	d = &q->desc[0];
+	txwi = e->txwi;
+	KUNIT_ASSERT_NOT_NULL(test, txwi);
+	ptr = mt76_get_txwi_ptr(dev, txwi);
+	KUNIT_EXPECT_PTR_EQ(test, t->prepare_txwi, (void *)ptr);
+	KUNIT_EXPECT_EQ(test, txwi->qid, MT_TXQ_VI);
+	KUNIT_EXPECT_EQ(test, txwi->phy_idx, MT_BAND1);
+	KUNIT_EXPECT_EQ(test, ptr[0], 0xa5);
+
+	ctrl = le32_to_cpu(d->ctrl);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(d->buf0),
+			lower_32_bits(txwi->dma_addr));
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(d->buf1),
+			lower_32_bits(e->dma_addr[1]));
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_maps(dev, e->dma_addr[1],
+						   skb->data));
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_SD_LEN0, ctrl),
+			MT76_DMA_TEST_TXWI_SIZE);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_SD_LEN1, ctrl), 100);
+	KUNIT_EXPECT_TRUE(test, ctrl & MT_DMA_CTL_LAST_SEC1);
+	KUNIT_EXPECT_FALSE(test, ctrl & MT_DMA_CTL_LAST_SEC0);
+	KUNIT_EXPECT_FALSE(test, ctrl & MT_DMA_CTL_DMA_DONE);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(d->info), 0xc0000a50);
+
+	KUNIT_EXPECT_PTR_EQ(test, e->skb, skb);
+	KUNIT_EXPECT_EQ(test, e->dma_len[0], MT76_DMA_TEST_TXWI_SIZE);
+	KUNIT_EXPECT_EQ(test, e->dma_len[1], 100);
+	/* the txwi stays mapped for reuse, the frame is unmapped when done */
+	KUNIT_EXPECT_TRUE(test, e->skip_buf0);
+	KUNIT_EXPECT_FALSE(test, e->skip_buf1);
+	KUNIT_EXPECT_EQ(test, e->wcid, 0xffff);
+	KUNIT_EXPECT_EQ(test, q->head, 1);
+	KUNIT_EXPECT_EQ(test, q->queued, 1);
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(q)->cpu_idx, 0);
+	dev->queue_ops->kick(dev, q);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(q)->cpu_idx, 1);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 0);
+}
+
+/* Fragments fill the descriptors two at a time after the txwi and the
+ * head; the last buffer is marked in the last descriptor, and the frame's
+ * skb and txwi are kept on that one.
+ */
+static void mt76_dma_test_tx_queue_skb_frags(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct sk_buff *skb, *frag;
+	struct mt76_queue *q;
+	u32 ctrl;
+
+	q = mt76_dma_test_tx_queue(t, 0, 16);
+
+	/* txwi + head + 2 fragments: two full descriptors */
+	skb = mt76_dma_test_skb(t, 60, 0x01);
+	mt76_dma_test_add_frags(t, skb, 2, 40);
+	KUNIT_ASSERT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+			MT_TXQ_BE, skb, NULL, NULL), 1);
+	KUNIT_EXPECT_EQ(test, t->prepare_nbuf, 4);
+	KUNIT_EXPECT_EQ(test, q->queued, 2);
+	KUNIT_EXPECT_EQ(test, q->head, 2);
+
+	ctrl = le32_to_cpu(q->desc[0].ctrl);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_SD_LEN1, ctrl), 60);
+	KUNIT_EXPECT_FALSE(test, ctrl & (MT_DMA_CTL_LAST_SEC0 |
+					 MT_DMA_CTL_LAST_SEC1));
+	frag = skb_shinfo(skb)->frag_list;
+	ctrl = le32_to_cpu(q->desc[1].ctrl);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_SD_LEN0, ctrl), 40);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_SD_LEN1, ctrl), 40);
+	KUNIT_EXPECT_TRUE(test, ctrl & MT_DMA_CTL_LAST_SEC1);
+	KUNIT_EXPECT_FALSE(test, ctrl & MT_DMA_CTL_LAST_SEC0);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_maps(dev, q->entry[1].dma_addr[0],
+						   frag->data));
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_maps(dev, q->entry[1].dma_addr[1],
+						   frag->next->data));
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[1].buf1),
+			lower_32_bits(q->entry[1].dma_addr[1]));
+
+	/* the first descriptor only marks the txwi as taken */
+	KUNIT_EXPECT_PTR_EQ(test, q->entry[0].txwi, DMA_DUMMY_DATA);
+	KUNIT_EXPECT_NULL(test, q->entry[0].skb);
+	KUNIT_EXPECT_TRUE(test, q->entry[0].skip_buf0);
+	KUNIT_EXPECT_FALSE(test, q->entry[0].skip_buf1);
+	KUNIT_EXPECT_PTR_EQ(test, q->entry[1].skb, skb);
+	KUNIT_EXPECT_NOT_NULL(test, q->entry[1].txwi);
+	KUNIT_EXPECT_PTR_NE(test, q->entry[1].txwi, DMA_DUMMY_DATA);
+	KUNIT_EXPECT_FALSE(test, q->entry[1].skip_buf0);
+	KUNIT_EXPECT_FALSE(test, q->entry[1].skip_buf1);
+
+	/* txwi + head + 1 fragment: the last descriptor is half used */
+	skb = mt76_dma_test_skb(t, 50, 0x02);
+	mt76_dma_test_add_frags(t, skb, 1, 30);
+	KUNIT_ASSERT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+			MT_TXQ_BE, skb, NULL, NULL), 3);
+	ctrl = le32_to_cpu(q->desc[3].ctrl);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_SD_LEN0, ctrl), 30);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_SD_LEN1, ctrl), 0);
+	KUNIT_EXPECT_TRUE(test, ctrl & MT_DMA_CTL_LAST_SEC0);
+	KUNIT_EXPECT_FALSE(test, ctrl & MT_DMA_CTL_LAST_SEC1);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[3].buf1), 0);
+	KUNIT_EXPECT_TRUE(test, q->entry[3].skip_buf1);
+	KUNIT_EXPECT_EQ(test, q->queued, 4);
+}
+
+/* A descriptor list holds 32 buffers: the txwi, the head and 30
+ * fragments fit, one more fragment is refused.
+ */
+static void mt76_dma_test_tx_queue_skb_max_frags(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+	struct sk_buff *skb;
+	u32 ctrl;
+
+	q = mt76_dma_test_tx_queue(t, 0, 32);
+
+	skb = mt76_dma_test_skb(t, 20, 0x01);
+	mt76_dma_test_add_frags(t, skb, 30, 8);
+	KUNIT_ASSERT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+			MT_TXQ_BE, skb, NULL, NULL), 15);
+	KUNIT_EXPECT_EQ(test, t->prepare_nbuf, 32);
+	KUNIT_EXPECT_EQ(test, q->queued, 16);
+	ctrl = le32_to_cpu(q->desc[15].ctrl);
+	KUNIT_EXPECT_TRUE(test, ctrl & MT_DMA_CTL_LAST_SEC1);
+
+	skb = mt76_dma_test_skb(t, 20, 0x02);
+	mt76_dma_test_add_frags(t, skb, 31, 8);
+	KUNIT_EXPECT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+			MT_TXQ_BE, skb, NULL, NULL), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, t->n_prepare, 1);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+	KUNIT_EXPECT_EQ(test, q->queued, 16);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->txwi_cache), 1);
+}
+
+/* A frame that doesn't fit is dropped (and reported) without touching the
+ * ring, and its txwi goes back to the cache.
+ */
+static void mt76_dma_test_tx_queue_skb_full(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+	struct sk_buff *skb;
+
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	/* one descriptor left: that one is never used */
+	q->queued = 6;
+	skb = mt76_dma_test_skb(t, 100, 0x01);
+
+	KUNIT_EXPECT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+			MT_TXQ_BE, skb, NULL, NULL), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, t->n_prepare, 0);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+	KUNIT_EXPECT_EQ(test, q->head, 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[0].ctrl),
+			MT_DMA_CTL_DMA_DONE);
+	KUNIT_EXPECT_NULL(test, q->entry[0].skb);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->txwi_cache), 1);
+
+	/* two left: it fits */
+	q->queued = 5;
+	skb = mt76_dma_test_skb(t, 100, 0x02);
+	KUNIT_EXPECT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+			MT_TXQ_BE, skb, NULL, NULL), 0);
+	KUNIT_EXPECT_EQ(test, q->queued, 6);
+	/* the cached txwi was reused */
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->txwi_cache));
+	q->queued = 1;
+}
+
+/* During a reset, frames are dropped before anything is allocated. */
+static void mt76_dma_test_tx_queue_skb_reset(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+	struct sk_buff *skb;
+
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	skb = mt76_dma_test_skb(t, 100, 0x01);
+	set_bit(MT76_RESET, &dev->phy.state);
+
+	KUNIT_EXPECT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+			MT_TXQ_BE, skb, NULL, NULL), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+	KUNIT_EXPECT_EQ(test, t->n_prepare, 0);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->txwi_cache));
+	clear_bit(MT76_RESET, &dev->phy.state);
+}
+
+/* When the driver can't prepare the frame, its error is returned, the
+ * frame dropped and the txwi kept for the next one.
+ */
+static void mt76_dma_test_tx_queue_skb_prepare_error(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+	struct sk_buff *skb;
+
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	skb = mt76_dma_test_skb(t, 100, 0x01);
+	mt76_dma_test_add_frags(t, skb, 1, 20);
+	t->prepare_ret = -EINVAL;
+
+	KUNIT_EXPECT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+			MT_TXQ_BE, skb, NULL, NULL), -EINVAL);
+	KUNIT_EXPECT_EQ(test, t->n_prepare, 1);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, q->head, 0);
+	KUNIT_EXPECT_NULL(test, q->entry[0].txwi);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->txwi_cache), 1);
+}
+
+/* Drivers that need 4-byte aligned payloads get a 2-byte pad after a
+ * 26-byte QoS header.
+ */
+static void mt76_dma_test_tx_queue_skb_pad(struct kunit *test)
+{
+	struct mt76_dma_test *t;
+	struct ieee80211_hdr *hdr;
+	struct mt76_queue *q;
+	struct mt76_dev *dev;
+	struct sk_buff *skb;
+
+	t = mt76_dma_test_init(test, &mt76_dma_test_drv_aligned);
+	dev = t->dev;
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	skb = mt76_dma_test_skb(t, 40, 0x66);
+	hdr = (struct ieee80211_hdr *)skb->data;
+	hdr->frame_control = cpu_to_le16(IEEE80211_FTYPE_DATA |
+					 IEEE80211_STYPE_QOS_DATA);
+
+	KUNIT_ASSERT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+			MT_TXQ_BE, skb, NULL, NULL), 0);
+	KUNIT_EXPECT_EQ(test, skb->len, 42);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_SD_LEN1,
+					le32_to_cpu(q->desc[0].ctrl)), 42);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(((struct ieee80211_hdr *)
+					   skb->data)->frame_control),
+			IEEE80211_FTYPE_DATA | IEEE80211_STYPE_QOS_DATA);
+	KUNIT_EXPECT_EQ(test, skb->data[25], 0x66);
+	KUNIT_EXPECT_EQ(test, skb->data[26], 0);
+	KUNIT_EXPECT_EQ(test, skb->data[27], 0);
+	KUNIT_EXPECT_EQ(test, skb->data[28], 0x66);
+}
+
+/* Raw frames (MCU messages) take one descriptor without a txwi and are
+ * kicked to the hardware at once.
+ */
+static void mt76_dma_test_tx_queue_raw(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue_entry *e;
+	struct mt76_queue *q;
+	struct sk_buff *skb;
+	u32 ctrl;
+
+	q = mt76_dma_test_tx_queue(t, 2, 8);
+	skb = mt76_dma_test_skb(t, 64, 0x33);
+
+	KUNIT_ASSERT_EQ(test, dev->queue_ops->tx_queue_skb_raw(dev, q, skb,
+			0x80000005), 0);
+
+	e = &q->entry[0];
+	ctrl = le32_to_cpu(q->desc[0].ctrl);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[0].buf0),
+			lower_32_bits(e->dma_addr[0]));
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_maps(dev, e->dma_addr[0],
+						   skb->data));
+	KUNIT_EXPECT_EQ(test, ctrl, FIELD_PREP(MT_DMA_CTL_SD_LEN0, 64) |
+				    MT_DMA_CTL_LAST_SEC0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[0].buf1), 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[0].info), 0x80000005);
+	KUNIT_EXPECT_PTR_EQ(test, e->skb, skb);
+	KUNIT_EXPECT_NULL(test, e->txwi);
+	KUNIT_EXPECT_FALSE(test, e->skip_buf0);
+	KUNIT_EXPECT_TRUE(test, e->skip_buf1);
+	KUNIT_EXPECT_EQ(test, q->queued, 1);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(q)->cpu_idx, 1);
+
+	/* completion hands the frame back to the driver */
+	mt76_dma_test_qregs(q)->dma_idx = 1;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_ASSERT_EQ(test, t->n_done, 1);
+	KUNIT_EXPECT_PTR_EQ(test, t->done[0].skb, skb);
+	KUNIT_EXPECT_NULL(test, t->done[0].txwi);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->txwi_cache));
+}
+
+/* Raw frames are dropped while the MCU is being reset or when the ring is
+ * full.
+ */
+static void mt76_dma_test_tx_queue_raw_errors(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+	struct sk_buff *skb;
+
+	q = mt76_dma_test_tx_queue(t, 2, 8);
+
+	set_bit(MT76_MCU_RESET, &dev->phy.state);
+	skb = mt76_dma_test_skb(t, 64, 0x33);
+	KUNIT_EXPECT_EQ(test, dev->queue_ops->tx_queue_skb_raw(dev, q, skb, 0),
+			-ENOMEM);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 1);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(q)->cpu_idx, 0);
+	clear_bit(MT76_MCU_RESET, &dev->phy.state);
+
+	q->queued = 6;
+	skb = mt76_dma_test_skb(t, 64, 0x33);
+	KUNIT_EXPECT_EQ(test, dev->queue_ops->tx_queue_skb_raw(dev, q, skb, 0),
+			-ENOMEM);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 2);
+	KUNIT_EXPECT_EQ(test, q->head, 0);
+
+	q->queued = 5;
+	skb = mt76_dma_test_skb(t, 64, 0x33);
+	KUNIT_EXPECT_EQ(test, dev->queue_ops->tx_queue_skb_raw(dev, q, skb, 0),
+			0);
+	KUNIT_EXPECT_EQ(test, q->queued, 6);
+	q->queued = 1;
+}
+
+/* Queue @n linear frames on @q, returning them in @skbs. */
+static void mt76_dma_test_queue_frames(struct mt76_dma_test *t,
+				       struct mt76_queue *q,
+				       struct sk_buff **skbs, int n)
+{
+	struct mt76_dev *dev = t->dev;
+	int i;
+
+	for (i = 0; i < n; i++) {
+		skbs[i] = mt76_dma_test_skb(t, 50 + i, i);
+		KUNIT_ASSERT_GE(t->test, dev->queue_ops->tx_queue_skb(&dev->phy,
+				q, MT_TXQ_BE, skbs[i], NULL, NULL), 0);
+	}
+	dev->queue_ops->kick(dev, q);
+}
+
+/* Cleanup completes the frames the hardware is done with (up to dma_idx),
+ * in ring order, and keeps the rest; the txwis are cached for reuse.
+ */
+static void mt76_dma_test_tx_cleanup(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_txwi_cache *txwi[3];
+	struct mt76_dev *dev = t->dev;
+	struct sk_buff *skbs[3];
+	struct mt76_queue *q;
+	int i;
+
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	mt76_dma_test_queue_frames(t, q, skbs, 3);
+	for (i = 0; i < 3; i++)
+		txwi[i] = q->entry[i].txwi;
+
+	/* nothing done yet */
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, t->n_done, 0);
+	KUNIT_EXPECT_EQ(test, q->queued, 3);
+
+	mt76_dma_test_qregs(q)->dma_idx = 2;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_ASSERT_EQ(test, t->n_done, 2);
+	KUNIT_EXPECT_PTR_EQ(test, t->done[0].skb, skbs[0]);
+	KUNIT_EXPECT_PTR_EQ(test, t->done[0].txwi, txwi[0]);
+	KUNIT_EXPECT_PTR_EQ(test, t->done[1].skb, skbs[1]);
+	KUNIT_EXPECT_EQ(test, t->done[1].wcid, 0xffff);
+	KUNIT_EXPECT_EQ(test, q->tail, 2);
+	KUNIT_EXPECT_EQ(test, q->queued, 1);
+	/* completed entries are cleared, the pending one is kept */
+	KUNIT_EXPECT_NULL(test, q->entry[0].skb);
+	KUNIT_EXPECT_NULL(test, q->entry[1].txwi);
+	KUNIT_EXPECT_PTR_EQ(test, q->entry[2].skb, skbs[2]);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->txwi_cache), 2);
+	KUNIT_EXPECT_PTR_EQ(test, list_first_entry(&dev->txwi_cache,
+			struct mt76_txwi_cache, list), txwi[1]);
+
+	mt76_dma_test_qregs(q)->dma_idx = 3;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+	KUNIT_EXPECT_EQ(test, t->n_done, 3);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, q->tail, 3);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 3);
+
+	/* the next frame reuses the newest cached txwi */
+	mt76_dma_test_queue_frames(t, q, skbs, 1);
+	KUNIT_EXPECT_PTR_EQ(test, q->entry[3].txwi, txwi[2]);
+}
+
+/* dma_idx is read again when the cleanup reaches it, so frames finished
+ * meanwhile are reclaimed in the same pass.
+ */
+static void mt76_dma_test_tx_cleanup_reread(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct sk_buff *skbs[4];
+	struct mt76_queue *q;
+
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	mt76_dma_test_queue_frames(t, q, skbs, 4);
+
+	mt76_dma_test_qregs(q)->dma_idx = 1;
+	t->bump_q = q;
+	t->bump_dma_idx = 3;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+
+	KUNIT_EXPECT_EQ(test, t->n_done, 3);
+	KUNIT_EXPECT_EQ(test, q->tail, 3);
+	KUNIT_EXPECT_EQ(test, q->queued, 1);
+}
+
+/* A frame spread over two descriptors completes once, with its txwi;
+ * the first descriptor's txwi placeholder isn't taken for a txwi.
+ */
+static void mt76_dma_test_tx_cleanup_multi_desc(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_txwi_cache *txwi;
+	struct mt76_queue *q;
+	struct sk_buff *skb;
+
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	skb = mt76_dma_test_skb(t, 60, 0x01);
+	mt76_dma_test_add_frags(t, skb, 2, 40);
+	KUNIT_ASSERT_EQ(test, dev->queue_ops->tx_queue_skb(&dev->phy, q,
+			MT_TXQ_BE, skb, NULL, NULL), 1);
+	txwi = q->entry[1].txwi;
+
+	mt76_dma_test_qregs(q)->dma_idx = 2;
+	dev->queue_ops->tx_cleanup(dev, q, false);
+
+	KUNIT_ASSERT_EQ(test, t->n_done, 1);
+	KUNIT_EXPECT_PTR_EQ(test, t->done[0].skb, skb);
+	KUNIT_EXPECT_PTR_EQ(test, t->done[0].txwi, txwi);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->txwi_cache), 1);
+	KUNIT_EXPECT_PTR_EQ(test, list_first_entry(&dev->txwi_cache,
+			struct mt76_txwi_cache, list), txwi);
+	KUNIT_EXPECT_NULL(test, q->entry[0].txwi);
+}
+
+/* A flush completes everything regardless of the hardware, then resyncs
+ * the ring to where the hardware stands.
+ */
+static void mt76_dma_test_tx_cleanup_flush(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue_regs *regs;
+	struct sk_buff *skbs[3];
+	struct mt76_queue *q;
+
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	regs = mt76_dma_test_qregs(q);
+	mt76_dma_test_queue_frames(t, q, skbs, 3);
+	regs->dma_idx = 1;
+	regs->ring_size = 0;
+
+	dev->queue_ops->tx_cleanup(dev, q, true);
+
+	KUNIT_EXPECT_EQ(test, t->n_done, 3);
+	KUNIT_EXPECT_EQ(test, t->n_freed, 3);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, q->head, 1);
+	KUNIT_EXPECT_EQ(test, q->tail, 1);
+	KUNIT_EXPECT_EQ(test, regs->cpu_idx, 1);
+	KUNIT_EXPECT_EQ(test, regs->ring_size, 8);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->txwi_cache), 3);
+}
+
+/* On a dead bus (dma_idx reads 0xffffffff) the cleanup can't tell how far
+ * the hardware got: it reclaims everything and keeps the ring indices in
+ * range.
+ */
+static void mt76_dma_test_tx_cleanup_dead_bus(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct sk_buff *skbs[3];
+	struct mt76_queue *q;
+
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	mt76_dma_test_queue_frames(t, q, skbs, 3);
+	mt76_dma_test_qregs(q)->dma_idx = 0xffffffff;
+
+	dev->queue_ops->tx_cleanup(dev, q, false);
+
+	KUNIT_EXPECT_EQ(test, t->n_done, 3);
+	KUNIT_EXPECT_EQ(test, q->queued, 0);
+	KUNIT_EXPECT_EQ(test, q->tail, 3);
+	KUNIT_EXPECT_LT(test, (int)q->tail, q->ndesc);
+	mt76_dma_test_qregs(q)->dma_idx = 3;
+}
+
+/* With MT_DRV_TXWI_NO_FREE (the mt7915) the txwi belongs to the driver's
+ * tx token: cleanup must not cache it.
+ */
+static void mt76_dma_test_tx_cleanup_no_free(struct kunit *test)
+{
+	struct mt76_dma_test *t;
+	struct sk_buff *skbs[2];
+	struct mt76_queue *q;
+	struct mt76_dev *dev;
+
+	t = mt76_dma_test_init(test, &mt76_dma_test_drv_no_free);
+	dev = t->dev;
+	q = mt76_dma_test_tx_queue(t, 0, 8);
+	mt76_dma_test_queue_frames(t, q, skbs, 2);
+	mt76_dma_test_qregs(q)->dma_idx = 2;
+
+	dev->queue_ops->tx_cleanup(dev, q, false);
+
+	KUNIT_ASSERT_EQ(test, t->n_done, 2);
+	KUNIT_EXPECT_NOT_NULL(test, t->done[0].txwi);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->txwi_cache));
+	/* the driver's job: give them back */
+	mt76_put_txwi(dev, t->done[0].txwi);
+	mt76_put_txwi(dev, t->done[1].txwi);
+}
+
+/* Cleaning up a missing or unallocated queue does nothing. */
+static void mt76_dma_test_tx_cleanup_no_queue(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+
+	q = kunit_kzalloc(test, sizeof(*q), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, q);
+	q->queued = 1;
+
+	dev->queue_ops->tx_cleanup(dev, NULL, true);
+	dev->queue_ops->tx_cleanup(dev, q, true);
+
+	KUNIT_EXPECT_EQ(test, t->n_done, 0);
+	KUNIT_EXPECT_EQ(test, q->queued, 1);
+}
+
+/* --- rx -------------------------------------------------------------------------- */
+
+/* Filling an rx ring gives every slot but one a page pool buffer (the
+ * hardware would take a full ring for an empty one), each descriptor
+ * pointing past the buffer's headroom with the room left, owned by the
+ * hardware, and kicks the ring.
+ */
+static void mt76_dma_test_rx_fill(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+	int i, len;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, 0);
+	q->buf_offset = 32;
+	len = SKB_WITH_OVERHEAD(MT76_DMA_TEST_BUF_SIZE) - 32;
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_rx_fill(dev, q, false), 7);
+	KUNIT_EXPECT_EQ(test, q->queued, 7);
+	KUNIT_EXPECT_EQ(test, q->head, 7);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(q)->cpu_idx, 7);
+
+	for (i = 0; i < 7; i++) {
+		struct mt76_queue_entry *e = &q->entry[i];
+		struct mt76_desc *d = &q->desc[i];
+
+		KUNIT_ASSERT_NOT_NULL(test, e->buf);
+		KUNIT_EXPECT_TRUE(test, mt76_dma_test_maps(dev, e->dma_addr[0],
+							   e->buf + 32));
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(d->buf0),
+				lower_32_bits(e->dma_addr[0]));
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(d->ctrl),
+				FIELD_PREP(MT_DMA_CTL_SD_LEN0, len));
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(d->buf1), 0);
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(d->info), 0);
+		KUNIT_EXPECT_EQ(test, e->dma_len[0], len);
+		KUNIT_EXPECT_EQ(test, e->wcid, 0xffff);
+		KUNIT_EXPECT_NULL(test, e->txwi);
+		if (i)
+			KUNIT_EXPECT_PTR_NE(test, e->buf, q->entry[i - 1].buf);
+	}
+	KUNIT_EXPECT_NULL(test, q->entry[7].buf);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(q->desc[7].ctrl),
+			MT_DMA_CTL_DMA_DONE);
+
+	/* already full: nothing added, nothing kicked */
+	mt76_dma_test_qregs(q)->cpu_idx = 0x55;
+	KUNIT_EXPECT_EQ(test, mt76_dma_rx_fill(dev, q, false), 0);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(q)->cpu_idx, 0x55);
+	mt76_dma_test_qregs(q)->cpu_idx = 7;
+
+	/* a queue that was never allocated */
+	KUNIT_EXPECT_EQ(test, mt76_dma_rx_fill_buf(dev,
+					&dev->q_rx[MT_RXQ_BAND2], false), 0);
+}
+
+/* A completed single-buffer frame becomes an skb on the buffer itself
+ * (past the headroom), passed to the driver with its descriptor info;
+ * the slot is refilled and the ring kicked.
+ */
+static void mt76_dma_test_rx_process(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_queue *q;
+	struct sk_buff *skb;
+	void *buf;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_BAND1, 8, 0);
+	q->buf_offset = 64;
+	KUNIT_ASSERT_EQ(test, mt76_dma_rx_fill(t->dev, q, false), 7);
+	buf = q->entry[0].buf;
+	mt76_dma_test_rx_desc(t, q, 0, 100, 0x3c, MT_DMA_CTL_LAST_SEC0,
+			      0xabcd0001);
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 1);
+
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&t->rx), 1);
+	skb = skb_peek(&t->rx);
+	KUNIT_EXPECT_EQ(test, t->rx_qid, MT_RXQ_BAND1);
+	KUNIT_EXPECT_EQ(test, t->rx_info, 0xabcd0001);
+	KUNIT_EXPECT_EQ(test, *(u32 *)skb->cb, 0xabcd0001);
+	KUNIT_EXPECT_EQ(test, skb->len, 100);
+	KUNIT_EXPECT_PTR_EQ(test, (void *)skb->head, buf);
+	KUNIT_EXPECT_PTR_EQ(test, (void *)skb->data, buf + 64);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_skb_filled(skb, 0, 100, 0x3c));
+	KUNIT_EXPECT_EQ(test, t->n_rx_check, 1);
+	KUNIT_EXPECT_PTR_EQ(test, t->rx_check_data, buf);
+	KUNIT_EXPECT_EQ(test, t->rx_check_len, 100);
+
+	KUNIT_EXPECT_EQ(test, q->tail, 1);
+	KUNIT_EXPECT_EQ(test, q->queued, 7);
+	KUNIT_EXPECT_EQ(test, q->head, 0);
+	KUNIT_EXPECT_NULL(test, q->entry[0].buf);
+	KUNIT_EXPECT_NOT_NULL(test, q->entry[7].buf);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(q)->cpu_idx, 0);
+
+	/* nothing more completed */
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 0);
+	KUNIT_EXPECT_EQ(test, q->tail, 1);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&t->rx), 1);
+}
+
+/* Processing stops at the budget; the rest is left for the next poll. */
+static void mt76_dma_test_rx_process_budget(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_queue *q;
+	int i;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, 0);
+	mt76_dma_rx_fill(t->dev, q, false);
+	for (i = 0; i < 3; i++)
+		mt76_dma_test_rx_frame(t, q, i, 60, i);
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 2), 2);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&t->rx), 2);
+	KUNIT_EXPECT_EQ(test, q->tail, 2);
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 2), 1);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&t->rx), 3);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_skb_filled(skb_peek_tail(&t->rx),
+							 0, 60, 2));
+}
+
+/* Frames the driver consumes in rx_check (tx-free events and the like) are
+ * recycled and don't count against the budget.
+ */
+static void mt76_dma_test_rx_process_rx_check(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_queue *q;
+	void *buf;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, 0);
+	mt76_dma_rx_fill(t->dev, q, false);
+	buf = q->entry[0].buf;
+	mt76_dma_test_rx_frame(t, q, 0, 24, 0x11);
+	t->rx_check_drop = true;
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 0);
+	KUNIT_EXPECT_EQ(test, t->n_rx_check, 1);
+	KUNIT_EXPECT_PTR_EQ(test, t->rx_check_data, buf);
+	KUNIT_EXPECT_EQ(test, t->rx_check_len, 24);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&t->rx), 0);
+	KUNIT_EXPECT_EQ(test, q->tail, 1);
+	KUNIT_EXPECT_EQ(test, q->queued, 7);
+}
+
+/* A frame over several buffers becomes one skb: the first buffer is its
+ * head, the others page fragments. Only complete frames reach the driver
+ * and rx_check, and they count once against the budget.
+ */
+static void mt76_dma_test_rx_process_frags(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct skb_shared_info *shinfo;
+	struct sk_buff *skb;
+	struct mt76_queue *q;
+	struct page *page;
+	void *buf1;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, 0);
+	mt76_dma_rx_fill(t->dev, q, false);
+	buf1 = q->entry[1].buf;
+	mt76_dma_test_rx_desc(t, q, 0, 1000, 0xaa, 0, 1);
+	mt76_dma_test_rx_desc(t, q, 1, 300, 0xbb, MT_DMA_CTL_LAST_SEC0, 2);
+
+	/* only the first half is there yet */
+	q->desc[1].ctrl &= ~cpu_to_le32(MT_DMA_CTL_DMA_DONE);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 1);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&t->rx), 0);
+	KUNIT_EXPECT_NOT_NULL(test, q->rx_head);
+
+	q->desc[1].ctrl |= cpu_to_le32(MT_DMA_CTL_DMA_DONE);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 0);
+
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&t->rx), 1);
+	KUNIT_EXPECT_NULL(test, q->rx_head);
+	skb = skb_peek(&t->rx);
+	shinfo = skb_shinfo(skb);
+	KUNIT_EXPECT_EQ(test, skb->len, 1300);
+	KUNIT_EXPECT_EQ(test, skb_headlen(skb), 1000);
+	KUNIT_ASSERT_EQ(test, shinfo->nr_frags, 1);
+	page = virt_to_head_page(buf1);
+	KUNIT_EXPECT_PTR_EQ(test, skb_frag_page(&shinfo->frags[0]), page);
+	KUNIT_EXPECT_EQ(test, skb_frag_off(&shinfo->frags[0]),
+			buf1 - page_address(page));
+	KUNIT_EXPECT_EQ(test, skb_frag_size(&shinfo->frags[0]), 300);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_skb_filled(skb, 0, 1000, 0xaa));
+	KUNIT_EXPECT_EQ(test, *(u8 *)skb_frag_address(&shinfo->frags[0]),
+			0xbb);
+	/* the info passed along is the last descriptor's */
+	KUNIT_EXPECT_EQ(test, t->rx_info, 2);
+	KUNIT_EXPECT_EQ(test, t->n_rx_check, 0);
+}
+
+/* Descriptors flagged for dropping (hardware drop, to-host-A, WED repeat,
+ * old non-fragment packets, PN check failures) are recycled without
+ * reaching the driver; the rest go through.
+ */
+static void mt76_dma_test_rx_process_drop(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	u32 last = MT_DMA_CTL_LAST_SEC0, ver = MT_DMA_CTL_VER_MASK;
+	struct mt76_queue *q;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 16, 0);
+	mt76_dma_rx_fill(t->dev, q, false);
+
+	mt76_dma_test_rx_desc(t, q, 0, 40, 0, last | MT_DMA_CTL_DROP, 0);
+	mt76_dma_test_rx_desc(t, q, 1, 40, 1, last | MT_DMA_CTL_TO_HOST_A, 0);
+	q->desc[2].buf1 = cpu_to_le32(FIELD_PREP(MT_DMA_WED_IND_REASON,
+					MT_DMA_WED_IND_REASON_REPEAT));
+	mt76_dma_test_rx_desc(t, q, 2, 40, 2, last | ver, 0);
+	q->desc[3].buf1 = cpu_to_le32(FIELD_PREP(MT_DMA_WED_IND_REASON,
+					MT_DMA_WED_IND_REASON_OLDPKT));
+	mt76_dma_test_rx_desc(t, q, 3, 40, 3, last | ver, 0);
+	/* an old packet that is a fragment is kept */
+	q->desc[4].buf1 = q->desc[3].buf1;
+	mt76_dma_test_rx_desc(t, q, 4, 40, 4, last | ver,
+			      MT_DMA_INFO_DMA_FRAG);
+	mt76_dma_test_rx_desc(t, q, 5, 40, 5,
+			      last | ver | MT_DMA_CTL_PN_CHK_FAIL, 0);
+	mt76_dma_test_rx_desc(t, q, 6, 40, 6, last | ver, 0);
+	/* without the version bit, the PN check bit means nothing */
+	mt76_dma_test_rx_desc(t, q, 7, 40, 7, last | MT_DMA_CTL_PN_CHK_FAIL,
+			      0);
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 3);
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&t->rx), 3);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_skb_filled(skb_peek(&t->rx),
+							 0, 40, 4));
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_skb_filled(skb_peek_tail(&t->rx),
+							 0, 40, 7));
+	KUNIT_EXPECT_EQ(test, q->tail, 8);
+	KUNIT_EXPECT_EQ(test, q->queued, 15);
+}
