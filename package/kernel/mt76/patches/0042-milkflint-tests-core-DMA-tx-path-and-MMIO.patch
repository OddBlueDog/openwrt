+/* A length the buffer can't hold is dropped; a fragment that long drops
+ * the frame it belongs to. The ring carries on with the next frame.
+ */
+static void mt76_dma_test_rx_process_too_long(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	int max = SKB_WITH_OVERHEAD(MT76_DMA_TEST_BUF_SIZE);
+	struct mt76_queue *q;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, 0);
+	q->buf_offset = 16;
+	mt76_dma_rx_fill(t->dev, q, false);
+
+	mt76_dma_test_rx_frame(t, q, 0, max - 16 + 1, 0);
+	mt76_dma_test_rx_desc(t, q, 1, 100, 1, 0, 0);
+	mt76_dma_test_rx_frame(t, q, 2, MT76_DMA_TEST_BUF_SIZE - 16 + 1, 2);
+	mt76_dma_test_rx_frame(t, q, 3, max - 16, 3);
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 2);
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&t->rx), 1);
+	KUNIT_EXPECT_EQ(test, skb_peek(&t->rx)->len, max - 16);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_skb_filled(skb_peek(&t->rx),
+							 0, max - 16, 3));
+	KUNIT_EXPECT_NULL(test, q->rx_head);
+	KUNIT_EXPECT_EQ(test, q->tail, 4);
+	KUNIT_EXPECT_EQ(test, t->n_rx_check, 1);
+}
+
+/* An skb holds MAX_SKB_FRAGS fragments: a frame of one buffer more is
+ * dropped as a whole.
+ */
+static void mt76_dma_test_rx_process_frag_overflow(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_queue *q;
+	struct sk_buff *skb;
+	int i, n = MAX_SKB_FRAGS + 1;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 64, 0);
+	KUNIT_ASSERT_EQ(test, mt76_dma_rx_fill(t->dev, q, false), 63);
+	KUNIT_ASSERT_LE(test, 2 * n + 1, 63);
+
+	/* head + MAX_SKB_FRAGS fragments: delivered */
+	for (i = 0; i < n; i++)
+		mt76_dma_test_rx_desc(t, q, i, 64, i,
+				      i == n - 1 ? MT_DMA_CTL_LAST_SEC0 : 0, 0);
+	/* head + MAX_SKB_FRAGS + 1 fragments: dropped */
+	for (i = n; i < 2 * n + 1; i++)
+		mt76_dma_test_rx_desc(t, q, i, 64, i,
+				      i == 2 * n ? MT_DMA_CTL_LAST_SEC0 : 0, 0);
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 64), 2);
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&t->rx), 1);
+	skb = skb_peek(&t->rx);
+	KUNIT_EXPECT_EQ(test, skb_shinfo(skb)->nr_frags, MAX_SKB_FRAGS);
+	KUNIT_EXPECT_EQ(test, skb->len, 64 * n);
+	KUNIT_EXPECT_NULL(test, q->rx_head);
+	KUNIT_EXPECT_EQ(test, q->tail, 2 * n + 1);
+}
+
+/* On a WED rx ring each buffer is registered as an rx token, which the
+ * descriptor carries for the hardware, with the buffer handed to the host.
+ */
+static void mt76_dma_test_rx_wed_fill(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+	int i;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, MT_WED_Q_RX(0));
+	KUNIT_EXPECT_EQ(test, mt76_dma_rx_fill(dev, q, false), 7);
+
+	for (i = 0; i < 7; i++) {
+		struct mt76_queue_entry *e = &q->entry[i];
+		u32 buf1 = le32_to_cpu(q->desc[i].buf1);
+		struct mt76_txwi_cache *r;
+
+		KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_TOKEN, buf1), i);
+		KUNIT_EXPECT_TRUE(test, le32_to_cpu(q->desc[i].ctrl) &
+					MT_DMA_CTL_TO_HOST);
+		r = idr_find(&dev->rx_token, i);
+		KUNIT_ASSERT_NOT_NULL(test, r);
+		KUNIT_EXPECT_PTR_EQ(test, e->txwi, r);
+		KUNIT_EXPECT_PTR_EQ(test, r->ptr, e->buf);
+		KUNIT_EXPECT_EQ(test, r->dma_addr, e->dma_addr[0]);
+		KUNIT_EXPECT_EQ(test, r->qid, MT_RXQ_MAIN);
+	}
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(q)->cpu_idx, 7);
+
+	/* a full WED ring is kicked even when nothing was added */
+	mt76_dma_test_qregs(q)->cpu_idx = 0x55;
+	KUNIT_EXPECT_EQ(test, mt76_dma_rx_fill(dev, q, false), 0);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(q)->cpu_idx, 7);
+}
+
+/* Out of rx tokens, the fill stops short and keeps the rxwi it couldn't
+ * register.
+ */
+static void mt76_dma_test_rx_wed_no_tokens(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_queue *q;
+
+	dev->rx_token_size = 3;
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, MT_WED_Q_RX(0));
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_rx_fill(dev, q, false), 3);
+	KUNIT_EXPECT_EQ(test, q->queued, 3);
+	KUNIT_EXPECT_EQ(test, q->head, 3);
+	KUNIT_EXPECT_NULL(test, q->entry[3].buf);
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_qregs(q)->cpu_idx, 3);
+	KUNIT_EXPECT_EQ(test, list_count_nodes(&dev->rxwi_cache), 1);
+}
+
+/* WED completes buffers by token, not by ring slot: the frame is the
+ * token's buffer, whose rxwi is then reused for the refill.
+ */
+static void mt76_dma_test_rx_wed_process(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct mt76_txwi_cache *r3;
+	struct mt76_queue *q;
+	struct sk_buff *skb;
+	void *buf3;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, MT_WED_Q_RX(0));
+	mt76_dma_rx_fill(dev, q, false);
+	buf3 = q->entry[3].buf;
+	r3 = idr_find(&dev->rx_token, 3);
+
+	memset(buf3, 0x5e, 80);
+	dma_sync_single_for_device(dev->dma_dev, q->entry[3].dma_addr[0], 80,
+				   DMA_FROM_DEVICE);
+	q->desc[0].buf1 = cpu_to_le32(FIELD_PREP(MT_DMA_CTL_TOKEN, 3));
+	mt76_dma_test_rx_desc(t, q, 0, 80, 0, MT_DMA_CTL_LAST_SEC0, 0);
+
+	KUNIT_EXPECT_EQ(test, mt76_dma_test_poll(t, q, 16), 1);
+
+	KUNIT_ASSERT_EQ(test, skb_queue_len(&t->rx), 1);
+	skb = skb_peek(&t->rx);
+	KUNIT_EXPECT_PTR_EQ(test, (void *)skb->head, buf3);
+	KUNIT_EXPECT_EQ(test, skb->len, 80);
+	KUNIT_EXPECT_TRUE(test, mt76_dma_test_skb_filled(skb, 0, 80, 0x5e));
+	/* token 3 was released and handed out again, with the same rxwi */
+	KUNIT_EXPECT_PTR_EQ(test, idr_find(&dev->rx_token, 3), r3);
+	KUNIT_EXPECT_PTR_EQ(test, r3->ptr, q->entry[7].buf);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_CTL_TOKEN,
+					le32_to_cpu(q->desc[7].buf1)), 3);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->rxwi_cache));
+	/* slot 0's own buffer is still out with its token */
+	KUNIT_EXPECT_NOT_NULL(test, idr_find(&dev->rx_token, 0));
+}
+
+/* A token the host doesn't know ends the poll there; nothing is passed
