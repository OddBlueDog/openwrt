+/* The NAPI poll processes its own queue and, with budget to spare,
+ * completes NAPI and tells the driver to re-enable the interrupt.
+ */
+static void mt76_dma_test_rx_poll(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct napi_struct *napi;
+	struct mt76_queue *q;
+	int done;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_BAND1, 8, 0);
+	napi = mt76_dma_test_napi(t, MT_RXQ_BAND1);
+	mt76_dma_rx_fill(dev, q, false);
+	mt76_dma_test_rx_frame(t, q, 0, 60, 0);
+	mt76_dma_test_rx_frame(t, q, 1, 61, 1);
+
+	local_bh_disable();
+	KUNIT_ASSERT_TRUE(test, napi_schedule_prep(napi));
+	done = napi->poll(napi, 16);
+	local_bh_enable();
+
+	KUNIT_EXPECT_EQ(test, done, 2);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&t->rx), 2);
+	KUNIT_EXPECT_EQ(test, t->rx_qid, MT_RXQ_BAND1);
+	KUNIT_EXPECT_EQ(test, t->n_poll_complete, 1);
+	KUNIT_EXPECT_EQ(test, t->poll_qid, MT_RXQ_BAND1);
+	KUNIT_EXPECT_FALSE(test, test_bit(NAPI_STATE_SCHED, &napi->state));
+}
+
+/* With the budget used up, NAPI stays scheduled and the interrupt off. */
+static void mt76_dma_test_rx_poll_budget(struct kunit *test)
+{
+	struct mt76_dma_test *t = mt76_dma_test_init(test, NULL);
+	struct mt76_dev *dev = t->dev;
+	struct napi_struct *napi;
+	struct mt76_queue *q;
+	int i, done;
+
+	q = mt76_dma_test_rx_queue(t, MT_RXQ_MAIN, 8, 0);
+	napi = mt76_dma_test_napi(t, MT_RXQ_MAIN);
+	mt76_dma_rx_fill(dev, q, false);
+	for (i = 0; i < 3; i++)
+		mt76_dma_test_rx_frame(t, q, i, 60, i);
+
+	local_bh_disable();
+	KUNIT_ASSERT_TRUE(test, napi_schedule_prep(napi));
+	done = mt76_dma_rx_poll(napi, 2);
+	KUNIT_EXPECT_EQ(test, done, 2);
+	KUNIT_EXPECT_EQ(test, t->n_poll_complete, 0);
+	KUNIT_EXPECT_TRUE(test, test_bit(NAPI_STATE_SCHED, &napi->state));
+	/* the next round finishes */
+	done = mt76_dma_rx_poll(napi, 2);
+	local_bh_enable();
+
+	KUNIT_EXPECT_EQ(test, done, 1);
+	KUNIT_EXPECT_EQ(test, t->n_poll_complete, 1);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(&t->rx), 3);
+}
