index 73d47608..350cb42a 100644
--- a/mmio.c
+++ b/mmio.c
@@ -126,3 +126,7 @@ void mt76_mmio_init(struct mt76_dev *dev, void __iomem *regs)
 	spin_lock_init(&dev->mmio.irq_lock);
 }
 EXPORT_SYMBOL_GPL(mt76_mmio_init);
