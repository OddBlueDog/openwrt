+/* The radio's limits: what's outside them gets terms that are inside, which the
+ * device's next request can take up, and nothing is agreed until then.
+ */
+static void mt7915_test_twt_policy(struct kunit *test)
+{
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct mt7915_dev *dev = env->dev;
+	struct mt7915_phy *phy = &dev->phy;
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_vif *mvif = mt7915_test_vif(test, dev, 1);
+	struct mt7915_sta *a = mt7915_test_sta(test, dev, 9, mvif);
+	struct mt7915_sta *b = mt7915_test_sta(test, dev, 10, mvif);
+	struct ieee80211_sta *sta = mt7915_test_to_sta(a);
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_twt_setup *twt;
+	struct ieee80211_twt_params *p;
+	u8 exp;
+
+	mt7915_test_tsf(dev, 1 << 30);
+
+	/* longer than the limit: as near it as the fields can say */
+	phy->twt_policy.max_interval_ms = 60000;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 20, 1024, 64, 0);
+	p = mt7915_test_twt_params(twt);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ALTERNATE);
+	exp = le16_get_bits(p->req_type, IEEE80211_TWT_REQTYPE_WAKE_INT_EXP);
+	KUNIT_EXPECT_LE(test, (u64)le16_to_cpu(p->mantissa) << exp, 60000000);
+	KUNIT_EXPECT_GT(test, (u64)le16_to_cpu(p->mantissa) << exp, 59999000);
+	KUNIT_EXPECT_NE(test, le64_to_cpu(p->twt), 0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	phy->twt_policy.max_interval_ms = 0;
+
+	/* shorter than the limit: at least the limit; demanded, so dictated */
+	phy->twt_policy.min_interval_ms = 500;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_DEMAND, 10, 100, 64, 0);
+	p = mt7915_test_twt_params(twt);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_DICTATE);
+	exp = le16_get_bits(p->req_type, IEEE80211_TWT_REQTYPE_WAKE_INT_EXP);
+	KUNIT_EXPECT_GE(test, (u64)le16_to_cpu(p->mantissa) << exp, 500000);
+	KUNIT_EXPECT_LE(test, (u64)le16_to_cpu(p->mantissa) << exp, 500100);
+	phy->twt_policy.min_interval_ms = 0;
+
+	/* the wake duration the radio asks for, not just the firmware's */
+	phy->twt_policy.min_wake_dur = 100;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64, 0);
+	p = mt7915_test_twt_params(twt);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ALTERNATE);
+	KUNIT_EXPECT_EQ(test, p->min_twt_dur, 100);
+	phy->twt_policy.min_wake_dur = 0;
+
+	/* raising the duration past the interval takes the interval with it */
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 0, 8192, 16, 0);
+	p = mt7915_test_twt_params(twt);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ALTERNATE);
+	exp = le16_get_bits(p->req_type, IEEE80211_TWT_REQTYPE_WAKE_INT_EXP);
+	KUNIT_EXPECT_GT(test, (u64)le16_to_cpu(p->mantissa) << exp,
+			MT7915_MIN_TWT_DUR << 8);
+
+	/* trigger-enabled: offered without, when the radio says never */
+	phy->twt_policy.trigger = MT7915_TWT_TRIGGER_NEVER;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64,
+				  IEEE80211_TWT_REQTYPE_TRIGGER);
+	p = mt7915_test_twt_params(twt);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ALTERNATE);
+	KUNIT_EXPECT_FALSE(test, le16_to_cpu(p->req_type) &
+			   IEEE80211_TWT_REQTYPE_TRIGGER);
+	phy->twt_policy.trigger = MT7915_TWT_TRIGGER_ALLOW;
+
+	/* the same terms without it are accepted */
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64, 0);
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_ACCEPT);
+	KUNIT_EXPECT_EQ(test, a->twt.flowid_mask, BIT(0));
+
+	/* the limits on how many */
+	phy->twt_policy.max_sta_flows = 1;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64,
+				  FIELD_PREP(IEEE80211_TWT_REQTYPE_FLOWID, 1));
+	mt7915_mac_add_twt_setup(hw, sta, twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_REJECT);
+	phy->twt_policy.max_sta_flows = 0;
+
+	phy->twt_policy.max_flows = 1;
+	twt = mt7915_test_twt_req(test, TWT_SETUP_CMD_REQUEST, 10, 1024, 64, 0);
+	mt7915_mac_add_twt_setup(hw, mt7915_test_to_sta(b), twt);
+	KUNIT_EXPECT_EQ(test, mt7915_test_twt_answer(twt), TWT_SETUP_CMD_REJECT);
+	phy->twt_policy.max_flows = 0;
+	KUNIT_EXPECT_EQ(test, b->twt.flowid_mask, 0);
+
+	KUNIT_EXPECT_EQ(test, phy->twt_counters.alternate, 4);
+	KUNIT_EXPECT_EQ(test, phy->twt_counters.dictate, 1);
+	KUNIT_EXPECT_EQ(test, phy->twt_counters.accepted, 1);
+	KUNIT_EXPECT_EQ(test, phy->twt_counters.rejected, 2);
+}
+
+/* The first wake time the device can still make, in phase */
+static void mt7915_test_twt_next_tsf(struct kunit *test)
+{
+	/* still ahead: as it is */
+	KUNIT_EXPECT_EQ(test, mt7915_mac_twt_next_tsf(1000, 50000, 1000), 50000);
+	/* past: on its phase */
+	KUNIT_EXPECT_EQ(test, mt7915_mac_twt_next_tsf(1000000, 500, 102400),
+			500 + 10 * 102400);
+	/* a boundary closer than the lead is skipped */
+	KUNIT_EXPECT_EQ(test, mt7915_mac_twt_next_tsf(1024000 - 5000, 0, 102400),
+			11 * 102400);
+	KUNIT_EXPECT_EQ(test,
+			mt7915_mac_twt_next_tsf(1024000 - MT7915_TWT_MIN_LEAD_US,
+						0, 102400),
+			1024000);
+	/* ahead, but closer than the lead */
+	KUNIT_EXPECT_EQ(test, mt7915_mac_twt_next_tsf(1000, 2000, 102400),
+			2000 + 102400);
+}
