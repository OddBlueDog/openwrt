+/* The frame that tells a device an agreement is over */
+static void mt7915_test_twt_teardown_frame(struct kunit *test)
+{
+	static const u8 da[ETH_ALEN] = { 2, 0, 0, 0, 0, 9 };
+	static const u8 sa[ETH_ALEN] = { 2, 0, 0, 0, 0, 1 };
+	struct mt7915_test_env *env = mt7915_test_env(test);
+	struct ieee80211_mgmt *mgmt;
+	struct sk_buff *skb;
+
+	skb = mt7915_mac_twt_teardown_skb(env->dev->mt76.hw, da, sa, 3);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	mgmt = (void *)skb->data;
+	KUNIT_EXPECT_EQ(test, skb->len, IEEE80211_MIN_ACTION_SIZE + 2);
+	KUNIT_EXPECT_TRUE(test, ieee80211_is_action(mgmt->frame_control));
+	KUNIT_EXPECT_MEMEQ(test, mgmt->da, da, ETH_ALEN);
+	KUNIT_EXPECT_MEMEQ(test, mgmt->sa, sa, ETH_ALEN);
+	KUNIT_EXPECT_MEMEQ(test, mgmt->bssid, sa, ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, mgmt->u.action.category, WLAN_CATEGORY_S1G);
+	KUNIT_EXPECT_EQ(test, mgmt->u.action.u.s1g.action_code,
+			WLAN_S1G_TWT_TEARDOWN);
+	KUNIT_EXPECT_EQ(test, mgmt->u.action.u.s1g.variable[0], 3);
+	KUNIT_EXPECT_TRUE(test, IEEE80211_SKB_CB(skb)->flags &
+			  IEEE80211_TX_INTFL_DONT_ENCRYPT);
+	KUNIT_EXPECT_EQ(test, skb_get_queue_mapping(skb), IEEE80211_AC_VO);
+	kfree_skb(skb);
 }
 
