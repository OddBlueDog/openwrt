diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
index d362622b..54d69405 100644
--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -1413,6 +1413,227 @@ static const struct file_operations mt7915_spatial_reuse_fops = {
 	.llseek = default_llseek,
 };
 
+static const char * const mt7915_twt_trigger_names[] = {
+	[MT7915_TWT_TRIGGER_ALLOW] = "allow",
+	[MT7915_TWT_TRIGGER_NEVER] = "never",
+};
+
+static int mt7915_twt_policy_show(struct seq_file *s, void *data)
+{
+	struct mt7915_phy *phy = s->private;
+	struct mt7915_dev *dev = phy->dev;
+	const struct mt7915_twt_policy *pol = &phy->twt_policy;
+
+	mutex_lock(&dev->mt76.mutex);
+	seq_printf(s, "min_interval_ms %u\n", pol->min_interval_ms);
+	seq_printf(s, "max_interval_ms %u\n", pol->max_interval_ms);
+	seq_printf(s, "min_wake_dur %u\n",
+		   max_t(u32, pol->min_wake_dur, MT7915_MIN_TWT_DUR));
+	seq_printf(s, "max_flows %u\n", pol->max_flows ?: MT7915_MAX_TWT_AGRT);
+	seq_printf(s, "max_sta_flows %u\n",
+		   pol->max_sta_flows ?: MT7915_MAX_STA_TWT_AGRT);
+	seq_printf(s, "trigger %s\n", mt7915_twt_trigger_names[pol->trigger]);
+	mutex_unlock(&dev->mt76.mutex);
+
+	return 0;
+}
+
+static int mt7915_twt_policy_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, mt7915_twt_policy_show, inode->i_private);
+}
+
+/* One setting per write, "<name> <value>": what's asked from now on. It leaves
+ * the agreements devices have, which twt_teardown can end.
+ */
+int mt7915_twt_policy_set(struct mt7915_phy *phy, const char *buf)
+{
+	struct mt7915_twt_policy *pol = &phy->twt_policy;
+	char name[16], value[8];
+	u32 val = 0;
+	int ret = 0, i;
+
+	if (sscanf(buf, "%15s %7s", name, value) != 2)
+		return -EINVAL;
+
+	if (!strcmp(name, "trigger")) {
+		i = match_string(mt7915_twt_trigger_names,
+				 ARRAY_SIZE(mt7915_twt_trigger_names), value);
+		if (i < 0)
+			return -EINVAL;
+		val = i;
+	} else if (sscanf(buf, "%*s %u", &val) != 1) {
+		return -EINVAL;
+	}
+
+	mutex_lock(&phy->dev->mt76.mutex);
+	if (!strcmp(name, "min_interval_ms")) {
+		if (val > 3600000 || (pol->max_interval_ms && val > pol->max_interval_ms))
+			ret = -ERANGE;
+		else
+			pol->min_interval_ms = val;
+	} else if (!strcmp(name, "max_interval_ms")) {
+		if (val > 3600000 || (val && val < pol->min_interval_ms))
+			ret = -ERANGE;
+		else
+			pol->max_interval_ms = val;
+	} else if (!strcmp(name, "min_wake_dur")) {
+		if (val < MT7915_MIN_TWT_DUR || val > U8_MAX)
+			ret = -ERANGE;
+		else
+			pol->min_wake_dur = val;
+	} else if (!strcmp(name, "max_flows")) {
+		if (!val || val > MT7915_MAX_TWT_AGRT)
+			ret = -ERANGE;
+		else
+			pol->max_flows = val;
+	} else if (!strcmp(name, "max_sta_flows")) {
+		if (!val || val > MT7915_MAX_STA_TWT_AGRT)
+			ret = -ERANGE;
+		else
+			pol->max_sta_flows = val;
+	} else if (!strcmp(name, "trigger")) {
+		pol->trigger = val;
+	} else {
+		ret = -EINVAL;
+	}
+	mutex_unlock(&phy->dev->mt76.mutex);
+
+	return ret;
+}
+
+static ssize_t
+mt7915_twt_policy_write(struct file *file, const char __user *userbuf,
+			size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	char buf[32];
+	int ret;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, userbuf, count))
+		return -EFAULT;
+	buf[count] = 0;
+
+	ret = mt7915_twt_policy_set(s->private, buf);
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations mt7915_twt_policy_fops = {
+	.open = mt7915_twt_policy_open,
+	.read = seq_read,
+	.write = mt7915_twt_policy_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+/* What the radio has agreed to and how requests have gone, a line each, for
+ * Wi-Fi's page
+ */
+static int mt7915_twt_status_show(struct seq_file *s, void *data)
+{
+	struct mt7915_phy *phy = s->private;
+	struct mt7915_dev *dev = phy->dev;
+	const struct mt7915_twt_counters *c = &phy->twt_counters;
+	struct mt7915_twt_flow *flow;
+
+	mutex_lock(&dev->mt76.mutex);
+	seq_printf(s,
+		   "counters accepted=%u repeated=%u replaced=%u alternate=%u dictate=%u rejected=%u teardown_rx=%u teardown_tx=%u lost=%u\n",
+		   c->accepted, c->repeated, c->replaced, c->alternate,
+		   c->dictate, c->rejected, c->teardown_rx, c->teardown_tx,
+		   c->lost);
+	list_for_each_entry(flow, &dev->twt_list, list) {
+		struct mt7915_sta *msta;
+		struct ieee80211_sta *sta;
+
+		if (flow->band_idx != phy->mt76->band_idx)
+			continue;
+
+		msta = container_of(flow - flow->id, struct mt7915_sta,
+				    twt.flow[0]);
+		sta = container_of((void *)msta, struct ieee80211_sta, drv_priv);
+		seq_printf(s,
+			   "flow sta=%pM id=%u interval_us=%llu wake_us=%u trigger=%u announced=%u protection=%u tsf=%llu age_s=%u\n",
+			   sta->addr, flow->id,
+			   (u64)le16_to_cpu(flow->mantissa) << flow->exp,
+			   flow->duration << 8, flow->trigger, !flow->flowtype,
+			   flow->protection, flow->tsf,
+			   jiffies_to_msecs(jiffies - flow->created) / 1000);
+	}
+	mutex_unlock(&dev->mt76.mutex);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mt7915_twt_status);
+
+/* "<mac> <flow id|all>": ends agreements and tells the device */
+static ssize_t
+mt7915_twt_teardown_handler(struct wiphy *wiphy, struct file *file, char *buf,
+			    size_t count, void *data)
+{
+	struct mt7915_phy *phy = data;
+	struct mt7915_dev *dev = phy->dev;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	u8 addr[ETH_ALEN];
+	char which[4];
+	unsigned long mask;
+	unsigned int id;
+	int i;
+
+	if (sscanf(buf, "%hhx:%hhx:%hhx:%hhx:%hhx:%hhx %3s", &addr[0], &addr[1],
+		   &addr[2], &addr[3], &addr[4], &addr[5], which) != 7)
+		return -EINVAL;
+
+	sta = ieee80211_find_sta_by_ifaddr(phy->mt76->hw, addr, NULL);
+	if (!sta)
+		return -ENOENT;
+	msta = (struct mt7915_sta *)sta->drv_priv;
+
+	mutex_lock(&dev->mt76.mutex);
+	if (!strcmp(which, "all")) {
+		mask = msta->twt.flowid_mask;
+	} else if (!kstrtouint(which, 10, &id) &&
+		   id < MT7915_MAX_STA_TWT_AGRT) {
+		mask = msta->twt.flowid_mask & BIT(id);
+	} else {
+		mutex_unlock(&dev->mt76.mutex);
+		return -EINVAL;
+	}
+	for_each_set_bit(i, &mask, MT7915_MAX_STA_TWT_AGRT)
+		mt7915_mac_twt_teardown_flow(dev, msta, i);
+	mutex_unlock(&dev->mt76.mutex);
+
+	if (!mask)
+		return -ENOENT;
+
+	for_each_set_bit(i, &mask, MT7915_MAX_STA_TWT_AGRT)
+		mt7915_mac_twt_send_teardown(phy, sta, i);
+
+	return count;
+}
+
+static ssize_t
+mt7915_twt_teardown_write(struct file *file, const char __user *userbuf,
+			  size_t count, loff_t *ppos)
+{
+	struct mt7915_phy *phy = file->private_data;
+	char buf[32];
+
+	return wiphy_locked_debugfs_write(phy->mt76->hw->wiphy, file, buf,
+					  sizeof(buf), userbuf, count,
+					  mt7915_twt_teardown_handler, phy);
+}
+
+static const struct file_operations mt7915_twt_teardown_fops = {
+	.open = simple_open,
+	.write = mt7915_twt_teardown_write,
+	.llseek = default_llseek,
+};
+
 int mt7915_init_debugfs(struct mt7915_phy *phy)
 {
 	struct mt7915_dev *dev = phy->dev;
@@ -1449,6 +1670,10 @@ int mt7915_init_debugfs(struct mt7915_phy *phy)
 	debugfs_create_file("rf_regval", 0600, dir, dev, &fops_rf_regval);
 	debugfs_create_file("spatial_reuse", 0600, dir, phy,
 			    &mt7915_spatial_reuse_fops);
+	debugfs_create_file("twt_policy", 0600, dir, phy, &mt7915_twt_policy_fops);
+	debugfs_create_file("twt_status", 0400, dir, phy, &mt7915_twt_status_fops);
+	debugfs_create_file("twt_teardown", 0200, dir, phy,
+			    &mt7915_twt_teardown_fops);
 	debugfs_create_u32("rx_event_frags", 0400, dir, &dev->rx_event_frags);
 	if (!is_mt7915(&dev->mt76))
 		debugfs_create_file("vow_atf", 0600, dir, dev, &fops_vow_atf);
diff --git a/mt7915/init.c b/mt7915/init.c
index 376a84c1..ddad4349 100644
--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -404,6 +404,11 @@ mt7915_init_wiphy(struct mt7915_phy *phy)
 	struct wiphy *wiphy = hw->wiphy;
 	struct mt7915_dev *dev = phy->dev;
 
+	/* devices that sleep longer than this miss what keeps them on the
+	 * network: hostapd's inactivity poll and group rekey
+	 */
+	phy->twt_policy.max_interval_ms = 60000;
+
 	hw->queues = 4;
 	hw->max_rx_aggregation_subframes = IEEE80211_MAX_AMPDU_BUF_HE;
 	hw->max_tx_aggregation_subframes = IEEE80211_MAX_AMPDU_BUF_HE;
diff --git a/mt7915/mac.c b/mt7915/mac.c
index 1014830e..e4978b2e 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1531,6 +1531,8 @@ static void mt7915_mac_twt_reset(struct mt7915_dev *dev)
 		msta = container_of(flow - flow->id, struct mt7915_sta,
 				    twt.flow[0]);
 		msta->twt.flowid_mask &= ~BIT(flow->id);
+		/* the device still sleeps by it: reconfig_complete tells it */
+		msta->twt.lost_mask |= BIT(flow->id);
 		list_del_init(&flow->list);
 	}
 
@@ -2402,101 +2404,198 @@ mt7915_mac_twt_duration_align(int duration)
 	return duration << 8;
 }
 
+/* Where a new flow's wake period goes: the first gap long enough among its
+ * band's flows, in start order. A band's TSF is its own, so another band's
+ * flows are no reason to move. Offsets only keep wake periods apart for flows
+ * whose intervals are multiples of each other; the others meet now and then,
+ * which is allowed.
+ */
 static u64
 mt7915_mac_twt_sched_list_add(struct mt7915_dev *dev,
 			      struct mt7915_twt_flow *flow)
 {
-	struct mt7915_twt_flow *iter, *iter_next;
-	u32 duration = flow->duration << 8;
-	u64 start_tsf;
-
-	iter = list_first_entry_or_null(&dev->twt_list,
-					struct mt7915_twt_flow, list);
-	if (!iter || !iter->sched || iter->start_tsf > duration) {
-		/* add flow as first entry in the list */
-		list_add(&flow->list, &dev->twt_list);
-		return 0;
-	}
+	struct mt7915_twt_flow *iter, *pos = NULL;
+	u32 duration = mt7915_mac_twt_duration_align(flow->duration);
+	u64 start_tsf = 0;
 
-	list_for_each_entry_safe(iter, iter_next, &dev->twt_list, list) {
-		start_tsf = iter->start_tsf +
-			    mt7915_mac_twt_duration_align(iter->duration);
-		if (list_is_last(&iter->list, &dev->twt_list))
+	list_for_each_entry(iter, &dev->twt_list, list) {
+		if (!iter->sched || iter->band_idx != flow->band_idx)
+			continue;
+		if (iter->start_tsf > start_tsf + duration)
 			break;
 
-		if (!iter_next->sched ||
-		    iter_next->start_tsf > start_tsf + duration) {
-			list_add(&flow->list, &iter->list);
-			goto out;
-		}
+		start_tsf = iter->start_tsf +
+			    mt7915_mac_twt_duration_align(iter->duration);
+		pos = iter;
 	}
 
-	/* add flow as last entry in the list */
-	list_add_tail(&flow->list, &dev->twt_list);
-out:
+	list_add(&flow->list, pos ? &pos->list : &dev->twt_list);
+
 	return start_tsf;
 }
 
+/* A request's wake duration in the firmware's unit of 256 us (1 TU is 4) */
+static u32 mt7915_mac_twt_req_dur(struct ieee80211_twt_setup *twt)
+{
+	struct ieee80211_twt_params *twt_agrt = (void *)twt->params;
+	u32 dur = twt_agrt->min_twt_dur;
+
+	return twt->control & IEEE80211_TWT_CONTROL_WAKE_DUR_UNIT ? dur * 4 : dur;
+}
+
+static u64 mt7915_mac_twt_req_interval(struct ieee80211_twt_params *twt_agrt)
+{
+	u8 exp = FIELD_GET(IEEE80211_TWT_REQTYPE_WAKE_INT_EXP,
+			   le16_to_cpu(twt_agrt->req_type));
+
+	return (u64)le16_to_cpu(twt_agrt->mantissa) << exp;
+}
+
+/* The nearest interval the fields can hold on the side the limit needs */
+static void mt7915_mac_twt_set_interval(struct ieee80211_twt_params *twt_agrt,
+					u64 interval, bool round_up)
+{
+	u64 mantissa = interval;
+	u8 exp = 0;
+
+	while (mantissa > U16_MAX) {
+		exp++;
+		mantissa = interval >> exp;
+		if (round_up && mantissa << exp < interval)
+			mantissa++;
+	}
+
+	twt_agrt->mantissa = cpu_to_le16(mantissa);
+	twt_agrt->req_type &= ~cpu_to_le16(IEEE80211_TWT_REQTYPE_WAKE_INT_EXP);
+	twt_agrt->req_type |=
+		le16_encode_bits(exp, IEEE80211_TWT_REQTYPE_WAKE_INT_EXP);
+}
+
 static int mt7915_mac_check_twt_req(struct ieee80211_twt_setup *twt)
 {
 	struct ieee80211_twt_params *twt_agrt;
 	u64 interval, duration;
-	u16 mantissa;
-	u8 exp;
 
 	/* only individual agreement supported */
 	if (twt->control & IEEE80211_TWT_CONTROL_NEG_TYPE_BROADCAST)
 		return -EOPNOTSUPP;
 
-	/* only 256us unit supported */
-	if (twt->control & IEEE80211_TWT_CONTROL_WAKE_DUR_UNIT)
-		return -EOPNOTSUPP;
-
 	twt_agrt = (struct ieee80211_twt_params *)twt->params;
 
 	/* explicit agreement not supported */
 	if (!(twt_agrt->req_type & cpu_to_le16(IEEE80211_TWT_REQTYPE_IMPLICIT)))
 		return -EOPNOTSUPP;
 
-	exp = FIELD_GET(IEEE80211_TWT_REQTYPE_WAKE_INT_EXP,
-			le16_to_cpu(twt_agrt->req_type));
-	mantissa = le16_to_cpu(twt_agrt->mantissa);
-	duration = twt_agrt->min_twt_dur << 8;
+	duration = (u64)mt7915_mac_twt_req_dur(twt) << 8;
 
 	/* a station awake for its whole interval never sleeps */
-	interval = (u64)mantissa << exp;
+	interval = mt7915_mac_twt_req_interval(twt_agrt);
 	if (!interval || interval <= duration)
 		return -EOPNOTSUPP;
 
 	return 0;
 }
 
+/* Brings a request within the radio's policy; true if that changed it */
+static bool mt7915_mac_twt_apply_policy(struct mt7915_phy *phy,
+					struct ieee80211_twt_setup *twt)
+{
+	struct ieee80211_twt_params *twt_agrt = (void *)twt->params;
+	const struct mt7915_twt_policy *pol = &phy->twt_policy;
+	bool in_tu = twt->control & IEEE80211_TWT_CONTROL_WAKE_DUR_UNIT;
+	u32 dur = mt7915_mac_twt_req_dur(twt);
+	u32 floor = max_t(u32, pol->min_wake_dur, MT7915_MIN_TWT_DUR);
+	u64 interval = mt7915_mac_twt_req_interval(twt_agrt);
+	u64 limit;
+	bool changed = false;
+
+	if (dur < floor || dur > U8_MAX) {
+		dur = clamp_t(u32, dur, floor, U8_MAX);
+		twt_agrt->min_twt_dur = in_tu ? DIV_ROUND_UP(dur, 4) : dur;
+		if (twt_agrt->min_twt_dur * (in_tu ? 4 : 1) > U8_MAX)
+			twt_agrt->min_twt_dur = U8_MAX / 4;
+		dur = mt7915_mac_twt_req_dur(twt);
+		changed = true;
+	}
+
+	limit = (u64)pol->max_interval_ms * USEC_PER_MSEC;
+	if (limit && interval > limit) {
+		interval = limit;
+		mt7915_mac_twt_set_interval(twt_agrt, interval, false);
+		changed = true;
+	}
+
+	limit = (u64)pol->min_interval_ms * USEC_PER_MSEC;
+	/* and it still has to leave the device time to sleep */
+	limit = max_t(u64, limit, ((u64)dur << 8) + 1);
+	if (interval < limit) {
+		mt7915_mac_twt_set_interval(twt_agrt, limit, true);
+		changed = true;
+	}
+
+	if ((twt_agrt->req_type & cpu_to_le16(IEEE80211_TWT_REQTYPE_TRIGGER)) &&
+	    pol->trigger == MT7915_TWT_TRIGGER_NEVER) {
+		twt_agrt->req_type &= ~cpu_to_le16(IEEE80211_TWT_REQTYPE_TRIGGER);
+		changed = true;
+	}
+
+	return changed;
+}
+
+/* The same agreement as one the station has. It asks again when our answer
+ * was lost, and the answer to that is the same answer.
+ */
 static bool
-mt7915_mac_twt_param_equal(struct mt7915_sta *msta,
-			   struct ieee80211_twt_params *twt_agrt)
+mt7915_mac_twt_param_equal(struct mt7915_twt_flow *f,
+			   struct ieee80211_twt_setup *twt,
+			   enum ieee80211_twt_setup_cmd cmd, u64 interval)
 {
+	struct ieee80211_twt_params *twt_agrt = (void *)twt->params;
 	u16 type = le16_to_cpu(twt_agrt->req_type);
-	u8 exp;
-	int i;
+	u8 exp = FIELD_GET(IEEE80211_TWT_REQTYPE_WAKE_INT_EXP, type);
+	u64 rem;
+
+	/* a demanded time is part of the terms, as a phase of the interval */
+	if (cmd == TWT_SETUP_CMD_DEMAND) {
+		div64_u64_rem(le64_to_cpu(twt_agrt->twt) - f->tsf, interval, &rem);
+		if (rem)
+			return false;
+	}
+
+	return f->duration == mt7915_mac_twt_req_dur(twt) &&
