+/* Whether the driver holds a dozing station's frames. Switched off, every event
+ * wakes the station: none stays held. A station with a TWT agreement stays out
+ * of it: the firmware reports it as dozing for as long as the agreement lasts,
+ * whatever it's doing, and sends its frames only in its wake periods, so they
+ * have to be in the firmware by then rather than here.
+ */
+static bool mt7915_mcu_sta_ps_hold(struct mt7915_sta *msta, bool dozing)
+{
+	return READ_ONCE(ps_sync) && dozing && !READ_ONCE(msta->twt.flowid_mask);
+}
