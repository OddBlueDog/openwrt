+/* twt_status: a radio's own agreements, in the terms the page shows */
+static void mt7915_debugfs_test_twt_status(struct kunit *test)
+{
+	struct mt7915_debugfs_test_twt *t;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	struct mt7915_twt_flow *flow;
+	struct mt7915_phy *phy;
+	struct mt76_phy *mphy;
+	struct mt7915_dev *dev;
+
+	dev = kunit_kzalloc(test, sizeof(*dev), GFP_KERNEL);
+	phy = kunit_kzalloc(test, sizeof(*phy), GFP_KERNEL);
+	mphy = kunit_kzalloc(test, sizeof(*mphy), GFP_KERNEL);
+	t = kunit_kzalloc(test, sizeof(*t), GFP_KERNEL);
+	sta = kunit_kzalloc(test, sizeof(*sta) + sizeof(*msta), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	KUNIT_ASSERT_NOT_NULL(test, mphy);
+	KUNIT_ASSERT_NOT_NULL(test, t);
+	KUNIT_ASSERT_NOT_NULL(test, sta);
+
+	mutex_init(&dev->mt76.mutex);
+	INIT_LIST_HEAD(&dev->twt_list);
+	phy->dev = dev;
+	phy->mt76 = mphy;
+	mphy->band_idx = 1;
+	phy->twt_counters.accepted = 4;
+	phy->twt_counters.lost = 2;
+	eth_broadcast_addr(sta->addr);
+	msta = (void *)sta->drv_priv;
+
+	flow = &msta->twt.flow[3];
+	flow->id = 3;
+	flow->band_idx = 1;
+	flow->mantissa = cpu_to_le16(1000);
+	flow->exp = 2;
+	flow->duration = 64;
+	flow->flowtype = 1;
+	flow->tsf = 77;
+	flow->created = jiffies;
+	list_add_tail(&flow->list, &dev->twt_list);
+
+	/* another radio's isn't listed */
+	msta->twt.flow[1].id = 1;
+	msta->twt.flow[1].band_idx = 0;
+	list_add_tail(&msta->twt.flow[1].list, &dev->twt_list);
+
+	t->s.buf = t->buf;
+	t->s.size = sizeof(t->buf);
+	t->s.private = phy;
+	KUNIT_EXPECT_EQ(test, mt7915_twt_status_show(&t->s, NULL), 0);
+	t->buf[min(t->s.count, sizeof(t->buf) - 1)] = 0;
+	KUNIT_EXPECT_NOT_NULL(test, strstr(t->buf, "counters accepted=4 "));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(t->buf, " lost=2\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(t->buf,
+		"flow sta=ff:ff:ff:ff:ff:ff id=3 interval_us=4000 wake_us=16384 trigger=0 announced=0 protection=0 tsf=77 age_s=0\n"));
+	KUNIT_EXPECT_NULL(test, strstr(t->buf, "id=1 "));
+}
