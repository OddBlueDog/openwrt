+/* A teardown frame's octet comes as it is. Its low bits are the flow, bit 7 means
+ * all of them, and an agreement of another negotiation type isn't one of these:
+ * a device that said "all" and kept an agreement here would be sent to on its
+ * schedule while it's awake waiting.
+ */
+static void mt7915_main_test_twt_teardown_octet(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	int i;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	for (i = 0; i < 3; i++) {
+		msta->twt.flow[i].id = i;
+		msta->twt.flow[i].table_id = i;
+		msta->twt.flowid_mask |= BIT(i);
+		dev->twt.table_mask |= BIT(i);
+		dev->twt.n_agrt++;
+		list_add_tail(&msta->twt.flow[i].list, &dev->twt_list);
+	}
+	mt7915_main_test_clear(fake);
+
+	/* another negotiation type: not ours */
+	mt7915_twt_teardown_request(hw, sta, BIT(5) | 1);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	KUNIT_EXPECT_EQ(test, msta->twt.flowid_mask, GENMASK(2, 0));
+
+	/* reserved bits don't change which flow it is */
+	mt7915_twt_teardown_request(hw, sta, BIT(3) | 1);
+	KUNIT_EXPECT_EQ(test, msta->twt.flowid_mask, BIT(0) | BIT(2));
+
+	mt7915_twt_teardown_request(hw, sta, MT7915_TWT_TEARDOWN_ALL);
+	KUNIT_EXPECT_EQ(test, msta->twt.flowid_mask, 0);
+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 0);
+	KUNIT_EXPECT_EQ(test, dev->twt.table_mask, 0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->twt_list));
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 3);
+}
