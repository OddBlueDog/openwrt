+/* A station with a TWT agreement isn't held: its frames have to be in the
+ * firmware for its wake periods, which it doesn't announce. One held when the
+ * agreement begins is let go, and one dozing when the last one ends is held.
+ */
+static void mt7915_mcu2_events_ps_sync_twt(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct ieee80211_vif *vif = mt7915_mcu2_vif(test, dev);
+	struct mt7915_sta *msta;
+
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_mcu2_ps_sync_default, NULL), 0);
+	ps_sync = true;
+
+	msta = (void *)mt7915_mcu2_sta(test, vif, 0x23)->drv_priv;
+	rcu_assign_pointer(dev->mt76.wcid[0x23], &msta->wcid);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_mcu2_drop_wcids, dev), 0);
+
+	mt7915_mcu2_ps_event(test, dev, 0x23, true);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_PS, &msta->wcid.flags));
+
+	msta->twt.flowid_mask = BIT(0);
+	mt7915_mcu_sta_ps_update(dev, msta);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &msta->wcid.flags));
+
+	/* its PM bit goes on changing, and the frames stay out of it */
+	mt7915_mcu2_ps_event(test, dev, 0x23, false);
+	mt7915_mcu2_ps_event(test, dev, 0x23, true);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &msta->wcid.flags));
+	KUNIT_EXPECT_TRUE(test, msta->ps.dozing);
+
+	msta->twt.flowid_mask = 0;
+	mt7915_mcu_sta_ps_update(dev, msta);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_PS, &msta->wcid.flags));
+
+	/* nothing to change: no transition, so no worker kicked for nothing */
+	mt7915_mcu_sta_ps_update(dev, msta);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_PS, &msta->wcid.flags));
+
+	mt7915_mcu2_ps_event(test, dev, 0x23, false);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &msta->wcid.flags));
+}
