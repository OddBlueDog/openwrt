+/* An NVMEM cell whose provider can't read it: its error. */
+static void mt76_eeprom_test_nvmem_read_error(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_eeprom_test_dev(test);
+	struct device_node *np = mt76_eeprom_test_of(test, dev);
+	struct device_node *live = mt76_eeprom_test_live(test);
+	u8 buf[16];
+
+	mt76_eeprom_test_provider(test, dev, live, NULL, 32, 16);
+	MT76_EEPROM_TEST_CELLS(test, np, "nvmem-cells", live->phandle);
+	MT76_EEPROM_TEST_STRS(test, np, "nvmem-cell-names", "eeprom");
+	KUNIT_EXPECT_EQ(test, mt76_get_of_data_from_nvmem(dev, buf, "eeprom",
+			16), -EIO);
+}
+
 /* An EEPROM cell whose NVMEM provider hasn't probed yet must defer the
  * probe, not be taken for "no EEPROM in the device tree".
  */
@@ -979,6 +1002,7 @@ static struct kunit_case mt76_eeprom_test_cases[] = {
 	KUNIT_CASE(mt76_eeprom_test_mtd_short_property),
 	KUNIT_CASE(mt76_eeprom_test_nvmem),
 	KUNIT_CASE(mt76_eeprom_test_nvmem_cell),
+	KUNIT_CASE(mt76_eeprom_test_nvmem_read_error),
 	KUNIT_CASE(mt76_eeprom_test_init_nvmem_defer),
 	KUNIT_CASE(mt76_eeprom_test_override_no_dt),
 	KUNIT_CASE(mt76_eeprom_test_override_dt),
