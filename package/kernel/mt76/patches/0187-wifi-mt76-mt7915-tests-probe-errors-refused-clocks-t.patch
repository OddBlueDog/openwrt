@@ -1711,7 +1730,8 @@ mt7915_soc_test_probe_env(struct kunit *test)
 }
 
 static struct platform_device *
-mt7915_soc_test_probe_pdev(struct kunit *test, struct mt7915_soc_test_probe *p)
+__mt7915_soc_test_probe_pdev(struct kunit *test,
+			     struct mt7915_soc_test_probe *p, bool irq)
 {
 	struct resource res[] = {
 		DEFINE_RES_MEM(0x0c000000, SZ_8M),
@@ -1723,7 +1743,7 @@ mt7915_soc_test_probe_pdev(struct kunit *test, struct mt7915_soc_test_probe *p)
 
 	pdev = platform_device_register_simple("mt7915e-soc-test",
 					       MT7915_SOC_TEST_PROBE_ID, res,
-					       ARRAY_SIZE(res));
+					       ARRAY_SIZE(res) - !irq);
 	KUNIT_ASSERT_FALSE(test, IS_ERR(pdev));
 	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
 			mt7915_soc_test_pdev_put, pdev), 0);
@@ -1731,6 +1751,12 @@ mt7915_soc_test_probe_pdev(struct kunit *test, struct mt7915_soc_test_probe *p)
 	return pdev;
 }
 
+static struct platform_device *
+mt7915_soc_test_probe_pdev(struct kunit *test, struct mt7915_soc_test_probe *p)
+{
+	return __mt7915_soc_test_probe_pdev(test, p, true);
+}
+
 /* The MT7986's platform probe: an MT7986 by its device tree node, its
  * register window, its interrupt requested, the SoC side set up (clocks,
  * the INFRACFG and SKU windows, the consys reset line) and the WiFi
@@ -1749,6 +1775,33 @@ static void mt7915_soc_test_probe_register_fails(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, irq_has_action(p->irq));
 }
 
+/* A probe stops, freeing the device, without an interrupt, with one it
+ * can't have, or when the SoC side can't be set up (its SKU window here),
+ * the interrupt then given back.
+ */
+static void mt7915_soc_test_probe_errors(struct kunit *test)
+{
+	struct mt7915_soc_test_probe *p = mt7915_soc_test_probe_env(test);
+	struct platform_device *pdev;
+
+	pdev = __mt7915_soc_test_probe_pdev(test, p, false);
+	KUNIT_EXPECT_LT(test, mt7915_soc_test_probe(pdev), 0);
+	KUNIT_EXPECT_EQ(test, p->n_register, 0);
+	platform_device_unregister(pdev);
+	kunit_remove_action(test, mt7915_soc_test_pdev_put, pdev);
+
+	pdev = mt7915_soc_test_probe_pdev(test, p);
+	irq_set_status_flags(p->irq, IRQ_NOREQUEST);
+	KUNIT_EXPECT_LT(test, mt7915_soc_test_probe(pdev), 0);
+	irq_clear_status_flags(p->irq, IRQ_NOREQUEST);
+	pdev->dev.of_node = p->np;
+
+	p->no_sku = true;
+	KUNIT_EXPECT_EQ(test, mt7915_soc_test_probe(pdev), -ENOMEM);
+	KUNIT_EXPECT_FALSE(test, irq_has_action(p->irq));
+	KUNIT_EXPECT_EQ(test, p->n_register, 0);
+}
+
 /* A probe whose registration goes through keeps its interrupt; removing
  * the platform device unregisters it.
  */
@@ -1756,6 +1809,7 @@ static void mt7915_soc_test_probe_remove(struct kunit *test)
 {
 	struct mt7915_soc_test_probe *p = mt7915_soc_test_probe_env(test);
 	struct platform_device *pdev = mt7915_soc_test_probe_pdev(test, p);
+	void (*remove)(struct platform_device *pdev);
 
 	KUNIT_ASSERT_EQ(test, mt7915_soc_test_probe(pdev), 0);
 	KUNIT_EXPECT_TRUE(test, irq_has_action(p->irq));
@@ -1763,11 +1817,97 @@ static void mt7915_soc_test_probe_remove(struct kunit *test)
 			    (void *)p->dev);
 	KUNIT_EXPECT_EQ(test, mt76_chip(&p->dev->mt76), 0x7986);
 
-	mt798x_wmac_remove(pdev);
+	/* through the driver's own pointer, as the platform bus calls it (a
+	 * direct call gets the three-line function inlined here, where gcov
+	 * doesn't count it as run)
+	 */
+	remove = mt798x_wmac_driver.remove;
+	OPTIMIZER_HIDE_VAR(remove);
+	remove(pdev);
 	KUNIT_EXPECT_EQ(test, p->n_unregister, 1);
 	devm_free_irq(&pdev->dev, p->irq, p->dev);
 }
 
+static int mt7915_soc_test_clk_refuse(struct clk_hw *hw)
+{
+	return -EIO;
+}
+
+static const struct clk_ops mt7915_soc_test_bad_clk_ops = {
+	.prepare = mt7915_soc_test_clk_refuse,
+};
+
+struct mt7915_soc_test_bad_clk {
+	struct clk_hw hw;
+	struct clk_lookup *cl;
+};
+
+static void mt7915_soc_test_bad_clk_del(void *data)
+{
+	struct mt7915_soc_test_bad_clk *c = data;
+
+	clkdev_drop(c->cl);
+	clk_hw_unregister(&c->hw);
+}
+
+/* a clock @con_id of platform device @id that can't be enabled */
+static void mt7915_soc_test_bad_clk(struct kunit *test, const char *name,
+				    const char *con_id, int id)
+{
+	struct clk_init_data init = {
+		.name = name,
+		.ops = &mt7915_soc_test_bad_clk_ops,
+	};
+	struct mt7915_soc_test_bad_clk *c;
+
+	c = kunit_kzalloc(test, sizeof(*c), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, c);
+	c->hw.init = &init;
+	KUNIT_ASSERT_EQ(test, clk_hw_register(NULL, &c->hw), 0);
+	c->cl = clkdev_hw_create(&c->hw, con_id, "mt7915e-soc-test.%d", id);
+	if (!c->cl)
+		clk_hw_unregister(&c->hw);
+	KUNIT_ASSERT_NOT_NULL(test, c->cl);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_soc_test_bad_clk_del, c), 0);
+}
+
+/* Clocks that refuse to be enabled are reported, and the setup goes on
+ * (here to the missing reset line).
+ */
+static void mt7915_soc_test_wmac_init_bad_clocks(struct kunit *test)
+{
+	static const struct resource res[] = {
+		DEFINE_RES_MEM(0x0c000000, SZ_4K),
+		DEFINE_RES_MEM(0x0c001000, SZ_4K),
+		DEFINE_RES_MEM(0x0c002000, SZ_4K),
+	};
+	struct platform_device *pdev;
+	struct mt7915_soc_test *t;
+	struct mt7915_dev *dev;
+	struct device *kdev;
+	int ret;
+
+	mt7915_soc_test_bad_clk(test, "mt7915e-soc-test-bad-mcu", "mcu", 7989);
+	mt7915_soc_test_bad_clk(test, "mt7915e-soc-test-bad-ap2conn",
+				"ap2conn", 7989);
+	pdev = platform_device_register_simple("mt7915e-soc-test", 7989, res,
+					       ARRAY_SIZE(res));
+	KUNIT_ASSERT_FALSE(test, IS_ERR(pdev));
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_soc_test_pdev_put, pdev), 0);
+	t = mt7915_soc_test_init(test, &dev);
+	kdev = dev->mt76.dev;
+	dev->mt76.dev = &pdev->dev;
+	ret = mt798x_wmac_init(dev);
+	dev->mt76.dev = kdev;
+
+	KUNIT_EXPECT_EQ(test, ret, -ENOENT);
+	dev->dcm = (void __force __iomem *)t->dcm;
+	dev->sku = (void __force __iomem *)t->sku;
+	dev->rstc = NULL;
+}
+
 static struct kunit_case mt7915_soc_test_cases[] = {
 	KUNIT_CASE(mt7915_soc_test_spi_access),
 	KUNIT_CASE(mt7915_soc_test_spi_busy),
@@ -1811,6 +1951,8 @@ static struct kunit_case mt7915_soc_test_cases[] = {
 	KUNIT_CASE(mt7915_soc_test_probe_unknown_chip),
 	KUNIT_CASE(mt7915_soc_test_probe_register_fails),
 	KUNIT_CASE(mt7915_soc_test_probe_remove),
+	KUNIT_CASE(mt7915_soc_test_probe_errors),
+	KUNIT_CASE(mt7915_soc_test_wmac_init_bad_clocks),
 	KUNIT_CASE(mt7915_soc_test_wmac_init),
 	KUNIT_CASE(mt7915_soc_test_wmac_init_windows),
 	{}
