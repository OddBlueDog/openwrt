diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
index fcfc7976..a0f4ebf8 100644
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -271,6 +271,53 @@ struct mt7915_phy {
 #endif
 };
 
+#define MT7915_RDD_REPORTS		8
+#define MT7915_RDD_PULSES		32
+
+/* a pulse of a radar report, in the chip's own units */
+struct mt7915_rdd_pulse {
+	u32 start;
+	u16 width;
+	s16 power;
+};
+
+/* A radar report from the chip (MCU_EXT_EVENT_RDD_REPORT), as debugfs
+ * "rdd_reports" shows it: when it came, the detector and the channel its
+ * radio was on, then what the event carried (zero where it was cut short;
+ * the pulse counts are those of the pulses that arrived).
+ */
+struct mt7915_rdd_report {
+	u32 seq;
+	time64_t time;		/* real time, seconds */
+	u64 uptime_ms;		/* boottime */
+	u8 rdd_idx;
+	u8 band;		/* the radio's band_idx */
+	u16 freq;		/* MHz: control channel, */
+	u16 width;		/* width */
+	u16 center;		/* and center_freq1 */
+
+	u8 radar_type_idx;
+	u8 long_detected;
+	u8 constant_prf_detected;
+	u8 staggered_prf_detected;
+	u8 n_periodic;
+	u8 n_long;
+	u8 n_hw;
+	u8 out_lpn;
+	u8 out_spn;
+	u8 out_crpn;
+	u8 out_crpw;
+	u8 out_crbn;
+	u8 out_stgpn;
+	u8 out_stgpw;
+	u32 out_pri_const;
+	u32 out_pri_stg[3];
+
+	struct mt7915_rdd_pulse periodic[MT7915_RDD_PULSES];
+	struct mt7915_rdd_pulse long_pulse[MT7915_RDD_PULSES];
+	struct mt7915_rdd_pulse hw[MT7915_RDD_PULSES];
+};
+
 struct mt7915_dev {
 	union { /* must be first */
 		struct mt76_dev mt76;
@@ -325,6 +372,16 @@ struct mt7915_dev {
 	spinlock_t reg_lock;
 
 	u32 hw_pattern;
+	/* the last radar reports, for debugfs "rdd_reports": written in the
+	 * MCU rx path, read in process context. The report numbered seq is
+	 * in ring[seq % MT7915_RDD_REPORTS]; @seq is the newest's.
+	 */
+	struct {
+		spinlock_t lock;
+		u32 seq;
+		u8 count;
+		struct mt7915_rdd_report ring[MT7915_RDD_REPORTS];
+	} rdd_reports;
 	u32 ple1_sts;
 	/* firmware events that spanned several rx buffers */
 	u32 rx_event_frags;
@@ -597,6 +654,8 @@ struct mt7915_sta_ps_stats {
 
 void mt7915_sta_ps_stats(struct mt7915_sta *msta,
 			 struct mt7915_sta_ps_stats *st);
+int mt7915_rdd_reports_get(struct mt7915_dev *dev,
+			   struct mt7915_rdd_report *r);
 int mt7915_mcu_apply_group_cal(struct mt7915_dev *dev);
 int mt7915_mcu_apply_tx_dpd(struct mt7915_phy *phy);
 int mt7915_mcu_get_chan_mib_info(struct mt7915_phy *phy, bool chan_switch);
diff --git a/mt7915/tests/debugfs-test.c b/mt7915/tests/debugfs-test.c
index caa83f6c..5b56fe7b 100644
--- a/mt7915/tests/debugfs-test.c
+++ b/mt7915/tests/debugfs-test.c
@@ -73,8 +73,118 @@ static void mt7915_debugfs_test_twt_stats_locked(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, mutex_is_locked(&dev->mt76.mutex));
 }
 
+/* "rdd_reports" for @dev, NUL-terminated */
+static const char *
+mt7915_debugfs_test_rdd_read(struct kunit *test, struct mt7915_dev *dev)
+{
+	struct seq_file *s;
+	struct device *d;
+	char *buf;
+
+	s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+	d = kunit_kzalloc(test, sizeof(*d), GFP_KERNEL);
+	buf = kunit_kzalloc(test, 4096 + 1, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_NOT_NULL(test, d);
+	KUNIT_ASSERT_NOT_NULL(test, buf);
+
+	dev_set_drvdata(d, dev);
+	s->buf = buf;
+	s->size = 4096;
+	s->private = d;
+	KUNIT_ASSERT_EQ(test, mt7915_rdd_reports_show(s, NULL), 0);
+	KUNIT_ASSERT_LT(test, s->count, s->size);
+	return buf;
+}
+
+/* The radar reports, oldest first: a line each, then a line per pulse
+ * (periodic, long, hardware), in the format the router's script parses.
+ * The power is signed, the flags 0 or 1. Nothing at all with no reports.
+ */
+static void mt7915_debugfs_test_rdd_reports(struct kunit *test)
+{
+	static const char * const lines[] = {
+		"report 7 time 1761300000 uptime_ms 123456 rdd 1 band 1 freq 5300 width 80 center 5290 type 3 long 1 constant 1 staggered 0 periodic_pulses 1 long_pulses 1 hw_pulses 2 pri_const 1428 pri_stg 100,200,300 lpn 1 spn 2 crpn 3 crpw 4 crbn 5 stgpn 6 stgpw 7\n",
+		"pulse periodic start 4000000000 width 65535 power -60\n",
+		"pulse long start 12 width 3000 power 0\n",
+		"pulse hw start 1 width 2 power -32768\n",
+		"pulse hw start 7 width 8 power 32767\n",
+		"report 8 time 1761300060 uptime_ms 183456 rdd 2 band 0 freq 0 width 0 center 0 type 0 long 0 constant 0 staggered 1 periodic_pulses 0 long_pulses 0 hw_pulses 0 pri_const 4294967295 pri_stg 0,0,0 lpn 0 spn 0 crpn 0 crpw 0 crbn 0 stgpn 0 stgpw 255\n",
+	};
+	struct mt7915_rdd_report *e;
+	struct mt7915_dev *dev;
+	char *expect;
+	int i;
+
+	expect = kunit_kzalloc(test, 4096, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, expect);
+	for (i = 0; i < ARRAY_SIZE(lines); i++)
+		strlcat(expect, lines[i], 4096);
+
+	dev = kunit_kzalloc(test, sizeof(*dev), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev);
+	spin_lock_init(&dev->rdd_reports.lock);
+
+	KUNIT_EXPECT_STREQ(test, mt7915_debugfs_test_rdd_read(test, dev),
+			   "");
+
+	/* reports 7 and 8 of 8: the ring wrapped */
+	dev->rdd_reports.seq = 8;
+	dev->rdd_reports.count = 2;
+
+	e = &dev->rdd_reports.ring[7];
+	e->seq = 7;
+	e->time = 1761300000;
