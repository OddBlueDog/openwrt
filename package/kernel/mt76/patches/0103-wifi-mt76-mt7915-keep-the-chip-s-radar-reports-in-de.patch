 mt7915/mcu.c                | 144 +++++++++++++++-
 mt7915/mcu.h                |  45 ++---
 mt7915/mmio.c               |   1 +
 mt7915/mt7915.h             |  59 +++++++
 mt7915/tests/debugfs-test.c | 110 ++++++++++++
 mt7915/tests/mcu2-test.c    | 326 ++++++++++++++++++++++++++++++++++++
 7 files changed, 722 insertions(+), 24 deletions(-)

diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
index 4f4bf0be..f3ca6843 100644
--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -465,6 +465,65 @@ exit:
 }
 DEFINE_SHOW_ATTRIBUTE(mt7915_muru_stats);
 
+static void
+mt7915_rdd_reports_pulses(struct seq_file *s, const char *kind,
+			  const struct mt7915_rdd_pulse *p, int n)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		seq_printf(s, "pulse %s start %u width %u power %d\n", kind,
+			   p[i].start, p[i].width, p[i].power);
+}
+
+/* The chip's last radar reports, oldest first: a "report" line each, then
+ * a "pulse" line for each pulse it carried (periodic, long, then the
+ * hardware's). Numbers are in decimal and in the chip's own units. A
+ * script on the router parses this: keep the format.
+ */
+static int
+mt7915_rdd_reports_show(struct seq_file *s, void *data)
+{
+	struct mt7915_dev *dev = dev_get_drvdata(s->private);
+	struct mt7915_rdd_report *r;
+	int i, n;
+
+	r = kmalloc_array(MT7915_RDD_REPORTS, sizeof(*r), GFP_KERNEL);
+	if (!r)
+		return -ENOMEM;
+
+	n = mt7915_rdd_reports_get(dev, r);
+	for (i = 0; i < n; i++) {
+		const struct mt7915_rdd_report *e = &r[i];
+
+		seq_printf(s, "report %u time %lld uptime_ms %llu rdd %u band %u",
+			   e->seq, e->time, e->uptime_ms, e->rdd_idx, e->band);
+		seq_printf(s, " freq %u width %u center %u",
+			   e->freq, e->width, e->center);
+		seq_printf(s, " type %u long %d constant %d staggered %d",
+			   e->radar_type_idx, !!e->long_detected,
+			   !!e->constant_prf_detected,
+			   !!e->staggered_prf_detected);
+		seq_printf(s, " periodic_pulses %u long_pulses %u hw_pulses %u",
+			   e->n_periodic, e->n_long, e->n_hw);
+		seq_printf(s, " pri_const %u pri_stg %u,%u,%u",
+			   e->out_pri_const, e->out_pri_stg[0],
+			   e->out_pri_stg[1], e->out_pri_stg[2]);
+		seq_printf(s, " lpn %u spn %u crpn %u crpw %u crbn %u",
+			   e->out_lpn, e->out_spn, e->out_crpn, e->out_crpw,
+			   e->out_crbn);
+		seq_printf(s, " stgpn %u stgpw %u\n",
+			   e->out_stgpn, e->out_stgpw);
+		mt7915_rdd_reports_pulses(s, "periodic", e->periodic,
+					  e->n_periodic);
+		mt7915_rdd_reports_pulses(s, "long", e->long_pulse, e->n_long);
+		mt7915_rdd_reports_pulses(s, "hw", e->hw, e->n_hw);
+	}
+	kfree(r);
+
+	return 0;
+}
+
 static int
 mt7915_rdd_monitor(struct seq_file *s, void *data)
 {
@@ -1355,6 +1414,8 @@ int mt7915_init_debugfs(struct mt7915_phy *phy)
 				    &fops_radar_trigger);
 		debugfs_create_devm_seqfile(dev->mt76.dev, "rdd_monitor", dir,
 					    mt7915_rdd_monitor);
+		debugfs_create_devm_seqfile(dev->mt76.dev, "rdd_reports", dir,
+					    mt7915_rdd_reports_show);
 	}
 
 	if (!ext_phy)
diff --git a/mt7915/mcu.c b/mt7915/mcu.c
index 247a0a3f..e369d5d3 100644
--- a/mt7915/mcu.c
+++ b/mt7915/mcu.c
@@ -355,16 +355,149 @@ mt7915_mcu_rx_thermal_notify(struct mt7915_dev *dev, struct sk_buff *skb)
 	phy->throttle_state = t->ctrl.duty.duty_cycle;
 }
 
+/* how many of the @num pulses at @off, @size bytes each, arrived in a
+ * report of @len bytes
+ */
+static u8
+mt7915_mcu_rdd_pulses_in(unsigned int len, size_t off, size_t size, u8 num)
+{
+	size_t n = len > off ? (len - off) / size : 0;
+
+	return min3(n, (size_t)num, (size_t)MT7915_RDD_PULSES);
+}
+
+static void
+mt7915_mcu_rdd_pulse(struct mt7915_rdd_pulse *p, __le32 start, __le16 width,
+		     __le16 power)
+{
+	p->start = le32_to_cpu(start);
+	p->width = le16_to_cpu(width);
+	p->power = (s16)le16_to_cpu(power);
+}
+
+/* Keep radar report @r for debugfs "rdd_reports", with the channel
+ * @chandef its detector's radio @mphy was on. Only @len bytes of it
+ * arrived: @hdr is its fixed part (zero past the end), and only the pulses
+ * that arrived are read.
+ */
+static void
+mt7915_mcu_rdd_report_add(struct mt7915_dev *dev, struct mt76_phy *mphy,
+			  const struct cfg80211_chan_def *chandef,
+			  const struct mt7915_mcu_rdd_report *r,
+			  const struct mt7915_mcu_rdd_report_hdr *hdr,
+			  unsigned int len)
+{
+	time64_t now = ktime_get_real_seconds();
+	u64 uptime_ms = ktime_to_ms(ktime_get_boottime());
+	struct mt7915_rdd_report *e;
+	int i;
+
+	BUILD_BUG_ON(ARRAY_SIZE(r->long_pulse) != MT7915_RDD_PULSES ||
+		     ARRAY_SIZE(r->periodic_pulse) != MT7915_RDD_PULSES ||
+		     ARRAY_SIZE(r->hw_pulse) != MT7915_RDD_PULSES);
+
+	spin_lock(&dev->rdd_reports.lock);
+	dev->rdd_reports.seq++;
+	if (dev->rdd_reports.count < MT7915_RDD_REPORTS)
+		dev->rdd_reports.count++;
+	e = &dev->rdd_reports.ring[dev->rdd_reports.seq % MT7915_RDD_REPORTS];
+	memset(e, 0, sizeof(*e));
+
+	e->seq = dev->rdd_reports.seq;
+	e->time = now;
+	e->uptime_ms = uptime_ms;
+	e->rdd_idx = hdr->rdd_idx;
+	e->band = mphy->band_idx;
+	if (chandef->chan) {
+		e->freq = chandef->chan->center_freq;
+		e->width = max(cfg80211_chandef_get_width(chandef), 0);
+		e->center = chandef->center_freq1;
+	}
+
+	e->radar_type_idx = hdr->radar_type_idx;
+	e->long_detected = hdr->long_detected;
+	e->constant_prf_detected = hdr->constant_prf_detected;
+	e->staggered_prf_detected = hdr->staggered_prf_detected;
+	e->out_lpn = hdr->out_lpn;
+	e->out_spn = hdr->out_spn;
+	e->out_crpn = hdr->out_crpn;
+	e->out_crpw = hdr->out_crpw;
+	e->out_crbn = hdr->out_crbn;
+	e->out_stgpn = hdr->out_stgpn;
+	e->out_stgpw = hdr->out_stgpw;
+	e->out_pri_const = le32_to_cpu(hdr->out_pri_const);
+	for (i = 0; i < ARRAY_SIZE(e->out_pri_stg); i++)
+		e->out_pri_stg[i] = le32_to_cpu(hdr->out_pri_stg[i]);
+
+	e->n_periodic = mt7915_mcu_rdd_pulses_in(len,
+			offsetof(struct mt7915_mcu_rdd_report, periodic_pulse),
+			sizeof(r->periodic_pulse[0]), hdr->periodic_pulse_num);
+	for (i = 0; i < e->n_periodic; i++)
+		mt7915_mcu_rdd_pulse(&e->periodic[i],
+				     r->periodic_pulse[i].start,
+				     r->periodic_pulse[i].pulse_width,
+				     r->periodic_pulse[i].pulse_power);
+
+	e->n_long = mt7915_mcu_rdd_pulses_in(len,
+			offsetof(struct mt7915_mcu_rdd_report, long_pulse),
+			sizeof(r->long_pulse[0]), hdr->long_pulse_num);
+	for (i = 0; i < e->n_long; i++)
+		mt7915_mcu_rdd_pulse(&e->long_pulse[i], r->long_pulse[i].start,
+				     r->long_pulse[i].pulse_width,
+				     r->long_pulse[i].pulse_power);
+
+	e->n_hw = mt7915_mcu_rdd_pulses_in(len,
+			offsetof(struct mt7915_mcu_rdd_report, hw_pulse),
+			sizeof(r->hw_pulse[0]), hdr->hw_pulse_num);
+	for (i = 0; i < e->n_hw; i++)
+		mt7915_mcu_rdd_pulse(&e->hw[i], r->hw_pulse[i].start,
+				     r->hw_pulse[i].pulse_width,
+				     r->hw_pulse[i].pulse_power);
+	spin_unlock(&dev->rdd_reports.lock);
+}
+
+/* the radar reports kept, oldest first, into @r (room for
+ * MT7915_RDD_REPORTS of them); returns how many
+ */
+int mt7915_rdd_reports_get(struct mt7915_dev *dev,
+			   struct mt7915_rdd_report *r)
+{
+	int i, n;
+
+	spin_lock_bh(&dev->rdd_reports.lock);
+	n = dev->rdd_reports.count;
+	for (i = 0; i < n; i++) {
+		u32 seq = dev->rdd_reports.seq - (n - 1 - i);
+
+		r[i] = dev->rdd_reports.ring[seq % MT7915_RDD_REPORTS];
+	}
+	spin_unlock_bh(&dev->rdd_reports.lock);
+
+	return n;
+}
+
 static void
 mt7915_mcu_rx_radar_detected(struct mt7915_dev *dev, struct sk_buff *skb)
 {
+	const size_t hdr_off = offsetof(struct mt7915_mcu_rdd_report, hdr);
+	struct mt7915_mcu_rdd_report_hdr hdr = {};
 	struct mt76_phy *mphy = &dev->mt76.phy;
 	struct mt7915_mcu_rdd_report *r;
 	u32 sku;
 
 	r = (struct mt7915_mcu_rdd_report *)skb->data;
+	/* one too short to say which detector heard it is dropped, as an
+	 * unknown detector's is; else a report cut short reads as zero past
+	 * its end
+	 */
+	if (skb->len <= hdr_off) {
+		dev_err(dev->mt76.dev, "RDD report too short (%u bytes)\n",
+			skb->len);
+		return;
+	}
+	memcpy(&hdr, &r->hdr, min(skb->len - hdr_off, sizeof(hdr)));
 
-	switch (r->rdd_idx) {
+	switch (hdr.rdd_idx) {
 	case MT_RDD_IDX_BAND0:
 		break;
 	case MT_RDD_IDX_BAND1:
@@ -381,14 +514,19 @@ mt7915_mcu_rx_radar_detected(struct mt7915_dev *dev, struct sk_buff *skb)
 		mphy = dev->rdd2_phy->mt76;
 		break;
 	default:
-		dev_err(dev->mt76.dev, "Unknown RDD idx %d\n", r->rdd_idx);
+		dev_err(dev->mt76.dev, "Unknown RDD idx %d\n", hdr.rdd_idx);
 		return;
 	}
 
 	if (!mphy)
 		return;
 
-	if (r->rdd_idx == MT_RDD_IDX_BACKGROUND)
+	mt7915_mcu_rdd_report_add(dev, mphy,
+				  hdr.rdd_idx == MT_RDD_IDX_BACKGROUND ?
+				  &dev->rdd2_chandef : &mphy->chandef,
+				  r, &hdr, skb->len);
+
+	if (hdr.rdd_idx == MT_RDD_IDX_BACKGROUND)
 		cfg80211_background_radar_event(mphy->hw->wiphy,
 						&dev->rdd2_chandef,
 						GFP_ATOMIC);
diff --git a/mt7915/mcu.h b/mt7915/mcu.h
