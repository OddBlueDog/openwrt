+/* A radar report from detector @rdd_idx with every field set and all 32
+ * entries of each pulse array filled (distinct, non-zero), saying it
+ * carries 3 periodic, 2 long and 4 hardware pulses.
+ */
+static struct mt7915_mcu_rdd_report *
+mt7915_mcu2_rdd_ev(struct kunit *test, u8 rdd_idx)
+{
+	struct mt7915_mcu_rdd_report *ev;
+	int i;
+
+	ev = kunit_kzalloc(test, sizeof(*ev), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ev);
+	ev->rdd_idx = rdd_idx;
+	ev->long_detected = 0;
+	ev->constant_prf_detected = 1;
+	ev->staggered_prf_detected = 0;
+	ev->radar_type_idx = 5;
+	ev->periodic_pulse_num = 3;
+	ev->long_pulse_num = 2;
+	ev->hw_pulse_num = 4;
+	ev->out_lpn = 11;
+	ev->out_spn = 12;
+	ev->out_crpn = 13;
+	ev->out_crpw = 14;
+	ev->out_crbn = 15;
+	ev->out_stgpn = 16;
+	ev->out_stgpw = 17;
+	ev->out_pri_const = cpu_to_le32(1428);
+	ev->out_pri_stg[0] = cpu_to_le32(2500);
+	ev->out_pri_stg[1] = cpu_to_le32(3333);
+	ev->out_pri_stg[2] = cpu_to_le32(0x80000001);
+	for (i = 0; i < 32; i++) {
+		ev->periodic_pulse[i].start = cpu_to_le32(1000 + i);
+		ev->periodic_pulse[i].pulse_width = cpu_to_le16(10 + i);
+		ev->periodic_pulse[i].pulse_power = cpu_to_le16(0xffc4 - i);
+		ev->long_pulse[i].start = cpu_to_le32(2000 + i);
+		ev->long_pulse[i].pulse_width = cpu_to_le16(300 + i);
+		ev->long_pulse[i].pulse_power = cpu_to_le16(0xff00 + i);
+		ev->hw_pulse[i].start = cpu_to_le32(0xf0000000 + i);
+		ev->hw_pulse[i].pulse_width = cpu_to_le16(0xffe0 + i);
+		ev->hw_pulse[i].pulse_power = cpu_to_le16(20 + i);
+		ev->hw_pulse[i].sc_pass = 1;
+		ev->hw_pulse[i].mdrdy_flag = 1;
+	}
+	return ev;
+}
+
+/* radar report @ev, of which only @len bytes arrived: the skb holds all
+ * of it, so a driver reading past @len would see the rest
+ */
+static void mt7915_mcu2_rdd_send(struct kunit *test, struct mt7915_dev *dev,
+				 struct mt7915_mcu_rdd_report *ev, int len)
+{
+	struct sk_buff *skb;
+
+	skb = mt7915_mcu2_event(test, MCU_EVENT_EXT, MCU_EXT_EVENT_RDD_REPORT,
+				0, ev, sizeof(*ev));
+	skb_trim(skb, len);
+	mt7915_mcu2_rx_event(test, dev, skb);
+	mt7915_mcu2_run_wiphy_work(dev);
+}
+
+/* the radar reports the driver kept, oldest first; returns how many */
+static int mt7915_mcu2_rdd_kept(struct kunit *test, struct mt7915_dev *dev,
+				struct mt7915_rdd_report **r)
+{
+	*r = kunit_kcalloc(test, MT7915_RDD_REPORTS, sizeof(**r), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, *r);
+	return mt7915_rdd_reports_get(dev, *r);
+}
+
+static void mt7915_mcu2_expect_pulse(struct kunit *test,
+				     const struct mt7915_rdd_pulse *p,
+				     u32 start, u16 width, s16 power)
+{
+	KUNIT_EXPECT_EQ(test, p->start, start);
+	KUNIT_EXPECT_EQ(test, p->width, width);
+	KUNIT_EXPECT_EQ(test, p->power, power);
+}
+
+/* entries @from.. of @p are empty */
+static void mt7915_mcu2_expect_no_pulses(struct kunit *test,
+					 const struct mt7915_rdd_pulse *p,
+					 int from)
+{
+	int i;
+
+	for (i = from; i < MT7915_RDD_PULSES; i++)
+		mt7915_mcu2_expect_pulse(test, &p[i], 0, 0, 0);
+}
+
+/* A radar report is kept for debugfs with what it carried, in host order
+ * (the 16-bit power signed), and when and where it came: the channel of
+ * the radio its detector maps to, that radio's band. Only the pulses the
+ * report counts are kept. The report still goes to mac80211.
+ */
+static void mt7915_mcu2_events_rdd_report(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu_rdd_report *ev;
+	struct mt7915_rdd_report *r, *e;
+	struct mt7915_phy *phy2;
+	time64_t t0, t1;
+	u64 up0, up1;
+	int i;
+
+	mt7915_mcu2_bands(test, dev);
+	mt7915_mcu2_tune(test, dev, 5260, NL80211_CHAN_WIDTH_80, 5290);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_rdd_kept(test, dev, &r), 0);
+
+	ev = mt7915_mcu2_rdd_ev(test, MT_RDD_IDX_BAND0);
+	t0 = ktime_get_real_seconds();
+	up0 = ktime_to_ms(ktime_get_boottime());
+	mt7915_mcu2_rdd_send(test, dev, ev, sizeof(*ev));
+	t1 = ktime_get_real_seconds();
+	up1 = ktime_to_ms(ktime_get_boottime());
+	KUNIT_EXPECT_EQ(test, dev->hw_pattern, 1);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_rdd_kept(test, dev, &r), 1);
+	e = &r[0];
+	KUNIT_EXPECT_EQ(test, e->seq, 1);
+	KUNIT_EXPECT_GE(test, e->time, t0);
+	KUNIT_EXPECT_LE(test, e->time, t1);
+	KUNIT_EXPECT_GE(test, e->uptime_ms, up0);
+	KUNIT_EXPECT_LE(test, e->uptime_ms, up1);
+	KUNIT_EXPECT_EQ(test, e->rdd_idx, MT_RDD_IDX_BAND0);
+	KUNIT_EXPECT_EQ(test, e->band, dev->mphy.band_idx);
+	KUNIT_EXPECT_EQ(test, e->freq, 5260);
+	KUNIT_EXPECT_EQ(test, e->width, 80);
+	KUNIT_EXPECT_EQ(test, e->center, 5290);
+	KUNIT_EXPECT_EQ(test, e->radar_type_idx, 5);
+	KUNIT_EXPECT_EQ(test, e->long_detected, 0);
+	KUNIT_EXPECT_EQ(test, e->constant_prf_detected, 1);
+	KUNIT_EXPECT_EQ(test, e->staggered_prf_detected, 0);
+	KUNIT_EXPECT_EQ(test, e->n_periodic, 3);
+	KUNIT_EXPECT_EQ(test, e->n_long, 2);
+	KUNIT_EXPECT_EQ(test, e->n_hw, 4);
+	KUNIT_EXPECT_EQ(test, e->out_lpn, 11);
+	KUNIT_EXPECT_EQ(test, e->out_spn, 12);
+	KUNIT_EXPECT_EQ(test, e->out_crpn, 13);
+	KUNIT_EXPECT_EQ(test, e->out_crpw, 14);
+	KUNIT_EXPECT_EQ(test, e->out_crbn, 15);
+	KUNIT_EXPECT_EQ(test, e->out_stgpn, 16);
+	KUNIT_EXPECT_EQ(test, e->out_stgpw, 17);
+	KUNIT_EXPECT_EQ(test, e->out_pri_const, 1428);
+	KUNIT_EXPECT_EQ(test, e->out_pri_stg[0], 2500);
+	KUNIT_EXPECT_EQ(test, e->out_pri_stg[1], 3333);
+	KUNIT_EXPECT_EQ(test, e->out_pri_stg[2], 0x80000001);
+	for (i = 0; i < 3; i++)
+		mt7915_mcu2_expect_pulse(test, &e->periodic[i], 1000 + i,
+					 10 + i, -60 - i);
+	mt7915_mcu2_expect_no_pulses(test, e->periodic, 3);
+	for (i = 0; i < 2; i++)
+		mt7915_mcu2_expect_pulse(test, &e->long_pulse[i], 2000 + i,
+					 300 + i, -256 + i);
+	mt7915_mcu2_expect_no_pulses(test, e->long_pulse, 2);
+	for (i = 0; i < 4; i++)
+		mt7915_mcu2_expect_pulse(test, &e->hw[i], 0xf0000000 + i,
+					 0xffe0 + i, 20 + i);
+	mt7915_mcu2_expect_no_pulses(test, e->hw, 4);
+
+	/* band 1's detector, with a band 1 radio: its channel and band */
+	mt7915_mcu2_set_adie(dev, MT7975_DUAL_ADIE);
+	phy2 = mt7915_mcu2_band1_phy(test, dev);
+	mt7915_mcu2_chandef(test, dev, &phy2->mt76->chandef, 5300,
+			    NL80211_CHAN_WIDTH_40, 5310);
+	ev->rdd_idx = MT_RDD_IDX_BAND1;
+	ev->periodic_pulse_num = 32;
+	ev->long_pulse_num = 0;
+	ev->hw_pulse_num = 1;
+	mt7915_mcu2_rdd_send(test, dev, ev, sizeof(*ev));
+	KUNIT_EXPECT_EQ(test, dev->hw_pattern, 2);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_rdd_kept(test, dev, &r), 2);
+	KUNIT_EXPECT_EQ(test, r[0].seq, 1);
+	KUNIT_EXPECT_EQ(test, r[0].rdd_idx, MT_RDD_IDX_BAND0);
+	e = &r[1];
+	KUNIT_EXPECT_EQ(test, e->seq, 2);
+	KUNIT_EXPECT_EQ(test, e->rdd_idx, MT_RDD_IDX_BAND1);
+	KUNIT_EXPECT_EQ(test, e->band, MT_BAND1);
+	KUNIT_EXPECT_EQ(test, e->freq, 5300);
+	KUNIT_EXPECT_EQ(test, e->width, 40);
+	KUNIT_EXPECT_EQ(test, e->center, 5310);
+	KUNIT_EXPECT_EQ(test, e->n_periodic, 32);
+	KUNIT_EXPECT_EQ(test, e->n_long, 0);
+	KUNIT_EXPECT_EQ(test, e->n_hw, 1);
+	mt7915_mcu2_expect_pulse(test, &e->periodic[31], 1031, 41, -91);
+	mt7915_mcu2_expect_no_pulses(test, e->long_pulse, 0);
+	mt7915_mcu2_expect_pulse(test, &e->hw[0], 0xf0000000, 0xffe0, 20);
+	mt7915_mcu2_expect_no_pulses(test, e->hw, 1);
+}
+
+/* A report cut short is kept with what arrived: fields past its end read
+ * as zero, and each pulse count is cut to the pulses that arrived whole
+ * (and to 32). Nothing past the end is read.
+ */
+static void mt7915_mcu2_events_rdd_report_short(struct kunit *test)
+{
+	const int pulses = offsetof(struct mt7915_mcu_rdd_report, long_pulse);
+	const int hdr = offsetof(struct mt7915_mcu_rdd_report, hdr);
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu_rdd_report *ev;
+	struct mt7915_rdd_report *r, *e;
+
+	mt7915_mcu2_bands(test, dev);
+	mt7915_mcu2_tune(test, dev, 5260, NL80211_CHAN_WIDTH_80, 5290);
+	ev = mt7915_mcu2_rdd_ev(test, MT_RDD_IDX_BAND0);
+	ev->periodic_pulse_num = 10;
+	ev->long_pulse_num = 20;
+	ev->hw_pulse_num = 10;
+
+	/* the fixed part and 3 long pulses, half of a 4th */
+	mt7915_mcu2_rdd_send(test, dev, ev, pulses + 3 * 12 + 6);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_rdd_kept(test, dev, &r), 1);
+	e = &r[0];
+	KUNIT_EXPECT_EQ(test, e->radar_type_idx, 5);
+	KUNIT_EXPECT_EQ(test, e->out_stgpw, 17);
+	KUNIT_EXPECT_EQ(test, e->out_pri_stg[2], 0x80000001);
+	KUNIT_EXPECT_EQ(test, e->n_long, 3);
+	KUNIT_EXPECT_EQ(test, e->n_periodic, 0);
+	KUNIT_EXPECT_EQ(test, e->n_hw, 0);
+	mt7915_mcu2_expect_pulse(test, &e->long_pulse[2], 2002, 302, -254);
+	mt7915_mcu2_expect_no_pulses(test, e->long_pulse, 3);
+	mt7915_mcu2_expect_no_pulses(test, e->periodic, 0);
+	mt7915_mcu2_expect_no_pulses(test, e->hw, 0);
+	KUNIT_EXPECT_EQ(test, dev->hw_pattern, 1);
+
+	/* all long pulses and 2 periodic ones; more than 32 long ones
+	 * claimed
+	 */
+	ev->long_pulse_num = 200;
+	mt7915_mcu2_rdd_send(test, dev, ev,
+			     offsetof(struct mt7915_mcu_rdd_report,
+				      periodic_pulse) + 2 * 12);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_rdd_kept(test, dev, &r), 2);
+	e = &r[1];
+	KUNIT_EXPECT_EQ(test, e->n_long, 32);
+	KUNIT_EXPECT_EQ(test, e->n_periodic, 2);
+	KUNIT_EXPECT_EQ(test, e->n_hw, 0);
+	mt7915_mcu2_expect_pulse(test, &e->long_pulse[31], 2031, 331, -225);
+	mt7915_mcu2_expect_pulse(test, &e->periodic[1], 1001, 11, -61);
+	mt7915_mcu2_expect_no_pulses(test, e->periodic, 2);
+	mt7915_mcu2_expect_no_pulses(test, e->hw, 0);
+
+	/* the whole report, more than 32 hardware pulses claimed */
+	ev->hw_pulse_num = 33;
+	mt7915_mcu2_rdd_send(test, dev, ev, sizeof(*ev));
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_rdd_kept(test, dev, &r), 3);
+	KUNIT_EXPECT_EQ(test, r[2].n_hw, 32);
+	mt7915_mcu2_expect_pulse(test, &r[2].hw[31], 0xf000001f, 0xffff, 51);
+
+	/* the fixed part cut after the periodic pulse count */
+	mt7915_mcu2_rdd_send(test, dev, ev, hdr + 6);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_rdd_kept(test, dev, &r), 4);
+	e = &r[3];
+	KUNIT_EXPECT_EQ(test, e->rdd_idx, MT_RDD_IDX_BAND0);
+	KUNIT_EXPECT_EQ(test, e->constant_prf_detected, 1);
+	KUNIT_EXPECT_EQ(test, e->radar_type_idx, 5);
+	KUNIT_EXPECT_EQ(test, e->n_periodic, 0);
+	KUNIT_EXPECT_EQ(test, e->n_long, 0);
+	KUNIT_EXPECT_EQ(test, e->n_hw, 0);
+	KUNIT_EXPECT_EQ(test, e->out_lpn, 0);
+	KUNIT_EXPECT_EQ(test, e->out_stgpw, 0);
+	KUNIT_EXPECT_EQ(test, e->out_pri_const, 0);
+	KUNIT_EXPECT_EQ(test, e->out_pri_stg[2], 0);
+	KUNIT_EXPECT_EQ(test, e->freq, 5260);
+	KUNIT_EXPECT_EQ(test, dev->hw_pattern, 4);
+}
+
+/* The last 8 reports are kept, oldest first, numbered in the order they
+ * came.
+ */
+static void mt7915_mcu2_events_rdd_report_ring(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu_rdd_report *ev;
+	struct mt7915_rdd_report *r;
+	int i;
+
+	mt7915_mcu2_bands(test, dev);
+	mt7915_mcu2_tune(test, dev, 5260, NL80211_CHAN_WIDTH_80, 5290);
+	ev = mt7915_mcu2_rdd_ev(test, MT_RDD_IDX_BAND0);
+	for (i = 0; i < 11; i++) {
+		ev->radar_type_idx = i;
+		mt7915_mcu2_rdd_send(test, dev, ev, sizeof(*ev));
+	}
+	KUNIT_EXPECT_EQ(test, dev->hw_pattern, 11);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_rdd_kept(test, dev, &r),
+			MT7915_RDD_REPORTS);
+	for (i = 0; i < MT7915_RDD_REPORTS; i++) {
+		KUNIT_EXPECT_EQ(test, r[i].seq, 4 + i);
+		KUNIT_EXPECT_EQ(test, r[i].radar_type_idx, 3 + i);
+		KUNIT_EXPECT_EQ(test, r[i].n_periodic, 3);
+	}
+}
+
+/* Reports the driver drops (an unknown detector, one without a radio, one
+ * too short to say which detector it's from) aren't kept either.
+ */
+static void mt7915_mcu2_events_rdd_report_dropped(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu_rdd_report *ev;
+	struct mt7915_rdd_report *r;
+
+	ev = mt7915_mcu2_rdd_ev(test, 3);
+	mt7915_mcu2_rdd_send(test, dev, ev, sizeof(*ev));
+	ev->rdd_idx = MT_RDD_IDX_BAND0;
+	mt7915_mcu2_rdd_send(test, dev, ev,
+			     offsetof(struct mt7915_mcu_rdd_report, hdr));
+	ev->rdd_idx = MT_RDD_IDX_BACKGROUND;
+	mt7915_mcu2_rdd_send(test, dev, ev, sizeof(*ev));
+	mt7915_mcu2_set_adie(dev, MT7976_DUAL_ADIE);
+	ev->rdd_idx = MT_RDD_IDX_BAND1;
+	mt7915_mcu2_rdd_send(test, dev, ev, sizeof(*ev));
+
+	KUNIT_EXPECT_EQ(test, dev->hw_pattern, 0);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_rdd_kept(test, dev, &r), 0);
+	KUNIT_EXPECT_EQ(test, dev->rdd_reports.seq, 0);
+}
+
 static void mt7915_mcu2_ps_event(struct kunit *test, struct mt7915_dev *dev,
 				 u16 wcid, bool ps)
 {
@@ -1389,6 +1711,10 @@ static struct kunit_case mt7915_mcu2_event_cases[] = {
