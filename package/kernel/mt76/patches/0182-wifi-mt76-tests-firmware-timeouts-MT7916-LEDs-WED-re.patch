 				     const void *data, size_t len)
 {
-	char path[96];
 	struct file *f;
 	loff_t pos = 0;
 	ssize_t n;
+	char *path;
 
-	snprintf(path, sizeof(path), "/lib/firmware/%s", name);
+	path = kunit_kmalloc(test, 96, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, path);
+	snprintf(path, 96, "/lib/firmware/%s", name);
 	f = filp_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
