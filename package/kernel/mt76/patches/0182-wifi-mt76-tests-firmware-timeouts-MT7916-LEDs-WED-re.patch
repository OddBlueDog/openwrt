+	if (kunit_add_action_or_reset(test, mt7915_replay_test_unlink, path))
+		kunit_skip(test, "can't remove %s after the test", path);
 	n = kernel_write(f, data, len, &pos);
 	filp_close(f, NULL);
 	/* until the deferred fput() runs, the file is still being written
