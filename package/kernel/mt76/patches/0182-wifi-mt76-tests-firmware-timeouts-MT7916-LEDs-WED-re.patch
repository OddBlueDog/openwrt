 	synchronize_rcu();
 }
 
+/* The handshakes with the firmware's ownership and state registers give
+ * up when they never change: the driver doesn't get the device, the
+ * firmware never enters its download state at a load, or at the driver's
+ * exit (which then doesn't hand the device back).
+ */
+static u32 mt7915_mcu2_fw_own_addr;	/* LPCR, as the fake sees it */
+
+/* the firmware keeps the device: its own status never clears */
+static u32 mt7915_mcu2_fw_owns(struct mt76_test_fake *fake, u32 addr, u32 val)
+{
+	return addr == mt7915_mcu2_fw_own_addr ? val | MT_TOP_LPCR_HOST_FW_OWN_STAT :
+					  val;
+}
+
+static void mt7915_mcu2_fw_handshake_timeouts(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	mt76_wr(dev, MT_TOP_LPCR_HOST_BAND(0), 0);
+	mt7915_mcu2_fw_own_addr = fake->last_addr;
+	fake->rr_hook = mt7915_mcu2_fw_owns;
+	KUNIT_EXPECT_EQ(test, mt7915_driver_own(dev, 0), -EIO);
+	fake->rr_hook = NULL;
+
+	mt76_wr(dev, MT_TOP_MISC, FIELD_PREP(MT_TOP_MISC_FW_STATE,
+					     FW_STATE_RDY));
+	KUNIT_EXPECT_EQ(test, mt7915_load_firmware(dev), -EIO);
+
+	mt76_wr(dev, MT_TOP_LPCR_HOST_BAND(0), 0);
+	mt7915_mcu_exit(dev);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TOP_LPCR_HOST_BAND(0)) &
+			MT_TOP_LPCR_HOST_FW_OWN, 0);
+}
+
+/* The MT7915's DPD calibration channels are its own list: a channel only
+ * it has gets an index, one only the others have doesn't.
+ */
+static void mt7915_mcu2_dpd_freq_idx_mt7915(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u32 rev = dev->mt76.rev;
+	int v2;
+
+	v2 = mt7915_dpd_freq_idx(dev, 5180, 0);
+	dev->mt76.rev = 0x79150000;
+	KUNIT_EXPECT_GE(test, mt7915_dpd_freq_idx(dev, 5180, 0), 0);
+	KUNIT_EXPECT_GE(test, mt7915_dpd_freq_idx(dev, 2412, 0), 0);
+	dev->mt76.rev = rev;
+	KUNIT_EXPECT_GE(test, v2, 0);
+}
+
 /* A channel switch with no memory for the message fails cleanly. */
 static void mt7915_mcu2_update_bss_rfch_nomem(struct kunit *test)
 {
@@ -4473,6 +4525,8 @@ static struct kunit_case mt7915_mcu2_misc_cases[] = {
