 	KUNIT_EXPECT_EQ(test, q->flags, flags);
 }
 
+/* WED version 3's reorder indication ring: reset with its indexes and
+ * handed to the hardware full (its descriptors are the hardware's to
+ * write, no buffers of the host's), then WED is told where it is.
+ */
+static void mt76_wed_test_dma_setup_rro_ind(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_wed_test_dev(test);
+	struct mt76_test_wed *w = mt76_test_wed_init(test, &dev->mmio.wed);
+	struct mt76_queue *q;
+
+	q = mt76_wed_test_queue(test, dev, MT_WED_RRO_Q_IND);
+	q->desc = kunit_kcalloc(test, q->ndesc,
+				sizeof(struct mt76_wed_rro_desc), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, q->desc);
+	writel(2, &q->regs->dma_idx);
+
+	KUNIT_EXPECT_EQ(test, mt76_wed_dma_setup(dev, q, false), 0);
+	KUNIT_EXPECT_EQ(test, w->n_ind, 1);
+	KUNIT_EXPECT_EQ(test, readl(&q->regs->dma_idx), 0);
+	KUNIT_EXPECT_EQ(test, q->flags, MT_WED_RRO_Q_IND);
+}
+
 /* --- reset, offload ----------------------------------------------------------- */
 
 /* The DMA reset handshake with the Ethernet driver's WED reset: only while
@@ -377,6 +401,20 @@ static void mt76_wed_test_dma_reset(struct kunit *test)
 	clear_bit(MT76_STATE_WED_RESET, &dev->phy.state);
 }
 
+/* WED never saying its reset is done: the host gives up after 3 s. */
+static void mt76_wed_test_dma_reset_timeout(struct kunit *test)
+{
+	struct mt76_dev *dev = mt76_wed_test_dev(test);
+	struct mt76_mmio *mmio = &dev->mmio;
+
+	init_completion(&mmio->wed_reset);
+	init_completion(&mmio->wed_reset_complete);
+	set_bit(MT76_STATE_WED_RESET, &dev->phy.state);
+	mt76_wed_dma_reset(dev);
+	KUNIT_EXPECT_TRUE(test, completion_done(&mmio->wed_reset));
+	clear_bit(MT76_STATE_WED_RESET, &dev->phy.state);
+}
+
 /* A traffic control (flow offload) setup goes to WED, or is refused when
  * there's none.
  */
@@ -486,6 +524,8 @@ static struct kunit_case mt76_wed_test_cases[] = {
 	KUNIT_CASE(mt76_wed_test_dma_setup_none),
