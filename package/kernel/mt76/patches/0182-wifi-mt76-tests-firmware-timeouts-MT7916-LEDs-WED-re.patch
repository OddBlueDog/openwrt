 /* /lib/firmware/@name, for request_firmware() (the VM's root file system
  * is a throwaway copy)
  */
+/* the file at @data (a path) removed again, so that the next tests find
+ * the firmware directory as the VM ships it (some test what happens
+ * without a file)
+ */
+static void mt7915_replay_test_unlink(void *data)
+{
+	struct dentry *parent;
+	struct path path;
+
+	if (kern_path(data, 0, &path))
+		return;
+	parent = dget_parent(path.dentry);
+	inode_lock_nested(d_inode(parent), I_MUTEX_PARENT);
+	vfs_unlink(mnt_idmap(path.mnt), d_inode(parent), path.dentry, NULL);
+	inode_unlock(d_inode(parent));
+	dput(parent);
+	path_put(&path);
+}
+
