+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for mt76 core helpers. Included at the end of mac80211.c when
+ * CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU test build only).
+ */
+#include <kunit/test.h>
+
+/* DFS state must only be off while the phy is actually on a scan channel. */
+static void mt76_test_dfs_state_during_scan(struct kunit *test)
+{
+	struct ieee80211_channel chan = {
+		.band = NL80211_BAND_5GHZ,
+		.center_freq = 5500,
+		.flags = IEEE80211_CHAN_RADAR,
+	};
+	struct ieee80211_hw *hw;
+	struct mt76_dev *dev;
+	struct mt76_phy *phy;
+
+	dev = kunit_kzalloc(test, sizeof(*dev), GFP_KERNEL);
+	hw = kunit_kzalloc(test, sizeof(*hw), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev);
+	KUNIT_ASSERT_NOT_NULL(test, hw);
+
+	phy = &dev->phy;
+	phy->dev = dev;
+	phy->hw = hw;
+	phy->chandef.chan = &chan;
+	dev->region = NL80211_DFS_ETSI;
+	/* monitor on a radar channel: active without needing a wiphy */
+	hw->conf.flags = IEEE80211_CONF_MONITOR;
+
+	KUNIT_EXPECT_EQ(test, mt76_phy_dfs_state(phy), MT_DFS_STATE_ACTIVE);
+
+	/* sw scan, back on the operating channel: detection stays on */
+	set_bit(MT76_SCANNING, &phy->state);
+	phy->offchannel = false;
+	KUNIT_EXPECT_EQ(test, mt76_phy_dfs_state(phy), MT_DFS_STATE_ACTIVE);
+
+	/* sw scan, on a scan channel: off */
+	phy->offchannel = true;
+	KUNIT_EXPECT_EQ(test, mt76_phy_dfs_state(phy), MT_DFS_STATE_DISABLED);
+
+	/* no DFS region: off */
+	clear_bit(MT76_SCANNING, &phy->state);
+	phy->offchannel = false;
+	dev->region = NL80211_DFS_UNSET;
+	KUNIT_EXPECT_EQ(test, mt76_phy_dfs_state(phy), MT_DFS_STATE_DISABLED);
+}
+
+static bool mt76_test_wcid_used(u32 *mask, int idx)
+{
+	return mask[idx / 32] & BIT(idx % 32);
+}
+
+/* Allocations stay inside [min, size), lowest free first. */
+static void mt76_test_wcid_alloc_ranges(struct kunit *test)
+{
+	u32 mask[DIV_ROUND_UP(MT76_N_WCIDS, 32)] = {};
+	int i;
+
+	KUNIT_EXPECT_EQ(test, mt76_wcid_alloc(mask, 288), 0);
+	KUNIT_EXPECT_EQ(test, mt76_wcid_alloc(mask, 288), 1);
+
+	/* an offset range returns absolute indices and marks them used */
+	for (i = 256; i < 272; i++) {
+		KUNIT_EXPECT_EQ(test, __mt76_wcid_alloc(mask, 256, 272), i);
+		KUNIT_EXPECT_TRUE(test, mt76_test_wcid_used(mask, i));
+	}
+	KUNIT_EXPECT_EQ(test, __mt76_wcid_alloc(mask, 256, 272), -1);
+
+	/* the low range is unaffected */
+	KUNIT_EXPECT_FALSE(test, mt76_test_wcid_used(mask, 2));
+	KUNIT_EXPECT_EQ(test, mt76_wcid_alloc(mask, 288), 2);
+}
+
+static struct kunit_case mt76_core_test_cases[] = {
+	KUNIT_CASE(mt76_test_dfs_state_during_scan),
+	KUNIT_CASE(mt76_test_wcid_alloc_ranges),
+	{}
+};
+
+static struct kunit_suite mt76_core_test_suite = {
+	.name = "mt76-core",
+	.test_cases = mt76_core_test_cases,
+};
+
+kunit_test_suites(&mt76_core_test_suite);
