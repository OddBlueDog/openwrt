+/* --- tx power ---------------------------------------------------------- */
+
+static struct ieee80211_channel *
+mt7915_init_test_chan(struct ieee80211_supported_band *sband, int hw_value)
+{
+	int i;
+
+	for (i = 0; i < sband->n_channels; i++)
+		if (sband->channels[i].hw_value == hw_value)
+			return &sband->channels[i];
+	return NULL;
+}
+
+/* Each channel's max power: the best chain's eeprom target power plus the
+ * band's rate delta, plus the 4 chain combining gain (12 half-dB), in dBm
+ * (rounded up from half-dB), capped by the regulatory limit.
+ */
+static void mt7915_init_test_txpower(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_device(test,
+							 MT7976_ONE_ADIE_DBDC,
+							 NULL);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	struct ieee80211_channel *ch1, *ch11, *ch36, *ch100;
+
+	ch1 = mt7915_init_test_chan(&dev->mphy.sband_2g.sband, 1);
+	ch11 = mt7915_init_test_chan(&dev->mphy.sband_2g.sband, 11);
+	ch36 = mt7915_init_test_chan(&phy2->mt76->sband_5g.sband, 36);
+	ch100 = mt7915_init_test_chan(&phy2->mt76->sband_5g.sband, 100);
+	KUNIT_ASSERT_NOT_NULL(test, ch1);
+	KUNIT_ASSERT_NOT_NULL(test, ch11);
+	KUNIT_ASSERT_NOT_NULL(test, ch36);
+	KUNIT_ASSERT_NOT_NULL(test, ch100);
+	ch1->max_reg_power = 30;
+	ch11->max_reg_power = 10;
+	ch36->max_reg_power = 30;
+	ch100->max_reg_power = 30;
+	dev->phy.sku_path_en = true;
+
+	mt7915_init_txpower(&dev->phy);
+	/* (max(14, 20, 16, 12) + 2 + 12) / 2 */
+	KUNIT_EXPECT_EQ(test, ch1->orig_mpwr, 17);
+	KUNIT_EXPECT_EQ(test, ch1->max_power, 17);
+	KUNIT_EXPECT_EQ(test, ch11->orig_mpwr, 17);
+	KUNIT_EXPECT_EQ(test, ch11->max_power, 10);
+	KUNIT_EXPECT_TRUE(test, dev->phy.sku_limit_en);
+	/* no per path limits in the device tree */
+	KUNIT_EXPECT_FALSE(test, dev->phy.sku_path_en);
+
+	mt7915_init_txpower(phy2);
+	/* (10 - 3 + 12) / 2, rounded up */
+	KUNIT_EXPECT_EQ(test, ch36->orig_mpwr, 10);
+	KUNIT_EXPECT_EQ(test, ch100->max_power, 10);
+
+	/* with 2 chains the combining gain is 6 half-dB */
+	dev->mphy.chainmask = 0x3;
+	mt7915_init_txpower(&dev->phy);
+	/* (max(14, 20) + 2 + 6) / 2 */
+	KUNIT_EXPECT_EQ(test, ch1->orig_mpwr, 14);
+
+	/* no phy, nothing to do */
+	mt7915_init_txpower(NULL);
+}
+
+static bool mt7915_init_test_rdd_sent(struct mt76_test_fake *fake, u8 cmd)
+{
+	struct mt76_test_msg *msg;
+
+	list_for_each_entry(msg, &fake->msgs, list)
+		if (msg->cmd == MCU_EXT_CMD(SET_RDD_CTRL) && msg->data[0] == cmd)
+			return true;
+	return false;
+}
+
+/* A regulatory change records the country and DFS region, stops the
+ * background radar chain when there's no DFS region any more, recomputes
+ * the power limits and restarts radar detection from scratch.
+ */
+static void mt7915_init_test_regd_notifier(struct kunit *test)
+{
+	struct mt76_test_fake *fake;
+	struct mt7915_dev *dev = mt7915_init_test_device(test,
+							 MT7976_ONE_ADIE_DBDC,
+							 &fake);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	struct wiphy *wiphy2 = phy2->mt76->hw->wiphy;
+	struct regulatory_request req = {
+		.alpha2 = "DE",
+		.dfs_region = NL80211_DFS_ETSI,
+	};
+	struct ieee80211_channel *ch36;
+	struct mt76_test_msg *msg;
+
+	ch36 = mt7915_init_test_chan(&phy2->mt76->sband_5g.sband, 36);
+	KUNIT_ASSERT_NOT_NULL(test, ch36);
+	KUNIT_ASSERT_PTR_EQ(test, phy2->mt76->chandef.chan, ch36);
+	ch36->max_reg_power = 5;
+	ch36->max_power = 30;
+	mt7915_init_test_clear(fake);
+
+	phy2->mt76->dfs_state = MT_DFS_STATE_ACTIVE;
+	mt7915_regd_notifier(wiphy2, &req);
+	KUNIT_EXPECT_MEMEQ(test, dev->mt76.alpha2, "DE", 2);
+	KUNIT_EXPECT_EQ(test, dev->mt76.region, NL80211_DFS_ETSI);
+	KUNIT_EXPECT_EQ(test, ch36->max_power, 5);
+	/* 36 isn't a radar channel: detection restarted as disabled */
+	KUNIT_EXPECT_EQ(test, phy2->mt76->dfs_state, MT_DFS_STATE_DISABLED);
+	KUNIT_EXPECT_TRUE(test, mt7915_init_test_rdd_sent(fake,
+							  RDD_NORMAL_START));
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(SET_RDD_CTRL));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->data[0], RDD_STOP);
+	KUNIT_EXPECT_EQ(test, msg->data[1], MT_RDD_IDX_BAND1);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(OFFCH_SCAN_CTRL)), 0);
+
+	/* back to no DFS region: the background chain is stopped first */
+	mt7915_init_test_clear(fake);
+	req.dfs_region = NL80211_DFS_UNSET;
+	mt7915_regd_notifier(wiphy2, &req);
+	KUNIT_EXPECT_EQ(test, dev->mt76.region, NL80211_DFS_UNSET);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_RDD_CTRL));
+	KUNIT_EXPECT_EQ(test, msg->data[0], RDD_STOP);
+	KUNIT_EXPECT_EQ(test, msg->data[1], MT_RDD_IDX_BACKGROUND);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(OFFCH_SCAN_CTRL)), 1);
+
+	/* band 0 has no radar detection at all */
+	mt7915_init_test_clear(fake);
+	mt7915_regd_notifier(dev->mt76.hw->wiphy, &req);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.dfs_state, MT_DFS_STATE_UNKNOWN);
+}
