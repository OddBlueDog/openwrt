+/* The roaming check itself: only other AP interfaces are searched. */
+static void mt7915_main_test_drop_other_sta(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *ap, *ap2, *mesh;
+	struct drop_sta_iter data = { .dev = dev, .hw = hw };
+
+	ap = mt7915_main_test_ap(test, hw, 1);
+	ap2 = mt7915_main_test_ap(test, hw, 2);
+	mesh = mt7915_main_test_vif(test, NL80211_IFTYPE_MESH_POINT, 3);
+	mt7915_main_test_clear(fake);
+	data.vif = ap;
+	data.sta_addr[0] = 0x02;
+
+	/* not the interface the station authorizes on, not a mesh */
+	__mt7915_drop_sta(&data, ap->addr, ap);
+	__mt7915_drop_sta(&data, mesh->addr, mesh);
+	/* another AP mac80211 knows no such station on */
+	__mt7915_drop_sta(&data, ap2->addr, ap2);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+}
