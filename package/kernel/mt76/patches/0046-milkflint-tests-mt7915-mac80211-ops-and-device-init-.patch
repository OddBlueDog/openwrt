+/* --- MAC init ---------------------------------------------------------------- */
+
+/* Device-wide MAC init: rx length, hardware de-aggregation, all WTBL
+ * counters cleared, both bands' MAC set up, LED pins muxed and airtime
+ * fairness on (MT7986).
+ */
+static void mt7915_init_test_mac_init(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_hif hif2 = {};
+	u32 val;
+	int band;
+
+	dev->dbdc_support = true;
+	mt76_wr(dev, MT_MDP_DCR2, MT_MDP_DCR2_RX_TRANS_SHORT);
+	mt76_wr(dev, MT_DMA_DCR0(1), MT_DMA_DCR0_RXD_G5_EN);
+	mt76_wr(dev, MT_WTBLOFF_TOP_ACR(0), MT_WTBLOFF_TOP_ADM_BACKOFFTIME);
+	mt76_wr(dev, MT_WF_RMAC_MIB_AIRTIME0(1), MT_WF_RMAC_MIB_OBSS_BACKOFF);
+
+	mt7915_mac_init(dev);
+
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_MDP_DCR1_MAX_RX_LEN,
+					mt76_rr(dev, MT_MDP_DCR1)), 0x680);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_MDP_DCR2) &
+			MT_MDP_DCR2_RX_TRANS_SHORT, 0);
+	KUNIT_EXPECT_NE(test, mt76_rr(dev, MT_MDP_DCR0) &
+			MT_MDP_DCR0_DAMSDU_EN, 0);
+	/* the last WTBL entry was the last one cleared */
+	val = mt76_rr(dev, MT_WTBL_UPDATE);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_WTBL_UPDATE_WLAN_IDX, val),
+			MT7916_WTBL_SIZE - 1);
+	KUNIT_EXPECT_NE(test, val & MT_WTBL_UPDATE_ADM_COUNT_CLEAR, 0);
+	/* no second PCIe interface: qid 6 isn't moved */
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WF_PP_TOP_RXQ_WFDMA_CF_5), 0);
+
+	for (band = 0; band < 2; band++) {
+		val = mt76_rr(dev, MT_TMAC_CTCR0(band));
+		KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TMAC_CTCR0_INS_DDLMT_REFTIME,
+						val), 0x3f);
+		KUNIT_EXPECT_NE(test, val & MT_TMAC_CTCR0_INS_DDLMT_EN, 0);
+		KUNIT_EXPECT_NE(test, val &
+				MT_TMAC_CTCR0_INS_DDLMT_VHT_SMPDU_EN, 0);
+		val = mt76_rr(dev, MT_MDP_BNRCFR0(band));
+		KUNIT_EXPECT_EQ(test, FIELD_GET(MT_MDP_RCFR0_MCU_RX_MGMT, val),
+				MT_MDP_TO_HIF);
+		KUNIT_EXPECT_EQ(test, FIELD_GET(MT_MDP_RCFR0_MCU_RX_CTL_BAR,
+						val), MT_MDP_TO_HIF);
+		val = mt76_rr(dev, MT_MDP_BNRCFR1(band));
+		KUNIT_EXPECT_EQ(test, FIELD_GET(MT_MDP_RCFR1_RX_DROPPED_UCAST,
+						val), MT_MDP_TO_HIF);
+		val = mt76_rr(dev, MT_DMA_DCR0(band));
+		KUNIT_EXPECT_EQ(test, FIELD_GET(MT_DMA_DCR0_MAX_RX_LEN, val),
+				0x680);
+		KUNIT_EXPECT_EQ(test, val & MT_DMA_DCR0_RXD_G5_EN, 0);
+		KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WF_RMAC_RSVD0(band)),
+				MT_WF_RMAC_RSVD0_EIFS_CLR);
+		KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WTBLOFF_TOP_ACR(band)) &
+				MT_WTBLOFF_TOP_ADM_BACKOFFTIME, 0);
+		val = mt76_rr(dev, MT_WF_RMAC_MIB_AIRTIME0(band));
+		KUNIT_EXPECT_EQ(test, FIELD_GET(MT_WF_RMAC_MIB_ED_OFFSET, val),
+				4);
+		KUNIT_EXPECT_EQ(test, FIELD_GET(MT_WF_RMAC_MIB_OBSS_BACKOFF,
+						val), 0);
+		val = mt76_rr(dev, MT_WTBLOFF_TOP_RSCR(band));
+		KUNIT_EXPECT_EQ(test, FIELD_GET(MT_WTBLOFF_TOP_RSCR_RCPI_PARAM,
+						val), 3);
+		/* tx durations keep the backoff time on the MT7986 */
+		KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_AGG_ATCR0(band)) &
+				MT_AGG_ATCR_MAC_BFF_TIME_EN, 0);
+		/* without WED tx status stays per MPDU */
+		KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_AGG_ACR4(band)) &
+				MT_AGG_ACR_PPDU_TXS2H, 0);
+	}
+
+	/* DBDC: both LED pins */
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LED_GPIO_MUX0) & GENMASK(11, 4),
+			0x110);
+	KUNIT_EXPECT_TRUE(test, dev->vow_atf_en);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(SET_DRR_CTRL)), 2);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(SET_FEATURE_CTRL)), 1);
+
+	/* a second interface takes rx queue 6 */
+	dev->hif2 = &hif2;
+	mt7915_mac_init(dev);
+	KUNIT_EXPECT_NE(test, mt76_rr(dev, MT_WF_PP_TOP_RXQ_WFDMA_CF_5) &
+			MT_WF_PP_TOP_RXQ_QID6_WFDMA_HIF_SEL_MASK, 0);
+	dev->hif2 = NULL;
+}
