+/* The firmware's BSS groups: hw BSSIDs 0-3 of band 0 are 0-3, of band 1
+ * 4-7; extended BSSIDs 1-15 are 9-23 on band 0 and 25-39 on band 1.
+ */
+static void mt7915_init_test_vow_bss_grp(struct kunit *test)
+{
+	static const struct {
+		u8 band, omac, grp;
+	} cases[] = {
+		{ 0, HW_BSSID_0, 0 },
+		{ 0, HW_BSSID_3, 3 },
+		{ 1, HW_BSSID_0, 4 },
+		{ 1, HW_BSSID_3, 7 },
+		{ 0, EXT_BSSID_1, 9 },
+		{ 0, EXT_BSSID_MAX, 23 },
+		{ 1, EXT_BSSID_1, 25 },
+		{ 1, EXT_BSSID_MAX, 39 },
+	};
+	struct mt76_vif_link mvif = {};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		mvif.band_idx = cases[i].band;
+		mvif.omac_idx = cases[i].omac;
+		KUNIT_EXPECT_EQ_MSG(test, mt7915_vow_sta_bss_grp(&mvif),
+				    cases[i].grp, "case %d", i);
+	}
+}
