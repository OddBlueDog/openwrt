+/* --- ethtool ---------------------------------------------------------------- */
+
+static int mt7915_main_test_stat_idx(const char *name)
+{
+	int i;
+
+	for (i = 0; i < MT7915_SSTATS_LEN; i++)
+		if (!strcmp(mt7915_gstrings_stats[i], name))
+			return i;
+	return -1;
+}
+
+/* ethtool stats: the names, their count (plus page pool stats) and the
+ * values, which must sit at their name's index.
+ */
+static void mt7915_main_test_ethtool(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct mt76_mib_stats *mib = &dev->phy.mib;
+	struct ieee80211_vif *vif;
+	int n = MT7915_MAIN_TEST_OP(get_et_sset_count)(hw, NULL, ETH_SS_STATS);
+	u64 *data;
+	u8 *strings;
+	int i;
+
+	KUNIT_EXPECT_EQ(test, n, MT7915_SSTATS_LEN +
+			page_pool_ethtool_stats_get_count());
+	KUNIT_EXPECT_EQ(test, MT7915_MAIN_TEST_OP(get_et_sset_count)(hw, NULL,
+			ETH_SS_PRIV_FLAGS), 0);
+
+	strings = kunit_kzalloc(test, n * ETH_GSTRING_LEN, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, strings);
+	mt7915_get_et_strings(hw, NULL, ETH_SS_TEST, strings);
+	KUNIT_EXPECT_EQ(test, strings[0], 0);
+	mt7915_get_et_strings(hw, NULL, ETH_SS_STATS, strings);
+	KUNIT_EXPECT_STREQ(test, (char *)strings, "tx_ampdu_cnt");
+	KUNIT_EXPECT_STREQ(test, (char *)strings +
+			   (MT7915_SSTATS_LEN - 1) * ETH_GSTRING_LEN,
+			   "v_tx_nss_4");
+	/* page pool names follow, when the kernel has them */
+	if (n > MT7915_SSTATS_LEN)
+		KUNIT_EXPECT_NE(test,
+				strings[MT7915_SSTATS_LEN * ETH_GSTRING_LEN], 0);
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	mib->tx_ampdu_cnt = 1001;
+	mib->ba_miss_cnt = 1002;
+	mib->tx_bf_fb_trig_cnt = 1003;
+	mib->tx_amsdu[7] = 1004;
+	mib->rx_fifo_full_cnt = 1005;
+	mib->rx_ba_cnt = 1006;
+	mib->dl_he_gtr16ru_cnt = 1007;
+	mib->ul_hetrig_4mu_cnt = 1008;
+	dev->mphy.aggr_stats[14] = 1009;
+
+	data = kunit_kcalloc(test, n, sizeof(*data), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	for (i = 0; i < n; i++)
+		data[i] = 0xdead;
+	mt7915_get_et_stats(hw, vif, NULL, data);
+	KUNIT_EXPECT_EQ(test, data[mt7915_main_test_stat_idx("tx_ampdu_cnt")],
+			mib->tx_ampdu_cnt);
+	KUNIT_EXPECT_EQ(test, data[mt7915_main_test_stat_idx("ba_miss_count")],
+			mib->ba_miss_cnt);
+	KUNIT_EXPECT_EQ(test, data[mt7915_main_test_stat_idx(
+			"tx_beamformee_feedback_trig")], mib->tx_bf_fb_trig_cnt);
+	KUNIT_EXPECT_EQ(test, data[mt7915_main_test_stat_idx(
+			"tx_msdu_pack_8")], mib->tx_amsdu[7]);
+	KUNIT_EXPECT_EQ(test, data[mt7915_main_test_stat_idx(
+			"rx_fifo_full_cnt")], mib->rx_fifo_full_cnt);
+	KUNIT_EXPECT_EQ(test, data[mt7915_main_test_stat_idx("rx_ba_cnt")],
+			mib->rx_ba_cnt);
+	KUNIT_EXPECT_EQ(test, data[mt7915_main_test_stat_idx(
+			"dl_he_gtr16ru_cnt")], mib->dl_he_gtr16ru_cnt);
+	KUNIT_EXPECT_EQ(test, data[mt7915_main_test_stat_idx(
+			"ul_hetrig_4mu_cnt")], mib->ul_hetrig_4mu_cnt);
+	KUNIT_EXPECT_EQ(test, data[mt7915_main_test_stat_idx(
+			"tx_ampdu_len:224-247")], 1009);
+	/* no station of this vif: the per-vif counters are left alone */
+	KUNIT_EXPECT_EQ(test, data[mt7915_main_test_stat_idx("v_tx_mode_cck")],
+			0xdead);
+}
