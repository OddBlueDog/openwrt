+	capa = le16_to_cpu(data->he_6ghz_capa.capa);
+	KUNIT_EXPECT_NE(test, capa & IEEE80211_HE_6GHZ_CAP_TX_ANTPAT_CONS, 0);
+	KUNIT_EXPECT_NE(test, capa & IEEE80211_HE_6GHZ_CAP_RX_ANTPAT_CONS, 0);
+	KUNIT_EXPECT_EQ(test, u16_get_bits(capa,
+			IEEE80211_HE_6GHZ_CAP_MIN_MPDU_START),
