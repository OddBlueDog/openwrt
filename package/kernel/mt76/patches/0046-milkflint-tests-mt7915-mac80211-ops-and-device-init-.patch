+/* The MT7915 has a smaller rx length, excludes the backoff from tx
+ * durations, and no airtime fairness (cheap: the chip id is all it checks).
+ */
+static void mt7915_init_test_mac_init_mt7915(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	dev->mt76.rev = 0x79150000;
+	mt76_wr(dev, MT_PLE_HOST_RPT0, MT_PLE_HOST_RPT0_TX_LATENCY);
+	mt7915_mac_init(dev);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_MDP_DCR1_MAX_RX_LEN,
+					mt76_rr(dev, MT_MDP_DCR1)), 0x400);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_PLE_HOST_RPT0) &
+			MT_PLE_HOST_RPT0_TX_LATENCY, 0);
+	KUNIT_EXPECT_NE(test, mt76_rr(dev, MT_AGG_ATCR0(1)) &
+			MT_AGG_ATCR_MAC_BFF_TIME_EN, 0);
+	KUNIT_EXPECT_FALSE(test, dev->vow_atf_en);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	dev->mt76.rev = 0x79860000;
+}
+
+/* LED pin muxing per chip: two LED pins with DBDC, otherwise the second
+ * pin if the board selects it, else the first.
+ */
+static void mt7915_init_test_led_mux(struct kunit *test)
+{
+	static const struct {
+		u32 rev;
+		bool dbdc;
+		u8 pin;
+		u32 reg;
+		u32 mask;
+		u32 val;
+	} cases[] = {
+		{ 0x79860000, true, 0, MT_LED_GPIO_MUX0, GENMASK(11, 4), 0x110 },
+		{ 0x79860000, false, 1, MT_LED_GPIO_MUX0, GENMASK(11, 4), 0x100 },
+		{ 0x79860000, false, 0, MT_LED_GPIO_MUX0, GENMASK(11, 4), 0x010 },
+		{ 0x79150000, true, 0, MT_LED_GPIO_MUX2, GENMASK(11, 8), 0x400 },
+		{ 0x79150000, false, 1, MT_LED_GPIO_MUX3, GENMASK(11, 8), 0x400 },
+		{ 0x79150000, false, 0, MT_LED_GPIO_MUX2, GENMASK(11, 8), 0x400 },
+	};
+	struct mt7915_dev *dev = mt7915_init_test_chip(test, 0);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		mt76_wr(dev, MT_LED_GPIO_MUX0, 0);
+		mt76_wr(dev, MT_LED_GPIO_MUX1, 0);
+		mt76_wr(dev, MT_LED_GPIO_MUX2, 0);
+		mt76_wr(dev, MT_LED_GPIO_MUX3, 0);
+		dev->mt76.rev = cases[i].rev;
+		dev->dbdc_support = cases[i].dbdc;
+		dev->mphy.leds.pin = cases[i].pin;
+		mt7915_init_led_mux(dev);
+		KUNIT_EXPECT_EQ_MSG(test, mt76_rr(dev, cases[i].reg) &
+				    cases[i].mask, cases[i].val, "case %d", i);
+		/* the MT7915 with DBDC uses both its pins */
+		if (cases[i].rev == 0x79150000 && cases[i].dbdc)
+			KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LED_GPIO_MUX3) &
+					GENMASK(11, 8), 0x400);
+	}
+	/* other chips: nothing */
+	mt76_wr(dev, MT_LED_GPIO_MUX0, 0);
+	dev->mt76.rev = 0x79810000;
+	dev->dbdc_support = true;
+	mt7915_init_led_mux(dev);
+	dev->dbdc_support = false;
+	mt7915_init_led_mux(dev);
+	dev->mphy.leds.pin = 0;
+	mt7915_init_led_mux(dev);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LED_GPIO_MUX0), 0);
+	dev->mt76.rev = 0x79860000;
+}
+
+/* The MT7916 muxes its LED pins on GPIO 14/15. mt7915_init_led_mux()
+ * matches its chip id as 0x7916, but the MT7916's is 0x7906 (is_mt7916()),
+ * so it never muxes them.
+ */
+static void mt7915_init_test_led_mux_mt7916(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+
+	kunit_skip(test, "driver bug: mt7915_init_led_mux() checks chip 0x7916, the MT7916 is 0x7906");
+
+	dev = mt7915_init_test_chip(test, 0);
+	dev->mt76.rev = 0x79060000;
+	dev->dbdc_support = true;
+	mt7915_init_led_mux(dev);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LED_GPIO_MUX1) & GENMASK(31, 24),
+			0x33000000);
+	dev->mt76.rev = 0x79860000;
+}
+
+static u32 mt7915_init_test_led_ctrl;
+static bool mt7915_init_test_led_kicked;
+
+/* notes a read of LED_CTRL with the kick bit set */
+static u32 mt7915_init_test_led_hook(struct mt76_test_fake *fake, u32 addr,
+				     u32 val)
+{
+	if (addr == mt7915_init_test_led_ctrl && (val & MT_LED_CTRL_KICK))
+		mt7915_init_test_led_kicked = true;
+	return val;
+}
+
+/* The LED is driven in PWM mode: on and off times in 10 ms ticks (at least
+ * one), brightness as always on or always off, kicked on the phy's band
+ * with the board's polarity.
+ */
+static void mt7915_init_test_leds(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt76_phy *mphy = &dev->mphy;
+	unsigned long on = 100, off = 5;
+	struct mt7915_phy *phy2;
+	u32 val;
+
+	/* the fake's address for LED_CTRL(0) */
+	mt76_wr(dev, MT_LED_CTRL(0), 0);
+	mt7915_init_test_led_ctrl = fake->last_addr;
+	mt7915_init_test_led_kicked = false;
+	fake->rr_hook = mt7915_init_test_led_hook;
+
+	mt7915_led_set_brightness(&mphy->leds.cdev, LED_OFF);
+	val = mt76_rr(dev, MT_LED_STATUS_0(0));
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_LED_STATUS_DURATION, val), 0xffff);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_LED_STATUS_ON, val), 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_LED_STATUS_OFF, val), 0xff);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LED_STATUS_1(0)), val);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LED_EN(0)), 1);
+	/* kicked, then the kick bit dropped */
+	KUNIT_EXPECT_TRUE(test, mt7915_init_test_led_kicked);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LED_CTRL(0)), 0);
+	fake->rr_hook = NULL;
+
+	/* through the LED class callback, as the LED core calls it */
+	mphy->leds.cdev.brightness_set = mt7915_led_set_brightness;
+	READ_ONCE(mphy->leds.cdev.brightness_set)(&mphy->leds.cdev, LED_FULL);
+	val = mt76_rr(dev, MT_LED_STATUS_0(0));
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_LED_STATUS_ON, val), 0xff);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_LED_STATUS_OFF, val), 0);
+
+	KUNIT_EXPECT_EQ(test, mt7915_led_set_blink(&mphy->leds.cdev, &on, &off),
+			0);
+	val = mt76_rr(dev, MT_LED_STATUS_0(0));
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_LED_STATUS_ON, val), 10);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_LED_STATUS_OFF, val), 10);
+	on = 0;
+	off = 250;
+	mt7915_led_set_blink(&mphy->leds.cdev, &on, &off);
+	val = mt76_rr(dev, MT_LED_STATUS_0(0));
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_LED_STATUS_ON, val), 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_LED_STATUS_OFF, val), 25);
+
+	/* band 1, active low */
+	dev->dbdc_support = true;
+	phy2 = mt7915_alloc_ext_phy(dev);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(phy2));
+	dev->mphy.leds.al = true;
+	mt7915_led_set_brightness(&phy2->mt76->leds.cdev, LED_FULL);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LED_CTRL(1)),
+			MT_LED_CTRL_POLARITY | MT_LED_CTRL_BAND);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LED_EN(1)), 1);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_LED_STATUS_ON,
+					mt76_rr(dev, MT_LED_STATUS_1(1))), 0xff);
+	ieee80211_free_hw(phy2->mt76->hw);
+}
