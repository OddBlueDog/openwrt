+/* SAR limits apply to a valid channel only and are pushed with the tx
+ * power table; invalid specs are refused.
+ */
+static void mt7915_main_test_set_sar_specs(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct cfg80211_sar_specs *sar;
+
+	sar = kunit_kzalloc(test, struct_size(sar, sub_specs, 1), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sar);
+	sar->type = NL80211_SAR_TYPE_POWER;
+	sar->num_sub_specs = 1;
+	sar->sub_specs[0].power = 40;
+	sar->sub_specs[0].freq_range_index = 0;
+
+	KUNIT_ASSERT_EQ(test, mt7915_set_sar_specs(hw, sar), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.frp[0].power, 20);
+	KUNIT_EXPECT_NOT_NULL(test, mt76_test_find_msg(fake,
+			MCU_EXT_CMD(TX_POWER_FEATURE_CTRL)));
+
+	mt7915_main_test_clear(fake);
+	sar->num_sub_specs = 0;
+	KUNIT_EXPECT_EQ(test, mt7915_set_sar_specs(hw, sar), -EINVAL);
+
+	sar->num_sub_specs = 1;
+	dev->mphy.chandef.chan = NULL;
+	KUNIT_EXPECT_EQ(test, mt7915_set_sar_specs(hw, sar), -EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+}
