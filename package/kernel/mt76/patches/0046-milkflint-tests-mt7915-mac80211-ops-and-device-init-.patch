+/* Per-station tx power: the frame minimum goes to 0 first, then the
+ * station's limit, as half-dB offsets of the limit (after the 4 chain
+ * combining gain) from the per-rate powers the firmware reports, for the
+ * station's rate groups (CCK and OFDM skipped: HT rates first).
+ */
+static void mt7915_main_test_sta_txpwr(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_main_test_fw *fw = fake->priv;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt76_test_msg *msg;
+	int offs = mt7915_sku_group_len[SKU_CCK] +
+		   mt7915_sku_group_len[SKU_OFDM];
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	sta->deflink.ht_cap.ht_supported = true;
+	fw->sku = true;
+	fw->sku_val[offs][0] = 10;	/* band 0's power of HT MCS 0 */
+	fw->sku_val[offs][1] = 30;
+	dev->mphy.txpower_cur = 40;
+	mt7915_main_test_clear(fake);
+
+	sta->deflink.txpwr.type = NL80211_TX_POWER_LIMITED;
+	sta->deflink.txpwr.power = 15;
+	KUNIT_ASSERT_EQ(test, mt7915_sta_set_txpwr(hw, vif, sta), 0);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(TX_POWER_FEATURE_CTRL));
+	KUNIT_EXPECT_EQ(test, msg->data[0], TX_POWER_LIMIT_FRAME_MIN);
+	KUNIT_EXPECT_EQ(test, msg->data[2], 0);		/* band */
+	KUNIT_EXPECT_EQ(test, (s8)msg->data[3], 0);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(TX_POWER_FEATURE_CTRL));
+	KUNIT_EXPECT_EQ(test, msg->data[0], TX_POWER_LIMIT_FRAME);
+	KUNIT_EXPECT_EQ(test, (s8)msg->data[5], 20);	/* max: txpower_cur */
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(msg->data + 6),
+			mt7915_main_test_msta(sta)->wcid.idx);
+	/* 15 dBm: 30 half-dB, less 12 for 4 chains, less 10, halved */
+	KUNIT_EXPECT_EQ(test, (s8)msg->data[8], 4);
+	KUNIT_EXPECT_EQ(test, (s8)msg->data[9], 9);
+
+	/* "automatic": no limit, no offsets (a single chain, see
+	 * mt7915_main_test_sta_txpwr_auto() for more)
+	 */
+	mt7915_main_test_clear(fake);
+	dev->mphy.chainmask = 0x1;
+	sta->deflink.txpwr.type = NL80211_TX_POWER_AUTOMATIC;
+	KUNIT_ASSERT_EQ(test, mt7915_sta_set_txpwr(hw, vif, sta), 0);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(TX_POWER_FEATURE_CTRL));
+	KUNIT_EXPECT_EQ(test, msg->data[0], TX_POWER_LIMIT_FRAME);
+	KUNIT_EXPECT_EQ(test, msg->data[8], 0);
+	KUNIT_EXPECT_EQ(test, msg->data[9], 0);
+	dev->mphy.chainmask = 0xf;
+	sta->deflink.txpwr.type = NL80211_TX_POWER_LIMITED;
+
+	/* a limit above the current power is refused */
+	mt7915_main_test_clear(fake);
+	sta->deflink.txpwr.power = 40;
+	KUNIT_EXPECT_EQ(test, mt7915_sta_set_txpwr(hw, vif, sta), -EINVAL);
+
+	mt7915_main_test_clear(fake);
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_sta_set_txpwr(hw, vif, sta), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+}
