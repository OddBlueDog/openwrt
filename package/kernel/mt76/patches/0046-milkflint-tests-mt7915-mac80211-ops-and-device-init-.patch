+/* A monitor interface without an address becomes the band's monitor vif;
+ * as it isn't an AP on hw BSSID 1-3 it loses the encap offloads. Its BSS
+ * info has no rf channel or rate TLVs. Removing it clears monitor_vif.
+ */
+static void mt7915_main_test_add_monitor(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct mt76_test_msg *msg;
+
+	vif = mt7915_main_test_vif(test, NL80211_IFTYPE_MONITOR, 0);
+	eth_zero_addr(vif->addr);
+	vif->offload_flags = IEEE80211_OFFLOAD_ENCAP_ENABLED |
+			     IEEE80211_OFFLOAD_DECAP_ENABLED;
+	KUNIT_ASSERT_EQ(test, mt7915_add_interface(hw, vif), 0);
+	KUNIT_EXPECT_PTR_EQ(test, dev->phy.monitor_vif, vif);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_mvif(vif)->mt76.omac_idx,
+			HW_BSSID_0);
+	KUNIT_EXPECT_EQ(test, vif->offload_flags,
+			IEEE80211_OFFLOAD_ENCAP_4ADDR);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(BSS_INFO_UPDATE));
+	KUNIT_EXPECT_NOT_NULL(test, mt7915_main_test_tlv(msg, BSS_INFO_BASIC));
+	KUNIT_EXPECT_NULL(test, mt7915_main_test_tlv(msg, BSS_INFO_RF_CH));
+
+	mt7915_remove_interface(hw, vif);
+	KUNIT_EXPECT_NULL(test, dev->phy.monitor_vif);
+}
