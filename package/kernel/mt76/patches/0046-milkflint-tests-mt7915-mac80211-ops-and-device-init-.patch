+/* Removing a station takes it off the poll and rate control lists, and
+ * mt76 frees its wcid.
+ */
+static void mt7915_main_test_sta_remove(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	int idx;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	idx = msta->wcid.idx;
+	mt7915_main_test_add_poll(dev, &msta->wcid);
+	list_add_tail(&msta->rc_list, &dev->sta_rc_list);
+	KUNIT_ASSERT_FALSE(test, list_empty(&dev->mt76.sta_poll_list));
+
+	mt76_sta_pre_rcu_remove(hw, vif, sta);
+	KUNIT_EXPECT_NULL(test, rcu_access_pointer(dev->mt76.wcid[idx]));
+	KUNIT_ASSERT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_NONE,
+					     IEEE80211_STA_NOTEXIST), 0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->mt76.sta_poll_list));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->sta_rc_list));
+	KUNIT_EXPECT_FALSE(test, dev->mt76.wcid_mask[idx / 32] & BIT(idx % 32));
+	/* MT_WTBL_UPDATE was last told to clear this entry's counters */
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_WTBL_UPDATE_WLAN_IDX,
+					mt76_rr(dev, MT_WTBL_UPDATE)), idx);
+	KUNIT_EXPECT_NE(test, mt76_rr(dev, MT_WTBL_UPDATE) &
+			MT_WTBL_UPDATE_ADM_COUNT_CLEAR, 0);
+}
