+static void mt7915_init_test_hwmon_show(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct device *d = mt7915_init_test_hwmon_dev(test, &dev->phy);
+	struct sensor_device_attribute bad = { .index = 4 };
+	char buf[32];
+	struct mt76_test_msg *msg;
+
+	fake->reply = mt7915_init_test_reply;
+	fake->priv = (void *)47L;
+	dev->mphy.band_idx = 1;
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_temp_show(d,
+			&sensor_dev_attr_temp1_input.dev_attr, buf), 6);
+	KUNIT_EXPECT_STREQ(test, buf, "47000\n");
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(THERMAL_CTRL));
+	KUNIT_EXPECT_EQ(test, msg->data[0], THERMAL_SENSOR_TEMP_QUERY);
+	KUNIT_EXPECT_EQ(test, msg->data[2], 1);		/* band */
+
+	dev->phy.throttle_temp[MT7915_CRIT_TEMP_IDX] = 110;
+	dev->phy.throttle_temp[MT7915_MAX_TEMP_IDX] = 120;
+	dev->phy.throttle_state = 42;
+	mt7915_thermal_temp_show(d, &sensor_dev_attr_temp1_crit.dev_attr, buf);
+	KUNIT_EXPECT_STREQ(test, buf, "110000\n");
+	mt7915_thermal_temp_show(d, &sensor_dev_attr_temp1_max.dev_attr, buf);
+	KUNIT_EXPECT_STREQ(test, buf, "120000\n");
+	mt7915_thermal_temp_show(d, &sensor_dev_attr_throttle1.dev_attr, buf);
+	KUNIT_EXPECT_STREQ(test, buf, "42\n");
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_temp_show(d, &bad.dev_attr, buf),
+			-EINVAL);
+
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_temp_show(d,
+			&sensor_dev_attr_temp1_input.dev_attr, buf), -EIO);
+}
