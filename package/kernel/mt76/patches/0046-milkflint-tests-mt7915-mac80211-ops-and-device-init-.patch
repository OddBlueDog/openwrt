+/* The init work after registration hands the eeprom to the firmware
+ * (efuse mode, or the whole buffer in flash mode), then inits the MAC and
+ * beamforming.
+ */
+static void mt7915_init_test_init_work(struct kunit *test)
+{
+	struct mt76_test_fake *fake;
+	struct mt7915_dev *dev = mt7915_init_test_device(test,
+							 MT7976_ONE_ADIE_DBDC,
+							 &fake);
+	struct mt76_test_msg *msg;
+
+	mt7915_init_test_clear(fake);
+	queue_work(system_wq, &dev->init_work);
+	flush_work(&dev->init_work);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(EFUSE_BUFFER_MODE));
+	KUNIT_EXPECT_EQ(test, msg->data[0], EE_MODE_EFUSE);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(TXBF_ACTION)), 3);
+	KUNIT_EXPECT_TRUE(test, dev->vow_atf_en);
+	KUNIT_EXPECT_EQ(test, mt76_test_find_msg(fake,
+			MCU_EXT_CMD(TXBF_ACTION))->data[0], MT_BF_TYPE_UPDATE);
+
+	/* flash mode: the eeprom in 1 KiB pages */
+	mt7915_init_test_clear(fake);
+	dev->flash_mode = true;
+	mt7915_init_work(&dev->init_work);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(EFUSE_BUFFER_MODE)), 4);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->data[0], EE_MODE_BUFFER);
+	KUNIT_EXPECT_EQ(test, msg->len, sizeof(struct mt7915_mcu_eeprom) +
+			0x400);
+	KUNIT_EXPECT_MEMEQ(test, msg->data + sizeof(struct mt7915_mcu_eeprom),
+			   dev->mt76.eeprom.data, 0x400);
+}
