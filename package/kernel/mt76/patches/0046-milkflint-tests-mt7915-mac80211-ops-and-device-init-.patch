+/* Station statistics: the rx rate comes from the firmware when it answers,
+ * the tx rate from the last tx status (legacy or MCS), plus the tx
+ * counters and ack signal mt76 keeps.
+ */
+static void mt7915_main_test_sta_statistics(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_main_test_fw *fw = fake->priv;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct station_info sinfo = {};
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	msta->wcid.stats.tx_failed = 3;
+	msta->wcid.stats.tx_retries = 9;
+	msta->ack_signal = -50;
+	ewma_avg_signal_add(&msta->avg_ack_signal, 60);
+	msta->wcid.rate.legacy = 540;
+	mt7915_main_test_clear(fake);
+
+	/* the firmware sends no rate back: no rx rate */
+	mt7915_sta_statistics(hw, vif, sta, &sinfo);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->cmd,
+			MCU_EXT_CMD(PHY_STAT_INFO));
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(mt76_test_msg(fake, 0)->data +
+						 2), msta->wcid.idx);
+	KUNIT_EXPECT_FALSE(test, sinfo.filled &
+			   BIT_ULL(NL80211_STA_INFO_RX_BITRATE));
+	KUNIT_EXPECT_TRUE(test, sinfo.filled &
+			  BIT_ULL(NL80211_STA_INFO_TX_BITRATE));
+	KUNIT_EXPECT_EQ(test, sinfo.txrate.legacy, 540);
+	KUNIT_EXPECT_EQ(test, sinfo.tx_failed, 3);
+	KUNIT_EXPECT_EQ(test, sinfo.tx_retries, 9);
+	KUNIT_EXPECT_EQ(test, sinfo.ack_signal, -50);
+	KUNIT_EXPECT_EQ(test, sinfo.avg_ack_signal, -60);
+	KUNIT_EXPECT_TRUE(test, sinfo.filled &
+			  BIT_ULL(NL80211_STA_INFO_TX_FAILED));
+	KUNIT_EXPECT_TRUE(test, sinfo.filled &
+			  BIT_ULL(NL80211_STA_INFO_TX_RETRIES));
+	KUNIT_EXPECT_TRUE(test, sinfo.filled &
+			  BIT_ULL(NL80211_STA_INFO_ACK_SIGNAL));
+	KUNIT_EXPECT_TRUE(test, sinfo.filled &
+			  BIT_ULL(NL80211_STA_INFO_ACK_SIGNAL_AVG));
+	KUNIT_EXPECT_FALSE(test, sinfo.filled &
+			   BIT_ULL(NL80211_STA_INFO_TX_BYTES64));
+
+	/* HE rx rate from the firmware, HE tx rate */
+	fw->rx_rate = true;
+	fw->rx.mode = MT_PHY_TYPE_HE_SU;
+	fw->rx.rate = 11;
+	fw->rx.nsts = 1;
+	fw->rx.gi = 1;
+	fw->rx.bw = IEEE80211_STA_RX_BW_80;
+	msta->wcid.rate = (struct rate_info){
+		.flags = RATE_INFO_FLAGS_HE_MCS, .mcs = 9, .nss = 2,
+		.bw = RATE_INFO_BW_40, .he_gi = 2, .he_dcm = 1,
+		.he_ru_alloc = 3,
+	};
+	memset(&sinfo, 0, sizeof(sinfo));
+	mt7915_sta_statistics(hw, vif, sta, &sinfo);
+	KUNIT_EXPECT_TRUE(test, sinfo.filled &
+			  BIT_ULL(NL80211_STA_INFO_RX_BITRATE));
+	KUNIT_EXPECT_EQ(test, sinfo.rxrate.mcs, 11);
+	KUNIT_EXPECT_EQ(test, sinfo.rxrate.nss, 2);
+	KUNIT_EXPECT_EQ(test, sinfo.rxrate.bw, RATE_INFO_BW_80);
+	KUNIT_EXPECT_EQ(test, sinfo.rxrate.flags, RATE_INFO_FLAGS_HE_MCS);
+	KUNIT_EXPECT_EQ(test, sinfo.txrate.legacy, 0);
+	KUNIT_EXPECT_EQ(test, sinfo.txrate.mcs, 9);
+	KUNIT_EXPECT_EQ(test, sinfo.txrate.nss, 2);
+	KUNIT_EXPECT_EQ(test, sinfo.txrate.bw, RATE_INFO_BW_40);
+	KUNIT_EXPECT_EQ(test, sinfo.txrate.he_gi, 2);
+	KUNIT_EXPECT_EQ(test, sinfo.txrate.he_dcm, 1);
+	KUNIT_EXPECT_EQ(test, sinfo.txrate.he_ru_alloc, 3);
+	KUNIT_EXPECT_EQ(test, sinfo.txrate.flags, RATE_INFO_FLAGS_HE_MCS);
+
+	/* no tx status yet: no tx rate */
+	memset(&msta->wcid.rate, 0, sizeof(msta->wcid.rate));
+	memset(&sinfo, 0, sizeof(sinfo));
+	mt7915_sta_statistics(hw, vif, sta, &sinfo);
+	KUNIT_EXPECT_FALSE(test, sinfo.filled &
+			   BIT_ULL(NL80211_STA_INFO_TX_BITRATE));
+}
