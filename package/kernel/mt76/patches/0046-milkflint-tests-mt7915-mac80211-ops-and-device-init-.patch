+/* No free station wcid: -ENOSPC and nothing sent. */
+static void mt7915_main_test_sta_add_full(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	int i;
+
+	vif = mt7915_main_test_ap(test, dev->mt76.hw, 1);
+	mt7915_main_test_clear(fake);
+	for (i = 0; i < MT7915_WTBL_STA; i++)
+		dev->mt76.wcid_mask[i / 32] |= BIT(i % 32);
+	sta = mt7915_main_test_sta(test, vif, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mac_sta_add(&dev->mt76, vif, sta),
+			-ENOSPC);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+}
+
+/* Association: the station entry goes to connected with its capabilities,
+ * the WTBL gets the RCPI default, rate control is set up, and only then
+ * may frames go out to it. Each step's firmware error aborts it with tx
+ * still disabled.
+ */
+static void mt7915_main_test_sta_assoc(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	struct sta_rec_basic *sbasic;
+	struct mt76_test_msg *msg;
+	u32 addr;
+	int n;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	sta->deflink.ht_cap.ht_supported = true;
+	sta->deflink.ht_cap.mcs.rx_mask[0] = 0xff;
+	mt7915_main_test_clear(fake);
+
+	KUNIT_ASSERT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_AUTH,
+					     IEEE80211_STA_ASSOC), 0);
+	KUNIT_EXPECT_EQ(test, (int)msta->wcid.sta, 1);
+	KUNIT_EXPECT_EQ(test, (int)msta->wcid.sta_disabled, 0);
+	KUNIT_EXPECT_NE(test, msta->wcid.tx_info & MT_WCID_TX_INFO_SET, 0);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	sbasic = mt7915_main_test_tlv(msg, STA_REC_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, sbasic);
+	KUNIT_EXPECT_EQ(test, sbasic->conn_state, CONN_STATE_CONNECT);
+	KUNIT_EXPECT_NOT_NULL(test, mt7915_main_test_tlv(msg, STA_REC_HT));
+	KUNIT_EXPECT_NOT_NULL(test, mt7915_main_test_tlv(
+		mt76_test_find_msg(fake, MCU_EXT_CMD(STA_REC_UPDATE)),
+		STA_REC_RA));
+	addr = mt7915_mac_wtbl_lmac_addr(dev, msta->wcid.idx, 30);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, addr) & 0xff, 0xa0);
+	/* entry, airtime group, rate control */
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+	mt7915_main_test_check_group(test, mt76_test_msg(fake, 1), 0);
+	KUNIT_EXPECT_NOT_NULL(test, mt7915_main_test_tlv(mt76_test_msg(fake, 2),
+							 STA_REC_RA));
+
+	for (n = 1; n <= 3; n += 2) {
+		msta->wcid.sta = 0;
+		msta->wcid.sta_disabled = 1;
+		msta->wcid.tx_info = 0;
+		mt7915_main_test_clear(fake);
+		mt7915_main_test_fail_at(fake, n, -EIO);
+		KUNIT_EXPECT_EQ(test, mt7915_mac_sta_event(&dev->mt76, vif, sta,
+				MT76_STA_EVENT_ASSOC), -EIO);
+		KUNIT_EXPECT_EQ(test, (int)msta->wcid.sta, 0);
+		KUNIT_EXPECT_EQ(test, (int)msta->wcid.sta_disabled, 1);
+		KUNIT_EXPECT_EQ(test, msta->wcid.tx_info, 0);
+		KUNIT_EXPECT_EQ(test, fake->n_msgs, n);
+	}
+	mt7915_main_test_clear(fake);
+}
+
+/* Authorizing a station on an AP opens its port in the firmware. Another
+ * interface's entry for the same address (a station that roamed between
+ * our APs) would be dropped first, but mac80211 has none here, so nothing
+ * else is sent. On other interface types no such search happens.
+ */
+static void mt7915_main_test_sta_authorize(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif, *mesh;
+	struct ieee80211_sta *sta, *peer;
+	struct sta_rec_basic *sbasic;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	mesh = mt7915_main_test_vif(test, NL80211_IFTYPE_MESH_POINT, 2);
+	KUNIT_ASSERT_EQ(test, mt7915_add_interface(hw, mesh), 0);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	peer = mt7915_main_test_add_sta(test, hw, mesh, 2);
+	mt7915_main_test_clear(fake);
+
+	KUNIT_ASSERT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_ASSOC,
+					     IEEE80211_STA_AUTHORIZED), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	sbasic = mt7915_main_test_tlv(mt76_test_msg(fake, 0), STA_REC_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, sbasic);
+	KUNIT_EXPECT_EQ(test, sbasic->conn_state, CONN_STATE_PORT_SECURE);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->data[1],
+			mt7915_main_test_msta(sta)->wcid.idx);
+	mt7915_main_test_check_group(test, mt76_test_msg(fake, 1), 0);
+
+	/* the mesh peer: hw BSSID 1, group 1 */
+	mt7915_main_test_clear(fake);
+	KUNIT_ASSERT_EQ(test, mt76_sta_state(hw, mesh, peer,
+					     IEEE80211_STA_ASSOC,
+					     IEEE80211_STA_AUTHORIZED), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	mt7915_main_test_check_group(test, mt76_test_msg(fake, 1), 1);
+
+	/* states without an event do nothing */
+	mt7915_main_test_clear(fake);
+	KUNIT_EXPECT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_NONE,
+					     IEEE80211_STA_AUTH), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_mac_sta_event(&dev->mt76, vif, sta,
+						   (enum mt76_sta_event)99), 0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+}
