+/* VoW: airtime fairness on, deficit bound and the quantum table, then the
+ * feature switch with airtime fairness enabled.
+ */
+static void mt7915_init_test_vow_init(struct kunit *test)
+{
+	static const u8 quantum[] = VOW_DRR_QUANTUM_TABLE;
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt76_test_msg *msg;
+
+	mt7915_vow_init(dev);
+	KUNIT_EXPECT_TRUE(test, dev->vow_atf_en);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_DRR_CTRL));
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data),
+			VOW_DRR_CTRL_AIRTIME_DEFICIT_BOUND);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data + 12),
+			VOW_MAX_DEFICIT_ON);
+	msg = mt76_test_msg(fake, 1);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data),
+			VOW_DRR_CTRL_AIRTIME_QUANTUM_ALL);
+	KUNIT_EXPECT_MEMEQ(test, msg->data + 12, quantum, sizeof(quantum));
+	msg = mt76_test_msg(fake, 2);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_FEATURE_CTRL));
+	/* ATF and WATF enable */
+	KUNIT_EXPECT_NE(test, get_unaligned_le16(msg->data + 22) & BIT(13), 0);
+	KUNIT_EXPECT_NE(test, get_unaligned_le16(msg->data + 22) & BIT(9), 0);
+}
