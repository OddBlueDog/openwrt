+/* Beamforming init: with DBDC the BF modules are split between the bands
+ * first; then sounding starts and explicit BF is enabled. A firmware error
+ * stops the sequence.
+ */
+static void mt7915_init_test_txbf_init(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt76_test_msg *msg;
+
+	dev->dbdc_support = true;
+	KUNIT_ASSERT_EQ(test, mt7915_txbf_init(dev), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->cmd,
+			MCU_EXT_CMD(TXBF_ACTION));
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->data[0],
+			MT_BF_MODULE_UPDATE);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 1)->data[0],
+			MT_BF_SOUNDING_ON);
+	msg = mt76_test_msg(fake, 2);
+	KUNIT_EXPECT_EQ(test, msg->data[0], MT_BF_TYPE_UPDATE);
+	KUNIT_EXPECT_EQ(test, msg->data[1], 1);	/* explicit */
+
+	mt7915_init_test_clear(fake);
+	dev->dbdc_support = false;
+	KUNIT_ASSERT_EQ(test, mt7915_txbf_init(dev), 0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 2);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->data[0],
+			MT_BF_SOUNDING_ON);
+
+	mt7915_init_test_clear(fake);
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_txbf_init(dev), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+	mt7915_init_test_clear(fake);
+	dev->dbdc_support = true;
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_txbf_init(dev), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+}
