+/* --- interfaces -------------------------------------------------------------- */
+
+/* Own MAC (BSSID) slots: an AP takes hw BSSID 0, then the extended ones;
+ * stations, mesh and IBSS prefer hw BSSIDs 1-3, and only stations fall back
+ * to the extended ones and finally to hw BSSID 0.
+ */
+static void mt7915_main_test_omac_idx(struct kunit *test)
+{
+	u64 hw123 = BIT_ULL(1) | BIT_ULL(2) | BIT_ULL(3);
+	u64 ext = GENMASK_ULL(EXT_BSSID_MAX, EXT_BSSID_1);
+
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_AP, 0), HW_BSSID_0);
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_AP, BIT_ULL(0)),
+			EXT_BSSID_1);
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_AP,
+					   BIT_ULL(0) | BIT_ULL(EXT_BSSID_1)),
+			EXT_BSSID_1 + 1);
+	/* hw BSSIDs 1-3 are not for APs */
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_AP, BIT_ULL(0) | ext),
+			-1);
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_MONITOR, 0),
+			HW_BSSID_0);
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_MONITOR, BIT_ULL(0)),
+			EXT_BSSID_1);
+
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_STATION, 0), 1);
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_STATION, BIT_ULL(1)),
+			2);
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_STATION, hw123),
+			EXT_BSSID_1);
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_STATION,
+					   hw123 | ext), HW_BSSID_0);
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_STATION,
+					   hw123 | ext | BIT_ULL(0)), -1);
+
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_MESH_POINT, 0), 1);
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_ADHOC, BIT_ULL(1) |
+					   BIT_ULL(2)), 3);
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_MESH_POINT, hw123),
+			-1);
+	KUNIT_EXPECT_EQ(test, get_omac_idx(NL80211_IFTYPE_ADHOC, hw123), -1);
+}
+
+/* An AP on band 0: hw BSSID 0, WMM set 0, the first free wcid for its
+ * broadcast traffic, published; the firmware learns about the device
+ * (own MAC address), the BSS and the broadcast station, in that order;
+ * rate masks start out unrestricted.
+ */
+static void mt7915_main_test_add_ap(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct mt7915_vif *mvif;
+	struct mt76_test_msg *msg;
+	struct bss_info_basic *basic;
+	struct bss_info_omac *omac;
+	struct sta_rec_basic *sbasic;
+
+	vif = mt7915_main_test_vif(test, NL80211_IFTYPE_AP, 1);
+	vif->offload_flags = IEEE80211_OFFLOAD_ENCAP_ENABLED;
+	mvif = mt7915_main_test_mvif(vif);
+
+	KUNIT_ASSERT_EQ(test, mt7915_add_interface(hw, vif), 0);
+	KUNIT_EXPECT_EQ(test, mvif->mt76.idx, 0);
+	KUNIT_EXPECT_EQ(test, mvif->mt76.omac_idx, HW_BSSID_0);
+	KUNIT_EXPECT_EQ(test, mvif->mt76.band_idx, 0);
+	KUNIT_EXPECT_EQ(test, mvif->mt76.wmm_idx, 0);
+	KUNIT_EXPECT_PTR_EQ(test, mvif->phy, &dev->phy);
+	KUNIT_EXPECT_PTR_EQ(test, mvif->mt76.wcid, &mvif->sta.wcid);
+	KUNIT_EXPECT_EQ(test, dev->mt76.vif_mask, BIT_ULL(0));
+	KUNIT_EXPECT_EQ(test, dev->phy.omac_mask, BIT_ULL(0));
+	/* wcid 0 is the global one */
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.idx, 1);
+	KUNIT_EXPECT_PTR_EQ(test, rcu_access_pointer(dev->mt76.wcid[1]),
+			    &mvif->sta.wcid);
+	KUNIT_EXPECT_NE(test, mvif->sta.wcid.tx_info & MT_WCID_TX_INFO_SET, 0);
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.hw_key_idx, 0xff);
+	KUNIT_EXPECT_EQ(test, (int)mvif->sta.wcid.phy_idx, 0);
+	/* an AP keeps its offloads and gets 4-address encap */
+	KUNIT_EXPECT_EQ(test, vif->offload_flags,
+			IEEE80211_OFFLOAD_ENCAP_ENABLED |
+			IEEE80211_OFFLOAD_ENCAP_4ADDR);
+	KUNIT_EXPECT_EQ(test, mvif->bitrate_mask.control[0].legacy,
+			GENMASK(31, 0));
+	KUNIT_EXPECT_EQ(test, mvif->bitrate_mask.control[1].gi,
+			NL80211_TXRATE_DEFAULT_GI);
+	KUNIT_EXPECT_EQ(test, mvif->bitrate_mask.control[1].he_gi, 0xff);
+	KUNIT_EXPECT_EQ(test, mvif->bitrate_mask.control[1].he_ltf, 0xff);
+	KUNIT_EXPECT_EQ(test, mvif->bitrate_mask.control[0].ht_mcs[3], 0xff);
+	KUNIT_EXPECT_EQ(test, mvif->bitrate_mask.control[0].vht_mcs[7],
+			0xffff);
+	KUNIT_EXPECT_EQ(test, mvif->bitrate_mask.control[0].he_mcs[7],
+			0xffff);
+	/* no capability restricted until start_ap says otherwise */
+	KUNIT_EXPECT_TRUE(test, mvif->cap.ht_ldpc);
+	KUNIT_EXPECT_TRUE(test, mvif->cap.he_mu_ebfer);
+
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(DEV_INFO_UPDATE));
+	KUNIT_EXPECT_EQ(test, msg->data[0], HW_BSSID_0);	/* omac */
+	KUNIT_EXPECT_EQ(test, msg->data[1], 0);		/* band */
+	KUNIT_EXPECT_EQ(test, msg->data[12], 1);		/* active */
+	KUNIT_EXPECT_MEMEQ(test, msg->data + 14, vif->addr, ETH_ALEN);
+
+	msg = mt76_test_msg(fake, 1);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(BSS_INFO_UPDATE));
+	omac = mt7915_main_test_tlv(msg, BSS_INFO_OMAC);
+	KUNIT_ASSERT_NOT_NULL(test, omac);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(omac->conn_type),
+			CONNECTION_INFRA_AP);
+	KUNIT_EXPECT_EQ(test, omac->omac_idx, HW_BSSID_0);
+	basic = mt7915_main_test_tlv(msg, BSS_INFO_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, basic);
+	KUNIT_EXPECT_EQ(test, basic->active, 1);
+	KUNIT_EXPECT_EQ(test, basic->bmc_wcid_lo, 1);
+	KUNIT_EXPECT_MEMEQ(test, basic->bssid, vif->addr, ETH_ALEN);
+	KUNIT_EXPECT_NOT_NULL(test, mt7915_main_test_tlv(msg, BSS_INFO_RF_CH));
+
+	msg = mt76_test_msg(fake, 2);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	KUNIT_EXPECT_EQ(test, msg->data[1], 1);		/* wlan_idx_lo */
+	sbasic = mt7915_main_test_tlv(msg, STA_REC_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, sbasic);
+	KUNIT_EXPECT_EQ(test, sbasic->conn_state, CONN_STATE_PORT_SECURE);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(sbasic->conn_type),
+			CONNECTION_INFRA_BC);
+	/* MT7986 has airtime fairness: the BSS joins its band's group */
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(AT_PROC_MODULE));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->data[96], 0);		/* group */
+	KUNIT_EXPECT_EQ(test, msg->data[97], 0);		/* band */
+}
