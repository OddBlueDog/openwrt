+/* The slot time follows ERP short slot on 2.4 GHz (9 or 20 us) and is
+ * always short on 5 GHz; the MAC timing registers are only rewritten when
+ * it changes.
+ */
+static void mt7915_main_test_bss_slot_time(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw, *hw2 = mt7915_main_test_hw2(dev);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	struct ieee80211_vif *vif, *vif2;
+	unsigned int n_wr;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	vif2 = mt7915_main_test_ap(test, hw2, 2);
+	/* timings are only written to a running band */
+	set_bit(MT76_STATE_RUNNING, &dev->mphy.state);
+	KUNIT_EXPECT_EQ(test, dev->phy.slottime, 9);
+
+	vif->bss_conf.use_short_slot = false;
+	mt7915_bss_info_changed(hw, vif, &vif->bss_conf, BSS_CHANGED_ERP_SLOT);
+	KUNIT_EXPECT_EQ(test, dev->phy.slottime, 20);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_IFS_SLOT,
+					mt76_rr(dev, MT_TMAC_ICR0(0))), 20);
+
+	n_wr = fake->n_wr;
+	mt7915_bss_info_changed(hw, vif, &vif->bss_conf, BSS_CHANGED_ERP_SLOT);
+	KUNIT_EXPECT_EQ(test, fake->n_wr, n_wr);
+
+	vif->bss_conf.use_short_slot = true;
+	mt7915_bss_info_changed(hw, vif, &vif->bss_conf, BSS_CHANGED_ERP_SLOT);
+	KUNIT_EXPECT_EQ(test, dev->phy.slottime, 9);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_IFS_SLOT,
+					mt76_rr(dev, MT_TMAC_ICR0(0))), 9);
+
+	phy2->slottime = 20;
+	vif2->bss_conf.use_short_slot = false;
+	mt7915_bss_info_changed(hw2, vif2, &vif2->bss_conf,
+				BSS_CHANGED_ERP_SLOT);
+	KUNIT_EXPECT_EQ(test, phy2->slottime, 9);
+	clear_bit(MT76_STATE_RUNNING, &dev->mphy.state);
+}
