+/* --- more capabilities, power and thermal corners ------------------------ */
+
+/* The MT7915's wiphy (cheap: init_wiphy only checks the chip id): 4 us
+ * A-MPDU density, 7991 byte VHT MPDUs, and without DBDC 160 MHz short GI
+ * and extended NSS BW; a background radar chain but no per-station tx
+ * power.
+ */
+static void mt7915_init_test_wiphy_mt7915(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct mt76_phy *mphy = &dev->mphy;
+	u32 *vht = &mphy->sband_5g.sband.vht_cap.cap;
+
+	dev->mt76.rev = 0x79150000;
+	mphy->cap.has_2ghz = true;
+	mphy->cap.has_5ghz = true;
+	mphy->chainmask = 0xf;
+	mphy->antenna_mask = 0xf;
+	dev->dbdc_support = false;
+	mt7915_init_wiphy(&dev->phy);
+	KUNIT_EXPECT_EQ(test, mphy->sband_2g.sband.ht_cap.ampdu_density,
+			IEEE80211_HT_MPDU_DENSITY_4);
+	KUNIT_EXPECT_EQ(test, mphy->sband_5g.sband.ht_cap.ampdu_density,
+			IEEE80211_HT_MPDU_DENSITY_4);
+	KUNIT_EXPECT_EQ(test, *vht & IEEE80211_VHT_CAP_MAX_MPDU_MASK,
+			IEEE80211_VHT_CAP_MAX_MPDU_LENGTH_7991);
+	KUNIT_EXPECT_NE(test, *vht & IEEE80211_VHT_CAP_SHORT_GI_160, 0);
+	KUNIT_EXPECT_EQ(test, u32_get_bits(*vht,
+			IEEE80211_VHT_CAP_EXT_NSS_BW_MASK), 1);
+	KUNIT_EXPECT_EQ(test, *vht & IEEE80211_VHT_CAP_SUPP_CHAN_WIDTH_MASK,
+			0);
+	KUNIT_EXPECT_TRUE(test, ieee80211_hw_check(hw,
+						  SUPPORTS_VHT_EXT_NSS_BW));
+	KUNIT_EXPECT_TRUE(test, wiphy_ext_feature_isset(hw->wiphy,
+			NL80211_EXT_FEATURE_RADAR_BACKGROUND));
+	KUNIT_EXPECT_FALSE(test, wiphy_ext_feature_isset(hw->wiphy,
+			NL80211_EXT_FEATURE_STA_TX_PWR));
+	KUNIT_EXPECT_EQ(test, hw->wiphy->txq_memory_limit, 32 << 20);
+
+	/* with DBDC neither 160 MHz short GI nor extended NSS BW */
+	*vht = 0;
+	__clear_bit(IEEE80211_HW_SUPPORTS_VHT_EXT_NSS_BW, hw->flags);
+	dev->dbdc_support = true;
+	mt7915_init_wiphy(&dev->phy);
+	KUNIT_EXPECT_EQ(test, *vht & IEEE80211_VHT_CAP_SHORT_GI_160, 0);
+	KUNIT_EXPECT_FALSE(test, ieee80211_hw_check(hw,
+						   SUPPORTS_VHT_EXT_NSS_BW));
+	dev->mt76.rev = 0x79860000;
+}
