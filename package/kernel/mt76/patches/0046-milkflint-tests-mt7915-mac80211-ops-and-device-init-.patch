+/* --- aggregation ------------------------------------------------------------- */
+
+static void mt7915_main_test_ba_params(struct ieee80211_ampdu_params *p,
+				       struct ieee80211_sta *sta,
+				       enum ieee80211_ampdu_mlme_action action)
+{
+	memset(p, 0, sizeof(*p));
+	p->action = action;
+	p->sta = sta;
+	p->tid = 5;
+	p->ssn = 100;
+	p->buf_size = 64;
+}
