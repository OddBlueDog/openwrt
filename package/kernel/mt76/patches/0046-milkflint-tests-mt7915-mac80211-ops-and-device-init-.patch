+/* A rate control change of an associated station is queued for the rate
+ * control work, once, which updates the firmware's rate table; changes
+ * for a station that isn't associated are ignored.
+ */
+static void mt7915_main_test_sta_rc_update(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	mt7915_main_test_clear(fake);
+
+	mt7915_sta_rc_update(hw, vif, &sta->deflink, IEEE80211_RC_BW_CHANGED);
+	KUNIT_EXPECT_TRUE(test, list_empty(&msta->rc_list));
+	KUNIT_EXPECT_EQ(test, msta->changed, 0);
+	KUNIT_EXPECT_FALSE(test, work_pending(&dev->rc_work));
+
+	msta->wcid.sta = 1;
+	/* hold the work back to see what it gets */
+	mutex_lock(&dev->mt76.mutex);
+	mt7915_sta_rc_update(hw, vif, &sta->deflink, IEEE80211_RC_BW_CHANGED);
+	mt7915_sta_rc_update(hw, vif, &sta->deflink, IEEE80211_RC_NSS_CHANGED);
+	KUNIT_EXPECT_EQ(test, msta->changed, IEEE80211_RC_BW_CHANGED |
+			IEEE80211_RC_NSS_CHANGED);
+	KUNIT_EXPECT_PTR_EQ(test, dev->sta_rc_list.next, &msta->rc_list);
+	KUNIT_EXPECT_PTR_EQ(test, dev->sta_rc_list.prev, &msta->rc_list);
+	mutex_unlock(&dev->mt76.mutex);
+
+	flush_work(&dev->rc_work);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->sta_rc_list));
+	KUNIT_EXPECT_EQ(test, msta->changed, 0);
+	KUNIT_EXPECT_NOT_NULL(test, mt7915_main_test_tlv(
+		mt76_test_find_msg(fake, MCU_EXT_CMD(STA_REC_UPDATE)),
+		STA_REC_RA));
+}
