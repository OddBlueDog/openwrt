+/* "Automatic" tx power for a station means no limit: the firmware should
+ * get the frame setting without offsets. mt7915_mcu_set_txpower_frame()
+ * subtracts the multi-chain gain from 0 first, gets a negative power and
+ * refuses with -EINVAL on any device with more than one chain.
+ */
+static void mt7915_main_test_sta_txpwr_auto(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	struct mt76_test_fake *fake;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct ieee80211_hw *hw;
+	struct mt76_test_msg *msg;
+
+	kunit_skip(test, "driver bug: automatic station tx power fails with -EINVAL on multi-chain devices");
+
+	dev = mt7915_main_test_dev(test);
+	fake = mt76_test_fake;
+	hw = dev->mt76.hw;
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	((struct mt7915_main_test_fw *)fake->priv)->sku = true;
+	dev->mphy.txpower_cur = 40;
+	mt7915_main_test_clear(fake);
+
+	sta->deflink.txpwr.type = NL80211_TX_POWER_AUTOMATIC;
+	sta->deflink.txpwr.power = 10;
+	KUNIT_ASSERT_EQ(test, mt7915_sta_set_txpwr(hw, vif, sta), 0);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(TX_POWER_FEATURE_CTRL));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->data[0], TX_POWER_LIMIT_FRAME);
+	KUNIT_EXPECT_EQ(test, msg->data[8], 0);
+}
