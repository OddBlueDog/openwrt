+	KUNIT_ASSERT_EQ(test, sband->n_iftype_data, MT7915_INIT_TEST_N_HE);
+	KUNIT_EXPECT_EQ(test, mphy->sband_2g.sband.n_iftype_data, 0);
+	data = ieee80211_get_sband_iftype_data(sband, NL80211_IFTYPE_AP);
