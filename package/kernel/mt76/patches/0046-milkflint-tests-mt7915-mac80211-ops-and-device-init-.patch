+/* --- channel, config, filters --------------------------------------------- */
+
+/* A channel switch is programmed in the firmware, timings and counters are
+ * reset with it, and the watchdog keeps running even when the firmware
+ * refuses the switch.
+ */
+static void mt7915_main_test_set_channel(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt76_test_msg *msg;
+
+	dev->phy.noise = 90;
+	dev->mphy.aggr_stats[2] = 3;
+	KUNIT_ASSERT_EQ(test, mt7915_set_channel(&dev->mphy), 0);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(CHANNEL_SWITCH));
+	KUNIT_EXPECT_EQ(test, msg->data[0],
+			dev->mphy.chandef.chan->hw_value);
+	KUNIT_EXPECT_EQ(test, msg->data[3], 4);		/* tx paths */
+	KUNIT_EXPECT_EQ(test, msg->data[4], 4);		/* rx paths */
+	KUNIT_EXPECT_EQ(test, dev->phy.noise, 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.aggr_stats[2], 0);
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&dev->mphy.mac_work));
+	/* the CCA statistics were restarted */
+	KUNIT_EXPECT_NE(test, mt76_rr(dev, MT_WF_PHY_RX_CTRL1_MT7916(0)) &
+			(BIT(11) | BIT(9)), 0);
+
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+	mt7915_main_test_clear(fake);
+	dev->phy.noise = 90;
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_set_channel(&dev->mphy), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+	KUNIT_EXPECT_EQ(test, dev->phy.noise, 90);
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&dev->mphy.mac_work));
+}
+
+static void mt7915_main_test_vfree(void *p)
+{
+	vfree(p);
+}
+
+/* With pre-calibration data (flash mode) the band's DPD calibration for the
+ * new channel goes to the firmware first, 3 units per channel on the MT7986;
+ * a channel without calibration data fails the switch.
+ */
+static void mt7915_main_test_set_channel_dpd(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	struct ieee80211_channel ch34 = {
+		.band = NL80211_BAND_5GHZ, .center_freq = 5170, .hw_value = 34,
+	};
+	struct mt76_test_msg *msg;
+	u32 group, base;
+	u8 *cal;
+
+	group = mt7915_get_cal_group_size(dev);
+	cal = vzalloc(group + mt7915_get_cal_dpd_size(dev));
+	KUNIT_ASSERT_NOT_NULL(test, cal);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_main_test_vfree, cal), 0);
+	dev->cal = cal;
+	((u8 *)dev->mt76.eeprom.data)[MT_EE_DO_PRE_CAL_V2] = MT_EE_WIFI_CAL_DPD_5G;
+	/* 5180 MHz is entry 66 of the MT7986's DPD channel list */
+	base = group + 66 * 3 * MT_EE_CAL_UNIT;
+	cal[base] = 0x5a;
+	cal[base + 2 * MT_EE_CAL_UNIT] = 0xa5;
+	KUNIT_ASSERT_EQ(test, phy2->mt76->chandef.chan->center_freq, 5180);
+
+	KUNIT_ASSERT_EQ(test, mt7915_set_channel(phy2->mt76), 0);
+	/* then the switch itself and the counter reset's MIB query */
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 5);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(DPD_PRE_CAL_INFO));
+	KUNIT_EXPECT_EQ(test, msg->data[7], 198);		/* unit */
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data + 12),
+			MT_EE_CAL_UNIT);
+	KUNIT_EXPECT_EQ(test, msg->data[16], 0x5a);
+	msg = mt76_test_msg(fake, 2);
+	KUNIT_EXPECT_EQ(test, msg->data[7], 200);
+	KUNIT_EXPECT_EQ(test, msg->data[16], 0xa5);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 3)->cmd,
+			MCU_EXT_CMD(CHANNEL_SWITCH));
+	cancel_delayed_work_sync(&phy2->mt76->mac_work);
+
+	/* no calibration for this channel */
+	mt7915_main_test_clear(fake);
+	cfg80211_chandef_create(&phy2->mt76->chandef, &ch34, NL80211_CHAN_HT20);
+	KUNIT_EXPECT_EQ(test, mt7915_set_channel(phy2->mt76), -EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&phy2->mt76->mac_work));
+	cancel_delayed_work_sync(&phy2->mt76->mac_work);
+	cfg80211_chandef_create(&phy2->mt76->chandef,
+				&phy2->mt76->sband_5g.sband.channels[0],
+				NL80211_CHAN_HT20);
+	dev->cal = NULL;
+}
+
+/* mac80211 changing the channel goes through mt76's channel switch to
+ * mt7915_set_channel() and re-applies the tx power limits; a power change
+ * alone only re-applies the limits.
+ */
+static void mt7915_main_test_config_channel(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_channel *ch6 = &dev->mphy.sband_2g.sband.channels[5];
+	struct mt76_test_msg *msg;
+
+	KUNIT_ASSERT_EQ(test, ch6->hw_value, 6);
+	cfg80211_chandef_create(&hw->conf.chandef, ch6, NL80211_CHAN_HT20);
+	KUNIT_ASSERT_EQ(test, mt7915_config(hw, -1,
+					    IEEE80211_CONF_CHANGE_CHANNEL), 0);
+	KUNIT_EXPECT_PTR_EQ(test, dev->mphy.chandef.chan, ch6);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(CHANNEL_SWITCH));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->data[0], 6);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(TX_POWER_FEATURE_CTRL));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->data[0], TX_POWER_LIMIT_TABLE);
+	KUNIT_EXPECT_EQ(test, msg->data[2], 0);		/* band */
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+
+	mt7915_main_test_clear(fake);
+	hw->conf.power_level = 10;
+	KUNIT_ASSERT_EQ(test, mt7915_config(hw, -1,
+					    IEEE80211_CONF_CHANGE_POWER), 0);
+	KUNIT_EXPECT_NULL(test, mt76_test_find_msg(fake,
+			MCU_EXT_CMD(CHANNEL_SWITCH)));
+	KUNIT_EXPECT_NOT_NULL(test, mt76_test_find_msg(fake,
+			MCU_EXT_CMD(TX_POWER_FEATURE_CTRL)));
+	/* the new limit applies: 10 dBm is 20 in half-dB steps */
+	KUNIT_EXPECT_LE(test, dev->mphy.txpower_cur, 20);
+
+	/* errors come back to mac80211 */
+	mt7915_main_test_clear(fake);
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_config(hw, -1,
+					    IEEE80211_CONF_CHANGE_POWER), -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_config(hw, -1,
+					    IEEE80211_CONF_CHANGE_CHANNEL),
+			-EIO);
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+}
+
+/* Monitor mode on a band: frames to other stations are kept, the rx
+ * descriptors carry the extra group 5 (rx vector) info, and the hardware
+ * stops translating 802.11 headers while any band monitors. Off again:
+ * the reverse.
+ */
+static void mt7915_main_test_config_monitor(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw = dev->mt76.hw, *hw2 = mt7915_main_test_hw2(dev);
+
+	mt76_set(dev, MT_MDP_DCR0, MT_MDP_DCR0_RX_HDR_TRANS_EN);
+	hw->conf.flags |= IEEE80211_CONF_MONITOR;
+	KUNIT_ASSERT_EQ(test, mt7915_config(hw, -1,
+					    IEEE80211_CONF_CHANGE_MONITOR), 0);
+	KUNIT_EXPECT_EQ(test, dev->monitor_mask, BIT(0));
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WF_RFCR(0)) &
+			MT_WF_RFCR_DROP_OTHER_UC, 0);
+	KUNIT_EXPECT_NE(test, mt76_rr(dev, MT_DMA_DCR0(0)) &
+			MT_DMA_DCR0_RXD_G5_EN, 0);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_MDP_DCR0) &
+			MT_MDP_DCR0_RX_HDR_TRANS_EN, 0);
+
+	hw2->conf.flags |= IEEE80211_CONF_MONITOR;
+	KUNIT_ASSERT_EQ(test, mt7915_config(hw2, -1,
+					    IEEE80211_CONF_CHANGE_MONITOR), 0);
+	KUNIT_EXPECT_EQ(test, dev->monitor_mask, BIT(0) | BIT(1));
+	KUNIT_EXPECT_NE(test, mt76_rr(dev, MT_DMA_DCR0(1)) &
+			MT_DMA_DCR0_RXD_G5_EN, 0);
+
+	/* band 0 stops monitoring, band 1 still does */
+	hw->conf.flags &= ~IEEE80211_CONF_MONITOR;
+	KUNIT_ASSERT_EQ(test, mt7915_config(hw, -1,
+					    IEEE80211_CONF_CHANGE_MONITOR), 0);
+	KUNIT_EXPECT_EQ(test, dev->monitor_mask, BIT(1));
+	KUNIT_EXPECT_NE(test, mt76_rr(dev, MT_WF_RFCR(0)) &
+			MT_WF_RFCR_DROP_OTHER_UC, 0);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_DMA_DCR0(0)) &
+			MT_DMA_DCR0_RXD_G5_EN, 0);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_MDP_DCR0) &
+			MT_MDP_DCR0_RX_HDR_TRANS_EN, 0);
+
+	hw2->conf.flags &= ~IEEE80211_CONF_MONITOR;
+	KUNIT_ASSERT_EQ(test, mt7915_config(hw2, -1,
+					    IEEE80211_CONF_CHANGE_MONITOR), 0);
+	KUNIT_EXPECT_EQ(test, dev->monitor_mask, 0);
+	KUNIT_EXPECT_NE(test, mt76_rr(dev, MT_MDP_DCR0) &
+			MT_MDP_DCR0_RX_HDR_TRANS_EN, 0);
+}
+
+/* The rx filter: only the FIF_ flags the hardware can honour come back,
+ * each turns its drop bits off, and control frames are kept in RFCR1 only
+ * with FIF_CONTROL. Unicast to others is dropped unless monitoring.
+ */
+static void mt7915_main_test_configure_filter(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw = dev->mt76.hw, *hw2 = mt7915_main_test_hw2(dev);
+	u32 ctl = MT_WF_RFCR1_DROP_ACK | MT_WF_RFCR1_DROP_BF_POLL |
+		  MT_WF_RFCR1_DROP_BA | MT_WF_RFCR1_DROP_CFEND |
+		  MT_WF_RFCR1_DROP_CFACK;
+	u32 other_bss = MT_WF_RFCR_DROP_OTHER_TIM | MT_WF_RFCR_DROP_A3_MAC |
+			MT_WF_RFCR_DROP_A3_BSSID;
+	u32 control = MT_WF_RFCR_DROP_CTS | MT_WF_RFCR_DROP_RTS |
+		      MT_WF_RFCR_DROP_CTL_RSV;
+	unsigned int flags;
+	u32 val;
+
+	/* bits nothing should still drop */
+	dev->phy.rxfilter = MT_WF_RFCR_DROP_OTHER_BSS | MT_WF_RFCR_DROP_MCAST |
+			    MT_WF_RFCR_DROP_PROBEREQ |
+			    MT_WF_RFCR_DROP_STBC_MULTI;
+
+	flags = FIF_OTHER_BSS | FIF_FCSFAIL | FIF_CONTROL | FIF_ALLMULTI |
+		FIF_PROBE_REQ;
+	mt7915_configure_filter(hw, flags, &flags, 0);
+	KUNIT_EXPECT_EQ(test, flags, FIF_OTHER_BSS | FIF_FCSFAIL | FIF_CONTROL);
+	val = mt76_rr(dev, MT_WF_RFCR(0));
+	KUNIT_EXPECT_EQ(test, val & (other_bss | control |
+				     MT_WF_RFCR_DROP_FCSFAIL), 0);
+	KUNIT_EXPECT_EQ(test, val & (MT_WF_RFCR_DROP_OTHER_BSS |
+				     MT_WF_RFCR_DROP_MCAST |
+				     MT_WF_RFCR_DROP_PROBEREQ |
+				     MT_WF_RFCR_DROP_STBC_MULTI), 0);
+	KUNIT_EXPECT_NE(test, val & MT_WF_RFCR_DROP_OTHER_UC, 0);
+	KUNIT_EXPECT_EQ(test, val, dev->phy.rxfilter | MT_WF_RFCR_DROP_OTHER_UC);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WF_RFCR1(0)) & ctl, 0);
+
+	flags = 0;
+	mt7915_configure_filter(hw, FIF_OTHER_BSS, &flags, 0);
+	KUNIT_EXPECT_EQ(test, flags, 0);
+	val = mt76_rr(dev, MT_WF_RFCR(0));
+	KUNIT_EXPECT_EQ(test, val & other_bss, other_bss);
+	KUNIT_EXPECT_EQ(test, val & control, control);
+	KUNIT_EXPECT_NE(test, val & MT_WF_RFCR_DROP_FCSFAIL, 0);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WF_RFCR1(0)) & ctl, ctl);
+
+	/* band 1, monitoring */
+	hw2->conf.flags |= IEEE80211_CONF_MONITOR;
+	flags = FIF_FCSFAIL;
+	mt7915_configure_filter(hw2, flags, &flags, 0);
+	val = mt76_rr(dev, MT_WF_RFCR(1));
+	KUNIT_EXPECT_EQ(test, val & MT_WF_RFCR_DROP_OTHER_UC, 0);
+	KUNIT_EXPECT_EQ(test, val & MT_WF_RFCR_DROP_FCSFAIL, 0);
+	KUNIT_EXPECT_EQ(test, val & other_bss, other_bss);
+	/* the monitor bit isn't remembered in the band's filter */
+	KUNIT_EXPECT_NE(test, mt7915_ext_phy(dev)->rxfilter &
+			other_bss, 0);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WF_RFCR1(1)) & ctl, ctl);
+}
+
+/* WMM parameters are stored per hardware queue (the reverse AC order) and
+ * only sent with the next BSS_CHANGED_QOS: EDCA_UPDATE then carries them,
+ * in the interface's WMM set, with contention windows as exponents.
+ */
+static void mt7915_main_test_conf_tx(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw2 = mt7915_main_test_hw2(dev);
+	struct ieee80211_tx_queue_params vo = {
+		.aifs = 2, .cw_min = 3, .cw_max = 7, .txop = 47,
+	};
+	struct ieee80211_vif *vif;
+	struct mt7915_vif *mvif;
+	struct mt76_test_msg *msg;
+	struct mt7915_mcu_tx *req;
+
+	vif = mt7915_main_test_ap(test, hw2, 1);
+	mvif = mt7915_main_test_mvif(vif);
+	mt7915_main_test_clear(fake);
+
+	KUNIT_EXPECT_EQ(test, MT7915_MAIN_TEST_OP(conf_tx)(hw2, vif, 0,
+							   IEEE80211_AC_VO,
+							   &vo), 0);
+	KUNIT_EXPECT_EQ(test, mvif->queue_params[3].txop, 47);
+	KUNIT_EXPECT_EQ(test, mvif->queue_params[0].txop, 0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	mt7915_bss_info_changed(hw2, vif, &vif->bss_conf, BSS_CHANGED_QOS);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(EDCA_UPDATE));
+	req = mt7915_test_payload(msg, struct mt7915_mcu_tx);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->total, IEEE80211_NUM_ACS);
+	KUNIT_EXPECT_EQ(test, req->edca[3].queue, 3 + 2 * MT76_CONNAC_MAX_WMM_SETS);
+	KUNIT_EXPECT_EQ(test, req->edca[3].aifs, 2);
+	KUNIT_EXPECT_EQ(test, req->edca[3].cw_min, 2);	/* fls(3) */
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->edca[3].cw_max), 3);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->edca[3].txop), 47);
+	/* unset queues get the defaults */
+	KUNIT_EXPECT_EQ(test, req->edca[0].cw_min, 5);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->edca[0].cw_max), 10);
+}
+
+/* --- keys -------------------------------------------------------------------- */
+
+/* A key conf as mac80211 embeds it at the end of its struct ieee80211_key:
+ * mt76 reads the CCMP rx PNs from there, so there's zeroed room before it.
+ */
+static struct ieee80211_key_conf *
+mt7915_main_test_key(struct kunit *test, u32 cipher, u8 idx, u8 len)
+{
+	struct ieee80211_key_conf *key;
+	u8 *buf;
+	int i;
+
+	buf = kunit_kzalloc(test, 4096, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, buf);
+	key = (void *)(buf + 2048);
+	key->cipher = cipher;
+	key->keyidx = idx;
+	key->keylen = len;
+	for (i = 0; i < len; i++)
+		key->key[i] = 0x10 + i;
+
+	return key;
+}
+
+/* The first group key of an AP sets the BSS cipher (BSS info update) and
+ * goes to the firmware on the broadcast wcid; later keys don't touch the
+ * BSS again. CCMP keys get rx PN checking.
+ */
+static void mt7915_main_test_set_group_key(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_key_conf *key;
+	struct ieee80211_vif *vif;
+	struct mt7915_vif *mvif;
+	struct mt76_test_msg *msg;
+	struct sta_rec_sec *sec;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	mvif = mt7915_main_test_mvif(vif);
+	mt7915_main_test_clear(fake);
+
+	key = mt7915_main_test_key(test, WLAN_CIPHER_SUITE_CCMP, 1, 16);
+	KUNIT_ASSERT_EQ(test, mt7915_set_key(hw, SET_KEY, vif, NULL, key), 0);
+	KUNIT_EXPECT_EQ(test, mvif->mt76.cipher, MCU_CIPHER_AES_CCMP);
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.hw_key_idx, 1);
+	KUNIT_EXPECT_TRUE(test, mvif->sta.wcid.rx_check_pn);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(BSS_INFO_UPDATE));
+	KUNIT_EXPECT_EQ(test, ((struct bss_info_basic *)
+			mt7915_main_test_tlv(msg, BSS_INFO_BASIC))->cipher,
+			MCU_CIPHER_AES_CCMP);
+	msg = mt76_test_msg(fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	KUNIT_EXPECT_EQ(test, msg->data[1], mvif->sta.wcid.idx);
+	sec = mt7915_main_test_tlv(msg, STA_REC_KEY_V2);
+	KUNIT_ASSERT_NOT_NULL(test, sec);
+	KUNIT_EXPECT_EQ(test, sec->add, SET_KEY);
+	KUNIT_EXPECT_EQ(test, sec->n_cipher, 1);
+	KUNIT_EXPECT_EQ(test, sec->key[0].cipher_id, MCU_CIPHER_AES_CCMP);
+	KUNIT_EXPECT_EQ(test, sec->key[0].key_id, 1);
+	KUNIT_EXPECT_EQ(test, sec->key[0].key_len, 16);
+	KUNIT_EXPECT_MEMEQ(test, sec->key[0].key, key->key, 16);
+
+	/* a GTK rekey: the BSS keeps its cipher */
+	mt7915_main_test_clear(fake);
+	key = mt7915_main_test_key(test, WLAN_CIPHER_SUITE_GCMP_256, 2, 32);
+	KUNIT_ASSERT_EQ(test, mt7915_set_key(hw, SET_KEY, vif, NULL, key), 0);
+	KUNIT_EXPECT_EQ(test, mvif->mt76.cipher, MCU_CIPHER_AES_CCMP);
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.hw_key_idx, 2);
+	KUNIT_EXPECT_FALSE(test, mvif->sta.wcid.rx_check_pn);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 1);
+	sec = mt7915_main_test_tlv(mt76_test_msg(fake, 0), STA_REC_KEY_V2);
+	KUNIT_ASSERT_NOT_NULL(test, sec);
+	KUNIT_EXPECT_EQ(test, sec->key[0].cipher_id, MCU_CIPHER_GCMP_256);
+	KUNIT_EXPECT_EQ(test, sec->key[0].key_len, 32);
+
+	/* removing a key only forgets its index: nothing is sent */
+	mt7915_main_test_clear(fake);
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, DISABLE_KEY, vif, NULL, key),
+			0);
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.hw_key_idx, 0xff);
+	key->keyidx = 1;
+	mvif->sta.wcid.hw_key_idx = 2;
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, DISABLE_KEY, vif, NULL, key),
+			0);
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.hw_key_idx, 2);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+}
+
+/* BIP (AES-CMAC) keys use the second key slot and the hardware adds the
+ * MMIE; the firmware gets the last CCMP key with it.
+ */
+static void mt7915_main_test_set_bip_key(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_key_conf *key;
+	struct ieee80211_vif *vif;
+	struct mt7915_vif *mvif;
+	struct sta_rec_sec *sec;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	mvif = mt7915_main_test_mvif(vif);
+	key = mt7915_main_test_key(test, WLAN_CIPHER_SUITE_CCMP, 1, 16);
+	KUNIT_ASSERT_EQ(test, mt7915_set_key(hw, SET_KEY, vif, NULL, key), 0);
+	mt7915_main_test_clear(fake);
+
+	key = mt7915_main_test_key(test, WLAN_CIPHER_SUITE_AES_CMAC, 4, 16);
+	KUNIT_ASSERT_EQ(test, mt7915_set_key(hw, SET_KEY, vif, NULL, key), 0);
+	KUNIT_EXPECT_NE(test, key->flags & IEEE80211_KEY_FLAG_GENERATE_MMIE, 0);
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.hw_key_idx2, 4);
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.hw_key_idx, 1);
+	sec = mt7915_main_test_tlv(mt76_test_msg(fake, 0), STA_REC_KEY_V2);
+	KUNIT_ASSERT_NOT_NULL(test, sec);
+	KUNIT_EXPECT_EQ(test, sec->n_cipher, 2);
+	KUNIT_EXPECT_EQ(test, sec->key[0].cipher_id, MCU_CIPHER_AES_CCMP);
+	KUNIT_EXPECT_EQ(test, sec->key[0].key_id, 1);
+	KUNIT_EXPECT_EQ(test, sec->key[1].cipher_id, MCU_CIPHER_BIP_CMAC_128);
+
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, DISABLE_KEY, vif, NULL, key),
+			0);
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.hw_key_idx2, 0xff);
+	KUNIT_EXPECT_EQ(test, mvif->sta.wcid.hw_key_idx, 1);
+}
+
+/* Keys the hardware can't do fall back to software (-EOPNOTSUPP), without
+ * any firmware traffic: WEP, unknown ciphers, per-station group keys of
+ * IBSS/mesh, and keys for a station that isn't associated yet (whose
+ * removal is a no-op).
+ */
+static void mt7915_main_test_set_key_unsupported(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_key_conf *key;
+	struct ieee80211_vif *ap, *mesh;
+	struct ieee80211_sta *sta;
+
+	ap = mt7915_main_test_ap(test, hw, 1);
+	mesh = mt7915_main_test_vif(test, NL80211_IFTYPE_MESH_POINT, 2);
+	KUNIT_ASSERT_EQ(test, mt7915_add_interface(hw, mesh), 0);
+	sta = mt7915_main_test_add_sta(test, hw, ap, 1);
+	mt7915_main_test_clear(fake);
+
+	key = mt7915_main_test_key(test, WLAN_CIPHER_SUITE_WEP40, 0, 5);
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, SET_KEY, ap, NULL, key),
+			-EOPNOTSUPP);
+	key->cipher = WLAN_CIPHER_SUITE_WEP104;
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, SET_KEY, ap, NULL, key),
+			-EOPNOTSUPP);
+	key->cipher = WLAN_CIPHER_SUITE_BIP_GMAC_256;
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, SET_KEY, ap, NULL, key),
+			-EOPNOTSUPP);
+
+	key = mt7915_main_test_key(test, WLAN_CIPHER_SUITE_CCMP, 1, 16);
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, SET_KEY, mesh, NULL, key),
+			-EOPNOTSUPP);
+	key->cipher = WLAN_CIPHER_SUITE_TKIP;
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, SET_KEY, mesh, NULL, key),
+			-EOPNOTSUPP);
+	/* pairwise and GCMP ones are fine on mesh */
+	key->flags |= IEEE80211_KEY_FLAG_PAIRWISE;
+	key->keylen = 32;
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, SET_KEY, mesh, NULL, key), 0);
+	key = mt7915_main_test_key(test, WLAN_CIPHER_SUITE_GCMP, 1, 16);
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, SET_KEY, mesh, NULL, key), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(STA_REC_UPDATE)), 2);
+
+	mt7915_main_test_clear(fake);
+	key = mt7915_main_test_key(test, WLAN_CIPHER_SUITE_CCMP_256, 0, 32);
+	key->flags |= IEEE80211_KEY_FLAG_PAIRWISE;
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, SET_KEY, ap, sta, key),
+			-EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, DISABLE_KEY, ap, sta, key),
+			0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+}
+
+/* A pairwise key for an associated station goes on the station's wcid;
+ * a firmware error is returned.
+ */
+static void mt7915_main_test_set_sta_key(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_key_conf *key;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	struct mt76_test_msg *msg;
+	struct sta_rec_sec *sec;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	msta->wcid.sta = 1;
+	mt7915_main_test_clear(fake);
+
+	key = mt7915_main_test_key(test, WLAN_CIPHER_SUITE_TKIP, 0, 32);
+	key->flags |= IEEE80211_KEY_FLAG_PAIRWISE;
+	KUNIT_ASSERT_EQ(test, mt7915_set_key(hw, SET_KEY, vif, sta, key), 0);
+	KUNIT_EXPECT_EQ(test, msta->wcid.hw_key_idx, 0);
+	/* station keys leave the BSS cipher alone */
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_mvif(vif)->mt76.cipher, 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 1);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->data[1], msta->wcid.idx);
+	sec = mt7915_main_test_tlv(msg, STA_REC_KEY_V2);
+	KUNIT_ASSERT_NOT_NULL(test, sec);
+	KUNIT_EXPECT_EQ(test, sec->key[0].cipher_id, MCU_CIPHER_TKIP);
+	/* the firmware wants the rx and tx MIC keys swapped */
+	KUNIT_EXPECT_MEMEQ(test, sec->key[0].key + 16, key->key + 24, 8);
+	KUNIT_EXPECT_MEMEQ(test, sec->key[0].key + 24, key->key + 16, 8);
+
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_set_key(hw, SET_KEY, vif, sta, key), -EIO);
+}
+
+/* --- BSS changes -------------------------------------------------------------- */
+
+/* Association state drives the BSS info: up when associated (before the
+ * other updates), down when not (after them).
+ */
+static void mt7915_main_test_bss_assoc(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct bss_info_basic *basic;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	mt7915_main_test_clear(fake);
+
+	vif->cfg.assoc = true;
+	mt7915_bss_info_changed(hw, vif, &vif->bss_conf, BSS_CHANGED_ASSOC |
+				BSS_CHANGED_QOS);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->cmd,
+			MCU_EXT_CMD(BSS_INFO_UPDATE));
+	basic = mt7915_main_test_tlv(mt76_test_msg(fake, 0), BSS_INFO_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, basic);
+	KUNIT_EXPECT_EQ(test, basic->active, 1);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 1)->cmd,
+			MCU_EXT_CMD(EDCA_UPDATE));
+
+	mt7915_main_test_clear(fake);
+	vif->cfg.assoc = false;
+	mt7915_bss_info_changed(hw, vif, &vif->bss_conf, BSS_CHANGED_ASSOC |
+				BSS_CHANGED_QOS);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->cmd,
+			MCU_EXT_CMD(EDCA_UPDATE));
+	basic = mt7915_main_test_tlv(mt76_test_msg(fake, 1), BSS_INFO_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, basic);
+	KUNIT_EXPECT_EQ(test, basic->active, 0);
+
+	/* a BSSID change only matters to stations */
+	mt7915_main_test_clear(fake);
+	mt7915_bss_info_changed(hw, vif, &vif->bss_conf, BSS_CHANGED_BSSID);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+}
+
+/* A station losing its BSSID takes down its BSS info and its peer entry,
+ * after everything else in the same update.
+ */
+static void mt7915_main_test_bss_sta_bssid(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct sta_rec_basic *sbasic;
+	u8 bssid[ETH_ALEN] = {};
+
+	vif = mt7915_main_test_vif(test, NL80211_IFTYPE_STATION, 1);
+	vif->bss_conf.bssid = bssid;
+	mt7915_main_test_mvif(vif)->phy = &dev->phy;
+	mt7915_main_test_mvif(vif)->mt76.omac_idx = 1;
+
+	mt7915_bss_info_changed(hw, vif, &vif->bss_conf, BSS_CHANGED_BSSID |
+				BSS_CHANGED_ERP_CTS_PROT);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+	KUNIT_EXPECT_NOT_NULL(test, mt7915_main_test_tlv(mt76_test_msg(fake, 0),
+			BSS_INFO_PROTECT_INFO));
+	KUNIT_EXPECT_EQ(test, ((struct bss_info_basic *)mt7915_main_test_tlv(
+			mt76_test_msg(fake, 1), BSS_INFO_BASIC))->active, 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 2)->cmd,
+			MCU_EXT_CMD(STA_REC_UPDATE));
+	sbasic = mt7915_main_test_tlv(mt76_test_msg(fake, 2), STA_REC_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, sbasic);
+	KUNIT_EXPECT_EQ(test, sbasic->conn_state, CONN_STATE_DISCONNECT);
+}
+
+/* Beaconing interfaces that aren't APs (mesh, IBSS) bring their BSS and
+ * broadcast peer up when beaconing starts, and get EDCA with it. The beacon
+ * itself isn't built for a nontransmitted BSS (the transmitting one carries
+ * it), so nothing more is sent here.
+ */
+static void mt7915_main_test_bss_mesh_beacon(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct sta_rec_basic *sbasic;
+
+	vif = mt7915_main_test_vif(test, NL80211_IFTYPE_MESH_POINT, 1);
+	KUNIT_ASSERT_EQ(test, mt7915_add_interface(hw, vif), 0);
+	mt7915_main_test_clear(fake);
+
+	vif->bss_conf.enable_beacon = true;
+	vif->bss_conf.nontransmitted = true;
+	mt7915_bss_info_changed(hw, vif, &vif->bss_conf,
+				BSS_CHANGED_BEACON_ENABLED);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 4);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->cmd,
+			MCU_EXT_CMD(BSS_INFO_UPDATE));
+	sbasic = mt7915_main_test_tlv(mt76_test_msg(fake, 1), STA_REC_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, sbasic);
+	KUNIT_EXPECT_EQ(test, sbasic->conn_state, CONN_STATE_PORT_SECURE);
+	mt7915_main_test_check_group(test, mt76_test_msg(fake, 2), 1);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 3)->cmd,
+			MCU_EXT_CMD(EDCA_UPDATE));
+
+	/* neither are discovery frames */
+	mt7915_main_test_clear(fake);
+	mt7915_bss_info_changed(hw, vif, &vif->bss_conf,
+				BSS_CHANGED_FILS_DISCOVERY |
+				BSS_CHANGED_UNSOL_BCAST_PROBE_RESP);
+	mt7915_channel_switch_beacon(hw, vif, &dev->mphy.chandef);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+}
