diff --git a/mt7915/tests/init-test.c b/mt7915/tests/init-test.c
new file mode 100644
index 00000000..fa0c44da
--- /dev/null
+++ b/mt7915/tests/init-test.c
@@ -0,0 +1,1925 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for mt7915 device init: band config, the capabilities the
+ * driver announces to mac80211 (HT/VHT/HE per band and antenna count),
+ * tx power limits, MAC init registers, LED and thermal callbacks, and the
+ * registration of both bands with mac80211. Included at the end of
+ * mt7915/init.c when CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU
+ * test build only).
+ *
+ * mt7915_init_test_device() is also used by tests/main-test.c: an MT7986
+ * registered with mac80211 the way mt7915_register_device() does it, minus
+ * DMA and firmware download (mt7915_init_hardware()), which need the SoC.
+ */
+#include <kunit/test.h>
+#include <linux/dma-mapping.h>
+#include "fake.h"
+
+struct mt7915_dev *mt7915_init_test_device(struct kunit *test, u32 sku,
+					   struct mt76_test_fake **fake);
+
+/* kernel/rcu/rcu.h, exported: registering and unregistering a wiphy waits
+ * for several RCU grace periods, ~70 ms each time in the test VM unless
+ * they're expedited
+ */
+void rcu_expedite_gp(void);
+void rcu_unexpedite_gp(void);
+
+/* --- a device ------------------------------------------------------------ */
+
+static const u8 mt7915_init_test_mac[ETH_ALEN] = {
+	0x00, 0x0c, 0x43, 0x26, 0x60, 0x00
+};
+
+/* the eeprom's per chain target powers and rate power deltas */
+#define MT7915_INIT_TEST_PWR_2G		{ 14, 20, 16, 12 }
+#define MT7915_INIT_TEST_PWR_5G		10
+#define MT7915_INIT_TEST_DELTA_2G	(MT_EE_RATE_DELTA_EN | \
+					 MT_EE_RATE_DELTA_SIGN | 2)
+#define MT7915_INIT_TEST_DELTA_5G	(MT_EE_RATE_DELTA_EN | 3)
+
+/* An MT7986 whose A-die reports @sku, with an eeprom image that has band 0
+ * on 2.4 GHz and band 1 on 5 GHz, 4 tx paths each, like the GL-MT6000's
+ * MT7976C (MT7976_ONE_ADIE_DBDC). dbdc_support and the phys are left to
+ * the caller.
+ */
+static struct mt7915_dev *mt7915_init_test_chip(struct kunit *test, u32 sku)
+{
+	static const u8 pwr_2g[] = MT7915_INIT_TEST_PWR_2G;
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 *eep;
+	int i;
+
+	mt76_wr(dev, MT_CONNINFRA_SKU_DEC_ADDR, sku);
+
+	eep = kunit_kzalloc(test, MT7916_EEPROM_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, eep);
+	eep[MT_EE_CHIP_ID] = 0x86;
+	eep[MT_EE_CHIP_ID + 1] = 0x79;
+	memcpy(eep + MT_EE_MAC_ADDR, mt7915_init_test_mac, ETH_ALEN);
+	eep[MT_EE_WIFI_CONF] =
+		FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL, MT_EE_V2_BAND_SEL_2GHZ) |
+		FIELD_PREP(MT_EE_WIFI_CONF0_TX_PATH, 4) |
+		FIELD_PREP(MT_EE_WIFI_CONF0_RX_PATH, 4);
+	eep[MT_EE_WIFI_CONF + 1] =
+		FIELD_PREP(MT_EE_WIFI_CONF0_BAND_SEL, MT_EE_V2_BAND_SEL_5GHZ) |
+		FIELD_PREP(MT_EE_WIFI_CONF0_TX_PATH, 4) |
+		FIELD_PREP(MT_EE_WIFI_CONF0_RX_PATH, 4);
+	for (i = 0; i < 4; i++) {
+		eep[MT_EE_TX0_POWER_2G_V2 + i] = pwr_2g[i];
+		memset(eep + MT_EE_TX0_POWER_5G_V2 + i * 5,
+		       MT7915_INIT_TEST_PWR_5G, 5);
+	}
+	eep[MT_EE_RATE_DELTA_2G_V2] = MT7915_INIT_TEST_DELTA_2G;
+	eep[MT_EE_RATE_DELTA_5G_V2] = MT7915_INIT_TEST_DELTA_5G;
+	dev->mt76.eeprom.data = eep;
+	dev->mt76.eeprom.size = MT7916_EEPROM_SIZE;
+
+	return dev;
+}
+
+static void mt7915_init_test_unexpedite(void *data)
+{
+	rcu_unexpedite_gp();
+}
+
+static void mt7915_init_test_unregister(void *data)
+{
+	struct mt7915_dev *dev = data;
+
+	mt7915_unregister_thermal(&dev->phy);
+	mt76_unregister_device(&dev->mt76);
+}
+
+static void mt7915_init_test_unregister_ext(void *data)
+{
+	mt7915_unregister_ext_phy(data);
+}
+
+/* Register @dev the way mt7915_register_device() does, from band config
+ * on, without mt7915_init_hardware()'s DMA and firmware: the fake firmware
+ * stands in, the eeprom is the caller's, wcid 0 is the global one. The
+ * init work isn't queued. mac80211 makes no default interface. Undone when
+ * the test ends.
+ */
+static void mt7915_init_test_register(struct kunit *test,
+				      struct mt7915_dev *dev, bool dma)
+{
+	struct mt7915_phy *phy2;
+	int ret, idx;
+
+	rcu_expedite_gp();
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_init_test_unexpedite, NULL), 0);
+
+	dev->dbdc_support = mt7915_band_config(dev);
+	phy2 = mt7915_alloc_ext_phy(dev);
+	KUNIT_ASSERT_FALSE(test, IS_ERR(phy2));
+	INIT_WORK(&dev->init_work, mt7915_init_work);
+	if (dma) {
+		/* the DMA rings, as mt7915_init_hardware() sets them up */
+		KUNIT_ASSERT_EQ(test, mt7915_dma_init(dev, phy2), 0);
+		set_bit(MT76_STATE_INITIALIZED, &dev->mphy.state);
+		tasklet_kill(&dev->mt76.irq_tasklet);
+	}
+
+	/* what mt7915_init_hardware() would have done */
+	mt7915_eeprom_parse_hw_cap(dev, &dev->phy);
+	memcpy(dev->mphy.macaddr, dev->mt76.eeprom.data + MT_EE_MAC_ADDR,
+	       ETH_ALEN);
+	idx = mt76_wcid_alloc(dev->mt76.wcid_mask, MT7915_WTBL_STA);
+	dev->mt76.global_wcid.idx = idx;
+	dev->mt76.global_wcid.hw_key_idx = -1;
+	dev->mt76.global_wcid.tx_info |= MT_WCID_TX_INFO_SET;
+	rcu_assign_pointer(dev->mt76.wcid[idx], &dev->mt76.global_wcid);
+
+	mt7915_init_wiphy(&dev->phy);
+	ieee80211_hw_set(dev->mt76.hw, NO_AUTO_VIF);
+
+	ret = mt76_register_device(&dev->mt76, true, mt76_rates,
+				   ARRAY_SIZE(mt76_rates));
+	if (ret && phy2)
+		ieee80211_free_hw(phy2->mt76->hw);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	ret = kunit_add_action_or_reset(test, mt7915_init_test_unregister, dev);
+	if (ret && phy2)
+		ieee80211_free_hw(phy2->mt76->hw);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	ret = mt7915_thermal_init(&dev->phy);
+	if (ret && phy2)
+		ieee80211_free_hw(phy2->mt76->hw);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	if (!phy2)
+		return;
+
+	ieee80211_hw_set(phy2->mt76->hw, NO_AUTO_VIF);
+	ret = mt7915_register_ext_phy(dev, phy2);
+	if (ret) {
+		mt7915_unregister_thermal(phy2);
+		mt76_unregister_phy(phy2->mt76);
+		ieee80211_free_hw(phy2->mt76->hw);
+	}
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_init_test_unregister_ext, dev), 0);
+}
+
+/* For main-test.c too: an MT7986 with A-die @sku, registered (see above).
+ * @fake, if set, gets the device's fake, which belongs to this file's copy
+ * of fake.h.
+ */
+struct mt7915_dev *mt7915_init_test_device(struct kunit *test, u32 sku,
+					   struct mt76_test_fake **fake)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test, sku);
+
+	if (fake)
+		*fake = mt76_test_fake;
+	mt7915_init_test_register(test, dev, false);
+
+	return dev;
+}
+
+/* the fake firmware's answer to temperature queries: fake->priv degrees */
+static void mt7915_init_test_reply(struct mt76_test_fake *fake,
+				   const struct mt76_test_msg *msg,
+				   struct sk_buff *reply)
+{
+	if (msg->cmd == MCU_EXT_CMD(THERMAL_CTRL)) {
+		__le32 v[2] = { 0, cpu_to_le32((long)fake->priv) };
+
+		skb_put_data(reply, v, sizeof(v));
+	}
+}
+
+static void mt7915_init_test_clear(struct mt76_test_fake *fake)
+{
+	INIT_LIST_HEAD(&fake->msgs);
+	fake->n_msgs = 0;
+	fake->mcu_ret = 0;
+}
+
+/* --- band config and registration ---------------------------------------- */
+
+/* The A-die SKU decides DBDC on the MT7986: one MT7976 doing both bands or
+ * two A-dies give two bands (the main phy on band 0); a single-band A-die
+ * puts the main phy on band 1 without DBDC. On MT7915 a bound strap
+ * decides, the MT7916 always has two bands.
+ */
+static void mt7915_init_test_band_config(struct kunit *test)
+{
+	static const struct {
+		u32 sku;
+		bool dbdc;
+		u8 band;
+	} cases[] = {
+		{ MT7976_ONE_ADIE_DBDC, true, 0 },
+		{ MT7975_ONE_ADIE, false, 1 },
+		{ MT7976_ONE_ADIE, false, 1 },
+		{ MT7975_DUAL_ADIE, true, 0 },
+		{ MT7976_DUAL_ADIE, true, 0 },
+	};
+	struct mt7915_dev *dev = mt7915_init_test_chip(test, 0);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		dev->mphy.band_idx = 1 - cases[i].band;
+		mt76_wr(dev, MT_CONNINFRA_SKU_DEC_ADDR, cases[i].sku);
+		KUNIT_EXPECT_EQ_MSG(test, mt7915_band_config(dev),
+				    cases[i].dbdc, "sku %x", cases[i].sku);
+		KUNIT_EXPECT_EQ_MSG(test, dev->mphy.band_idx, cases[i].band,
+				    "sku %x", cases[i].sku);
+	}
+
+	dev->mt76.rev = 0x79150000;
+	mt76_wr(dev, MT_HW_BOUND, BIT(5));
+	KUNIT_EXPECT_TRUE(test, mt7915_band_config(dev));
+	mt76_wr(dev, MT_HW_BOUND, 0);
+	KUNIT_EXPECT_FALSE(test, mt7915_band_config(dev));
+	dev->mt76.rev = 0x79060000;
+	KUNIT_EXPECT_TRUE(test, mt7915_band_config(dev));
+	KUNIT_EXPECT_EQ(test, dev->mphy.band_idx, 0);
+	dev->mt76.rev = 0x79860000;
+}
+
+/* Without DBDC there's no second phy to allocate. */
+static void mt7915_init_test_alloc_ext_phy(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test, MT7976_ONE_ADIE);
+	struct mt7915_phy *phy;
+
+	dev->dbdc_support = false;
+	KUNIT_EXPECT_NULL(test, mt7915_alloc_ext_phy(dev));
+
+	dev->dbdc_support = true;
+	phy = mt7915_alloc_ext_phy(dev);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(phy));
+	KUNIT_EXPECT_PTR_EQ(test, phy->dev, dev);
+	KUNIT_EXPECT_PTR_EQ(test, phy->mt76->priv, (void *)phy);
+	KUNIT_EXPECT_EQ(test, phy->mt76->band_idx, 1);
+	KUNIT_EXPECT_PTR_NE(test, phy->mt76->hw, dev->mt76.hw);
+	KUNIT_EXPECT_PTR_EQ(test, mt7915_hw_phy(phy->mt76->hw), phy);
+	/* not registered: band 1 isn't the device's yet */
+	KUNIT_EXPECT_NULL(test, mt7915_ext_phy(dev));
+	ieee80211_free_hw(phy->mt76->hw);
+}
+
+/* The GL-MT6000's A-die does both bands: band 0 is 2.4 GHz with 4 chains,
+ * band 1 a second phy on 5 GHz with the next 4, each registered with
+ * mac80211 as its own wiphy with thermal protection, and band 1 gets a
+ * locally administered MAC derived from band 0's when the eeprom has none.
+ */
+static void mt7915_init_test_register_dbdc(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_device(test,
+							 MT7976_ONE_ADIE_DBDC,
+							 NULL);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	u8 mac2[ETH_ALEN];
+
+	KUNIT_EXPECT_TRUE(test, dev->dbdc_support);
+	KUNIT_EXPECT_EQ(test, dev->mphy.band_idx, 0);
+	KUNIT_EXPECT_TRUE(test, dev->mphy.cap.has_2ghz);
+	KUNIT_EXPECT_FALSE(test, dev->mphy.cap.has_5ghz);
+	KUNIT_EXPECT_EQ(test, dev->mphy.chainmask, 0xf);
+	KUNIT_EXPECT_EQ(test, dev->mphy.antenna_mask, 0xf);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_REGISTERED,
+					 &dev->mphy.state));
+
+	KUNIT_ASSERT_NOT_NULL(test, phy2);
+	KUNIT_EXPECT_PTR_EQ(test, phy2->dev, dev);
+	KUNIT_EXPECT_EQ(test, phy2->mt76->band_idx, 1);
+	KUNIT_EXPECT_TRUE(test, phy2->mt76->cap.has_5ghz);
+	KUNIT_EXPECT_FALSE(test, phy2->mt76->cap.has_2ghz);
+	KUNIT_EXPECT_EQ(test, phy2->mt76->chainmask, 0xf0);
+	KUNIT_EXPECT_EQ(test, phy2->mt76->antenna_mask, 0xf);
+	KUNIT_EXPECT_EQ(test, dev->chainmask, 0xff);
+	KUNIT_EXPECT_PTR_NE(test, phy2->mt76->hw, dev->mt76.hw);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_REGISTERED,
+					 &phy2->mt76->state));
+	KUNIT_EXPECT_PTR_EQ(test, phy2->mt76->mac_work.work.func,
+			    &mt7915_mac_work);
+
+	memcpy(mac2, mt7915_init_test_mac, ETH_ALEN);
+	mac2[0] |= 2;
+	mac2[0] ^= BIT(7);
+	KUNIT_EXPECT_MEMEQ(test, phy2->mt76->macaddr, mac2, ETH_ALEN);
+	KUNIT_EXPECT_MEMEQ(test, dev->mphy.macaddr, mt7915_init_test_mac,
+			   ETH_ALEN);
+
+	/* both bands have their thermal limits and a cooling device */
+	KUNIT_EXPECT_EQ(test, dev->phy.throttle_temp[MT7915_CRIT_TEMP_IDX],
+			MT7915_CRIT_TEMP);
+	KUNIT_EXPECT_EQ(test, phy2->throttle_temp[MT7915_MAX_TEMP_IDX],
+			MT7915_MAX_TEMP);
+	KUNIT_EXPECT_NOT_NULL(test, dev->phy.cdev);
+	KUNIT_EXPECT_NOT_NULL(test, phy2->cdev);
+	/* no device tree thermal zone in the VM */
+	KUNIT_EXPECT_NULL(test, dev->phy.tzone);
+
+	/* unregistering band 1 frees its cooling device and phy */
+	mt7915_unregister_ext_phy(dev);
+	KUNIT_EXPECT_NULL(test, mt7915_ext_phy(dev));
+	/* the test's own teardown is now a no-op for band 1 */
+	mt7915_unregister_ext_phy(dev);
+	mt7915_unregister_thermal(&dev->phy);
+	KUNIT_EXPECT_NULL(test, dev->phy.cdev);
+}
+
+/* An eeprom with a valid second MAC address gives it to band 1. */
+static void mt7915_init_test_register_mac2(struct kunit *test)
+{
+	static const u8 mac2[ETH_ALEN] = { 0x00, 0x0c, 0x43, 0x26, 0x60, 0x01 };
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+
+	memcpy(dev->mt76.eeprom.data + MT_EE_MAC_ADDR2, mac2, ETH_ALEN);
+	mt7915_init_test_register(test, dev, false);
+	KUNIT_ASSERT_NOT_NULL(test, mt7915_ext_phy(dev));
+	KUNIT_EXPECT_MEMEQ(test, mt7915_ext_phy(dev)->mt76->macaddr, mac2,
+			   ETH_ALEN);
+}
+
+/* A single band A-die: one phy, on band 1, 5 GHz, all 4 chains unshifted,
+ * and without DBDC the tx queues may use 32 MiB.
+ */
+static void mt7915_init_test_register_single(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_device(test, MT7976_ONE_ADIE,
+							 NULL);
+	struct wiphy *wiphy = dev->mt76.hw->wiphy;
+
+	KUNIT_EXPECT_FALSE(test, dev->dbdc_support);
+	KUNIT_EXPECT_NULL(test, mt7915_ext_phy(dev));
+	KUNIT_EXPECT_EQ(test, dev->mphy.band_idx, 1);
+	KUNIT_EXPECT_TRUE(test, dev->mphy.cap.has_5ghz);
+	KUNIT_EXPECT_FALSE(test, dev->mphy.cap.has_2ghz);
+	KUNIT_EXPECT_EQ(test, dev->mphy.chainmask, 0xf);
+	KUNIT_EXPECT_EQ(test, wiphy->txq_memory_limit, 32 << 20);
+	KUNIT_EXPECT_NOT_NULL(test, wiphy->bands[NL80211_BAND_5GHZ]);
+	KUNIT_EXPECT_NULL(test, wiphy->bands[NL80211_BAND_2GHZ]);
+}
+
+/* --- capabilities ---------------------------------------------------------- */
+
+/* What both wiphys tell mac80211 and cfg80211 about the MT7986. */
+static void mt7915_init_test_wiphy(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_device(test,
+							 MT7976_ONE_ADIE_DBDC,
+							 NULL);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	struct ieee80211_hw *hw = dev->mt76.hw, *hw2 = phy2->mt76->hw;
+	struct wiphy *wiphy = hw->wiphy;
+	struct ieee80211_sta_ht_cap *ht;
+	u32 vht;
+
+	KUNIT_EXPECT_EQ(test, hw->queues, 4);
+	KUNIT_EXPECT_EQ(test, hw->max_rx_aggregation_subframes,
+			IEEE80211_MAX_AMPDU_BUF_HE);
+	KUNIT_EXPECT_EQ(test, hw->max_tx_aggregation_subframes,
+			IEEE80211_MAX_AMPDU_BUF_HE);
+	KUNIT_EXPECT_EQ(test, hw->netdev_features, NETIF_F_RXCSUM);
+	KUNIT_EXPECT_EQ(test, hw->radiotap_timestamp.units_pos,
+			IEEE80211_RADIOTAP_TIMESTAMP_UNIT_US);
+	KUNIT_EXPECT_EQ(test, dev->phy.slottime, 9);
+	KUNIT_EXPECT_EQ(test, hw->sta_data_size, sizeof(struct mt7915_sta));
+	KUNIT_EXPECT_EQ(test, hw->vif_data_size, sizeof(struct mt7915_vif));
+	KUNIT_EXPECT_PTR_EQ(test, wiphy->iface_combinations, &if_comb[0]);
+	KUNIT_EXPECT_EQ(test, wiphy->n_iface_combinations, 1);
+	KUNIT_EXPECT_PTR_EQ(test, wiphy->reg_notifier, &mt7915_regd_notifier);
+	KUNIT_EXPECT_NE(test, wiphy->flags & WIPHY_FLAG_HAS_CHANNEL_SWITCH, 0);
+	KUNIT_EXPECT_EQ(test, wiphy->mbssid_max_interfaces, 16);
+	KUNIT_EXPECT_EQ(test, hw->max_tx_fragments, 4);
+	/* DBDC: the 32 MiB tx queue limit isn't raised */
+	KUNIT_EXPECT_NE(test, wiphy->txq_memory_limit, 32 << 20);
+	KUNIT_EXPECT_EQ(test, wiphy->available_antennas_tx, 0xf);
+	KUNIT_EXPECT_EQ(test, wiphy->available_antennas_rx, 0xf);
+	KUNIT_EXPECT_EQ(test, hw2->wiphy->available_antennas_tx, 0xf);
+
