+/* 6 GHz channels get their limit too, from the 6 GHz target powers. */
+static void mt7915_init_test_txpower_6ghz(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct ieee80211_channel ch = {
+		.band = NL80211_BAND_6GHZ,
+		.center_freq = 5955,
+		.hw_value = 1,
+		.max_reg_power = 30,
+	};
+	u8 *eep = dev->mt76.eeprom.data;
+
+	memset(eep + MT_EE_TX0_POWER_6G_V2, 20, 2 * 8);
+	dev->mphy.cap.has_6ghz = true;
+	dev->mphy.chainmask = 0x3;
+	dev->mphy.sband_6g.sband.band = NL80211_BAND_6GHZ;
+	dev->mphy.sband_6g.sband.channels = &ch;
+	dev->mphy.sband_6g.sband.n_channels = 1;
+	mt7915_init_txpower(&dev->phy);
+	/* (20 + 6 for 2 chains) / 2 */
+	KUNIT_EXPECT_EQ(test, ch.orig_mpwr, 13);
+	KUNIT_EXPECT_EQ(test, ch.max_power, 13);
+	dev->mphy.sband_6g.sband.channels = NULL;
+	dev->mphy.sband_6g.sband.n_channels = 0;
+}
