 mt7915/tests/init-test.c | 1925 +++++++++++++++++++++++
 mt7915/tests/main-test.c | 3112 ++++++++++++++++++++++++++++++++++++++
 4 files changed, 5045 insertions(+)
 create mode 100644 mt7915/tests/init-test.c
 create mode 100644 mt7915/tests/main-test.c

