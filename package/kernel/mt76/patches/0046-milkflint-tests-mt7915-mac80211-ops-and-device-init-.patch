+/* Thermal setup on a wiphy that isn't in sysfs: the cooling device can't
+ * be linked and is dropped, the hwmon device can't be added and the error
+ * is returned, with nothing left registered.
+ */
+static void mt7915_init_test_thermal_init_fails(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+
+	KUNIT_EXPECT_LT(test, mt7915_thermal_init(&dev->phy), 0);
+	KUNIT_EXPECT_NULL(test, dev->phy.cdev);
+	KUNIT_EXPECT_NULL(test, dev->phy.tzone);
+	KUNIT_EXPECT_EQ(test, dev->phy.throttle_temp[MT7915_CRIT_TEMP_IDX],
+			MT7915_CRIT_TEMP);
+}
+
+/* --- reset and teardown ----------------------------------------------------- */
+
+static u32 mt7915_init_test_poll_addr;
+static u32 mt7915_init_test_poll_val;
+static bool mt7915_init_test_poll_seen;
+
+/* answers polls of one register with bits set, notes reads of others */
+static u32 mt7915_init_test_poll_hook(struct mt76_test_fake *fake, u32 addr,
+				      u32 val)
+{
+	if (addr == mt7915_init_test_poll_addr) {
+		if (val & BIT(0))
+			mt7915_init_test_poll_seen = true;
+		return val | mt7915_init_test_poll_val;
+	}
+	return val;
+}
+
+/* the fake's address for the driver's register @reg */
+static u32 mt7915_init_test_addr(struct mt7915_dev *dev, u32 reg)
+{
+	u32 val = mt76_rr(dev, reg);
+
+	mt76_wr(dev, reg, val);
+	return mt76_test_fake->last_addr;
+}
+
+/* The SoC side of an MT7986, enough for its WMAC reset: the SKU and DCM
+ * register windows, conninfra answering with its version and the bus
+ * sleep protection acking.
+ */
+static void mt7915_init_test_soc(struct kunit *test, struct mt7915_dev *dev)
+{
+	void *sku = kunit_kzalloc(test, SZ_4K, GFP_KERNEL);
+	void *dcm = kunit_kzalloc(test, SZ_4K, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, sku);
+	KUNIT_ASSERT_NOT_NULL(test, dcm);
+	dev->sku = (void __force __iomem *)sku;
+	dev->dcm = (void __force __iomem *)dcm;
+	mt76_wr(dev, MT_CONN_INFRA_BASE, 0x02070000);
+	mt76_wr(dev, MT_CONN_INFRA_WF_SLP_PROT_RDY, MT_CONN_INFRA_CONN);
+}
+
+/* A WiFi subsystem reset on the MT7986 takes the WMAC down (bus sleep
+ * protection on) and up again through the SoC code; the MT7916 pulses its
+ * subsystem reset bit; the MT7915 runs its power control sequence, waits
+ * for the MCU's dummy register to reset and clears the firmware state.
+ */
+static void mt7915_init_test_wfsys_reset(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u32 val;
+
+	mt7915_init_test_soc(test, dev);
+	mt7915_wfsys_reset(dev);
+	KUNIT_EXPECT_NE(test, mt76_rr(dev, MT_CONN_INFRA_WF_SLP_PROT) &
+			MT_CONN_INFRA_WF_SLP_PROT_MASK, 0);
+
+	dev->mt76.rev = 0x79060000;
+	mt7915_init_test_poll_addr = mt7915_init_test_addr(dev,
+							   MT_WF_SUBSYS_RST);
+	mt7915_init_test_poll_val = 0;
+	mt7915_init_test_poll_seen = false;
+	fake->rr_hook = mt7915_init_test_poll_hook;
+	mt7915_wfsys_reset(dev);
+	KUNIT_EXPECT_TRUE(test, mt7915_init_test_poll_seen);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WF_SUBSYS_RST) & BIT(0), 0);
+
+	dev->mt76.rev = 0x79150000;
+	mt76_wr(dev, MT_TOP_MISC, MT_TOP_MISC_FW_STATE);
+	mt7915_init_test_poll_addr = mt7915_init_test_addr(dev,
+						MT_MCU_WFDMA0_DUMMY_CR);
+	mt7915_init_test_poll_val = GENMASK(31, 16);
+	mt7915_wfsys_reset(dev);
+	fake->rr_hook = NULL;
+	val = mt76_rr(dev, MT_TOP_PWR_CTRL);
+	KUNIT_EXPECT_EQ(test, val & ~MT_TOP_PWR_HW_CTRL,
+			MT_TOP_PWR_KEY | MT_TOP_PWR_SW_PWR_ON |
+			MT_TOP_PWR_PWR_ON);
+	KUNIT_EXPECT_NE(test, val & MT_TOP_PWR_HW_CTRL, 0);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_MCU_WFDMA0_DUMMY_CR) &
+			GENMASK(15, 0), GENMASK(15, 0));
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TOP_MISC) &
+			MT_TOP_MISC_FW_STATE, 0);
+	dev->mt76.rev = 0x79860000;
+}
+
+/* Unregistering the device (module unload): both wiphys go away, the
+ * firmware is restarted and given back (FW own), DMA is torn down and the
+ * WMAC disabled, and the device freed, without leaving anything behind.
+ */
+static void mt7915_init_test_unregister_device(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt76_test_msg *msg;
+	u32 lpcr, slp;
+
+	mt7915_init_test_soc(test, dev);
+	KUNIT_ASSERT_EQ(test, dma_coerce_mask_and_coherent(dev->mt76.dma_dev,
+			DMA_BIT_MASK(32)), 0);
+	mt7915_init_test_register(test, dev, true);
+	KUNIT_ASSERT_NOT_NULL(test, mt7915_ext_phy(dev));
+	KUNIT_ASSERT_EQ(test, mt7915_coredump_register(dev), 0);
+	/* the firmware goes back to its download state when restarted */
+	mt76_wr(dev, MT_TOP_MISC, FIELD_PREP(MT_TOP_MISC_FW_STATE,
+					     FW_STATE_FW_DOWNLOAD));
+	lpcr = mt7915_init_test_addr(dev, MT_TOP_LPCR_HOST_BAND(0));
+	slp = mt7915_init_test_addr(dev, MT_CONN_INFRA_WF_SLP_PROT);
+	mt7915_init_test_clear(fake);
+
+	/* mt7915_unregister_device() frees the device: no teardown after */
+	kunit_remove_action(test, mt7915_init_test_unregister_ext, dev);
+	kunit_remove_action(test, mt7915_init_test_unregister, dev);
+	kunit_remove_action(test, mt76_test_free_device, &dev->mt76);
+	kunit_remove_action(test, mt76_test_fake_free, fake);
+	mt7915_unregister_device(dev);
+
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_NOT_NULL(test, msg);
+	if (msg) {
+		KUNIT_EXPECT_EQ(test, msg->cmd, MCU_CMD(NIC_POWER_CTRL));
+		KUNIT_EXPECT_EQ(test, msg->data[0], 1);
+	}
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+	KUNIT_EXPECT_NE(test, mt76_test_reg(fake, lpcr) &
+			MT_TOP_LPCR_HOST_FW_OWN, 0);
+	KUNIT_EXPECT_NE(test, mt76_test_reg(fake, slp) &
+			MT_CONN_INFRA_WF_SLP_PROT_MASK, 0);
+
+	/* what mt76_test_fake_free() would have done, minus the device */
+	xa_destroy(&fake->regs);
+	mt76_test_fake = NULL;
+}
+
+/* An MT7986 that can do DMA, about to go through mt7915_register_device()
+ * with firmware that doesn't answer: MT76_MCU_RESET is set, so each
+ * firmware command times out at once instead of after seconds.
+ */
+static struct mt7915_dev *mt7915_init_test_dead_fw(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+
+	KUNIT_ASSERT_EQ(test, dma_coerce_mask_and_coherent(dev->mt76.dma_dev,
+			DMA_BIT_MASK(32)), 0);
+	mt76_wr(dev, MT_TOP_MISC, FIELD_PREP(MT_TOP_MISC_FW_STATE,
+					     FW_STATE_FW_DOWNLOAD));
+	mt76_wr(dev, MT_INT_MASK_CSR, ~0);
+	set_bit(MT76_MCU_RESET, &dev->mphy.state);
+	/* the NAPI teardown waits for grace periods */
+	rcu_expedite_gp();
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_init_test_unexpedite, NULL), 0);
+	return dev;
+}
+
+/* what mt7915_stop_hardware() would undo of the DMA init */
+static void mt7915_init_test_dma_teardown(struct mt7915_dev *dev)
+{
+	int i;
+
+	mt76_for_each_q_rx(&dev->mt76, i)
+		napi_disable(&dev->mt76.napi[i]);
+	mt7915_dma_cleanup(dev);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+}
+
+/* mt7915_register_device() with the firmware not answering (missing or
+ * hung): band config and DMA are set up, interrupts masked, the firmware
+ * download fails at the patch semaphore and the error comes back, without
+ * registering anything with mac80211 (band 1's phy is freed again).
+ */
+static void mt7915_init_test_register_no_firmware(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_dead_fw(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	int ret;
+
+	ret = mt7915_register_device(dev);
+	KUNIT_EXPECT_LT(test, ret, 0);
+	KUNIT_EXPECT_TRUE(test, dev->dbdc_support);
+	KUNIT_EXPECT_EQ(test, dev->mphy.band_idx, 0);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_INITIALIZED,
+					 &dev->mphy.state));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_MCU_RUNNING,
+					  &dev->mphy.state));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_REGISTERED,
+					  &dev->mphy.state));
+	KUNIT_EXPECT_NULL(test, mt7915_ext_phy(dev));
+	KUNIT_EXPECT_FALSE(test, dev->recovery.hw_init_done);
+	/* all interrupts masked before DMA came up */
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_INT_MASK_CSR), 0);
+	/* the driver's own firmware path took over from the fake */
+	KUNIT_EXPECT_PTR_NE(test, dev->mt76.mcu_ops, &mt7915_test_mcu_ops);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	/* rx DMA was set up */
+	KUNIT_EXPECT_NE(test, dev->mt76.q_rx[MT_RXQ_MAIN].ndesc, 0);
+
+	mt7915_init_test_dma_teardown(dev);
+}
+
+/* A failed mt7915_register_device() should leave the hardware as it found
+ * it: when mt7915_init_hardware() fails after the DMA init (no firmware),
+ * nothing stops the WFDMA engines or frees the rings, NAPI contexts and
+ * page pools (mt7915_stop_hardware() is only on the later error paths).
+ */
+static void mt7915_init_test_register_no_firmware_cleanup(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+
+	kunit_skip(test, "driver bug: mt7915_register_device() leaves DMA running and allocated when mt7915_init_hardware() fails");
+
+	dev = mt7915_init_test_dead_fw(test);
+	KUNIT_EXPECT_LT(test, mt7915_register_device(dev), 0);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WFDMA0_GLO_CFG) &
+			(MT_WFDMA0_GLO_CFG_TX_DMA_EN |
+			 MT_WFDMA0_GLO_CFG_RX_DMA_EN), 0);
+}
+
+static struct kunit_case mt7915_init_test_cases[] = {
+	KUNIT_CASE(mt7915_init_test_band_config),
+	KUNIT_CASE(mt7915_init_test_alloc_ext_phy),
+	KUNIT_CASE(mt7915_init_test_register_dbdc),
+	KUNIT_CASE(mt7915_init_test_register_mac2),
+	KUNIT_CASE(mt7915_init_test_register_single),
+	KUNIT_CASE(mt7915_init_test_wiphy),
+	KUNIT_CASE(mt7915_init_test_he_caps),
+	KUNIT_CASE(mt7915_init_test_he_caps_chains),
+	KUNIT_CASE(mt7915_init_test_he_caps_shrink),
+	KUNIT_CASE(mt7915_init_test_vht_txbf_caps),
+	KUNIT_CASE(mt7915_init_test_he_caps_mt7915),
+	KUNIT_CASE(mt7915_init_test_he_caps_6ghz),
+	KUNIT_CASE(mt7915_init_test_txpower),
+	KUNIT_CASE(mt7915_init_test_regd_notifier),
+	KUNIT_CASE(mt7915_init_test_mac_init),
+	KUNIT_CASE(mt7915_init_test_mac_init_mt7915),
+	KUNIT_CASE(mt7915_init_test_led_mux),
+	KUNIT_CASE(mt7915_init_test_led_mux_mt7916),
+	KUNIT_CASE(mt7915_init_test_leds),
+	KUNIT_CASE(mt7915_init_test_vow_init),
+	KUNIT_CASE(mt7915_init_test_vow_bss_grp),
+	KUNIT_CASE(mt7915_init_test_txbf_init),
+	KUNIT_CASE(mt7915_init_test_init_work),
+	KUNIT_CASE(mt7915_init_test_hwmon_show),
+	KUNIT_CASE(mt7915_init_test_hwmon_store),
+	KUNIT_CASE(mt7915_init_test_cooling),
+	KUNIT_CASE(mt7915_init_test_thermal_zone),
+	KUNIT_CASE(mt7915_init_test_wiphy_mt7915),
+	KUNIT_CASE(mt7915_init_test_txpower_6ghz),
+	KUNIT_CASE(mt7915_init_test_thermal_init_fails),
+	KUNIT_CASE(mt7915_init_test_wfsys_reset),
+	KUNIT_CASE(mt7915_init_test_unregister_device),
+	KUNIT_CASE(mt7915_init_test_register_no_firmware),
+	KUNIT_CASE(mt7915_init_test_register_no_firmware_cleanup),
+	{}
+};
+
+static struct kunit_suite mt7915_init_test_suite = {
+	.name = "mt7915-init",
+	.test_cases = mt7915_init_test_cases,
+};
+
+kunit_test_suites(&mt7915_init_test_suite);
diff --git a/mt7915/tests/main-test.c b/mt7915/tests/main-test.c
new file mode 100644
index 00000000..05537c20
--- /dev/null
+++ b/mt7915/tests/main-test.c
@@ -0,0 +1,3112 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for the mt7915 mac80211 callbacks (mt7915_ops): starting and
+ * stopping a band, interfaces, stations, keys, aggregation, BSS changes,
+ * filters, TSF, antennas, statistics and DFS background detection, checked
+ * against the fake firmware and registers of fake.h. Included at the end of
+ * mt7915/main.c when CONFIG_MT76_KUNIT_TEST is defined (milkflint's QEMU
+ * test build only).
+ *
+ * The device is the GL-MT6000's MT7986 (one MT7976C A-die, DBDC) of
+ * tests/init-test.c, registered with mac80211: band 0 (2.4 GHz) on
+ * dev->mt76.hw, band 1 (5 GHz) on its own hw. Interfaces and stations are
+ * allocated here and handed to the callbacks the way mac80211 would, but
+ * mac80211 itself never sees them, so the few paths that hand a vif back to
+ * mac80211 internals (beacon templates, ieee80211_find_sta() for a station
+ * interface, stopping a tx BA session) aren't reached.
+ */
+#include <kunit/test.h>
+#include "fake.h"
+#include "../eeprom.h"
+
+struct mt7915_dev *mt7915_init_test_device(struct kunit *test, u32 sku,
+					   struct mt76_test_fake **fake);
+
+/* A callback as mac80211 calls it, through the ops: called directly, the
+ * smallest ones get folded into the test.
+ */
+#define MT7915_MAIN_TEST_OP(op)		READ_ONCE(mt7915_ops.op)
+
+/* PM_STATE_CTRL states, from mt76_connac_mcu.c */
+#define MT7915_MAIN_TEST_ENTER_PM	1
+#define MT7915_MAIN_TEST_EXIT_PM	2
+
+/* --- the device and its fake firmware -------------------------------------- */
+
+struct mt7915_main_test_fw {
+	int fail_at;		/* the n-th message (1: the first) fails */
+	int err;		/* ... with this */
+	int temp;		/* THERMAL_CTRL temperature query answer */
+	bool rx_rate;		/* answer PHY_STAT_INFO with @rx */
+	struct mt7915_mcu_phy_rx_info rx;
+	bool sku;		/* answer tx power queries with @sku_val */
+	s8 sku_val[MT7915_SKU_RATE_NUM][2];
+};
+
+static void mt7915_main_test_reply(struct mt76_test_fake *fake,
+				   const struct mt76_test_msg *msg,
+				   struct sk_buff *reply)
+{
+	struct mt7915_main_test_fw *fw = fake->priv;
+
+	if (fw->fail_at && fake->n_msgs + 1 == fw->fail_at)
+		fake->mcu_ret = fw->err;
+
+	if (msg->cmd == MCU_EXT_CMD(THERMAL_CTRL)) {
+		__le32 v[2] = { 0, cpu_to_le32(fw->temp) };
+
+		skb_put_data(reply, v, sizeof(v));
+	} else if (msg->cmd == MCU_EXT_CMD(PHY_STAT_INFO) && fw->rx_rate) {
+		skb_put_data(reply, &fw->rx, sizeof(fw->rx));
+	} else if (msg->cmd == MCU_EXT_CMD(TX_POWER_FEATURE_CTRL) &&
+		   fw->sku && msg->data[0] == TX_POWER_LIMIT_INFO) {
+		skb_put_zero(reply, 4);
+		skb_put_data(reply, fw->sku_val, sizeof(fw->sku_val));
+	}
+}
+
+/* make the @n-th message from now on fail with @err */
+static void mt7915_main_test_fail_at(struct mt76_test_fake *fake, int n,
+				     int err)
+{
+	struct mt7915_main_test_fw *fw = fake->priv;
+
+	fake->mcu_ret = n == 1 ? err : 0;
+	fw->fail_at = n > 1 ? fake->n_msgs + n : 0;
+	fw->err = err;
+}
+
+/* forget the messages sent so far */
+static void mt7915_main_test_clear(struct mt76_test_fake *fake)
+{
+	struct mt7915_main_test_fw *fw = fake->priv;
+
+	INIT_LIST_HEAD(&fake->msgs);
+	fake->n_msgs = 0;
+	fake->mcu_ret = 0;
+	fw->fail_at = 0;
+}
+
+static void mt7915_main_test_cleanup(void *data)
+{
+	struct mt7915_dev *dev = data;
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+	if (phy2)
+		cancel_delayed_work_sync(&phy2->mt76->mac_work);
+	cancel_work_sync(&dev->rc_work);
+	cancel_work_sync(&dev->reset_work);
+	mt76_test_fake = NULL;
+}
+
+/* The DBDC MT7986, registered, not started. The fake of this file's fake.h
+ * copy points at the device's fake.
+ */
+static struct mt7915_dev *mt7915_main_test_dev(struct kunit *test)
+{
+	struct mt7915_main_test_fw *fw;
+	struct mt76_test_fake *fake;
+	struct mt7915_dev *dev;
+
+	dev = mt7915_init_test_device(test, MT7976_ONE_ADIE_DBDC, &fake);
+	KUNIT_ASSERT_NOT_NULL(test, mt7915_ext_phy(dev));
+	fw = kunit_kzalloc(test, sizeof(*fw), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, fw);
+	mt76_test_fake = fake;
+	fake->priv = fw;
+	fake->reply = mt7915_main_test_reply;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_main_test_cleanup, dev), 0);
+	mt7915_main_test_clear(fake);
+
+	return dev;
+}
+
+static struct ieee80211_hw *mt7915_main_test_hw2(struct mt7915_dev *dev)
+{
+	return mt7915_ext_phy(dev)->mt76->hw;
+}
+
+/* the first message with command @cmd, or NULL */
+static struct mt76_test_msg *mt7915_main_test_first(int cmd)
+{
+	struct mt76_test_msg *msg;
+
+	list_for_each_entry(msg, &mt76_test_fake->msgs, list)
+		if (msg->cmd == cmd)
+			return msg;
+	return NULL;
+}
+
+/* the TLV @tag of a STA_REC_UPDATE or BSS_INFO_UPDATE message, or NULL */
+static void *mt7915_main_test_tlv(const struct mt76_test_msg *msg, u16 tag)
+{
+	int i = sizeof(struct sta_req_hdr);
+
+	if (!msg)
+		return NULL;
+
+	while (i + sizeof(struct tlv) <= msg->len) {
+		const struct tlv *tlv = (const void *)(msg->data + i);
+		int len = le16_to_cpu(tlv->len);
+
+		if (le16_to_cpu(tlv->tag) == tag)
+			return (void *)tlv;
+		if (len < sizeof(*tlv))
+			break;
+		i += len;
+	}
+
+	return NULL;
+}
+
+/* a vif with room for the driver's state, as mac80211 allocates it */
+static struct ieee80211_vif *
+mt7915_main_test_vif(struct kunit *test, enum nl80211_iftype type, u8 id)
+{
+	struct ieee80211_vif *vif;
+
+	vif = kunit_kzalloc(test, sizeof(*vif) + sizeof(struct mt7915_vif),
+			    GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, vif);
+	vif->type = type;
+	vif->addr[0] = 0x02;
+	vif->addr[4] = 0x76;
+	vif->addr[5] = id;
+	vif->bss_conf.vif = vif;
+	/* mac80211 points an AP's BSSID at its own address */
+	vif->bss_conf.bssid = vif->addr;
+	vif->bss_conf.beacon_int = 100;
+	vif->bss_conf.dtim_period = 2;
+	vif->link_conf[0] = &vif->bss_conf;
+
+	return vif;
+}
+
+static struct mt7915_vif *mt7915_main_test_mvif(struct ieee80211_vif *vif)
+{
+	return (struct mt7915_vif *)vif->drv_priv;
+}
+
+/* an AP interface added on @hw */
+static struct ieee80211_vif *
+mt7915_main_test_ap(struct kunit *test, struct ieee80211_hw *hw, u8 id)
+{
+	struct ieee80211_vif *vif = mt7915_main_test_vif(test,
+							 NL80211_IFTYPE_AP, id);
+
+	KUNIT_ASSERT_EQ(test, mt7915_add_interface(hw, vif), 0);
+	return vif;
+}
+
+/* a station, as mac80211 allocates it, with one txq per tid */
+static struct ieee80211_sta *
+mt7915_main_test_sta(struct kunit *test, struct ieee80211_vif *vif, u8 id)
+{
+	struct ieee80211_sta *sta;
+	int i;
+
+	sta = kunit_kzalloc(test, sizeof(*sta) + sizeof(struct mt7915_sta),
+			    GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sta);
+	sta->addr[0] = 0x02;
+	sta->addr[4] = 0x5a;
+	sta->addr[5] = id;
+	sta->aid = id;
+	sta->wme = true;
+	sta->deflink.sta = sta;
+	memcpy(sta->deflink.addr, sta->addr, ETH_ALEN);
+	sta->deflink.rx_nss = 1;
+	sta->deflink.bandwidth = IEEE80211_STA_RX_BW_20;
+	sta->deflink.supp_rates[NL80211_BAND_2GHZ] = 0xfff;
+	sta->deflink.supp_rates[NL80211_BAND_5GHZ] = 0xff;
+	RCU_INIT_POINTER(sta->link[0], &sta->deflink);
+
+	for (i = 0; i < IEEE80211_NUM_TIDS; i++) {
+		struct ieee80211_txq *txq;
+
+		txq = kunit_kzalloc(test, sizeof(*txq) + sizeof(struct mt76_txq),
+				    GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, txq);
+		txq->vif = vif;
+		txq->sta = sta;
+		txq->tid = i;
+		sta->txq[i] = txq;
+	}
+
+	return sta;
+}
