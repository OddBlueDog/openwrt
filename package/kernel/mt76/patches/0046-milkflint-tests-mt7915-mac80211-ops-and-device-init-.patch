+/* Frames go out on the station's wcid, a vif's own broadcast wcid without
+ * a station, or the global one without either, on the hw's band.
+ */
+static void mt7915_main_test_tx(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw = dev->mt76.hw, *hw2 = mt7915_main_test_hw2(dev);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	struct ieee80211_tx_control control = {};
+	struct ieee80211_vif *vif, *vif2;
+	struct ieee80211_sta *sta;
+	struct mt76_wcid *wcids[3];
+	struct sk_buff *skbs[3];
+	int i;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	vif2 = mt7915_main_test_ap(test, hw2, 2);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	mt7915_main_test_msta(sta)->wcid.tx_info |= MT_WCID_TX_INFO_SET;
+	wcids[0] = &mt7915_main_test_msta(sta)->wcid;
+	wcids[1] = &mt7915_main_test_mvif(vif2)->sta.wcid;
+	wcids[2] = &dev->mt76.global_wcid;
+
+	/* the tx worker needs DMA queues: keep it off */
+	mt76_worker_disable(&dev->mt76.tx_worker);
+	for (i = 0; i < 3; i++) {
+		struct ieee80211_hdr *hdr;
+
+		skbs[i] = alloc_skb(64, GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, skbs[i]);
+		hdr = skb_put_zero(skbs[i], 24);
+		hdr->frame_control = cpu_to_le16(IEEE80211_FTYPE_DATA |
+						 IEEE80211_STYPE_DATA);
+		skb_set_queue_mapping(skbs[i], IEEE80211_AC_BE);
+	}
+
+	control.sta = sta;
+	IEEE80211_SKB_CB(skbs[0])->control.vif = vif;
+	mt7915_tx(hw, &control, skbs[0]);
+	control.sta = NULL;
+	IEEE80211_SKB_CB(skbs[1])->control.vif = vif2;
+	mt7915_tx(hw2, &control, skbs[1]);
+	mt7915_tx(hw, &control, skbs[2]);
+
+	for (i = 0; i < 3; i++)
+		KUNIT_EXPECT_PTR_EQ(test, skb_peek(&wcids[i]->tx_pending),
+				    skbs[i]);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TX_HW_QUEUE_PHY,
+			(u32)IEEE80211_SKB_CB(skbs[1])->hw_queue), 1);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TX_HW_QUEUE_PHY,
+			(u32)IEEE80211_SKB_CB(skbs[0])->hw_queue), 0);
+	KUNIT_EXPECT_FALSE(test, list_empty(&dev->mphy.tx_list));
+	KUNIT_EXPECT_FALSE(test, list_empty(&phy2->mt76->tx_list));
+
+	for (i = 0; i < 3; i++) {
+		struct mt76_phy *mphy = i == 1 ? phy2->mt76 : &dev->mphy;
+
+		spin_lock_bh(&mphy->tx_lock);
+		list_del_init(&wcids[i]->tx_list);
+		spin_unlock_bh(&mphy->tx_lock);
+		skb_queue_purge(&wcids[i]->tx_pending);
+	}
+	mt76_worker_enable(&dev->mt76.tx_worker);
+}
