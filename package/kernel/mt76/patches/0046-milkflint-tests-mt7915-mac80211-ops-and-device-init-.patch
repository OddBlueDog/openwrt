+/* The cooling device: 0-99 throttle states, mapped to the firmware's
+ * duty cycle (100 means no throttling) halved per level; the state only
+ * changes when the firmware took it.
+ */
+static void mt7915_init_test_cooling(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct thermal_cooling_device *cdev;
+	unsigned long state;
+	int i;
+
+	cdev = kunit_kzalloc(test, sizeof(*cdev), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, cdev);
+	cdev->devdata = &dev->phy;
+
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_get_max_throttle_state(cdev,
+								    &state), 0);
+	KUNIT_EXPECT_EQ(test, state, MT7915_CDEV_THROTTLE_MAX);
+
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_set_cur_throttle_state(cdev, 100),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_set_cur_throttle_state(cdev, 0),
+			0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_set_cur_throttle_state(cdev, 20),
+			0);
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_get_cur_throttle_state(cdev,
+								    &state), 0);
+	KUNIT_EXPECT_EQ(test, state, 20);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 4);
+	for (i = 0; i < 4; i++) {
+		struct mt76_test_msg *msg = mt76_test_msg(fake, i);
+
+		KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(THERMAL_PROT));
+		KUNIT_EXPECT_EQ(test, msg->data[0], THERMAL_PROTECT_DUTY_CONFIG);
+		KUNIT_EXPECT_EQ(test, msg->data[2], i);		/* level */
+		KUNIT_EXPECT_EQ(test, msg->data[3], 80 >> i);	/* duty */
+	}
+
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_set_cur_throttle_state(cdev, 50),
+			-EIO);
+	mt7915_thermal_get_cur_throttle_state(cdev, &state);
+	KUNIT_EXPECT_EQ(test, state, 20);
+}
