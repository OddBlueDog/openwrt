+/* hwmon: new limits are clamped to 60-130 degrees and rounded, the
+ * critical one must stay below the maximum, and the firmware gets the new
+ * protection thresholds (restore 10 degrees below critical).
+ */
+static void mt7915_init_test_hwmon_store(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_phy *phy = &dev->phy;
+	struct device *d = mt7915_init_test_hwmon_dev(test, phy);
+	struct device_attribute *crit = &sensor_dev_attr_temp1_crit.dev_attr;
+	struct device_attribute *max = &sensor_dev_attr_temp1_max.dev_attr;
+	struct mt76_test_msg *msg;
+
+	phy->throttle_temp[MT7915_CRIT_TEMP_IDX] = 110;
+	phy->throttle_temp[MT7915_MAX_TEMP_IDX] = 120;
+
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_temp_store(d, crit, "hot", 3),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_temp_store(d, crit, "125000", 6),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_temp_store(d, max, "100000", 6),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, phy->throttle_temp[MT7915_CRIT_TEMP_IDX], 110);
+	KUNIT_EXPECT_EQ(test, phy->throttle_temp[MT7915_MAX_TEMP_IDX], 120);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_temp_store(d, crit, "99600", 5),
+			5);
+	KUNIT_EXPECT_EQ(test, phy->throttle_temp[MT7915_CRIT_TEMP_IDX], 100);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(THERMAL_PROT));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->data[0], THERMAL_PROTECT_ENABLE);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data + 4), 120);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data + 8), 90);
+
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_temp_store(d, max, "500000", 6),
+			6);
+	KUNIT_EXPECT_EQ(test, phy->throttle_temp[MT7915_MAX_TEMP_IDX], 130);
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_temp_store(d, crit, "1", 1), 1);
+	KUNIT_EXPECT_EQ(test, phy->throttle_temp[MT7915_CRIT_TEMP_IDX], 60);
+
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_thermal_temp_store(d, max, "125000", 6),
+			-EIO);
+}
