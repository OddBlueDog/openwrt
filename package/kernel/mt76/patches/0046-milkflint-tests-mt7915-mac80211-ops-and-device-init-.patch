+/* The STA_REC BA TLV of the last BA message */
+static struct sta_rec_ba *mt7915_main_test_ba(void)
+{
+	return mt7915_main_test_tlv(mt76_test_find_msg(mt76_test_fake,
+				    MCU_EXT_CMD(STA_REC_UPDATE)), STA_REC_BA);
+}
+
+/* An rx BA session sets up mt76's reorder buffer and the firmware's
+ * recipient entry with the session's ssn and window; stopping it removes
+ * both.
+ */
+static void mt7915_main_test_ampdu_rx(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_ampdu_params p;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	struct sta_rec_ba *ba;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	mt7915_main_test_clear(fake);
+
+	mt7915_main_test_ba_params(&p, sta, IEEE80211_AMPDU_RX_START);
+	KUNIT_ASSERT_EQ(test, mt7915_ampdu_action(hw, vif, &p), 0);
+	KUNIT_EXPECT_NOT_NULL(test, rcu_access_pointer(msta->wcid.aggr[5]));
+	ba = mt7915_main_test_ba();
+	KUNIT_ASSERT_NOT_NULL(test, ba);
+	KUNIT_EXPECT_EQ(test, ba->tid, 5);
+	KUNIT_EXPECT_EQ(test, ba->ba_type, MT_BA_TYPE_RECIPIENT);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, BIT(5));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->ssn), 100);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->winsize), 64);
+
+	mt7915_main_test_clear(fake);
+	p.action = IEEE80211_AMPDU_RX_STOP;
+	KUNIT_ASSERT_EQ(test, mt7915_ampdu_action(hw, vif, &p), 0);
+	KUNIT_EXPECT_NULL(test, rcu_access_pointer(msta->wcid.aggr[5]));
+	ba = mt7915_main_test_ba();
+	KUNIT_ASSERT_NOT_NULL(test, ba);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, 0);
+	KUNIT_EXPECT_EQ(test, ba->ba_type, MT_BA_TYPE_RECIPIENT);
+
+	/* a tid mac80211 has no txq for */
+	sta->txq[5] = NULL;
+	mt7915_main_test_clear(fake);
+	KUNIT_EXPECT_EQ(test, mt7915_ampdu_action(hw, vif, &p), -EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+}
+
+/* tx BA: starting is immediate and only marks the tid; once operational
+ * the txq aggregates and the firmware gets an originator entry; stopping
+ * (flush) undoes both. A session without A-MSDU turns A-MSDU off for the
+ * station.
+ */
+static void mt7915_main_test_ampdu_tx(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_ampdu_params p;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	struct mt76_txq *mtxq;
+	struct sta_rec_ba *ba;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	mtxq = (struct mt76_txq *)sta->txq[5]->drv_priv;
+	msta->wcid.amsdu = true;
+	mt7915_main_test_clear(fake);
+
+	mt7915_main_test_ba_params(&p, sta, IEEE80211_AMPDU_TX_START);
+	KUNIT_EXPECT_EQ(test, mt7915_ampdu_action(hw, vif, &p),
+			IEEE80211_AMPDU_TX_START_IMMEDIATE);
+	KUNIT_EXPECT_TRUE(test, test_bit(5, &msta->wcid.ampdu_state));
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	mtxq->send_bar = true;
+	p.action = IEEE80211_AMPDU_TX_OPERATIONAL;
+	p.amsdu = true;
+	KUNIT_ASSERT_EQ(test, mt7915_ampdu_action(hw, vif, &p), 0);
+	KUNIT_EXPECT_TRUE(test, mtxq->aggr);
+	KUNIT_EXPECT_FALSE(test, mtxq->send_bar);
+	KUNIT_EXPECT_TRUE(test, msta->wcid.amsdu);
+	ba = mt7915_main_test_ba();
+	KUNIT_ASSERT_NOT_NULL(test, ba);
+	KUNIT_EXPECT_EQ(test, ba->ba_type, MT_BA_TYPE_ORIGINATOR);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, BIT(5));
+	KUNIT_EXPECT_EQ(test, ba->amsdu, 1);
+
+	p.amsdu = false;
+	KUNIT_ASSERT_EQ(test, mt7915_ampdu_action(hw, vif, &p), 0);
+	KUNIT_EXPECT_FALSE(test, msta->wcid.amsdu);
+
+	mt7915_main_test_clear(fake);
+	p.action = IEEE80211_AMPDU_TX_STOP_FLUSH;
+	KUNIT_ASSERT_EQ(test, mt7915_ampdu_action(hw, vif, &p), 0);
+	KUNIT_EXPECT_FALSE(test, mtxq->aggr);
+	KUNIT_EXPECT_FALSE(test, test_bit(5, &msta->wcid.ampdu_state));
+	ba = mt7915_main_test_ba();
+	KUNIT_ASSERT_NOT_NULL(test, ba);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, 0);
+
+	mtxq->aggr = true;
+	set_bit(5, &msta->wcid.ampdu_state);
+	p.action = IEEE80211_AMPDU_TX_STOP_FLUSH_CONT;
+	KUNIT_ASSERT_EQ(test, mt7915_ampdu_action(hw, vif, &p), 0);
+	KUNIT_EXPECT_FALSE(test, mtxq->aggr);
+	KUNIT_EXPECT_FALSE(test, test_bit(5, &msta->wcid.ampdu_state));
+
+	/* firmware errors are returned */
+	fake->mcu_ret = -EIO;
+	p.action = IEEE80211_AMPDU_TX_OPERATIONAL;
+	KUNIT_EXPECT_EQ(test, mt7915_ampdu_action(hw, vif, &p), -EIO);
+	p.action = IEEE80211_AMPDU_RX_STOP;
+	KUNIT_EXPECT_EQ(test, mt7915_ampdu_action(hw, vif, &p), -EIO);
+}
