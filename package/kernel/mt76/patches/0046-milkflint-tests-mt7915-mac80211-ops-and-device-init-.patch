+/* HE capabilities of a 4x4 MT7986 band, per interface type: an AP is a
+ * full SU/MU beamformer with TWT responder and UL MU-MIMO, a station a
+ * SU beamformer, both 4 stream beamformees with MCS 0-11 on 4 streams up
+ * to 160 MHz on 5 GHz. Mesh gets HE without beamforming.
+ */
+static void mt7915_init_test_he_caps(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_device(test,
+							 MT7976_ONE_ADIE_DBDC,
+							 NULL);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	struct ieee80211_supported_band *sb2 = &dev->mphy.sband_2g.sband;
+	struct ieee80211_supported_band *sb5 = &phy2->mt76->sband_5g.sband;
+	const struct ieee80211_sta_he_cap *ap, *sta;
+	const u8 *phy, *mac;
+
+	KUNIT_EXPECT_EQ(test, sb2->n_iftype_data, MT7915_INIT_TEST_N_HE);
+	KUNIT_EXPECT_EQ(test, sb5->n_iftype_data, MT7915_INIT_TEST_N_HE);
+
+	ap = ieee80211_get_he_iftype_cap(sb2, NL80211_IFTYPE_AP);
+	KUNIT_ASSERT_NOT_NULL(test, ap);
+	KUNIT_EXPECT_TRUE(test, ap->has_he);
+	mac = ap->he_cap_elem.mac_cap_info;
+	phy = ap->he_cap_elem.phy_cap_info;
+	KUNIT_EXPECT_EQ(test, mac[0], IEEE80211_HE_MAC_CAP0_HTC_HE |
+			IEEE80211_HE_MAC_CAP0_TWT_RES);
+	KUNIT_EXPECT_EQ(test, mac[2], IEEE80211_HE_MAC_CAP2_BSR);
+	KUNIT_EXPECT_EQ(test, mac[3], IEEE80211_HE_MAC_CAP3_OMI_CONTROL |
+			IEEE80211_HE_MAC_CAP3_MAX_AMPDU_LEN_EXP_EXT_3);
+	KUNIT_EXPECT_EQ(test, mac[4], IEEE80211_HE_MAC_CAP4_AMSDU_IN_AMPDU |
+			IEEE80211_HE_MAC_CAP4_BQR);
+	KUNIT_EXPECT_EQ(test, mac[5],
+			IEEE80211_HE_MAC_CAP5_OM_CTRL_UL_MU_DATA_DIS_RX);
+	KUNIT_EXPECT_EQ(test, phy[0],
+			IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_40MHZ_IN_2G);
+	KUNIT_EXPECT_EQ(test, phy[1],
+			IEEE80211_HE_PHY_CAP1_LDPC_CODING_IN_PAYLOAD);
+	KUNIT_EXPECT_EQ(test, phy[2], IEEE80211_HE_PHY_CAP2_STBC_TX_UNDER_80MHZ |
+			IEEE80211_HE_PHY_CAP2_STBC_RX_UNDER_80MHZ |
+			IEEE80211_HE_PHY_CAP2_NDP_4x_LTF_AND_3_2US |
+			IEEE80211_HE_PHY_CAP2_UL_MU_FULL_MU_MIMO);
+	KUNIT_EXPECT_EQ(test, phy[3],
+			IEEE80211_HE_PHY_CAP3_DCM_MAX_CONST_TX_QPSK |
+			IEEE80211_HE_PHY_CAP3_DCM_MAX_CONST_RX_QPSK |
+			IEEE80211_HE_PHY_CAP3_SU_BEAMFORMER);
+	KUNIT_EXPECT_EQ(test, phy[4], IEEE80211_HE_PHY_CAP4_SU_BEAMFORMEE |
+			IEEE80211_HE_PHY_CAP4_BEAMFORMEE_MAX_STS_UNDER_80MHZ_4 |
+			IEEE80211_HE_PHY_CAP4_BEAMFORMEE_MAX_STS_ABOVE_80MHZ_4 |
+			IEEE80211_HE_PHY_CAP4_MU_BEAMFORMER);
+	KUNIT_EXPECT_EQ(test, phy[5],
+		FIELD_PREP(IEEE80211_HE_PHY_CAP5_BEAMFORMEE_NUM_SND_DIM_UNDER_80MHZ_MASK, 3) |
+		FIELD_PREP(IEEE80211_HE_PHY_CAP5_BEAMFORMEE_NUM_SND_DIM_ABOVE_80MHZ_MASK, 3));
+	KUNIT_EXPECT_EQ(test, phy[6],
+			IEEE80211_HE_PHY_CAP6_PARTIAL_BW_EXT_RANGE |
+			IEEE80211_HE_PHY_CAP6_PPE_THRESHOLD_PRESENT |
+			IEEE80211_HE_PHY_CAP6_CODEBOOK_SIZE_42_SU |
+			IEEE80211_HE_PHY_CAP6_CODEBOOK_SIZE_75_MU |
+			IEEE80211_HE_PHY_CAP6_TRIG_SU_BEAMFORMING_FB |
+			IEEE80211_HE_PHY_CAP6_TRIG_MU_BEAMFORMING_PARTIAL_BW_FB);
+	/* Nc 3 (index 2), STBC beyond 80 MHz */
+	KUNIT_EXPECT_EQ(test, phy[7], (2 << 3) |
+			IEEE80211_HE_PHY_CAP7_STBC_TX_ABOVE_80MHZ |
+			IEEE80211_HE_PHY_CAP7_STBC_RX_ABOVE_80MHZ);
+	KUNIT_EXPECT_EQ(test, phy[9],
+			IEEE80211_HE_PHY_CAP9_TX_1024_QAM_LESS_THAN_242_TONE_RU |
+			IEEE80211_HE_PHY_CAP9_RX_1024_QAM_LESS_THAN_242_TONE_RU);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ap->he_mcs_nss_supp.rx_mcs_80),
+			0xffaa);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ap->he_mcs_nss_supp.tx_mcs_80),
+			0xffaa);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ap->he_mcs_nss_supp.rx_mcs_160),
+			0xffaa);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ap->he_mcs_nss_supp.tx_mcs_160),
+			0xffaa);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ap->he_mcs_nss_supp.rx_mcs_80p80),
+			0);
+	/* PPE thresholds for 4 streams */
+	KUNIT_EXPECT_EQ(test, ap->ppe_thres[0] &
+			IEEE80211_PPE_THRES_NSS_MASK, 3);
+
+	sta = ieee80211_get_he_iftype_cap(sb2, NL80211_IFTYPE_STATION);
+	KUNIT_ASSERT_NOT_NULL(test, sta);
+	mac = sta->he_cap_elem.mac_cap_info;
+	phy = sta->he_cap_elem.phy_cap_info;
+	KUNIT_EXPECT_EQ(test, mac[0], IEEE80211_HE_MAC_CAP0_HTC_HE);
+	KUNIT_EXPECT_EQ(test, mac[1], IEEE80211_HE_MAC_CAP1_TF_MAC_PAD_DUR_16US);
+	KUNIT_EXPECT_EQ(test, phy[0],
+			IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_40MHZ_IN_2G |
+			IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_RU_MAPPING_IN_2G);
+	KUNIT_EXPECT_EQ(test, phy[1],
+			IEEE80211_HE_PHY_CAP1_LDPC_CODING_IN_PAYLOAD |
+			IEEE80211_HE_PHY_CAP1_DEVICE_CLASS_A |
+			IEEE80211_HE_PHY_CAP1_HE_LTF_AND_GI_FOR_HE_PPDUS_0_8US);
+	KUNIT_EXPECT_NE(test, phy[3] & IEEE80211_HE_PHY_CAP3_SU_BEAMFORMER, 0);
+	KUNIT_EXPECT_EQ(test, phy[4] & IEEE80211_HE_PHY_CAP4_MU_BEAMFORMER, 0);
+	KUNIT_EXPECT_NE(test, phy[6] &
+			IEEE80211_HE_PHY_CAP6_PARTIAL_BANDWIDTH_DL_MUMIMO, 0);
+	KUNIT_EXPECT_NE(test, phy[6] & IEEE80211_HE_PHY_CAP6_TRIG_CQI_FB, 0);
+	KUNIT_EXPECT_EQ(test, phy[6] &
+			IEEE80211_HE_PHY_CAP6_TRIG_SU_BEAMFORMING_FB, 0);
+	KUNIT_EXPECT_EQ(test, phy[7] & IEEE80211_HE_PHY_CAP7_MAX_NC_MASK,
+			2 << 3);
+	KUNIT_EXPECT_NE(test, phy[7] &
+			IEEE80211_HE_PHY_CAP7_POWER_BOOST_FACTOR_SUPP, 0);
+	KUNIT_EXPECT_EQ(test, phy[8],
+			IEEE80211_HE_PHY_CAP8_20MHZ_IN_40MHZ_HE_PPDU_IN_2G |
+			IEEE80211_HE_PHY_CAP8_DCM_MAX_RU_484 |
+			IEEE80211_HE_PHY_CAP8_20MHZ_IN_160MHZ_HE_PPDU |
+			IEEE80211_HE_PHY_CAP8_80MHZ_IN_160MHZ_HE_PPDU);
+	KUNIT_EXPECT_NE(test, phy[9] &
+			IEEE80211_HE_PHY_CAP9_NON_TRIGGERED_CQI_FEEDBACK, 0);
+
+#ifdef CONFIG_MAC80211_MESH
+	{
+		const struct ieee80211_sta_he_cap *mesh;
+
+		mesh = ieee80211_get_he_iftype_cap(sb2,
+						   NL80211_IFTYPE_MESH_POINT);
+		KUNIT_ASSERT_NOT_NULL(test, mesh);
+		phy = mesh->he_cap_elem.phy_cap_info;
+		KUNIT_EXPECT_EQ(test, phy[4], 0);
+		KUNIT_EXPECT_EQ(test, phy[3] &
+				IEEE80211_HE_PHY_CAP3_SU_BEAMFORMER, 0);
+		/* no PPE thresholds: nominal padding instead */
+		KUNIT_EXPECT_EQ(test, u8_get_bits(phy[9],
+				IEEE80211_HE_PHY_CAP9_NOMINAL_PKT_PADDING_MASK),
+				IEEE80211_HE_PHY_CAP9_NOMINAL_PKT_PADDING_16US);
+	}
+#endif
+
+	/* 5 GHz: 160 MHz, the 5 GHz RU mapping */
+	ap = ieee80211_get_he_iftype_cap(sb5, NL80211_IFTYPE_AP);
+	sta = ieee80211_get_he_iftype_cap(sb5, NL80211_IFTYPE_STATION);
+	KUNIT_ASSERT_NOT_NULL(test, ap);
+	KUNIT_ASSERT_NOT_NULL(test, sta);
+	KUNIT_EXPECT_EQ(test, ap->he_cap_elem.phy_cap_info[0],
+		IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_40MHZ_80MHZ_IN_5G |
