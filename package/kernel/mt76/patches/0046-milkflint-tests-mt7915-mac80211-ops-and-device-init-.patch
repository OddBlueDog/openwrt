+/* Starting an AP records which capabilities the BSS advertises (they shape
+ * the stations' beamforming and coding later), then brings the BSS and its
+ * broadcast peer up; a firmware error stops it early. Stopping it takes the
+ * broadcast peer down.
+ */
+static void mt7915_main_test_start_stop_ap(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct mt7915_vif_cap *cap;
+	struct sta_rec_basic *sbasic;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	cap = &mt7915_main_test_mvif(vif)->cap;
+	mt7915_main_test_clear(fake);
+
+	vif->bss_conf.ht_ldpc = true;
+	vif->bss_conf.vht_su_beamformer = true;
+	vif->bss_conf.vht_mu_beamformee = true;
+	vif->bss_conf.he_ldpc = true;
+	vif->bss_conf.he_su_beamformee = true;
+	vif->bss_conf.he_mu_beamformer = true;
+	KUNIT_ASSERT_EQ(test, mt7915_start_ap(hw, vif, &vif->bss_conf), 0);
+	KUNIT_EXPECT_TRUE(test, cap->ht_ldpc);
+	KUNIT_EXPECT_FALSE(test, cap->vht_ldpc);
+	KUNIT_EXPECT_TRUE(test, cap->vht_su_ebfer);
+	KUNIT_EXPECT_FALSE(test, cap->vht_su_ebfee);
+	KUNIT_EXPECT_FALSE(test, cap->vht_mu_ebfer);
+	KUNIT_EXPECT_TRUE(test, cap->vht_mu_ebfee);
+	KUNIT_EXPECT_TRUE(test, cap->he_ldpc);
+	KUNIT_EXPECT_FALSE(test, cap->he_su_ebfer);
+	KUNIT_EXPECT_TRUE(test, cap->he_su_ebfee);
+	KUNIT_EXPECT_TRUE(test, cap->he_mu_ebfer);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->cmd,
+			MCU_EXT_CMD(BSS_INFO_UPDATE));
+	sbasic = mt7915_main_test_tlv(mt76_test_msg(fake, 1), STA_REC_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, sbasic);
+	KUNIT_EXPECT_EQ(test, sbasic->conn_state, CONN_STATE_PORT_SECURE);
+	/* band 0, hw BSSID 0: group 0 */
+	mt7915_main_test_check_group(test, mt76_test_msg(fake, 2), 0);
+
+	mt7915_main_test_clear(fake);
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_start_ap(hw, vif, &vif->bss_conf), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+
+	mt7915_main_test_clear(fake);
+	mt7915_stop_ap(hw, vif, &vif->bss_conf);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 1);
+	sbasic = mt7915_main_test_tlv(mt76_test_msg(fake, 0), STA_REC_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, sbasic);
+	KUNIT_EXPECT_EQ(test, sbasic->conn_state, CONN_STATE_DISCONNECT);
+}
