+		IEEE80211_HE_PHY_CAP5_BEAMFORMEE_NUM_SND_DIM_ABOVE_80MHZ_MASK), 1);
+
+	dev->dbdc_support = true;
+	memset(data, 0, NUM_NL80211_IFTYPES * sizeof(*data));
+	n = mt7915_init_he_caps(phy, NL80211_BAND_5GHZ, data);
