+/* The TSF of a BSS is read, set or adjusted through the band's LPON
+ * registers: the own MAC's TSF control register selects the operation and
+ * UTTR0/1 carry the value. Extended BSSIDs use hw BSSID 0's timer.
+ */
+static void mt7915_main_test_tsf(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw = dev->mt76.hw, *hw2 = mt7915_main_test_hw2(dev);
+	struct ieee80211_vif *vif, *vif2, *vif3;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	vif2 = mt7915_main_test_ap(test, hw, 2);	/* extended BSSID */
+	vif3 = mt7915_main_test_vif(test, NL80211_IFTYPE_MESH_POINT, 3);
+	KUNIT_ASSERT_EQ(test, mt7915_add_interface(hw2, vif3), 0);
+
+	mt76_wr(dev, MT_LPON_UTTR0(0), 0x89abcdef);
+	mt76_wr(dev, MT_LPON_UTTR1(0), 0x01234567);
+	KUNIT_EXPECT_EQ(test, mt7915_get_tsf(hw, vif2), 0x0123456789abcdefULL);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_TCR_MT7916(0, 0)) &
+			MT_LPON_TCR_SW_MODE, MT_LPON_TCR_SW_READ);
+
+	mt7915_set_tsf(hw, vif, 0x1122334455667788ULL);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_UTTR0(0)), 0x55667788);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_UTTR1(0)), 0x11223344);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_TCR_MT7916(0, 0)) &
+			MT_LPON_TCR_SW_MODE, MT_LPON_TCR_SW_WRITE);
+
+	/* band 1, hw BSSID 1 */
+	mt7915_offset_tsf(hw2, vif3, -2);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_UTTR0(1)), 0xfffffffe);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_UTTR1(1)), 0xffffffff);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_TCR_MT7916(1, 1)) &
+			MT_LPON_TCR_SW_MODE, MT_LPON_TCR_SW_ADJUST);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_TCR_MT7916(1, 0)), 0);
+
+	mt76_wr(dev, MT_LPON_UTTR0(1), 5);
+	mt76_wr(dev, MT_LPON_UTTR1(1), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_get_tsf(hw2, vif3), 5);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_TCR_MT7916(1, 1)) &
+			MT_LPON_TCR_SW_MODE, MT_LPON_TCR_SW_READ);
+
+	/* the MT7915 has its TSF control registers elsewhere (cheap: only
+	 * the chip id is checked)
+	 */
+	dev->mt76.rev = 0x79150000;
+	mt7915_set_tsf(hw, vif, 1);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_TCR(0, 0)) &
+			MT_LPON_TCR_SW_MODE, MT_LPON_TCR_SW_WRITE);
+	mt7915_offset_tsf(hw, vif, 1);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_TCR(0, 0)) &
+			MT_LPON_TCR_SW_MODE, MT_LPON_TCR_SW_ADJUST);
+	mt7915_get_tsf(hw, vif);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_LPON_TCR(0, 0)) &
+			MT_LPON_TCR_SW_MODE, MT_LPON_TCR_SW_READ);
+	dev->mt76.rev = 0x79860000;
+}
