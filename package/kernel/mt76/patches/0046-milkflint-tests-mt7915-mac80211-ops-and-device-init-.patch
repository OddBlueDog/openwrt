+/* The per-station ethtool worker only adds the interface's own stations. */
+static void mt7915_main_test_ethtool_worker(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct mt76_ethtool_worker_info wi = {};
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	u64 *data;
+	int base = mt7915_main_test_stat_idx("v_tx_mode_cck");
+
+	data = kunit_kcalloc(test, MT7915_SSTATS_LEN, sizeof(*data),
+			     GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	mt7915_main_test_msta(sta)->wcid.stats.tx_mode[MT_PHY_TYPE_CCK] = 4;
+
+	wi.data = data;
+	wi.initial_stat_idx = base;
+	wi.idx = mt7915_main_test_mvif(vif)->mt76.idx + 1;
+	mt7915_ethtool_worker(&wi, sta);
+	KUNIT_EXPECT_EQ(test, wi.sta_count, 0);
+	KUNIT_EXPECT_EQ(test, data[base], 0);
+
+	wi.idx = mt7915_main_test_mvif(vif)->mt76.idx;
+	mt7915_ethtool_worker(&wi, sta);
+	KUNIT_EXPECT_EQ(test, wi.sta_count, 1);
+	KUNIT_EXPECT_EQ(test, data[base], 4);
+}
