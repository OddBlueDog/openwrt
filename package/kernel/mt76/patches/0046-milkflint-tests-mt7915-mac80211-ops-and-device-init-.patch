+/* --- stations ---------------------------------------------------------------- */
+
+/* A new station gets a wcid below the interfaces' range, starts disabled
+ * for tx, and the firmware gets a new disconnected station entry plus its
+ * airtime fairness setup (unpaused, default weight in the BSS's group).
+ */
+static void mt7915_main_test_sta_add(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw2 = mt7915_main_test_hw2(dev);
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	struct mt76_test_msg *msg;
+	struct sta_rec_basic *sbasic;
+
+	vif = mt7915_main_test_ap(test, hw2, 1);
+	mt7915_main_test_clear(fake);
+	sta = mt7915_main_test_sta(test, vif, 1);
+	sta->tdls = true;
+	msta = mt7915_main_test_msta(sta);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mac_sta_add(&dev->mt76, vif, sta), 0);
+	KUNIT_EXPECT_EQ(test, msta->wcid.idx, 2);
+	KUNIT_EXPECT_LT(test, msta->wcid.idx, MT7915_WTBL_STA);
+	KUNIT_EXPECT_PTR_EQ(test, msta->vif, mt7915_main_test_mvif(vif));
+	KUNIT_EXPECT_EQ(test, (int)msta->wcid.sta_disabled, 1);
+	KUNIT_EXPECT_EQ(test, (int)msta->wcid.sta, 0);
+	KUNIT_EXPECT_EQ(test, (int)msta->wcid.phy_idx, 1);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_TDLS_PEER,
+					 &msta->wcid.flags));
+	KUNIT_EXPECT_TRUE(test, list_empty(&msta->rc_list));
+
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	KUNIT_EXPECT_EQ(test, msg->data[1], 2);
+	sbasic = mt7915_main_test_tlv(msg, STA_REC_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, sbasic);
+	KUNIT_EXPECT_EQ(test, sbasic->conn_state, CONN_STATE_DISCONNECT);
+	KUNIT_EXPECT_MEMEQ(test, sbasic->peer_addr, sta->addr, ETH_ALEN);
+	/* new entry, with its WTBL */
+	KUNIT_EXPECT_NOT_NULL(test, mt7915_main_test_tlv(msg, STA_REC_WTBL));
+	msg = mt76_test_msg(fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_DRR_CTRL));
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data),
+			VOW_DRR_CTRL_STA_PAUSE);
+	KUNIT_EXPECT_EQ(test, msg->data[4], 2);
+	msg = mt76_test_msg(fake, 2);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data),
+			VOW_DRR_CTRL_STA_ALL);
+	/* band 1, hw BSSID 0: airtime group 4 */
+	KUNIT_EXPECT_EQ(test, FIELD_GET(VOW_DRR_STA_BSS_GRP_MASK,
+					get_unaligned_le32(msg->data + 12)), 4);
+}
