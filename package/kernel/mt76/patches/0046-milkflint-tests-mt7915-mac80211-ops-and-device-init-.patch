+/* 4-address mode and rx header decap offload are station flags; an
+ * associated station's WTBL header translation is updated with them.
+ */
+static void mt7915_main_test_sta_flags(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	mt7915_main_test_clear(fake);
+
+	mt7915_sta_set_4addr(hw, vif, sta, true);
+	mt7915_sta_set_decap_offload(hw, vif, sta, true);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_4ADDR, &msta->wcid.flags));
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_HDR_TRANS,
+					 &msta->wcid.flags));
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	msta->wcid.sta = 1;
+	mt7915_sta_set_4addr(hw, vif, sta, false);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_4ADDR,
+					  &msta->wcid.flags));
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 1);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->cmd,
+			MCU_EXT_CMD(WTBL_UPDATE));
+	mt7915_sta_set_decap_offload(hw, vif, sta, false);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_HDR_TRANS,
+					  &msta->wcid.flags));
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 2);
+	/* the WTBL index is the station's */
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 1)->data[0],
+			msta->wcid.idx);
+}
