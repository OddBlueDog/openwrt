+/* --- start / stop ---------------------------------------------------------- */
+
+/* Starting band 0 powers its MAC on in the firmware (power save off first,
+ * then MAC and header translation), arms thermal protection and tx power
+ * limits, programs the rx path and starts the watchdog; stopping it powers
+ * the MAC back off.
+ */
+static void mt7915_main_test_start_stop(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct mt76_test_msg *msg;
+
+	dev->mphy.aggr_stats[0] = 7;
+
+	KUNIT_ASSERT_EQ(test, mt7915_start(hw), 0);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_RUNNING, &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&dev->mphy.mac_work));
+	/* counters start from zero on a fresh start */
+	KUNIT_EXPECT_EQ(test, dev->mphy.aggr_stats[0], 0);
+
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(PM_STATE_CTRL));
+	KUNIT_EXPECT_EQ(test, msg->data[1], MT7915_MAIN_TEST_EXIT_PM);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(MAC_INIT_CTRL));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->data[0], 1);		/* enable */
+	KUNIT_EXPECT_EQ(test, msg->data[1], 0);		/* band */
+	/* header translation on */
+	msg = mt7915_main_test_first(MCU_EXT_CMD(RX_HDR_TRANS));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->data[1], 1);
+	/* 4 duty cycle levels, then protection off and on again */
+	KUNIT_EXPECT_EQ(test, mt76_test_count_msgs(fake,
+			MCU_EXT_CMD(THERMAL_PROT)), 6);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(PROTECT_CTRL));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(msg->data + 4),
+			MT7915_RTS_LEN_THRES);
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(SET_RX_PATH));
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->data[6], 0);		/* band_idx */
+	/* noise floor measurement on */
+	KUNIT_EXPECT_NE(test, mt76_rr(dev, MT_WF_PHY_RXTD12_MT7916(0)) &
+			MT_WF_PHY_RXTD12_IRPI_SW_CLR, 0);
+
+	mt7915_main_test_clear(fake);
+	mt7915_stop(hw, false);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_RUNNING,
+					  &dev->mphy.state));
+	KUNIT_EXPECT_FALSE(test, delayed_work_pending(&dev->mphy.mac_work));
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(PM_STATE_CTRL));
+	KUNIT_EXPECT_EQ(test, msg->data[1], MT7915_MAIN_TEST_ENTER_PM);
+	msg = mt76_test_msg(fake, 2);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(MAC_INIT_CTRL));
+	KUNIT_EXPECT_EQ(test, msg->data[0], 0);
+	KUNIT_EXPECT_EQ(test, msg->data[1], 0);
+}
+
+static bool mt7915_main_test_band_msgs(struct mt76_test_fake *fake, int cmd,
+				       u8 band)
+{
+	struct mt76_test_msg *msg;
+
+	list_for_each_entry(msg, &fake->msgs, list) {
+		if (msg->cmd != cmd)
+			continue;
+		if (cmd == MCU_EXT_CMD(PM_STATE_CTRL) && msg->data[20] == band)
+			return true;
+		if (cmd == MCU_EXT_CMD(MAC_INIT_CTRL) && msg->data[1] == band)
+			return true;
+	}
+	return false;
+}
+
+/* Band 0's MAC must be up for band 1 to work: starting band 1 alone powers
+ * both on, starting it while band 0 runs only adds band 1, and the main
+ * band is only powered down once neither band runs.
+ */
+static void mt7915_main_test_start_stop_dbdc(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw, *hw2 = mt7915_main_test_hw2(dev);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	u32 pm = MCU_EXT_CMD(PM_STATE_CTRL), mac = MCU_EXT_CMD(MAC_INIT_CTRL);
+
+	/* band 1 alone */
+	KUNIT_ASSERT_EQ(test, mt7915_start(hw2), 0);
+	KUNIT_EXPECT_TRUE(test, mt7915_main_test_band_msgs(fake, pm, 0));
+	KUNIT_EXPECT_TRUE(test, mt7915_main_test_band_msgs(fake, pm, 1));
+	KUNIT_EXPECT_TRUE(test, mt7915_main_test_band_msgs(fake, mac, 0));
+	KUNIT_EXPECT_TRUE(test, mt7915_main_test_band_msgs(fake, mac, 1));
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_RUNNING,
+					 &phy2->mt76->state));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_RUNNING,
+					  &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&phy2->mt76->mac_work));
+	KUNIT_EXPECT_EQ(test, mt76_test_find_msg(fake,
+			MCU_EXT_CMD(SET_RX_PATH))->data[6], 1);
+
+	/* stopping it powers both down */
+	mt7915_main_test_clear(fake);
+	mt7915_stop(hw2, false);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_RUNNING,
+					  &phy2->mt76->state));
+	KUNIT_EXPECT_TRUE(test, mt7915_main_test_band_msgs(fake, mac, 1));
+	KUNIT_EXPECT_TRUE(test, mt7915_main_test_band_msgs(fake, mac, 0));
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 6);
+
+	/* band 0 running: band 1 only touches band 1 */
+	KUNIT_ASSERT_EQ(test, mt7915_start(hw), 0);
+	mt7915_main_test_clear(fake);
+	KUNIT_ASSERT_EQ(test, mt7915_start(hw2), 0);
+	KUNIT_EXPECT_FALSE(test, mt7915_main_test_band_msgs(fake, pm, 0));
+	KUNIT_EXPECT_FALSE(test, mt7915_main_test_band_msgs(fake, mac, 0));
+	KUNIT_EXPECT_TRUE(test, mt7915_main_test_band_msgs(fake, mac, 1));
+
+	mt7915_main_test_clear(fake);
+	mt7915_stop(hw2, false);
+	KUNIT_EXPECT_TRUE(test, mt7915_main_test_band_msgs(fake, mac, 1));
+	KUNIT_EXPECT_FALSE(test, mt7915_main_test_band_msgs(fake, mac, 0));
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 3);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_STATE_RUNNING, &dev->mphy.state));
+
+	mt7915_main_test_clear(fake);
+	mt7915_stop(hw, false);
+	KUNIT_EXPECT_TRUE(test, mt7915_main_test_band_msgs(fake, mac, 0));
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 3);
+}
+
+/* Any firmware command failing while starting a band fails the start: the
+ * band isn't marked running, no watchdog runs, and nothing more is sent.
+ */
+static void mt7915_main_test_start_errors(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw2 = mt7915_main_test_hw2(dev);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	bool blacklist[32] = {};
+	int n, total;
+
+	/* band 1 alone sends band 0's commands too: every step is there */
+	KUNIT_ASSERT_EQ(test, mt7915_start(hw2), 0);
+	total = fake->n_msgs;
+	KUNIT_ASSERT_LE(test, total, ARRAY_SIZE(blacklist));
+	/* the rx header translation blacklist (operation 1) may fail alone */
+	for (n = 1; n <= total; n++) {
+		struct mt76_test_msg *msg = mt76_test_msg(fake, n - 1);
+
+		blacklist[n - 1] = msg->cmd == MCU_EXT_CMD(RX_HDR_TRANS) &&
+				   msg->data[0] == 1;
+	}
+	mt7915_stop(hw2, false);
+	cancel_delayed_work_sync(&phy2->mt76->mac_work);
+
+	/* the last message, the counter query, isn't checked */
+	for (n = 1; n < total; n++) {
+		mt7915_main_test_clear(fake);
+		mt7915_main_test_fail_at(fake, n, -EIO);
+		KUNIT_EXPECT_EQ_MSG(test, mt7915_start(hw2), -EIO,
+				    "message %d", n);
+		/* a failed blacklist only shows with the next command */
+		KUNIT_EXPECT_EQ_MSG(test, fake->n_msgs,
+				    n + blacklist[n - 1], "message %d", n);
+		KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_RUNNING,
+						  &phy2->mt76->state));
+		KUNIT_EXPECT_FALSE(test,
+			delayed_work_pending(&phy2->mt76->mac_work));
+	}
+	mt7915_main_test_clear(fake);
+}
+
+/* After a hw restart mac80211 completes the reconfiguration: queues run
+ * again and the watchdog is back.
+ */
+static void mt7915_main_test_reconfig_complete(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw = dev->mt76.hw;
+
+	ieee80211_stop_queues(hw);
+	KUNIT_ASSERT_TRUE(test, ieee80211_queue_stopped(hw, 0));
+
+	mt7915_reconfig_complete(hw, IEEE80211_RECONFIG_TYPE_RESTART);
+	KUNIT_EXPECT_FALSE(test, ieee80211_queue_stopped(hw, 0));
+	KUNIT_EXPECT_FALSE(test, ieee80211_queue_stopped(hw, 3));
+	KUNIT_EXPECT_TRUE(test, delayed_work_pending(&dev->mphy.mac_work));
+}
