+/* Disassociation tears down the station's TWT agreements, disconnects it
+ * in the firmware and stops tx to it.
+ */
+static void mt7915_main_test_sta_disassoc(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	struct mt7915_twt_flow *flow;
+	struct sta_rec_basic *sbasic;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	sta = mt7915_main_test_add_sta(test, hw, vif, 1);
+	msta = mt7915_main_test_msta(sta);
+	KUNIT_ASSERT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_AUTH,
+					     IEEE80211_STA_ASSOC), 0);
+
+	flow = &msta->twt.flow[1];
+	flow->id = 1;
+	flow->table_id = 3;
+	msta->twt.flowid_mask = BIT(1);
+	dev->twt.table_mask = BIT(3);
+	dev->twt.n_agrt = 1;
+	list_add_tail(&flow->list, &dev->twt_list);
+	mt7915_main_test_clear(fake);
+
+	KUNIT_ASSERT_EQ(test, mt76_sta_state(hw, vif, sta, IEEE80211_STA_ASSOC,
+					     IEEE80211_STA_AUTH), 0);
+	KUNIT_EXPECT_EQ(test, msta->twt.flowid_mask, 0);
+	KUNIT_EXPECT_EQ(test, dev->twt.n_agrt, 0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->twt_list));
+	KUNIT_EXPECT_EQ(test, (int)msta->wcid.sta, 0);
+	KUNIT_EXPECT_EQ(test, (int)msta->wcid.sta_disabled, 1);
+	KUNIT_EXPECT_EQ(test, msta->wcid.tx_info & MT_WCID_TX_INFO_SET, 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->cmd,
+			MCU_EXT_CMD(TWT_AGRT_UPDATE));
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->data[1],
+			MCU_TWT_AGRT_DELETE);
+	sbasic = mt7915_main_test_tlv(mt76_test_msg(fake, 1), STA_REC_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, sbasic);
+	KUNIT_EXPECT_EQ(test, sbasic->conn_state, CONN_STATE_DISCONNECT);
+}
