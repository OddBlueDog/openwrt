+/* HE caps of @dev's 2.4 GHz band with @chains chains, computed afresh */
+static const struct ieee80211_sta_he_cap *
+mt7915_init_test_he_chains(struct mt7915_dev *dev, u8 chains)
+{
+	memset(dev->phy.iftype, 0, sizeof(dev->phy.iftype));
+	dev->mphy.cap.has_2ghz = true;
+	dev->mphy.antenna_mask = chains;
+	dev->mphy.chainmask = chains;
+	mt7915_set_stream_he_caps(&dev->phy);
+	return ieee80211_get_he_iftype_cap(&dev->mphy.sband_2g.sband,
+					   NL80211_IFTYPE_AP);
+}
+
+/* Fewer chains, fewer streams: 2 chains give MCS 0-11 on 2 streams and 2
+ * sounding dimensions; a single chain can't beamform at all.
+ */
+static void mt7915_init_test_he_caps_chains(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	const struct ieee80211_sta_he_cap *ap;
+	const u8 *phy;
+
+	ap = mt7915_init_test_he_chains(dev, 0x3);
+	KUNIT_ASSERT_NOT_NULL(test, ap);
+	phy = ap->he_cap_elem.phy_cap_info;
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ap->he_mcs_nss_supp.tx_mcs_80),
+			0xfffa);
+	KUNIT_EXPECT_EQ(test, phy[5],
+		FIELD_PREP(IEEE80211_HE_PHY_CAP5_BEAMFORMEE_NUM_SND_DIM_UNDER_80MHZ_MASK, 1) |
+		FIELD_PREP(IEEE80211_HE_PHY_CAP5_BEAMFORMEE_NUM_SND_DIM_ABOVE_80MHZ_MASK, 1));
+	KUNIT_EXPECT_EQ(test, phy[7] & IEEE80211_HE_PHY_CAP7_MAX_NC_MASK,
+			1 << 3);
+	KUNIT_EXPECT_EQ(test, ap->ppe_thres[0] &
+			IEEE80211_PPE_THRES_NSS_MASK, 1);
+
+	ap = mt7915_init_test_he_chains(dev, 0x1);
+	KUNIT_ASSERT_NOT_NULL(test, ap);
+	phy = ap->he_cap_elem.phy_cap_info;
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ap->he_mcs_nss_supp.tx_mcs_80),
+			0xfffe);
+	KUNIT_EXPECT_EQ(test, phy[3] & IEEE80211_HE_PHY_CAP3_SU_BEAMFORMER, 0);
+	KUNIT_EXPECT_EQ(test, phy[4] & IEEE80211_HE_PHY_CAP4_MU_BEAMFORMER, 0);
+	KUNIT_EXPECT_EQ(test, phy[5], 0);
+	KUNIT_EXPECT_EQ(test, phy[6] &
+			IEEE80211_HE_PHY_CAP6_TRIG_SU_BEAMFORMING_FB, 0);
+	KUNIT_EXPECT_EQ(test, phy[7], 0);
+	/* still a beamformee */
+	KUNIT_EXPECT_NE(test, phy[4] & IEEE80211_HE_PHY_CAP4_SU_BEAMFORMEE, 0);
+}
+
+/* set_antenna recomputes the HE caps in place: going from 4 chains to 1
+ * must give the same caps as a 1 chain band. The STBC beyond 80 MHz bits
+ * of an AP are only ever set, never cleared, so a single chain AP keeps
+ * claiming STBC tx/rx above 80 MHz.
+ */
+static void mt7915_init_test_he_caps_shrink(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	const struct ieee80211_sta_he_cap *ap;
+
+	kunit_skip(test, "driver bug: HE STBC >80 MHz bits stay set after the antennas drop to one chain");
+
+	dev = mt7915_init_test_chip(test, MT7976_ONE_ADIE_DBDC);
+	dev->mphy.cap.has_2ghz = true;
+	dev->mphy.antenna_mask = 0xf;
+	dev->mphy.chainmask = 0xf;
+	mt7915_set_stream_he_caps(&dev->phy);
+	dev->mphy.antenna_mask = 0x1;
+	dev->mphy.chainmask = 0x1;
+	mt7915_set_stream_he_caps(&dev->phy);
+	ap = ieee80211_get_he_iftype_cap(&dev->mphy.sband_2g.sband,
+					 NL80211_IFTYPE_AP);
+	KUNIT_ASSERT_NOT_NULL(test, ap);
+	KUNIT_EXPECT_EQ(test, ap->he_cap_elem.phy_cap_info[7], 0);
+}
+
+/* VHT beamforming caps follow the chain count, and only exist on 5 GHz. */
+static void mt7915_init_test_vht_txbf_caps(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct mt76_phy *mphy = &dev->mphy;
+	u32 *cap = &mphy->sband_5g.sband.vht_cap.cap;
+
+	mphy->chainmask = 0x3;
+	mphy->cap.has_5ghz = false;
+	mt7915_set_stream_vht_txbf_caps(&dev->phy);
+	KUNIT_EXPECT_EQ(test, *cap, 0);
+
+	mphy->cap.has_5ghz = true;
+	mt7915_set_stream_vht_txbf_caps(&dev->phy);
+	KUNIT_EXPECT_EQ(test, *cap, IEEE80211_VHT_CAP_SU_BEAMFORMEE_CAPABLE |
+			IEEE80211_VHT_CAP_MU_BEAMFORMEE_CAPABLE |
+			IEEE80211_VHT_CAP_SU_BEAMFORMER_CAPABLE |
+			IEEE80211_VHT_CAP_MU_BEAMFORMER_CAPABLE |
+			u32_encode_bits(1, IEEE80211_VHT_CAP_BEAMFORMEE_STS_MASK) |
+			u32_encode_bits(1,
+				IEEE80211_VHT_CAP_SOUNDING_DIMENSIONS_MASK));
+
+	/* one chain: the beamformer bits go away again */
+	mphy->chainmask = 0x1;
+	*cap &= ~IEEE80211_VHT_CAP_BEAMFORMEE_STS_MASK;
+	mt7915_set_stream_vht_txbf_caps(&dev->phy);
+	KUNIT_EXPECT_EQ(test, *cap, IEEE80211_VHT_CAP_SU_BEAMFORMEE_CAPABLE |
+			IEEE80211_VHT_CAP_MU_BEAMFORMEE_CAPABLE);
+}
+
+static struct ieee80211_sband_iftype_data *
+mt7915_init_test_find(struct ieee80211_sband_iftype_data *data, int n,
+		      enum nl80211_iftype type)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (data[i].types_mask & BIT(type))
+			return &data[i];
+	return NULL;
+}
+
+/* The MT7915 does half its streams at 160 MHz, none with DBDC, has no UL
+ * MU-MIMO and no STBC beyond 80 MHz (cheap to check with the chip id
+ * changed, the builders only look at it).
+ */
+static void mt7915_init_test_he_caps_mt7915(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_init_test_chip(test,
+						       MT7976_ONE_ADIE_DBDC);
+	struct ieee80211_sband_iftype_data *data, *ap, *sta;
+	struct mt7915_phy *phy = &dev->phy;
+	int n;
+
+	data = kunit_kcalloc(test, NUM_NL80211_IFTYPES, sizeof(*data),
+			     GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	phy->mt76->antenna_mask = 0xf;
+	phy->mt76->chainmask = 0xf;
+	dev->mt76.rev = 0x79150000;
+
+	dev->dbdc_support = false;
+	n = mt7915_init_he_caps(phy, NL80211_BAND_5GHZ, data);
+	KUNIT_EXPECT_EQ(test, n, MT7915_INIT_TEST_N_HE);
+	ap = mt7915_init_test_find(data, n, NL80211_IFTYPE_AP);
+	KUNIT_ASSERT_NOT_NULL(test, ap);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ap->he_cap.he_mcs_nss_supp.tx_mcs_80),
+			0xffaa);
+	KUNIT_EXPECT_EQ(test,
+			le16_to_cpu(ap->he_cap.he_mcs_nss_supp.tx_mcs_160),
+			0xfffa);
+	KUNIT_EXPECT_NE(test, ap->he_cap.he_cap_elem.phy_cap_info[0] &
+		IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_160MHZ_IN_5G, 0);
+	KUNIT_EXPECT_EQ(test, ap->he_cap.he_cap_elem.phy_cap_info[2] &
+			IEEE80211_HE_PHY_CAP2_UL_MU_FULL_MU_MIMO, 0);
