+/* Out of interface indexes (19 per band) or own MAC slots, adding fails
+ * with -ENOSPC before anything reaches the firmware, and a monitor vif
+ * that didn't make it is forgotten.
+ */
+static void mt7915_main_test_add_vif_full(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+
+	dev->mt76.vif_mask = GENMASK_ULL(2 * MT7915_MAX_INTERFACES - 1, 0);
+	vif = mt7915_main_test_vif(test, NL80211_IFTYPE_MONITOR, 0);
+	eth_zero_addr(vif->addr);
+	KUNIT_EXPECT_EQ(test, mt7915_add_interface(hw, vif), -ENOSPC);
+	KUNIT_EXPECT_NULL(test, dev->phy.monitor_vif);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	/* one index short of the limit is fine */
+	dev->mt76.vif_mask = GENMASK_ULL(2 * MT7915_MAX_INTERFACES - 2, 0);
+	vif = mt7915_main_test_vif(test, NL80211_IFTYPE_AP, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_add_interface(hw, vif), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_mvif(vif)->mt76.idx,
+			2 * MT7915_MAX_INTERFACES - 1);
+
+	mt7915_main_test_clear(fake);
+	dev->mt76.vif_mask = 0;
+	dev->phy.omac_mask = BIT_ULL(1) | BIT_ULL(2) | BIT_ULL(3);
+	vif = mt7915_main_test_vif(test, NL80211_IFTYPE_MESH_POINT, 2);
+	KUNIT_EXPECT_EQ(test, mt7915_add_interface(hw, vif), -ENOSPC);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	KUNIT_EXPECT_EQ(test, dev->mt76.vif_mask, 0);
+}
+
+/* The firmware refusing the device leaves nothing allocated; running out
+ * of wcids after it took the device takes the device back.
+ */
+static void mt7915_main_test_add_vif_errors(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct mt76_test_msg *msg;
+
+	vif = mt7915_main_test_vif(test, NL80211_IFTYPE_MONITOR, 0);
+	eth_zero_addr(vif->addr);
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_add_interface(hw, vif), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+	KUNIT_EXPECT_EQ(test, dev->mt76.vif_mask, 0);
+	KUNIT_EXPECT_EQ(test, dev->phy.omac_mask, 0);
+	KUNIT_EXPECT_NULL(test, dev->phy.monitor_vif);
+
+	mt7915_main_test_clear(fake);
+	memset(dev->mt76.wcid_mask, 0xff, sizeof(dev->mt76.wcid_mask));
+	KUNIT_EXPECT_EQ(test, mt7915_add_interface(hw, vif), -ENOSPC);
+	KUNIT_EXPECT_EQ(test, dev->mt76.vif_mask, 0);
+	KUNIT_EXPECT_EQ(test, dev->phy.omac_mask, 0);
+	KUNIT_EXPECT_NULL(test, dev->phy.monitor_vif);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	msg = mt76_test_msg(fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(DEV_INFO_UPDATE));
+	KUNIT_EXPECT_EQ(test, msg->data[12], 0);		/* inactive */
+}
+
+/* Removing an AP: the BSS and its broadcast station go down, the device
+ * goes inactive, the wcid is unpublished and every slot it held is free
+ * again, including a pending station poll.
+ */
+static void mt7915_main_test_remove_ap(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw;
+	struct ieee80211_vif *vif;
+	struct mt7915_vif *mvif;
+	struct mt76_test_msg *msg;
+	struct sta_rec_basic *sbasic;
+	struct bss_info_basic *basic;
+	int idx;
+
+	vif = mt7915_main_test_ap(test, hw, 1);
+	mvif = mt7915_main_test_mvif(vif);
+	idx = mvif->sta.wcid.idx;
+	mt7915_main_test_add_poll(dev, &mvif->sta.wcid);
+	KUNIT_ASSERT_FALSE(test, list_empty(&dev->mt76.sta_poll_list));
+	mt7915_main_test_clear(fake);
+
+	mt7915_remove_interface(hw, vif);
+	KUNIT_EXPECT_EQ(test, dev->mt76.vif_mask, 0);
+	KUNIT_EXPECT_EQ(test, dev->phy.omac_mask, 0);
+	KUNIT_EXPECT_NULL(test, rcu_access_pointer(dev->mt76.wcid[idx]));
+	KUNIT_EXPECT_FALSE(test, dev->mt76.wcid_mask[idx / 32] & BIT(idx % 32));
+	KUNIT_EXPECT_TRUE(test, list_empty(&dev->mt76.sta_poll_list));
+
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(BSS_INFO_UPDATE));
+	basic = mt7915_main_test_tlv(msg, BSS_INFO_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, basic);
+	KUNIT_EXPECT_EQ(test, basic->active, 0);
+	KUNIT_EXPECT_NULL(test, mt7915_main_test_tlv(msg, BSS_INFO_OMAC));
+	msg = mt76_test_msg(fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	sbasic = mt7915_main_test_tlv(msg, STA_REC_BASIC);
+	KUNIT_ASSERT_NOT_NULL(test, sbasic);
+	KUNIT_EXPECT_EQ(test, sbasic->conn_state, CONN_STATE_DISCONNECT);
+	msg = mt76_test_msg(fake, 2);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(DEV_INFO_UPDATE));
+	KUNIT_EXPECT_EQ(test, msg->data[12], 0);
+
+	/* the slots are reusable */
+	vif = mt7915_main_test_ap(test, hw, 2);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_mvif(vif)->mt76.omac_idx,
+			HW_BSSID_0);
+	KUNIT_EXPECT_EQ(test, mt7915_main_test_mvif(vif)->sta.wcid.idx, idx);
+}
