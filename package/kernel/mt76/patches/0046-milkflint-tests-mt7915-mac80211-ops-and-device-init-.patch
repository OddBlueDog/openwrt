+/* --- DFS background detection ------------------------------------------ */
+
+/* The background (zero-wait DFS) chain: refused without a DFS region or
+ * when another band holds it; a radar channel starts it (offchannel scan
+ * start, then radar detection with the region's code), a non-radar one or
+ * none stops it.
+ */
+static void mt7915_main_test_radar_background(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw2 = mt7915_main_test_hw2(dev);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	struct ieee80211_supported_band *sband = &phy2->mt76->sband_5g.sband;
+	struct ieee80211_channel *radar = NULL, *plain = NULL;
+	struct cfg80211_chan_def c_radar, c_plain;
+	struct mt76_test_msg *msg;
+	int i;
+
+	for (i = 0; i < sband->n_channels; i++) {
+		if (sband->channels[i].hw_value == 36)
+			plain = &sband->channels[i];
+		if (sband->channels[i].hw_value == 100)
+			radar = &sband->channels[i];
+	}
+	KUNIT_ASSERT_NOT_NULL(test, radar);
+	KUNIT_ASSERT_NOT_NULL(test, plain);
+	radar->flags |= IEEE80211_CHAN_RADAR;
+	plain->flags &= ~IEEE80211_CHAN_RADAR;
+	cfg80211_chandef_create(&c_radar, radar, NL80211_CHAN_HT20);
+	cfg80211_chandef_create(&c_plain, plain, NL80211_CHAN_HT20);
+
+	dev->mt76.region = NL80211_DFS_UNSET;
+	KUNIT_EXPECT_EQ(test, mt7915_set_radar_background(hw2, &c_radar),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	dev->mt76.region = NL80211_DFS_ETSI;
+	dev->rdd2_phy = &dev->phy;
+	KUNIT_EXPECT_EQ(test, mt7915_set_radar_background(hw2, &c_radar),
+			-EBUSY);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	dev->rdd2_phy = NULL;
+
+	KUNIT_ASSERT_EQ(test, mt7915_set_radar_background(hw2, &c_radar), 0);
+	KUNIT_EXPECT_PTR_EQ(test, dev->rdd2_phy, phy2);
+	KUNIT_EXPECT_PTR_EQ(test, dev->rdd2_chandef.chan, radar);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->cmd,
+			MCU_EXT_CMD(OFFCH_SCAN_CTRL));
+	msg = mt76_test_msg(fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_RDD_CTRL));
+	KUNIT_EXPECT_EQ(test, msg->data[0], RDD_START);
+	KUNIT_EXPECT_EQ(test, msg->data[1], MT_RDD_IDX_BACKGROUND);
+	KUNIT_EXPECT_EQ(test, msg->data[3], 0);		/* ETSI */
+
+	/* moving it to another radar channel: stop first, then start */
+	mt7915_main_test_clear(fake);
+	dev->mt76.region = NL80211_DFS_JP;
+	KUNIT_ASSERT_EQ(test, mt7915_set_radar_background(hw2, &c_radar), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 4);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->data[0], RDD_STOP);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 3)->data[0], RDD_START);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 3)->data[3], 2);	/* JP */
+
+	/* stopping it: no radar detection started again */
+	mt7915_main_test_clear(fake);
+	KUNIT_ASSERT_EQ(test, mt7915_set_radar_background(hw2, NULL), 0);
+	KUNIT_EXPECT_NULL(test, dev->rdd2_phy);
+	KUNIT_EXPECT_GE(test, fake->n_msgs, 2);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->data[0], RDD_STOP);
+	for (i = 0; i < fake->n_msgs; i++) {
+		msg = mt76_test_msg(fake, i);
+		if (msg->cmd == MCU_EXT_CMD(SET_RDD_CTRL))
+			KUNIT_EXPECT_EQ(test, msg->data[0], RDD_STOP);
+	}
+
+	/* a channel without radar, chain idle: just stop, and remember it */
+	mt7915_main_test_clear(fake);
+	KUNIT_ASSERT_EQ(test, mt7915_set_radar_background(hw2, &c_plain), 0);
+	KUNIT_EXPECT_PTR_EQ(test, dev->rdd2_phy, phy2);
+	KUNIT_EXPECT_PTR_EQ(test, dev->rdd2_chandef.chan, plain);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(fake, 0)->data[0], RDD_STOP);
+	dev->rdd2_phy = NULL;
+
+	/* firmware errors leave the chain as it was */
+	mt7915_main_test_clear(fake);
+	dev->mt76.region = NL80211_DFS_FCC;
+	mt7915_main_test_fail_at(fake, 2, -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_set_radar_background(hw2, &c_radar),
+			-EIO);
+	KUNIT_EXPECT_NULL(test, dev->rdd2_phy);
+	mt7915_main_test_clear(fake);
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_set_radar_background(hw2, NULL), -EIO);
+	/* band 0 has no 5 GHz: no background chain for it */
+	fake->mcu_ret = 0;
+	KUNIT_EXPECT_EQ(test, mt7915_set_radar_background(dev->mt76.hw, NULL),
+			-EINVAL);
+	radar->flags &= ~IEEE80211_CHAN_RADAR;
+}
