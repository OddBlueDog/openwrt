+/* On band 1 an AP uses band 1's own BSSID slots and WMM sets 2-3. */
+static void mt7915_main_test_add_ap_band1(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	struct ieee80211_vif *vif;
+	struct mt7915_vif *mvif;
+	struct mt76_test_msg *msg;
+
+	mt7915_main_test_ap(test, dev->mt76.hw, 1);
+	vif = mt7915_main_test_ap(test, mt7915_main_test_hw2(dev), 2);
+	mvif = mt7915_main_test_mvif(vif);
+
+	KUNIT_EXPECT_EQ(test, mvif->mt76.idx, 1);
+	KUNIT_EXPECT_EQ(test, mvif->mt76.omac_idx, HW_BSSID_0);
+	KUNIT_EXPECT_EQ(test, mvif->mt76.band_idx, 1);
+	KUNIT_EXPECT_EQ(test, mvif->mt76.wmm_idx, 2);
+	KUNIT_EXPECT_PTR_EQ(test, mvif->phy, phy2);
+	KUNIT_EXPECT_EQ(test, (int)mvif->sta.wcid.phy_idx, 1);
+	KUNIT_EXPECT_EQ(test, phy2->omac_mask, BIT_ULL(0));
+	KUNIT_EXPECT_EQ(test, dev->phy.omac_mask, BIT_ULL(0));
+	msg = mt76_test_find_msg(fake, MCU_EXT_CMD(DEV_INFO_UPDATE));
+	KUNIT_EXPECT_EQ(test, msg->data[1], 1);
+	/* hw BSSID 0 of band 1 is airtime group 4 */
+	KUNIT_EXPECT_EQ(test, mt76_test_find_msg(fake,
+			MCU_EXT_CMD(AT_PROC_MODULE))->data[96], 4);
+}
