+/* The coverage class (never negative) stretches the ack timeouts by 3 us
+ * per class; with DBDC the larger of both bands' classes applies.
+ */
+static void mt7915_main_test_coverage_class(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct ieee80211_hw *hw = dev->mt76.hw, *hw2 = mt7915_main_test_hw2(dev);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	u32 base;
+
+	set_bit(MT76_STATE_RUNNING, &dev->mphy.state);
+	mt7915_set_coverage_class(hw, -1, 0);
+	base = FIELD_GET(MT_TIMEOUT_VAL_PLCP, mt76_rr(dev, MT_TMAC_CDTR(0)));
+
+	mt7915_set_coverage_class(hw, -1, 2);
+	KUNIT_EXPECT_EQ(test, dev->phy.coverage_class, 2);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TIMEOUT_VAL_PLCP,
+					mt76_rr(dev, MT_TMAC_CDTR(0))),
+			base + 6);
+
+	mt7915_set_coverage_class(hw2, -1, 5);
+	KUNIT_EXPECT_EQ(test, phy2->coverage_class, 5);
+	mt7915_set_coverage_class(hw, -1, -3);
+	KUNIT_EXPECT_EQ(test, dev->phy.coverage_class, 0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TIMEOUT_VAL_PLCP,
+					mt76_rr(dev, MT_TMAC_CDTR(0))),
+			base + 15);
+	clear_bit(MT76_STATE_RUNNING, &dev->mphy.state);
+}
