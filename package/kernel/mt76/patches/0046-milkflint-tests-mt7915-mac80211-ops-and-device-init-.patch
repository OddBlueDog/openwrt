+/* Antennas: tx and rx must match, be non-empty and within the chains;
+ * the chainmask of band 1 sits after band 0's chains, the stream and
+ * beamforming capabilities follow the count, and the tx power is redone.
+ */
+static void mt7915_main_test_set_antenna(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_main_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct ieee80211_hw *hw = dev->mt76.hw, *hw2 = mt7915_main_test_hw2(dev);
+	struct mt7915_phy *phy2 = mt7915_ext_phy(dev);
+	struct ieee80211_sta_vht_cap *vht = &phy2->mt76->sband_5g.sband.vht_cap;
+	const struct ieee80211_sta_he_cap *he;
+
+	KUNIT_EXPECT_EQ(test, mt7915_set_antenna(hw, -1, 0, 0), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_set_antenna(hw, -1, 0x3, 0x1), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_set_antenna(hw, -1, 0x10, 0x10), -EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.antenna_mask, 0xf);
+
+	KUNIT_ASSERT_EQ(test, mt7915_set_antenna(hw, -1, 0x3, 0x3), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.antenna_mask, 0x3);
+	KUNIT_EXPECT_EQ(test, dev->mphy.chainmask, 0x3);
+	KUNIT_EXPECT_EQ(test, dev->mphy.sband_2g.sband.ht_cap.mcs.rx_mask[1],
+			0xff);
+	KUNIT_EXPECT_EQ(test, dev->mphy.sband_2g.sband.ht_cap.mcs.rx_mask[2],
+			0);
+	he = ieee80211_get_he_iftype_cap(&dev->mphy.sband_2g.sband,
+					 NL80211_IFTYPE_AP);
+	KUNIT_ASSERT_NOT_NULL(test, he);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(he->he_mcs_nss_supp.tx_mcs_80),
+			0xfffa);
+	KUNIT_EXPECT_NOT_NULL(test, mt76_test_find_msg(fake,
+			MCU_EXT_CMD(TX_POWER_FEATURE_CTRL)));
+
+	KUNIT_ASSERT_EQ(test, mt7915_set_antenna(hw2, -1, 0x1, 0x1), 0);
+	KUNIT_EXPECT_EQ(test, phy2->mt76->antenna_mask, 0x1);
+	KUNIT_EXPECT_EQ(test, phy2->mt76->chainmask, 0x10);
+	/* one chain: no beamformer, a 1 stream beamformee */
+	KUNIT_EXPECT_EQ(test, vht->cap & IEEE80211_VHT_CAP_SU_BEAMFORMER_CAPABLE,
+			0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(vht->vht_mcs.rx_mcs_map) & 0xc, 0xc);
+
+	KUNIT_ASSERT_EQ(test, mt7915_set_antenna(hw2, -1, 0xf, 0xf), 0);
+	KUNIT_EXPECT_EQ(test, phy2->mt76->chainmask, 0xf0);
+	KUNIT_EXPECT_NE(test, vht->cap & IEEE80211_VHT_CAP_SU_BEAMFORMER_CAPABLE,
+			0);
+
+	/* MT7981 (and MT7916) 3T3R parts with 2 streams on 5 GHz keep all
+	 * of band 1's chains when all streams are asked for
+	 */
+	dev->mt76.rev = 0x79810000;
+	hw2->wiphy->available_antennas_tx = 0x3;
+	dev->chainmask = 0x73;
+	KUNIT_ASSERT_EQ(test, mt7915_set_antenna(hw2, -1, 0x3, 0x3), 0);
+	KUNIT_EXPECT_EQ(test, phy2->mt76->chainmask, 0x70);
+	KUNIT_ASSERT_EQ(test, mt7915_set_antenna(hw2, -1, 0x1, 0x1), 0);
+	KUNIT_EXPECT_EQ(test, phy2->mt76->chainmask, 0x10);
+	/* band 0 always follows the antennas */
+	KUNIT_ASSERT_EQ(test, mt7915_set_antenna(hw, -1, 0xf, 0xf), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.chainmask, 0xf);
+	dev->mt76.rev = 0x79860000;
+}
