+struct mt7915_mcu2_vow_feature {
+	__le16 bss_flag;
+	__le16 vow_ctrl_flag;
+	__le16 bss_value[9];
+	__le16 vow_ctrl_val;
+	__le16 time_token_value[2];
+	__le16 length_token_value[2];
+	__le32 tx_ctrl;
+	__le32 sch_ctrl;
+} __packed;
+
+/* The VOW feature switches: 32 us refill, the always-on scheduler bits,
+ * and those of airtime fairness (WATF, ATF, its tx control) following
+ * vow_atf_en.
+ */
+static void mt7915_mcu2_vow_feature(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu2_vow_feature *req;
+	u16 base = VOW_REFILL_PERIOD_32US | BIT(4) | BIT(5) | BIT(12) |
+		   BIT(14);
+	int cmd = MCU_EXT_CMD(SET_FEATURE_CTRL);
+	int i;
+
+	dev->vow_atf_en = false;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_vow_feature_ctrl(dev), 0);
+	req = (const void *)mt7915_mcu2_msg(test, cmd, sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->bss_flag), 0xffff);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->vow_ctrl_flag), 0xf231);
+	for (i = 0; i < 9; i++)
+		KUNIT_EXPECT_EQ(test, le16_to_cpu(req->bss_value[i]),
+				i == 0 || i == 2 || i == 8 ? 0xffff : 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->vow_ctrl_val), base);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->time_token_value[0]), 0xffff);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->time_token_value[1]), 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->tx_ctrl), 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->sch_ctrl), BIT(6));
+
+	dev->vow_atf_en = true;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_vow_feature_ctrl(dev), 0);
+	req = (const void *)mt7915_mcu2_msg(test, cmd, sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->vow_ctrl_val),
+			base | BIT(9) | BIT(13));
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->tx_ctrl), 0x6bf69e1f);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->sch_ctrl), BIT(6));
+}
+
+/* An interface's BSS group on its band, for the airtime module: four per
+ * band for the hardware BSSIDs, extended BSSes after them.
+ */
+static void mt7915_mcu2_vow_band(struct kunit *test)
+{
+	struct {
+		__le16 action;
+		__le16 sub_action;
+		__le32 rsv1[5];
+		u8 rsv2[72];
+		u8 group_idx;
+		u8 band_idx;
+		u8 rsv3[2];
+	} __packed *req;
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_vif *mvif;
+	int cmd = MCU_EXT_CMD(AT_PROC_MODULE);
+
+	mvif = (void *)mt7915_mcu2_vif(test, dev)->drv_priv;
+	mvif->mt76.band_idx = 1;
+	mvif->mt76.omac_idx = 2;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_vow_band(dev, mvif), 0);
+	req = (void *)mt7915_mcu2_msg(test, cmd, sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->action), 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->sub_action), 4);
+	KUNIT_EXPECT_EQ(test, req->group_idx, 6);
+	KUNIT_EXPECT_EQ(test, req->band_idx, 1);
+
+	mvif->mt76.band_idx = 0;
+	mvif->mt76.omac_idx = EXT_BSSID_1 + 2;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_vow_band(dev, mvif), 0);
+	req = (void *)mt7915_mcu2_msg(test, cmd, sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, req->group_idx, 4 * 2 + 1 + 2);
+	KUNIT_EXPECT_EQ(test, req->band_idx, 0);
+}
