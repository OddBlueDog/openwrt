+/* Radar detector thresholds go to the firmware field by field, each kind
+ * under its own tag: FCC-5 long pulses (1), a radar pattern (2), pulse
+ * limits (3).
+ */
+static void mt7915_mcu2_radar_thresholds(struct kunit *test)
+{
+	static const struct mt7915_dfs_pulse pulse = {
+		.max_width = 40,
+		.max_pwr = -10,
+		.min_pwr = -60,
+		.min_stgr_pri = 200,
+		.max_stgr_pri = 3000,
+		.min_cr_pri = 300,
+		.max_cr_pri = 4000,
+	};
+	static const struct mt7915_dfs_pattern pattern = {
+		.enb = 1, .stgr = 2, .min_crpn = 3, .max_crpn = 4,
+		.min_crpr = 5, .min_pw = 6, .min_pri = 1428, .max_pri = 3846,
+		.max_pw = 7, .min_crbn = 8, .max_crbn = 9, .min_stgpn = 10,
+		.max_stgpn = 11, .min_stgpr = 12, .min_stgpr_diff = 13,
+	};
+	struct {
+		__le32 tag;
+		__le16 min_lpn;
+		u8 rsv[2];
+	} __packed *lpn;
+	struct {
+		__le32 tag;
+		__le32 val[7];
+	} __packed *pul;
+	struct {
+		__le32 tag;
+		__le16 radar_type;
+		u8 enb, stgr, min_crpn, max_crpn, min_crpr, min_pw;
+		__le32 min_pri, max_pri;
+		u8 max_pw, min_crbn, max_crbn, min_stgpn, max_stgpn, min_stgpr;
+		u8 rsv[2];
+		__le32 min_stgpr_diff;
+	} __packed *pat;
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	int cmd = MCU_EXT_CMD(SET_RDD_TH);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_fcc5_lpn(dev, 8), 0);
+	lpn = (void *)mt7915_mcu2_nth(test, 0, cmd, sizeof(*lpn))->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(lpn->tag), 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(lpn->min_lpn), 8);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_pulse_th(dev, &pulse), 0);
+	pul = (void *)mt7915_mcu2_nth(test, 1, cmd, sizeof(*pul))->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pul->tag), 3);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pul->val[0]), 40);
+	KUNIT_EXPECT_EQ(test, (int)le32_to_cpu(pul->val[1]), -10);
+	KUNIT_EXPECT_EQ(test, (int)le32_to_cpu(pul->val[2]), -60);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pul->val[3]), 200);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pul->val[4]), 3000);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pul->val[5]), 300);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pul->val[6]), 4000);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_radar_th(dev, 5, &pattern), 0);
+	pat = (void *)mt7915_mcu2_nth(test, 2, cmd, sizeof(*pat))->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pat->tag), 2);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(pat->radar_type), 5);
+	KUNIT_EXPECT_EQ(test, pat->enb, 1);
+	KUNIT_EXPECT_EQ(test, pat->stgr, 2);
+	KUNIT_EXPECT_EQ(test, pat->min_crpn, 3);
+	KUNIT_EXPECT_EQ(test, pat->max_crpn, 4);
+	KUNIT_EXPECT_EQ(test, pat->min_crpr, 5);
+	KUNIT_EXPECT_EQ(test, pat->min_pw, 6);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pat->min_pri), 1428);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pat->max_pri), 3846);
+	KUNIT_EXPECT_EQ(test, pat->max_pw, 7);
+	KUNIT_EXPECT_EQ(test, pat->min_crbn, 8);
+	KUNIT_EXPECT_EQ(test, pat->max_crbn, 9);
+	KUNIT_EXPECT_EQ(test, pat->min_stgpn, 10);
+	KUNIT_EXPECT_EQ(test, pat->max_stgpn, 11);
+	KUNIT_EXPECT_EQ(test, pat->min_stgpr, 12);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(pat->min_stgpr_diff), 13);
+
+	mt76_test_fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_fcc5_lpn(dev, 8), -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_pulse_th(dev, &pulse), -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_radar_th(dev, 5, &pattern), -EIO);
+}
