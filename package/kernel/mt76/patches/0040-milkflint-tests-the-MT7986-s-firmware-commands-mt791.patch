+	MT7915_MCU2_CHAN(NL80211_BAND_5GHZ, 5745, 149, 0),
+	MT7915_MCU2_CHAN(NL80211_BAND_5GHZ, 5765, 153, 0),
+	MT7915_MCU2_CHAN(NL80211_BAND_5GHZ, 5785, 157, 0),
+	MT7915_MCU2_CHAN(NL80211_BAND_5GHZ, 5805, 161, 0),
