+struct mt7915_mcu2_red_watermark {
+	__le32 args[3];
+	u8 cmd;
+	u8 version;
+	u8 __rsv1[4];
+	__le16 len;
+	__le16 high_mark;
+	__le16 low_mark;
+	u8 __rsv2[12];
+} __packed;
+
+/* RED (early drop) in the WA firmware: switched on with the global token
+ * watermarks first (256 and 1792 tokens below the hardware's 4096), then
+ * the switch, then the WA's own parameter; off without the watermarks.
+ */
+static void mt7915_mcu2_set_red(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu2_red_watermark *mark;
+	int wa = MCU_WA_PARAM_CMD(SET);
+	const __le32 *args;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_red(dev, true), 0);
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 3);
+	mark = (const void *)mt7915_mcu2_nth(test, 0, wa,
+					     sizeof(*mark))->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(mark->args[0]),
+			MCU_WA_PARAM_RED_SETTING);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(mark->args[1]), 0);
+	KUNIT_EXPECT_EQ(test, mark->cmd, 2);	/* global token watermark */
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(mark->len), sizeof(*mark) - 12);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(mark->high_mark), 4096 - 256);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(mark->low_mark), 4096 - 256 - 1536);
+	args = (const void *)mt7915_mcu2_nth(test, 1, MCU_EXT_CMD(RED_ENABLE),
+					     4)->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(args[0]), 2);	/* by WA */
+	args = (const void *)mt7915_mcu2_nth(test, 2, wa, 12)->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(args[0]), MCU_WA_PARAM_RED);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(args[1]), 1);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(args[2]), 0);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_red(dev, false), 0);
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 5);
+	args = (const void *)mt7915_mcu2_nth(test, 3, MCU_EXT_CMD(RED_ENABLE),
+					     4)->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(args[0]), 0);
+	args = (const void *)mt7915_mcu2_nth(test, 4, wa, 12)->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(args[0]), MCU_WA_PARAM_RED);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(args[1]), 0);
+}
+
+/* Each step's error ends the sequence. */
+static void mt7915_mcu2_set_red_errors(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	int n;
+
+	for (n = 1; n <= 3; n++) {
+		mt7915_mcu2_fail_nth(dev, n);
+		KUNIT_EXPECT_EQ(test, mt7915_mcu_set_red(dev, true), -EIO);
+	}
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 1 + 2 + 3);
+	mt7915_mcu2_fail_nth(dev, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_red(dev, false), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 7);
+}
