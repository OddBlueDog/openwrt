+/* No memory for the message: -ENOMEM and nothing (more) sent. */
+static void mt7915_test_rate_nomem(struct kunit *test)
+{
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_nomem_after(test, c.dev, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_smps(c.dev, c.vif, c.sta),
+			-ENOMEM);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_smps(c.dev, c.vif, c.sta),
+			-ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_rate_ctrl(c.dev, c.vif, c.sta,
+			&c.msta->wcid, false), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_fixed_rate_ctrl(c.dev, c.vif,
+			c.sta, &c.msta->wcid, NULL, RATE_PARAM_AUTO), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 1);
+}
