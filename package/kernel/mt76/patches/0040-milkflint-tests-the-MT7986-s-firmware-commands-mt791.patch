+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * KUnit tests for the mt7915 firmware code outside station and BSS state:
+ * bringing the firmware up and down, the message transport, unsolicited
+ * firmware events, and the channel, calibration, radar, tx power, thermal,
+ * EEPROM, EDCA and airtime scheduler (VOW) commands. Included at the end of
+ * mt7915/mcu.c after tests/mcu-test.c when CONFIG_MT76_KUNIT_TEST is
+ * defined (milkflint's QEMU test build only).
+ *
+ * Most tests use fake.h's firmware, which records each payload the driver
+ * builds. The transport tests swap in the driver's own (what
+ * mt7915_mcu_init() installs) over a fake MCU queue that records the
+ * finished frames, TXD included, and answers them as the firmware does.
+ */
+#include <kunit/test.h>
+#include <linux/firmware.h>
+#include "fake.h"
+
