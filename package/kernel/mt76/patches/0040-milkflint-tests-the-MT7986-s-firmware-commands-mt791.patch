 #endif
diff --git a/mt7915/tests/mcu-test.c b/mt7915/tests/mcu-test.c
index c62d33bb..da845b58 100644
--- a/mt7915/tests/mcu-test.c
+++ b/mt7915/tests/mcu-test.c
@@ -4,8 +4,14 @@
  * the driver sends, checked against the fake firmware of fake.h. Included at
  * the end of mt7915/mcu.c when CONFIG_MT76_KUNIT_TEST is defined
  * (milkflint's QEMU test build only).
+ *
+ * Most of them build interfaces and stations the way mt7915/main.c does and
+ * walk the TLV streams of the STA_REC_UPDATE and BSS_INFO_UPDATE messages the
+ * driver sends: an 8-byte sta_req_hdr counting the TLVs that follow, each TLV
+ * a tag and a length that covers whatever is nested in it.
  */
 #include <kunit/test.h>
+#include <linux/etherdevice.h>
 #include "fake.h"
 
 /* for fake.h's mt7915_test_dev(), in the other files' tests too */
@@ -106,10 +112,4118 @@ static void mt7915_test_set_mac_error(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
 }
 
+/* --- firmware hooks ------------------------------------------------------- */
+
+/* Make one message fail, or every message allocation once some messages went
+ * out: the device's MCU ops become a copy whose tailroom grows too large to
+ * allocate (alloc_skb() then fails quietly).
+ */
+struct mt7915_test_hooks {
+	struct mt76_mcu_ops ops;
+	int fail_at;		/* this message (0: the first) gets err */
+	int err;
+	int nomem_after;	/* allocations fail after this many messages */
+};
+
+static int mt7915_test_hooked_send(struct mt76_dev *mdev, struct sk_buff *skb,
+				   int cmd, int *seq)
+{
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_test_hooks *h = fake->priv;
+	int ret;
+
+	fake->mcu_ret = fake->n_msgs == h->fail_at ? h->err : 0;
+	ret = mt76_test_mcu_send(mdev, skb, cmd, seq);
+	if (h->nomem_after >= 0 && fake->n_msgs >= h->nomem_after)
+		h->ops.tailroom = SZ_1G;
+
+	return ret;
+}
+
+static struct mt7915_test_hooks *
+mt7915_test_hooks(struct kunit *test, struct mt7915_dev *dev)
+{
+	struct mt7915_test_hooks *h;
+
+	h = kunit_kzalloc(test, sizeof(*h), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, h);
+	h->ops = *dev->mt76.mcu_ops;
+	h->ops.mcu_skb_send_msg = mt7915_test_hooked_send;
+	h->fail_at = -1;
+	h->nomem_after = -1;
+	mt76_test_fake->priv = h;
+	dev->mt76.mcu_ops = &h->ops;
+
+	return h;
+}
+
+/* message @n (0: the next one) fails with @err, the others go through */
+static void mt7915_test_fail_at(struct kunit *test, struct mt7915_dev *dev,
+				int n, int err)
+{
+	struct mt7915_test_hooks *h = mt7915_test_hooks(test, dev);
+
+	h->fail_at = mt76_test_fake->n_msgs + n;
+	h->err = err;
+}
+
+/* only @n more messages can be allocated */
+static void mt7915_test_nomem_after(struct kunit *test, struct mt7915_dev *dev,
+				    int n)
+{
+	struct mt7915_test_hooks *h = mt7915_test_hooks(test, dev);
+
+	h->nomem_after = mt76_test_fake->n_msgs + n;
+	if (!n)
+		h->ops.tailroom = SZ_1G;
+}
+
+/* --- TLV streams ---------------------------------------------------------- */
+
+/* Walk the TLVs tiling @len bytes at @buf: return the first one tagged @tag
+ * (NULL if none) and count them all in *@n. A TLV that overruns the buffer,
+ * or bytes too few for a TLV header, fail the test.
+ */
+static struct tlv *mt7915_test_walk(struct kunit *test, u8 *buf, int len,
+				    int tag, int *n)
+{
+	struct tlv *found = NULL;
+	int off = 0;
+
+	*n = 0;
+	while (off < len) {
+		struct tlv *tlv = (struct tlv *)(buf + off);
+		int tlen;
+
+		if (len - off < (int)sizeof(*tlv)) {
+			KUNIT_FAIL(test, "%d stray bytes after the TLVs",
+				   len - off);
+			break;
+		}
+		tlen = le16_to_cpu(tlv->len);
+		if (tlen < (int)sizeof(*tlv) || tlen > len - off) {
+			KUNIT_FAIL(test, "TLV %u at %d: length %d, %d left",
+				   le16_to_cpu(tlv->tag), off, tlen, len - off);
+			break;
+		}
+		if (!found && le16_to_cpu(tlv->tag) == tag)
+			found = tlv;
+		(*n)++;
+		off += tlen;
+	}
+
+	return found;
+}
+
+/* TLV @tag (at least @size bytes) of the STA_REC/BSS_INFO payload at @data,
+ * or NULL; the header must count every TLV.
+ */
+static void *mt7915_test_tlv_in(struct kunit *test, u8 *data, int len,
+				int tag, size_t size)
+{
+	struct sta_req_hdr *hdr = (struct sta_req_hdr *)data;
+	struct tlv *tlv;
+	int n;
+
+	KUNIT_ASSERT_GE(test, len, (int)sizeof(*hdr));
+	tlv = mt7915_test_walk(test, data + sizeof(*hdr), len - sizeof(*hdr),
+			       tag, &n);
+	KUNIT_EXPECT_EQ(test, (int)le16_to_cpu(hdr->tlv_num), n);
+	if (tlv)
+		KUNIT_EXPECT_GE(test, (int)le16_to_cpu(tlv->len), (int)size);
+
+	return tlv;
+}
+
+#define mt7915_test_tlv(test, msg, tag, type)				\
+	((type *)mt7915_test_tlv_in(test, (msg)->data, (msg)->len, tag,	\
+				    sizeof(type)))
+#define mt7915_test_skb_tlv(test, skb, tag, type)			\
+	((type *)mt7915_test_tlv_in(test, (skb)->data, (skb)->len, tag,	\
+				    sizeof(type)))
+
+/* how many TLVs the payload at @data holds (checked against its header) */
+static int mt7915_test_ntlv(struct kunit *test, u8 *data, int len)
+{
+	struct sta_req_hdr *hdr = (struct sta_req_hdr *)data;
+
+	mt7915_test_tlv_in(test, data, len, -1, 0);
+	return le16_to_cpu(hdr->tlv_num);
+}
+
+/* the tags of the payload's TLVs in order, at most @max; returns how many */
+static int mt7915_test_tags(struct kunit *test, struct mt76_test_msg *msg,
+			    u16 *tags, int max)
+{
+	int off = sizeof(struct sta_req_hdr), n = 0;
+
+	mt7915_test_ntlv(test, msg->data, msg->len);
+	while (off + (int)sizeof(struct tlv) <= msg->len && n < max) {
+		struct tlv *tlv = (struct tlv *)(msg->data + off);
+
+		if (!le16_to_cpu(tlv->len))
+			break;
+		tags[n++] = le16_to_cpu(tlv->tag);
+		off += le16_to_cpu(tlv->len);
+	}
+
+	return n;
+}
+
+/* WTBL TLV @tag nested in the STA_REC_WTBL TLV at @data, whose wtbl_req_hdr
+ * must count every nested TLV
+ */
+static void *mt7915_test_wtbl_in(struct kunit *test, u8 *data, int len,
+				 int tag, size_t size)
+{
+	struct wtbl_req_hdr *hdr;
+	struct tlv *wtbl, *tlv;
+	int n, wlen;
+
+	wtbl = mt7915_test_tlv_in(test, data, len, STA_REC_WTBL,
+				  sizeof(*wtbl) + sizeof(*hdr));
+	KUNIT_ASSERT_NOT_NULL(test, wtbl);
+	hdr = (struct wtbl_req_hdr *)wtbl->data;
+	wlen = le16_to_cpu(wtbl->len) - sizeof(*wtbl) - sizeof(*hdr);
+	tlv = mt7915_test_walk(test, (u8 *)(hdr + 1), wlen, tag, &n);
+	KUNIT_EXPECT_EQ(test, (int)le16_to_cpu(hdr->tlv_num), n);
+	if (tlv)
+		KUNIT_EXPECT_GE(test, (int)le16_to_cpu(tlv->len), (int)size);
+
+	return tlv;
+}
+
+#define mt7915_test_wtbl(test, msg, tag, type)				\
+	((type *)mt7915_test_wtbl_in(test, (msg)->data, (msg)->len, tag,	\
+				     sizeof(type)))
+#define mt7915_test_skb_wtbl(test, skb, tag, type)			\
+	((type *)mt7915_test_wtbl_in(test, (skb)->data, (skb)->len, tag,	\
+				     sizeof(type)))
+
+/* the wtbl_req_hdr in the STA_REC_WTBL TLV of @msg */
+static struct wtbl_req_hdr *mt7915_test_wtbl_hdr(struct kunit *test,
+						 struct mt76_test_msg *msg)
+{
+	struct tlv *wtbl;
+
+	wtbl = mt7915_test_tlv_in(test, msg->data, msg->len, STA_REC_WTBL,
+				  sizeof(*wtbl) + sizeof(struct wtbl_req_hdr));
+	KUNIT_ASSERT_NOT_NULL(test, wtbl);
+
+	return (struct wtbl_req_hdr *)wtbl->data;
+}
+
+/* beacon sub-TLV @tag in the BSS_INFO_OFFLOAD TLV at @data, whose sub_ntlv
+ * must count every sub-TLV
+ */
+static void *mt7915_test_bcn_in(struct kunit *test, u8 *data, int len,
+				int tag, size_t size)
+{
+	struct bss_info_bcn *bcn;
+	struct tlv *tlv;
+	int n;
+
+	bcn = mt7915_test_tlv_in(test, data, len, BSS_INFO_OFFLOAD,
+				 sizeof(*bcn));
+	KUNIT_ASSERT_NOT_NULL(test, bcn);
+	tlv = mt7915_test_walk(test, (u8 *)(bcn + 1),
+			       le16_to_cpu(bcn->len) - sizeof(*bcn), tag, &n);
+	KUNIT_EXPECT_EQ(test, (int)le16_to_cpu(bcn->sub_ntlv), n);
+	if (tlv)
+		KUNIT_EXPECT_GE(test, (int)le16_to_cpu(tlv->len), (int)size);
+
+	return tlv;
+}
+
+#define mt7915_test_bcn(test, msg, tag, type)				\
+	((type *)mt7915_test_bcn_in(test, (msg)->data, (msg)->len, tag,	\
+				    sizeof(type)))
+#define mt7915_test_skb_bcn(test, skb, tag, type)			\
+	((type *)mt7915_test_bcn_in(test, (skb)->data, (skb)->len, tag,	\
+				    sizeof(type)))
+
+/* --- interfaces and stations ---------------------------------------------- */
+
+static const u8 mt7915_test_own_addr[ETH_ALEN] = { 2, 0x79, 0x86, 0, 0, 1 };
+static const u8 mt7915_test_peer_addr[ETH_ALEN] = { 2, 0x79, 0x86, 0, 0, 2 };
+static const u8 mt7915_test_ap_addr[ETH_ALEN] = { 2, 0x79, 0x86, 0, 0, 3 };
+
+/* WTBL entries of the vif itself (broadcast) and of its station */
+#define MT7915_TEST_VIF_WCID	0x1f0
+#define MT7915_TEST_STA_WCID	0x10a
+/* extended BSS @n (EXT_BSSID_1 is 1) */
+#define MT7915_TEST_EXT_BSSID(n)	(EXT_BSSID_START + (n))
+
+/* What our band supports for HE (AP and station only): 4 sounding
+ * dimensions below and above 80 MHz, 2 tx streams at 80 MHz, 1 at 160.
+ */
+static const struct ieee80211_sband_iftype_data mt7915_test_iftype = {
+	.types_mask = BIT(NL80211_IFTYPE_AP) | BIT(NL80211_IFTYPE_STATION),
+	.he_cap = {
+		.has_he = true,
+		.he_cap_elem.phy_cap_info[5] =
+			FIELD_PREP_CONST(IEEE80211_HE_PHY_CAP5_BEAMFORMEE_NUM_SND_DIM_UNDER_80MHZ_MASK, 3) |
+			FIELD_PREP_CONST(IEEE80211_HE_PHY_CAP5_BEAMFORMEE_NUM_SND_DIM_ABOVE_80MHZ_MASK, 3),
+		.he_mcs_nss_supp = {
+			.tx_mcs_80 = cpu_to_le16(0xfffa),
+			.tx_mcs_160 = cpu_to_le16(0xfffe),
+			.tx_mcs_80p80 = cpu_to_le16(0xffff),
+		},
+	},
+};
+
+/* Put @phy on channel @ch of @band, @width wide around channel @center, with
+ * four chains, HT (and VHT off 2.4 GHz) and mt7915_test_iftype's HE.
+ */
+static void mt7915_test_chandef(struct kunit *test, struct mt7915_phy *phy,
+				enum nl80211_band band, int ch,
+				enum nl80211_chan_width width, int center)
+{
+	struct mt76_phy *mphy = phy->mt76;
+	struct ieee80211_supported_band *sband;
+	struct ieee80211_channel *chan;
+
+	chan = kunit_kzalloc(test, sizeof(*chan), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, chan);
+	chan->band = band;
+	chan->hw_value = ch;
+	chan->center_freq = ieee80211_channel_to_frequency(ch, band);
+
+	sband = band == NL80211_BAND_2GHZ ? &mphy->sband_2g.sband :
+					    &mphy->sband_5g.sband;
+	sband->band = band;
+	sband->ht_cap.ht_supported = true;
+	sband->vht_cap.vht_supported = band != NL80211_BAND_2GHZ;
+	/* we sound with three dimensions in VHT */
+	sband->vht_cap.cap =
+		FIELD_PREP(IEEE80211_VHT_CAP_SOUNDING_DIMENSIONS_MASK, 2);
+	_ieee80211_set_sband_iftype_data(sband, &mt7915_test_iftype, 1);
+	mphy->hw->wiphy->bands[band] = sband;
+
+	memset(&mphy->chandef, 0, sizeof(mphy->chandef));
+	mphy->chandef.chan = chan;
+	mphy->chandef.width = width;
+	mphy->chandef.center_freq1 = ieee80211_channel_to_frequency(center,
+								    band);
+	mphy->antenna_mask = 0xf;
+	mphy->chainmask = 0xf;
+}
+
+/* An @type interface with omac @omac_idx on @phy, set up the way
+ * mt7915_add_interface() does, @pad zeroed bytes into its allocation.
+ */
+static struct ieee80211_vif *
+__mt7915_test_vif(struct kunit *test, struct mt7915_phy *phy,
+		  enum nl80211_iftype type, u8 omac_idx, size_t pad)
+{
+	struct cfg80211_bitrate_mask *mask;
+	struct ieee80211_vif *vif;
+	struct mt7915_vif *mvif;
+	u8 *mem, *bssid;
+	int i;
+
+	mem = kunit_kzalloc(test, pad + sizeof(*vif) + sizeof(*mvif),
+			    GFP_KERNEL);
+	bssid = kunit_kzalloc(test, ETH_ALEN, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, mem);
+	KUNIT_ASSERT_NOT_NULL(test, bssid);
+	vif = (struct ieee80211_vif *)(mem + pad);
+
+	vif->type = type;
+	ether_addr_copy(vif->addr, mt7915_test_own_addr);
+	ether_addr_copy(bssid, type == NL80211_IFTYPE_STATION ?
+		       mt7915_test_ap_addr : mt7915_test_own_addr);
+	vif->bss_conf.vif = vif;
+	vif->bss_conf.bssid = bssid;
+	vif->bss_conf.beacon_int = 100;
+	vif->bss_conf.dtim_period = 2;
+	vif->bss_conf.chanreq.oper = phy->mt76->chandef;
+	RCU_INIT_POINTER(vif->link_conf[0], &vif->bss_conf);
+
+	mvif = (struct mt7915_vif *)vif->drv_priv;
+	mvif->mt76.idx = 1;
+	mvif->mt76.omac_idx = omac_idx;
+	mvif->mt76.band_idx = phy->mt76->band_idx;
+	mvif->mt76.wmm_idx = type != NL80211_IFTYPE_AP;
+	mvif->mt76.wcid = &mvif->sta.wcid;
+	mvif->phy = phy;
+	mvif->sta.wcid.idx = MT7915_TEST_VIF_WCID;
+	INIT_LIST_HEAD(&mvif->sta.rc_list);
+	memset(&mvif->cap, -1, sizeof(mvif->cap));
+
+	/* mt7915_init_bitrate_mask(): everything allowed */
+	mask = &mvif->bitrate_mask;
+	for (i = 0; i < ARRAY_SIZE(mask->control); i++) {
+		mask->control[i].gi = NL80211_TXRATE_DEFAULT_GI;
+		mask->control[i].he_gi = 0xff;
+		mask->control[i].he_ltf = 0xff;
+		mask->control[i].legacy = GENMASK(31, 0);
+		memset(mask->control[i].ht_mcs, 0xff,
+		       sizeof(mask->control[i].ht_mcs));
+		memset(mask->control[i].vht_mcs, 0xff,
+		       sizeof(mask->control[i].vht_mcs));
+		memset(mask->control[i].he_mcs, 0xff,
+		       sizeof(mask->control[i].he_mcs));
+	}
+
+	return vif;
+}
+
+static struct ieee80211_vif *
+mt7915_test_vif(struct kunit *test, struct mt7915_phy *phy,
+		enum nl80211_iftype type, u8 omac_idx)
+{
+	return __mt7915_test_vif(test, phy, type, omac_idx, 0);
+}
+
+/* A legacy station of @vif, 20 MHz, two rx streams, WMM, set up the way
+ * mt7915_mac_sta_add() and the association event do.
+ */
+static struct ieee80211_sta *mt7915_test_sta(struct kunit *test,
+					     struct ieee80211_vif *vif)
+{
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+
+	sta = kunit_kzalloc(test, sizeof(*sta) + sizeof(*msta), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sta);
+	ether_addr_copy(sta->addr, mt7915_test_peer_addr);
+	sta->aid = 3;
+	sta->wme = true;
+	sta->deflink.sta = sta;
+	ether_addr_copy(sta->deflink.addr, sta->addr);
+	sta->deflink.rx_nss = 2;
+	sta->deflink.bandwidth = IEEE80211_STA_RX_BW_20;
+	sta->deflink.smps_mode = IEEE80211_SMPS_OFF;
+	RCU_INIT_POINTER(sta->link[0], &sta->deflink);
+
+	msta = (struct mt7915_sta *)sta->drv_priv;
+	msta->vif = (struct mt7915_vif *)vif->drv_priv;
+	msta->wcid.idx = MT7915_TEST_STA_WCID;
+	msta->wcid.sta = 1;
+	INIT_LIST_HEAD(&msta->rc_list);
+
+	return sta;
+}
+
+/* HT: 40 MHz, short GI, LDPC, STBC, greenfield, 2 streams */
+static void mt7915_test_ht(struct ieee80211_sta *sta)
+{
+	struct ieee80211_sta_ht_cap *ht = &sta->deflink.ht_cap;
+
+	ht->ht_supported = true;
+	ht->cap = IEEE80211_HT_CAP_SUP_WIDTH_20_40 | IEEE80211_HT_CAP_SGI_20 |
+		  IEEE80211_HT_CAP_SGI_40 | IEEE80211_HT_CAP_LDPC_CODING |
+		  IEEE80211_HT_CAP_TX_STBC | IEEE80211_HT_CAP_GRN_FLD |
+		  (1 << IEEE80211_HT_CAP_RX_STBC_SHIFT);
+	ht->ampdu_factor = IEEE80211_HT_MAX_AMPDU_32K;
+	ht->ampdu_density = IEEE80211_HT_MPDU_DENSITY_4;
+	ht->mcs.rx_mask[0] = 0xff;
+	ht->mcs.rx_mask[1] = 0xff;
+}
+
+/* VHT: 2 streams of MCS 0-9, short GI at 80 MHz, LDPC, STBC, SU beamformee
+ * of 4 space-time streams, A-MPDU exponent 7
+ */
+static void mt7915_test_vht(struct ieee80211_sta *sta)
+{
+	struct ieee80211_sta_vht_cap *vht = &sta->deflink.vht_cap;
+
+	vht->vht_supported = true;
+	vht->cap = IEEE80211_VHT_CAP_RXLDPC | IEEE80211_VHT_CAP_SHORT_GI_80 |
+		   IEEE80211_VHT_CAP_TXSTBC | IEEE80211_VHT_CAP_RXSTBC_1 |
+		   IEEE80211_VHT_CAP_SU_BEAMFORMEE_CAPABLE |
+		   FIELD_PREP(IEEE80211_VHT_CAP_BEAMFORMEE_STS_MASK, 3) |
+		   FIELD_PREP(IEEE80211_VHT_CAP_MAX_A_MPDU_LENGTH_EXPONENT_MASK,
+			      7);
+	vht->vht_mcs.rx_mcs_map = cpu_to_le16(0xfffa);
+	vht->vht_mcs.tx_mcs_map = cpu_to_le16(0xfff5);
+}
+
+/* HE: 2 streams of MCS 0-11 at 80 MHz, SU beamformer, SU beamformee of 2
+ * space-time streams below 80 MHz
+ */
+static void mt7915_test_he(struct ieee80211_sta *sta)
+{
+	struct ieee80211_sta_he_cap *he = &sta->deflink.he_cap;
+
+	memset(he, 0, sizeof(*he));
+	he->has_he = true;
+	he->he_cap_elem.phy_cap_info[3] = IEEE80211_HE_PHY_CAP3_SU_BEAMFORMER;
+	he->he_cap_elem.phy_cap_info[4] = IEEE80211_HE_PHY_CAP4_SU_BEAMFORMEE |
+		u8_encode_bits(1, IEEE80211_HE_PHY_CAP4_BEAMFORMEE_MAX_STS_UNDER_80MHZ_MASK);
+	he->he_mcs_nss_supp.rx_mcs_80 = cpu_to_le16(0xfffa);
+	he->he_mcs_nss_supp.tx_mcs_80 = cpu_to_le16(0xfffa);
+	he->he_mcs_nss_supp.rx_mcs_160 = cpu_to_le16(0xffff);
+	he->he_mcs_nss_supp.rx_mcs_80p80 = cpu_to_le16(0xffff);
+}
