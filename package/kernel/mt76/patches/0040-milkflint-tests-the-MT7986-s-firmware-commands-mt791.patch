+/* HT is implicit only: rows for all antennas, columns from the station's
+ * tx streams if it says, else from its rx MCS set.
+ */
+static void mt7915_test_bfer_ht(struct kunit *test)
+{
+	struct ieee80211_mcs_info *mcs;
+	struct mt7915_test_ctx c;
+	struct sta_rec_bf *bf;
+
+	mt7915_test_init(test, &c, NL80211_BAND_2GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_ht(c.sta);
+	mcs = &c.sta->deflink.ht_cap.mcs;
+
+	/* no iBF: nothing for HT */
+	KUNIT_EXPECT_NULL(test, mt7915_test_bf_tlv(test, &c));
+
+	c.dev->ibf = true;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->tx_mode, MT_PHY_TYPE_HT);
+	KUNIT_EXPECT_EQ(test, bf->bf_cap, 2);
+	KUNIT_EXPECT_EQ(test, bf->nrow, 3);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->ibf_ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->bw, IEEE80211_STA_RX_BW_20);
+	KUNIT_EXPECT_EQ(test, bf->ibf_timeout, 0x18);
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 5);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 0);
+
+	mcs->rx_mask[2] = 0xff;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 2);
+	KUNIT_EXPECT_EQ(test, bf->ibf_ncol, 2);
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 6);
+	mcs->rx_mask[3] = 0xff;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 3);
+	KUNIT_EXPECT_EQ(test, bf->ibf_ncol, 3);
+
+	/* tx streams it declares win */
+	mcs->tx_params = IEEE80211_HT_MCS_TX_DEFINED |
+			 IEEE80211_HT_MCS_TX_RX_DIFF |
+			 FIELD_PREP(IEEE80211_HT_MCS_TX_MAX_STREAMS_MASK, 1);
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_40;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, bf->mem_20m);
+
+	/* ... only when they differ from the rx streams */
+	mcs->tx_params = IEEE80211_HT_MCS_TX_DEFINED;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 3);
+
+	/* a single stream up to 40 MHz takes longer to time out */
+	mcs->tx_params = 0;
+	mcs->rx_mask[1] = mcs->rx_mask[2] = mcs->rx_mask[3] = 0;
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_20;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 0);
+	KUNIT_EXPECT_EQ(test, bf->ibf_timeout, 0x48);
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 3);
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_40;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ibf_timeout, 0x48);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 3);
+
+	/* legacy stations get none */
+	c.sta->deflink.ht_cap.ht_supported = false;
+	KUNIT_EXPECT_NULL(test, mt7915_test_bf_tlv(test, &c));
+}
