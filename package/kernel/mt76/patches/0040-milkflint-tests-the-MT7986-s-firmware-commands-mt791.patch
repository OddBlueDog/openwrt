+struct mt7915_mcu2_pre_cal {
+	u8 dir;
+	u8 valid;
+	__le16 bitmap;
+	s8 precal;
+	u8 action;
+	u8 band;
+	u8 idx;
+	u8 rsv[4];
+	__le32 len;
+};
+
+/* pre-calibration data read from flash: the group calibration, then the
+ * 1 KiB DPD units; no two units have the same bytes
+ */
+static u8 *mt7915_mcu2_cal(struct kunit *test, struct mt7915_dev *dev)
+{
+	u32 len = mt7915_get_cal_group_size(dev) +
+		  mt7915_get_cal_dpd_size(dev);
+	u8 *cal;
+	u32 i;
+
+	cal = vzalloc(len);
+	KUNIT_ASSERT_NOT_NULL(test, cal);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_vfree, cal), 0);
+	for (i = 0; i < len; i++)
+		cal[i] = i ^ (i >> 10);
+	dev->cal = cal;
+	return cal;
+}
+
+/* messages @first.. are the DPD units of the channel in slot @slot: three
+ * per channel, two on the MT7915
+ */
+static void mt7915_mcu2_expect_dpd(struct kunit *test, struct mt7915_dev *dev,
+				   unsigned int first, int slot)
+{
+	const u8 *cal = (u8 *)dev->cal + mt7915_get_cal_group_size(dev);
+	int i, unit, n = is_mt7915(&dev->mt76) ? 2 : 3;
+	const struct mt7915_mcu2_pre_cal *req;
+	struct mt76_test_msg *msg;
+
+	for (i = 0; i < n; i++) {
+		unit = slot * n + i;
+		msg = mt7915_mcu2_nth(test, first + i,
+				      MCU_EXT_CMD(DPD_PRE_CAL_INFO),
+				      sizeof(*req) + MT_EE_CAL_UNIT);
+		req = (const void *)msg->data;
+		KUNIT_EXPECT_EQ(test, req->idx, (u8)unit);
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(req->len), MT_EE_CAL_UNIT);
+		KUNIT_EXPECT_EQ(test, memcmp(msg->data + sizeof(*req),
+					     cal + unit * MT_EE_CAL_UNIT,
+					     MT_EE_CAL_UNIT), 0);
+	}
+}
+
+/* Before using a channel the driver hands the firmware its DPD calibration
+ * from flash (DPD, flatness...: three 1 KiB units from the channel's slot),
+ * if the EEPROM says the band was calibrated.
+ */
+static void mt7915_mcu2_tx_dpd_5g(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 *eep = mt7915_mcu2_eeprom(test, dev);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	mt7915_mcu2_cal(test, dev);
+	mt7915_mcu2_bands(test, dev);
+	eep[MT_EE_DO_PRE_CAL_V2] = MT_EE_WIFI_CAL_DPD_5G;
+
+	mt7915_mcu2_tune(test, dev, 5180, NL80211_CHAN_WIDTH_20, 5180);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_tx_dpd(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+	mt7915_mcu2_expect_dpd(test, dev, 0, 66);
+
+	mt7915_mcu2_tune(test, dev, 5180, NL80211_CHAN_WIDTH_80, 5210);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_tx_dpd(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 6);
+	mt7915_mcu2_expect_dpd(test, dev, 3, 68);
+
+	/* the UNII-3 channels: slots past 255 units */
+	mt7915_mcu2_tune(test, dev, 5745, NL80211_CHAN_WIDTH_20, 5745);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_tx_dpd(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 9);
+	mt7915_mcu2_expect_dpd(test, dev, 6, 86);
+}
+
+/* The MT7915 keeps its calibration flags elsewhere in the EEPROM, has a
+ * shorter channel list and two DPD units per channel.
+ */
+static void mt7915_mcu2_tx_dpd_mt7915(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u8 *eep;
+
+	dev->mt76.rev = 0x79150000;
+	eep = mt7915_mcu2_eeprom(test, dev);
+	mt7915_mcu2_cal(test, dev);
+	mt7915_mcu2_bands(test, dev);
+
+	eep[MT_EE_DO_PRE_CAL_V2] = MT_EE_WIFI_CAL_DPD_5G;
+	mt7915_mcu2_tune(test, dev, 5200, NL80211_CHAN_WIDTH_20, 5200);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_tx_dpd(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	eep[MT_EE_DO_PRE_CAL] = MT_EE_WIFI_CAL_DPD_5G;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_tx_dpd(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	mt7915_mcu2_expect_dpd(test, dev, 0, 1);
+
+	eep[MT_EE_DO_PRE_CAL] = MT_EE_WIFI_CAL_GROUP;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_group_cal(dev), 0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 2 + 50);
+	dev->mt76.rev = 0x79860000;
+}
+
+/* Each band has its own "DPD calibrated" bit; 2.4 GHz channels use the
+ * band's slots after the 5 GHz list, 6 GHz ones the front of it.
+ */
+static void mt7915_mcu2_tx_dpd_bands(struct kunit *test)
+{
+	struct ieee80211_channel chan6g =
+		MT7915_MCU2_CHAN(NL80211_BAND_6GHZ, 5975, 5, 0);
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 *eep = mt7915_mcu2_eeprom(test, dev);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	mt7915_mcu2_cal(test, dev);
+	mt7915_mcu2_bands(test, dev);
+	eep[MT_EE_DO_PRE_CAL_V2] = MT_EE_WIFI_CAL_DPD_2G |
+				   MT_EE_WIFI_CAL_DPD_6G;
+
+	mt7915_mcu2_tune(test, dev, 5180, NL80211_CHAN_WIDTH_20, 5180);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_tx_dpd(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+
+	mt7915_mcu2_tune(test, dev, 2437, NL80211_CHAN_WIDTH_20, 2437);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_tx_dpd(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 3);
+	mt7915_mcu2_expect_dpd(test, dev, 0, 98);
+
+	dev->mphy.chandef.chan = &chan6g;
+	dev->mphy.chandef.center_freq1 = 5975;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_tx_dpd(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 6);
+	mt7915_mcu2_expect_dpd(test, dev, 3, 1);
+
+	eep[MT_EE_DO_PRE_CAL_V2] = MT_EE_WIFI_CAL_DPD_5G;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_tx_dpd(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 6);
+	dev->mphy.chandef.chan = NULL;
+}
