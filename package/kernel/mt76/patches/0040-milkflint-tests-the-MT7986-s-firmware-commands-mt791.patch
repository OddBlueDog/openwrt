+/* An SMPS change: the WTBL SMPS bit (dynamic SMPS only), then the rate
+ * control's MMPS mode.
+ */
+static void mt7915_test_add_smps(struct kunit *test)
+{
+	struct sta_rec_ra_fixed *ra;
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+	struct wtbl_smps *smps;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	c.sta->deflink.smps_mode = IEEE80211_SMPS_DYNAMIC;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_smps(c.dev, c.vif, c.sta), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 2);
+	msg = mt76_test_msg(c.fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	KUNIT_EXPECT_EQ(test, mt7915_test_wtbl_hdr(test, msg)->operation,
+			WTBL_SET);
+	smps = mt7915_test_wtbl(test, msg, WTBL_SMPS, struct wtbl_smps);
+	KUNIT_ASSERT_NOT_NULL(test, smps);
+	KUNIT_EXPECT_EQ(test, smps->smps, 1);
+	ra = mt7915_test_ra_fixed(test, &c, 1);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->field), RATE_PARAM_MMPS_UPDATE);
+	KUNIT_EXPECT_EQ(test, ra->mmps_mode, MCU_MMPS_DYNAMIC);
+
+	c.sta->deflink.smps_mode = IEEE80211_SMPS_STATIC;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_smps(c.dev, c.vif, c.sta), 0);
+	smps = mt7915_test_wtbl(test, mt76_test_msg(c.fake, 2), WTBL_SMPS,
+				struct wtbl_smps);
+	KUNIT_ASSERT_NOT_NULL(test, smps);
+	KUNIT_EXPECT_EQ(test, smps->smps, 0);
+	ra = mt7915_test_ra_fixed(test, &c, 3);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, ra->mmps_mode, MCU_MMPS_STATIC);
+
+	/* a failed WTBL update stops it */
+	mt7915_test_fail_at(test, c.dev, 0, -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_smps(c.dev, c.vif, c.sta), -EIO);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 5);
+}
