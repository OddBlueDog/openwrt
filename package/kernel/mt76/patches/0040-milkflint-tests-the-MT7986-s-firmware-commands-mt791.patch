+/* The MT7915's layout: five counters behind 20 bytes, and its tx time
+ * includes the backoff (79 us per TXOP start), which the driver removes.
+ */
+static void mt7915_mcu2_chan_mib_mt7915(struct kunit *test)
+{
+	static const u32 offs[] = {
+		MIB_NON_WIFI_TIME, MIB_TX_TIME, MIB_RX_TIME,
+		MIB_OBSS_AIRTIME, MIB_TXOP_INIT_COUNT,
+	};
+	static const u64 data[] = { 100, 10000, 300, 400, 0x10002 };
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu_mib *req;
+	struct mt76_channel_state *state;
+	struct mt76_test_msg *msg;
+	int i;
+
+	state = kunit_kzalloc(test, sizeof(*state), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, state);
+	dev->mphy.chan_state = state;
+	dev->mt76.rev = 0x79150000;
+
+	mt7915_mcu2_mib_reply(test, 20, data, 4);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_chan_mib_info(&dev->phy, false),
+			-EINVAL);
+
+	mt7915_mcu2_mib_reply(test, 20, data, 5);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_get_chan_mib_info(&dev->phy, false),
+			0);
+	msg = mt7915_mcu2_msg(test, MCU_EXT_CMD(GET_MIB_INFO),
+			      5 * sizeof(*req));
+	req = (const void *)msg->data;
+	for (i = 0; i < 5; i++)
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(req[i].offs), offs[i]);
+	KUNIT_EXPECT_EQ(test, state->cc_tx, 10000 - 2 * 79);
+	KUNIT_EXPECT_EQ(test, state->cc_busy, 100 + 10000 - 2 * 79 + 300 + 400);
+	dev->mt76.rev = 0x79860000;
+}
+
+/* A channel's DPD slot: 20 MHz channels by frequency (6 GHz first), 2.4 GHz
+ * by thirds after them, wider ones by the channel above, else below center.
+ */
+static void mt7915_mcu2_dpd_idx(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const int n = 97;
+
+#define __idx(_freq, _bw)						\
+	mt7915_dpd_freq_idx(dev, _freq, NL80211_CHAN_WIDTH_##_bw)
+	KUNIT_EXPECT_EQ(test, __idx(2412, 20), n);
+	KUNIT_EXPECT_EQ(test, __idx(2431, 20), n);
+	KUNIT_EXPECT_EQ(test, __idx(2432, 20), n + 1);
+	KUNIT_EXPECT_EQ(test, __idx(2456, 40), n + 1);
+	KUNIT_EXPECT_EQ(test, __idx(2457, 20), n + 2);
+	KUNIT_EXPECT_EQ(test, __idx(2484, 20), n + 2);
+
+	KUNIT_EXPECT_EQ(test, __idx(5955, 20), 0);
+	KUNIT_EXPECT_EQ(test, __idx(6115, 20), 8);
+	KUNIT_EXPECT_EQ(test, __idx(7115, 20), 58);
+	KUNIT_EXPECT_EQ(test, __idx(5180, 20), 66);
+	KUNIT_EXPECT_EQ(test, __idx(5885, 20), 93);
+	KUNIT_EXPECT_EQ(test, __idx(5190, 40), 67);
+	KUNIT_EXPECT_EQ(test, __idx(5210, 80), 68);
+	KUNIT_EXPECT_EQ(test, __idx(5895, 40), 93);	/* nothing above */
+
+	/* 20 MHz channels need their own slot; 80+80 has none */
+	KUNIT_EXPECT_EQ(test, __idx(5190, 20), -1);
+	KUNIT_EXPECT_EQ(test, __idx(5170, 20), -1);
+	KUNIT_EXPECT_EQ(test, __idx(5210, 80P80), -1);
+
+	/* the MT7915's shorter list: 5 GHz only */
+	dev->mt76.rev = 0x79150000;
+	KUNIT_EXPECT_EQ(test, __idx(2412, 20), 24);
+	KUNIT_EXPECT_EQ(test, __idx(5180, 20), 0);
+	KUNIT_EXPECT_EQ(test, __idx(5825, 20), 23);
+	KUNIT_EXPECT_EQ(test, __idx(5190, 40), 1);
+	KUNIT_EXPECT_EQ(test, __idx(5955, 20), -1);
+	dev->mt76.rev = 0x79860000;
+#undef __idx
+}
+
+/* The MT7986's list ends with slots for 160 MHz channels (5250, 5570 and
+ * 5815 MHz; 6 GHz ones after the 6 GHz channels), but a 160 MHz channel
+ * finds the 20 MHz channel above its center first and never gets them.
+ */
+static void mt7915_mcu2_dpd_idx_160(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+
+	kunit_skip(test, "driver bug: 160 MHz channels never use their BW160 DPD slot");
+	dev = mt7915_test_dev(test);
+	KUNIT_EXPECT_EQ(test, mt7915_dpd_freq_idx(dev, 5250,
+			NL80211_CHAN_WIDTH_160), 94);
+	KUNIT_EXPECT_EQ(test, mt7915_dpd_freq_idx(dev, 5570,
+			NL80211_CHAN_WIDTH_160), 95);
+	KUNIT_EXPECT_EQ(test, mt7915_dpd_freq_idx(dev, 5815,
+			NL80211_CHAN_WIDTH_160), 96);
+	KUNIT_EXPECT_EQ(test, mt7915_dpd_freq_idx(dev, 6025,
+			NL80211_CHAN_WIDTH_160), 59);
+}
