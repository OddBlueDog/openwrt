+/* The spatial expansion index for the radio's antenna mask goes into the
+ * station's rate control (RA) record.
+ */
+static void mt7915_mcu2_spe_idx(struct kunit *test)
+{
+	static const struct {
+		u8 antenna_mask;
+		u8 spe_idx;
+	} cases[] = {
+		{ 0x1, 0 }, { 0x3, 0 }, { 0x5, 2 }, { 0x6, 4 }, { 0xc, 16 },
+		{ 0xe, 18 }, { 0xf, 0 },
+	};
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct ieee80211_vif *vif = mt7915_mcu2_vif(test, dev);
+	struct ieee80211_sta *sta = mt7915_mcu2_sta(test, vif, 0x42);
+	const struct sta_rec_ra_fixed *ra;
+	struct mt76_test_msg *msg;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		dev->mphy.antenna_mask = cases[i].antenna_mask;
+		KUNIT_ASSERT_EQ(test, mt7915_mcu_set_spe_idx(dev, vif, sta), 0);
+		msg = mt7915_mcu2_msg(test, MCU_EXT_CMD(STA_REC_UPDATE),
+				      sizeof(struct sta_req_hdr) +
+				      sizeof(*ra));
+		ra = (const void *)(msg->data + sizeof(struct sta_req_hdr));
+		KUNIT_EXPECT_EQ(test, le16_to_cpu(ra->tag), STA_REC_RA_UPDATE);
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->field),
+				RATE_PARAM_SPE_UPDATE);
+		KUNIT_EXPECT_EQ_MSG(test, ra->spe_idx, cases[i].spe_idx,
+				    "antenna mask %#x",
+				    cases[i].antenna_mask);
+	}
+}
