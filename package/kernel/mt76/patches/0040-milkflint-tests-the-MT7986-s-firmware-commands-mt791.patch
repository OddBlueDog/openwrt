+/* The beamforming actions the driver uses: sounding on, eBF (+ iBF if
+ * enabled) and two BF modules; anything else is refused unsent.
+ */
+static void mt7915_test_set_txbf(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt76_test_msg *msg;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_txbf(dev, MT_BF_SOUNDING_ON), 0);
+	msg = mt76_test_msg(fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(TXBF_ACTION));
+	KUNIT_EXPECT_EQ(test, msg->len, 16);
+	KUNIT_EXPECT_EQ(test, msg->data[0], MT_BF_SOUNDING_ON);
+	KUNIT_EXPECT_EQ(test, msg->data[1], 4);		/* snd_mode */
+
+	dev->ibf = true;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_txbf(dev, MT_BF_TYPE_UPDATE), 0);
+	msg = mt76_test_msg(fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->data[0], MT_BF_TYPE_UPDATE);
+	KUNIT_EXPECT_EQ(test, msg->data[1], 1);		/* ebf */
+	KUNIT_EXPECT_EQ(test, msg->data[2], 1);		/* ibf */
+	dev->ibf = false;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_txbf(dev, MT_BF_TYPE_UPDATE), 0);
+	msg = mt76_test_msg(fake, 2);
+	KUNIT_EXPECT_EQ(test, msg->data[1], 1);
+	KUNIT_EXPECT_EQ(test, msg->data[2], 0);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_txbf(dev, MT_BF_MODULE_UPDATE), 0);
+	msg = mt76_test_msg(fake, 3);
+	KUNIT_EXPECT_EQ(test, msg->data[0], MT_BF_MODULE_UPDATE);
+	KUNIT_EXPECT_EQ(test, msg->data[1], 2);		/* bf_num */
+	KUNIT_EXPECT_EQ(test, msg->data[2], 3);		/* bf_bitmap */
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_txbf(dev, 2), -EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 4);
+
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_txbf(dev, MT_BF_SOUNDING_ON),
+			-EIO);
+}
