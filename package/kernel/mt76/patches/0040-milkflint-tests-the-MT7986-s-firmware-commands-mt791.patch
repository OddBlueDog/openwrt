+/* the group calibration messages: @n pieces of 1 KiB, the last @last bytes */
+static void mt7915_mcu2_expect_group_cal(struct kunit *test,
+					 struct mt7915_dev *dev, int n,
+					 int last)
+{
+	const struct mt7915_mcu2_pre_cal *req;
+	struct mt76_test_msg *msg;
+	int i, len;
+
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, n);
+	for (i = 0; i < n; i++) {
+		len = i == n - 1 ? last : MT_EE_CAL_UNIT;
+		msg = mt7915_mcu2_nth(test, i, MCU_EXT_CMD(GROUP_PRE_CAL_INFO),
+				      sizeof(*req) + len);
+		req = (const void *)msg->data;
+		KUNIT_EXPECT_EQ(test, req->idx, i);
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(req->len), len);
+		KUNIT_EXPECT_EQ(test, memcmp(msg->data + sizeof(*req),
+				(u8 *)dev->cal + i * MT_EE_CAL_UNIT, len), 0);
+	}
+}
+
+/* The group calibration (DC offsets, IQ...) goes to the firmware in 1 KiB
+ * pieces with increasing indexes, the last one shorter: 54 KiB and 16
+ * bytes with MT7975 A-dies. Nothing is sent when the EEPROM has none.
+ */
+static void mt7915_mcu2_group_cal(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 *eep = mt7915_mcu2_eeprom(test, dev);
+
+	mt7915_mcu2_cal(test, dev);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_group_cal(dev), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 0);
+
+	eep[MT_EE_DO_PRE_CAL_V2] = MT_EE_WIFI_CAL_GROUP;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_group_cal(dev), 0);
+	mt7915_mcu2_expect_group_cal(test, dev, 55, 16);
+}
+
+/* With MT7976 A-dies (the GL-MT6000's) it is 94 KiB and 16 bytes; an error
+ * stops the upload.
+ */
+static void mt7915_mcu2_group_cal_mt7976(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 *eep = mt7915_mcu2_eeprom(test, dev);
+
+	mt7915_mcu2_set_adie(dev, MT_ADIE_TYPE_MASK);
+	mt7915_mcu2_cal(test, dev);
+	eep[MT_EE_DO_PRE_CAL_V2] = MT_EE_WIFI_CAL_GROUP;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_group_cal(dev), 0);
+	mt7915_mcu2_expect_group_cal(test, dev, 95, 16);
+
+	mt7915_mcu2_fail_nth(dev, 3);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_apply_group_cal(dev), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 95 + 3);
+}
+
+struct mt7915_mcu2_rdd_ctrl {
+	u8 ctrl;
+	u8 rdd_idx;
+	u8 rdd_rx_sel;
+	u8 val;
+	u8 rsv[4];
+} __packed;
+
+/* the background chain for radar detection: on 5180 MHz at 80 MHz, two
+ * antennas, watching @watch (5260 MHz at 80 MHz)
+ */
+static void mt7915_mcu2_background_setup(struct kunit *test,
+					 struct mt7915_dev *dev,
+					 struct cfg80211_chan_def *watch)
+{
+	mt7915_mcu2_bands(test, dev);
+	dev->mphy.cap.has_5ghz = true;
+	dev->mphy.band_idx = MT_BAND1;
+	dev->mphy.chainmask = 0x3;
+	dev->mphy.antenna_mask = 0x3;
+	mt7915_mcu2_tune(test, dev, 5180, NL80211_CHAN_WIDTH_80, 5210);
+	mt7915_mcu2_chandef(test, dev, watch, 5260, NL80211_CHAN_WIDTH_80,
+			    5290);
+}
+
+/* Background radar off: stop detector 2, park its chain on the operating
+ * channel. On: watch the channel, start detection with the region's rules.
+ */
+static void mt7915_mcu2_background_radar(struct kunit *test)
+{
+	static const struct {
+		enum nl80211_dfs_regions region;
+		u8 val;
+	} regions[] = {
+		{ NL80211_DFS_ETSI, 0 },
+		{ NL80211_DFS_FCC, 1 },
+		{ NL80211_DFS_JP, 2 },
+		{ NL80211_DFS_UNSET, 1 },
+	};
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu_background_chain_ctrl *ctrl;
+	const struct mt7915_mcu2_rdd_ctrl *rdd;
+	struct cfg80211_chan_def watch;
+	struct mt76_test_msg *msg;
+	int i;
+
+	mt7915_mcu2_background_setup(test, dev, &watch);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_rdd_background_enable(&dev->phy,
+			NULL), 0);
+	msg = mt7915_mcu2_nth(test, 0, MCU_EXT_CMD(SET_RDD_CTRL),
+			      sizeof(*rdd));
+	rdd = (const void *)msg->data;
+	KUNIT_EXPECT_EQ(test, rdd->ctrl, RDD_STOP);
+	KUNIT_EXPECT_EQ(test, rdd->rdd_idx, MT_RDD_IDX_BACKGROUND);
+	KUNIT_EXPECT_EQ(test, rdd->val, 0);
+	msg = mt7915_mcu2_nth(test, 1, MCU_EXT_CMD(OFFCH_SCAN_CTRL),
+			      sizeof(*ctrl));
+	ctrl = (const void *)msg->data;
+	KUNIT_EXPECT_EQ(test, ctrl->chan, 36);
+	KUNIT_EXPECT_EQ(test, ctrl->central_chan, 42);
+	KUNIT_EXPECT_EQ(test, ctrl->bw, CMD_CBW_80MHZ);
+	KUNIT_EXPECT_EQ(test, ctrl->tx_stream, 2);
+	KUNIT_EXPECT_EQ(test, ctrl->rx_stream, 0x3);
+	KUNIT_EXPECT_EQ(test, ctrl->monitor_chan, 0);
+	KUNIT_EXPECT_EQ(test, ctrl->scan_mode, 0);
+	KUNIT_EXPECT_EQ(test, ctrl->monitor_scan_type, 2);
+	KUNIT_EXPECT_EQ(test, ctrl->band, 1);
+
+	for (i = 0; i < ARRAY_SIZE(regions); i++) {
+		dev->mt76.region = regions[i].region;
+		KUNIT_ASSERT_EQ(test, mt7915_mcu_rdd_background_enable(
+				&dev->phy, &watch), 0);
+		msg = mt7915_mcu2_nth(test, 2 + 2 * i,
+				      MCU_EXT_CMD(OFFCH_SCAN_CTRL),
+				      sizeof(*ctrl));
+		ctrl = (const void *)msg->data;
+		KUNIT_EXPECT_EQ(test, ctrl->chan, 36);
+		KUNIT_EXPECT_EQ(test, ctrl->central_chan, 42);
+		KUNIT_EXPECT_EQ(test, ctrl->bw, CMD_CBW_80MHZ);
+		KUNIT_EXPECT_EQ(test, ctrl->monitor_chan, 52);
+		KUNIT_EXPECT_EQ(test, ctrl->monitor_central_chan, 58);
+		KUNIT_EXPECT_EQ(test, ctrl->monitor_bw, CMD_CBW_80MHZ);
+		KUNIT_EXPECT_EQ(test, ctrl->band_idx, MT_BAND1);
+		KUNIT_EXPECT_EQ(test, ctrl->scan_mode, 1);
+		KUNIT_EXPECT_EQ(test, ctrl->monitor_scan_type, 2);
+		KUNIT_EXPECT_EQ(test, ctrl->band, 1);
+		msg = mt7915_mcu2_nth(test, 3 + 2 * i,
+				      MCU_EXT_CMD(SET_RDD_CTRL), sizeof(*rdd));
+		rdd = (const void *)msg->data;
+		KUNIT_EXPECT_EQ(test, rdd->ctrl, RDD_START);
+		KUNIT_EXPECT_EQ(test, rdd->rdd_idx, MT_RDD_IDX_BACKGROUND);
+		KUNIT_EXPECT_EQ_MSG(test, rdd->val, regions[i].val,
+				    "region %d", regions[i].region);
+	}
+}
