+	KUNIT_ASSERT_NOT_NULL(test, bc);
+	KUNIT_EXPECT_EQ(test, bc->color, 42);
+	KUNIT_EXPECT_EQ(test, bc->disable, 0);
+
+	color.enabled = false;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_update_bss_color(c.dev, c.vif,
+			&color), 0);
+	bc = mt7915_test_tlv(test, mt76_test_msg(c.fake, 1),
+			     BSS_INFO_BSS_COLOR, struct bss_info_color);
+	KUNIT_ASSERT_NOT_NULL(test, bc);
+	KUNIT_EXPECT_EQ(test, bc->disable, 1);
+}
