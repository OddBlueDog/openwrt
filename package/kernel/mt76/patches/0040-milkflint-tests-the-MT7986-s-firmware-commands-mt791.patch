+/* Without 5 GHz there's no radar detector; an untuned radio has no channel
+ * to park the chain on; firmware errors stop the sequence.
+ */
+static void mt7915_mcu2_background_radar_errors(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct cfg80211_chan_def watch;
+
+	mt7915_mcu2_background_setup(test, dev, &watch);
+
+	dev->mphy.cap.has_5ghz = false;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_rdd_background_enable(&dev->phy,
+			&watch), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_rdd_background_enable(&dev->phy,
+			NULL), -EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 0);
+	dev->mphy.cap.has_5ghz = true;
+
+	mt7915_mcu2_fail_nth(dev, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_rdd_background_enable(&dev->phy,
+			NULL), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+	mt7915_mcu2_fail_nth(dev, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_rdd_background_enable(&dev->phy,
+			&watch), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 2);
+	mt7915_mcu2_fail_nth(dev, 2);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_rdd_background_enable(&dev->phy,
+			&watch), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 4);
+	fake->mcu_ret = 0;
+
+	dev->mphy.chandef.chan = NULL;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_rdd_background_enable(&dev->phy,
+			&watch), -EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 4);
+}
+
+/* While a background scan runs only the watched channel is named; starting
+ * one needs a channel, and unknown phases are refused. A 2.4 GHz channel
+ * to watch is marked as such.
+ */
+static void mt7915_mcu2_background_chain(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu_background_chain_ctrl *ctrl;
+	struct cfg80211_chan_def watch, watch2g;
+	struct mt76_test_msg *msg;
+
+	mt7915_mcu2_background_setup(test, dev, &watch);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_background_chain_ctrl(&dev->phy,
+			&watch, CH_SWITCH_BACKGROUND_SCAN_RUNNING), 0);
+	msg = mt7915_mcu2_msg(test, MCU_EXT_CMD(OFFCH_SCAN_CTRL),
+			      sizeof(*ctrl));
+	ctrl = (const void *)msg->data;
+	KUNIT_EXPECT_EQ(test, ctrl->monitor_chan, 52);
+	KUNIT_EXPECT_EQ(test, ctrl->monitor_central_chan, 58);
+	KUNIT_EXPECT_EQ(test, ctrl->band_idx, MT_BAND1);
+	KUNIT_EXPECT_EQ(test, ctrl->scan_mode, 2);
+	KUNIT_EXPECT_EQ(test, ctrl->chan, 0);
+	KUNIT_EXPECT_EQ(test, ctrl->monitor_bw, 0);
+	KUNIT_EXPECT_EQ(test, ctrl->band, 1);
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_background_chain_ctrl(&dev->phy,
+			NULL, CH_SWITCH_BACKGROUND_SCAN_START), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_background_chain_ctrl(&dev->phy,
+			&watch, CH_SWITCH_NORMAL), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 1);
+
+	mt7915_mcu2_chandef(test, dev, &watch2g, 2437,
+			    NL80211_CHAN_WIDTH_20, 2437);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_background_chain_ctrl(&dev->phy,
+			&watch2g, CH_SWITCH_BACKGROUND_SCAN_START), 0);
+	msg = mt7915_mcu2_msg(test, MCU_EXT_CMD(OFFCH_SCAN_CTRL),
+			      sizeof(*ctrl));
+	ctrl = (const void *)msg->data;
+	KUNIT_EXPECT_EQ(test, ctrl->monitor_chan, 6);
+	KUNIT_EXPECT_EQ(test, ctrl->band, 0);
+}
