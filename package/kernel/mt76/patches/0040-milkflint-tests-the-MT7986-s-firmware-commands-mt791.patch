+/* mac80211 has no beacon for an interface it never brought up: the beacon
+ * update fails and nothing is sent. The vif sits behind zeroed memory where
+ * mac80211's private part of it (whose link pointers it reads) would be.
+ */
+static void mt7915_test_add_beacon_no_template(struct kunit *test)
+{
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	c.vif = __mt7915_test_vif(test, c.phy, NL80211_IFTYPE_AP, HW_BSSID_0,
+				  SZ_64K);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_beacon(c.phy->mt76->hw, c.vif,
+			true, BSS_CHANGED_BEACON), -EINVAL);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 0);
+}
+
+/* FILS discovery and unsolicited probe responses need a template from
+ * mac80211, which only APs have; nothing is sent without one, and nothing
+ * for a non-transmitted BSS.
+ */
+static void mt7915_test_inband_discov(struct kunit *test)
+{
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_STATION);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_inband_discov(c.dev, c.vif,
+			BSS_CHANGED_FILS_DISCOVERY), -EINVAL);
+	c.vif->bss_conf.unsol_bcast_probe_resp_interval = 20;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_inband_discov(c.dev, c.vif,
+			BSS_CHANGED_UNSOL_BCAST_PROBE_RESP), -EINVAL);
+	/* no interval: no template asked for */
+	c.vif->bss_conf.unsol_bcast_probe_resp_interval = 0;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_inband_discov(c.dev, c.vif,
+			BSS_CHANGED_UNSOL_BCAST_PROBE_RESP), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_inband_discov(c.dev, c.vif, 0),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 0);
+
+	c.vif->bss_conf.nontransmitted = true;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_inband_discov(c.dev, c.vif,
+			BSS_CHANGED_FILS_DISCOVERY), 0);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 0);
+}
+
+/* Out of memory for the message: -ENOMEM, nothing sent, for every BSS
+ * command built in an skb.
+ */
+static void mt7915_test_bss_nomem(struct kunit *test)
+{
+	struct cfg80211_he_bss_color color = { .color = 1, .enabled = true };
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_nomem_after(test, c.dev, 0);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_bss_info(c.phy, c.vif, true),
+			-ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_beacon(c.phy->mt76->hw, c.vif,
+			false, BSS_CHANGED_BEACON_ENABLED), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_inband_discov(c.dev, c.vif,
+			BSS_CHANGED_FILS_DISCOVERY), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_protection(c.phy, c.vif, 0,
+			false), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_update_bss_color(c.dev, c.vif,
+			&color), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_dev_info(c.phy, c.vif, true),
+			-ENOMEM);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 0);
+}
