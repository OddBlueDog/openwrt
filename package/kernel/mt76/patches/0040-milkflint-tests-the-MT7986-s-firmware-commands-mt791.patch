+/* A disconnecting station gets only its basic TLV (no VOW group); a new
+ * one being added disconnected gets its WTBL entry too.
+ */
+static void mt7915_test_add_sta_disconnect(struct kunit *test)
+{
+	struct sta_rec_basic *basic;
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+	u16 tags[8];
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_ht(c.sta);
+	mt7915_test_he(c.sta);
+	c.sta->deflink.agg.max_amsdu_len = IEEE80211_MAX_MPDU_LEN_VHT_7991;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_sta(c.dev, c.vif, c.sta,
+			CONN_STATE_DISCONNECT, false), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 1);
+	msg = mt76_test_msg(c.fake, 0);
+	KUNIT_ASSERT_EQ(test, mt7915_test_tags(test, msg, tags, 8), 1);
+	KUNIT_EXPECT_EQ(test, tags[0], STA_REC_BASIC);
+	basic = mt7915_test_tlv(test, msg, STA_REC_BASIC, struct sta_rec_basic);
+	KUNIT_ASSERT_NOT_NULL(test, basic);
+	KUNIT_EXPECT_EQ(test, basic->conn_state, CONN_STATE_DISCONNECT);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->extra_info), EXTRA_INFO_VER);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_sta(c.dev, c.vif, c.sta,
+			CONN_STATE_DISCONNECT, true), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 2);
+	msg = mt76_test_msg(c.fake, 1);
+	KUNIT_ASSERT_EQ(test, mt7915_test_tags(test, msg, tags, 8), 2);
+	KUNIT_EXPECT_EQ(test, tags[0], STA_REC_BASIC);
+	KUNIT_EXPECT_EQ(test, tags[1], STA_REC_WTBL);
+	basic = mt7915_test_tlv(test, msg, STA_REC_BASIC, struct sta_rec_basic);
+	KUNIT_ASSERT_NOT_NULL(test, basic);
+	/* "new" only for a connection */
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->extra_info), EXTRA_INFO_VER);
+	KUNIT_EXPECT_NOT_NULL(test, mt7915_test_wtbl(test, msg, WTBL_HT,
+						     struct wtbl_ht));
+}
