+/* @c's station's STA_REC_BF, built on its own */
+static struct sta_rec_bf *mt7915_test_bf_tlv(struct kunit *test,
+					     struct mt7915_test_ctx *c)
+{
+	struct sk_buff *skb = mt7915_test_sta_req(test, c, &c->msta->wcid);
+
+	mt7915_mcu_sta_bfer_tlv(c->dev, skb, c->vif, c->sta);
+	return mt7915_test_skb_tlv(test, skb, STA_REC_BF, struct sta_rec_bf);
+}
+
+/* HE explicit beamforming: sounding at OFDM rates, rows from our sounding
+ * dimensions and the station's STS, columns from its streams, and the
+ * PFMU memory that takes; 160 MHz and 80+80 get their own dimensions.
+ */
+static void mt7915_test_bfer_he(struct kunit *test)
+{
+	struct ieee80211_he_cap_elem *pe;
+	struct mt7915_test_ctx c;
+	struct sta_rec_bf *bf;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_ht(c.sta);
+	mt7915_test_he(c.sta);
+	pe = &c.sta->deflink.he_cap.he_cap_elem;
+	pe->phy_cap_info[6] = IEEE80211_HE_PHY_CAP6_TRIG_SU_BEAMFORMING_FB;
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_80;
+
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->tx_mode, MT_PHY_TYPE_HE_SU);
+	KUNIT_EXPECT_EQ(test, bf->bf_cap, 1);
+	KUNIT_EXPECT_EQ(test, bf->sounding_phy, MT_PHY_TYPE_OFDM);
+	KUNIT_EXPECT_EQ(test, bf->ndp_rate, 0);
+	KUNIT_EXPECT_EQ(test, bf->ndpa_rate, MT7915_CFEND_RATE_DEFAULT);
+	KUNIT_EXPECT_EQ(test, bf->rept_poll_rate, MT7915_CFEND_RATE_DEFAULT);
+	KUNIT_EXPECT_TRUE(test, bf->trigger_su);
+	KUNIT_EXPECT_FALSE(test, bf->trigger_mu);
+	/* min(3 sounding dimensions, 1 STS), min(2 streams - 1, 1) */
+	KUNIT_EXPECT_EQ(test, bf->nrow, 1);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->ibf_ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->bw, IEEE80211_STA_RX_BW_80);
+	KUNIT_EXPECT_EQ(test, bf->ibf_dbw, IEEE80211_STA_RX_BW_80);
+	KUNIT_EXPECT_EQ(test, bf->ibf_nrow, 3);
+	KUNIT_EXPECT_EQ(test, bf->ibf_timeout, 0x18);
+	/* fewer rows than antennas: sized for all of them (4x2) */
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 5);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 10);
+	KUNIT_EXPECT_EQ(test, bf->nrow_gt_bw80, 0);
+	KUNIT_EXPECT_EQ(test, bf->ncol_gt_bw80, 0);
+
+	/* all four antennas sounded: 4x2 too, from the rows */
+	pe->phy_cap_info[4] = IEEE80211_HE_PHY_CAP4_SU_BEAMFORMEE |
+		u8_encode_bits(3, IEEE80211_HE_PHY_CAP4_BEAMFORMEE_MAX_STS_UNDER_80MHZ_MASK) |
+		u8_encode_bits(2, IEEE80211_HE_PHY_CAP4_BEAMFORMEE_MAX_STS_ABOVE_80MHZ_MASK);
+	pe->phy_cap_info[6] =
+		IEEE80211_HE_PHY_CAP6_TRIG_MU_BEAMFORMING_PARTIAL_BW_FB;
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_40;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_FALSE(test, bf->trigger_su);
+	KUNIT_EXPECT_TRUE(test, bf->trigger_mu);
+	KUNIT_EXPECT_EQ(test, bf->nrow, 3);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 5);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 5);
+
+	/* more STS than we sound: our 4 dimensions */
+	pe->phy_cap_info[4] = IEEE80211_HE_PHY_CAP4_SU_BEAMFORMEE |
+		u8_encode_bits(5, IEEE80211_HE_PHY_CAP4_BEAMFORMEE_MAX_STS_UNDER_80MHZ_MASK) |
+		u8_encode_bits(2, IEEE80211_HE_PHY_CAP4_BEAMFORMEE_MAX_STS_ABOVE_80MHZ_MASK);
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->nrow, 3);
+
+	/* 160 MHz with 80+80: columns from the smaller of the two maps */
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_160;
+	pe->phy_cap_info[0] =
+		IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_160MHZ_IN_5G |
+		IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_80PLUS80_MHZ_IN_5G;
+	c.sta->deflink.he_cap.he_mcs_nss_supp.rx_mcs_160 = cpu_to_le16(0xffea);
+	c.sta->deflink.he_cap.he_mcs_nss_supp.rx_mcs_80p80 =
+		cpu_to_le16(0xfffa);
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol_gt_bw80, 1);
+	KUNIT_EXPECT_EQ(test, bf->nrow_gt_bw80, 2);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 2 * bf->mem_20m);
+
+	pe->phy_cap_info[0] =
+		IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_160MHZ_IN_5G;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol_gt_bw80, 2);
+
+	pe->phy_cap_info[0] =
+		IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_80PLUS80_MHZ_IN_5G;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol_gt_bw80, 1);
+
+	/* without our HE capabilities for the interface: no record */
+	c.phy->mt76->sband_5g.sband.n_iftype_data = 0;
+	KUNIT_EXPECT_NULL(test, mt7915_test_bf_tlv(test, &c));
+}
+
+/* VHT explicit beamforming: rows from our sounding dimensions, its STS and
+ * our antennas, a single row at 160 MHz; implicit (if enabled): all our
+ * antennas, iBF timing and memory for narrow single-column entries.
+ */
+static void mt7915_test_bfer_vht(struct kunit *test)
+{
+	struct mt7915_test_ctx c;
+	struct sta_rec_bf *bf;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_ht(c.sta);
+	mt7915_test_vht(c.sta);
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_80;
+
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->tx_mode, MT_PHY_TYPE_VHT);
+	KUNIT_EXPECT_EQ(test, bf->bf_cap, 1);
+	KUNIT_EXPECT_EQ(test, bf->sounding_phy, MT_PHY_TYPE_OFDM);
+	KUNIT_EXPECT_EQ(test, bf->ndpa_rate, MT7915_CFEND_RATE_DEFAULT);
+	/* min(2 sounding dimensions, 3 STS, 3 antennas), 2 streams */
+	KUNIT_EXPECT_EQ(test, bf->nrow, 2);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->ibf_ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 5);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 10);
+
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_160;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->nrow, 1);
+
+	/* rows limited by the station's STS, then by our antennas */
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_80;
+	c.sta->deflink.vht_cap.cap &= ~IEEE80211_VHT_CAP_BEAMFORMEE_STS_MASK;
+	c.sta->deflink.vht_cap.cap |=
+		FIELD_PREP(IEEE80211_VHT_CAP_BEAMFORMEE_STS_MASK, 1);
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->nrow, 1);
+	c.sta->deflink.vht_cap.cap |=
+		FIELD_PREP(IEEE80211_VHT_CAP_BEAMFORMEE_STS_MASK, 3);
+	c.phy->mt76->chainmask = 0x3;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->nrow, 1);
+	KUNIT_EXPECT_EQ(test, bf->ibf_nrow, 1);
+	c.phy->mt76->chainmask = 0xf;
+
+	/* implicit: we don't explicitly beamform VHT */
+	c.mvif->cap.vht_su_ebfer = false;
+	c.dev->ibf = true;
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_40;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->tx_mode, MT_PHY_TYPE_VHT);
+	KUNIT_EXPECT_EQ(test, bf->bf_cap, 2);
+	KUNIT_EXPECT_EQ(test, bf->sounding_phy, 0);
+	KUNIT_EXPECT_EQ(test, bf->nrow, 3);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->ibf_ncol, 1);
+	KUNIT_EXPECT_EQ(test, bf->ibf_nrow, 3);
+	KUNIT_EXPECT_EQ(test, bf->ibf_timeout, 0x18);
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 5);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 5);
+
+	/* 160 MHz: twice the memory */
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_160;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->bw, IEEE80211_STA_RX_BW_160);
+	KUNIT_EXPECT_EQ(test, bf->ibf_dbw, IEEE80211_STA_RX_BW_160);
+	KUNIT_EXPECT_EQ(test, bf->nrow, 3);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 10);
+
+	/* one stream at 20 MHz */
+	c.sta->deflink.vht_cap.vht_mcs.rx_mcs_map = cpu_to_le16(0xfffe);
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_20;
+	bf = mt7915_test_bf_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bf);
+	KUNIT_EXPECT_EQ(test, bf->ncol, 0);
+	KUNIT_EXPECT_EQ(test, bf->ibf_timeout, 0x48);
+	KUNIT_EXPECT_EQ(test, bf->mem_20m, 3);
+	KUNIT_EXPECT_EQ(test, bf->mem_total, 0);
+
+	/* neither explicit nor implicit: none */
+	c.dev->ibf = false;
+	KUNIT_EXPECT_NULL(test, mt7915_test_bf_tlv(test, &c));
+}
