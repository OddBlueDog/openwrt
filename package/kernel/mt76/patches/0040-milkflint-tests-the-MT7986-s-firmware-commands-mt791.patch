+/* The MU/RU tx counters are clear-on-read in the firmware: each read adds
+ * them to the radio's totals.
+ */
+static void mt7915_mcu2_muru_stats(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu_muru_stats stats = {};
+	struct mt76_mib_stats *mib = &dev->phy.mib;
+	struct {
+		__le32 cmd;
+		u8 band_idx;
+	} *req;
+	__le32 *word = (__le32 *)&stats.dl;
+	int i;
+
+	/* every counter different: 1, 2, 3... */
+	for (i = 0; i < (sizeof(stats) - 4) / 4; i++)
+		word[i] = cpu_to_le32(i + 1);
+	mt7915_mcu2_reply(test, &stats, sizeof(stats));
+	dev->mphy.band_idx = MT_BAND1;
+	mib->dl_cck_cnt = 100;
+	mib->ul_hetrig_4mu_cnt = 200;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_muru_debug_get(&dev->phy), 0);
+	req = (void *)mt7915_mcu2_msg(test, MCU_EXT_CMD(MURU_CTRL),
+				      sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->cmd), MURU_GET_TXC_TX_STATS);
+	KUNIT_EXPECT_EQ(test, req->band_idx, MT_BAND1);
+
+	KUNIT_EXPECT_EQ(test, mib->dl_cck_cnt, 100 + 1);
+	KUNIT_EXPECT_EQ(test, mib->dl_ofdm_cnt, 2);
+	KUNIT_EXPECT_EQ(test, mib->dl_htmix_cnt, 3);
+	KUNIT_EXPECT_EQ(test, mib->dl_htgf_cnt, 4);
+	KUNIT_EXPECT_EQ(test, mib->dl_vht_su_cnt, 5);
+	KUNIT_EXPECT_EQ(test, mib->dl_vht_2mu_cnt, 6);
+	KUNIT_EXPECT_EQ(test, mib->dl_vht_3mu_cnt, 7);
+	KUNIT_EXPECT_EQ(test, mib->dl_vht_4mu_cnt, 8);
+	KUNIT_EXPECT_EQ(test, mib->dl_he_su_cnt, 9);
+	/* 10: HE extended range SU, not kept */
+	KUNIT_EXPECT_EQ(test, mib->dl_he_2ru_cnt, 11);
+	KUNIT_EXPECT_EQ(test, mib->dl_he_2mu_cnt, 12);
+	KUNIT_EXPECT_EQ(test, mib->dl_he_3ru_cnt, 13);
+	KUNIT_EXPECT_EQ(test, mib->dl_he_3mu_cnt, 14);
+	KUNIT_EXPECT_EQ(test, mib->dl_he_4ru_cnt, 15);
+	KUNIT_EXPECT_EQ(test, mib->dl_he_4mu_cnt, 16);
+	KUNIT_EXPECT_EQ(test, mib->dl_he_5to8ru_cnt, 17);
+	KUNIT_EXPECT_EQ(test, mib->dl_he_9to16ru_cnt, 18);
+	KUNIT_EXPECT_EQ(test, mib->dl_he_gtr16ru_cnt, 19);
+	KUNIT_EXPECT_EQ(test, mib->ul_hetrig_su_cnt, 20);
+	KUNIT_EXPECT_EQ(test, mib->ul_hetrig_2ru_cnt, 21);
+	KUNIT_EXPECT_EQ(test, mib->ul_hetrig_3ru_cnt, 22);
+	KUNIT_EXPECT_EQ(test, mib->ul_hetrig_4ru_cnt, 23);
+	KUNIT_EXPECT_EQ(test, mib->ul_hetrig_5to8ru_cnt, 24);
+	KUNIT_EXPECT_EQ(test, mib->ul_hetrig_9to16ru_cnt, 25);
+	KUNIT_EXPECT_EQ(test, mib->ul_hetrig_gtr16ru_cnt, 26);
+	KUNIT_EXPECT_EQ(test, mib->ul_hetrig_2mu_cnt, 27);
+	KUNIT_EXPECT_EQ(test, mib->ul_hetrig_3mu_cnt, 28);
+	KUNIT_EXPECT_EQ(test, mib->ul_hetrig_4mu_cnt, 200 + 29);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_muru_debug_get(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, mib->dl_cck_cnt, 100 + 2);
+	KUNIT_EXPECT_EQ(test, mib->ul_hetrig_su_cnt, 40);
+
+	mt76_test_fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_muru_debug_get(&dev->phy), -EIO);
+	KUNIT_EXPECT_EQ(test, mib->dl_cck_cnt, 100 + 2);
+}
