+/* --- BSS info ------------------------------------------------------------- */
+
+/* RF_CH: primary and center channels and the width (both segments for
+ * 80+80); HE trigger-based uplink is disabled unless we are an HE station.
+ */
+static void mt7915_test_bss_rfch(struct kunit *test)
+{
+	struct cfg80211_chan_def *chandef;
+	struct bss_info_rf_ch *ch;
+	struct mt7915_test_ctx c;
+	struct sk_buff *skb;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	chandef = &c.phy->mt76->chandef;
+
+	skb = mt7915_test_bss_req(test, &c);
+	mt7915_mcu_bss_rfch_tlv(skb, c.vif, c.phy);
+	ch = mt7915_test_skb_tlv(test, skb, BSS_INFO_RF_CH,
+				 struct bss_info_rf_ch);
+	KUNIT_ASSERT_NOT_NULL(test, ch);
+	KUNIT_EXPECT_EQ(test, ch->pri_ch, 36);
+	KUNIT_EXPECT_EQ(test, ch->center_ch0, 42);
+	KUNIT_EXPECT_EQ(test, ch->center_ch1, 0);
+	KUNIT_EXPECT_EQ(test, ch->bw, CMD_CBW_80MHZ);
+	KUNIT_EXPECT_EQ(test, ch->he_all_disable, 1);
+	KUNIT_EXPECT_EQ(test, ch->he_ru26_block, 0);
+
+	chandef->width = NL80211_CHAN_WIDTH_80P80;
+	chandef->center_freq2 = 5775;
+	skb = mt7915_test_bss_req(test, &c);
+	mt7915_mcu_bss_rfch_tlv(skb, c.vif, c.phy);
+	ch = mt7915_test_skb_tlv(test, skb, BSS_INFO_RF_CH,
+				 struct bss_info_rf_ch);
+	KUNIT_ASSERT_NOT_NULL(test, ch);
+	KUNIT_EXPECT_EQ(test, ch->bw, CMD_CBW_8080MHZ);
+	KUNIT_EXPECT_EQ(test, ch->center_ch0, 42);
+	KUNIT_EXPECT_EQ(test, ch->center_ch1, 155);
+
+	/* HE trigger-based uplink is a station thing */
+	c.vif->bss_conf.he_support = true;
+	skb = mt7915_test_bss_req(test, &c);
+	mt7915_mcu_bss_rfch_tlv(skb, c.vif, c.phy);
+	ch = mt7915_test_skb_tlv(test, skb, BSS_INFO_RF_CH,
+				 struct bss_info_rf_ch);
+	KUNIT_ASSERT_NOT_NULL(test, ch);
+	KUNIT_EXPECT_EQ(test, ch->he_all_disable, 1);
+	c.vif->type = NL80211_IFTYPE_STATION;
+	c.vif->bss_conf.he_support = false;
+	skb = mt7915_test_bss_req(test, &c);
+	mt7915_mcu_bss_rfch_tlv(skb, c.vif, c.phy);
+	ch = mt7915_test_skb_tlv(test, skb, BSS_INFO_RF_CH,
+				 struct bss_info_rf_ch);
+	KUNIT_ASSERT_NOT_NULL(test, ch);
+	KUNIT_EXPECT_EQ(test, ch->he_all_disable, 1);
+
+	/* an HE station on a radar channel with no intolerant AP around */
+	c.vif->bss_conf.he_support = true;
+	chandef->chan->flags |= IEEE80211_CHAN_RADAR;
+	skb = mt7915_test_bss_req(test, &c);
+	mt7915_mcu_bss_rfch_tlv(skb, c.vif, c.phy);
+	ch = mt7915_test_skb_tlv(test, skb, BSS_INFO_RF_CH,
+				 struct bss_info_rf_ch);
+	KUNIT_ASSERT_NOT_NULL(test, ch);
+	KUNIT_EXPECT_EQ(test, ch->he_all_disable, 0);
+	KUNIT_EXPECT_EQ(test, ch->he_ru26_block, 0);
+
+	chandef->chan->flags &= ~IEEE80211_CHAN_RADAR;
+	KUNIT_EXPECT_FALSE(test, mt7915_check_he_obss_narrow_bw_ru(
+			   c.phy->mt76->hw, c.vif));
+}
+
+/* An HE station on a radar channel where cfg80211 has seen an AP that
+ * can't tolerate 26-tone RUs (it has no extended capabilities at all) stops
+ * using them; off radar channels, APs are not looked at.
+ */
+static void mt7915_test_bss_rfch_intolerant(struct kunit *test)
+{
+	static const u8 ies[] = { WLAN_EID_SSID, 1, 'x' };
+	struct cfg80211_inform_bss data = {};
+	struct ieee80211_channel *chan;
+	struct bss_info_rf_ch *ch;
+	struct mt7915_test_ctx c;
+	struct cfg80211_bss *bss;
+	struct sk_buff *skb;
+	struct wiphy *wiphy;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_STATION);
+	c.vif->bss_conf.he_support = true;
+	wiphy = c.phy->mt76->hw->wiphy;
+	chan = c.phy->mt76->chandef.chan;
+	chan->flags |= IEEE80211_CHAN_RADAR;
+
+	data.chan = chan;
+	bss = cfg80211_inform_bss_data(wiphy, &data, CFG80211_BSS_FTYPE_BEACON,
+				       mt7915_test_ap_addr, 0,
+				       WLAN_CAPABILITY_ESS, 100, ies,
+				       sizeof(ies), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, bss);
+	cfg80211_put_bss(wiphy, bss);
+
+	skb = mt7915_test_bss_req(test, &c);
+	mt7915_mcu_bss_rfch_tlv(skb, c.vif, c.phy);
+	ch = mt7915_test_skb_tlv(test, skb, BSS_INFO_RF_CH,
+				 struct bss_info_rf_ch);
+	KUNIT_ASSERT_NOT_NULL(test, ch);
+	KUNIT_EXPECT_EQ(test, ch->he_ru26_block, 1);
+	KUNIT_EXPECT_EQ(test, ch->he_all_disable, 0);
+
+	chan->flags &= ~IEEE80211_CHAN_RADAR;
+	skb = mt7915_test_bss_req(test, &c);
+	mt7915_mcu_bss_rfch_tlv(skb, c.vif, c.phy);
+	ch = mt7915_test_skb_tlv(test, skb, BSS_INFO_RF_CH,
+				 struct bss_info_rf_ch);
+	KUNIT_ASSERT_NOT_NULL(test, ch);
+	KUNIT_EXPECT_EQ(test, ch->he_ru26_block, 0);
+}
+
+/* An AP that can't take 26-tone RUs from us (no extended capability bit
+ * 87) makes us stop using them; one that can changes nothing.
+ */
+static void mt7915_test_he_obss_iter(struct kunit *test)
+{
+	struct mt7915_he_obss_narrow_bw_ru_data data;
+	struct cfg80211_bss_ies *ies;
+	struct cfg80211_bss *bss;
+
+	bss = kunit_kzalloc(test, sizeof(*bss), GFP_KERNEL);
+	ies = kunit_kzalloc(test, sizeof(*ies) + 16, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, bss);
+	KUNIT_ASSERT_NOT_NULL(test, ies);
+	RCU_INIT_POINTER(bss->ies, ies);
+
+	/* no extended capabilities */
+	ies->data[0] = WLAN_EID_SSID;
+	ies->data[1] = 0;
+	ies->len = 2;
+	data.tolerated = true;
+	mt7915_check_he_obss_narrow_bw_ru_iter(NULL, bss, &data);
+	KUNIT_EXPECT_FALSE(test, data.tolerated);
+
+	/* too short to have octet 10 */
+	ies->data[0] = WLAN_EID_EXT_CAPABILITY;
+	ies->data[1] = 10;
+	memset(&ies->data[2], 0xff, 10);
+	ies->len = 12;
+	data.tolerated = true;
+	mt7915_check_he_obss_narrow_bw_ru_iter(NULL, bss, &data);
+	KUNIT_EXPECT_FALSE(test, data.tolerated);
+
+	/* octet 10 without the bit */
+	ies->data[1] = 11;
+	ies->data[12] = (u8)~WLAN_EXT_CAPA10_OBSS_NARROW_BW_RU_TOLERANCE_SUPPORT;
+	ies->len = 13;
+	data.tolerated = true;
+	mt7915_check_he_obss_narrow_bw_ru_iter(NULL, bss, &data);
+	KUNIT_EXPECT_FALSE(test, data.tolerated);
+
+	/* with it */
+	ies->data[12] = WLAN_EXT_CAPA10_OBSS_NARROW_BW_RU_TOLERANCE_SUPPORT;
+	data.tolerated = true;
+	mt7915_check_he_obss_narrow_bw_ru_iter(NULL, bss, &data);
+	KUNIT_EXPECT_TRUE(test, data.tolerated);
+
+	/* one intolerant AP is enough */
+	data.tolerated = false;
+	mt7915_check_he_obss_narrow_bw_ru_iter(NULL, bss, &data);
+	KUNIT_EXPECT_FALSE(test, data.tolerated);
+}
