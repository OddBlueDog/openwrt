+/* --- EEPROM, EDCA, RED, airtime, VOW and rates ------------------------- */
+
+/* With the EEPROM in efuse, the firmware is only told to use it. */
+static void mt7915_mcu2_set_eeprom_efuse(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu_eeprom *req;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_eeprom(dev), 0);
+	req = (const void *)mt7915_mcu2_msg(test,
+			MCU_EXT_CMD(EFUSE_BUFFER_MODE), sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, req->buffer_mode, EE_MODE_EFUSE);
+	KUNIT_EXPECT_EQ(test, req->format, EE_FORMAT_WHOLE);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->len), 0);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 1);
+}
+
+/* the EEPROM pages sent: @n pages of 1 KiB, the last one @last bytes */
+static void mt7915_mcu2_expect_eeprom_pages(struct kunit *test,
+					    struct mt7915_dev *dev, int n,
+					    int last)
+{
+	const struct mt7915_mcu_eeprom *req;
+	struct mt76_test_msg *msg;
+	int i, len;
+
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, n);
+	for (i = 0; i < n; i++) {
+		len = i == n - 1 ? last : 1024;
+		msg = mt7915_mcu2_nth(test, i, MCU_EXT_CMD(EFUSE_BUFFER_MODE),
+				      sizeof(*req) + len);
+		req = (const void *)msg->data;
+		KUNIT_EXPECT_EQ(test, req->buffer_mode, EE_MODE_BUFFER);
+		KUNIT_EXPECT_EQ(test, req->format,
+				FIELD_PREP(GENMASK(7, 5), n - 1) |
+				FIELD_PREP(GENMASK(4, 2), i) |
+				EE_FORMAT_WHOLE);
+		KUNIT_EXPECT_EQ(test, le16_to_cpu(req->len), len);
+		KUNIT_EXPECT_EQ(test, memcmp(msg->data + sizeof(*req),
+				(u8 *)dev->mt76.eeprom.data + i * 1024,
+				len), 0);
+	}
+}
+
+static void mt7915_mcu2_fill_eeprom(struct kunit *test, struct mt7915_dev *dev)
+{
+	u8 *eep = mt7915_mcu2_eeprom(test, dev);
+	int i;
+
+	for (i = 0; i < dev->mt76.eeprom.size; i++)
+		eep[i] = i ^ (i >> 8);
+}
+
+/* An EEPROM image from flash goes to the firmware's buffer in 1 KiB pages,
+ * each tagged with its number and the last page's: four on the MT7986.
+ */
+static void mt7915_mcu2_set_eeprom_flash(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+
+	mt7915_mcu2_fill_eeprom(test, dev);
+	dev->flash_mode = true;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_eeprom(dev), 0);
+	mt7915_mcu2_expect_eeprom_pages(test, dev, 4, 1024);
+}
+
+/* The MT7915's 3.5 KiB EEPROM ends in a half page; an error stops the
+ * upload.
+ */
+static void mt7915_mcu2_set_eeprom_flash_mt7915(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+
+	dev->mt76.rev = 0x79150000;
+	mt7915_mcu2_fill_eeprom(test, dev);
+	dev->flash_mode = true;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_eeprom(dev), 0);
+	mt7915_mcu2_expect_eeprom_pages(test, dev, 4, 512);
+
+	mt7915_mcu2_fail_nth(dev, 2);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_eeprom(dev), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 4 + 2);
+	dev->mt76.rev = 0x79860000;
+}
+
+/* Reading the efuse 16 bytes at a time: the block holding @offset, into
+ * the caller's buffer, or else into the EEPROM image at the address the
+ * firmware reports, which has to lie inside the image.
+ */
+static void mt7915_mcu2_get_eeprom(struct kunit *test)
+{
+	struct mt7915_mcu_eeprom_info res = {
+		.addr = cpu_to_le32(0x120),
+		.valid = cpu_to_le32(1),
+	};
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu_eeprom_info *req;
+	u8 zero[16] = {}, buf[16] = {};
+	u8 *eep;
+	int i;
+
+	eep = mt7915_mcu2_eeprom(test, dev);
+	for (i = 0; i < sizeof(res.data); i++)
+		res.data[i] = 0xa0 + i;
+	mt7915_mcu2_reply(test, &res, sizeof(res));
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_get_eeprom(dev, 0x12d, buf), 0);
+	req = (const void *)mt7915_mcu2_msg(test, MCU_EXT_QUERY(EFUSE_ACCESS),
+					    sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->addr), 0x120);
+	KUNIT_EXPECT_EQ(test, memcmp(buf, res.data, 16), 0);
+	KUNIT_EXPECT_EQ(test, memcmp(eep + 0x120, zero, 16), 0);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_get_eeprom(dev, 0x120, NULL), 0);
+	KUNIT_EXPECT_EQ(test, memcmp(eep + 0x120, res.data, 16), 0);
+
+	/* the last block, and one that would run past the image */
+	res.addr = cpu_to_le32(dev->mt76.eeprom.size - 16);
+	mt7915_mcu2_reply(test, &res, sizeof(res));
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_eeprom(dev, 0, NULL), 0);
+	KUNIT_EXPECT_EQ(test, memcmp(eep + dev->mt76.eeprom.size - 16,
+				     res.data, 16), 0);
+	res.addr = cpu_to_le32(dev->mt76.eeprom.size - 15);
+	mt7915_mcu2_reply(test, &res, sizeof(res));
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_eeprom(dev, 0, NULL), -EINVAL);
+	res.addr = cpu_to_le32(0x80000000);
+	mt7915_mcu2_reply(test, &res, sizeof(res));
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_eeprom(dev, 0, NULL), -EINVAL);
+
+	mt76_test_fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_eeprom(dev, 0, buf), -EIO);
+}
+
+/* How many efuse blocks are still free: the reply's first byte. */
+static void mt7915_mcu2_get_eeprom_free_block(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 reply[4] = { 7, 1, 2, 3 }, n = 0;
+	const u8 *req;
+
+	mt7915_mcu2_reply(test, reply, sizeof(reply));
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_get_eeprom_free_block(dev, &n), 0);
+	KUNIT_EXPECT_EQ(test, n, 7);
+	req = mt7915_mcu2_msg(test, MCU_EXT_QUERY(EFUSE_FREE_BLOCK), 4)->data;
+	KUNIT_EXPECT_EQ(test, req[0], 0);
+	KUNIT_EXPECT_EQ(test, req[1], 1);		/* version */
+	KUNIT_EXPECT_EQ(test, req[2], 0);		/* die */
+
+	mt76_test_fake->mcu_ret = -EIO;
+	n = 0;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_eeprom_free_block(dev, &n), -EIO);
+	KUNIT_EXPECT_EQ(test, n, 0);
+}
+
+/* EEPROM replies are read without a length check: a short one (here just
+ * the header) must be refused rather than read past.
+ */
+static void mt7915_mcu2_get_eeprom_short(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+	u8 buf[16], n;
+
+	kunit_skip(test, "driver bug: get_eeprom/get_eeprom_free_block read past a short reply");
+	dev = mt7915_test_dev(test);
+	mt7915_mcu2_eeprom(test, dev);
+	mt7915_mcu2_reply(test, NULL, 0);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_eeprom(dev, 0, buf), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_eeprom_free_block(dev, &n),
+			-EINVAL);
+}
+
+/* WMM parameters go to the firmware's EDCA table per AC: the AC's queue in
+ * the interface's WMM set, AIFS, TXOP, and the contention windows as
+ * exponents (log2(cw + 1)), 15 and 1023 when unset.
+ */
+static void mt7915_mcu2_set_tx(struct kunit *test)
+{
+	static const struct {
+		u8 aifs;
+		u16 cw_min, cw_max, txop;
+		u8 cw_min_exp, cw_max_exp;
+	} params[IEEE80211_NUM_ACS] = {
+		[IEEE80211_AC_VO] = { 2, 3, 7, 47, 2, 3 },
+		[IEEE80211_AC_VI] = { 2, 7, 15, 94, 3, 4 },
+		[IEEE80211_AC_BE] = { 3, 15, 1023, 0, 4, 10 },
+		[IEEE80211_AC_BK] = { 7, 0, 0, 0, 5, 10 },
+	};
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct ieee80211_vif *vif = mt7915_mcu2_vif(test, dev);
+	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
+	const struct mt7915_mcu_tx *req;
+	int ac;
+
+	mvif->mt76.wmm_idx = 1;
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+		mvif->queue_params[ac].aifs = params[ac].aifs;
+		mvif->queue_params[ac].cw_min = params[ac].cw_min;
+		mvif->queue_params[ac].cw_max = params[ac].cw_max;
+		mvif->queue_params[ac].txop = params[ac].txop;
+	}
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_tx(dev, vif), 0);
+	req = (const void *)mt7915_mcu2_msg(test, MCU_EXT_CMD(EDCA_UPDATE),
+					    sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, req->total, IEEE80211_NUM_ACS);
+	KUNIT_EXPECT_EQ(test, req->action, 0);
+	KUNIT_EXPECT_EQ(test, req->valid, 1);
+	KUNIT_EXPECT_EQ(test, req->mode, 1);		/* TX_CMD_MODE */
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+		struct edca e;
+
+		memcpy(&e, (const u8 *)req->edca + ac * sizeof(e), sizeof(e));
+		KUNIT_EXPECT_EQ(test, e.queue, ac + 4);
+		KUNIT_EXPECT_EQ(test, e.set, WMM_PARAM_SET);
+		KUNIT_EXPECT_EQ(test, e.aifs, params[ac].aifs);
+		KUNIT_EXPECT_EQ(test, le16_to_cpu(e.txop), params[ac].txop);
+		KUNIT_EXPECT_EQ(test, e.cw_min, params[ac].cw_min_exp);
+		KUNIT_EXPECT_EQ(test, le16_to_cpu(e.cw_max),
+				params[ac].cw_max_exp);
+	}
+
+	mt76_test_fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_tx(dev, vif), -EIO);
+}
