+
+/* a second radio on band 1, sharing the main radio's ieee80211_hw */
+static struct mt7915_phy *
+mt7915_mcu2_band1_phy(struct kunit *test, struct mt7915_dev *dev)
+{
+	struct mt7915_phy *phy;
+	struct mt76_phy *mphy;
+
