+/* A station's airtime weight becomes its DWRR quantum level per AC (VI and
+ * VO a level or two finer), next to its BSS group and the minimum
+ * bandwidth group, for its WTBL index.
+ */
+static void mt7915_mcu2_vow_sta(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct ieee80211_vif *vif = mt7915_mcu2_vif(test, dev);
+	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
+	const struct mt7915_mcu2_drr *req;
+	struct mt7915_sta *msta;
+
+	mvif->mt76.band_idx = 1;
+	mvif->mt76.omac_idx = 1;
+	msta = (void *)mt7915_mcu2_sta(test, vif, 0x123)->drv_priv;
+
+	req = mt7915_mcu2_drr(test, dev, msta, VOW_DRR_CTRL_STA_ALL, 256);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->action), VOW_DRR_CTRL_STA_ALL);
+	KUNIT_EXPECT_EQ(test, req->wlan_idx_lo, 0x23);
+	KUNIT_EXPECT_EQ(test, req->wlan_idx_hi, 0x1);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->com_value),
+			5 | 3 << 8 | 3 << 12 | 2 << 16 | 1 << 20 | 40 << 24);
+
+	req = mt7915_mcu2_drr(test, dev, msta, VOW_DRR_CTRL_STA_ALL, 1024);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->com_value),
+			5 | 5 << 8 | 5 << 12 | 4 << 16 | 3 << 20 | 40 << 24);
+
+	/* pausing is a station command with no value: not paused */
+	req = mt7915_mcu2_drr(test, dev, msta, VOW_DRR_CTRL_STA_PAUSE, 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->action),
+			VOW_DRR_CTRL_STA_PAUSE);
+	KUNIT_EXPECT_EQ(test, req->wlan_idx_lo, 0x23);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->com_value), 0);
+
+	mt76_test_fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_vow_drr_ctrl(dev, msta,
+			VOW_DRR_CTRL_STA_ALL, 256), -EIO);
+}
