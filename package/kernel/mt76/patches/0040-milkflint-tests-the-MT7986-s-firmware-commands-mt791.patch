+/* Implicit 160 MHz VHT beamforming is meant to use a single implicit row
+ * (bfer_vht sets ibf_nrow = 1), but bfer_tlv overwrites it with tx_ant.
+ */
+static void mt7915_test_bfer_vht_160_ibf(struct kunit *test)
+{
+	struct mt7915_test_ctx c;
+	struct sta_rec_bf *bf;
+
+	kunit_skip(test, "driver bug: 160 MHz iBF ibf_nrow = 1 is overwritten by tx_ant");
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_ht(c.sta);
+	mt7915_test_vht(c.sta);
+	c.mvif->cap.vht_su_ebfer = false;
+	c.dev->ibf = true;
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_160;
