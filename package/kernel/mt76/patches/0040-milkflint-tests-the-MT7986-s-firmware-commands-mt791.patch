+/* RX airtime accounting: the counters are cleared, then counting starts. */
+static void mt7915_mcu2_rx_airtime(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	int cmd = MCU_EXT_CMD(RX_AIRTIME_CTRL);
+	const struct mt7915_mcu2_airtime *req;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_init_rx_airtime(dev), 0);
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 2);
+	req = (const void *)mt7915_mcu2_nth(test, 0, cmd, sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->field), 2);	/* bitwise */
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->sub_field), 1);
+	KUNIT_EXPECT_EQ(test, req->airtime_clear, 1);
+	KUNIT_EXPECT_EQ(test, req->airtime_en, 0);
+	req = (const void *)mt7915_mcu2_nth(test, 1, cmd, sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->field), 1);	/* feature */
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->sub_field), 1);
+	KUNIT_EXPECT_EQ(test, req->airtime_en, 1);
+	KUNIT_EXPECT_EQ(test, req->mibtime_en, 0);
+
+	mt7915_mcu2_fail_nth(dev, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_init_rx_airtime(dev), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 3);
+	mt7915_mcu2_fail_nth(dev, 2);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_init_rx_airtime(dev), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 5);
+}
