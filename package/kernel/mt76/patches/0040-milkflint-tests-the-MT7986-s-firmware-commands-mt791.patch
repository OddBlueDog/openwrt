+/* An HE AP coming up: the OMAC TLV first, then basic, channel, bmc rate, RA,
+ * A-MSDU and HE TLVs in one BSS_INFO_UPDATE for the vif's BSS index.
+ */
+static void mt7915_test_add_bss_info_ap(struct kunit *test)
+{
+	static const u16 order[] = {
+		BSS_INFO_OMAC, BSS_INFO_BASIC, BSS_INFO_RF_CH,
+		BSS_INFO_BMC_RATE, BSS_INFO_RA, BSS_INFO_HW_AMSDU,
+		BSS_INFO_HE_BASIC,
+	};
+	struct bss_info_basic *basic;
+	struct bss_info_omac *omac;
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+	struct sta_req_hdr *hdr;
+	u16 tags[16];
+	int i, n;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	c.vif->bss_conf.he_support = true;
+	c.mvif->mt76.idx = 3;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_bss_info(c.phy, c.vif, true), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 1);
+	msg = mt76_test_msg(c.fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(BSS_INFO_UPDATE));
+	hdr = mt7915_test_payload(msg, struct sta_req_hdr);
+	KUNIT_ASSERT_NOT_NULL(test, hdr);
+	KUNIT_EXPECT_EQ(test, hdr->bss_idx, 3);
+	KUNIT_EXPECT_EQ(test, hdr->is_tlv_append, 1);
+
+	n = mt7915_test_tags(test, msg, tags, ARRAY_SIZE(tags));
+	KUNIT_ASSERT_EQ(test, n, (int)ARRAY_SIZE(order));
+	for (i = 0; i < n; i++)
+		KUNIT_EXPECT_EQ_MSG(test, tags[i], order[i], "TLV %d", i);
+
+	omac = mt7915_test_tlv(test, msg, BSS_INFO_OMAC, struct bss_info_omac);
+	KUNIT_ASSERT_NOT_NULL(test, omac);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(omac->conn_type),
+			CONNECTION_INFRA_AP);
+	KUNIT_EXPECT_EQ(test, omac->omac_idx, HW_BSSID_0);
+
+	basic = mt7915_test_tlv(test, msg, BSS_INFO_BASIC,
+				struct bss_info_basic);
+	KUNIT_ASSERT_NOT_NULL(test, basic);
+	KUNIT_EXPECT_EQ(test, basic->active, 1);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(basic->network_type), NETWORK_INFRA);
+	KUNIT_EXPECT_EQ(test, basic->bmc_wcid_lo, MT7915_TEST_VIF_WCID & 0xff);
+	KUNIT_EXPECT_EQ(test, basic->bmc_wcid_hi, MT7915_TEST_VIF_WCID >> 8);
+	KUNIT_EXPECT_MEMEQ(test, basic->bssid, mt7915_test_own_addr, ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->bcn_interval), 100);
+	KUNIT_EXPECT_EQ(test, basic->dtim_period, 2);
+	KUNIT_EXPECT_EQ(test, basic->phy_mode, PHY_MODE_A | PHY_MODE_AN |
+			PHY_MODE_AC | PHY_MODE_AX_5G);
+
+	/* the error comes back */
+	c.fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_bss_info(c.phy, c.vif, true),
+			-EIO);
+}
