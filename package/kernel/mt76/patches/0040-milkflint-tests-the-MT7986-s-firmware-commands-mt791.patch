+/* An own MAC address entry going active or away; repeaters use MUAR
+ * entries instead.
+ */
+static void mt7915_test_add_dev_info(struct kunit *test)
+{
+	struct mt7915_test_dev_info *req;
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	c.mvif->mt76.omac_idx = EXT_BSSID_1;
+	c.mvif->mt76.band_idx = 1;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_dev_info(c.phy, c.vif, true), 0);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_dev_info(c.phy, c.vif, false), 0);
+	msg = mt76_test_msg(c.fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(DEV_INFO_UPDATE));
+	KUNIT_EXPECT_EQ(test, msg->len, (int)sizeof(*req));
+	req = mt7915_test_payload(msg, struct mt7915_test_dev_info);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->omac_idx, EXT_BSSID_1);
+	KUNIT_EXPECT_EQ(test, req->band_idx, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->tlv_num), 1);
+	KUNIT_EXPECT_EQ(test, req->is_tlv_append, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->tag), DEV_INFO_ACTIVE);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->len), 12);
+	KUNIT_EXPECT_EQ(test, req->active, 1);
+	KUNIT_EXPECT_EQ(test, req->tlv_band_idx, 1);
+	KUNIT_EXPECT_MEMEQ(test, req->omac_addr, mt7915_test_own_addr,
+			   ETH_ALEN);
+	req = mt7915_test_payload(mt76_test_msg(c.fake, 1),
+				  struct mt7915_test_dev_info);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->active, 0);
+
+	c.mvif->mt76.omac_idx = REPEATER_BSSID_START;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_dev_info(c.phy, c.vif, true), 0);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 3);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(c.fake, 2)->cmd,
+			MCU_EXT_CMD(MUAR_UPDATE));
+}
+
+/* --- beacons and in-band discovery ---------------------------------------- */
+
+/* a BSS_INFO_UPDATE payload with an empty BSS_INFO_OFFLOAD TLV, as
+ * mt7915_mcu_add_beacon() starts one
+ */
+static struct sk_buff *mt7915_test_bcn_req(struct kunit *test,
+					   struct mt7915_test_ctx *c,
+					   struct bss_info_bcn **bcn)
+{
+	struct sk_buff *skb;
+
+	skb = __mt76_connac_mcu_alloc_sta_req(&c->dev->mt76, &c->mvif->mt76,
+					      NULL,
+					      MT7915_MAX_BSS_OFFLOAD_SIZE);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(skb));
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_kfree_skb, skb), 0);
+	*bcn = (struct bss_info_bcn *)mt76_connac_mcu_add_tlv(skb,
+			BSS_INFO_OFFLOAD, sizeof(**bcn));
+	(*bcn)->enable = true;
+
+	return skb;
+}
+
+#define MT7915_TEST_BCN_HDR	\
+	offsetof(struct ieee80211_mgmt, u.beacon.variable)
+
+/* a beacon of @c's vif carrying @ies */
+static struct sk_buff *mt7915_test_beacon(struct kunit *test,
+					  struct mt7915_test_ctx *c,
+					  const u8 *ies, int len)
+{
+	struct ieee80211_mgmt *mgmt;
+	struct sk_buff *skb;
+
+	skb = alloc_skb(MT7915_TEST_BCN_HDR + len, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_kfree_skb, skb), 0);
+	mgmt = skb_put_zero(skb, MT7915_TEST_BCN_HDR);
+	mgmt->frame_control = cpu_to_le16(IEEE80211_FTYPE_MGMT |
+					  IEEE80211_STYPE_BEACON);
+	eth_broadcast_addr(mgmt->da);
+	ether_addr_copy(mgmt->sa, c->vif->addr);
+	ether_addr_copy(mgmt->bssid, c->vif->addr);
+	mgmt->u.beacon.beacon_int = cpu_to_le16(100);
+	skb_put_data(skb, ies, len);
+	IEEE80211_SKB_CB(skb)->control.vif = c->vif;
+
+	return skb;
+}
+
+/* A running countdown goes to firmware as a CSA or color change sub-TLV
+ * with the counter's current value; none without a counter.
+ */
+static void mt7915_test_beacon_cntdwn(struct kunit *test)
+{
+	static const u8 ies[] = { WLAN_EID_CHANNEL_SWITCH, 3, 1, 40, 7 };
+	struct ieee80211_mutable_offsets offs = {};
+	struct bss_info_bcn_cntdwn *info;
+	struct bss_info_bcn *bcn;
+	struct mt7915_test_ctx c;
+	struct sk_buff *rskb, *skb;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	skb = mt7915_test_beacon(test, &c, ies, sizeof(ies));
+
+	rskb = mt7915_test_bcn_req(test, &c, &bcn);
+	mt7915_mcu_beacon_cntdwn(c.vif, rskb, skb, bcn, &offs);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(bcn->sub_ntlv), 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(bcn->len), (int)sizeof(*bcn));
+
+	offs.cntdwn_counter_offs[0] = MT7915_TEST_BCN_HDR + 4;
+	c.vif->bss_conf.csa_active = true;
+	rskb = mt7915_test_bcn_req(test, &c, &bcn);
+	mt7915_mcu_beacon_cntdwn(c.vif, rskb, skb, bcn, &offs);
+	info = mt7915_test_skb_bcn(test, rskb, BSS_INFO_BCN_CSA,
+				   struct bss_info_bcn_cntdwn);
+	KUNIT_ASSERT_NOT_NULL(test, info);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(info->len), (int)sizeof(*info));
+	KUNIT_EXPECT_EQ(test, info->cnt, 7);
+
+	c.vif->bss_conf.csa_active = false;
+	c.vif->bss_conf.color_change_active = true;
+	rskb = mt7915_test_bcn_req(test, &c, &bcn);
+	mt7915_mcu_beacon_cntdwn(c.vif, rskb, skb, bcn, &offs);
+	KUNIT_EXPECT_NULL(test, mt7915_test_skb_bcn(test, rskb,
+			  BSS_INFO_BCN_CSA, struct bss_info_bcn_cntdwn));
+	info = mt7915_test_skb_bcn(test, rskb, BSS_INFO_BCN_BCC,
+				   struct bss_info_bcn_cntdwn);
+	KUNIT_ASSERT_NOT_NULL(test, info);
+	KUNIT_EXPECT_EQ(test, info->cnt, 7);
+}
+
+/*
+ * Beacon IEs: an SSID, then three Multiple BSSID elements. Of their
+ * profiles, only those with a valid non-transmitted BSSID index count:
+ * index 1 (its index IE at 14), index 3 (at 45) and index 31 (at 73).
+ * Skipped: index 0, an element too short, a non-profile subelement, a
+ * profile too short, index 40, a profile without an index and one with a
+ * truncated index.
+ */
+static const u8 mt7915_test_mbss_ies[] = {
+	WLAN_EID_SSID, 0,
+	/* 2 */
+	WLAN_EID_MULTIPLE_BSSID, 22, 2,
+	0, 12,
+		WLAN_EID_NON_TX_BSSID_CAP, 2, 0x01, 0x04,
+		WLAN_EID_SSID, 1, 'a',
+		WLAN_EID_MULTI_BSSID_IDX, 3, 1, 1, 0,	/* 14 */
+	0, 5,
+		WLAN_EID_MULTI_BSSID_IDX, 3, 0, 1, 0,
+	/* 26 */
+	WLAN_EID_MULTIPLE_BSSID, 1, 2,
+	/* 29 */
+	WLAN_EID_MULTIPLE_BSSID, 47, 2,
+	1, 4, WLAN_EID_MULTI_BSSID_IDX, 2, 3, 0,
+	0, 3, WLAN_EID_SSID, 1, 'b',
+	0, 7,
+		WLAN_EID_MULTI_BSSID_IDX, 3, 3, 1, 0,	/* 45 */
+		WLAN_EID_SSID, 0,
+	0, 5,
+		WLAN_EID_MULTI_BSSID_IDX, 3, 40, 1, 0,
+	0, 4,
+		WLAN_EID_SSID, 2, 'c', 'd',
+	0, 4,
+		WLAN_EID_MULTI_BSSID_IDX, 1, 5, 0,
+	0, 5,
+		WLAN_EID_MULTI_BSSID_IDX, 3, 31, 1, 0,	/* 73 */
+};
+
+/* For a multiple BSSID set, firmware gets where each valid non-transmitted
+ * profile's index IE sits in the beacon, and a bitmap of those indexes.
+ */
+static void mt7915_test_beacon_mbss(struct kunit *test)
+{
+	struct ieee80211_mutable_offsets offs = {
+		.tim_offset = 60,
+		.mbssid_off = MT7915_TEST_BCN_HDR + 2,
+	};
+	struct bss_info_bcn_mbss *mbss;
+	struct bss_info_bcn *bcn;
+	struct mt7915_test_ctx c;
+	struct sk_buff *rskb, *skb;
+	int i;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	skb = mt7915_test_beacon(test, &c, mt7915_test_mbss_ies,
+				 sizeof(mt7915_test_mbss_ies));
+
+	rskb = mt7915_test_bcn_req(test, &c, &bcn);
+	mt7915_mcu_beacon_mbss(rskb, skb, c.vif, bcn, &offs);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(bcn->sub_ntlv), 0);
+
+	c.vif->bss_conf.bssid_indicator = 2;
+	rskb = mt7915_test_bcn_req(test, &c, &bcn);
+	mt7915_mcu_beacon_mbss(rskb, skb, c.vif, bcn, &offs);
+	mbss = mt7915_test_skb_bcn(test, rskb, BSS_INFO_BCN_MBSSID,
+				   struct bss_info_bcn_mbss);
+	KUNIT_ASSERT_NOT_NULL(test, mbss);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(mbss->len), (int)sizeof(*mbss));
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(mbss->bitmap),
+			BIT(0) | BIT(1) | BIT(3) | BIT(31));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(mbss->offset[0]), 60);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(mbss->offset[1]),
+			MT7915_TEST_BCN_HDR + 14);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(mbss->offset[3]),
+			MT7915_TEST_BCN_HDR + 45);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(mbss->offset[31]),
+			MT7915_TEST_BCN_HDR + 73);
+	for (i = 4; i < 31; i++)
+		KUNIT_EXPECT_EQ(test, le16_to_cpu(mbss->offset[i]), 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(mbss->offset[2]), 0);
+}
+
+/* The beacon content sub-TLV: padded to 4 bytes, the frame behind its TXD
+ * (firmware-queued on the beacon queue), and the TIM, CSA and color change
+ * counter offsets.
+ */
+static void mt7915_test_beacon_cont(struct kunit *test)
+{
+	static const u8 ies[] = { WLAN_EID_SSID, 1, 'x' };
+	static const u8 ssid2[] = { WLAN_EID_SSID, 2, 'a', 'b' };
+	struct ieee80211_mutable_offsets offs = {
+		.tim_offset = 50,
+	};
+	struct bss_info_bcn_cont *cont;
+	struct bss_info_bcn *bcn;
+	struct mt7915_test_ctx c;
+	struct sk_buff *rskb, *skb;
+	__le32 *txwi;
+	u32 val;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	c.mvif->mt76.omac_idx = EXT_BSSID_1;
+	skb = mt7915_test_beacon(test, &c, ies, sizeof(ies));
+
+	rskb = mt7915_test_bcn_req(test, &c, &bcn);
+	mt7915_mcu_beacon_cont(c.dev, c.vif, rskb, skb, bcn, &offs);
+	cont = mt7915_test_skb_bcn(test, rskb, BSS_INFO_BCN_CONTENT,
+				   struct bss_info_bcn_cont);
+	KUNIT_ASSERT_NOT_NULL(test, cont);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(cont->len),
+			(int)ALIGN(sizeof(*cont) + MT_TXD_SIZE + skb->len, 4));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(cont->pkt_len),
+			MT_TXD_SIZE + skb->len);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(cont->tim_ofs), 50);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(cont->csa_ofs), 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(cont->bcc_ofs), 0);
+
+	txwi = (__le32 *)(cont + 1);
+	val = le32_to_cpu(txwi[0]);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_TX_BYTES, val),
+			MT_TXD_SIZE + skb->len);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_PKT_FMT, val), MT_TX_TYPE_FW);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD0_Q_IDX, val), MT_LMAC_BCN0);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(MT_TXD1_OWN_MAC, le32_to_cpu(txwi[1])),
+			EXT_BSSID_1);
+	KUNIT_EXPECT_MEMEQ(test, (u8 *)txwi + MT_TXD_SIZE, skb->data,
+			   skb->len);
+
+	/* a frame that needs no padding gets none */
+	skb = mt7915_test_beacon(test, &c, ssid2, sizeof(ssid2));
+	rskb = mt7915_test_bcn_req(test, &c, &bcn);
+	mt7915_mcu_beacon_cont(c.dev, c.vif, rskb, skb, bcn, &offs);
+	cont = mt7915_test_skb_bcn(test, rskb, BSS_INFO_BCN_CONTENT,
+				   struct bss_info_bcn_cont);
+	KUNIT_ASSERT_NOT_NULL(test, cont);
+	KUNIT_EXPECT_EQ(test, sizeof(*cont) + MT_TXD_SIZE + skb->len, 84);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(cont->len), 84);
+
+	/* countdowns: CSA counter 4 and color change counter 3 bytes in */
+	offs.cntdwn_counter_offs[0] = 80;
+	c.vif->bss_conf.csa_active = true;
+	rskb = mt7915_test_bcn_req(test, &c, &bcn);
+	mt7915_mcu_beacon_cont(c.dev, c.vif, rskb, skb, bcn, &offs);
+	cont = mt7915_test_skb_bcn(test, rskb, BSS_INFO_BCN_CONTENT,
+				   struct bss_info_bcn_cont);
+	KUNIT_ASSERT_NOT_NULL(test, cont);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(cont->csa_ofs), 76);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(cont->bcc_ofs), 0);
+
+	c.vif->bss_conf.csa_active = false;
+	c.vif->bss_conf.color_change_active = true;
+	rskb = mt7915_test_bcn_req(test, &c, &bcn);
+	mt7915_mcu_beacon_cont(c.dev, c.vif, rskb, skb, bcn, &offs);
+	cont = mt7915_test_skb_bcn(test, rskb, BSS_INFO_BCN_CONTENT,
+				   struct bss_info_bcn_cont);
+	KUNIT_ASSERT_NOT_NULL(test, cont);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(cont->csa_ofs), 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(cont->bcc_ofs), 77);
+}
