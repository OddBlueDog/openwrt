+/* A firmware error on the record stops before the VOW group; one on the
+ * group doesn't fail the station. No memory: -ENOMEM, nothing sent.
+ */
+static void mt7915_test_add_sta_errors(struct kunit *test)
+{
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_fail_at(test, c.dev, 0, -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_sta(c.dev, c.vif, c.sta,
+			CONN_STATE_CONNECT, true), -EIO);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 1);
+
+	mt7915_test_fail_at(test, c.dev, 1, -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_sta(c.dev, c.vif, c.sta,
+			CONN_STATE_CONNECT, true), 0);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 3);
+
+	mt7915_test_nomem_after(test, c.dev, 0);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_sta(c.dev, c.vif, c.sta,
+			CONN_STATE_CONNECT, true), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 3);
+}
