+			MT_PHY_TYPE_VHT, 10, 0, 0, 0, 0), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_HT, 32, 0, 0, 0, 0), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_HE_SU, 0, 8, 0, 0, 0), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_HE_SU, 0, 7, 0, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.nss, 8);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			5, 0, 0, 0, 0, 0), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_EHT_SU, 0, 0, 0, 0, 0), -EINVAL);
