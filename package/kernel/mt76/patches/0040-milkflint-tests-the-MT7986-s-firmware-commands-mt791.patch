+/* A firmware error on either BA message is returned, and stops there. */
+static void mt7915_test_add_ba_errors(struct kunit *test)
+{
+	struct ieee80211_ampdu_params params = { .tid = 1, .buf_size = 64 };
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	params.sta = c.sta;
+	mt7915_test_fail_at(test, c.dev, 0, -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_tx_ba(c.dev, &params, true), -EIO);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 1);
+	mt7915_test_fail_at(test, c.dev, 1, -EIO);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_rx_ba(c.dev, &params, true), -EIO);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 3);
+}
