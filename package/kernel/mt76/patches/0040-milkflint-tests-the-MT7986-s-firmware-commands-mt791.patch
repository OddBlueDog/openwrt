+/* Without scene detection the driver programs spatial reuse itself: SR on
+ * with tx, PD thresholds from the AP's offsets, SR prohibition in HE-SIG-A
+ * for this BSS and the SRG color/BSSID bitmaps of the band.
+ */
+static void mt7915_test_obss_spr_manual(struct kunit *test)
+{
+	struct ieee80211_he_obss_pd pd = {
+		.enable = true,
+		.sr_ctrl = IEEE80211_HE_SPR_NON_SRG_OFFSET_PRESENT |
+			   IEEE80211_HE_SPR_SRG_INFORMATION_PRESENT |
+			   IEEE80211_HE_SPR_HESIGA_SR_VAL15_ALLOWED,
+		.non_srg_max_offset = 10,
+		.max_offset = 20,
+		.bss_color_bitmap = { 1, 2, 3, 4, 5, 6, 7, 8 },
+		.partial_bssid_bitmap = { 9, 10, 11, 12, 13, 14, 15, 16 },
+	};
+	struct mt7915_test_spr_bitmap *bm;
+	struct mt7915_test_spr_siga *siga;
+	struct mt7915_test_spr_pd *req;
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+	int i;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_scene_detect(test, false);
+	c.phy->mt76->band_idx = 1;
+	c.mvif->mt76.omac_idx = MT7915_TEST_EXT_BSSID(3);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 8);
+	mt7915_test_expect_spr(test, c.fake, 0, SPR_ENABLE_SD, 0, 1);
+	mt7915_test_expect_spr(test, c.fake, 1, SPR_ENABLE, 1, 1);
+	mt7915_test_expect_spr(test, c.fake, 2, SPR_ENABLE_TX, 1, 1);
+	mt7915_test_expect_spr(test, c.fake, 3, SPR_ENABLE_DPD, 0, 1);
+
+	msg = mt76_test_msg(c.fake, 4);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_SPR));
+	KUNIT_EXPECT_EQ(test, msg->len, (int)sizeof(*req));
+	req = mt7915_test_payload(msg, struct mt7915_test_spr_pd);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->ctrl.action, SPR_SET_PARAM);
+	KUNIT_EXPECT_EQ(test, req->ctrl.argnum, 9);
+	KUNIT_EXPECT_EQ(test, req->ctrl.band_idx, 1);
+	KUNIT_EXPECT_EQ(test, req->pd_th_non_srg, 82 - 10);
+	KUNIT_EXPECT_EQ(test, req->pd_th_srg, 82 - 20);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->obss_pd_min), 82);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->obss_pd_min_srg), 82);
+	KUNIT_EXPECT_EQ(test, req->txpwr_restrict_mode, 2);
+	KUNIT_EXPECT_EQ(test, req->txpwr_ref, 21);
+
+	mt7915_test_expect_spr(test, c.fake, 5, SPR_ENABLE_MODE, 0, 1);
+
+	msg = mt76_test_msg(c.fake, 6);
+	KUNIT_EXPECT_EQ(test, msg->len, (int)sizeof(*siga));
+	siga = mt7915_test_payload(msg, struct mt7915_test_spr_siga);
+	KUNIT_ASSERT_NOT_NULL(test, siga);
+	KUNIT_EXPECT_EQ(test, siga->ctrl.action, SPR_SET_SIGA);
+	KUNIT_EXPECT_EQ(test, siga->ctrl.argnum, 1);
+	KUNIT_EXPECT_EQ(test, siga->ctrl.band_idx, 1);
+	/* extended BSSes follow the four hardware ones */
+	KUNIT_EXPECT_EQ(test, siga->omac, MT7915_TEST_EXT_BSSID(3) - 12);
+	for (i = 0; i < ARRAY_SIZE(siga->flag); i++)
+		KUNIT_EXPECT_EQ(test, siga->flag[i],
+				i == MT7915_TEST_EXT_BSSID(3) - 12 ? 0xf : 0);
+
+	msg = mt76_test_msg(c.fake, 7);
+	KUNIT_EXPECT_EQ(test, msg->len, (int)sizeof(*bm));
+	bm = mt7915_test_payload(msg, struct mt7915_test_spr_bitmap);
+	KUNIT_ASSERT_NOT_NULL(test, bm);
+	KUNIT_EXPECT_EQ(test, bm->ctrl.action, SPR_SET_SRG_BITMAP);
+	KUNIT_EXPECT_EQ(test, bm->ctrl.argnum, 4);
+	KUNIT_EXPECT_EQ(test, bm->ctrl.band_idx, 1);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(bm->color_l[0]), 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(bm->color_l[1]), 0x04030201);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(bm->color_h[1]), 0x08070605);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(bm->bssid_l[1]), 0x0c0b0a09);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(bm->bssid_h[1]), 0x100f0e0d);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(bm->bssid_h[0]), 0);
+
+	/* spatial reuse off: detection and SR disabled, nothing more */
+	pd.enable = false;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 10);
+	mt7915_test_expect_spr(test, c.fake, 8, SPR_ENABLE_SD, 0, 1);
+	mt7915_test_expect_spr(test, c.fake, 9, SPR_ENABLE, 0, 1);
+}
