+/* --- rate helpers --------------------------------------------------------- */
+
+/* The highest stream with any MCS, counted from 0, is what firmware takes as
+ * the station's stream count; holes below it don't lower it.
+ */
+static void mt7915_test_sta_nss(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_sta_nss(0xffff), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_sta_nss(0xfffc), 0);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_sta_nss(0xfffa), 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_sta_nss(0xffc3), 2);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_sta_nss(0xcfff), 6);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_sta_nss(0x5555), 7);
+}
+
+/* A station's HE MCS map is clipped stream by stream to the vif's bitrate
+ * mask, for at most four streams and no more than its rx_nss.
+ */
+static void mt7915_test_sta_he_mcs(struct kunit *test)
+{
+	struct mt7915_test_ctx c;
+	__le16 out;
+	u16 *mask;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mask = c.mvif->bitrate_mask.control[NL80211_BAND_5GHZ].he_mcs;
+
+	/* 0-7, 0-9, 0-11, none: an open mask keeps all of it */
+	c.sta->deflink.rx_nss = 4;
+	mt7915_mcu_set_sta_he_mcs(c.sta, &out, 0xffe4);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out), 0xffe4);
+
+	/* the mask lowers stream 2 to 0-7 and stream 3 to 0-9 */
+	mask[1] = GENMASK(7, 0);
+	mask[2] = GENMASK(9, 0);
+	mt7915_mcu_set_sta_he_mcs(c.sta, &out, 0xffe4);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out), 0xffd0);
+	mask[2] = GENMASK(11, 0);
+	mt7915_mcu_set_sta_he_mcs(c.sta, &out, 0xffe4);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out), 0xffe0);
+
+	/* a stream with nothing left of it is not supported */
+	mask[0] = 0;
+	mt7915_mcu_set_sta_he_mcs(c.sta, &out, 0xffe4);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out), 0xffe3);
+
+	/* streams beyond rx_nss are left as they are */
+	c.sta->deflink.rx_nss = 1;
+	mt7915_mcu_set_sta_he_mcs(c.sta, &out, 0xffe4);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out), 0xffe7);
+
+	/* and so is everything past the fourth stream */
+	mask[0] = mask[1] = mask[2] = 0xffff;
+	mask[3] = GENMASK(7, 0);
+	mask[4] = 0;
+	c.sta->deflink.rx_nss = 8;
+	mt7915_mcu_set_sta_he_mcs(c.sta, &out, 0xfea4);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out), 0xfe24);
+	/* three streams: the fourth one is not looked at */
+	c.sta->deflink.rx_nss = 3;
+	mt7915_mcu_set_sta_he_mcs(c.sta, &out, 0xfea4);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out), 0xfea4);
+}
+
+/* The VHT MCS bitmaps of a station: what its map supports, masked, per
+ * stream up to its rx_nss (at most four).
+ */
+static void mt7915_test_sta_vht_mcs(struct kunit *test)
+{
+	static const u16 mask[NL80211_VHT_NSS_MAX] = {
+		0xffff, GENMASK(7, 0), 0xffff, 0xffff,
+		0xffff, 0xffff, 0xffff, 0xffff,
+	};
+	struct mt7915_test_ctx c;
+	__le16 out[8];
+	int i;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	/* 0-9, 0-8, 0-7, none */
+	c.sta->deflink.vht_cap.vht_mcs.rx_mcs_map = cpu_to_le16(0xffc6);
+
+	for (i = 0; i < ARRAY_SIZE(out); i++)
+		out[i] = cpu_to_le16(0x1234);
+	c.sta->deflink.rx_nss = 6;
+	mt7915_mcu_set_sta_vht_mcs(c.sta, out, mask);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out[0]), GENMASK(9, 0));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out[1]), GENMASK(7, 0));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out[2]), GENMASK(7, 0));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out[3]), 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out[4]), 0x1234);
+
+	out[1] = cpu_to_le16(0x1234);
+	c.sta->deflink.rx_nss = 1;
+	mt7915_mcu_set_sta_vht_mcs(c.sta, out, mask);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out[0]), GENMASK(9, 0));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out[1]), 0x1234);
+
+	out[3] = cpu_to_le16(0x1234);
+	c.sta->deflink.rx_nss = 3;
+	mt7915_mcu_set_sta_vht_mcs(c.sta, out, mask);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out[2]), GENMASK(7, 0));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(out[3]), 0x1234);
+}
+
+/* HT MCS bitmaps: the station's rx mask under the vif's mask, per stream up
+ * to its rx_nss (at most four).
+ */
+static void mt7915_test_sta_ht_mcs(struct kunit *test)
+{
+	static const u8 mask[IEEE80211_HT_MCS_MASK_LEN] = {
+		0xff, 0x3c, 0xff, 0x00, 0xff,
+	};
+	struct mt7915_test_ctx c;
+	u8 out[8];
+
+	mt7915_test_init(test, &c, NL80211_BAND_2GHZ, NL80211_IFTYPE_AP);
+	c.sta->deflink.ht_cap.mcs.rx_mask[0] = 0xff;
+	c.sta->deflink.ht_cap.mcs.rx_mask[1] = 0xff;
+	c.sta->deflink.ht_cap.mcs.rx_mask[2] = 0x0f;
+	c.sta->deflink.ht_cap.mcs.rx_mask[3] = 0xff;
+	c.sta->deflink.ht_cap.mcs.rx_mask[4] = 0xff;
+
+	memset(out, 0x55, sizeof(out));
+	c.sta->deflink.rx_nss = 9;
+	mt7915_mcu_set_sta_ht_mcs(c.sta, out, mask);
+	KUNIT_EXPECT_EQ(test, out[0], 0xff);
+	KUNIT_EXPECT_EQ(test, out[1], 0x3c);
+	KUNIT_EXPECT_EQ(test, out[2], 0x0f);
+	KUNIT_EXPECT_EQ(test, out[3], 0x00);
+	KUNIT_EXPECT_EQ(test, out[4], 0x55);
+
+	memset(out, 0x55, sizeof(out));
+	c.sta->deflink.rx_nss = 2;
+	mt7915_mcu_set_sta_ht_mcs(c.sta, out, mask);
+	KUNIT_EXPECT_EQ(test, out[1], 0x3c);
+	KUNIT_EXPECT_EQ(test, out[2], 0x55);
+
+	memset(out, 0x55, sizeof(out));
+	c.sta->deflink.rx_nss = 3;
+	mt7915_mcu_set_sta_ht_mcs(c.sta, out, mask);
+	KUNIT_EXPECT_EQ(test, out[2], 0x0f);
+	KUNIT_EXPECT_EQ(test, out[3], 0x55);
+}
