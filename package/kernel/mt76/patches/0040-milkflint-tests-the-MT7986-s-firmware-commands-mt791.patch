+struct mt7915_test_muar {
+	u8 mode;
+	u8 force_clear;
+	u8 clear_bitmap[8];
+	u8 entry_count;
+	u8 write;
+	u8 band;
+	u8 index;
+	u8 bssid;
+	u8 addr[ETH_ALEN];
+} __packed;
+
+/* A repeater (omac 0x20 and up) owns two MUAR entries, its address and its
+ * BSSID; the table stays on while any repeater entry is in use.
+ */
+static void mt7915_test_muar_config(struct kunit *test)
+{
+	struct mt7915_test_muar *req;
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_STATION);
+	c.phy->mt76->band_idx = 1;
+	c.mvif->mt76.omac_idx = REPEATER_BSSID_START + 3;
+	c.phy->omac_mask = BIT_ULL(REPEATER_BSSID_START + 3);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_muar_config(c.phy, c.vif, false,
+			true), 0);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_muar_config(c.phy, c.vif, true,
+			true), 0);
+	msg = mt76_test_msg(c.fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(MUAR_UPDATE));
+	KUNIT_EXPECT_EQ(test, msg->len, (int)sizeof(*req));
+	req = mt7915_test_payload(msg, struct mt7915_test_muar);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->mode, 1);
+	KUNIT_EXPECT_EQ(test, req->entry_count, 1);
+	KUNIT_EXPECT_EQ(test, req->write, 1);
+	KUNIT_EXPECT_EQ(test, req->band, 1);
+	KUNIT_EXPECT_EQ(test, req->index, 6);
+	KUNIT_EXPECT_MEMEQ(test, req->addr, mt7915_test_own_addr, ETH_ALEN);
+	req = mt7915_test_payload(mt76_test_msg(c.fake, 1),
+				  struct mt7915_test_muar);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->index, 7);
+	KUNIT_EXPECT_MEMEQ(test, req->addr, mt7915_test_ap_addr, ETH_ALEN);
+
+	/* the last repeater going away turns the table off */
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_muar_config(c.phy, c.vif, false,
+			false), 0);
+	req = mt7915_test_payload(mt76_test_msg(c.fake, 2),
+				  struct mt7915_test_muar);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->mode, 0);
+	KUNIT_EXPECT_TRUE(test, is_zero_ether_addr(req->addr));
+
+	/* not while another one is there */
+	c.phy->omac_mask |= BIT_ULL(REPEATER_BSSID_START + 7);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_muar_config(c.phy, c.vif, false,
+			false), 0);
+	req = mt7915_test_payload(mt76_test_msg(c.fake, 3),
+				  struct mt7915_test_muar);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->mode, 1);
+}
