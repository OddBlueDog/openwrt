+/* ERP/HT protection for the BSS: the HT protection mode, non-GF stations
+ * and CTS protection as flags, and the RTS thresholds (the default ones
+ * unless set).
+ */
+static void mt7915_test_set_protection(struct kunit *test)
+{
+	static const struct {
+		u8 ht_mode;
+		bool cts;
+		u32 mode;
+	} cases[] = {
+		{ IEEE80211_HT_OP_MODE_PROTECTION_NONE, false, 0 },
+		{ IEEE80211_HT_OP_MODE_PROTECTION_NONMEMBER, false, BIT(1) },
+		{ IEEE80211_HT_OP_MODE_PROTECTION_20MHZ, false, BIT(2) },
+		{ IEEE80211_HT_OP_MODE_PROTECTION_NONHT_MIXED, false, BIT(3) },
+		{ IEEE80211_HT_OP_MODE_NON_GF_STA_PRSNT, false, BIT(7) },
+		{ IEEE80211_HT_OP_MODE_PROTECTION_NONE, true, BIT(5) },
+		{ IEEE80211_HT_OP_MODE_PROTECTION_20MHZ |
+		  IEEE80211_HT_OP_MODE_NON_GF_STA_PRSNT, true,
+		  BIT(2) | BIT(5) | BIT(7) },
+	};
+	struct bss_info_prot *prot;
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+	int i;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		KUNIT_ASSERT_EQ(test, mt7915_mcu_set_protection(c.phy, c.vif,
+				cases[i].ht_mode, cases[i].cts), 0);
+		msg = mt76_test_msg(c.fake, i);
+		KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(BSS_INFO_UPDATE));
+		KUNIT_EXPECT_EQ(test, msg->data[0], c.mvif->mt76.idx);
+		KUNIT_EXPECT_EQ(test, mt7915_test_ntlv(test, msg->data,
+						       msg->len), 1);
+		prot = mt7915_test_tlv(test, msg, BSS_INFO_PROTECT_INFO,
+				       struct bss_info_prot);
+		KUNIT_ASSERT_NOT_NULL(test, prot);
+		KUNIT_EXPECT_EQ_MSG(test, le32_to_cpu(prot->prot_mode),
+				    cases[i].mode, "case %d", i);
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(prot->rts_len_thres),
+				MT7915_RTS_LEN_THRES);
+		KUNIT_EXPECT_EQ(test, prot->rts_pkt_thres, 2);
+		KUNIT_EXPECT_EQ(test, le16_to_cpu(prot->he_rts_thres), 1023);
+	}
+
+	/* the configured RTS threshold and HE duration-based RTS */
+	c.phy->mt76->hw->wiphy->rts_threshold = 500;
+	c.vif->bss_conf.frame_time_rts_th = 300;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_protection(c.phy, c.vif, 0,
+			false), 0);
+	prot = mt7915_test_tlv(test, mt76_test_msg(c.fake, i),
+			       BSS_INFO_PROTECT_INFO, struct bss_info_prot);
+	KUNIT_ASSERT_NOT_NULL(test, prot);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(prot->rts_len_thres), 500);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(prot->he_rts_thres), 300);
+
+	c.fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_protection(c.phy, c.vif, 0,
+			false), -EIO);
+}
