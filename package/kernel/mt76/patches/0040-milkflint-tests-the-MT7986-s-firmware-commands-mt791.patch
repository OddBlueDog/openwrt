+/* Header translation in the WTBL follows the station's flags: hardware
+ * rx de-amsdu translation if enabled, 4-address (WDS) frames both ways,
+ * TDLS peers neither.
+ */
+static void mt7915_test_sta_wtbl_hdr_trans(struct kunit *test)
+{
+	struct wtbl_hdr_trans *htr;
+	struct mt7915_test_ctx c;
+	struct sk_buff *skb;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	set_bit(MT_WCID_FLAG_HDR_TRANS, &c.msta->wcid.flags);
+	skb = mt7915_test_sta_req(test, &c, &c.msta->wcid);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_sta_wtbl_tlv(c.dev, skb, c.vif,
+			c.sta), 0);
+	htr = mt7915_test_skb_wtbl(test, skb, WTBL_HDR_TRANS,
+				   struct wtbl_hdr_trans);
+	KUNIT_ASSERT_NOT_NULL(test, htr);
+	KUNIT_EXPECT_EQ(test, htr->no_rx_trans, 0);
+	KUNIT_EXPECT_EQ(test, htr->from_ds, 1);
+	KUNIT_EXPECT_EQ(test, htr->to_ds, 0);
+
+	set_bit(MT_WCID_FLAG_4ADDR, &c.msta->wcid.flags);
+	skb = mt7915_test_sta_req(test, &c, &c.msta->wcid);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_sta_wtbl_tlv(c.dev, skb, c.vif,
+			c.sta), 0);
+	htr = mt7915_test_skb_wtbl(test, skb, WTBL_HDR_TRANS,
+				   struct wtbl_hdr_trans);
+	KUNIT_ASSERT_NOT_NULL(test, htr);
+	KUNIT_EXPECT_EQ(test, htr->from_ds, 1);
+	KUNIT_EXPECT_EQ(test, htr->to_ds, 1);
+
+	set_bit(MT_WCID_FLAG_TDLS_PEER, &c.msta->wcid.flags);
+	skb = mt7915_test_sta_req(test, &c, &c.msta->wcid);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_sta_wtbl_tlv(c.dev, skb, c.vif,
+			c.sta), 0);
+	htr = mt7915_test_skb_wtbl(test, skb, WTBL_HDR_TRANS,
+				   struct wtbl_hdr_trans);
+	KUNIT_ASSERT_NOT_NULL(test, htr);
+	KUNIT_EXPECT_EQ(test, htr->from_ds, 0);
+	KUNIT_EXPECT_EQ(test, htr->to_ds, 0);
+}
