+/* --- beamforming ---------------------------------------------------------- */
+
+/* Explicit beamforming needs AP or station mode, two chains to beamform
+ * with, our capability and the station's matching one (HE first, then
+ * VHT; HT has none).
+ */
+static void mt7915_test_ebf_supported(struct kunit *test)
+{
+	struct ieee80211_he_cap_elem *pe;
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	pe = &c.sta->deflink.he_cap.he_cap_elem;
+
+	mt7915_test_ht(c.sta);
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   false));
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   true));
+
+	/* VHT: we beamform a beamformee, and are beamformed by a beamformer */
+	mt7915_test_vht(c.sta);
+	KUNIT_EXPECT_TRUE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			  false));
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   true));
+	c.sta->deflink.vht_cap.cap |= IEEE80211_VHT_CAP_SU_BEAMFORMER_CAPABLE;
+	KUNIT_EXPECT_TRUE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			  true));
+	c.mvif->cap.vht_su_ebfer = false;
+	c.mvif->cap.vht_su_ebfee = false;
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   false));
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   true));
+
+	/* HE decides when present, even against VHT */
+	c.mvif->cap.vht_su_ebfer = true;
+	c.mvif->cap.vht_su_ebfee = true;
+	c.sta->deflink.he_cap.has_he = true;
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   false));
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   true));
+	pe->phy_cap_info[4] = IEEE80211_HE_PHY_CAP4_SU_BEAMFORMEE;
+	pe->phy_cap_info[3] = IEEE80211_HE_PHY_CAP3_SU_BEAMFORMER;
+	KUNIT_EXPECT_TRUE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			  false));
+	KUNIT_EXPECT_TRUE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			  true));
+	c.mvif->cap.he_su_ebfer = false;
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   false));
+	c.mvif->cap.he_su_ebfee = false;
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   true));
+
+	/* a single chain can still be beamformed, but not beamform */
+	c.mvif->cap.he_su_ebfer = true;
+	c.mvif->cap.he_su_ebfee = true;
+	c.phy->mt76->chainmask = 0x1;
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   false));
+	KUNIT_EXPECT_TRUE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			  true));
+
+	c.phy->mt76->chainmask = 0xf;
+	c.vif->type = NL80211_IFTYPE_STATION;
+	KUNIT_EXPECT_TRUE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			  false));
+	KUNIT_EXPECT_TRUE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			  true));
+	c.vif->type = NL80211_IFTYPE_ADHOC;
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   false));
+	KUNIT_EXPECT_FALSE(test, mt7915_is_ebf_supported(c.phy, c.vif, c.sta,
+			   true));
+}
