+/* A single HT MCS (here MCS 10, the third of the second stream) and forced
+ * short GI: the rate, the GI in the WTBL and in rate control, the spatial
+ * extension.
+ */
+static void mt7915_test_rate_fixed_ht(struct kunit *test)
+{
+	struct cfg80211_bitrate_mask *mask;
+	struct mt7915_test_ctx c;
+	struct mt7915_dev *dev;
+	struct sta_phy *phy;
+	u32 addr;
+
+	mt7915_test_init(test, &c, NL80211_BAND_2GHZ, NL80211_IFTYPE_AP);
+	dev = c.dev;
+	c.phy->mt76->antenna_mask = 0x6;
+	mt7915_test_ht(c.sta);
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_40;
+	mask = &c.mvif->bitrate_mask;
+	memset(mask->control[NL80211_BAND_2GHZ].ht_mcs, 0,
+	       sizeof(mask->control[NL80211_BAND_2GHZ].ht_mcs));
+	mask->control[NL80211_BAND_2GHZ].ht_mcs[1] = BIT(2);
+	mask->control[NL80211_BAND_2GHZ].gi = NL80211_TXRATE_FORCE_SGI;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_rate_ctrl(c.dev, c.vif, c.sta,
+			&c.msta->wcid, false), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 4);
+	phy = mt7915_test_fixed_phy(test, &c, 1, RATE_PARAM_FIXED_MCS);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	KUNIT_EXPECT_EQ(test, phy->mcs, 10);
+	/* short GI at 20 and 40 MHz */
+	KUNIT_EXPECT_EQ(test, phy->sgi, 0x3);
+	phy = mt7915_test_fixed_phy(test, &c, 2, RATE_PARAM_FIXED_GI);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	KUNIT_EXPECT_EQ(test, phy->sgi, 0x3);
+	mt7915_test_expect_spe(test, &c, 3);
+
+	addr = MT_WTBL_LMAC_OFFS(MT7915_TEST_STA_WCID & 0x7f, 7);
+	KUNIT_EXPECT_EQ(test, mt76_rr(c.dev, addr), 0x3 << 12);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_WTBLON_TOP_WDUCR),
+			MT7915_TEST_STA_WCID >> 7);
+}
+
+/* A single HE MCS with a fixed HE GI and LTF: each per width up to the
+ * station's, in two-bit fields; GI goes to the WTBL's HE field too.
+ */
+static void mt7915_test_rate_fixed_he(struct kunit *test)
+{
+	struct cfg80211_bitrate_mask *mask;
+	struct mt7915_test_ctx c;
+	struct sta_phy *phy;
+	u32 addr;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	c.phy->mt76->antenna_mask = 0x6;
+	mt7915_test_ht(c.sta);
+	mt7915_test_vht(c.sta);
+	mt7915_test_he(c.sta);
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_80;
+	mask = &c.mvif->bitrate_mask;
+	memset(mask->control[NL80211_BAND_5GHZ].he_mcs, 0,
+	       sizeof(mask->control[NL80211_BAND_5GHZ].he_mcs));
+	mask->control[NL80211_BAND_5GHZ].he_mcs[0] = BIT(9);
+	mask->control[NL80211_BAND_5GHZ].he_gi = 2;
+	mask->control[NL80211_BAND_5GHZ].he_ltf = 1;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_rate_ctrl(c.dev, c.vif, c.sta,
+			&c.msta->wcid, false), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 5);
+	phy = mt7915_test_fixed_phy(test, &c, 1, RATE_PARAM_FIXED_MCS);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	KUNIT_EXPECT_EQ(test, phy->mcs, 9);
+	KUNIT_EXPECT_EQ(test, phy->sgi, 0x2a);
+	KUNIT_EXPECT_EQ(test, phy->he_ltf, 0x15);
+	phy = mt7915_test_fixed_phy(test, &c, 2, RATE_PARAM_FIXED_GI);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	KUNIT_EXPECT_EQ(test, phy->sgi, 0x2a);
+	phy = mt7915_test_fixed_phy(test, &c, 3, RATE_PARAM_FIXED_HE_LTF);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	KUNIT_EXPECT_EQ(test, phy->he_ltf, 0x15);
+	mt7915_test_expect_spe(test, &c, 4);
+
+	addr = MT_WTBL_LMAC_OFFS(MT7915_TEST_STA_WCID & 0x7f, 7);
+	KUNIT_EXPECT_EQ(test, mt76_rr(c.dev, addr), 0x2aU << 24);
+}
