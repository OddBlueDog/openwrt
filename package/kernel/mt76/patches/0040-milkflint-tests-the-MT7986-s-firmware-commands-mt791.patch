+static void mt7915_test_restore_sd(void *data)
+{
+	sr_scene_detect = *(bool *)data;
+}
+
+/* set the sr_scene_detect module parameter for this test */
+static void mt7915_test_scene_detect(struct kunit *test, bool val)
+{
+	bool *old = kunit_kzalloc(test, sizeof(*old), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, old);
+	*old = sr_scene_detect;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_test_restore_sd, old), 0);
+	sr_scene_detect = val;
+}
