+				   center);
+}
+
+/* --- firmware behind the driver's own transport ------------------------- */
+
+struct mt7915_mcu2_frame {
+	struct list_head list;
+	struct mt76_queue *q;
+	int len;
+	u8 data[];			/* the TXD, then the payload */
+};
+
+struct mt7915_mcu2_fw {
+	struct kunit *test;
+	struct mt7915_dev *dev;
+	struct mt76_queue q[__MT_MCUQ_MAX];
+	struct list_head frames;	/* every frame queued, oldest first */
+	unsigned int n_frames;
+	unsigned int n_cleanups;
+	int ret;			/* what queueing a frame returns */
+	bool silent;			/* take frames, answer none */
+	u8 sem_get;			/* PATCH_SEM_CONTROL answers */
+	u8 sem_rel;
+	const void *payload;		/* after each reply's header */
+	int payload_len;
+};
+
+static struct mt7915_mcu2_fw *mt7915_mcu2_fw;
+
+/* tx_queue_skb_raw on the MCU queues: record the frame, and answer it with
+ * its sequence number through the driver's event path, as the firmware does
+ */
+static int mt7915_mcu2_fw_queue(struct mt76_dev *mdev, struct mt76_queue *q,
+				struct sk_buff *skb, u32 tx_info)
+{
+	struct mt7915_mcu2_fw *fw = mt7915_mcu2_fw;
+	struct mt76_connac2_mcu_txd *txd = (void *)skb->data;
+	struct mt76_connac2_mcu_rxd *rxd;
+	struct mt7915_mcu2_frame *frame;
+	struct sk_buff *reply = NULL;
+	int ret = fw->ret;
+
+	frame = kunit_kmalloc(fw->test, sizeof(*frame) + skb->len, GFP_KERNEL);
+	if (frame) {
+		frame->q = q;
+		frame->len = skb->len;
+		memcpy(frame->data, skb->data, skb->len);
+		list_add_tail(&frame->list, &fw->frames);
+		fw->n_frames++;
+	}
+
+	if (!ret && !fw->silent && skb->len >= sizeof(*txd))
+		reply = alloc_skb(sizeof(*rxd) + fw->payload_len, GFP_KERNEL);
+	if (reply) {
+		rxd = skb_put_zero(reply, sizeof(*rxd));
+		rxd->eid = txd->cid;
+		rxd->seq = txd->seq;
+		if (fw->payload_len)
+			skb_put_data(reply, fw->payload, fw->payload_len);
+		/* the semaphore status is the byte the parser returns */
+		if (txd->cid == MCU_CMD_PATCH_SEM_CONTROL &&
+		    skb->len >= sizeof(*txd) + 4)
+			rxd->ext_eid = get_unaligned_le32(txd + 1) ==
+				       PATCH_SEM_GET ? fw->sem_get :
+						       fw->sem_rel;
+		mt7915_mcu_rx_event(fw->dev, reply);
+	}
+
+	dev_kfree_skb(skb);
+	return ret;
+}
+
+static void mt7915_mcu2_fw_cleanup(struct mt76_dev *mdev,
+				   struct mt76_queue *q, bool flush)
+{
+	mt7915_mcu2_fw->n_cleanups++;
+}
+
+static void mt7915_mcu2_fw_detach(void *data)
+{
+	mt7915_mcu2_fw = NULL;
+}
+
+/* MCU queues for @dev that go to a fake firmware. The ROM patch is already
+ * loaded and the semaphore free, unless the test says otherwise.
+ */
+static struct mt7915_mcu2_fw *
+mt7915_mcu2_fw_attach(struct kunit *test, struct mt7915_dev *dev)
+{
+	static const struct mt76_queue_ops ops = {
+		.tx_queue_skb_raw = mt7915_mcu2_fw_queue,
+		.tx_cleanup = mt7915_mcu2_fw_cleanup,
+	};
+	struct mt7915_mcu2_fw *fw;
+	int i;
+
+	fw = kunit_kzalloc(test, sizeof(*fw), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, fw);
+	fw->test = test;
+	fw->dev = dev;
+	INIT_LIST_HEAD(&fw->frames);
+	fw->sem_get = PATCH_IS_DL;
+	fw->sem_rel = PATCH_REL_SEM_SUCCESS;
+	for (i = 0; i < __MT_MCUQ_MAX; i++)
+		dev->mt76.q_mcu[i] = &fw->q[i];
+	dev->mt76.queue_ops = &ops;
+	mt7915_mcu2_fw = fw;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_mcu2_fw_detach, NULL), 0);
+	return fw;
+}
+
+/* frame @i must be legacy command @cid on MCU queue @qid with a payload of
+ * @len bytes behind a complete TXD; returns the payload
+ */
+static const u8 *
+mt7915_mcu2_frame(struct kunit *test, struct mt7915_mcu2_fw *fw,
+		  unsigned int i, u8 cid, enum mt76_mcuq_id qid, int len)
+{
+	struct mt7915_mcu2_frame *frame, *found = NULL;
+	struct mt76_connac2_mcu_txd *txd;
+
+	list_for_each_entry(frame, &fw->frames, list)
+		if (!i--) {
+			found = frame;
+			break;
+		}
+	KUNIT_ASSERT_NOT_NULL(test, found);
+	KUNIT_ASSERT_EQ(test, found->len, (int)sizeof(*txd) + len);
+	KUNIT_EXPECT_PTR_EQ(test, found->q, &fw->q[qid]);
+
+	txd = (struct mt76_connac2_mcu_txd *)found->data;
+	KUNIT_EXPECT_EQ(test, txd->cid, cid);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid, 0);
+	KUNIT_EXPECT_EQ(test, txd->pkt_type, MCU_PKT_ID);
+	KUNIT_EXPECT_EQ(test, txd->set_query, MCU_Q_NA);
+	KUNIT_EXPECT_EQ(test, txd->s2d_index, MCU_S2D_H2N);
+	KUNIT_EXPECT_NE(test, txd->seq, 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(txd->len),
+			found->len - sizeof(txd->txd));
+
+	return found->data + sizeof(*txd);
+}
+
+static u32 mt7915_mcu2_lpcr[2];
+
+/* the firmware lets go of a band (FW_OWN_STAT clears) once the driver asks
+ * for it with DRV_OWN
+ */
+static u32 mt7915_mcu2_own_hook(struct mt76_test_fake *fake, u32 addr,
+				u32 val)
+{
+	if ((addr == mt7915_mcu2_lpcr[0] || addr == mt7915_mcu2_lpcr[1]) &&
+	    !(val & MT_TOP_LPCR_HOST_DRV_OWN))
+		val |= MT_TOP_LPCR_HOST_FW_OWN_STAT;
+	return val;
+}
+
+/* where the register file keeps the driver's register @addr */
+static u32 mt7915_mcu2_reg_key(struct mt7915_dev *dev, u32 addr)
+{
+	mt76_wr(dev, addr, mt76_rr(dev, addr));
+	return mt76_test_fake->last_addr;
+}
+
+/* a chip whose firmware owns it and waits in the download state */
+static void mt7915_mcu2_chip_ready(struct mt7915_dev *dev)
+{
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	mt7915_mcu2_lpcr[0] = mt7915_mcu2_reg_key(dev,
+						  MT_TOP_LPCR_HOST_BAND(0));
+	mt7915_mcu2_lpcr[1] = mt7915_mcu2_reg_key(dev,
+						  MT_TOP_LPCR_HOST_BAND(1));
+	fake->rr_hook = mt7915_mcu2_own_hook;
+	mt76_wr(dev, MT_TOP_MISC,
+		FIELD_PREP(MT_TOP_MISC_FW_STATE, FW_STATE_FW_DOWNLOAD));
+	mt76_wr(dev, MT_SWDEF_MODE, 0xff);	/* not normal mode yet */
+}
+
+/* what loading firmware file @name fails with here (the VM has no MT7986
+ * firmware); skips the test if the file is there after all
+ */
+static int mt7915_mcu2_fw_missing(struct kunit *test, struct mt7915_dev *dev,
+				  const char *name)
+{
+	const struct firmware *fw;
+	int ret;
+
+	ret = request_firmware(&fw, name, dev->mt76.dev);
+	if (!ret) {
+		release_firmware(fw);
+		kunit_skip(test, "%s is installed", name);
+	}
+	return ret;
+}
+
+/* mt7915_mcu_init(), kept out of line: inlined into a test, coverage would
+ * count its lines as the test's
+ */
+static int mt7915_mcu2_mcu_init(struct mt7915_dev *dev)
+{
+	int (*init)(struct mt7915_dev *dev) = mt7915_mcu_init;
+
+	OPTIMIZER_HIDE_VAR(init);
+	return init(dev);
+}
+
+/* Bring-up with the ROM patch in place: driver own, semaphore release, MCU
+ * restart, patch check, all through the driver's own transport; the missing
+ * RAM code's error comes back and the MCU isn't marked running.
+ */
+static void mt7915_mcu2_init_no_ram_code(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu2_fw *fw = mt7915_mcu2_fw_attach(test, dev);
+	int err = mt7915_mcu2_fw_missing(test, dev, MT7986_FIRMWARE_WM_MT7975);
+	const struct mt76_mcu_ops *ops;
+	const u8 *data;
+
+	mt7915_mcu2_chip_ready(dev);
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_mcu_init(dev), err);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT76_STATE_MCU_RUNNING,
+					  &dev->mphy.state));
+
+	ops = dev->mt76.mcu_ops;
+	KUNIT_EXPECT_TRUE(test, ops->mcu_skb_send_msg ==
+				mt7915_mcu_send_message);
+	KUNIT_EXPECT_TRUE(test, ops->mcu_parse_response ==
+				mt7915_mcu_parse_response);
+	KUNIT_EXPECT_TRUE(test, ops->mcu_skb_prepare_msg ==
+				mt76_connac2_mcu_fill_message);
+	KUNIT_EXPECT_EQ(test, ops->headroom,
+			sizeof(struct mt76_connac2_mcu_txd));
+	KUNIT_EXPECT_EQ(test, ops->max_retry, 1);
+
+	/* normal operation mode, then driver own on band 0, irq acked */
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_SWDEF_MODE),
+			MT_SWDEF_NORMAL_MODE);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(mt76_test_fake,
+					    mt7915_mcu2_lpcr[0]),
+			MT_TOP_LPCR_HOST_DRV_OWN);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TOP_LPCR_HOST_BAND_IRQ_STAT(0)),
+			MT_TOP_LPCR_HOST_BAND_STAT);
+	/* a single host interface: band 1 stays with the firmware */
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(mt76_test_fake,
+					    mt7915_mcu2_lpcr[1]), 0);
+
+	KUNIT_ASSERT_EQ(test, fw->n_frames, 3);
+	data = mt7915_mcu2_frame(test, fw, 0, MCU_CMD_PATCH_SEM_CONTROL,
+				 MT_MCUQ_WM, 4);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(data), PATCH_SEM_RELEASE);
+	data = mt7915_mcu2_frame(test, fw, 1, MCU_CMD_NIC_POWER_CTRL,
+				 MT_MCUQ_WM, 4);
+	KUNIT_EXPECT_EQ(test, data[0], 1);		/* power_mode */
+	data = mt7915_mcu2_frame(test, fw, 2, MCU_CMD_PATCH_SEM_CONTROL,
+				 MT_MCUQ_WM, 4);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(data), PATCH_SEM_GET);
+}
+
+/* No patch loaded yet: the driver takes the semaphore, can't find the patch
+ * file, and gives the semaphore back before failing.
+ */
+static void mt7915_mcu2_init_no_patch(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu2_fw *fw = mt7915_mcu2_fw_attach(test, dev);
+	int err = mt7915_mcu2_fw_missing(test, dev, MT7986_ROM_PATCH_MT7975);
+	const u8 *data;
+
+	mt7915_mcu2_chip_ready(dev);
+	fw->sem_get = PATCH_NOT_DL_SEM_SUCCESS;
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_mcu_init(dev), err);
+	KUNIT_ASSERT_EQ(test, fw->n_frames, 4);
+	data = mt7915_mcu2_frame(test, fw, 3, MCU_CMD_PATCH_SEM_CONTROL,
+				 MT_MCUQ_WM, 4);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(data), PATCH_SEM_RELEASE);
+}
+
+/* A semaphore the firmware won't hand out fails the bring-up with -EAGAIN;
+ * one it won't take back at the start doesn't stop it.
+ */
+static void mt7915_mcu2_init_semaphore(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu2_fw *fw = mt7915_mcu2_fw_attach(test, dev);
+
+	mt7915_mcu2_chip_ready(dev);
+	fw->sem_rel = PATCH_IS_DL;		/* not a release success */
+	fw->sem_get = PATCH_REL_SEM_SUCCESS;	/* not a get answer */
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_mcu_init(dev), -EAGAIN);
+	KUNIT_ASSERT_EQ(test, fw->n_frames, 3);
+	mt7915_mcu2_frame(test, fw, 1, MCU_CMD_NIC_POWER_CTRL, MT_MCUQ_WM, 4);
+	mt7915_mcu2_frame(test, fw, 2, MCU_CMD_PATCH_SEM_CONTROL, MT_MCUQ_WM,
+			  4);
+}
+
+/* With a second host interface (hif2), band 1 is taken over too, before
+ * any firmware message.
+ */
+static void mt7915_mcu2_init_dual_hif(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu2_fw *fw = mt7915_mcu2_fw_attach(test, dev);
+	int err = mt7915_mcu2_fw_missing(test, dev, MT7986_FIRMWARE_WM_MT7975);
+
+	dev->hif2 = kunit_kzalloc(test, sizeof(*dev->hif2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev->hif2);
+	mt7915_mcu2_chip_ready(dev);
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_mcu_init(dev), err);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(mt76_test_fake,
+					    mt7915_mcu2_lpcr[0]),
+			MT_TOP_LPCR_HOST_DRV_OWN);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(mt76_test_fake,
+					    mt7915_mcu2_lpcr[1]),
+			MT_TOP_LPCR_HOST_DRV_OWN);
+	KUNIT_EXPECT_EQ(test, mt76_rr(dev, MT_TOP_LPCR_HOST_BAND_IRQ_STAT(1)),
+			MT_TOP_LPCR_HOST_BAND_STAT);
+	KUNIT_EXPECT_EQ(test, fw->n_frames, 3);
+	dev->hif2 = NULL;
+}
+
+static struct mt76_connac2_mcu_txd *
+mt7915_mcu2_last_frame(struct kunit *test, struct mt7915_mcu2_fw *fw,
+		       enum mt76_mcuq_id qid, int len)
+{
+	struct mt7915_mcu2_frame *frame;
+
+	KUNIT_ASSERT_FALSE(test, list_empty(&fw->frames));
+	frame = list_last_entry(&fw->frames, struct mt7915_mcu2_frame, list);
+	KUNIT_EXPECT_PTR_EQ(test, frame->q, &fw->q[qid]);
+	KUNIT_EXPECT_EQ(test, frame->len,
+			(int)sizeof(struct mt76_connac2_mcu_txd) + len);
+	return (struct mt76_connac2_mcu_txd *)frame->data;
+}
+
+/* After bring-up, commands get an extended-command TXD with an ack request,
+ * go to WM until the firmware runs and to WA after (WA commands marked for
+ * the WA), and replies are matched and parsed, with per-command timeouts.
+ */
+static void mt7915_mcu2_transport(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu2_fw *fw = mt7915_mcu2_fw_attach(test, dev);
+	__le32 temp[2] = { 0, cpu_to_le32(51) };
+	struct mt76_connac2_mcu_txd *txd;
+
+	mt7915_mcu2_chip_ready(dev);
+	/* fails for want of the RAM code, with the transport in place */
+	KUNIT_ASSERT_LT(test, mt7915_mcu2_mcu_init(dev), 0);
+	fw->payload = temp;
+	fw->payload_len = sizeof(temp);
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_temperature(&dev->phy), 51);
+	KUNIT_EXPECT_EQ(test, dev->mt76.mcu.timeout, 2 * HZ);
+	txd = mt7915_mcu2_last_frame(test, fw, MT_MCUQ_WM, 8);
+	KUNIT_EXPECT_EQ(test, txd->cid, MCU_CMD_EXT_CID);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid, MCU_EXT_CMD_THERMAL_CTRL);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid_ack, 1);
+	KUNIT_EXPECT_EQ(test, txd->set_query, MCU_Q_SET);
+	KUNIT_EXPECT_EQ(test, txd->s2d_index, MCU_S2D_H2N);
+	KUNIT_EXPECT_EQ(test, ((u8 *)(txd + 1))[0], THERMAL_SENSOR_TEMP_QUERY);
+
+	fw->payload_len = 0;
+	set_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_ser(dev, SER_QUERY, 0, 1), 0);
+	KUNIT_EXPECT_EQ(test, dev->mt76.mcu.timeout, 5 * HZ);
+	txd = mt7915_mcu2_last_frame(test, fw, MT_MCUQ_WA, 4);
+	KUNIT_EXPECT_EQ(test, txd->cid, MCU_CMD_EXT_CID);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid, MCU_EXT_CMD_SET_SER_TRIGGER);
+	KUNIT_EXPECT_EQ(test, txd->s2d_index, MCU_S2D_H2N);
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_red(dev, false), 0);
+	txd = mt7915_mcu2_last_frame(test, fw, MT_MCUQ_WA, 12);
+	KUNIT_EXPECT_EQ(test, txd->cid, MCU_CMD_WA_PARAM);
+	KUNIT_EXPECT_EQ(test, txd->ext_cid, MCU_WA_PARAM_CMD_SET);
+	KUNIT_EXPECT_EQ(test, txd->s2d_index, MCU_S2D_H2C);
+	clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+}
+
+/* Shutdown restarts the MCU, gives every band back to the firmware once it
+ * is back in the download state, and drops replies nobody waits for.
+ */
+static void mt7915_mcu2_exit(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt76_test_msg *msg;
+	struct sk_buff *stale;
+
+	mt7915_mcu2_chip_ready(dev);
+	stale = alloc_skb(16, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, stale);
+	skb_queue_tail(&dev->mt76.mcu.res_q, stale);
+
+	mt7915_mcu_exit(dev);
+
+	msg = mt7915_mcu2_msg(test, MCU_CMD(NIC_POWER_CTRL), 4);
+	KUNIT_EXPECT_EQ(test, msg->data[0], 1);		/* power_mode */
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, mt7915_mcu2_lpcr[0]),
+			MT_TOP_LPCR_HOST_FW_OWN);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, mt7915_mcu2_lpcr[1]), 0);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&dev->mt76.mcu.res_q));
+}
+
+/* With two host interfaces, shutdown hands back band 1 as well. */
+static void mt7915_mcu2_exit_dual_hif(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	dev->hif2 = kunit_kzalloc(test, sizeof(*dev->hif2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dev->hif2);
+	mt7915_mcu2_chip_ready(dev);
+
+	mt7915_mcu_exit(dev);
+
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, mt7915_mcu2_lpcr[0]),
+			MT_TOP_LPCR_HOST_FW_OWN);
+	KUNIT_EXPECT_EQ(test, mt76_test_reg(fake, mt7915_mcu2_lpcr[1]),
+			MT_TOP_LPCR_HOST_FW_OWN);
+	dev->hif2 = NULL;
+}
+
+/* Firmware download frames go to the FWDL ring; commands to WM until the
+ * firmware runs, then to WA (which forwards to WM).
+ */
+static void mt7915_mcu2_send_queues(struct kunit *test)
+{
+	/* MCU_CMD() isn't a constant expression */
+	const struct {
+		int cmd;
+		bool running;
+		enum mt76_mcuq_id qid;
+	} cases[] = {
+		{ MCU_CMD(FW_SCATTER), false, MT_MCUQ_FWDL },
+		{ MCU_EXT_CMD(SET_SER_TRIGGER), false, MT_MCUQ_WM },
+		{ MCU_CMD(PATCH_SEM_CONTROL), false, MT_MCUQ_WM },
+		{ MCU_EXT_CMD(SET_SER_TRIGGER), true, MT_MCUQ_WA },
+		{ MCU_WA_PARAM_CMD(SET), true, MT_MCUQ_WA },
+		{ MCU_CMD(FW_SCATTER), true, MT_MCUQ_FWDL },
+	};
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu2_fw *fw = mt7915_mcu2_fw_attach(test, dev);
+	struct mt7915_mcu2_frame *frame;
+	struct sk_buff *skb;
+	int i;
+
+	fw->silent = true;
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		skb = alloc_skb(16, GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, skb);
+		skb_put_zero(skb, 16);
+		if (cases[i].running)
+			set_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+		else
+			clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+
+		KUNIT_EXPECT_EQ(test, mt7915_mcu_send_message(&dev->mt76, skb,
+				cases[i].cmd, NULL), 0);
+		KUNIT_ASSERT_EQ(test, fw->n_frames, i + 1);
+		frame = list_last_entry(&fw->frames, struct mt7915_mcu2_frame,
+					list);
+		KUNIT_EXPECT_PTR_EQ_MSG(test, frame->q, &fw->q[cases[i].qid],
+					"case %d", i);
+	}
+	clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+}
+
+/* Before a command it waits for, the driver drops stale queued replies (with
+ * 4-bit sequence numbers one could pass for the answer); others keep them.
+ */
+static void mt7915_mcu2_send_purges_stale(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu2_fw *fw = mt7915_mcu2_fw_attach(test, dev);
+	struct sk_buff_head *res_q = &dev->mt76.mcu.res_q;
+	struct sk_buff *skb, *stale;
+	int seq = 0;
+
+	fw->silent = true;
+	stale = alloc_skb(16, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, stale);
+	skb_queue_tail(res_q, stale);
+
+	skb = alloc_skb(16, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_send_message(&dev->mt76, skb,
+			MCU_EXT_CMD(SET_SER_TRIGGER), NULL), 0);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(res_q), 1);
+
+	skb = alloc_skb(16, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_send_message(&dev->mt76, skb,
+			MCU_EXT_CMD(SET_SER_TRIGGER), &seq), 0);
+	KUNIT_EXPECT_EQ(test, skb_queue_len(res_q), 0);
+	KUNIT_EXPECT_EQ(test, fw->n_frames, 2);
+}
+
+/* A full MCU ring (or any queueing error) comes back to the sender. */
+static void mt7915_mcu2_send_error(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu2_fw *fw = mt7915_mcu2_fw_attach(test, dev);
+	struct sk_buff *skb;
+
+	fw->ret = -ENOMEM;
+	skb = alloc_skb(16, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_send_message(&dev->mt76, skb,
+			MCU_EXT_CMD(SET_SER_TRIGGER), NULL), -ENOMEM);
+}
+
+/* Reply timeouts: 2 s for stats and station/BSS updates, 10 s for the EEPROM
+ * buffer, 5 s otherwise; only extended commands match by extended id.
+ */
+static void mt7915_mcu2_timeouts(struct kunit *test)
+{
+	/* MCU_CMD() isn't a constant expression */
+	const struct {
+		int cmd;
+		unsigned long timeout;
+	} cases[] = {
+		{ MCU_EXT_CMD(THERMAL_CTRL), 2 * HZ },
+		{ MCU_EXT_CMD(GET_MIB_INFO), 2 * HZ },
+		{ MCU_EXT_CMD(PHY_STAT_INFO), 2 * HZ },
+		{ MCU_EXT_CMD(STA_REC_UPDATE), 2 * HZ },
+		{ MCU_EXT_CMD(BSS_INFO_UPDATE), 2 * HZ },
+		{ MCU_EXT_QUERY(THERMAL_CTRL), 2 * HZ },
+		{ MCU_EXT_CMD(EFUSE_BUFFER_MODE), 10 * HZ },
+		{ MCU_EXT_CMD(SET_SER_TRIGGER), 5 * HZ },
+		{ MCU_CMD(PATCH_SEM_CONTROL), 5 * HZ },
+		{ MCU_WA_PARAM_CMD(SET), 5 * HZ },
+		/* a legacy command whose upper bits look like THERMAL_CTRL */
+		{ MCU_CMD(PATCH_SEM_CONTROL) |
+		  FIELD_PREP(__MCU_CMD_FIELD_EXT_ID,
+			     MCU_EXT_CMD_THERMAL_CTRL), 5 * HZ },
+	};
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		dev->mt76.mcu.timeout = 0;
+		mt7915_mcu_set_timeout(&dev->mt76, cases[i].cmd);
+		KUNIT_EXPECT_EQ_MSG(test, dev->mt76.mcu.timeout,
+				    cases[i].timeout, "case %d", i);
+	}
+}
+
+static int mt7915_mcu2_resets;
+
+static void mt7915_mcu2_reset_work(struct work_struct *work)
+{
+	mt7915_mcu2_resets++;
+}
+
+/* A firmware that stops answering: the command fails with -ETIMEDOUT, the
+ * MCU is marked as resetting and one full (restart) recovery is queued.
+ * Timeouts during that recovery don't queue another.
+ */
+static void mt7915_mcu2_fw_timeout(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	/* the real recovery would reset the (fake) chip */
+	INIT_WORK(&dev->reset_work, mt7915_mcu2_reset_work);
+	mt7915_mcu2_resets = 0;
+	fake->mcu_silent = true;
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_temperature(&dev->phy),
+			-ETIMEDOUT);
+	flush_work(&dev->reset_work);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_resets, 1);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT76_MCU_RESET, &dev->mphy.state));
+	KUNIT_EXPECT_TRUE(test, dev->recovery.restart);
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_temperature(&dev->phy),
+			-ETIMEDOUT);
+	flush_work(&dev->reset_work);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_resets, 1);
+}
+
+static struct kunit_case mt7915_mcu2_fw_cases[] = {
+	KUNIT_CASE(mt7915_mcu2_init_no_ram_code),
+	KUNIT_CASE(mt7915_mcu2_init_no_patch),
+	KUNIT_CASE(mt7915_mcu2_init_semaphore),
+	KUNIT_CASE(mt7915_mcu2_init_dual_hif),
+	KUNIT_CASE(mt7915_mcu2_transport),
+	KUNIT_CASE(mt7915_mcu2_exit),
+	KUNIT_CASE(mt7915_mcu2_exit_dual_hif),
+	KUNIT_CASE(mt7915_mcu2_send_queues),
+	KUNIT_CASE(mt7915_mcu2_send_purges_stale),
+	KUNIT_CASE(mt7915_mcu2_send_error),
+	KUNIT_CASE(mt7915_mcu2_timeouts),
+	KUNIT_CASE(mt7915_mcu2_fw_timeout),
+	{}
+};
+
+static struct kunit_suite mt7915_mcu2_fw_suite = {
+	.name = "mt7915-mcu-fw",
+	.test_cases = mt7915_mcu2_fw_cases,
+};
+
+/* --- firmware events ------------------------------------------------------ */
+
+/* an event from the firmware: @len bytes of @ev (which starts with the rxd
+ * header) with the header's ids and sequence number set
+ */
+static struct sk_buff *
+mt7915_mcu2_event(struct kunit *test, u8 eid, u8 ext_eid, u8 seq,
+		  void *ev, int len)
+{
+	struct mt76_connac2_mcu_rxd *rxd;
+	struct sk_buff *skb;
+
+	KUNIT_ASSERT_GE(test, len, (int)sizeof(*rxd));
+	skb = alloc_skb(len, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	rxd = skb_put_data(skb, ev, len);
+	rxd->eid = eid;
+	rxd->ext_eid = ext_eid;
+	rxd->seq = seq;
+	return skb;
+}
+
+/* the driver's rx path for MCU events runs in NAPI */
+static void mt7915_mcu2_rx(struct mt7915_dev *dev, struct sk_buff *skb)
+{
+	local_bh_disable();
+	rcu_read_lock();
+	mt7915_mcu_rx_event(dev, skb);
+	rcu_read_unlock();
+	local_bh_enable();
+}
+
+/* @skb is handled as an unsolicited event: consumed, not queued for a
+ * command waiting for its reply
+ */
+static void mt7915_mcu2_rx_event(struct kunit *test, struct mt7915_dev *dev,
+				 struct sk_buff *skb)
+{
+	skb_get(skb);
+	mt7915_mcu2_rx(dev, skb);
+	KUNIT_EXPECT_EQ(test, refcount_read(&skb->users), 1);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&dev->mt76.mcu.res_q));
+	kfree_skb(skb);
+}
+
+/* @skb is handled as a command's reply: queued as is for the waiter */
+static void mt7915_mcu2_rx_reply(struct kunit *test, struct mt7915_dev *dev,
+				 struct sk_buff *skb)
+{
+	struct sk_buff *queued;
+
+	skb_get(skb);
+	mt7915_mcu2_rx(dev, skb);
+	queued = skb_dequeue(&dev->mt76.mcu.res_q);
+	KUNIT_EXPECT_PTR_EQ(test, queued, skb);
+	KUNIT_EXPECT_TRUE(test, skb_queue_empty(&dev->mt76.mcu.res_q));
+	if (queued)
+		kfree_skb(queued);
+	kfree_skb(skb);
+}
+
+/* Events carrying a command's sequence number are replies, whatever their
+ * id; so are the WA's tx statistics, which come with sequence number 0.
+ */
+static void mt7915_mcu2_events_replies(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_connac2_mcu_rxd rxd = {};
+
+	mt7915_mcu2_rx_reply(test, dev, mt7915_mcu2_event(test,
+			MCU_EVENT_EXT, MCU_EXT_EVENT_MURU_CTRL, 3,
+			&rxd, sizeof(rxd)));
+	mt7915_mcu2_rx_reply(test, dev, mt7915_mcu2_event(test,
+			MCU_CMD_PATCH_SEM_CONTROL, 0, 9, &rxd, sizeof(rxd)));
+	mt7915_mcu2_rx_reply(test, dev, mt7915_mcu2_event(test,
+			MCU_EVENT_EXT, MCU_EXT_EVENT_RDD_REPORT, 1,
+			&rxd, sizeof(rxd)));
+	mt7915_mcu2_rx_reply(test, dev, mt7915_mcu2_event(test,
+			MCU_CMD_EXT_CID, MCU_EXT_EVENT_WA_TX_STAT, 0,
+			&rxd, sizeof(rxd)));
+}
+
+/* The WA answers a tx statistics query without the query's sequence
+ * number: the reply parser takes it anyway. Any other event with the wrong
+ * number is someone else's reply.
+ */
+static void mt7915_mcu2_parse_wa_tx_stat(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	int cmd = MCU_WA_PARAM_CMD(QUERY);
+	struct {
+		struct mt76_connac2_mcu_rxd rxd;
+		u8 data[8];
+	} ev = {};
+	struct sk_buff *skb;
+
+	skb = mt7915_mcu2_event(test, MCU_CMD_EXT_CID,
+				MCU_EXT_EVENT_WA_TX_STAT, 0, &ev, sizeof(ev));
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_parse_response(&dev->mt76, cmd, skb,
+							5), 0);
+	KUNIT_EXPECT_EQ(test, skb->len, sizeof(ev.data));
+	kfree_skb(skb);
+
+	skb = mt7915_mcu2_event(test, MCU_CMD_EXT_CID,
+				MCU_EXT_EVENT_MURU_CTRL, 0, &ev, sizeof(ev));
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_parse_response(&dev->mt76, cmd, skb,
+							5), -EAGAIN);
+	kfree_skb(skb);
+
+	skb = mt7915_mcu2_event(test, 0x01, MCU_EXT_EVENT_WA_TX_STAT, 0, &ev,
+				sizeof(ev));
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_parse_response(&dev->mt76, cmd, skb,
+							5), -EAGAIN);
+	kfree_skb(skb);
+}
+
+/* Events with sequence number 0, and the ids the firmware only ever sends
+ * on its own (thermal, log, assert, power save, color change), are handled
+ * and freed in the rx path, even when they carry a sequence number.
+ */
+static void mt7915_mcu2_events_unsolicited(struct kunit *test)
+{
+	static const u8 ids[] = {
+		MCU_EXT_EVENT_THERMAL_PROTECT,
+		MCU_EXT_EVENT_FW_LOG_2_HOST,
+		MCU_EXT_EVENT_ASSERT_DUMP,
+		MCU_EXT_EVENT_PS_SYNC,
+		MCU_EXT_EVENT_BCC_NOTIFY,
+	};
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 ev[64] = {};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ids); i++)
+		mt7915_mcu2_rx_event(test, dev, mt7915_mcu2_event(test,
+				MCU_EVENT_EXT, ids[i], 5, ev, 64));
+
+	/* WA_TX_STAT only counts as a reply from the WA (EXT_CID) */
+	mt7915_mcu2_rx_event(test, dev, mt7915_mcu2_event(test, 0x01,
+			MCU_EXT_EVENT_WA_TX_STAT, 0, ev, 64));
+	/* unknown ids, extended or not */
+	mt7915_mcu2_rx_event(test, dev, mt7915_mcu2_event(test,
+			MCU_EVENT_EXT, MCU_EXT_EVENT_MURU_CTRL, 0, ev, 64));
+	mt7915_mcu2_rx_event(test, dev, mt7915_mcu2_event(test, 0x01, 0, 0,
+			ev, 64));
+	KUNIT_EXPECT_EQ(test, dev->hw_pattern, 0);
+}
+
+static void mt7915_mcu2_thermal_event(struct kunit *test,
+				      struct mt7915_dev *dev, u8 eid,
+				      u8 ctrl_id, u8 band, u8 duty)
+{
+	struct mt7915_mcu_thermal_notify ev = {};
+
+	ev.ctrl.ctrl_id = ctrl_id;
+	ev.ctrl.band_idx = band;
+	ev.ctrl.duty.duty_level = 2;
+	ev.ctrl.duty.duty_cycle = duty;
+	mt7915_mcu2_rx_event(test, dev, mt7915_mcu2_event(test, eid,
+			MCU_EXT_EVENT_THERMAL_PROTECT, 0, &ev, sizeof(ev)));
+}
+
+/* Thermal protection reports the duty cycle the firmware throttles a band
+ * to; the driver keeps it per radio (the cooling device reads it back).
+ */
+static void mt7915_mcu2_events_thermal(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_phy *phy2;
+
+	/* band 1 without a radio of its own is the main radio's */
+	mt7915_mcu2_thermal_event(test, dev, MCU_EVENT_EXT,
+				  THERMAL_PROTECT_ENABLE, 1, 40);
+	KUNIT_EXPECT_EQ(test, dev->phy.throttle_state, 40);
+	mt7915_mcu2_thermal_event(test, dev, MCU_EVENT_EXT,
+				  THERMAL_PROTECT_ENABLE, 0, 70);
+	KUNIT_EXPECT_EQ(test, dev->phy.throttle_state, 70);
+
+	/* other reports, unknown bands and non-extended events change
+	 * nothing
+	 */
+	mt7915_mcu2_thermal_event(test, dev, MCU_EVENT_EXT,
+				  THERMAL_PROTECT_DUTY_INFO, 0, 10);
+	mt7915_mcu2_thermal_event(test, dev, MCU_EVENT_EXT,
+				  THERMAL_PROTECT_ENABLE, 2, 10);
+	mt7915_mcu2_thermal_event(test, dev, 0x01,
+				  THERMAL_PROTECT_ENABLE, 0, 10);
+	KUNIT_EXPECT_EQ(test, dev->phy.throttle_state, 70);
+
+	/* with a band 1 radio, its reports go there */
+	phy2 = mt7915_mcu2_band1_phy(test, dev);
+	mt7915_mcu2_thermal_event(test, dev, MCU_EVENT_EXT,
+				  THERMAL_PROTECT_ENABLE, 1, 25);
+	KUNIT_EXPECT_EQ(test, phy2->throttle_state, 25);
+	KUNIT_EXPECT_EQ(test, dev->phy.throttle_state, 70);
+
+	/* unless the main radio is band 1 itself */
+	dev->mphy.band_idx = MT_BAND1;
+	mt7915_mcu2_thermal_event(test, dev, MCU_EVENT_EXT,
+				  THERMAL_PROTECT_ENABLE, 1, 50);
+	KUNIT_EXPECT_EQ(test, dev->phy.throttle_state, 50);
+	KUNIT_EXPECT_EQ(test, phy2->throttle_state, 25);
+}
+
+/* mac80211 handles a radar detection in wiphy work: run it now */
+static void mt7915_mcu2_run_wiphy_work(struct mt7915_dev *dev)
+{
+	struct wiphy *wiphy = dev->mphy.hw->wiphy;
+
+	wiphy_lock(wiphy);
+	wiphy_work_flush(wiphy, NULL);
+	wiphy_unlock(wiphy);
+}
+
+/* a radar report from detector @rdd_idx; true if the driver passed it on
+ * (each detection counts in hw_pattern)
+ */
+static bool mt7915_mcu2_radar(struct kunit *test, struct mt7915_dev *dev,
+			      u8 rdd_idx)
+{
+	struct mt7915_mcu_rdd_report *ev;
+	u32 seen = dev->hw_pattern;
+
+	ev = kunit_kzalloc(test, sizeof(*ev), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ev);
+	ev->rdd_idx = rdd_idx;
+	ev->long_detected = 1;
+	mt7915_mcu2_rx_event(test, dev, mt7915_mcu2_event(test,
+			MCU_EVENT_EXT, MCU_EXT_EVENT_RDD_REPORT, 0,
+			ev, sizeof(*ev)));
+	mt7915_mcu2_run_wiphy_work(dev);
+	return dev->hw_pattern != seen;
+}
+
+/* Radar reports reach mac80211 for the detector's radio: band 1's is the
+ * main radio when a single A-die makes it band 1, else the band 1 radio (or
+ * nobody); unknown and radio-less background detectors are dropped.
+ */
+static void mt7915_mcu2_events_radar(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+
+	KUNIT_EXPECT_TRUE(test, mt7915_mcu2_radar(test, dev, MT_RDD_IDX_BAND0));
+
+	mt7915_mcu2_set_adie(dev, MT7976_DUAL_ADIE);
+	KUNIT_EXPECT_FALSE(test, mt7915_mcu2_radar(test, dev,
+						   MT_RDD_IDX_BAND1));
+	mt7915_mcu2_set_adie(dev, MT7976_ONE_ADIE);
+	KUNIT_EXPECT_TRUE(test, mt7915_mcu2_radar(test, dev,
+						  MT_RDD_IDX_BAND1));
+	mt7915_mcu2_set_adie(dev, MT7975_ONE_ADIE);
+	KUNIT_EXPECT_TRUE(test, mt7915_mcu2_radar(test, dev,
+						  MT_RDD_IDX_BAND1));
+
+	mt7915_mcu2_set_adie(dev, MT7975_DUAL_ADIE);
+	mt7915_mcu2_band1_phy(test, dev);
+	KUNIT_EXPECT_TRUE(test, mt7915_mcu2_radar(test, dev,
+						  MT_RDD_IDX_BAND1));
+
+	KUNIT_EXPECT_FALSE(test, mt7915_mcu2_radar(test, dev,
+						   MT_RDD_IDX_BACKGROUND));
+	KUNIT_EXPECT_FALSE(test, mt7915_mcu2_radar(test, dev, 3));
+	KUNIT_EXPECT_EQ(test, dev->hw_pattern, 4);
+}
+
+static void mt7915_mcu2_ps_event(struct kunit *test, struct mt7915_dev *dev,
+				 u16 wcid, bool ps)
+{
+	struct mt7915_mcu_ps_notify ev = {
+		.wtbl_lower = wcid & 0xff,
+		.wtbl_higher = wcid >> 8,
+		.ps_bit = ps ? 0x80 : 0,	/* any non-zero value */
+	};
+
+	mt7915_mcu2_rx_event(test, dev, mt7915_mcu2_event(test,
+			MCU_EVENT_EXT, MCU_EXT_EVENT_PS_SYNC, 0,
+			&ev, sizeof(ev)));
+}
+
+static void mt7915_mcu2_drop_wcids(void *data)
+{
+	struct mt7915_dev *dev = data;
+
+	RCU_INIT_POINTER(dev->mt76.wcid[0x23], NULL);
+	RCU_INIT_POINTER(dev->mt76.wcid[0x123], NULL);
+	RCU_INIT_POINTER(dev->mt76.wcid[0x40], NULL);
+}
+
+/* The firmware tells which station went to sleep or woke up by its 16-bit
+ * WTBL index, split in two bytes; the station's power save flag follows.
+ * Entries that aren't stations are left alone.
+ */
+static void mt7915_mcu2_events_ps_sync(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct ieee80211_vif *vif = mt7915_mcu2_vif(test, dev);
+	struct mt7915_sta *hi, *lo, *notsta;
+
+	hi = (void *)mt7915_mcu2_sta(test, vif, 0x123)->drv_priv;
+	lo = (void *)mt7915_mcu2_sta(test, vif, 0x23)->drv_priv;
+	notsta = (void *)mt7915_mcu2_sta(test, vif, 0x40)->drv_priv;
+	notsta->wcid.sta = 0;
+	rcu_assign_pointer(dev->mt76.wcid[0x123], &hi->wcid);
+	rcu_assign_pointer(dev->mt76.wcid[0x23], &lo->wcid);
+	rcu_assign_pointer(dev->mt76.wcid[0x40], &notsta->wcid);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_mcu2_drop_wcids, dev), 0);
+
+	mt7915_mcu2_ps_event(test, dev, 0x123, true);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_PS, &hi->wcid.flags));
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &lo->wcid.flags));
+
+	mt7915_mcu2_ps_event(test, dev, 0x123, false);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &hi->wcid.flags));
+
+	mt7915_mcu2_ps_event(test, dev, 0x40, true);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS,
+					  &notsta->wcid.flags));
+	/* an index nothing is registered at */
+	mt7915_mcu2_ps_event(test, dev, 0x124, true);
+}
+
+static void mt7915_mcu2_log_event(struct kunit *test, struct mt7915_dev *dev,
+				  u8 s2d, const void *data, int len)
+{
+	struct {
+		struct mt76_connac2_mcu_rxd rxd;
+		u8 data[32];
+	} ev = {};
+
+	ev.rxd.s2d_index = s2d;
+	memcpy(ev.data, data, len);
+	mt7915_mcu2_rx_event(test, dev, mt7915_mcu2_event(test,
+			MCU_EVENT_EXT, MCU_EXT_EVENT_FW_LOG_2_HOST, 0, &ev,
+			sizeof(ev.rxd) + len));
+}
+
+/* Firmware log lines from the WM, the WA or elsewhere go to the kernel log,
+ * binary WM logs to debugfs; either way the event is consumed.
+ */
+static void mt7915_mcu2_events_log(struct kunit *test)
+{
+	static const char line[] = "milkflint: hello from the firmware";
+	__le32 bin[4] = { cpu_to_le32(MT7915_MCU2_FW_BIN_LOG_MAGIC) };
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+
+	mt7915_mcu2_log_event(test, dev, 0, line, 32);
+	mt7915_mcu2_log_event(test, dev, 0, bin, sizeof(bin));
+	mt7915_mcu2_log_event(test, dev, 2, line, 32);
+	mt7915_mcu2_log_event(test, dev, 7, line, 32);
+}
+
+/* Channel switch and color change announcements end in mac80211 for the
+ * band they name; with no interface up there's nothing to finish, and
+ * reports for bands the chip doesn't have are dropped.
+ */
+static void mt7915_mcu2_events_csa_bcc(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu_csa_notify csa = {};
+	struct mt7915_mcu_bcc_notify bcc = {};
+	int band;
+
+	mt7915_mcu2_band1_phy(test, dev);
+	for (band = 0; band < 3; band++) {
+		csa.band_idx = band;
+		csa.csa_count = 0;
+		mt7915_mcu2_rx_event(test, dev, mt7915_mcu2_event(test,
+				MCU_EVENT_EXT, MCU_EXT_EVENT_CSA_NOTIFY, 0,
+				&csa, sizeof(csa)));
+		bcc.band_idx = band;
+		mt7915_mcu2_rx_event(test, dev, mt7915_mcu2_event(test,
+				MCU_EVENT_EXT, MCU_EXT_EVENT_BCC_NOTIFY, 0,
+				&bcc, sizeof(bcc)));
+	}
+}
