+/* An MT7986 with an @type interface (omac 0) on channel 6 (20 MHz) or 36
+ * (80 MHz), and a legacy station of it.
+ */
+static void mt7915_test_init(struct kunit *test, struct mt7915_test_ctx *c,
+			     enum nl80211_band band, enum nl80211_iftype type)
+{
+	c->dev = mt7915_test_dev(test);
+	c->fake = mt76_test_fake;
+	c->phy = &c->dev->phy;
+	if (band == NL80211_BAND_2GHZ)
+		mt7915_test_chandef(test, c->phy, band, 6,
+				    NL80211_CHAN_WIDTH_20, 6);
+	else
+		mt7915_test_chandef(test, c->phy, band, 36,
+				    NL80211_CHAN_WIDTH_80, 42);
+	c->vif = mt7915_test_vif(test, c->phy, type, HW_BSSID_0);
+	c->mvif = (struct mt7915_vif *)c->vif->drv_priv;
+	c->sta = mt7915_test_sta(test, c->vif);
+	c->msta = (struct mt7915_sta *)c->sta->drv_priv;
+}
