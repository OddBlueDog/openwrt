+/* An associating HE station: every TLV, in the order firmware depends on,
+ * then its VOW group.
+ */
+static void mt7915_test_add_sta_full(struct kunit *test)
+{
+	static const u16 order[] = {
+		STA_REC_BASIC, STA_REC_BF, STA_REC_HT, STA_REC_VHT,
+		STA_REC_APPS, STA_REC_WTBL, STA_REC_HW_AMSDU, STA_REC_HE,
+		STA_REC_MURU, STA_REC_BFEE,
+	};
+	struct sta_rec_uapsd *uapsd;
+	struct sta_rec_basic *basic;
+	struct sta_rec_vht *vht;
+	struct sta_rec_ht *ht;
+	struct wtbl_generic *gen;
+	struct wtbl_ht *wht;
+	struct wtbl_vht *wvht;
+	struct wtbl_smps *smps;
+	struct wtbl_rx *rx;
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+	struct sta_req_hdr *hdr;
+	u16 tags[16];
+	int i, n;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_ht(c.sta);
+	mt7915_test_vht(c.sta);
+	mt7915_test_he(c.sta);
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_80;
+	c.sta->deflink.agg.max_amsdu_len = IEEE80211_MAX_MPDU_LEN_VHT_7991;
+	c.sta->uapsd_queues = IEEE80211_WMM_IE_STA_QOSINFO_AC_VO |
+			      IEEE80211_WMM_IE_STA_QOSINFO_AC_BE;
+	c.sta->max_sp = 2;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_sta(c.dev, c.vif, c.sta,
+			CONN_STATE_CONNECT, true), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 2);
+	msg = mt76_test_msg(c.fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	hdr = mt7915_test_payload(msg, struct sta_req_hdr);
+	KUNIT_ASSERT_NOT_NULL(test, hdr);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_lo, MT7915_TEST_STA_WCID & 0xff);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_hi, MT7915_TEST_STA_WCID >> 8);
+	KUNIT_EXPECT_EQ(test, hdr->muar_idx, HW_BSSID_0);
+
+	n = mt7915_test_tags(test, msg, tags, ARRAY_SIZE(tags));
+	KUNIT_ASSERT_EQ(test, n, (int)ARRAY_SIZE(order));
+	for (i = 0; i < n; i++)
+		KUNIT_EXPECT_EQ_MSG(test, tags[i], order[i], "TLV %d", i);
+
+	basic = mt7915_test_tlv(test, msg, STA_REC_BASIC, struct sta_rec_basic);
+	KUNIT_ASSERT_NOT_NULL(test, basic);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(basic->conn_type),
+			CONNECTION_INFRA_STA);
+	KUNIT_EXPECT_EQ(test, basic->conn_state, CONN_STATE_CONNECT);
+	KUNIT_EXPECT_EQ(test, basic->qos, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->aid), 3);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->extra_info),
+			EXTRA_INFO_VER | EXTRA_INFO_NEW);
+	KUNIT_EXPECT_MEMEQ(test, basic->peer_addr, mt7915_test_peer_addr,
+			   ETH_ALEN);
+
+	ht = mt7915_test_tlv(test, msg, STA_REC_HT, struct sta_rec_ht);
+	KUNIT_ASSERT_NOT_NULL(test, ht);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ht->ht_cap),
+			c.sta->deflink.ht_cap.cap);
+	vht = mt7915_test_tlv(test, msg, STA_REC_VHT, struct sta_rec_vht);
+	KUNIT_ASSERT_NOT_NULL(test, vht);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(vht->vht_cap),
+			c.sta->deflink.vht_cap.cap);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(vht->vht_rx_mcs_map), 0xfffa);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(vht->vht_tx_mcs_map), 0xfff5);
+	uapsd = mt7915_test_tlv(test, msg, STA_REC_APPS, struct sta_rec_uapsd);
+	KUNIT_ASSERT_NOT_NULL(test, uapsd);
+	KUNIT_EXPECT_EQ(test, uapsd->dac_map, BIT(3) | BIT(1));
+	KUNIT_EXPECT_EQ(test, uapsd->tac_map, BIT(3) | BIT(1));
+	KUNIT_EXPECT_EQ(test, uapsd->max_sp, 2);
+
+	KUNIT_EXPECT_EQ(test, mt7915_test_wtbl_hdr(test, msg)->operation,
+			WTBL_RESET_AND_SET);
+	gen = mt7915_test_wtbl(test, msg, WTBL_GENERIC, struct wtbl_generic);
+	KUNIT_ASSERT_NOT_NULL(test, gen);
+	KUNIT_EXPECT_MEMEQ(test, gen->peer_addr, mt7915_test_peer_addr,
+			   ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, gen->muar_idx, HW_BSSID_0);
+	KUNIT_EXPECT_EQ(test, gen->qos, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(gen->partial_aid), 3);
+	rx = mt7915_test_wtbl(test, msg, WTBL_RX, struct wtbl_rx);
+	KUNIT_ASSERT_NOT_NULL(test, rx);
+	KUNIT_EXPECT_EQ(test, rx->rca1, 0);
+	wht = mt7915_test_wtbl(test, msg, WTBL_HT, struct wtbl_ht);
+	KUNIT_ASSERT_NOT_NULL(test, wht);
+	KUNIT_EXPECT_EQ(test, wht->ht, 1);
+	KUNIT_EXPECT_EQ(test, wht->ldpc, 1);
+	KUNIT_EXPECT_EQ(test, wht->af, 7);
+	KUNIT_EXPECT_EQ(test, wht->mm, IEEE80211_HT_MPDU_DENSITY_4);
+	wvht = mt7915_test_wtbl(test, msg, WTBL_VHT, struct wtbl_vht);
+	KUNIT_ASSERT_NOT_NULL(test, wvht);
+	KUNIT_EXPECT_EQ(test, wvht->vht, 1);
+	KUNIT_EXPECT_EQ(test, wvht->ldpc, 1);
+	smps = mt7915_test_wtbl(test, msg, WTBL_SMPS, struct wtbl_smps);
+	KUNIT_ASSERT_NOT_NULL(test, smps);
+	KUNIT_EXPECT_EQ(test, smps->smps, 0);
+
+	msg = mt76_test_msg(c.fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_DRR_CTRL));
+	KUNIT_EXPECT_EQ(test, msg->data[4], MT7915_TEST_STA_WCID & 0xff);
+	KUNIT_EXPECT_EQ(test, msg->data[6], MT7915_TEST_STA_WCID >> 8);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(*(__le32 *)(msg->data + 12)), 0);
+}
