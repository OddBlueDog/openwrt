+/* Disabling beacons sends an empty, disabled offload TLV; a
+ * non-transmitted BSS of a multiple BSSID set sends nothing.
+ */
+static void mt7915_test_add_beacon_disable(struct kunit *test)
+{
+	struct ieee80211_hw *hw;
+	struct bss_info_bcn *bcn;
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	hw = c.phy->mt76->hw;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_beacon(hw, c.vif, false,
+			BSS_CHANGED_BEACON_ENABLED), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 1);
+	msg = mt76_test_msg(c.fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(BSS_INFO_UPDATE));
+	KUNIT_EXPECT_EQ(test, mt7915_test_ntlv(test, msg->data, msg->len), 1);
+	bcn = mt7915_test_tlv(test, msg, BSS_INFO_OFFLOAD, struct bss_info_bcn);
+	KUNIT_ASSERT_NOT_NULL(test, bcn);
+	KUNIT_EXPECT_EQ(test, bcn->enable, 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(bcn->sub_ntlv), 0);
+
+	c.vif->bss_conf.nontransmitted = true;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_beacon(hw, c.vif, true,
+			BSS_CHANGED_BEACON), 0);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 1);
+
+	c.vif->bss_conf.nontransmitted = false;
+	c.fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_add_beacon(hw, c.vif, false,
+			BSS_CHANGED_BEACON_ENABLED), -EIO);
+}
