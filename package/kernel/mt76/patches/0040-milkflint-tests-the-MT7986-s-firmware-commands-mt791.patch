+/* MU settings for APs and stations: DL OFDMA always, UL MU-MIMO on this
+ * chip, DL MU-MIMO if we can MU beamform, and the station's HE MU
+ * capabilities.
+ */
+static void mt7915_test_sta_muru(struct kunit *test)
+{
+	struct ieee80211_he_cap_elem *elem;
+	struct sta_rec_muru *muru;
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	muru = mt7915_test_muru_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, muru);
+	KUNIT_EXPECT_TRUE(test, muru->cfg.ofdma_dl_en);
+	KUNIT_EXPECT_FALSE(test, muru->cfg.ofdma_ul_en);
+	KUNIT_EXPECT_TRUE(test, muru->cfg.mimo_dl_en);
+	KUNIT_EXPECT_TRUE(test, muru->cfg.mimo_ul_en);
+	KUNIT_EXPECT_FALSE(test, muru->mimo_dl.vht_mu_bfee);
+	KUNIT_EXPECT_FALSE(test, muru->ofdma_ul.mu_cascading);
+
+	/* DL MU-MIMO needs one of our MU beamforming capabilities */
+	memset(&c.mvif->cap, 0, sizeof(c.mvif->cap));
+	muru = mt7915_test_muru_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, muru);
+	KUNIT_EXPECT_FALSE(test, muru->cfg.mimo_dl_en);
+	c.mvif->cap.he_mu_ebfer = true;
+	muru = mt7915_test_muru_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, muru);
+	KUNIT_EXPECT_TRUE(test, muru->cfg.mimo_dl_en);
+	c.mvif->cap.he_mu_ebfer = false;
+	c.mvif->cap.vht_mu_ebfer = true;
+	muru = mt7915_test_muru_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, muru);
+	KUNIT_EXPECT_TRUE(test, muru->cfg.mimo_dl_en);
+	c.mvif->cap.vht_mu_ebfer = false;
+	c.mvif->cap.vht_mu_ebfee = true;
+	muru = mt7915_test_muru_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, muru);
+	KUNIT_EXPECT_TRUE(test, muru->cfg.mimo_dl_en);
+
+	/* a VHT MU beamformee */
+	mt7915_test_vht(c.sta);
+	c.sta->deflink.vht_cap.cap |= IEEE80211_VHT_CAP_MU_BEAMFORMEE_CAPABLE;
+	muru = mt7915_test_muru_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, muru);
+	KUNIT_EXPECT_TRUE(test, muru->mimo_dl.vht_mu_bfee);
+
+	/* HE MU capabilities */
+	c.sta->deflink.he_cap.has_he = true;
+	elem = &c.sta->deflink.he_cap.he_cap_elem;
+	elem->mac_cap_info[1] =
+		u8_encode_bits(2, IEEE80211_HE_MAC_CAP1_TF_MAC_PAD_DUR_MASK);
+	elem->mac_cap_info[2] = IEEE80211_HE_MAC_CAP2_MU_CASCADING;
+	elem->mac_cap_info[3] = IEEE80211_HE_MAC_CAP3_OFDMA_RA |
+				IEEE80211_HE_MAC_CAP3_RX_CTRL_FRAME_TO_MULTIBSS;
+	elem->phy_cap_info[1] =
+		u8_encode_bits(3, IEEE80211_HE_PHY_CAP1_PREAMBLE_PUNC_RX_MASK);
+	elem->phy_cap_info[2] = IEEE80211_HE_PHY_CAP2_UL_MU_FULL_MU_MIMO |
+				IEEE80211_HE_PHY_CAP2_UL_MU_PARTIAL_MU_MIMO;
+	elem->phy_cap_info[6] = IEEE80211_HE_PHY_CAP6_PARTIAL_BANDWIDTH_DL_MUMIMO;
+	elem->phy_cap_info[8] = IEEE80211_HE_PHY_CAP8_20MHZ_IN_40MHZ_HE_PPDU_IN_2G |
+				IEEE80211_HE_PHY_CAP8_20MHZ_IN_160MHZ_HE_PPDU |
+				IEEE80211_HE_PHY_CAP8_80MHZ_IN_160MHZ_HE_PPDU;
+	muru = mt7915_test_muru_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, muru);
+	KUNIT_EXPECT_TRUE(test, muru->mimo_dl.partial_bw_dl_mimo);
+	KUNIT_EXPECT_TRUE(test, muru->mimo_ul.full_ul_mimo);
+	KUNIT_EXPECT_TRUE(test, muru->mimo_ul.partial_ul_mimo);
+	KUNIT_EXPECT_EQ(test, muru->ofdma_dl.punc_pream_rx, 3);
+	KUNIT_EXPECT_TRUE(test, muru->ofdma_dl.he_20m_in_40m_2g);
+	KUNIT_EXPECT_TRUE(test, muru->ofdma_dl.he_20m_in_160m);
+	KUNIT_EXPECT_TRUE(test, muru->ofdma_dl.he_80m_in_160m);
+	KUNIT_EXPECT_EQ(test, muru->ofdma_ul.t_frame_dur, 2);
+	KUNIT_EXPECT_EQ(test, muru->ofdma_ul.mu_cascading, 1);
+	KUNIT_EXPECT_EQ(test, muru->ofdma_ul.uo_ra, 1);
+	KUNIT_EXPECT_EQ(test, muru->ofdma_ul.rx_ctrl_frame_to_mbss, 1);
+
+	/* stations have one too, nothing else does */
+	c.vif->type = NL80211_IFTYPE_STATION;
+	KUNIT_EXPECT_NOT_NULL(test, mt7915_test_muru_tlv(test, &c));
+	c.vif->type = NL80211_IFTYPE_ADHOC;
+	KUNIT_EXPECT_NULL(test, mt7915_test_muru_tlv(test, &c));
+}
