+	wiphy->bands[NL80211_BAND_5GHZ] = &dev->mphy.sband_5g.sband;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_mcu2_drop_bands, wiphy), 0);
+}
+
