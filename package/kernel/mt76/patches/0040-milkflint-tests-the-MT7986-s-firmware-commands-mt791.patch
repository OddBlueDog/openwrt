+
+/* the last message sent with @cmd, which must be @len bytes long */
+static struct mt76_test_msg *
+mt7915_mcu2_msg(struct kunit *test, int cmd, int len)
+{
+	struct mt76_test_msg *msg = mt76_test_find_msg(mt76_test_fake, cmd);
+
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_ASSERT_EQ(test, msg->len, len);
+	return msg;
+}
+
+/* the @i-th message sent (0: the first): command @cmd, @len bytes */
+static struct mt76_test_msg *
+mt7915_mcu2_nth(struct kunit *test, unsigned int i, int cmd, int len)
+{
+	struct mt76_test_msg *msg = mt76_test_msg(mt76_test_fake, i);
+
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_ASSERT_EQ(test, msg->cmd, cmd);
+	KUNIT_ASSERT_EQ(test, msg->len, len);
+	return msg;
+}
+
+struct mt7915_mcu2_blob {
+	int len;
+	u8 data[];
+};
+
+static void mt7915_mcu2_reply_hook(struct mt76_test_fake *fake,
+				   const struct mt76_test_msg *msg,
+				   struct sk_buff *skb)
+{
+	struct mt7915_mcu2_blob *blob = fake->priv;
+
+	skb_put_data(skb, blob->data, blob->len);
+}
+
+/* the firmware answers every message with @len bytes of @data */
+static void mt7915_mcu2_reply(struct kunit *test, const void *data, int len)
+{
+	struct mt76_test_fake *fake = mt76_test_fake;
+	struct mt7915_mcu2_blob *blob;
+
+	KUNIT_ASSERT_LE(test, len, 2048);
+	blob = kunit_kmalloc(test, sizeof(*blob) + len, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, blob);
+	blob->len = len;
+	if (len)
+		memcpy(blob->data, data, len);
+	fake->priv = blob;
+	fake->reply = mt7915_mcu2_reply_hook;
+}
+
+/* an EEPROM image of the chip's size, all zeros */
+static u8 *mt7915_mcu2_eeprom(struct kunit *test, struct mt7915_dev *dev)
+{
+	dev->mt76.eeprom.size = mt7915_eeprom_size(dev);
+	dev->mt76.eeprom.data = kunit_kzalloc(test, dev->mt76.eeprom.size,
+					      GFP_KERNEL);
