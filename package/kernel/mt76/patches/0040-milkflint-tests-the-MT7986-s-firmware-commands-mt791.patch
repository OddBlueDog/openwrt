+struct mt7915_test_twt_req {
+	u8 tbl_idx;
+	u8 cmd;
+	u8 own_mac_idx;
+	u8 flowid;
+	__le16 peer_id;
+	u8 duration;
+	u8 bss_idx;
+	__le64 start_tsf;
+	__le16 mantissa;
+	u8 exponent;
+	u8 is_ap;
+	u8 agrt_params;
+	u8 rsv[23];
+} __packed;
+
+/* A TWT agreement as the AP sets it up: table slot, flow, peer, wake time
+ * and interval, and the trigger/announce/protection flags.
+ */
+static void mt7915_test_twt_agrt_update(struct kunit *test)
+{
+	struct mt7915_test_twt_req *req;
+	struct mt7915_twt_flow flow = {
+		.tsf = 0x123456789aULL,
+		.duration = 200,
+		.wcid = MT7915_TEST_STA_WCID,
+		.mantissa = cpu_to_le16(512),
+		.exp = 10,
+		.table_id = 5,
+		.id = 3,
+		.protection = 1,
+		.flowtype = 0,
+		.trigger = 1,
+	};
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	c.mvif->mt76.omac_idx = MT7915_TEST_EXT_BSSID(2);
+	c.mvif->mt76.idx = 4;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_twt_agrt_update(c.dev, c.mvif, &flow,
+			MCU_TWT_AGRT_ADD), 0);
+	msg = mt76_test_msg(c.fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(TWT_AGRT_UPDATE));
+	req = mt7915_test_payload(msg, struct mt7915_test_twt_req);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, msg->len, (int)sizeof(*req));
+	KUNIT_EXPECT_EQ(test, req->tbl_idx, 5);
+	KUNIT_EXPECT_EQ(test, req->cmd, MCU_TWT_AGRT_ADD);
+	KUNIT_EXPECT_EQ(test, req->own_mac_idx, MT7915_TEST_EXT_BSSID(2));
+	KUNIT_EXPECT_EQ(test, req->flowid, 3);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->peer_id), MT7915_TEST_STA_WCID);
+	KUNIT_EXPECT_EQ(test, req->duration, 200);
+	KUNIT_EXPECT_EQ(test, req->bss_idx, 4);
+	KUNIT_EXPECT_EQ(test, le64_to_cpu(req->start_tsf), 0x123456789aULL);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->mantissa), 512);
+	KUNIT_EXPECT_EQ(test, req->exponent, 10);
+	KUNIT_EXPECT_EQ(test, req->is_ap, 1);
+	/* protect | announce | trigger */
+	KUNIT_EXPECT_EQ(test, req->agrt_params, 0x7);
+
+	/* unannounced, untriggered, unprotected */
+	flow.protection = 0;
+	flow.flowtype = 1;
+	flow.trigger = 0;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_twt_agrt_update(c.dev, c.mvif, &flow,
+			MCU_TWT_AGRT_DELETE), 0);
+	req = mt7915_test_payload(mt76_test_msg(c.fake, 1),
+				  struct mt7915_test_twt_req);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->cmd, MCU_TWT_AGRT_DELETE);
+	KUNIT_EXPECT_EQ(test, req->agrt_params, 0);
+	flow.protection = 1;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_twt_agrt_update(c.dev, c.mvif, &flow,
+			MCU_TWT_AGRT_ADD), 0);
+	req = mt7915_test_payload(mt76_test_msg(c.fake, 2),
+				  struct mt7915_test_twt_req);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->agrt_params, BIT(2));
+}
