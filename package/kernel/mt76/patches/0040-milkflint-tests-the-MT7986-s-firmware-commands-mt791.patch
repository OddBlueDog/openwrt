+/* An rx BA session: recipient entries, with the reset by peer address and
+ * TID set up; A-MSDU is not touched.
+ */
+static void mt7915_test_add_rx_ba(struct kunit *test)
+{
+	struct ieee80211_ampdu_params params = {
+		.tid = 2,
+		.ssn = 7,
+		.buf_size = 256,
+	};
+	struct mt7915_test_ctx c;
+	struct sta_rec_ba *ba;
+	struct wtbl_ba *wba;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	params.sta = c.sta;
+	c.msta->wcid.amsdu = true;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_rx_ba(c.dev, &params, true), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 2);
+	KUNIT_EXPECT_TRUE(test, c.msta->wcid.amsdu);
+	wba = mt7915_test_wtbl(test, mt76_test_msg(c.fake, 0), WTBL_BA,
+			       struct wtbl_ba);
+	KUNIT_ASSERT_NOT_NULL(test, wba);
+	KUNIT_EXPECT_EQ(test, wba->tid, 2);
+	KUNIT_EXPECT_EQ(test, wba->ba_type, MT_BA_TYPE_RECIPIENT);
+	KUNIT_EXPECT_MEMEQ(test, wba->peer_addr, mt7915_test_peer_addr,
+			   ETH_ALEN);
+	KUNIT_EXPECT_EQ(test, wba->rst_ba_tid, 2);
+	KUNIT_EXPECT_EQ(test, wba->rst_ba_sel, RST_BA_MAC_TID_MATCH);
+	KUNIT_EXPECT_EQ(test, wba->rst_ba_sb, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(wba->ba_winsize), 256);
+	ba = mt7915_test_tlv(test, mt76_test_msg(c.fake, 1), STA_REC_BA,
+			     struct sta_rec_ba);
+	KUNIT_ASSERT_NOT_NULL(test, ba);
+	KUNIT_EXPECT_EQ(test, ba->ba_type, MT_BA_TYPE_RECIPIENT);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, BIT(2));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->ssn), 7);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->winsize), 256);
+}
