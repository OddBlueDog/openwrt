+/* Several VHT rates but a forced long GI: no fixed rate, the GI (off) is
+ * fixed; with the mask back to default, nothing is fixed at all.
+ */
+static void mt7915_test_rate_fixed_vht_gi(struct kunit *test)
+{
+	struct cfg80211_bitrate_mask *mask;
+	struct mt7915_test_ctx c;
+	struct sta_phy *phy;
+	u32 addr;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	c.phy->mt76->antenna_mask = 0x6;
+	mt7915_test_ht(c.sta);
+	mt7915_test_vht(c.sta);
+	mask = &c.mvif->bitrate_mask;
+	mask->control[NL80211_BAND_5GHZ].gi = NL80211_TXRATE_FORCE_LGI;
+	addr = MT_WTBL_LMAC_OFFS(MT7915_TEST_STA_WCID & 0x7f, 7);
+	mt76_wr(c.dev, addr, 0xf000 | 0x0f00);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_rate_ctrl(c.dev, c.vif, c.sta,
+			&c.msta->wcid, false), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 3);
+	phy = mt7915_test_fixed_phy(test, &c, 1, RATE_PARAM_FIXED_GI);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	KUNIT_EXPECT_EQ(test, phy->sgi, 0);
+	mt7915_test_expect_spe(test, &c, 2);
+	/* only the GI bits change */
+	KUNIT_EXPECT_EQ(test, mt76_rr(c.dev, addr), 0x0f00);
+
+	mask->control[NL80211_BAND_5GHZ].gi = NL80211_TXRATE_DEFAULT_GI;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_rate_ctrl(c.dev, c.vif, c.sta,
+			&c.msta->wcid, false), 0);
+	KUNIT_EXPECT_EQ(test, c.fake->n_msgs, 4);
+
+	/* a single VHT MCS, of the second stream: the MCS alone */
+	memset(mask->control[NL80211_BAND_5GHZ].vht_mcs, 0,
+	       sizeof(mask->control[NL80211_BAND_5GHZ].vht_mcs));
+	mask->control[NL80211_BAND_5GHZ].vht_mcs[1] = BIT(3);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_rate_ctrl(c.dev, c.vif, c.sta,
+			&c.msta->wcid, false), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 7);
+	phy = mt7915_test_fixed_phy(test, &c, 5, RATE_PARAM_FIXED_MCS);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	KUNIT_EXPECT_EQ(test, phy->mcs, 3);
+	KUNIT_EXPECT_EQ(test, phy->sgi, 0);
+	mt7915_test_expect_spe(test, &c, 6);
+}
