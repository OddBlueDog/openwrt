+/* Rate adaptation for the BSS: AP or ad-hoc, one stream per antenna, and
+ * the fixed algorithm parameters.
+ */
+static void mt7915_test_bss_ra(struct kunit *test)
+{
+	struct mt7915_test_ctx c;
+	struct bss_info_ra *ra;
+	struct sk_buff *skb;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	skb = mt7915_test_bss_req(test, &c);
+	mt7915_mcu_bss_ra_tlv(skb, c.vif, c.phy);
+	ra = mt7915_test_skb_tlv(test, skb, BSS_INFO_RA, struct bss_info_ra);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ra->len), (int)sizeof(*ra));
+	KUNIT_EXPECT_EQ(test, ra->op_mode, 1);
+	KUNIT_EXPECT_EQ(test, ra->adhoc_en, 0);
+	KUNIT_EXPECT_EQ(test, ra->short_preamble, 1);
+	KUNIT_EXPECT_EQ(test, ra->tx_streams, 4);
+	KUNIT_EXPECT_EQ(test, ra->rx_streams, 4);
+	KUNIT_EXPECT_EQ(test, ra->algo, 4);
+	KUNIT_EXPECT_EQ(test, ra->train_up_rule, 2);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ra->train_up_high_thres), 110);
+	KUNIT_EXPECT_EQ(test, (s16)le16_to_cpu(ra->train_up_rule_rssi), -70);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ra->low_traffic_thres), 2);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->phy_cap), 0xfdf);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->interval), 500);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->fast_interval), 100);
+
+	c.vif->type = NL80211_IFTYPE_ADHOC;
+	c.phy->mt76->antenna_mask = 0x3;
+	skb = mt7915_test_bss_req(test, &c);
+	mt7915_mcu_bss_ra_tlv(skb, c.vif, c.phy);
+	ra = mt7915_test_skb_tlv(test, skb, BSS_INFO_RA, struct bss_info_ra);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, ra->op_mode, 0);
+	KUNIT_EXPECT_EQ(test, ra->adhoc_en, 1);
+	KUNIT_EXPECT_EQ(test, ra->tx_streams, 2);
+	KUNIT_EXPECT_EQ(test, ra->rx_streams, 2);
+}
