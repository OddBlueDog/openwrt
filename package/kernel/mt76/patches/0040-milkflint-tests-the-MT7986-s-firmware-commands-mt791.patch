+/* Each HT and VHT capability of the station maps to its own rate control
+ * flag.
+ */
+static void mt7915_test_rate_ctrl_caps(struct kunit *test)
+{
+	static const struct {
+		u16 ht;
+		u32 vht, cap;
+	} caps[] = {
+		{ IEEE80211_HT_CAP_SGI_20, 0, STA_CAP_SGI_20 },
+		{ IEEE80211_HT_CAP_SGI_40, 0, STA_CAP_SGI_40 },
+		{ IEEE80211_HT_CAP_TX_STBC, 0, STA_CAP_TX_STBC },
+		{ 2 << IEEE80211_HT_CAP_RX_STBC_SHIFT, 0, STA_CAP_RX_STBC },
+		{ IEEE80211_HT_CAP_LDPC_CODING, 0, STA_CAP_LDPC },
+		{ 0, IEEE80211_VHT_CAP_SHORT_GI_80, STA_CAP_VHT_SGI_80 },
+		{ 0, IEEE80211_VHT_CAP_SHORT_GI_160, STA_CAP_VHT_SGI_160 },
+		{ 0, IEEE80211_VHT_CAP_TXSTBC, STA_CAP_VHT_TX_STBC },
+		{ 0, IEEE80211_VHT_CAP_RXSTBC_3, STA_CAP_VHT_RX_STBC },
+		{ 0, IEEE80211_VHT_CAP_RXLDPC, STA_CAP_VHT_LDPC },
+	};
+	struct mt7915_test_ctx c;
+	struct sta_rec_ra *ra;
+	int i;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	c.sta->wme = false;
+	c.sta->deflink.ht_cap.ht_supported = true;
+	c.sta->deflink.vht_cap.vht_supported = true;
+	for (i = 0; i < ARRAY_SIZE(caps); i++) {
+		c.sta->deflink.ht_cap.cap = caps[i].ht;
+		c.sta->deflink.vht_cap.cap = caps[i].vht;
+		ra = mt7915_test_ra_tlv(test, &c);
+		KUNIT_ASSERT_NOT_NULL(test, ra);
+		KUNIT_EXPECT_EQ_MSG(test, le32_to_cpu(ra->sta_cap),
+				    STA_CAP_HT | STA_CAP_VHT | caps[i].cap,
+				    "cap %d", i);
+	}
+}
