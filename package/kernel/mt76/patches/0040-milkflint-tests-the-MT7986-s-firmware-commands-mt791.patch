--- a/mt7915/mcu.c
+++ b/mt7915/mcu.c
@@ -4408,4 +4408,5 @@ int mt7915_mcu_rf_regval(struct mt7915_dev *dev, u32 regidx, u32 *val, bool set)
 
 #if IS_ENABLED(CONFIG_MT76_KUNIT_TEST)
 #include "tests/mcu-test.c"
