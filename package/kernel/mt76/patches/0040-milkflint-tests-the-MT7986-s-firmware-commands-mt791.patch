+/* --- station records ------------------------------------------------------ */
+
+/* The interface's own entry (broadcast/multicast, or the AP for a
+ * station): basic and WTBL TLVs, then the BSS group for airtime fairness.
+ */
+static void mt7915_test_add_sta_vif(struct kunit *test)
+{
+	struct wtbl_hdr_trans *htr;
+	struct wtbl_generic *gen;
+	struct wtbl_req_hdr *wtbl;
+	struct sta_rec_basic *basic;
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+	struct sta_req_hdr *hdr;
+	struct wtbl_rx *rx;
+	u16 tags[8];
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	c.mvif->mt76.omac_idx = HW_BSSID_1;
+	c.mvif->mt76.idx = 2;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_sta(c.dev, c.vif, NULL,
+			CONN_STATE_PORT_SECURE, true), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 2);
+	msg = mt76_test_msg(c.fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	hdr = mt7915_test_payload(msg, struct sta_req_hdr);
+	KUNIT_ASSERT_NOT_NULL(test, hdr);
+	KUNIT_EXPECT_EQ(test, hdr->bss_idx, 2);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_lo, MT7915_TEST_VIF_WCID & 0xff);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_hi, MT7915_TEST_VIF_WCID >> 8);
+	/* not a peer: the broadcast MUAR entry */
+	KUNIT_EXPECT_EQ(test, hdr->muar_idx, 0xe);
+	KUNIT_ASSERT_EQ(test, mt7915_test_tags(test, msg, tags, 8), 2);
+	KUNIT_EXPECT_EQ(test, tags[0], STA_REC_BASIC);
+	KUNIT_EXPECT_EQ(test, tags[1], STA_REC_WTBL);
+
+	basic = mt7915_test_tlv(test, msg, STA_REC_BASIC, struct sta_rec_basic);
+	KUNIT_ASSERT_NOT_NULL(test, basic);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(basic->conn_type),
+			CONNECTION_INFRA_BC);
+	KUNIT_EXPECT_EQ(test, basic->conn_state, CONN_STATE_PORT_SECURE);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(basic->extra_info),
+			EXTRA_INFO_VER | EXTRA_INFO_NEW);
+	KUNIT_EXPECT_TRUE(test, is_broadcast_ether_addr(basic->peer_addr));
+
+	wtbl = mt7915_test_wtbl_hdr(test, msg);
+	KUNIT_EXPECT_EQ(test, wtbl->operation, WTBL_RESET_AND_SET);
+	KUNIT_EXPECT_EQ(test, wtbl->wlan_idx_lo, MT7915_TEST_VIF_WCID & 0xff);
+	KUNIT_EXPECT_EQ(test, wtbl->wlan_idx_hi, MT7915_TEST_VIF_WCID >> 8);
+	gen = mt7915_test_wtbl(test, msg, WTBL_GENERIC, struct wtbl_generic);
+	KUNIT_ASSERT_NOT_NULL(test, gen);
+	KUNIT_EXPECT_TRUE(test, is_broadcast_ether_addr(gen->peer_addr));
+	KUNIT_EXPECT_EQ(test, gen->muar_idx, 0xe);
+	rx = mt7915_test_wtbl(test, msg, WTBL_RX, struct wtbl_rx);
+	KUNIT_ASSERT_NOT_NULL(test, rx);
+	KUNIT_EXPECT_EQ(test, rx->rca1, 1);
+	KUNIT_EXPECT_EQ(test, rx->rca2, 1);
+	KUNIT_EXPECT_EQ(test, rx->rv, 1);
+	htr = mt7915_test_wtbl(test, msg, WTBL_HDR_TRANS,
+			       struct wtbl_hdr_trans);
+	KUNIT_ASSERT_NOT_NULL(test, htr);
+	KUNIT_EXPECT_EQ(test, htr->from_ds, 1);
+	KUNIT_EXPECT_EQ(test, htr->to_ds, 0);
+	KUNIT_EXPECT_EQ(test, htr->no_rx_trans, 1);
+	KUNIT_EXPECT_NULL(test, mt7915_test_wtbl(test, msg, WTBL_HT,
+						 struct wtbl_ht));
+
+	msg = mt76_test_msg(c.fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_DRR_CTRL));
+	KUNIT_EXPECT_EQ(test, msg->len, 24);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(*(__le32 *)msg->data), 1);
+	KUNIT_EXPECT_EQ(test, msg->data[4], MT7915_TEST_VIF_WCID & 0xff);
+	KUNIT_EXPECT_EQ(test, msg->data[6], MT7915_TEST_VIF_WCID >> 8);
+	/* VOW group of hardware BSS 1 on band 0 */
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(*(__le32 *)(msg->data + 12)), 1);
