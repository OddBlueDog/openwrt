+/* With firmware scene detection (the default), only detection and spatial
+ * reuse itself are switched; firmware adjusts the PD thresholds alone.
+ */
+static void mt7915_test_obss_spr_scene_detect(struct kunit *test)
+{
+	struct ieee80211_he_obss_pd pd = {};
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_scene_detect(test, true);
+	c.phy->mt76->band_idx = 1;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 1);
+	mt7915_test_expect_spr(test, c.fake, 0, SPR_ENABLE_SD, 1, 1);
+
+	pd.enable = true;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_obss_spr(c.phy, c.vif, &pd), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 3);
+	mt7915_test_expect_spr(test, c.fake, 1, SPR_ENABLE_SD, 1, 1);
+	mt7915_test_expect_spr(test, c.fake, 2, SPR_ENABLE, 1, 1);
+}
