+/* Starting a tx BA session: the WTBL BA entry, then the STA_REC_BA, both
+ * as originator; a session without A-MSDU stops hardware A-MSDU.
+ */
+static void mt7915_test_add_tx_ba(struct kunit *test)
+{
+	struct ieee80211_ampdu_params params = {
+		.tid = 5,
+		.ssn = 100,
+		.buf_size = 64,
+	};
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+	struct sta_req_hdr *hdr;
+	struct sta_rec_ba *ba;
+	struct wtbl_ba *wba;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	params.sta = c.sta;
+	c.mvif->mt76.idx = 2;
+	c.msta->wcid.amsdu = true;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_tx_ba(c.dev, &params, true), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 2);
+	KUNIT_EXPECT_FALSE(test, c.msta->wcid.amsdu);
+
+	msg = mt76_test_msg(c.fake, 0);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	hdr = mt7915_test_payload(msg, struct sta_req_hdr);
+	KUNIT_ASSERT_NOT_NULL(test, hdr);
+	KUNIT_EXPECT_EQ(test, hdr->bss_idx, 2);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_lo, MT7915_TEST_STA_WCID & 0xff);
+	KUNIT_EXPECT_EQ(test, hdr->wlan_idx_hi, MT7915_TEST_STA_WCID >> 8);
+	KUNIT_EXPECT_EQ(test, mt7915_test_wtbl_hdr(test, msg)->operation,
+			WTBL_SET);
+	wba = mt7915_test_wtbl(test, msg, WTBL_BA, struct wtbl_ba);
+	KUNIT_ASSERT_NOT_NULL(test, wba);
+	KUNIT_EXPECT_EQ(test, wba->tid, 5);
+	KUNIT_EXPECT_EQ(test, wba->ba_type, MT_BA_TYPE_ORIGINATOR);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(wba->sn), 100);
+	KUNIT_EXPECT_EQ(test, wba->ba_en, 1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(wba->ba_winsize), 64);
+
+	msg = mt76_test_msg(c.fake, 1);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(STA_REC_UPDATE));
+	KUNIT_EXPECT_EQ(test, mt7915_test_ntlv(test, msg->data, msg->len), 1);
+	ba = mt7915_test_tlv(test, msg, STA_REC_BA, struct sta_rec_ba);
+	KUNIT_ASSERT_NOT_NULL(test, ba);
+	KUNIT_EXPECT_EQ(test, ba->tid, 5);
+	KUNIT_EXPECT_EQ(test, ba->ba_type, MT_BA_TYPE_ORIGINATOR);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, BIT(5));
+	KUNIT_EXPECT_EQ(test, ba->amsdu, 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->ssn), 100);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ba->winsize), 64);
+
+	/* with A-MSDU in A-MPDU, hardware A-MSDU stays on */
+	c.msta->wcid.amsdu = true;
+	params.amsdu = true;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_tx_ba(c.dev, &params, true), 0);
+	KUNIT_EXPECT_TRUE(test, c.msta->wcid.amsdu);
+	ba = mt7915_test_tlv(test, mt76_test_msg(c.fake, 3), STA_REC_BA,
+			     struct sta_rec_ba);
+	KUNIT_ASSERT_NOT_NULL(test, ba);
+	KUNIT_EXPECT_EQ(test, ba->amsdu, 1);
+
+	/* stopping it clears the window and leaves A-MSDU alone */
+	params.amsdu = false;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_tx_ba(c.dev, &params, false), 0);
+	KUNIT_EXPECT_TRUE(test, c.msta->wcid.amsdu);
+	wba = mt7915_test_wtbl(test, mt76_test_msg(c.fake, 4), WTBL_BA,
+			       struct wtbl_ba);
+	KUNIT_ASSERT_NOT_NULL(test, wba);
+	KUNIT_EXPECT_EQ(test, wba->ba_en, 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(wba->sn), 0);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(wba->ba_winsize), 0);
+	ba = mt7915_test_tlv(test, mt76_test_msg(c.fake, 5), STA_REC_BA,
+			     struct sta_rec_ba);
+	KUNIT_ASSERT_NOT_NULL(test, ba);
+	KUNIT_EXPECT_EQ(test, ba->ba_en, 0);
+}
