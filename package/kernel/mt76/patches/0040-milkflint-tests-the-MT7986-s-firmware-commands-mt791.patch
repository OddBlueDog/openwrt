+/* Being beamformed by the station: an identity matrix as feedback when it
+ * sounds 2 dimensions and we have 3 chains, against the 2x2 negative gain.
+ */
+static void mt7915_test_bfee(struct kunit *test)
+{
+	struct ieee80211_he_cap_elem *pe;
+	struct mt7915_test_ctx c;
+	struct sta_rec_bfee *bfee;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	/* legacy, HT */
+	KUNIT_EXPECT_NULL(test, mt7915_test_bfee_tlv(test, &c));
+	mt7915_test_ht(c.sta);
+	KUNIT_EXPECT_NULL(test, mt7915_test_bfee_tlv(test, &c));
+
+	/* VHT beamformer, not beamformee-capable us */
+	mt7915_test_vht(c.sta);
+	c.sta->deflink.vht_cap.cap |= IEEE80211_VHT_CAP_SU_BEAMFORMER_CAPABLE |
+		FIELD_PREP(IEEE80211_VHT_CAP_SOUNDING_DIMENSIONS_MASK, 1);
+	c.mvif->cap.vht_su_ebfee = false;
+	KUNIT_EXPECT_NULL(test, mt7915_test_bfee_tlv(test, &c));
+
+	c.mvif->cap.vht_su_ebfee = true;
+	c.phy->mt76->chainmask = 0x7;
+	bfee = mt7915_test_bfee_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bfee);
+	KUNIT_EXPECT_TRUE(test, bfee->fb_identity_matrix);
+	c.phy->mt76->chainmask = 0xf;
+	bfee = mt7915_test_bfee_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bfee);
+	KUNIT_EXPECT_FALSE(test, bfee->fb_identity_matrix);
+
+	/* HE: its sounding dimensions */
+	c.phy->mt76->chainmask = 0x7;
+	c.sta->deflink.he_cap.has_he = true;
+	pe = &c.sta->deflink.he_cap.he_cap_elem;
+	pe->phy_cap_info[3] = IEEE80211_HE_PHY_CAP3_SU_BEAMFORMER;
+	pe->phy_cap_info[5] = u8_encode_bits(3,
+		IEEE80211_HE_PHY_CAP5_BEAMFORMEE_NUM_SND_DIM_UNDER_80MHZ_MASK);
+	bfee = mt7915_test_bfee_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bfee);
+	KUNIT_EXPECT_FALSE(test, bfee->fb_identity_matrix);
+	pe->phy_cap_info[5] = u8_encode_bits(1,
+		IEEE80211_HE_PHY_CAP5_BEAMFORMEE_NUM_SND_DIM_UNDER_80MHZ_MASK);
+	bfee = mt7915_test_bfee_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, bfee);
+	KUNIT_EXPECT_TRUE(test, bfee->fb_identity_matrix);
+}
