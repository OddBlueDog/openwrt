+/* Each fixed-rate step that firmware fails ends the update there. */
+static void mt7915_test_rate_fixed_errors(struct kunit *test)
+{
+	struct cfg80211_bitrate_mask *mask;
+	struct mt7915_test_ctx c;
+	int i;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mt7915_test_he(c.sta);
+	mask = &c.mvif->bitrate_mask;
+	memset(mask->control[NL80211_BAND_5GHZ].he_mcs, 0,
+	       sizeof(mask->control[NL80211_BAND_5GHZ].he_mcs));
+	mask->control[NL80211_BAND_5GHZ].he_mcs[0] = BIT(7);
+	mask->control[NL80211_BAND_5GHZ].he_gi = 1;
+	mask->control[NL80211_BAND_5GHZ].he_ltf = 2;
+
+	/* RA, FIXED_MCS, FIXED_GI, FIXED_HE_LTF, SPE_UPDATE */
+	for (i = 1; i < 5; i++) {
+		unsigned int sent = c.fake->n_msgs;
+
+		mt7915_test_fail_at(test, c.dev, i, -EIO);
+		KUNIT_EXPECT_EQ_MSG(test, mt7915_mcu_add_rate_ctrl(c.dev,
+				    c.vif, c.sta, &c.msta->wcid, false), -EIO,
+				    "message %d", i);
+		KUNIT_EXPECT_EQ_MSG(test, c.fake->n_msgs - sent, i + 1,
+				    "message %d", i);
+	}
+}
