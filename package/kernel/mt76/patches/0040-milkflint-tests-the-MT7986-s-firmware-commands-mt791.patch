+/* the phy of the RA_UPDATE @field message @i, or NULL */
+static struct sta_phy *mt7915_test_fixed_phy(struct kunit *test,
+					     struct mt7915_test_ctx *c, int i,
+					     u32 field)
+{
+	struct sta_rec_ra_fixed *ra = mt7915_test_ra_fixed(test, c, i);
+
+	if (!ra)
+		return NULL;
+	KUNIT_EXPECT_EQ_MSG(test, le32_to_cpu(ra->field), field,
+			    "message %d", i);
+	return &ra->phy;
+}
