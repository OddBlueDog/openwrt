+/* Hardware A-MSDU for AP and station peers that take A-MSDUs: 8 subframes
+ * up to the MPDU size the station takes (11454 on this chip), and the
+ * station marked for A-MSDU.
+ */
+static void mt7915_test_sta_amsdu(struct kunit *test)
+{
+	static const struct {
+		u16 len;
+		u8 size;
+	} cases[] = {
+		{ IEEE80211_MAX_MPDU_LEN_VHT_11454,
+		  IEEE80211_VHT_CAP_MAX_MPDU_LENGTH_11454 },
+		{ IEEE80211_MAX_MPDU_LEN_VHT_7991,
+		  IEEE80211_VHT_CAP_MAX_MPDU_LENGTH_7991 },
+		{ IEEE80211_MAX_MPDU_LEN_HT_7935,
+		  IEEE80211_VHT_CAP_MAX_MPDU_LENGTH_7991 },
+		{ IEEE80211_MAX_MPDU_LEN_HT_3839,
+		  IEEE80211_VHT_CAP_MAX_MPDU_LENGTH_3895 },
+	};
+	struct sta_rec_amsdu *amsdu;
+	struct mt7915_test_ctx c;
+	struct sk_buff *skb;
+	int i;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	/* no A-MSDU */
+	skb = mt7915_test_sta_req(test, &c, &c.msta->wcid);
+	mt7915_mcu_sta_amsdu_tlv(c.dev, skb, c.vif, c.sta);
+	KUNIT_EXPECT_EQ(test, mt7915_test_ntlv(test, skb->data, skb->len), 0);
+	KUNIT_EXPECT_FALSE(test, c.msta->wcid.amsdu);
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		c.msta->wcid.amsdu = false;
+		c.sta->deflink.agg.max_amsdu_len = cases[i].len;
+		skb = mt7915_test_sta_req(test, &c, &c.msta->wcid);
+		mt7915_mcu_sta_amsdu_tlv(c.dev, skb, c.vif, c.sta);
+		amsdu = mt7915_test_skb_tlv(test, skb, STA_REC_HW_AMSDU,
+					    struct sta_rec_amsdu);
+		KUNIT_ASSERT_NOT_NULL(test, amsdu);
+		KUNIT_EXPECT_EQ(test, amsdu->max_amsdu_num, 8);
+		KUNIT_EXPECT_EQ(test, amsdu->amsdu_en, 1);
+		KUNIT_EXPECT_EQ_MSG(test, amsdu->max_mpdu_size, cases[i].size,
+				    "case %d", i);
+		KUNIT_EXPECT_TRUE(test, c.msta->wcid.amsdu);
+	}
+
+	c.vif->type = NL80211_IFTYPE_STATION;
+	skb = mt7915_test_sta_req(test, &c, &c.msta->wcid);
+	mt7915_mcu_sta_amsdu_tlv(c.dev, skb, c.vif, c.sta);
+	KUNIT_EXPECT_EQ(test, mt7915_test_ntlv(test, skb->data, skb->len), 1);
+
+	c.msta->wcid.amsdu = false;
+	c.vif->type = NL80211_IFTYPE_MESH_POINT;
+	skb = mt7915_test_sta_req(test, &c, &c.msta->wcid);
+	mt7915_mcu_sta_amsdu_tlv(c.dev, skb, c.vif, c.sta);
+	KUNIT_EXPECT_EQ(test, mt7915_test_ntlv(test, skb->data, skb->len), 0);
+	KUNIT_EXPECT_FALSE(test, c.msta->wcid.amsdu);
+}
