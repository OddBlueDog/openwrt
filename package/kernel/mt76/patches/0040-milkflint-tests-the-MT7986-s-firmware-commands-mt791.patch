+/* Legacy rates come as the hardware rate code: they're looked up in the
+ * band's bitrates (CCK only on 2.4 GHz, short preamble folded in).
+ */
+static void mt7915_mcu2_rx_rate_legacy(struct kunit *test)
+{
+	struct ieee80211_channel chan6g =
+		MT7915_MCU2_CHAN(NL80211_BAND_6GHZ, 5975, 5, 0);
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu2_rx_rate r = {};
+
+	mt7915_mcu2_bands(test, dev);
+	mt7915_mcu2_tune(test, dev, 2437, NL80211_CHAN_WIDTH_20, 2437);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_CCK, 3, 0, 0, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.legacy, 110);
+	KUNIT_EXPECT_EQ(test, r.rate.mcs, 3);
+	KUNIT_EXPECT_EQ(test, r.rate.flags, 0);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_CCK, 4 | 1, 0, 0, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.legacy, 20);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_OFDM, 11, 0, 0, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.legacy, 60);
+	KUNIT_EXPECT_EQ(test, r.rate.mcs, 4);
+
+	mt7915_mcu2_tune(test, dev, 5180, NL80211_CHAN_WIDTH_20, 5180);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_OFDM, 12, 0, 0, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.legacy, 540);
+	KUNIT_EXPECT_EQ(test, r.rate.mcs, 7);
+
+	mt7915_mcu2_sband(test, &dev->mphy.sband_6g, NL80211_BAND_6GHZ,
+			  &chan6g, 1, mt76_rates + 4,
+			  ARRAY_SIZE(mt76_rates) - 4);
+	dev->mphy.chandef.chan = &chan6g;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_OFDM, 8, 0, 0, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.legacy, 480);
+	dev->mphy.chandef.chan = NULL;
+}
