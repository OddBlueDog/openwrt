+		mt7915_test_fail_at(test, c.dev, i, -EIO);
+		KUNIT_EXPECT_EQ_MSG(test, mt7915_mcu_add_obss_spr(c.phy, c.vif,
+				    &pd), -EIO, "message %d", i);
+		KUNIT_EXPECT_EQ_MSG(test, c.fake->n_msgs - sent, i + 1,
+				    "message %d", i);
+	}
+}
