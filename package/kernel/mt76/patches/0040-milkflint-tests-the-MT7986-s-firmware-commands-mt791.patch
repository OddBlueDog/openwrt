+
+/* --- making one message fail ---------------------------------------------- */
+
+static unsigned int mt7915_mcu2_fail_at;
+
+static int mt7915_mcu2_send_or_fail(struct mt76_dev *mdev, struct sk_buff *skb,
+				    int cmd, int *seq)
+{
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	fake->mcu_ret = fake->n_msgs + 1 == mt7915_mcu2_fail_at ? -EIO : 0;
+	return mt76_test_mcu_send(mdev, skb, cmd, seq);
+}
+
+static const struct mt76_mcu_ops mt7915_mcu2_fail_ops = {
+	.headroom = sizeof(struct mt76_connac2_mcu_txd),
+	.mcu_skb_send_msg = mt7915_mcu2_send_or_fail,
+	.mcu_parse_response = mt7915_test_parse_response,
+};
+
+/* the @n-th message from now (1: the next) fails with -EIO, the others
+ * go through
+ */
+static void mt7915_mcu2_fail_nth(struct mt7915_dev *dev, unsigned int n)
+{
+	mt7915_mcu2_fail_at = mt76_test_fake->n_msgs + n;
+	dev->mt76.mcu_ops = &mt7915_mcu2_fail_ops;
+}
+
+/* --- channel, calibration and radar --------------------------------------- */
+
+struct mt7915_mcu2_chan_info {
+	u8 control_ch;
+	u8 center_ch;
+	u8 bw;
+	u8 tx_path_num;
+	u8 rx_path;
+	u8 switch_reason;
+	u8 band_idx;
+	u8 center_ch2;
+	__le16 cac_case;
+	u8 channel_band;
+	u8 rsv0;
+	__le32 outband_freq;
+	u8 txpower_drop;
+	u8 ap_bw;
+	u8 ap_center_ch;
+	u8 rsv1[57];
+} __packed;
+
+static const struct mt7915_mcu2_chan_info *
+mt7915_mcu2_chan_info(struct kunit *test, struct mt7915_dev *dev, int cmd)
+{
+	struct wiphy *wiphy = dev->mphy.hw->wiphy;
+	struct mt76_test_msg *msg;
+	int ret;
+
+	/* mac80211 holds the wiphy lock for channel changes */
+	wiphy_lock(wiphy);
+	ret = mt7915_mcu_set_chan_info(&dev->phy, cmd);
+	wiphy_unlock(wiphy);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	msg = mt7915_mcu2_msg(test, cmd, sizeof(struct mt7915_mcu2_chan_info));
+	return (const void *)msg->data;
+}
+
+/* The channel the radio tunes to, as the firmware gets it: primary and
+ * center channel numbers, width, band and the chains to use. A channel
+ * switch counts the rx chains, setting the rx path passes their mask.
+ */
+static void mt7915_mcu2_chan_info_basic(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu2_chan_info *req;
+
+	mt7915_mcu2_bands(test, dev);
+	dev->mphy.hw->conf.flags = 0;
+	dev->mphy.band_idx = MT_BAND1;
+	dev->mphy.chainmask = 0xf;
+	dev->mphy.antenna_mask = 0xf;
+	mt7915_mcu2_tune(test, dev, 5180, NL80211_CHAN_WIDTH_20_NOHT, 5180);
+
+	req = mt7915_mcu2_chan_info(test, dev, MCU_EXT_CMD(CHANNEL_SWITCH));
+	KUNIT_EXPECT_EQ(test, req->control_ch, 36);
+	KUNIT_EXPECT_EQ(test, req->center_ch, 36);
+	KUNIT_EXPECT_EQ(test, req->bw, CMD_CBW_20MHZ);
+	KUNIT_EXPECT_EQ(test, req->tx_path_num, 4);
+	KUNIT_EXPECT_EQ(test, req->rx_path, 4);
+	KUNIT_EXPECT_EQ(test, req->switch_reason, CH_SWITCH_NORMAL);
+	KUNIT_EXPECT_EQ(test, req->band_idx, MT_BAND1);
+	KUNIT_EXPECT_EQ(test, req->center_ch2, 0);
+	KUNIT_EXPECT_EQ(test, req->channel_band, 1);
+
+	req = mt7915_mcu2_chan_info(test, dev, MCU_EXT_CMD(SET_RX_PATH));
+	KUNIT_EXPECT_EQ(test, req->rx_path, 0xf);
+	KUNIT_EXPECT_EQ(test, req->tx_path_num, 4);
+	KUNIT_EXPECT_EQ(test, req->control_ch, 36);
+
+	mt76_test_fake->mcu_ret = -EIO;
+	wiphy_lock(dev->mphy.hw->wiphy);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_chan_info(&dev->phy,
+			MCU_EXT_CMD(CHANNEL_SWITCH)), -EIO);
+	wiphy_unlock(dev->mphy.hw->wiphy);
+}
+
+/* A partial antenna mask uses spatial expansion: as many tx paths as up to
+ * the highest antenna. With DBDC, a band's chains are its slice of the mask.
+ */
+static void mt7915_mcu2_chan_info_chains(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu2_chan_info *req;
+
+	mt7915_mcu2_bands(test, dev);
+	dev->mphy.hw->conf.flags = 0;
+	mt7915_mcu2_tune(test, dev, 5180, NL80211_CHAN_WIDTH_20_NOHT, 5180);
+	dev->mphy.chainmask = 0x6;
+	dev->mphy.antenna_mask = 0x6;
+	req = mt7915_mcu2_chan_info(test, dev, MCU_EXT_CMD(CHANNEL_SWITCH));
+	KUNIT_EXPECT_EQ(test, req->tx_path_num, 3);
+	KUNIT_EXPECT_EQ(test, req->rx_path, 2);
+
+	dev->dbdc_support = true;
+	dev->chainshift = 2;
+	dev->mphy.band_idx = MT_BAND1;
+	dev->mphy.chainmask = 0xc;
+	dev->mphy.antenna_mask = 0x3;
+	req = mt7915_mcu2_chan_info(test, dev, MCU_EXT_CMD(SET_RX_PATH));
+	KUNIT_EXPECT_EQ(test, req->tx_path_num, 2);
+	KUNIT_EXPECT_EQ(test, req->rx_path, 0x3);
+}
+
+/* The switch reason picks the firmware's calibration: plain, DFS (a CAC is
+ * needed), or scan/idle (DPD may be skipped); monitor mode is a plain switch.
+ */
+static void mt7915_mcu2_chan_info_reason(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct ieee80211_hw *hw = dev->mphy.hw;
+	int cmd = MCU_EXT_CMD(CHANNEL_SWITCH);
+	struct ieee80211_channel *chan;
+
+	mt7915_mcu2_bands(test, dev);
+	hw->conf.flags = 0;
+	dev->mphy.chainmask = 0x3;
+	dev->mphy.antenna_mask = 0x3;
+	chan = mt7915_mcu2_tune(test, dev, 5260, NL80211_CHAN_WIDTH_20_NOHT,
+				5260);
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_chan_info(test, dev, cmd)->
+			switch_reason, CH_SWITCH_DFS);
+
+	/* after the CAC the channel is available: a plain switch */
+	chan->dfs_state = NL80211_DFS_AVAILABLE;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_chan_info(test, dev, cmd)->
+			switch_reason, CH_SWITCH_NORMAL);
+	chan->dfs_state = NL80211_DFS_USABLE;
+
+	hw->conf.flags = IEEE80211_CONF_MONITOR;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_chan_info(test, dev, cmd)->
+			switch_reason, CH_SWITCH_NORMAL);
+	dev->mphy.offchannel = true;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_chan_info(test, dev, cmd)->
+			switch_reason, CH_SWITCH_SCAN_BYPASS_DPD);
+	hw->conf.flags = 0;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_chan_info(test, dev, cmd)->
+			switch_reason, CH_SWITCH_SCAN_BYPASS_DPD);
+	dev->mphy.offchannel = false;
+	hw->conf.flags = IEEE80211_CONF_IDLE;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_chan_info(test, dev, cmd)->
+			switch_reason, CH_SWITCH_SCAN_BYPASS_DPD);
+	hw->conf.flags = 0;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_chan_info(test, dev, cmd)->
+			switch_reason, CH_SWITCH_DFS);
+}
+
+/* Wide channels carry their center channel numbers (both segments for
+ * 80+80), and each band its own code.
+ */
+static void mt7915_mcu2_chan_info_wide(struct kunit *test)
+{
+	struct ieee80211_channel chan6g =
+		MT7915_MCU2_CHAN(NL80211_BAND_6GHZ, 5975, 5, 0);
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	int cmd = MCU_EXT_CMD(CHANNEL_SWITCH);
+	const struct mt7915_mcu2_chan_info *req;
+
+	mt7915_mcu2_bands(test, dev);
+	dev->mphy.chainmask = 0x3;
+	dev->mphy.antenna_mask = 0x3;
+	/* idle: the switch reason doesn't need a regulatory check */
+	dev->mphy.hw->conf.flags = IEEE80211_CONF_IDLE;
+
+	mt7915_mcu2_tune(test, dev, 5180, NL80211_CHAN_WIDTH_80, 5210);
+	req = mt7915_mcu2_chan_info(test, dev, cmd);
+	KUNIT_EXPECT_EQ(test, req->control_ch, 36);
+	KUNIT_EXPECT_EQ(test, req->center_ch, 42);
+	KUNIT_EXPECT_EQ(test, req->bw, CMD_CBW_80MHZ);
+	KUNIT_EXPECT_EQ(test, req->center_ch2, 0);
+
