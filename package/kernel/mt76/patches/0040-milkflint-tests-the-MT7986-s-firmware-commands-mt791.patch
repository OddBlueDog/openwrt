+/* the firmware's answer to GET_MIB_INFO: @n counters after @offs bytes */
+static void mt7915_mcu2_mib_reply(struct kunit *test, int offs,
+				  const u64 *data, int n)
+{
+	u8 buf[20 + 5 * sizeof(struct mt7915_mcu_mib)] = {};
+	struct mt7915_mcu_mib *res = (void *)(buf + offs);
+	int i;
+
+	for (i = 0; i < n; i++)
+		res[i].data = cpu_to_le64(data[i]);
+	mt7915_mcu2_reply(test, buf, offs + n * sizeof(*res));
+}
+
+/* Channel airtime (MT7986): each read adds how much the band's tx, rx, OBSS
+ * and non-WiFi counters grew to the survey; a channel switch only rebases.
+ */
+static void mt7915_mcu2_chan_mib(struct kunit *test)
+{
+	static const u32 offs[] = {
+		MIB_NON_WIFI_TIME_V2, MIB_TX_TIME_V2, MIB_RX_TIME_V2,
+		MIB_OBSS_AIRTIME_V2,
+	};
+	static const u64 first[] = { 100, 200, 300, 400 };
+	static const u64 second[] = { 150, 260, 390, 480 };
+	static const u64 third[] = { 1000, 2000, 3000, 4000 };
+	static const u64 fourth[] = { 1001, 2002, 3003, 4004 };
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu_mib *req;
+	struct mt76_channel_state *state;
+	struct mt76_test_msg *msg;
+	int i;
+
+	state = kunit_kzalloc(test, sizeof(*state), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, state);
+	dev->mphy.chan_state = state;
+	dev->mphy.band_idx = MT_BAND1;
+
+	mt7915_mcu2_mib_reply(test, 0, first, 4);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_get_chan_mib_info(&dev->phy, false),
+			0);
+	msg = mt7915_mcu2_msg(test, MCU_EXT_CMD(GET_MIB_INFO),
+			      4 * sizeof(*req));
+	req = (const void *)msg->data;
+	for (i = 0; i < 4; i++) {
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(req[i].band), MT_BAND1);
+		KUNIT_EXPECT_EQ(test, le32_to_cpu(req[i].offs), offs[i]);
+	}
+	KUNIT_EXPECT_EQ(test, state->cc_tx, 200);
+	KUNIT_EXPECT_EQ(test, state->cc_bss_rx, 300);
+	KUNIT_EXPECT_EQ(test, state->cc_rx, 700);
+	KUNIT_EXPECT_EQ(test, state->cc_busy, 1000);
+
+	mt7915_mcu2_mib_reply(test, 0, second, 4);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_get_chan_mib_info(&dev->phy, false),
+			0);
+	KUNIT_EXPECT_EQ(test, state->cc_tx, 260);
+	KUNIT_EXPECT_EQ(test, state->cc_bss_rx, 390);
+	KUNIT_EXPECT_EQ(test, state->cc_rx, 870);
+	KUNIT_EXPECT_EQ(test, state->cc_busy, 1280);
+
+	mt7915_mcu2_mib_reply(test, 0, third, 4);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_get_chan_mib_info(&dev->phy, true),
+			0);
+	KUNIT_EXPECT_EQ(test, state->cc_busy, 1280);
+	KUNIT_EXPECT_EQ(test, state->cc_tx, 260);
+	KUNIT_EXPECT_EQ(test, dev->phy.state_ts.cc_tx, 2000);
+	KUNIT_EXPECT_EQ(test, dev->phy.state_ts.cc_bss_rx, 3000);
+	KUNIT_EXPECT_EQ(test, dev->phy.state_ts.cc_rx, 7000);
+	KUNIT_EXPECT_EQ(test, dev->phy.state_ts.cc_busy, 10000);
+
+	mt7915_mcu2_mib_reply(test, 0, fourth, 4);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_get_chan_mib_info(&dev->phy, false),
+			0);
+	KUNIT_EXPECT_EQ(test, state->cc_tx, 262);
+	KUNIT_EXPECT_EQ(test, state->cc_bss_rx, 393);
+	KUNIT_EXPECT_EQ(test, state->cc_rx, 877);
+	KUNIT_EXPECT_EQ(test, state->cc_busy, 1290);
+}
