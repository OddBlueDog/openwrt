+/* The VOW (airtime) group of a station: its BSS's, from band and omac. */
+static void mt7915_test_add_group(struct kunit *test)
+{
+	static const struct {
+		u8 band, omac, grp;
+	} cases[] = {
+		{ 0, HW_BSSID_0, 0 },
+		{ 1, HW_BSSID_2, 6 },
+		{ 0, MT7915_TEST_EXT_BSSID(3), 11 },
+		{ 1, MT7915_TEST_EXT_BSSID(3), 27 },
+	};
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+	int i;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		c.mvif->mt76.band_idx = cases[i].band;
+		c.mvif->mt76.omac_idx = cases[i].omac;
+		KUNIT_ASSERT_EQ(test, mt7915_mcu_add_group(c.dev, c.vif,
+				c.sta), 0);
+		msg = mt76_test_msg(c.fake, i);
+		KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_DRR_CTRL));
+		KUNIT_EXPECT_EQ(test, msg->data[4],
+				MT7915_TEST_STA_WCID & 0xff);
+		KUNIT_EXPECT_EQ(test, msg->data[6],
+				MT7915_TEST_STA_WCID >> 8);
+		KUNIT_EXPECT_EQ_MSG(test,
+				    le32_to_cpu(*(__le32 *)(msg->data + 12)),
+				    cases[i].grp, "case %d", i);
+	}
+}
