+	mt7915_test_expect_spe(test, &c, 2);
+
+	mask->control[NL80211_BAND_5GHZ].he_ltf = 0xff;
+	mask->control[NL80211_BAND_5GHZ].he_gi = 1;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_rate_ctrl(c.dev, c.vif, c.sta,
+			&c.msta->wcid, false), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 6);
+	phy = mt7915_test_fixed_phy(test, &c, 4, RATE_PARAM_FIXED_GI);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	KUNIT_EXPECT_EQ(test, phy->sgi, 1 | 1 << 2);
+	mt7915_test_expect_spe(test, &c, 5);
+}
