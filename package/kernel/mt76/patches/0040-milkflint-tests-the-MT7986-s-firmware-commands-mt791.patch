+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	c.sta->deflink.he_cap.has_he = true;
+	elem = &c.sta->deflink.he_cap.he_cap_elem;
+	elem->mac_cap_info[1] =
+		u8_encode_bits(2, IEEE80211_HE_MAC_CAP1_TF_MAC_PAD_DUR_MASK);
+	elem->mac_cap_info[3] =
+		u8_encode_bits(3, IEEE80211_HE_MAC_CAP3_MAX_AMPDU_LEN_EXP_MASK);
+	elem->phy_cap_info[0] =
+		u8_encode_bits(0x3, IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_MASK);
+	elem->phy_cap_info[1] = IEEE80211_HE_PHY_CAP1_DEVICE_CLASS_A |
+		u8_encode_bits(5, IEEE80211_HE_PHY_CAP1_PREAMBLE_PUNC_RX_MASK);
+	elem->phy_cap_info[3] =
+		u8_encode_bits(2, IEEE80211_HE_PHY_CAP3_DCM_MAX_CONST_TX_MASK) |
+		IEEE80211_HE_PHY_CAP3_DCM_MAX_TX_NSS_2 |
+		u8_encode_bits(1, IEEE80211_HE_PHY_CAP3_DCM_MAX_CONST_RX_MASK);
+	elem->phy_cap_info[8] =
+		u8_encode_bits(2, IEEE80211_HE_PHY_CAP8_DCM_MAX_RU_MASK);
+
+	he = mt7915_test_he_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, he);
+	KUNIT_EXPECT_EQ(test, he->t_frame_dur, 2);
+	KUNIT_EXPECT_EQ(test, he->max_ampdu_exp, 3);
+	KUNIT_EXPECT_EQ(test, he->bw_set, 0x3);
+	KUNIT_EXPECT_EQ(test, he->device_class, 1);
+	KUNIT_EXPECT_EQ(test, he->punc_pream_rx, 5);
+	KUNIT_EXPECT_EQ(test, he->dcm_tx_mode, 2);
+	KUNIT_EXPECT_EQ(test, he->dcm_tx_max_nss, 1);
+	KUNIT_EXPECT_EQ(test, he->dcm_rx_mode, 1);
+	KUNIT_EXPECT_EQ(test, he->dcm_rx_max_nss, 0);
+	KUNIT_EXPECT_EQ(test, he->dcm_max_ru, 2);
+	KUNIT_EXPECT_EQ(test, he->pkt_ext, 2);
+
+	elem->phy_cap_info[3] = IEEE80211_HE_PHY_CAP3_DCM_MAX_RX_NSS_2;
+	he = mt7915_test_he_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, he);
+	KUNIT_EXPECT_EQ(test, he->dcm_tx_max_nss, 0);
+	KUNIT_EXPECT_EQ(test, he->dcm_rx_max_nss, 1);
+}
