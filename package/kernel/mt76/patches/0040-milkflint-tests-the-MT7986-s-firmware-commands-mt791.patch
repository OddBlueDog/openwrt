+/* Each step of the manual spatial reuse setup stops it when firmware fails. */
+static void mt7915_test_obss_spr_errors(struct kunit *test)
+{
+	struct ieee80211_he_obss_pd pd = {
+		.enable = true,
+		.sr_ctrl = IEEE80211_HE_SPR_HESIGA_SR_VAL15_ALLOWED,
+	};
