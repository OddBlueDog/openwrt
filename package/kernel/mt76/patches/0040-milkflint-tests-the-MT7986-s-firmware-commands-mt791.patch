+	mphy = kunit_kzalloc(test, sizeof(*mphy), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, phy);
+	KUNIT_ASSERT_NOT_NULL(test, mphy);
+	mphy->hw = dev->mphy.hw;
+	mphy->dev = &dev->mt76;
+	mphy->priv = phy;
+	mphy->band_idx = MT_BAND1;
+	phy->mt76 = mphy;
+	phy->dev = dev;
+	dev->mt76.phys[MT_BAND1] = mphy;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_mcu2_drop_band1, dev), 0);
+	return phy;
+}
