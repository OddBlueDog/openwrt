+/* The global DRR settings: the deficit bound follows airtime fairness, the
+ * quantum levels are a fixed table; no station index.
+ */
+static void mt7915_mcu2_vow_global(struct kunit *test)
+{
+	static const u8 quantum[VOW_DRR_QUANTUM_NUM] = VOW_DRR_QUANTUM_TABLE;
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu2_drr *req;
+
+	dev->vow_atf_en = false;
+	req = mt7915_mcu2_drr(test, dev, NULL,
+			      VOW_DRR_CTRL_AIRTIME_DEFICIT_BOUND, 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->action),
+			VOW_DRR_CTRL_AIRTIME_DEFICIT_BOUND);
+	KUNIT_EXPECT_EQ(test, req->wlan_idx_lo, 0);
+	KUNIT_EXPECT_EQ(test, req->wlan_idx_hi, 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->com_value),
+			VOW_MAX_DEFICIT_OFF);
+	dev->vow_atf_en = true;
+	req = mt7915_mcu2_drr(test, dev, NULL,
+			      VOW_DRR_CTRL_AIRTIME_DEFICIT_BOUND, 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->com_value), VOW_MAX_DEFICIT_ON);
+
+	req = mt7915_mcu2_drr(test, dev, NULL,
+			      VOW_DRR_CTRL_AIRTIME_QUANTUM_ALL, 0);
+	KUNIT_EXPECT_EQ(test, memcmp(req->quantum, quantum, sizeof(quantum)),
+			0);
+
+	/* anything else goes out as is, with no value */
+	req = mt7915_mcu2_drr(test, dev, NULL, 0x99, 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->action), 0x99);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->com_value), 0);
