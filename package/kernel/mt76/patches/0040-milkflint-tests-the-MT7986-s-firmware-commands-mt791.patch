+/* A repeater's BSS info first updates both its MUAR entries. */
+static void mt7915_test_add_bss_info_repeater(struct kunit *test)
+{
+	struct mt7915_test_muar *req;
+	struct mt76_test_msg *msg;
+	struct mt7915_test_ctx c;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_STATION);
+	c.mvif->mt76.omac_idx = REPEATER_BSSID_START + 1;
+	c.phy->omac_mask = BIT_ULL(REPEATER_BSSID_START + 1);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_bss_info(c.phy, c.vif, false), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 3);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(c.fake, 0)->cmd,
+			MCU_EXT_CMD(MUAR_UPDATE));
+	req = mt7915_test_payload(mt76_test_msg(c.fake, 1),
+				  struct mt7915_test_muar);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(c.fake, 1)->cmd,
+			MCU_EXT_CMD(MUAR_UPDATE));
+	KUNIT_EXPECT_EQ(test, req->index, 3);
+	KUNIT_EXPECT_EQ(test, mt76_test_msg(c.fake, 2)->cmd,
+			MCU_EXT_CMD(BSS_INFO_UPDATE));
+
+	/* brought up (as an AP type, as a station looks up its AP in
+	 * mac80211): the MUAR entries get addresses, and a repeater is no
+	 * extended BSS
+	 */
+	c.vif->type = NL80211_IFTYPE_AP;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_add_bss_info(c.phy, c.vif, true), 0);
+	KUNIT_ASSERT_EQ(test, c.fake->n_msgs, 6);
+	req = mt7915_test_payload(mt76_test_msg(c.fake, 3),
+				  struct mt7915_test_muar);
+	KUNIT_ASSERT_NOT_NULL(test, req);
+	KUNIT_EXPECT_EQ(test, req->mode, 1);
+	KUNIT_EXPECT_MEMEQ(test, req->addr, mt7915_test_own_addr, ETH_ALEN);
+	msg = mt76_test_msg(c.fake, 5);
+	KUNIT_EXPECT_EQ(test, mt7915_test_ntlv(test, msg->data, msg->len), 6);
+	KUNIT_EXPECT_NULL(test, mt7915_test_tlv(test, msg, BSS_INFO_EXT_BSS,
+						struct bss_info_ext_bss));
+}
