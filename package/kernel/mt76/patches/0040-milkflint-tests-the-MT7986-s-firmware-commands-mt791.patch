+/* A legacy 2.4 GHz station's rates: CCK, and OFDM when it has more than
+ * the four CCK rates (masked by the vif), its channel, width and SMPS.
+ */
+static void mt7915_test_rate_ctrl_tlv_2g(struct kunit *test)
+{
+	struct mt7915_test_ctx c;
+	struct sta_rec_ra *ra;
+	u32 *legacy;
+
+	mt7915_test_init(test, &c, NL80211_BAND_2GHZ, NL80211_IFTYPE_AP);
+	legacy = &c.mvif->bitrate_mask.control[NL80211_BAND_2GHZ].legacy;
+	c.sta->deflink.supp_rates[NL80211_BAND_2GHZ] = 0xfff;
+	c.sta->deflink.smps_mode = IEEE80211_SMPS_STATIC;
+
+	ra = mt7915_test_ra_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, ra->valid, 1);
+	KUNIT_EXPECT_EQ(test, ra->auto_rate, 1);
+	KUNIT_EXPECT_EQ(test, ra->phy_mode, PHY_MODE_B | PHY_MODE_G);
+	KUNIT_EXPECT_EQ(test, ra->channel, 6);
+	KUNIT_EXPECT_EQ(test, ra->bw, IEEE80211_STA_RX_BW_20);
+	KUNIT_EXPECT_EQ(test, ra->phy.bw, IEEE80211_STA_RX_BW_20);
+	KUNIT_EXPECT_EQ(test, ra->mmps_mode, MCU_MMPS_STATIC);
+	KUNIT_EXPECT_EQ(test, ra->rate_len, 12);
+	KUNIT_EXPECT_EQ(test, ra->supp_mode, MODE_CCK | MODE_OFDM);
+	KUNIT_EXPECT_EQ(test, ra->supp_cck_rate, 0xf);
+	KUNIT_EXPECT_EQ(test, ra->supp_ofdm_rate, 0xff);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->sta_cap), STA_CAP_WMM);
+
+	*legacy = 0x0ff;
+	c.sta->wme = false;
+	c.sta->deflink.smps_mode = IEEE80211_SMPS_DYNAMIC;
+	ra = mt7915_test_ra_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, ra->rate_len, 8);
+	KUNIT_EXPECT_EQ(test, ra->supp_mode, MODE_CCK | MODE_OFDM);
+	KUNIT_EXPECT_EQ(test, ra->supp_ofdm_rate, 0xf);
+	KUNIT_EXPECT_EQ(test, ra->mmps_mode, MCU_MMPS_DYNAMIC);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->sta_cap), 0);
+
+	*legacy = 0x00f;
+	c.sta->deflink.smps_mode = IEEE80211_SMPS_AUTOMATIC;
+	ra = mt7915_test_ra_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, ra->rate_len, 4);
+	KUNIT_EXPECT_EQ(test, ra->supp_mode, MODE_CCK);
+	KUNIT_EXPECT_EQ(test, ra->supp_ofdm_rate, 0);
+	KUNIT_EXPECT_EQ(test, ra->mmps_mode, MCU_MMPS_DISABLE);
+
+	/* no legacy rates at all */
+	c.sta->deflink.supp_rates[NL80211_BAND_2GHZ] = 0;
+	ra = mt7915_test_ra_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, ra->rate_len, 0);
+	KUNIT_EXPECT_EQ(test, ra->supp_mode, 0);
+}
+
+/* An HT/VHT/HE station on 5 GHz: OFDM rates, every mode, the larger A-MPDU
+ * factor, its HT/VHT capabilities as flags (LDPC only if we do it) and its
+ * MCS sets under the vif's masks.
+ */
+static void mt7915_test_rate_ctrl_tlv_5g(struct kunit *test)
+{
+	struct cfg80211_bitrate_mask *mask;
+	struct mt7915_test_ctx c;
+	struct sta_rec_ra *ra;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	mask = &c.mvif->bitrate_mask;
+	mt7915_test_ht(c.sta);
+	mt7915_test_vht(c.sta);
+	c.sta->deflink.supp_rates[NL80211_BAND_5GHZ] = 0xff;
+	c.sta->deflink.bandwidth = IEEE80211_STA_RX_BW_80;
+	mask->control[NL80211_BAND_5GHZ].legacy = 0xf0;
+	mask->control[NL80211_BAND_5GHZ].ht_mcs[1] = 0x0f;
+	mask->control[NL80211_BAND_5GHZ].vht_mcs[1] = GENMASK(7, 0);
+
+	ra = mt7915_test_ra_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, ra->phy_mode,
+			PHY_MODE_A | PHY_MODE_AN | PHY_MODE_AC);
+	KUNIT_EXPECT_EQ(test, ra->channel, 36);
+	KUNIT_EXPECT_EQ(test, ra->bw, IEEE80211_STA_RX_BW_80);
+	KUNIT_EXPECT_EQ(test, ra->rate_len, 4);
+	KUNIT_EXPECT_EQ(test, ra->supp_mode, MODE_OFDM | MODE_HT | MODE_VHT);
+	KUNIT_EXPECT_EQ(test, ra->supp_cck_rate, 0);
+	KUNIT_EXPECT_EQ(test, ra->supp_ofdm_rate, 0xf0);
+	KUNIT_EXPECT_EQ(test, ra->af, 7);
+	KUNIT_EXPECT_EQ(test, ra->ht_gf, 1);
+	KUNIT_EXPECT_EQ(test, ra->ht_mcs[0], 0xff);
+	KUNIT_EXPECT_EQ(test, ra->ht_mcs[1], 0x0f);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->supp_ht_mcs), 0x0fff);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ra->supp_vht_mcs[0]), GENMASK(9, 0));
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(ra->supp_vht_mcs[1]), GENMASK(7, 0));
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->sta_cap),
+			STA_CAP_WMM | STA_CAP_HT | STA_CAP_SGI_20 |
+			STA_CAP_SGI_40 | STA_CAP_TX_STBC | STA_CAP_RX_STBC |
+			STA_CAP_LDPC | STA_CAP_VHT | STA_CAP_VHT_SGI_80 |
+			STA_CAP_VHT_TX_STBC | STA_CAP_VHT_RX_STBC |
+			STA_CAP_VHT_LDPC);
+
+	/* without our LDPC, no LDPC; the HT factor if it's the larger */
+	c.mvif->cap.ht_ldpc = false;
+	c.mvif->cap.vht_ldpc = false;
+	c.sta->deflink.ht_cap.cap = IEEE80211_HT_CAP_LDPC_CODING;
+	c.sta->deflink.ht_cap.ampdu_factor = 3;
+	c.sta->deflink.vht_cap.cap = IEEE80211_VHT_CAP_RXLDPC |
+		IEEE80211_VHT_CAP_SHORT_GI_160;
+	ra = mt7915_test_ra_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, ra->af, 3);
+	KUNIT_EXPECT_EQ(test, ra->ht_gf, 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->sta_cap),
+			STA_CAP_WMM | STA_CAP_HT | STA_CAP_VHT |
+			STA_CAP_VHT_SGI_160);
+
+	/* HE, with the 6 GHz A-MPDU exponent overriding */
+	mt7915_test_he(c.sta);
+	c.sta->deflink.he_6ghz_capa.capa =
+		le16_encode_bits(5, IEEE80211_HE_6GHZ_CAP_MAX_AMPDU_LEN_EXP);
+	ra = mt7915_test_ra_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, ra->supp_mode,
+			MODE_OFDM | MODE_HT | MODE_VHT | MODE_HE);
+	KUNIT_EXPECT_EQ(test, ra->phy_mode, PHY_MODE_A | PHY_MODE_AN |
+			PHY_MODE_AC | PHY_MODE_AX_5G);
+	KUNIT_EXPECT_TRUE(test, le32_to_cpu(ra->sta_cap) & STA_CAP_HE);
+	KUNIT_EXPECT_EQ(test, ra->af, 5);
+}
