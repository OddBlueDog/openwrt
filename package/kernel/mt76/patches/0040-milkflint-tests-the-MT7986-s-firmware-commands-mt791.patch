+/* Fixed-rate updates carry the field changed and its value: the rate for
+ * the FIXED fields, the SMPS mode, the spatial extension index.
+ */
+static void mt7915_test_fixed_rate_ctrl(struct kunit *test)
+{
+	struct sta_phy phy = {
+		.type = MT_PHY_TYPE_VHT, .sgi = 1, .bw = 2, .mcs = 9, .nss = 2,
+	};
+	struct sta_rec_ra_fixed *ra;
+	struct mt7915_test_ctx c;
+	u8 spe = 18;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_fixed_rate_ctrl(c.dev, c.vif,
+			c.sta, &c.msta->wcid, &phy, RATE_PARAM_FIXED_MCS), 0);
+	ra = mt7915_test_ra_fixed(test, &c, 0);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->field), RATE_PARAM_FIXED_MCS);
+	KUNIT_EXPECT_MEMEQ(test, &ra->phy, &phy, sizeof(phy));
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_fixed_rate_ctrl(c.dev, c.vif,
+			c.sta, &c.msta->wcid, NULL, RATE_PARAM_FIXED), 0);
+	ra = mt7915_test_ra_fixed(test, &c, 1);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->field), RATE_PARAM_FIXED);
+	KUNIT_EXPECT_EQ(test, ra->phy.mcs, 0);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_fixed_rate_ctrl(c.dev, c.vif,
+			c.sta, &c.msta->wcid, &phy, RATE_PARAM_AUTO), 0);
+	ra = mt7915_test_ra_fixed(test, &c, 2);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->field), RATE_PARAM_AUTO);
+	KUNIT_EXPECT_EQ(test, ra->phy.mcs, 0);
+
+	c.sta->deflink.smps_mode = IEEE80211_SMPS_DYNAMIC;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_fixed_rate_ctrl(c.dev, c.vif,
+			c.sta, &c.msta->wcid, NULL, RATE_PARAM_MMPS_UPDATE), 0);
+	ra = mt7915_test_ra_fixed(test, &c, 3);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->field), RATE_PARAM_MMPS_UPDATE);
+	KUNIT_EXPECT_EQ(test, ra->mmps_mode, MCU_MMPS_DYNAMIC);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_fixed_rate_ctrl(c.dev, c.vif,
+			c.sta, &c.msta->wcid, &spe, RATE_PARAM_SPE_UPDATE), 0);
+	ra = mt7915_test_ra_fixed(test, &c, 4);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(ra->field), RATE_PARAM_SPE_UPDATE);
+	KUNIT_EXPECT_EQ(test, ra->spe_idx, 18);
+	KUNIT_EXPECT_EQ(test, ra->phy.mcs, 0);
+
+	/* an unknown field goes as is */
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_fixed_rate_ctrl(c.dev, c.vif,
+			c.sta, &c.msta->wcid, &phy, 1), 0);
+	ra = mt7915_test_ra_fixed(test, &c, 5);
+	KUNIT_ASSERT_NOT_NULL(test, ra);
