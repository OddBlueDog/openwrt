+/* Each HE MAC/PHY capability of the station maps to its firmware flag
+ * (LDPC only if we do HE LDPC); none, no flags.
+ */
+static void mt7915_test_sta_he_caps(struct kunit *test)
+{
+	struct ieee80211_he_cap_elem *elem;
+	struct mt7915_test_ctx c;
+	struct sta_rec_he *he;
+	int i;
+
+	mt7915_test_init(test, &c, NL80211_BAND_5GHZ, NL80211_IFTYPE_AP);
+	elem = &c.sta->deflink.he_cap.he_cap_elem;
+	c.sta->deflink.he_cap.has_he = true;
+
+	he = mt7915_test_he_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, he);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(he->he_cap), 0);
+	KUNIT_EXPECT_EQ(test, he->pkt_ext, 2);
+
+	for (i = 0; i < ARRAY_SIZE(mt7915_test_he_caps); i++) {
+		memset(elem, 0, sizeof(*elem));
+		if (mt7915_test_he_caps[i].phy)
+			elem->phy_cap_info[mt7915_test_he_caps[i].idx] =
+				mt7915_test_he_caps[i].bit;
+		else
+			elem->mac_cap_info[mt7915_test_he_caps[i].idx] =
+				mt7915_test_he_caps[i].bit;
+		he = mt7915_test_he_tlv(test, &c);
+		KUNIT_ASSERT_NOT_NULL(test, he);
+		KUNIT_EXPECT_EQ_MSG(test, le32_to_cpu(he->he_cap),
+				    mt7915_test_he_caps[i].cap, "cap %d", i);
+	}
+
+	memset(elem, 0, sizeof(*elem));
+	elem->phy_cap_info[1] = IEEE80211_HE_PHY_CAP1_LDPC_CODING_IN_PAYLOAD;
+	c.mvif->cap.he_ldpc = false;
+	he = mt7915_test_he_tlv(test, &c);
+	KUNIT_ASSERT_NOT_NULL(test, he);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(he->he_cap), 0);
+
+	/* no HE, no TLV */
+	c.sta->deflink.he_cap.has_he = false;
+	KUNIT_EXPECT_NULL(test, mt7915_test_he_tlv(test, &c));
+}
