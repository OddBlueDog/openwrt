+/* --- tx power, SKU limits and thermal ------------------------------------ */
+
+struct mt7915_mcu2_power_req {
+	u8 format_id;
+	u8 val;			/* category, enable, ... */
+	u8 band_idx;
+	s8 power;		/* txpower_min, or reserved */
+} __packed;
+
+/* rate power the firmware reports for SKU table entry @i on @band (0.5 dB) */
+static s8 mt7915_mcu2_sku_pwr(int i, int band)
+{
+	return band ? i % 23 : 30 + i % 7;
+}
+
+/* the firmware's rate power table: 4 header bytes, then per rate its
+ * power on band 0 and band 1; @len bytes of it
+ */
+static void mt7915_mcu2_sku_reply(struct kunit *test, int len)
+{
+	s8 buf[4 + MT7915_SKU_RATE_NUM * 2] = {};
+	int i;
+
+	for (i = 0; i < MT7915_SKU_RATE_NUM; i++) {
+		buf[4 + 2 * i] = mt7915_mcu2_sku_pwr(i, 0);
+		buf[4 + 2 * i + 1] = mt7915_mcu2_sku_pwr(i, 1);
+	}
+	mt7915_mcu2_reply(test, buf, len);
+}
+
+/* The rate power table read back from the firmware: per rate, the column
+ * of the radio's band. Callers may ask for fewer rates.
+ */
+static void mt7915_mcu2_get_sku_rate(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu2_power_req *req;
+	s8 pwr[MT7915_SKU_RATE_NUM + 1];
+	int i;
+
+	mt7915_mcu2_sku_reply(test, 4 + MT7915_SKU_RATE_NUM * 2);
+	dev->mphy.band_idx = MT_BAND1;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_get_txpower_sku(&dev->phy, pwr,
+			MT7915_SKU_RATE_NUM, TX_POWER_INFO_RATE), 0);
+	req = (const void *)mt7915_mcu2_msg(test,
+			MCU_EXT_CMD(TX_POWER_FEATURE_CTRL), 4)->data;
+	KUNIT_EXPECT_EQ(test, req->format_id, TX_POWER_LIMIT_INFO);
+	KUNIT_EXPECT_EQ(test, req->val, TX_POWER_INFO_RATE);
+	KUNIT_EXPECT_EQ(test, req->band_idx, MT_BAND1);
+	for (i = 0; i < MT7915_SKU_RATE_NUM; i++)
+		KUNIT_EXPECT_EQ(test, pwr[i], mt7915_mcu2_sku_pwr(i, 1));
+
+	dev->mphy.band_idx = MT_BAND0;
+	memset(pwr, 0x7f, sizeof(pwr));
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_get_txpower_sku(&dev->phy, pwr, 10,
+			TX_POWER_INFO_RATE), 0);
+	for (i = 0; i < 10; i++)
+		KUNIT_EXPECT_EQ(test, pwr[i], mt7915_mcu2_sku_pwr(i, 0));
+	KUNIT_EXPECT_EQ(test, pwr[10], 0x7f);
+}
+
+/* The per-path table comes back as the firmware sent it; replies too short
+ * for what was asked are refused, unknown categories read nothing.
+ */
+static void mt7915_mcu2_get_sku_path(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	u8 reply[4 + MT7915_SKU_PATH_NUM];
+	s8 pwr[MT7915_SKU_PATH_NUM];
+	int i;
+
+	for (i = 0; i < sizeof(reply); i++)
+		reply[i] = i * 3;
+	mt7915_mcu2_reply(test, reply, sizeof(reply));
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_get_txpower_sku(&dev->phy, pwr,
+			sizeof(pwr), TX_POWER_INFO_PATH), 0);
+	KUNIT_EXPECT_EQ(test, memcmp(pwr, reply + 4, sizeof(pwr)), 0);
+
+	mt7915_mcu2_reply(test, reply, 4 + 100);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_txpower_sku(&dev->phy, pwr,
+			sizeof(pwr), TX_POWER_INFO_PATH), -EINVAL);
+	mt7915_mcu2_sku_reply(test, 4 + MT7915_SKU_RATE_NUM * 2 - 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_txpower_sku(&dev->phy, pwr,
+			MT7915_SKU_RATE_NUM, TX_POWER_INFO_RATE), -EINVAL);
+
+	memset(pwr, 0x55, sizeof(pwr));
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_txpower_sku(&dev->phy, pwr,
+			sizeof(pwr), 0), 0);
+	KUNIT_EXPECT_EQ(test, pwr[0], 0x55);
+
+	mt76_test_fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_txpower_sku(&dev->phy, pwr,
+			sizeof(pwr), TX_POWER_INFO_PATH), -EIO);
+}
+
+/* The global minimum frame power, in 0.5 dB steps */
+static void mt7915_mcu2_txpower_frame_min(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu2_power_req *req;
+	int cmd = MCU_EXT_CMD(TX_POWER_FEATURE_CTRL);
+
+	dev->mphy.band_idx = MT_BAND1;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_txpower_frame_min(&dev->phy, 3),
+			0);
+	req = (const void *)mt7915_mcu2_msg(test, cmd, 4)->data;
+	KUNIT_EXPECT_EQ(test, req->format_id, TX_POWER_LIMIT_FRAME_MIN);
+	KUNIT_EXPECT_EQ(test, req->band_idx, MT_BAND1);
+	KUNIT_EXPECT_EQ(test, req->power, 6);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_txpower_frame_min(&dev->phy, -2),
+			0);
+	req = (const void *)mt7915_mcu2_msg(test, cmd, 4)->data;
+	KUNIT_EXPECT_EQ(test, req->power, -4);
+}
+
+struct mt7915_mcu2_frame_req {
+	u8 format_id;
+	u8 rsv[3];
+	u8 band_idx;
+	s8 txpower_max;
+	__le16 wcid;
+	s8 txpower_offs[48];
+} __packed;
+
+/* a station's per-frame power limit; @ht/@vht/@he: what it supports. The
+ * radio has two chains and 20 dBm (40 half dB) to give.
+ */
+static int mt7915_mcu2_txpower_frame(struct kunit *test,
+				     struct mt7915_dev *dev, bool ht, bool vht,
+				     bool he, s8 txpower)
+{
+	struct ieee80211_vif *vif = mt7915_mcu2_vif(test, dev);
+	struct ieee80211_sta *sta = mt7915_mcu2_sta(test, vif, 0x155);
+
+	sta->deflink.ht_cap.ht_supported = ht;
+	sta->deflink.vht_cap.vht_supported = vht;
+	sta->deflink.he_cap.has_he = he;
+	dev->mphy.band_idx = MT_BAND1;
+	dev->mphy.chainmask = 0x3;
+	dev->mphy.txpower_cur = 40;
+	mt7915_mcu2_sku_reply(test, 4 + MT7915_SKU_RATE_NUM * 2);
+
+	return mt7915_mcu_set_txpower_frame(&dev->phy, vif, sta, txpower);
+}
+
+/* the frame limit sent: @len offsets from table entry @offs for a limit of
+ * @limit half dB (the user's dBm less the two-chain gain), in 1 dB steps
+ */
+static void mt7915_mcu2_expect_frame_req(struct kunit *test, int offs,
+					 int len, int limit)
+{
+	const struct mt7915_mcu2_frame_req *req;
+	int i, want;
+
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 2);
+	req = (const void *)mt7915_mcu2_nth(test, 1,
+			MCU_EXT_CMD(TX_POWER_FEATURE_CTRL),
+			sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, req->format_id, TX_POWER_LIMIT_FRAME);
+	KUNIT_EXPECT_EQ(test, req->band_idx, MT_BAND1);
+	KUNIT_EXPECT_EQ(test, req->txpower_max, 20);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->wcid), 0x155);
+	for (i = 0; i < ARRAY_SIZE(req->txpower_offs); i++) {
+		want = i < len ?
+		       (limit - mt7915_mcu2_sku_pwr(offs + i, 1) + 1) / 2 : 0;
+		KUNIT_EXPECT_EQ_MSG(test, req->txpower_offs[i], want,
+				    "offset %d", i);
+	}
+}
+
+/* A per-station tx power limit (iw ... station set ... txpower) is a set
+ * of offsets against the band's rate table, for the station's best rate
+ * group: HE (RU242 and up), else VHT, else HT.
+ */
+static void mt7915_mcu2_txpower_frame_he(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_txpower_frame(test, dev, true, true,
+							true, 17), 0);
+	/* CCK, OFDM, HT20, HT40, 4x VHT, 3x HE RU26..RU106 come first */
+	mt7915_mcu2_expect_frame_req(test, 4 + 8 + 8 + 9 + 4 * 12 + 3 * 12,
+				     4 * 12, 2 * 17 - 6);
+}
+
+static void mt7915_mcu2_txpower_frame_vht(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_txpower_frame(test, dev, true, true,
+							false, 17), 0);
+	mt7915_mcu2_expect_frame_req(test, 4 + 8 + 8 + 9, 4 * 12, 28);
+}
+
+static void mt7915_mcu2_txpower_frame_ht(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_txpower_frame(test, dev, true, false,
+							true, 12), 0);
+	mt7915_mcu2_expect_frame_req(test, 4 + 8, 8 + 9, 2 * 12 - 6);
+}
+
+/* Legacy-only stations can't get a limit, nor can a limit above what the
+ * radio transmits; the rate table query failing stops it all.
+ */
+static void mt7915_mcu2_txpower_frame_errors(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_txpower_frame(test, dev, false,
+							false, false, 17),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_txpower_frame(test, dev, true, true,
+							true, 30), -EINVAL);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 2);
+	fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu2_txpower_frame(test, dev, true, true,
+							true, 17), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 3);
+}
+
+/* Setting a station back to automatic power (0, what mac80211 passes for
+ * NL80211_TX_POWER_AUTOMATIC) should clear its offsets; on a radio with
+ * more than one chain the chain gain makes the bound negative and it fails.
+ */
+static void mt7915_mcu2_txpower_frame_auto(struct kunit *test)
+{
+	struct mt7915_dev *dev;
+
+	kunit_skip(test, "driver bug: txpower auto (0) for a station gives -EINVAL on multi-chain radios");
+	dev = mt7915_test_dev(test);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_txpower_frame(test, dev, true, true,
+							true, 0), 0);
+	mt7915_mcu2_expect_frame_req(test, 0, 0, 0);
+}
+
+/* the MT7976 EEPROM's 2.4 GHz target power: chain 0 15 dBm, chain 1 17 dBm
+ * (a third chain 22 dBm), plus @delta: the band's rate delta byte
+ */
+static void mt7915_mcu2_power_eeprom(struct kunit *test,
+				     struct mt7915_dev *dev, u8 delta)
+{
+	u8 *eep = dev->mt76.eeprom.data;
+
+	if (!eep)
+		eep = mt7915_mcu2_eeprom(test, dev);
+	mt7915_mcu2_set_adie(dev, MT_ADIE_TYPE_MASK);
+	eep[MT_EE_TX0_POWER_2G_V2] = 30;
+	eep[MT_EE_TX0_POWER_2G_V2 + 1] = 34;
+	eep[MT_EE_TX0_POWER_2G_V2 + 2] = 44;
+	eep[MT_EE_RATE_DELTA_2G_V2] = delta;
+}
+
+/* a two-chain 2.4 GHz radio on channel 6, the user asking for @dbm */
+static void mt7915_mcu2_power_setup(struct kunit *test,
+				    struct mt7915_dev *dev, int dbm)
+{
+	mt7915_mcu2_bands(test, dev);
+	dev->mphy.chainmask = 0x3;
+	dev->mphy.band_idx = MT_BAND0;
+	mt7915_mcu2_tune(test, dev, 2437, NL80211_CHAN_WIDTH_20_NOHT, 2437);
+	dev->mphy.main_chandef = dev->mphy.chandef;
+	dev->mphy.hw->conf.power_level = dbm;
+}
+
+/* Without SKU limits the radio uses the EEPROM power of its best chain plus
+ * the signed rate delta, and no table is sent; untuned, the user's power.
+ */
+static void mt7915_mcu2_txpower_sku_off(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+
+	mt7915_mcu2_power_setup(test, dev, 10);
+	mt7915_mcu2_power_eeprom(test, dev, MT_EE_RATE_DELTA_EN |
+				 MT_EE_RATE_DELTA_SIGN | 2);
+	dev->phy.sku_limit_en = false;
+
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_txpower_sku(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.txpower_cur, 36);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 0);
+
+	mt7915_mcu2_power_eeprom(test, dev, MT_EE_RATE_DELTA_EN | 3);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_txpower_sku(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.txpower_cur, 31);
+
+	mt7915_mcu2_power_eeprom(test, dev, 3);	/* delta not enabled */
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_txpower_sku(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.txpower_cur, 34);
+
+	dev->mphy.main_chandef.chan = NULL;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_txpower_sku(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.txpower_cur, 2 * 10 - 6);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 0);
+}
+
+/* the rate table sent, with every rate at @pwr: CCK and OFDM, HT20, HT40,
+ * then the four VHT bandwidths with two padding bytes each, then HE
+ */
+static void mt7915_mcu2_expect_sku_table(struct kunit *test, s8 pwr)
+{
+	s8 want[MT7915_SKU_RATE_NUM];
+	const u8 *data;
+	int i, vht = 4 + 8 + 8 + 9;
+
+	memset(want, pwr, sizeof(want));
+	for (i = 0; i < 4; i++) {
+		want[vht + i * 12 + 10] = 0;
+		want[vht + i * 12 + 11] = 0;
+	}
+	data = mt7915_mcu2_nth(test, 0, MCU_EXT_CMD(TX_POWER_FEATURE_CTRL),
+			       3 + MT7915_SKU_RATE_NUM)->data;
+	KUNIT_EXPECT_EQ(test, data[0], TX_POWER_LIMIT_TABLE);
+	KUNIT_EXPECT_EQ(test, data[1], 0);		/* rate limits */
+	KUNIT_EXPECT_EQ(test, data[2], MT_BAND1);
+	KUNIT_EXPECT_EQ(test, memcmp(data + 3, want, sizeof(want)), 0);
+}
+
+/* With SKU limits on, the radio transmits the lower of the EEPROM's and
+ * the user's power, and the firmware gets the rate power table: the user's
+ * power for every rate (there's no regulatory table in the device tree).
+ */
+static void mt7915_mcu2_txpower_sku_table(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+
+	mt7915_mcu2_power_setup(test, dev, 10);
+	mt7915_mcu2_power_eeprom(test, dev, MT_EE_RATE_DELTA_EN |
+				 MT_EE_RATE_DELTA_SIGN | 2);
+	dev->mphy.band_idx = MT_BAND1;
+	dev->phy.sku_limit_en = true;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_txpower_sku(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.txpower_cur, 14);
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 1);
+	mt7915_mcu2_expect_sku_table(test, 14);
+
+	dev->mphy.hw->conf.power_level = 30;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_txpower_sku(&dev->phy), 0);
+	KUNIT_EXPECT_EQ(test, dev->mphy.txpower_cur, 36);
+}
+
+/* The per-path table follows when per-path limits are configured: the same
+ * header with the path limit type, and all the path entries.
+ */
+static void mt7915_mcu2_txpower_sku_path(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt76_test_fake *fake = mt76_test_fake;
+	u8 zero[MT7915_SKU_PATH_NUM] = {};
+	const u8 *data;
+
+	mt7915_mcu2_power_setup(test, dev, 10);
+	mt7915_mcu2_power_eeprom(test, dev, 0);
+	dev->mphy.band_idx = MT_BAND1;
+	dev->phy.sku_limit_en = true;
+	dev->phy.sku_path_en = true;
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_txpower_sku(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, fake->n_msgs, 2);
+	mt7915_mcu2_expect_sku_table(test, 14);
+	data = mt7915_mcu2_nth(test, 1, MCU_EXT_CMD(TX_POWER_FEATURE_CTRL),
+			       3 + MT7915_SKU_PATH_NUM)->data;
+	KUNIT_EXPECT_EQ(test, data[0], TX_POWER_LIMIT_TABLE);
+	KUNIT_EXPECT_EQ(test, data[1], 1);		/* path limits */
+	KUNIT_EXPECT_EQ(test, data[2], MT_BAND1);
+	KUNIT_EXPECT_EQ(test, memcmp(data + 3, zero, sizeof(zero)), 0);
+
+	mt7915_mcu2_fail_nth(dev, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_txpower_sku(&dev->phy), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 3);
+	mt7915_mcu2_fail_nth(dev, 2);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_txpower_sku(&dev->phy), -EIO);
+	KUNIT_EXPECT_EQ(test, fake->n_msgs, 5);
+}
+
+/* SKU limits and per-path limits are two switches, sent in that order */
+static void mt7915_mcu2_sku_en(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	int cmd = MCU_EXT_CMD(TX_POWER_FEATURE_CTRL);
+	const struct mt7915_mcu2_power_req *req;
+
+	dev->mphy.band_idx = MT_BAND1;
+	dev->phy.sku_limit_en = true;
+	dev->phy.sku_path_en = false;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_sku_en(&dev->phy), 0);
+	req = (const void *)mt7915_mcu2_nth(test, 0, cmd, 4)->data;
+	KUNIT_EXPECT_EQ(test, req->format_id, TX_POWER_LIMIT_ENABLE);
+	KUNIT_EXPECT_EQ(test, req->val, 1);
+	KUNIT_EXPECT_EQ(test, req->band_idx, MT_BAND1);
+	req = (const void *)mt7915_mcu2_nth(test, 1, cmd, 4)->data;
+	KUNIT_EXPECT_EQ(test, req->format_id, TX_POWER_LIMIT_PATH_ENABLE);
+	KUNIT_EXPECT_EQ(test, req->val, 0);
+	KUNIT_EXPECT_EQ(test, req->band_idx, MT_BAND1);
+
+	dev->phy.sku_limit_en = false;
+	dev->phy.sku_path_en = true;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_sku_en(&dev->phy), 0);
+	req = (const void *)mt7915_mcu2_nth(test, 2, cmd, 4)->data;
+	KUNIT_EXPECT_EQ(test, req->val, 0);
+	req = (const void *)mt7915_mcu2_nth(test, 3, cmd, 4)->data;
+	KUNIT_EXPECT_EQ(test, req->val, 1);
+
+	mt7915_mcu2_fail_nth(dev, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_sku_en(&dev->phy), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 5);
+}
+
+/* The temperature query returns the firmware's reading (the reply's second
+ * word) as its result.
+ */
+static void mt7915_mcu2_temperature(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	__le32 reply[2] = { cpu_to_le32(0xdead), cpu_to_le32(47) };
+	const u8 *req;
+
+	mt7915_mcu2_reply(test, reply, sizeof(reply));
+	dev->mphy.band_idx = MT_BAND1;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_temperature(&dev->phy), 47);
+	req = mt7915_mcu2_msg(test, MCU_EXT_CMD(THERMAL_CTRL), 8)->data;
+	KUNIT_EXPECT_EQ(test, req[0], THERMAL_SENSOR_TEMP_QUERY);
+	KUNIT_EXPECT_EQ(test, req[1], 0);		/* action */
+	KUNIT_EXPECT_EQ(test, req[2], MT_BAND1);
+
+	mt76_test_fake->mcu_ret = -EIO;
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_get_temperature(&dev->phy), -EIO);
+}
+
+/* Throttling sets four duty levels, each with half the previous duty
+ * cycle; an error stops there.
+ */
+static void mt7915_mcu2_thermal_throttling(struct kunit *test)
+{
+	static const u8 duty[] = { 100, 50, 25, 12 };
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	const struct mt7915_mcu_thermal_ctrl *req;
+	int i;
+
+	dev->mphy.band_idx = MT_BAND1;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_thermal_throttling(&dev->phy,
+			100), 0);
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 4);
+	for (i = 0; i < 4; i++) {
+		req = (const void *)mt7915_mcu2_nth(test, i,
+				MCU_EXT_CMD(THERMAL_PROT), sizeof(*req))->data;
+		KUNIT_EXPECT_EQ(test, req->ctrl_id,
+				THERMAL_PROTECT_DUTY_CONFIG);
+		KUNIT_EXPECT_EQ(test, req->band_idx, MT_BAND1);
+		KUNIT_EXPECT_EQ(test, req->duty.duty_level, i);
+		KUNIT_EXPECT_EQ(test, req->duty.duty_cycle, duty[i]);
+	}
+
+	mt7915_mcu2_fail_nth(dev, 2);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_thermal_throttling(&dev->phy,
+			100), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 6);
+}
+
+/* Thermal protection is turned off, then on again with its trigger
+ * temperature and a restore temperature 10 degrees below the critical one.
+ */
+static void mt7915_mcu2_thermal_protect(struct kunit *test)
+{
+	struct {
+		struct mt7915_mcu_thermal_ctrl ctrl;
+		__le32 trigger_temp;
+		__le32 restore_temp;
+		__le16 sustain_time;
+		u8 rsv[2];
+	} __packed *req;
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	int cmd = MCU_EXT_CMD(THERMAL_PROT);
+
+	dev->mphy.band_idx = MT_BAND1;
+	dev->phy.throttle_temp[0] = 110;
+	dev->phy.throttle_temp[1] = 120;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_thermal_protect(&dev->phy), 0);
+	KUNIT_ASSERT_EQ(test, mt76_test_fake->n_msgs, 2);
+
+	req = (void *)mt7915_mcu2_nth(test, 0, cmd, sizeof(req->ctrl))->data;
+	KUNIT_EXPECT_EQ(test, req->ctrl.ctrl_id, THERMAL_PROTECT_DISABLE);
+	KUNIT_EXPECT_EQ(test, req->ctrl.band_idx, MT_BAND1);
+	KUNIT_EXPECT_EQ(test, req->ctrl.type.protect_type, 1);
+	KUNIT_EXPECT_EQ(test, req->ctrl.type.trigger_type, 1);
+
+	req = (void *)mt7915_mcu2_nth(test, 1, cmd, sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, req->ctrl.ctrl_id, THERMAL_PROTECT_ENABLE);
+	KUNIT_EXPECT_EQ(test, req->ctrl.band_idx, MT_BAND1);
+	KUNIT_EXPECT_EQ(test, req->ctrl.type.protect_type, 1);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->trigger_temp), 120);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->restore_temp), 100);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->sustain_time), 10);
+
+	mt7915_mcu2_fail_nth(dev, 1);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_thermal_protect(&dev->phy), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 3);
+	mt7915_mcu2_fail_nth(dev, 2);
+	KUNIT_EXPECT_EQ(test, mt7915_mcu_set_thermal_protect(&dev->phy), -EIO);
+	KUNIT_EXPECT_EQ(test, mt76_test_fake->n_msgs, 5);
+}
