+/* @c's station's STA_REC_HE, built on its own */
+static struct sta_rec_he *mt7915_test_he_tlv(struct kunit *test,
+					     struct mt7915_test_ctx *c)
+{
+	struct sk_buff *skb = mt7915_test_sta_req(test, c, &c->msta->wcid);
+
+	mt7915_mcu_sta_he_tlv(skb, c->sta, c->vif);
+	return mt7915_test_skb_tlv(test, skb, STA_REC_HE, struct sta_rec_he);
+}
