+struct mt7915_mcu2_rx_rate {
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+	struct rate_info rate;
+};
+
+/* the last received rate of station 0x42 as the firmware reports it */
+static int mt7915_mcu2_get_rx_rate(struct kunit *test, struct mt7915_dev *dev,
+				   struct mt7915_mcu2_rx_rate *r,
+				   u8 mode, u8 rate, u8 nsts, u8 gi, u8 stbc,
+				   u8 bw)
+{
+	struct mt7915_mcu_phy_rx_info res = {
+		.category = MCU_PHY_STATE_CONTENTION_RX_RATE,
+		.rate = rate,
+		.mode = mode,
+		.nsts = nsts,
+		.gi = gi,
+		.stbc = stbc,
+		.bw = bw,
+	};
+
+	if (!r->vif) {
+		r->vif = mt7915_mcu2_vif(test, dev);
+		r->sta = mt7915_mcu2_sta(test, r->vif, 0x42);
+	}
+	memset(&r->rate, 0, sizeof(r->rate));
+	r->rate.bw = 0xff;		/* must be set, even to 20 MHz */
+	mt7915_mcu2_reply(test, &res, sizeof(res));
+	return mt7915_mcu_get_rx_rate(&dev->phy, r->vif, r->sta, &r->rate);
+}
+
+/* HT, VHT and HE rates come back as MCS, spatial streams (STBC halves the
+ * space-time streams), guard interval and bandwidth, as the station info
+ * the user sees.
+ */
+static void mt7915_mcu2_rx_rate_mcs(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct mt7915_mcu2_rx_rate r = {};
+	struct {
+		u8 category;
+		u8 band;
+		__le16 wcid;
+	} __packed *req;
+
+	dev->mphy.band_idx = MT_BAND1;
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_HE_SU, 11, 1, NL80211_RATE_INFO_HE_GI_3_2,
+			0, IEEE80211_STA_RX_BW_160), 0);
+	req = (void *)mt7915_mcu2_msg(test, MCU_EXT_CMD(PHY_STAT_INFO),
+				      sizeof(*req))->data;
+	KUNIT_EXPECT_EQ(test, req->category, MCU_PHY_STATE_CONTENTION_RX_RATE);
+	KUNIT_EXPECT_EQ(test, req->band, MT_BAND1);
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(req->wcid), 0x42);
+	KUNIT_EXPECT_EQ(test, r.rate.mcs, 11);
+	KUNIT_EXPECT_EQ(test, r.rate.nss, 2);
+	KUNIT_EXPECT_EQ(test, r.rate.he_gi, NL80211_RATE_INFO_HE_GI_3_2);
+	KUNIT_EXPECT_EQ(test, r.rate.flags, RATE_INFO_FLAGS_HE_MCS);
+	KUNIT_EXPECT_EQ(test, r.rate.bw, RATE_INFO_BW_160);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_HE_MU, 7, 3, 0, 1,
+			IEEE80211_STA_RX_BW_80), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.nss, 2);	/* 4 STS with STBC */
+	KUNIT_EXPECT_EQ(test, r.rate.bw, RATE_INFO_BW_80);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_HE_TB, 7, 0, 0, 1,
+			IEEE80211_STA_RX_BW_20), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.nss, 1);		/* 1 STS stays 1 */
+	KUNIT_EXPECT_EQ(test, r.rate.bw, RATE_INFO_BW_20);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_HE_EXT_SU, 0, 0, 1, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.he_gi, 1);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_VHT, 9, 3, 1, 0,
+			IEEE80211_STA_RX_BW_80), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.mcs, 9);
+	KUNIT_EXPECT_EQ(test, r.rate.nss, 4);
+	KUNIT_EXPECT_EQ(test, r.rate.flags, RATE_INFO_FLAGS_VHT_MCS |
+					    RATE_INFO_FLAGS_SHORT_GI);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_VHT, 0, 0, 0, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.flags, RATE_INFO_FLAGS_VHT_MCS);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_HT, 31, 3, 0, 0,
+			IEEE80211_STA_RX_BW_40), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.mcs, 31);
+	KUNIT_EXPECT_EQ(test, r.rate.flags, RATE_INFO_FLAGS_MCS);
+	KUNIT_EXPECT_EQ(test, r.rate.bw, RATE_INFO_BW_40);
+	KUNIT_ASSERT_EQ(test, mt7915_mcu2_get_rx_rate(test, dev, &r,
+			MT_PHY_TYPE_HT_GF, 7, 0, 1, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, r.rate.flags, RATE_INFO_FLAGS_MCS |
+					    RATE_INFO_FLAGS_SHORT_GI);
+}
