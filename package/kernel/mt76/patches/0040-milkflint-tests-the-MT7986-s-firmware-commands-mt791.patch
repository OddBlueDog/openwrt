+/* the @i-th SET_SPR message: a simple @action, value @val, on band @band */
+static void mt7915_test_expect_spr(struct kunit *test,
+				   struct mt76_test_fake *fake, int i,
+				   u8 action, u32 val, u8 band)
+{
+	struct mt76_test_msg *msg = mt76_test_msg(fake, i);
+	struct mt7915_mcu_sr_ctrl *ctrl;
+
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_EXPECT_EQ(test, msg->cmd, MCU_EXT_CMD(SET_SPR));
+	KUNIT_EXPECT_EQ(test, msg->len, (int)sizeof(*ctrl));
+	ctrl = mt7915_test_payload(msg, struct mt7915_mcu_sr_ctrl);
+	KUNIT_ASSERT_NOT_NULL(test, ctrl);
+	KUNIT_EXPECT_EQ_MSG(test, ctrl->action, action, "message %d", i);
+	KUNIT_EXPECT_EQ(test, ctrl->argnum, 1);
+	KUNIT_EXPECT_EQ(test, ctrl->band_idx, band);
+	KUNIT_EXPECT_EQ_MSG(test, le32_to_cpu(ctrl->val), val, "message %d", i);
+}
