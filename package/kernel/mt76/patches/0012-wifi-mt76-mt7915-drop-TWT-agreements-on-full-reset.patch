From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Sun, 18 Oct 2026 21:16:34 +0100
Subject: [PATCH] wifi: mt76: mt7915: drop TWT agreements on full reset

mt7915_mac_full_reset() re-initialises dev->twt_list but leaves each
station's flowid_mask and the device's table_mask and n_agrt as they
were. mac80211 keeps the station private data across the restart, so a
later teardown list_del()s a flow whose neighbours point into the old
list, which can make stale flows reachable from the new list head again,
and table slots and the agreement count leak.

The restarted firmware has no agreements anyway, so unlink every flow,
clear its owner's flowid bit and reset the table state.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mt7915/mac.c | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/mt7915/mac.c b/mt7915/mac.c
index a47ea09f..73e7faac 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1422,6 +1422,26 @@ out:
 	return ret;
 }
 
+static void mt7915_mac_twt_reset(struct mt7915_dev *dev)
+{
+	struct mt7915_twt_flow *flow, *tmp;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+
+	/* the restarted firmware has no TWT agreements */
+	list_for_each_entry_safe(flow, tmp, &dev->twt_list, list) {
+		struct mt7915_sta *msta;
+
+		msta = container_of(flow - flow->id, struct mt7915_sta,
+				    twt.flow[0]);
+		msta->twt.flowid_mask &= ~BIT(flow->id);
+		list_del_init(&flow->list);
+	}
+
+	dev->twt.table_mask = 0;
+	dev->twt.n_agrt = 0;
+}
+
 static void
 mt7915_mac_full_reset(struct mt7915_dev *dev)
 {
@@ -1467,7 +1487,7 @@ mt7915_mac_full_reset(struct mt7915_dev *dev)
 	mt76_reset_device(&dev->mt76);
 
 	INIT_LIST_HEAD(&dev->sta_rc_list);
-	INIT_LIST_HEAD(&dev->twt_list);
+	mt7915_mac_twt_reset(dev);
 
 	i = mt76_wcid_alloc(dev->mt76.wcid_mask, MT7915_WTBL_STA);
 	dev->mt76.global_wcid.idx = i;
