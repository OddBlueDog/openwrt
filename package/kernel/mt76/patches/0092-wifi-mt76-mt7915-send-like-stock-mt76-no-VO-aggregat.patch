+++ b/mt76_connac_mac.c
@@ -1179,6 +1179,10 @@ int mt76_connac2_mac_fill_rx_rate(struct mt76_dev *dev,
 }
 EXPORT_SYMBOL_GPL(mt76_connac2_mac_fill_rx_rate);
 
+static bool vo_aggr;
+module_param(vo_aggr, bool, 0644);
+MODULE_PARM_DESC(vo_aggr, "Aggregate voice traffic (TIDs 6 and 7); off, as in stock OpenWrt's mt76");
+
 void mt76_connac2_tx_check_aggr(struct ieee80211_sta *sta, __le32 *txwi)
 {
 	struct mt76_wcid *wcid;
@@ -1190,6 +1194,8 @@ void mt76_connac2_tx_check_aggr(struct ieee80211_sta *sta, __le32 *txwi)
 		return;
 
 	tid = le32_get_bits(txwi[1], MT_TXD1_TID);
+	if (tid >= 6 && !READ_ONCE(vo_aggr)) /* skip VO queue */
+		return;
 
 	val = le32_to_cpu(txwi[2]);
 	fc = FIELD_GET(MT_TXD2_FRAME_TYPE, val) << 2 |
