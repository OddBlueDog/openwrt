diff --git a/mt7915/tests/mcu2-test.c b/mt7915/tests/mcu2-test.c
index 4feed76e..7fa10bfc 100644
--- a/mt7915/tests/mcu2-test.c
+++ b/mt7915/tests/mcu2-test.c
@@ -1152,12 +1152,22 @@ static void mt7915_mcu2_drop_wcids(void *data)
  * WTBL index, split in two bytes; the station's power save flag follows.
  * Entries that aren't stations are left alone.
  */
+static void mt7915_mcu2_ps_sync_default(void *data)
+{
+	ps_sync = false;
+}
+
 static void mt7915_mcu2_events_ps_sync(struct kunit *test)
 {
 	struct mt7915_dev *dev = mt7915_test_dev(test);
 	struct ieee80211_vif *vif = mt7915_mcu2_vif(test, dev);
 	struct mt7915_sta *hi, *lo, *notsta;
 
+	/* the ps_sync switch on; off (the default) is checked below */
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_mcu2_ps_sync_default, NULL), 0);
+	ps_sync = true;
+
 	hi = (void *)mt7915_mcu2_sta(test, vif, 0x123)->drv_priv;
 	lo = (void *)mt7915_mcu2_sta(test, vif, 0x23)->drv_priv;
 	notsta = (void *)mt7915_mcu2_sta(test, vif, 0x40)->drv_priv;
@@ -1182,6 +1192,36 @@ static void mt7915_mcu2_events_ps_sync(struct kunit *test)
 	mt7915_mcu2_ps_event(test, dev, 0x124, true);
 }
 
+/* With the ps_sync switch off (the default, as stock), a station the firmware reports dozing isn't
+ * held, and one already held is let go by its next event, dozing or not.
+ */
+static void mt7915_mcu2_events_ps_sync_off(struct kunit *test)
+{
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct ieee80211_vif *vif = mt7915_mcu2_vif(test, dev);
+	struct mt7915_sta *msta;
+
+	msta = (void *)mt7915_mcu2_sta(test, vif, 0x23)->drv_priv;
+	rcu_assign_pointer(dev->mt76.wcid[0x23], &msta->wcid);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_mcu2_drop_wcids, dev), 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_mcu2_ps_sync_default, NULL), 0);
+
+	ps_sync = false;
+	mt7915_mcu2_ps_event(test, dev, 0x23, true);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &msta->wcid.flags));
+
+	set_bit(MT_WCID_FLAG_PS, &msta->wcid.flags);
+	mt7915_mcu2_ps_event(test, dev, 0x23, true);
+	KUNIT_EXPECT_FALSE(test, test_bit(MT_WCID_FLAG_PS, &msta->wcid.flags));
+
+	/* back on, it follows the firmware again */
+	ps_sync = true;
+	mt7915_mcu2_ps_event(test, dev, 0x23, true);
+	KUNIT_EXPECT_TRUE(test, test_bit(MT_WCID_FLAG_PS, &msta->wcid.flags));
+}
+
 static void mt7915_mcu2_log_event(struct kunit *test, struct mt7915_dev *dev,
 				  u8 s2d, const void *data, int len)
 {
@@ -1244,6 +1284,7 @@ static struct kunit_case mt7915_mcu2_event_cases[] = {
 	KUNIT_CASE(mt7915_mcu2_events_thermal),
 	KUNIT_CASE(mt7915_mcu2_events_radar),
 	KUNIT_CASE(mt7915_mcu2_events_ps_sync),
+	KUNIT_CASE(mt7915_mcu2_events_ps_sync_off),
 	KUNIT_CASE(mt7915_mcu2_events_log),
 	KUNIT_CASE(mt7915_mcu2_events_csa_bcc),
 	{}
@@ -3330,6 +3371,88 @@ static void mt7915_mcu2_vow_feature(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->sch_ctrl), BIT(6));
 }
 
+static void mt7915_mcu2_vow_fw_quanta_off(void *data)
+{
+	vow_fw_quanta = false;
+}
+
+/* vow_fw_quanta: alternative airtime values. ATF without WATF, the firmware's
+ * own quantum table, and station levels one down in it; the rest as ours.
+ */
+static void mt7915_mcu2_vow_fw_quanta(struct kunit *test)
+{
+	static const u8 fw[VOW_DRR_QUANTUM_NUM] = {
+		6, 12, 16, 20, 24, 28, 32, 36
+	};
+	struct mt7915_dev *dev = mt7915_test_dev(test);
+	struct ieee80211_vif *vif = mt7915_mcu2_vif(test, dev);
+	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
+	const struct mt7915_mcu2_vow_feature *feat;
+	const struct mt7915_mcu2_drr *req;
+	struct mt7915_sta *msta;
+
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			mt7915_mcu2_vow_fw_quanta_off, NULL), 0);
+	vow_fw_quanta = true;
+	mvif->mt76.band_idx = 1;
+	mvif->mt76.omac_idx = 1;
+	msta = (void *)mt7915_mcu2_sta(test, vif, 0x123)->drv_priv;
+
+	/* the per-station levels: BK 2, BE 2, VI 1, VO 0 */
+	req = mt7915_mcu2_drr(test, dev, msta, VOW_DRR_CTRL_STA_ALL, 256);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->com_value),
+			5 | 2 << 8 | 2 << 12 | 1 << 16 | 0 << 20 | 40 << 24);
+	req = mt7915_mcu2_drr(test, dev, msta, VOW_DRR_CTRL_STA_ALL, 1024);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->com_value),
+			5 | 4 << 8 | 4 << 12 | 3 << 16 | 2 << 20 | 40 << 24);
+	/* the lowest level stays the lowest */
+	req = mt7915_mcu2_drr(test, dev, msta, VOW_DRR_CTRL_STA_ALL, 1);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->com_value), 5 | 40 << 24);
+
+	req = mt7915_mcu2_drr(test, dev, NULL,
+			      VOW_DRR_CTRL_AIRTIME_QUANTUM_ALL, 0);
+	KUNIT_EXPECT_EQ(test, memcmp(req->quantum, fw, sizeof(fw)), 0);
+
+	/* the deficit bound is 0x40 already */
+	dev->vow_atf_en = true;
+	req = mt7915_mcu2_drr(test, dev, NULL,
+			      VOW_DRR_CTRL_AIRTIME_DEFICIT_BOUND, 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(req->com_value), 0x40);
+
+	KUNIT_ASSERT_EQ(test, mt7915_mcu_set_vow_feature_ctrl(dev), 0);
+	feat = (const void *)mt7915_mcu2_msg(test, MCU_EXT_CMD(SET_FEATURE_CTRL),
+					     sizeof(*feat))->data;
