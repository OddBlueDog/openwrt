diff --git a/mt7915/mcu.c b/mt7915/mcu.c
index 076d7c9f..19e370f8 100644
--- a/mt7915/mcu.c
+++ b/mt7915/mcu.c
@@ -39,6 +39,25 @@ static bool sr_scene_detect = true;
 module_param(sr_scene_detect, bool, 0644);
 MODULE_PARM_DESC(sr_scene_detect, "Enable firmware scene detection algorithm");
 
+/* stock mt76 does these differently; each is a switch
+ * for an A/B on the router, the first two set as stock
+ */
+static bool ps_sync;
+module_param(ps_sync, bool, 0644);
+MODULE_PARM_DESC(ps_sync, "Hold back a station's frames while the firmware reports it dozing (off: hand them to the hardware, as stock mt76 does)");
+
+bool mt7915_vow_stock = true;
+module_param_named(vow_stock, mt7915_vow_stock, bool, 0444);
+MODULE_PARM_DESC(vow_stock, "Send no airtime (VoW) setup, as stock mt76: the firmware keeps its own defaults (vow_atf and vow_fw_quanta then do nothing)");
+
+static bool vow_fw_quanta;
+module_param(vow_fw_quanta, bool, 0444);
+MODULE_PARM_DESC(vow_fw_quanta, "Alternative airtime (VoW) values: no WATF with ATF, the firmware's own quantum table, station quanta one level down");
+
+static bool muru_ofdma_ul;
+module_param(muru_ofdma_ul, bool, 0644);
+MODULE_PARM_DESC(muru_ofdma_ul, "Let the firmware schedule UL OFDMA for HE stations (the firmware keeps the first station's setting per band, so set it before stations join)");
+
 static u8
 mt7915_mcu_get_sta_nss(u16 mcs_map)
 {
@@ -443,7 +462,9 @@ mt7915_mcu_rx_ps_sync(struct mt7915_dev *dev, struct sk_buff *skb)
 	if (!wcid || !wcid_to_sta(wcid))
 		return;
 
-	mt76_sta_ps_transition(&dev->mt76, wcid, !!p->ps_bit);
+	/* switched off, every event wakes the station: none stays held */
+	mt76_sta_ps_transition(&dev->mt76, wcid,
+			       READ_ONCE(ps_sync) && p->ps_bit);
 }
 
 static void
@@ -981,6 +1002,7 @@ mt7915_mcu_sta_muru_tlv(struct mt7915_dev *dev, struct sk_buff *skb,
 	if (!is_mt7915(&dev->mt76))
 		muru->cfg.mimo_ul_en = true;
 	muru->cfg.ofdma_dl_en = true;
+	muru->cfg.ofdma_ul_en = READ_ONCE(muru_ofdma_ul);
 
 	if (sta->deflink.vht_cap.vht_supported)
 		muru->mimo_dl.vht_mu_bfee =
@@ -1762,7 +1784,7 @@ mt7915_mcu_add_group(struct mt7915_dev *dev, struct ieee80211_vif *vif,
 		u8 rsv1[8];
 	} __packed req = {
 		.action = cpu_to_le32(MT_STA_BSS_GROUP),
-		.val = cpu_to_le32(is_mt7915(&dev->mt76) ?
+		.val = cpu_to_le32(is_mt7915(&dev->mt76) || mt7915_vow_stock ?
 				   mvif->mt76.idx % 16 :
 				   mt7915_vow_sta_bss_grp(&mvif->mt76)),
 	};
@@ -3736,6 +3758,16 @@ int mt7915_mcu_set_ser(struct mt7915_dev *dev, u8 action, u8 set, u8 band)
 				 &req, sizeof(req), false);
 }
 
+/* an AC's quantum level for a station's airtime weight; vow_fw_quanta
+ * puts it one down, in its table of twice the airtime per level
+ */
+static u8 mt7915_vow_sta_quantum(u16 weight, u8 ac)
+{
+	u8 level = mt76_connac_vow_dwrr_quantum(weight, ac);
+
+	return vow_fw_quanta && level ? level - 1 : level;
+}
+
 int mt7915_mcu_set_vow_drr_ctrl(struct mt7915_dev *dev, struct mt7915_sta *msta,
 				enum vow_drr_ctrl_id id, u16 weight)
 {
@@ -3763,13 +3795,13 @@ int mt7915_mcu_set_vow_drr_ctrl(struct mt7915_dev *dev, struct mt7915_sta *msta,
 		setting |= FIELD_PREP(VOW_DRR_STA_BSS_GRP_MASK,
 				      mt7915_vow_sta_bss_grp(&msta->vif->mt76));
 		setting |= FIELD_PREP(VOW_DRR_STA_AC0_QNTM_MASK,
-				      mt76_connac_vow_dwrr_quantum(weight, IEEE80211_AC_BK));
+				      mt7915_vow_sta_quantum(weight, IEEE80211_AC_BK));
 		setting |= FIELD_PREP(VOW_DRR_STA_AC1_QNTM_MASK,
-				      mt76_connac_vow_dwrr_quantum(weight, IEEE80211_AC_BE));
+				      mt7915_vow_sta_quantum(weight, IEEE80211_AC_BE));
 		setting |= FIELD_PREP(VOW_DRR_STA_AC2_QNTM_MASK,
-				      mt76_connac_vow_dwrr_quantum(weight, IEEE80211_AC_VI));
+				      mt7915_vow_sta_quantum(weight, IEEE80211_AC_VI));
 		setting |= FIELD_PREP(VOW_DRR_STA_AC3_QNTM_MASK,
-				      mt76_connac_vow_dwrr_quantum(weight, IEEE80211_AC_VO));
+				      mt7915_vow_sta_quantum(weight, IEEE80211_AC_VO));
 		setting |= UMAC_BWC_GROUP_MIN << 24;
 		req.air_time_ctrl.com_value = cpu_to_le32(setting);
 		break;
@@ -3783,9 +3815,13 @@ int mt7915_mcu_set_vow_drr_ctrl(struct mt7915_dev *dev, struct mt7915_sta *msta,
 		break;
 	case VOW_DRR_CTRL_AIRTIME_QUANTUM_ALL: {
 		static const u8 quantum[VOW_DRR_QUANTUM_NUM] = VOW_DRR_QUANTUM_TABLE;
+		/* the firmware's own boot table */
+		static const u8 fw[VOW_DRR_QUANTUM_NUM] = {
+			6, 12, 16, 20, 24, 28, 32, 36
+		};
 
 		memcpy(req.air_time_ctrl.air_time_quantum_all.air_time_quantum,
-		       quantum, sizeof(quantum));
+		       vow_fw_quanta ? fw : quantum, sizeof(quantum));
 		break;
 	}
 	default:
@@ -3820,7 +3856,7 @@ int mt7915_mcu_set_vow_feature_ctrl(struct mt7915_dev *dev)
 	value |= VOW_REFILL_PERIOD_32US;
 	value |= 1 << 4;
 	value |= 1 << 5;
-	value |= dev->vow_atf_en << 9;	/* WATF enable */
+	value |= (dev->vow_atf_en && !vow_fw_quanta) << 9;	/* WATF enable */
 	value |= 1 << 12;
 	value |= dev->vow_atf_en << 13;	/* ATF enable */
 	value |= 1 << 14;
