--- a/mt7915/tests/mcu-test.c
+++ b/mt7915/tests/mcu-test.c
@@ -2818,9 +2818,14 @@ static struct sta_rec_muru *mt7915_test_muru_tlv(struct kunit *test,
 				   struct sta_rec_muru);
