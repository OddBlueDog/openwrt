diff --git a/src/start-sqm b/src/start-sqm
index 7f99727..4ee5263 100755
--- a/src/start-sqm
+++ b/src/start-sqm
@@ -69,6 +69,12 @@ fi
 ret=$?
 if [ "$ret" -ne 0 ]; then
     sqm_error "${SCRIPT} failed to start on ${IFACE} (exit ${ret})"
+    # Take down what it set up: with no state file, no stop would, and
+    # downloads mustn't be redirected to an ifb that doesn't shape them.
+    CUR_IFB=${DEV:-$(ifb_name ${IFACE})}
+    SILENT=1 $TC qdisc del dev ${IFACE} ingress
+    SILENT=1 $TC qdisc del dev ${IFACE} root
+    sqm_cleanup 1
     exit "$ret"
 fi
 write_state_file "${STATE_FILE}" || exit 1
