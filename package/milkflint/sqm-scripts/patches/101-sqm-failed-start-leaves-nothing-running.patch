From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Subject: [PATCH] sqm: a start that fails leaves nothing running

The scripts' ingress() went on after a failed qdisc add: the ifb was
brought up and the redirect added, so downloads passed through an ifb
with no shaper, and ingress() returned the redirect's status. An unknown
word in iqdisc_opts does that, and so does autorate-ingress with cake_mq,
which the kernel refuses. Each script's egress() and ingress() now return
failure when a qdisc add (or bringing the ifb up) fails, before the
redirect.

start-sqm writes no state file for a failed start, so no stop would take
down what it did set up (an upload CAKE with the old settings, the ingress
qdisc, the ifb). It takes all of it down itself, then fails.

diff --git a/src/layer_cake.qos b/src/layer_cake.qos
index 112043b..baf4701 100644
--- a/src/layer_cake.qos
+++ b/src/layer_cake.qos
@@ -33,7 +33,7 @@ ingress() {
     qdisc=$(select_cake $DEV)
 
     SILENT=1 $TC qdisc del dev $IFACE handle ffff: ingress
-    $TC qdisc add dev $IFACE handle ffff: ingress
+    $TC qdisc add dev $IFACE handle ffff: ingress || return 1
 
     SILENT=1 $TC qdisc del dev $DEV root
 
@@ -41,9 +41,9 @@ ingress() {
     [ "$ZERO_DSCP_INGRESS" -eq "1" ] && INGRESS_CAKE_OPTS="$INGRESS_CAKE_OPTS wash"
 
     $TC qdisc add dev $DEV root $( get_stab_string ) $qdisc \
-        bandwidth ${DOWNLINK}kbit $( get_cake_lla_string ) ${INGRESS_CAKE_OPTS} ${IQDISC_OPTS}
+        bandwidth ${DOWNLINK}kbit $( get_cake_lla_string ) ${INGRESS_CAKE_OPTS} ${IQDISC_OPTS} || return 1
 
-    $IP link set dev $DEV up
+    $IP link set dev $DEV up || return 1
 
     # redirect all IP packets arriving in $IFACE to ifb0
 
