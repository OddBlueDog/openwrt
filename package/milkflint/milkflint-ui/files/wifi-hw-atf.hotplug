# MilkFlint: hardware airtime fairness off (milkflint.wifi.hw_atf, see
# /usr/libexec/milkflint/wifi-hw-atf), on every radio as it appears: at
# boot, or when the driver loads again. Installed as
# /etc/hotplug.d/ieee80211/31-milkflint-hw-atf; hotplug-call sources it, so
# it returns rather than exits.

[ "$ACTION" = add ] || return 0

(
	phy=${DEVICENAME:-${DEVPATH##*/}}
	f=/sys/kernel/debug/ieee80211/$phy/mt76/vow_atf
	# the driver adds its debugfs files after the radio is registered; the
	# stock driver has no such file, and then there's nothing to do
	i=0
	while [ ! -w "$f" ] && [ $i -lt 20 ]; do
		sleep 1
		i=$((i + 1))
	done
	/usr/libexec/milkflint/wifi-hw-atf "$phy"
) > /dev/null 2>&1 &
