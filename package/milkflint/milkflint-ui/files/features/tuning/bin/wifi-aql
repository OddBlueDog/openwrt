#!/bin/sh
# The Wi-Fi driver queue's limits for best-effort traffic (mac80211's AQL,
# access category 2), from milkflint.wifi.aql_be: "<low> <high>" in us,
# "off" for mac80211's own 5000 12000, unset for MilkFlint's 2500 5000.
# Writes them to the radios named,
# or to every radio there is. mac80211 takes them at once, for the devices
# already connected too, so Wi-Fi isn't restarted. The ieee80211 hotplug
# (30-milkflint-aql) runs this for each radio as it appears, and
# milkflint-tuning when the setting changes.
#
#   wifi-aql [phy...]

DEFAULT="2500 5000"

limits=$(uci -q get milkflint.wifi.aql_be)
case "$limits" in
'') limits=$DEFAULT ;;
off) limits="5000 12000" ;;
esac
if ! echo "$limits" | grep -qxE '[0-9]{1,6} [0-9]{1,6}'; then
	logger -t milkflint-tuning "milkflint.wifi.aql_be isn't \"<low> <high>\" or off: using $DEFAULT"
	limits=$DEFAULT
fi

[ $# -gt 0 ] || set -- $(ls /sys/kernel/debug/ieee80211 2> /dev/null)
for phy; do
	f=/sys/kernel/debug/ieee80211/$phy/aql_txq_limit
	[ -w "$f" ] && echo "2 $limits" > "$f"
done
exit 0
