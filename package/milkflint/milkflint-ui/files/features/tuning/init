#!/bin/sh /etc/rc.common
# MilkFlint performance tuning (ui feature "tuning"): puts the Performance
# Tuning page's settings into effect on the running router, without taking
# Wi-Fi or the network down.
# - milkflint.wifi.aql_be: the Wi-Fi driver queue's best-effort limits,
#   which /usr/libexec/milkflint/wifi-aql writes to every radio (the
#   ieee80211 hotplug does the same for each radio as it appears);
# - milkflint.steering.layout: MilkFlint's or OpenWrt's packet steering
#   (/usr/libexec/platform/packet-steering.sh), and milkflint.steering.rss:
#   0 spreads with RPS instead of the Ethernet's RSS rings. Whether steering
#   is on at all is network.globals.packet_steering, whose changes reload
#   packet_steering by themselves;
# - milkflint.gro.*: how the internet port groups what it receives
#   (/usr/libexec/milkflint/gro). Its automatic choice follows Smart Queue's
#   download options and the firewall's flow offloading, so this also
#   reloads when sqm or firewall change.
# Every page keeps its settings in /etc/config/milkflint, so a reload only
# redoes what changed since it last ran: saving another page leaves the
# radios, the CPUs and the port alone.

START=99
USE_PROCD=1

RUN=/var/run/milkflint-tuning

# <name> <value> <command...>: the command puts the setting into effect; it
# runs when the value changed since the last time, or always on start
put() {
	local name=$1 value=$2
	shift 2
	[ -z "$FORCE" ] && [ -f "$RUN/$name" ] && [ "$(cat "$RUN/$name")" = "$value" ] && return 0
	"$@"
	echo "$value" > "$RUN/$name"
}

# <service>: reload it, unless it's been disabled
reload_if_enabled() {
	! /etc/init.d/$1 enabled || /etc/init.d/$1 reload
}

apply() {
	mkdir -p "$RUN"
	put aql "$(uci -q get milkflint.wifi.aql_be)" /usr/libexec/milkflint/wifi-aql
	put steering "$(uci -q get milkflint.steering.layout) $(uci -q get milkflint.steering.rss)" reload_if_enabled packet_steering
	# what the GRO settings resolve to: sqm and firewall changes count too
	put gro "$(/usr/libexec/milkflint/gro show)" /usr/libexec/milkflint/gro
}

# at boot the hotplug and packet_steering have just done the same; after an
# install or update of this package, this brings the running router in line
# with its settings
start_service() {
	FORCE=1
	apply
}

reload_service() {
	apply
}

service_triggers() {
	procd_add_reload_trigger "milkflint" "sqm" "firewall"
}
