#!/bin/sh /etc/rc.common
# MilkFlint performance tuning (ui feature "tuning"): puts the Performance
# Tuning page's settings into effect on the running router, without taking
# Wi-Fi or the network down.
# - milkflint.wifi.aql_threshold: the radio's total that holds devices to
#   their low limit, in µs (the same script as aql_be);
# - milkflint.wifi.aql_be: the Wi-Fi driver queue's best-effort limits,
#   which /usr/libexec/milkflint/wifi-aql writes to every radio (the
#   ieee80211 hotplug does the same for each radio as it appears);
# - milkflint.steering.layout: MilkFlint's or OpenWrt's packet steering
#   (/usr/libexec/platform/packet-steering.sh), and milkflint.steering.rss:
#   0 spreads with RPS instead of the Ethernet's RSS rings. Whether steering
#   is on at all is network.globals.packet_steering, whose changes reload
#   packet_steering by themselves;
#   milkflint.steering.wifi_all "0" keeps the Wi-Fi driver's threads on the
#   RSS rings' CPUs, and milkflint.steering.rings_rt "0" runs the rings'
#   receive threads at normal priority (packet-steering.sh too);
# - milkflint.steering.rx_delay: the longest the Ethernet's receive
#   interrupt waits, in µs (/usr/libexec/milkflint/rx-delay);
# - milkflint.cake.ecn_drop: after how many ignored marks Smart Queue drops
#   from an ECN download that ignores them, "0" never (it always marks)
#   (/usr/libexec/milkflint/cake-ecn; the iface hotplug 12-milkflint-cake-ecn
#   runs it after sqm too);
# - milkflint.cake.l4s: where L4S traffic starts to be marked by how long each
#   packet has waited, in percent of Smart Queue's target, "0" not at all (the
#   same script);
# - milkflint.cake.dscp_restore: downloads get back the DSCP their connection
#   sends with (/usr/libexec/milkflint/cake-dscp; the same iface hotplug too);
# - milkflint.wifi.vo_aggr: whether the Wi-Fi driver aggregates the voice queue,
#   on by default (/usr/libexec/milkflint/wifi-vo-aggr;
#   the ieee80211 hotplug runs it for each radio too);
# - milkflint.wifi.spr_<band>: what each radio's driver does about spatial
#   reuse (/usr/libexec/milkflint/wifi-spr; the ieee80211 hotplug runs it for
#   each radio too);
# - milkflint.wifi.retries: how often the Wi-Fi driver sends a data frame
#   before it gives up (/usr/libexec/milkflint/wifi-retries; the ieee80211
#   hotplug runs it for each radio too);
# - milkflint.gro.*: how the internet port groups what it receives
#   (/usr/libexec/milkflint/gro). Its automatic choice follows Smart Queue's
#   download options and the firewall's flow offloading, so this also
#   reloads when sqm or firewall change.
# Every page keeps its settings in /etc/config/milkflint, so a reload only
# redoes what changed since it last ran: saving another page leaves the
# radios, the CPUs and the port alone.

START=99
USE_PROCD=1

RUN=/var/run/milkflint-tuning

# <name> <value> <command...>: the command puts the setting into effect; it
# runs when the value changed since the last time, or always on start
put() {
	local name=$1 value=$2
	shift 2
	[ -z "$FORCE" ] && [ -f "$RUN/$name" ] && [ "$(cat "$RUN/$name")" = "$value" ] && return 0
	"$@"
	echo "$value" > "$RUN/$name"
}

# <service>: reload it, unless it's been disabled
reload_if_enabled() {
	! /etc/init.d/$1 enabled || /etc/init.d/$1 reload
}

apply() {
	mkdir -p "$RUN"
	put aql "$(uci -q get milkflint.wifi.aql_be) $(uci -q get milkflint.wifi.aql_threshold)" /usr/libexec/milkflint/wifi-aql
	put steering "$(uci -q get milkflint.steering.layout) $(uci -q get milkflint.steering.rss) $(uci -q get milkflint.steering.wifi_all) $(uci -q get milkflint.steering.rings_rt)" reload_if_enabled packet_steering
	put rx_delay "$(uci -q get milkflint.steering.rx_delay)" /usr/libexec/milkflint/rx-delay
	put cake_ecn "$(uci -q get milkflint.cake.ecn_drop) $(uci -q get milkflint.cake.l4s)" /usr/libexec/milkflint/cake-ecn
	put cake_dscp "$(uci -q get milkflint.cake.dscp_restore)" /usr/libexec/milkflint/cake-dscp
	put vo_aggr "$(uci -q get milkflint.wifi.vo_aggr)" /usr/libexec/milkflint/wifi-vo-aggr
	put spr "$(uci -q get milkflint.wifi.spr_2g) $(uci -q get milkflint.wifi.spr_5g) $(uci -q get milkflint.wifi.spr_6g)" /usr/libexec/milkflint/wifi-spr
	put retries "$(uci -q get milkflint.wifi.retries)" /usr/libexec/milkflint/wifi-retries
	# what the GRO settings resolve to: sqm and firewall changes count too
	put gro "$(/usr/libexec/milkflint/gro show)" /usr/libexec/milkflint/gro
}

# at boot the hotplug and packet_steering have just done the same; after an
# install or update of this package, this brings the running router in line
# with its settings
start_service() {
	FORCE=1
	apply
}

reload_service() {
	apply
}

service_triggers() {
	procd_add_reload_trigger "milkflint" "sqm" "firewall"
}
