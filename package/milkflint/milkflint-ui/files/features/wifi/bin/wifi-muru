#!/bin/sh
# Multi-user (OFDMA / MU-MIMO) flags for each radio's Wi-Fi driver, from
# milkflint.wifi.muru_<band>_<flag> (band 2g, 5g, 6g):
#   ofdma_dl  0 off, unset (or anything else) 1 on
#   mimo_dl   0 off, unset (or anything else) 1 on
#   ofdma_ul  1 on,  unset (or anything else) 0 off
#   mimo_ul   1 on,  unset (or anything else) 0 off
# The driver applies them live for the band and every active BSS, without
# restarting Wi-Fi.
#
# Writes to the radios named, or to every radio there is; a driver without
# the file (not mt7915's) is left alone. milkflint-tuning runs this when a
# setting changes, the ieee80211 hotplug for each radio that appears.
#
#   wifi-muru [phy...]

[ $# -gt 0 ] || set -- $(ls /sys/kernel/debug/ieee80211 2> /dev/null)
for phy; do
	f=/sys/kernel/debug/ieee80211/$phy/mt76/muru
	[ -w "$f" ] || continue
	case "$(iw phy "$phy" info 2> /dev/null)" in
	*"Band 4:"*) band=6g ;;
	*"Band 2:"*) band=5g ;;
	*"Band 1:"*) band=2g ;;
	*) continue ;;
	esac
	odl=1
	[ "$(uci -q get "milkflint.wifi.muru_${band}_ofdma_dl")" = 0 ] && odl=0
	mdl=1
	[ "$(uci -q get "milkflint.wifi.muru_${band}_mimo_dl")" = 0 ] && mdl=0
	oul=0
	[ "$(uci -q get "milkflint.wifi.muru_${band}_ofdma_ul")" = 1 ] && oul=1
	mul=0
	[ "$(uci -q get "milkflint.wifi.muru_${band}_mimo_ul")" = 1 ] && mul=1
	echo "ofdma_dl=$odl ofdma_ul=$oul mimo_dl=$mdl mimo_ul=$mul" 2> /dev/null > "$f" \
		|| logger -t milkflint-wifi "$phy: the Wi-Fi driver didn't take multi-user flags"
done
exit 0
