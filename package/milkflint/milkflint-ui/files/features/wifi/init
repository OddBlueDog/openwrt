#!/bin/sh /etc/rc.common
# MilkFlint Wi-Fi (ui feature "wifi"): /usr/libexec/milkflint/radar-log keeps
# hostapd's radar events on the router's storage for the Radios & SSIDs page
# and the Logs page, unless the Logs page turns it off
# (milkflint.logs.radar=0).

# right after logd (log: 12), so a boot's first run still finds the boot's
# lines in its buffer, and before Wi-Fi starts
START=13
USE_PROCD=1

start_service() {
	[ "$(uci -q get milkflint.logs.radar)" = 0 ] && return 0
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/libexec/milkflint/radar-log
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "milkflint"
}
