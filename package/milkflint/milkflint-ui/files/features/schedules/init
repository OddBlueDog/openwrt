#!/bin/sh /etc/rc.common
# MilkFlint scheduled tasks (ui feature "schedules"): writes the enabled
# `schedule` sections of /etc/config/milkflint into a marked block of root's
# crontab, and runs again whenever that config changes.

START=96
USE_PROCD=1

CRONTAB=/etc/crontabs/root
BEGIN='# milkflint-schedules begin (managed by the web interface)'
END='# milkflint-schedules end'

add_task() {
	local cfg="$1" enabled action time days hour minute
	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get action "$cfg" action
	config_get time "$cfg" time
	config_get days "$cfg" days
	case "$action" in reboot|wifi_off|wifi_on) ;; *) return 0 ;; esac
	hour=${time%%:*}
	minute=${time##*:}
	case "$hour:$minute" in [0-9][0-9]:[0-9][0-9]) ;; *) return 0 ;; esac
	hour=${hour#0}
	minute=${minute#0}
	days=$(echo "$days" | tr ' ' ',')
	case "$days" in ''|*[!0-6,]*) days='*' ;; esac
	echo "$minute $hour * * $days /usr/libexec/milkflint/schedule-run $action" >> "$TASKS"
}

start_service() {
	TASKS=$(mktemp)
	config_load milkflint
	config_foreach add_task schedule
	touch "$CRONTAB"
	awk -v b="$BEGIN" -v e="$END" '$0 == b { skip = 1; next } $0 == e { skip = 0; next } !skip' "$CRONTAB" > "$CRONTAB.new"
	if [ -s "$TASKS" ]; then
		{ echo "$BEGIN"; cat "$TASKS"; echo "$END"; } >> "$CRONTAB.new"
	fi
	rm -f "$TASKS"
	if cmp -s "$CRONTAB" "$CRONTAB.new"; then
		rm -f "$CRONTAB.new"
	else
		mv "$CRONTAB.new" "$CRONTAB"
		/etc/init.d/cron enable
		/etc/init.d/cron restart
	fi
}

service_triggers() {
	procd_add_reload_trigger "milkflint"
}
