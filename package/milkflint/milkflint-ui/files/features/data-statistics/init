#!/bin/sh /etc/rc.common
# MilkFlint data statistics (ui feature "data-statistics"): nlbwmon counts
# each device's traffic while the Data Statistics page has it on
# (milkflint.datastats.enabled, on unless '0'), and is stopped and disabled
# otherwise. Stopping it writes its database, so the counts so far are kept
# for when it's turned back on.
#
# Opt-in 24-hour history (milkflint.datastats.history '1', and Data usage
# on): the instance "history" samples every device's traffic every 5 minutes
# into /root/milkflint-usage. Anywhere else the directory is removed at every
# start and reload, so a switch turned off with uci or LuCI by hand deletes the
# figures too.

START=95
USE_PROCD=1

start_history() {
	if [ "$(uci -q get milkflint.datastats.enabled)" != "0" ] &&
		[ "$(uci -q get milkflint.datastats.history)" = "1" ] && [ -x /usr/sbin/nlbw ]; then
		procd_open_instance history
		procd_set_param command /usr/bin/ucode /usr/libexec/milkflint/usage-history
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	else
		rm -rf /root/milkflint-usage /tmp/milkflint/usage-history.json
	fi
}

start_service() {
	start_history
	[ -x /etc/init.d/nlbwmon ] || return 0
	if [ "$(uci -q get milkflint.datastats.enabled)" != "0" ]; then
		/etc/init.d/nlbwmon enabled || /etc/init.d/nlbwmon enable
		/etc/init.d/nlbwmon running || /etc/init.d/nlbwmon start
	elif /etc/init.d/nlbwmon enabled || /etc/init.d/nlbwmon running; then
		/etc/init.d/nlbwmon stop
		/etc/init.d/nlbwmon disable
	fi
}

service_triggers() {
	procd_add_reload_trigger "milkflint"
}
