#!/bin/sh
# MilkFlint's own builds of OpenWrt packages stay installed. OpenWrt's
# package feeds keep newer builds of packages MilkFlint changes (its fixes to
# hostapd, the firewall, dnsmasq, the Wi-Fi scripts, its own Smart Queue
# scripts...) without those changes, and `apk upgrade`, or an upgrade on
# LuCI's Software page, would install them over MilkFlint's. So apk's world
# asks for the version installed of each, as OpenWrt's image build does for
# base-files, libc and the kernel (whose pin keeps every other kernel's
# modules out too). MilkFlint's own upgrades bring new builds: sysupgrade
# starts from the new image's world, and this runs again.
#
# Only a bare name is pinned: one with a repository tag (AdGuard Home's
# adguardhome@milkflint) or a version asked for is left as it is. One that's
# installed as another package's dependency, not in the world, is added.
# Safe to run again.
world=/etc/apk/world
db=/lib/apk/db/installed
[ -s "$world" ] && [ -s "$db" ] || exit 0

# The packages: by origin, the OpenWrt tree's package folders MilkFlint's
# patches change (kernel modules aside); by name, the packages-feed packages
# MilkFlint builds itself (AdGuard Home aside: its updates come from
# MilkFlint's own feed), and banIP, which its page drives in detail.
# BEGIN generated
origins='
feeds/base/base-files
feeds/base/network/config/firewall4
feeds/base/network/config/wifi-scripts
feeds/base/network/services/dnsmasq
feeds/base/network/services/hostapd
feeds/base/network/utils/wireguard-tools
feeds/base/system/ca-certificates
'
names='
banip
dnsproxy
gawk
iperf3
iperf3-ssl
libiperf3
miniupnpd-iptables
miniupnpd-nftables
nlbwmon
sqm-scripts
'
# END generated

tmp="$world.milkflint-pins"
ORIGINS="$origins" NAMES="$names" awk '
BEGIN {
	n = split(ENVIRON["ORIGINS"], a)
	for (i = 1; i <= n; i++) origin[a[i]] = 1
	n = split(ENVIRON["NAMES"], a)
	for (i = 1; i <= n; i++) wanted[a[i]] = 1
}
# one package of the database read: pinned if it is one of them
function package_done() {
	if (p != "" && v != "" && ((o in origin) || (p in wanted)))
		pin[p] = v
	p = v = o = ""
}
FILENAME == ARGV[1] {
	if ($0 == "") package_done()
	else if (substr($0, 1, 2) == "P:") p = substr($0, 3)
	else if (substr($0, 1, 2) == "V:") v = substr($0, 3)
	else if (substr($0, 1, 2) == "o:") o = substr($0, 3)
	next
}
FNR == 1 { package_done() }
# the world: its entries name[@tag][<op>version], or !name
{
	n = $0
	sub(/^!/, "", n)
	sub(/[@=<>~].*$/, "", n)
	seen[n] = 1
	if ($0 == n && (n in pin))
		print n "=" pin[n]
	else
		print
}
END {
	for (n in pin)
		if (!(n in seen))
			print n "=" pin[n]
}' "$db" "$world" > "$tmp" && mv "$tmp" "$world" || { rm -f "$tmp"; exit 1; }
exit 0
