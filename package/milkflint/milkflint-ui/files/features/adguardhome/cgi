#!/usr/bin/ucode
// AdGuard Home session handoff (ui feature "adguardhome";
// /cgi-bin/milkflint-adguardhome): trades a one-time, 30-second token from
// `ubus call milkflint.adguardhome open` (which requires an admin session and
// router login on) for AdGuard Home's HttpOnly session cookie, so opening
// AdGuard Home from MilkFlint signs straight in without exposing its cookie to
// JavaScript or sharing the router's root password over HTTP. Also clears that
// session on MilkFlint sign-out ({"logout":true}).
//   POST, Content-Type: application/json
//   {"token":"<32 chars>"}  -> Set-Cookie: agh_session=...; Path=/; HttpOnly; SameSite=Lax
//   {"logout":true}         -> revokes cookie in AdGuard Home and clears it
'use strict';

import { stdin, readfile, stat, unlink } from 'fs';
import * as agh from '/usr/libexec/milkflint/adguardhome.uc';

const MAX_BODY = 256;

function reply(status, body, cookie) {
	print(`Status: ${status}\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n`);
	if (cookie)
		print(`Set-Cookie: ${cookie}\r\n`);
	print('\r\n');
	print(sprintf('%J\n', body));
	exit(0);
}

const env = getenv();
if (env.REQUEST_METHOD != 'POST')
	reply('405 Method Not Allowed', { error: 'POST only' });
// another site's page can't send application/json here without a CORS
// preflight, which this never answers
if (!match(env.CONTENT_TYPE ?? '', /^application\/json[ \t]*(;|$)/))
	reply('415 Unsupported Media Type', { error: 'application/json only' });
const size = +(env.CONTENT_LENGTH ?? '');
if (!(size > 0 && size <= MAX_BODY))
	reply('413 Payload Too Large', { error: 'invalid length' });

let body = null;
try {
	body = json(stdin.read(size));
}
catch (e) {
	// not JSON
}
if (type(body) != 'object')
	reply('400 Bad Request', { error: 'invalid body' });

if (body.logout == true) {
	const m = match(env.HTTP_COOKIE ?? '', /(^|;[ \t]*)agh_session=([0-9a-fA-F]{32,128})(;|$)/);
	if (m)
		agh.logout_session(`agh_session=${m[2]}`, 2);
	reply('200 OK', { ok: true }, 'agh_session=; Path=/; Max-Age=0; HttpOnly; SameSite=Lax');
}

if (type(body.token) != 'string' || !match(body.token, /^[A-Za-z0-9]{32}$/))
	reply('403 Forbidden', { error: 'invalid token' });

const path = `${agh.OPEN_DIR}/${body.token}`;
const st = stat(path);
if (!st || st.type != 'file')
	reply('403 Forbidden', { error: 'invalid token' });
const session = trim(readfile(path) ?? '');
unlink(path);

const now = time();
if (now - st.mtime > agh.OPEN_TTL_S || st.mtime > now + 60 || !agh.uses_router_login())
	reply('403 Forbidden', { error: 'expired' });
if (!match(session, /^agh_session=[0-9a-fA-F]{32,128}$/))
	reply('403 Forbidden', { error: 'invalid session' });

reply('200 OK', { ok: true }, `${session}; Path=/; HttpOnly; SameSite=Lax`);
