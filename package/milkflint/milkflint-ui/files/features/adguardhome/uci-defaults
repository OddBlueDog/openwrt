#!/bin/sh
# AdGuard Home (ui feature "adguardhome"): in the image, off until it's
# turned on on its page. Its updates come from MilkFlint's own package feed,
# through the package updater (ui feature "pkg-update", whose first-boot
# defaults write the feed's repository line). apk's world pins
# adguardhome=<version> (via apk-pins, without @milkflint) so OpenWrt's feed
# can't replace it and offline apk commands (such as `apk del` after a reboot
# before `apk update`) never fail on a missing repository tag. Safe to run
# again (it is, after every upgrade).
[ -x /usr/bin/AdGuardHome ] || exit 0

# Earlier releases put adguardhome@milkflint in /etc/apk/world, which makes
# apk refuse offline commits when the feed index isn't cached. Replace any
# leftover tag with a plain version pin (91-milkflint-apk-pins pins bare
# adguardhome entries too).
ver=$(awk '/^P:adguardhome$/ { f = 1; next } f && /^V:/ { print substr($0, 3); exit } /^$/ { f = 0 }' /lib/apk/db/installed 2> /dev/null)
if grep -q '^adguardhome@milkflint' /etc/apk/world 2> /dev/null; then
	if [ -n "$ver" ]; then
		sed -i "s/^adguardhome@milkflint.*$/adguardhome=$ver/" /etc/apk/world
	else
		sed -i 's/^adguardhome@milkflint.*$/adguardhome/' /etc/apk/world
	fi
fi

# Releases before MilkFlint's own numbering (-r1001 and up) pinned
# adguardhome=<version>-r<small number>; OpenWrt's build of the same version
# has such a number, so the pin follows the installed (MilkFlint) version.
if [ -n "$ver" ]; then
	pin=$(grep '^adguardhome=' /etc/apk/world 2> /dev/null | head -n 1)
	rel=${pin##*-r}
	case "$rel" in
	'' | *[!0-9]*) ;;
	*)
		if [ "$rel" -lt 1000 ] && [ "$pin" != "adguardhome=$ver" ]; then
			sed -i "s/^adguardhome=.*$/adguardhome=$ver/" /etc/apk/world
		fi
		;;
	esac
fi

# what devices' lookups do while it's down, once it has started (the
# page's "If it stops answering", milkflint.adguardhome.fallback): a new
# install lets them fail; a router that had it on before the setting
# existed keeps having the router answer them, unfiltered, as it did
if [ -z "$(uci -q get milkflint.adguardhome.fallback)" ]; then
	touch /etc/config/milkflint
	uci -q get milkflint.adguardhome > /dev/null || uci set milkflint.adguardhome=adguardhome
	if [ "$(uci -q get adguardhome.config.enabled)" = 1 ]; then
		uci set milkflint.adguardhome.fallback=1
	else
		uci set milkflint.adguardhome.fallback=0
	fi
	uci commit milkflint
fi

# how AdGuard Home's web interface signs in (the page's "Use router login",
# milkflint.adguardhome.router_login): a new install uses MilkFlint's own
# login; a router that already had AdGuard Home set up keeps its own user
# name and password
if [ -z "$(uci -q get milkflint.adguardhome.router_login)" ]; then
	touch /etc/config/milkflint
	uci -q get milkflint.adguardhome > /dev/null || uci set milkflint.adguardhome=adguardhome
	if [ -s /etc/adguardhome/AdGuardHome.yaml ]; then
		uci set milkflint.adguardhome.router_login=0
	else
		uci set milkflint.adguardhome.router_login=1
	fi
	uci commit milkflint
fi

# the service stays off until the page turns it on (its own init checks
# adguardhome.config.enabled), and the monitor runs once it's on
/etc/init.d/milkflint-adguardhome enable
exit 0
