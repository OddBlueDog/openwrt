#!/usr/bin/ucode
// AdGuard Home's updates (ui feature "adguardhome"), from MilkFlint's own
// package feed only: its repository is tagged @milkflint
// (/etc/apk/repositories.d/milkflint.list) and apk's world has
// adguardhome@milkflint, so OpenWrt's feed, which has a package of the same
// name built another way, never replaces it. AdGuard Home's own updater is
// off (--no-check-update). The feed keeps earlier versions: going back to one
// is installing it (adguardhome@milkflint=<version>, which pins it until the
// next update from the page).
//
//   adguardhome-update check              the versions the feed has
//   adguardhome-update install [VERSION]  that one ('' or none: the newest)
//
// What it's doing and how it went: /var/run/milkflint/adguardhome-update.json
//   { busy, action, checked, installed, latest, versions: [newest first],
//     pinned, ok, error, log, finished }
'use strict';

import { readfile, mkdir, unlink } from 'fs';
import * as agh from './adguardhome.uc';

const STATUS = '/var/run/milkflint/adguardhome-update.json';
const PAUSE = '/var/run/milkflint/adguardhome.pause';
const LIST = '/etc/apk/repositories.d/milkflint.list';

let status = {};
try {
	status = json(readfile(STATUS) ?? '{}') ?? {};
}
catch (e) {
	status = {};
}

function save() {
	mkdir('/var/run/milkflint', 0o755);
	agh.write_atomic(STATUS, sprintf('%J', status), 0o644);
}

function feed_url() {
	for (let line in split(readfile(LIST) ?? '', '\n')) {
		const m = match(trim(line), /^@milkflint[ \t]+(\S+)$/);
		if (m)
			return m[1];
	}
	return null;
}

// "0.107.80-r1" before "0.107.79-r3": apk's own order would do, but this
// needs no apk call (numbers compared as numbers, part by part)
function vcmp(a, b) {
	const pa = split(replace(a, /-r/, '.'), '.'), pb = split(replace(b, /-r/, '.'), '.');
	for (let i = 0; i < max(length(pa), length(pb)); i++) {
		const x = +(pa[i] ?? 0), y = +(pb[i] ?? 0);
		if (x != y)
			return (x < y) ? -1 : 1;
	}
	return 0;
}

function pinned() {
	const m = match(readfile('/etc/apk/world') ?? '', /(^|\n)adguardhome@milkflint=([^\n]+)/);
	return m ? m[2] : null;
}

// The feed's versions of adguardhome, newest first (null if it can't be
// read), from its index itself: apk's own search would count the installed
// package and OpenWrt's feed too. (Installing checks the index's signature.)
function versions() {
	const url = feed_url();
	if (!url)
		return null;
	const idx = '/tmp/milkflint-feed.adb';
	unlink(idx);
	if (system(`uclient-fetch -q -T 20 -O ${idx} ${agh.sh_quote(url)} 2>/dev/null`) != 0)
		return null;
	const dump = agh.cmd(`apk adbdump ${idx}`);
	unlink(idx);
	if (dump == null || !match(dump, /packages:/))
		return null;
	const vs = [];
	let name = null;
	for (let line in split(dump, '\n')) {
		const n = match(line, /^  - name: (.+)$/);
		if (n) {
			name = trim(n[1]);
			continue;
		}
		const v = match(line, /^    version: ([0-9][0-9a-z.]*-r[0-9]+)$/);
		if (v && name == 'adguardhome' && !(v[1] in vs))
			push(vs, v[1]);
	}
	return sort(vs, (a, b) => vcmp(b, a));
}

const action = ARGV[0];
const want = ARGV[1] ?? '';
if (status.busy && time() - (status.started ?? 0) < 600)
	exit(1);
status.busy = true;
status.action = action;
status.started = time();
status.error = null;
status.ok = null;
save();

const vs = versions();
status.checked = time();
status.installed = agh.package_version();
status.pinned = pinned();
if (vs == null) {
	status.error = 'feed';
}
else {
	status.versions = vs;
	status.latest = vs[0] ?? null;
}

if (action == 'install' && status.error == null) {
	if (want != '' && !(want in vs)) {
		status.error = 'version';
	}
	else {
		// the redirect off meanwhile: dnsmasq answers while it restarts
		agh.write_atomic(PAUSE, `${time() + 300}`, 0o644);
		system('nft delete table inet milkflint_adguardhome 2>/dev/null');
		const spec = (want == '') ? 'adguardhome@milkflint' : `adguardhome@milkflint=${want}`;
		// apk's indexes first (a repository it can't reach doesn't stop it)
		agh.run('apk update');
		const r = agh.run(`apk add ${agh.sh_quote(spec)}`);
		status.log = substr(trim(r.out), -2000);
		status.installed = agh.package_version();
		status.pinned = pinned();
		status.ok = (want == '') ? (status.installed == status.latest) : (status.installed == want);
		if (!status.ok)
			status.error = 'install';
		if (agh.cmd('uci -q get adguardhome.config.enabled') == '1')
			system('/etc/init.d/adguardhome restart');
		system(`rm -f ${PAUSE}`);
	}
}

status.busy = false;
status.finished = time();
save();
