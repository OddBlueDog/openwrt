{
	"_": "banIP 1.9.1's options (banip.global) that the banIP page sets, as banIP and luci-app-banip take them: the type, the default banIP uses when it's unset, the range or the choices, and what a change needs (restart: banIP's table is rebuilt; none: read when used). milkflint.banip's rpcd checks every value against this; ui/tests/banip-model.test.ts checks the page's own copy (ui/src/features/banip/options.ts) agrees.",
	"options": {
		"ban_enabled": { "type": "bool", "default": "0", "apply": "own" },
		"ban_debug": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_autodetect": { "type": "bool", "default": "1", "apply": "restart" },
		"ban_protov4": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_protov6": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_dev": { "type": "list", "item": "device", "apply": "restart" },
		"ban_ifv4": { "type": "list", "item": "interface", "apply": "restart" },
		"ban_ifv6": { "type": "list", "item": "interface", "apply": "restart" },
		"ban_fetchcmd": { "type": "enum", "values": [ "uclient-fetch", "wget", "curl" ], "apply": "restart" },
		"ban_fetchparm": { "type": "string", "pattern": "^[A-Za-z0-9 =:,./_-]{1,200}$", "apply": "restart" },
		"ban_trigger": { "type": "list", "item": "interface", "apply": "restart" },
		"ban_triggerdelay": { "type": "int", "default": "20", "min": 1, "max": 300, "apply": "restart" },
		"ban_fetchretry": { "type": "int", "default": "5", "min": 1, "max": 99, "apply": "restart" },
		"ban_fetchinsecure": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_authkey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$", "apply": "restart" },
		"ban_nftcount": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_nicelimit": { "type": "int", "default": "0", "min": -20, "max": 19, "apply": "restart" },
		"ban_filelimit": { "type": "int", "default": "1024", "min": 64, "max": 65536, "apply": "restart" },
		"ban_cores": { "type": "int", "min": 1, "max": 64, "apply": "restart" },
		"ban_splitsize": { "type": "int", "default": "0", "min": 0, "max": 10000000, "apply": "restart" },
		"ban_basedir": { "type": "path", "default": "/tmp", "apply": "restart" },
		"ban_backupdir": { "type": "path", "default": "/tmp/banIP-backup", "apply": "restart" },
		"ban_reportdir": { "type": "path", "default": "/tmp/banIP-report", "apply": "restart" },
		"ban_errordir": { "type": "path", "default": "/tmp/banIP-error", "apply": "restart" },
		"ban_deduplicate": { "type": "bool", "default": "1", "apply": "restart" },
		"ban_nftpriority": { "type": "int", "default": "-100", "min": -300, "max": 300, "apply": "restart" },
		"ban_allowflag": { "type": "string", "pattern": "^(tcp|udp|[0-9]{1,5}(-[0-9]{1,5})?)( (tcp|udp|[0-9]{1,5}(-[0-9]{1,5})?))*$", "check": "ports", "apply": "restart" },
		"ban_vlanallow": { "type": "list", "item": "device", "apply": "restart" },
		"ban_vlanblock": { "type": "list", "item": "device", "apply": "restart" },
		"ban_bcp38": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_icmplimit": { "type": "int", "default": "25", "min": 0, "max": 1000000, "apply": "restart" },
		"ban_synlimit": { "type": "int", "default": "10", "min": 0, "max": 1000000, "apply": "restart" },
		"ban_udplimit": { "type": "int", "default": "100", "min": 0, "max": 1000000, "apply": "restart" },
		"ban_nftpolicy": { "type": "enum", "default": "memory", "values": [ "memory", "performance" ], "apply": "restart" },
		"ban_nftretry": { "type": "int", "default": "3", "min": 1, "max": 10, "apply": "restart" },
		"ban_blockpolicy": { "type": "enum", "default": "drop", "values": [ "drop", "reject" ], "apply": "restart" },
		"ban_feedin": { "type": "list", "item": "feed", "apply": "restart" },
		"ban_feedout": { "type": "list", "item": "feed", "apply": "restart" },
		"ban_feedinout": { "type": "list", "item": "feed", "apply": "restart" },
		"ban_feedreset": { "type": "list", "item": "feed", "apply": "restart" },
		"ban_feedcomplete": { "type": "list", "item": "feed", "apply": "restart" },
		"ban_nftloglevel": { "type": "enum", "default": "warn", "values": [ "emerg", "alert", "crit", "err", "warn", "notice", "info", "debug" ], "apply": "restart" },
		"ban_logprerouting": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_loginbound": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_logoutbound": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_logreadfile": { "type": "path", "apply": "restart" },
		"ban_loglimit": { "type": "int", "default": "100", "min": 0, "max": 100000, "apply": "restart" },
		"ban_logcount": { "type": "int", "default": "1", "min": 1, "max": 100, "apply": "restart" },
		"ban_logratelimit": { "type": "int", "default": "10", "min": 0, "max": 10000, "apply": "restart" },
		"ban_logburstlimit": { "type": "int", "default": "5", "min": 1, "max": 10000, "apply": "restart" },
		"ban_logterm": { "type": "list", "item": "logterm", "apply": "restart" },
		"ban_remotelog": { "type": "bool", "default": "0", "apply": "none" },
		"ban_remotetoken": { "type": "string", "pattern": "^[A-Za-z0-9.:]{3,20}$", "apply": "none" },
		"ban_nftexpiry": { "type": "string", "pattern": "^([1-9][0-9]{0,6}(ms|s|m|h|d)){1,4}$", "apply": "restart" },
		"ban_autoallowlist": { "type": "bool", "default": "1", "apply": "restart" },
		"ban_autoallowuplink": { "type": "enum", "default": "subnet", "values": [ "disable", "subnet", "ip" ], "apply": "restart" },
		"ban_autoblocklist": { "type": "bool", "default": "1", "apply": "restart" },
		"ban_autoblocksubnet": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_allowlistonly": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_monitorallowed": { "type": "bool", "default": "0", "apply": "restart" },
		"ban_allowurl": { "type": "list", "item": "url", "apply": "restart", "refetch": "allowlist" },
		"ban_feed": { "type": "list", "item": "feed", "apply": "restart" },
		"ban_country": { "type": "list", "item": "country", "apply": "restart", "refetch": "country" },
		"ban_region": { "type": "list", "item": "region", "apply": "restart", "refetch": "country" },
		"ban_countrysplit": { "type": "bool", "default": "0", "apply": "restart", "refetch": "country" },
		"ban_asn": { "type": "list", "item": "asn", "apply": "restart", "refetch": "asn" },
		"ban_asnsplit": { "type": "bool", "default": "0", "apply": "restart", "refetch": "asn" },
		"ban_resolver": { "type": "string", "pattern": "^[0-9A-Fa-f:.]{2,45}$", "check": "address", "apply": "restart" },
		"ban_mailnotification": { "type": "bool", "default": "0", "apply": "none" },
		"ban_mailreceiver": { "type": "string", "pattern": "^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,190}\\.[A-Za-z]{2,24}$", "apply": "none" },
		"ban_mailsender": { "type": "string", "default": "no-reply@banIP", "pattern": "^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,190}$", "apply": "none" },
		"ban_mailtopic": { "type": "string", "default": "banIP notification", "pattern": "^[ -~]{1,100}$", "apply": "none" },
		"ban_mailprofile": { "type": "string", "default": "ban_notify", "pattern": "^[A-Za-z0-9_]{1,32}$", "apply": "none" }
	},
	"items": {
		"device": "^[A-Za-z0-9._@:-]{1,15}$",
		"interface": "^[A-Za-z0-9_]{1,15}$",
		"feed": "^[a-z0-9]{3,15}$|^allowlist$|^blocklist$",
		"country": "^[a-z]{2}$",
		"region": "^(AFRINIC|APNIC|ARIN|LACNIC|RIPE)$",
		"asn": "^[1-9][0-9]{0,9}$",
		"url": "^https?://[A-Za-z0-9-]+\\.[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._?&+=:~#%/-]*)?$",
		"logterm": "^[^\\x01-\\x1f\\x7f]{1,200}$"
	},
	"milkflint": {
		"schedule": { "type": "enum", "default": "daily", "values": [ "off", "6h", "12h", "daily", "weekly" ] },
		"time": { "type": "string", "default": "04:00", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
		"day": { "type": "int", "default": "0", "min": 0, "max": 6 },
		"preset": { "type": "enum", "default": "off", "values": [ "off", "recommended", "strict", "custom" ] }
	}
}
