#!/bin/sh /etc/rc.common
# MilkFlint VPN client DNS (ui feature "vpn"): when "Use VPN's DNS" is on
# (milkflint.vpn_client.use_vpn_dns '1'), runs a lightweight dnsmasq instance
# on port 5455 as user adguardvpn pointing at the VPN provider's DNS servers
# and loads nftables table inet milkflint_vpn_dns to redirect marked VPN
# devices' port-53 lookups to it and mark its outbound traffic into wg_out.
# Other devices and the router itself keep using the main dnsmasq on port 53.

START=95
STOP=06
USE_PROCD=1

TABLE=milkflint_vpn_dns

vpn_dns_args() {
	ucode -e '
		import * as v from "/usr/libexec/milkflint/vpn-dns.uc";
		const args = v.dnsmasq_args();
		if (args)
			print(join("\n", args), "\n");
	' 2> /dev/null
}

apply_nft() {
	ucode -e '
		import * as v from "/usr/libexec/milkflint/vpn-dns.uc";
		v.apply_nft();
	' 2> /dev/null
}

clear_nft() {
	nft delete table inet $TABLE 2> /dev/null
}

start_service() {
	local args
	if [ -x /usr/sbin/dnsmasq ] && grep -q '^adguardvpn:' /etc/passwd; then
		args=$(vpn_dns_args)
	fi
	if [ -z "$args" ]; then
		clear_nft
		return 0
	fi
	local IFS='
'
	procd_open_instance dns
	procd_set_param command /usr/sbin/dnsmasq $args
	procd_set_param user adguardvpn
	procd_set_param group adguardvpn
	procd_set_param no_new_privs 1
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	apply_nft
}

service_stopped() {
	clear_nft
	return 0
}

service_triggers() {
	procd_add_reload_trigger firewall network milkflint dhcp
}

# Never call `stop` here: `stop` deletes the service and its reload triggers
# from procd, so a later UCI change wouldn't start it again. Calling `start`
# replaces the service in place (stopping `dns` if no longer wanted and
# clearing the nftables table) while keeping its triggers registered.
reload_service() {
	start
}
