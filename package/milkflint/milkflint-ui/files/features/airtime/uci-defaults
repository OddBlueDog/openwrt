#!/bin/sh
# Airtime fairness: the service always runs (it idles with every band off);
# the policy is on for a band while milkflint.wifi.airtime_<band> is "1",
# which the package's own first-boot defaults set once, for every band, with
# the auto shares at the balanced strength.
[ -f /etc/config/milkflint ] || touch /etc/config/milkflint
/etc/init.d/milkflint-airtime enable
exit 0
