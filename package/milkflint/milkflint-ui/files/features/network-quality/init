#!/bin/sh /etc/rc.common
# MilkFlint network quality probe (ui feature "network-quality")

START=95
USE_PROCD=1

start_service() {
	[ "$(uci -q get milkflint.netquality.enabled)" = "1" ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/libexec/milkflint/netquality
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "milkflint"
}
