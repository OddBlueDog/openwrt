
# AdGuard Home's service (/etc/init.d/adguardhome). MilkFlint's AdGuard Home
# page turns it on and writes its own settings (config_file) the first time;
# everything about filtering is set in AdGuard Home's web interface.
config adguardhome 'config'
	option enabled '0'
	# its settings, readable by root and its own account only (mode 600):
	# they hold its password hashes
	option config_file '/etc/adguardhome/AdGuardHome.yaml'
	# its lists, statistics and sessions, kept over restarts but not in
	# backups or upgrades (the query log is in /tmp/adguardhome, in RAM)
	option work_dir '/srv/adguardhome'
	option user 'adguardhome'
	option group 'adguardhome'
	option verbose '0'
	# Go's soft memory limit, in MiB (GOMEMLIMIT; 0: none): the garbage
	# collector works harder near it, which keeps loading or updating very
	# large lists from taking most of the router's memory at once (usual
	# lists stay well under it)
	option memlimit '384'
	# Go's GOGC and GOMAXPROCS (0: Go's defaults)
	option gc '0'
	option maxprocs '0'
	# more files it may read (jail_mount) or write (jail_mount_rw), e.g. a
	# certificate for its own HTTPS
	# list jail_mount '/etc/ssl/adguardhome.crt'
