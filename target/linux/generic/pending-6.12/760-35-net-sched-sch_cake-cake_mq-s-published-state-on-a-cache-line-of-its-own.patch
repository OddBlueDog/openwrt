From: MilkFlint <milkflint@localhost>
Date: Thu, 19 Nov 2026 17:10:00 +0000
Subject: [PATCH] net/sched: sch_cake: cake_mq's published state on a cache line of its own

At each resync, a cake_mq sub-queue reads what the others publish: when
each last sent a packet, what it used and its sparse flows' part, its
idle time, its bulk weight and whether it wants more. last_active was
written for every packet sent, next to the counters every packet
updates, so each read by another CPU was a miss, and each next write an
invalidation.

What the others read now sits on a cache line of its own, and the
counters start on the next. last_active is written as the queue empties
(the others read it only when the queue is empty, so it then has the
exact time), at least every half sync_time while packets go, if it was
never written, and at a resync after packets went. Nothing the others
decide changes.

KUnit: the layout, and when last_active is written.

---
--- a/net/sched/sch_cake.c
+++ b/net/sched/sch_cake.c
@@ -297,21 +297,24 @@ struct cake_sched_data {
 
 	/* mq sync state */
 	u64		last_checked_active;
-	u64		last_active;
 	u64		synced_rate;
 	u32		active_queues;
-	/* what the other sub-cakes read at their resync, written at ours:
-	 * bytes/s charged to the shaper, all of it and the sparse flows'
-	 * part, averaged over CAKE_MQ_TAU; the bulk weight; whether we
-	 * used (nearly) all of our share
+	/* What the other sub-cakes read at their resync, on a cache line of
+	 * its own, so that only our writes to it cost them a miss: when we
+	 * last sent a packet (they read it only when our queue is empty; it's
+	 * written then, and while we send at least every half sync_time);
+	 * written at our resync, bytes/s charged to the shaper, all of it
+	 * and the sparse flows' part, averaged over CAKE_MQ_TAU; the bulk
+	 * weight; whether we used (nearly) all of our share
 	 */
+	u64		last_active ____cacheline_aligned_in_smp;
 	u64		mq_usage;
 	u64		mq_sparse;
 	u64		mq_idle;	/* ns without a packet until we count as idle */
 	u32		mq_weight;
 	bool		mq_saturated;
-	/* charged to the shaper since our last resync */
-	u64		mq_bytes;
+	/* charged to the shaper since our last resync, a packet at a time */
+	u64		mq_bytes ____cacheline_aligned_in_smp;
 	u64		mq_sparse_bytes;
 	u32		mq_packets;
 	/* when the shaper last held packets back */
@@ -2559,6 +2562,8 @@ static void cake_mq_publish(struct cake_sched_data *q, u64 now)
 	usage = cake_mq_ewma(q->mq_usage, q->mq_bytes, dt, tau);
 	sparse = cake_mq_ewma(q->mq_sparse, q->mq_sparse_bytes, dt, tau);
 	idle = cake_mq_idle_after(q->mq_idle, q->mq_bytes, q->mq_packets, usage);
+	if (q->mq_packets)
+		WRITE_ONCE(q->last_active, now);
 	q->mq_bytes = 0;
 	q->mq_sparse_bytes = 0;
 	q->mq_packets = 0;
@@ -3357,7 +3362,13 @@ found:
 		flow->cvars.ecn_marked = true;
 	b->tin_ecn_mark += !!flow->cvars.ecn_marked;
 	qdisc_bstats_update(sch, skb);
-	if (q->config->is_shared)
+	/* The other sub-cakes read when we last sent only once our queue is
+	 * empty: written exactly as it empties, and otherwise at least every
+	 * half sync_time, for one that reads it as the queue empties
+	 */
+	if (q->config->is_shared &&
+	    (!sch->q.qlen || !q->last_active ||
+	     (s64)(now - q->last_active) >= (s64)(q->config->sync_time / 2)))
 		WRITE_ONCE(q->last_active, now);
 
 	/* collect delay stats */
--- a/net/sched/sch_cake_test.c
+++ b/net/sched/sch_cake_test.c
@@ -4509,6 +4509,83 @@ static void cake_test_overflow_heap(struct kunit *test)
 		KUNIT_EXPECT_TRUE_MSG(test, reset[m], "mode %d", m);
 }
 
+/* cake_mq: what the other sub-cakes read sits on a cache line of its own,
+ * and what's written for every packet starts on the next
+ */
+static void cake_test_mq_published_line(struct kunit *test)
+{
+	size_t at = offsetof(struct cake_sched_data, last_active);
+
+	KUNIT_EXPECT_EQ(test, at % SMP_CACHE_BYTES, 0);
+	KUNIT_EXPECT_LT(test, offsetof(struct cake_sched_data, mq_usage), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_LT(test, offsetof(struct cake_sched_data, mq_sparse), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_LT(test, offsetof(struct cake_sched_data, mq_idle), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_LT(test, offsetof(struct cake_sched_data, mq_weight), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_LT(test, offsetof(struct cake_sched_data, mq_saturated), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_bytes), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_held_at), at + SMP_CACHE_BYTES);
+}
+
+/* When a sub-cake last sent is written as its queue empties, whatever was
+ * there; while packets are left, only once half a sync_time has passed
+ * since it was last written (or it never was); and at a resync after
+ * packets were sent
+ */
+static void cake_test_mq_last_active(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_mq_live(test, mq, 1);
+	struct Qdisc *sch = mq->sch[1];
+	const u64 later = ktime_get_ns() + NSEC_PER_SEC;
+	u64 seen[5], before, now;
+	struct sk_buff *skb[5];
+	bool ok = true;
+	int i;
+
+	mq->cfg->sync_time = 200 * NSEC_PER_USEC;
+	cake_test_pkts(test, skb, 5, 5, 100);
+	before = ktime_get_ns();
+	rcu_read_lock_bh();
+	for (i = 0; i < 3; i++)
+		ok &= cake_test_in(sch, skb[i]);
+	/* never written: written */
+	ok &= cake_test_out(sch, skb[0]);
+	seen[0] = q->last_active;
+	/* written just now (a time ahead of this one): left alone */
+	q->last_active = later;
+	ok &= cake_test_out(sch, skb[1]);
+	seen[1] = q->last_active;
+	/* the queue empties: written, the exact time */
+	ok &= cake_test_out(sch, skb[2]);
+	seen[2] = q->last_active;
+	/* long ago: written */
+	ok &= cake_test_in(sch, skb[3]) && cake_test_in(sch, skb[4]);
+	q->last_active = 1;
+	ok &= cake_test_out(sch, skb[3]);
+	seen[3] = q->last_active;
+	ok &= cake_test_out(sch, skb[4]);
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_GE(test, seen[0], before);
+	KUNIT_EXPECT_EQ(test, seen[1], later);
+	KUNIT_EXPECT_GE(test, seen[2], seen[0]);
+	KUNIT_EXPECT_LT(test, seen[2], later);
+	KUNIT_EXPECT_GE(test, seen[3], seen[2]);
+
+	/* a resync after packets were sent, and one after none */
+	now = ktime_get_ns();
+	q->last_checked_active = now - mq->cfg->sync_time;
+	q->mq_packets = 3;
+	q->mq_bytes = 300;
+	cake_mq_publish(q, now);
+	seen[4] = q->last_active;
+	KUNIT_EXPECT_EQ(test, seen[4], now);
+	q->last_checked_active = now;
+	cake_mq_publish(q, now + mq->cfg->sync_time);
+	KUNIT_EXPECT_EQ(test, q->last_active, now);
+}
+
 static int cake_test_init(struct kunit *test)
 {
 	int i;
@@ -4606,6 +4683,8 @@ static struct kunit_case cake_test_cases[] = {
 	KUNIT_CASE(cake_test_decaying_steps),
 	KUNIT_CASE(cake_test_mq_drained_rests),
 	KUNIT_CASE(cake_test_mq_host_table_matches),
+	KUNIT_CASE(cake_test_mq_published_line),
+	KUNIT_CASE(cake_test_mq_last_active),
 	KUNIT_CASE(cake_test_autorate_throttled),
 	KUNIT_CASE(cake_test_change_refused),
 	KUNIT_CASE(cake_test_change_vs_autorate),
