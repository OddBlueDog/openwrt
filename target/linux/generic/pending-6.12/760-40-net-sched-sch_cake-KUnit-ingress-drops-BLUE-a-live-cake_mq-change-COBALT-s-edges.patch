+/* sparse_ahead_us in ingress mode, COBALT dropping the packet that was to
+ * go ahead (BLUE at its highest drops all of a flow's packets but its
+ * last): the drop is charged to the shaper, which then holds all the more,
+ * so the dequeue looks ahead again and the flow's next packet goes, the
+ * bulk flow still held. It can't go on to the bulk flows with its look
+ * ahead left over from the drop: the time it holds to and the failsafe
+ * haven't moved. Then, the shaper due, a bulk packet COBALT drops is
+ * followed by the flow's next one, as ever.
+ */
+static void cake_test_sparse_ahead_drop(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 125000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	u64 dur = (100 * q->rate_ns) >> q->rate_shft, tn[2];
+	struct cake_tin_data *b = &q->tins[0];
+	struct cake_flow *sflow, *bflow;
+	struct Qdisc *sch = mq->sch[0];
+	struct sk_buff *bulk[3], *s[2], *out[2];
+	u32 drops[3], qlen[2];
+	bool ok = true;
+	ktime_t now;
+	int i;
+
+	cake_test_ahead_set(test, 20000);
+	q->config->rate_flags |= CAKE_FLAG_INGRESS;
+	cake_test_dl_pkts(test, bulk, 3, 5, 1514, true);
+	cake_test_dl_pkts(test, s, 2, 6, 100, true);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	rcu_read_lock_bh();
+	for (i = 0; i < 3; i++)
+		ok &= cake_test_in(sch, bulk[i]);
+	/* the shaper holds the next 12 ms */
+	ok &= cake_test_out(sch, bulk[0]);
+	for (i = 0; i < 2; i++)
+		ok &= cake_test_in(sch, s[i]);
+	sflow = cake_test_flow_of(b, s[0]);
+	bflow = cake_test_flow_of(b, bulk[1]);
+	ok &= sflow && bflow;
+	if (ok) {
+		sflow->cvars.p_drop = U32_MAX;
+		drops[0] = sch->qstats.drops;
+		tn[0] = ktime_to_ns(q->time_next_packet);
+		out[0] = cake_dequeue(sch);
+		tn[1] = ktime_to_ns(q->time_next_packet);
+		drops[1] = sch->qstats.drops;
+		qlen[0] = sch->q.qlen;
+		/* the shaper due: the bulk flow's next packet dropped, its last sent */
+		bflow->cvars.p_drop = U32_MAX;
+		now = ktime_get();
+		q->time_next_packet = now;
+		q->failsafe_next_packet = now;
+		out[1] = cake_dequeue(sch);
+		drops[2] = sch->qstats.drops;
+		qlen[1] = sch->q.qlen;
+	}
+	rcu_read_unlock_bh();
+
+	KUNIT_ASSERT_TRUE(test, ok);
+	KUNIT_EXPECT_PTR_EQ(test, out[0], s[1]);
+	KUNIT_EXPECT_EQ(test, drops[1], drops[0] + 1);
+	KUNIT_EXPECT_EQ(test, qlen[0], 2);
+	/* both of its packets charged: the one dropped, the one sent */
+	KUNIT_EXPECT_EQ(test, tn[1], tn[0] + 2 * dur);
+	KUNIT_EXPECT_PTR_EQ(test, out[1], bulk[2]);
+	KUNIT_EXPECT_EQ(test, drops[2], drops[1] + 1);
+	KUNIT_EXPECT_EQ(test, qlen[1], 0);
+	kfree_skb(out[0]);
+	kfree_skb(out[1]);
+}
