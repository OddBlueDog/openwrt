From: MilkFlint <milkflint@localhost>
Date: Thu, 19 Nov 2026 16:50:00 +0000
Subject: [PATCH] net/sched: sch_cake: the overflow heap sifts a shortened queue all the way down

cake_heapify() sifts a queue whose backlog went down past its longer
child. After the first swap it compared the children at the queue's new
place with the backlog of the child that had gone up, not with the
queue's own, so the queue went down one level at most. The heap then had
queues longer than their parents: a drop at the memory limit could take
from a queue that wasn't the longest, or find an empty one at the top
(cake_drop()'s "heap has gone wrong", which rebuilds it at the next
drop). The queue is now compared with its children at each level.

KUnit: packets in and out of 1, 3, 4 and 8 tins at random, with drops at
the memory limit between them, all in one spell: each drop takes from a
longest queue. Before, a good part of them didn't.

---
--- a/net/sched/sch_cake.c
+++ b/net/sched/sch_cake.c
@@ -2060,11 +2060,12 @@ static u32 cake_heap_get_backlog(const struct cake_sched_data *q, u16 i)
 	return q->tins[ii.t].backlogs[ii.b];
 }
 
+/* Sift the queue at @i down the overflow heap, past every queue longer */
 static void cake_heapify(struct cake_sched_data *q, u16 i)
 {
 	static const u32 a = CAKE_MAX_TINS * CAKE_QUEUES;
 	u32 mb = cake_heap_get_backlog(q, i);
-	u32 m = i;
+	u32 ib = mb, m = i;
 
 	while (m < a) {
 		u32 l = m + m + 1;
@@ -2091,6 +2092,10 @@ static void cake_heapify(struct cake_sched_data *q, u16 i)
 		if (m != i) {
 			cake_heap_swap(q, i, m);
 			i = m;
+			/* its children are compared with it, not with the one
+			 * that went up in its place
+			 */
+			mb = ib;
 		} else {
 			break;
 		}
--- a/net/sched/sch_cake_test.c
+++ b/net/sched/sch_cake_test.c
@@ -4397,6 +4397,83 @@ static void cake_test_autorate_starts_afresh(struct kunit *test)
 	KUNIT_EXPECT_GE(test, q->last_packet_time, before);
 }
 
+/* The longest queue of the tins in use */
+static u32 cake_test_longest(struct cake_sched_data *q)
+{
+	u32 most = 0;
+	int t, j;
+
+	for (t = 0; t < q->tin_cnt; t++)
+		for (j = 0; j < CAKE_QUEUES; j++)
+			most = max(most, q->tins[t].backlogs[j]);
+	return most;
+}
+
+/* Each drop at the memory limit takes from a longest queue: with packets in
+ * and out of 1, 3, 4 and 8 tins at random and drops between them, all in
+ * one spell, so the heap the first drop builds is kept up to date from
+ * then on. A queue shortened at the top of the heap has to sift down past
+ * every queue that's now longer, not just its children.
+ */
+static void cake_test_overflow_heap(struct kunit *test)
+{
+	static const u8 modes[] = { CAKE_DIFFSERV_BESTEFFORT, CAKE_DIFFSERV_DIFFSERV3,
+				    CAKE_DIFFSERV_DIFFSERV4, CAKE_DIFFSERV_DIFFSERV8,
+				    CAKE_DIFFSERV_BESTEFFORT };
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 0, modes[0]);
+	struct Qdisc *sch = mq->sch[0];
+	const int n = 2500;
+	struct sk_buff **skb = cake_test_alloc(test, n * sizeof(*skb));
+	u32 victims = 0, wrong = 0;
+	struct rnd_state rnd;
+	int i, m, next = 0;
+
+	prandom_seed_state(&rnd, 7632);
+	for (i = 0; i < n; i++) {
+		skb[i] = cake_test_skb(test, false, IPPROTO_UDP, 2 + prandom_u32_state(&rnd) % 30,
+				       40000 + prandom_u32_state(&rnd) % 16, 0);
+		qdisc_skb_cb(skb[i])->pkt_len = 64 + prandom_u32_state(&rnd) % 1450;
+		/* a tin each, of those there are */
+		skb[i]->priority = 1 + prandom_u32_state(&rnd) % 8;
+	}
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	for (m = 0; m < ARRAY_SIZE(modes); m++) {
+		int op;
+
+		if (m) {
+			rtnl_lock();
+			KUNIT_EXPECT_EQ(test, 0, cake_change(sch, cake_test_opts(test, 0, modes[m],
+										   false), NULL));
+			rtnl_unlock();
+		}
+		for (op = 0; op < 500 && next < n; op++) {
+			u32 r = prandom_u32_state(&rnd) % 10, id, most, len;
+			struct sk_buff *to_free = NULL;
+
+			rcu_read_lock_bh();
+			if (r < 7 || !sch->q.qlen) {
+				/* CAKE has it now */
+				kunit_remove_action(test, cake_test_free_skb, skb[next]);
+				cake_test_in(sch, skb[next++]);
+			} else if (r < 9) {
+				kfree_skb(cake_dequeue(sch));
+			} else {
+				most = cake_test_longest(q);
+				id = cake_drop(sch, &to_free, ktime_get());
+				len = to_free ? qdisc_pkt_len(to_free) : 0;
+				kfree_skb_list(to_free);
+				victims++;
+				wrong += q->tins[id >> 16].backlogs[id & 0xffff] + len != most;
+			}
+			rcu_read_unlock_bh();
+		}
+	}
+	KUNIT_EXPECT_EQ(test, wrong, 0);
+	KUNIT_EXPECT_GT(test, victims, 100);
+}
+
 static int cake_test_init(struct kunit *test)
 {
 	int i;
@@ -4499,6 +4576,7 @@ static struct kunit_case cake_test_cases[] = {
 	KUNIT_CASE(cake_test_change_vs_autorate),
 	KUNIT_CASE(cake_test_clear_tin_parent),
 	KUNIT_CASE(cake_test_clear_tin_empty),
+	KUNIT_CASE(cake_test_overflow_heap),
 	KUNIT_CASE(cake_test_set_rate),
 	KUNIT_CASE(cake_test_mq_share_exact),
 	KUNIT_CASE(cake_test_autorate_starts_afresh),
