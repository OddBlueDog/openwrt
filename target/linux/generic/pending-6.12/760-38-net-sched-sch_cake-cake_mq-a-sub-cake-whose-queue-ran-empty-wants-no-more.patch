From: MilkFlint <milkflint@localhost>
Date: Mon, 23 Nov 2026 12:00:00 +0000
Subject: [PATCH] net/sched: sch_cake: cake_mq: a sub-cake whose queue ran empty wants no more

760-25 kept a cake_mq sub-cake counted as wanting more than its share for
as long as its shaper held packets back between one resync and the next,
whatever its average of what it used: a TCP flow held back by a share that
just grew sends at all of it while its average catches up. But a hold
alone doesn't say that. A stream well under its share, its packets
arriving a few at a time (a sender's timer, a NAPI poll's batch), has each
burst's second packet wait for the first, and runs empty in between. When
its queue's last packet of a burst goes at a dequeue that doesn't resync,
the next resync finds it held since the last one, and once it had wanted
more it went on wanting more. The other sub-cakes then left it its bid's
part of the rate (a sub-cake with only sparse flows bids as one host's
only flow) instead of what it used, and held themselves to the rest: with
two sub-cakes, up to half the rate unused.

A sub-cake held back by its share is never out of packets between two
resyncs; one that ran empty had less to send than its share let through.
cake_dequeue() notes when a packet leaves the queue empty, and the
sub-cake goes on wanting more only if that wasn't since its last resync.
Otherwise it drops out as one whose shaper stopped holding packets back,
and counts again as wanting more once it uses 7/8 of its share with
packets held back, or all of it.

How often the old rule latched depends on timing: with wake_slack_us at
its default the watchdog's wakeup that sends a burst's last packet is
usually a resync too, which ends the latch at the next burst, and once
out a stream well under its share doesn't come back in. Smoothly
paced streams seldom show it; a sender's own bursts or a NAPI poll's
arriving in a held queue can.

KUnit: the saturation table with a queue run empty since the last resync
(out, unless it uses most of its share); three cake_mq simulations, a
stream of 3 MB/s and one at a quarter of its share in bursts of two and
three packets, and a sparse-only one against a host's four bulk flows:
it drops out, the other takes the rest of the rate, no more than the rate
between them (each kept half on the old rule); the TCP senders' over-rate
simulation records drains as cake_dequeue() does and still holds the rate;
at 2 Mbit/s a sub-cake that wanted more and stops withholds at most four
of its packets' worth of the rate while it counts as active (48 ms here);
a third sub-cake near idle (1 Mbit/s, as RSS's ring 0) beside the bursts
doesn't change that; the drain time written only as the queue empties, on
the sub-cake's own cache line.

---
--- a/net/sched/sch_cake.c
+++ b/net/sched/sch_cake.c
@@ -328,8 +328,11 @@ struct cake_sched_data {
 	u64		mq_bytes ____cacheline_aligned_in_smp;
 	u64		mq_sparse_bytes;
 	u32		mq_packets;
-	/* when the shaper last held packets back */
+	/* when the shaper last held packets back, and when a packet sent
+	 * last left our queue empty
+	 */
 	u64		mq_held_at;
+	u64		mq_drained_at;
 	/* wakes a sub-cake gone idle, to retire its rotation: cake_mq_drained() */
 	struct qdisc_watchdog mq_watchdog;
 
@@ -2633,14 +2636,22 @@ static u64 cake_mq_idle_after(u64 idle, u64 bytes, u32 packets, u64 usage)
  * its share never waits.
  *
  * Once it wants more, it goes on wanting more for as long as its shaper
- * holds packets back between one resync and the next. Its average lags its
- * share: when the share grows (another sub-cake used less), it can count
- * as using well under 7/8 of it, and so as wanting no more, while it sends
- * at all of it. The others would then share out what it doesn't use, as they read it,
- * and take the part it does: together they'd send more than the rate, as
- * long as its average took to catch up, and do it again each time the share
- * moves. A sub-cake whose shaper stops holding packets back (its flows
- * slowed down) still drops out at its next resync.
+ * holds packets back between one resync and the next, and its queue never
+ * runs empty in between. Its average lags its share: when the share grows
+ * (another sub-cake used less), it can count as using well under 7/8 of
+ * it, and so as wanting no more, while it sends at all of it. The others
+ * would then share out what it doesn't use, as they read it, and take the
+ * part it does: together they'd send more than the rate, as long as its
+ * average took to catch up, and do it again each time the share moves.
+ *
+ * A sub-cake whose shaper stops holding packets back (its flows slowed
+ * down) drops out at its next resync, and so does one whose queue ran
+ * empty since its last: it had less to send than its share let through,
+ * and only its bursts waited. A stream at a quarter of its share, its
+ * packets arriving two at a time, has the second wait for the first
+ * almost every time; counted as wanting more, the others would leave it
+ * its bid's part of the rate rather than what it uses, and the rate would
+ * go unused.
  */
 static void cake_mq_publish(struct cake_sched_data *q, u64 now)
 {
@@ -2669,7 +2680,8 @@ static void cake_mq_publish(struct cake_sched_data *q, u64 now)
 		   usage >= q->synced_rate - (q->synced_rate >> 5) ||
 		   (now - q->mq_held_at < tau &&
 		    usage >= q->synced_rate - (q->synced_rate >> 3)) ||
-		   (q->mq_saturated && q->mq_held_at >= q->last_checked_active));
+		   (q->mq_saturated && q->mq_held_at >= q->last_checked_active &&
+		    q->mq_drained_at < q->last_checked_active));
 }
 
 /* The sub-cakes sharing the rate with @q, @q included: those on the
@@ -3505,12 +3517,16 @@ ahead:
 	qdisc_bstats_update(sch, skb);
 	/* The other sub-cakes read when we last sent only once our queue is
 	 * empty: written exactly as it empties, and otherwise at least every
-	 * half sync_time, for one that reads it as the queue empties
+	 * half sync_time, for one that reads it as the queue empties. Our
+	 * next resync reads whether it emptied (cake_mq_publish()).
 	 */
-	if (q->config->is_shared &&
-	    (!sch->q.qlen || !q->last_active ||
-	     (s64)(now - q->last_active) >= (s64)(q->config->sync_time / 2)))
-		WRITE_ONCE(q->last_active, now);
+	if (q->config->is_shared) {
+		if (!sch->q.qlen)
+			q->mq_drained_at = ktime_to_ns(now);
+		if (!sch->q.qlen || !q->last_active ||
+		    (s64)(now - q->last_active) >= (s64)(q->config->sync_time / 2))
+			WRITE_ONCE(q->last_active, now);
+	}
 
 	/* collect delay stats */
 	delay = ktime_to_ns(ktime_sub(now, cobalt_get_enqueue_time(skb)));
--- a/net/sched/sch_cake_test.c
+++ b/net/sched/sch_cake_test.c
@@ -854,7 +854,8 @@ static void cake_test_mq_ewma(struct kunit *test)
 
 /* Wanting more than its share: using all of it, or most of it with packets
  * held back by the shaper; and once wanting more, for as long as the shaper
- * holds packets back from one resync to the next, whatever its average
+ * holds packets back from one resync to the next and the queue never runs
+ * empty in between, whatever its average
  */
 static void cake_test_mq_saturated(struct kunit *test)
 {
@@ -869,6 +870,7 @@ static void cake_test_mq_saturated(struct kunit *test)
 		u8 held;
 		bool was;	/* wanted more at the last resync */
 		bool saturated;
+		bool drained;	/* its queue ran empty since the last resync */
 	} cases[] = {
 		{ 990, NOT_HELD, false, true },		/* all of it */
 		{ 900, HELD_SINCE, false, true },	/* TCP held back by its share */
@@ -882,6 +884,14 @@ static void cake_test_mq_saturated(struct kunit *test)
 		{ 900, HELD_BEFORE, true, true },
 		{ 800, HELD_BEFORE, true, false },
 		{ 700, NOT_HELD, true, false },
+		/* its bursts wait, but it runs out of packets in between: it
+		 * has less to send than its share
+		 */
+		{ 300, HELD_SINCE, true, false, true },
+		{ 700, HELD_SINCE, true, false, true },
+		/* ... which doesn't matter while it uses most of its share */
+		{ 900, HELD_SINCE, true, true, true },
+		{ 990, NOT_HELD, true, true, true },
 	};
 	int c;
 
@@ -899,6 +909,8 @@ static void cake_test_mq_saturated(struct kunit *test)
 		q->mq_idle = CAKE_MQ_TAU;
 		q->last_checked_active = now - dt;
 		q->mq_held_at = held_at[cases[c].held];
+		/* emptied after the last resync, or long before it */
+		q->mq_drained_at = cases[c].drained ? now - 50 * NSEC_PER_USEC : 0;
 		q->mq_saturated = cases[c].was;
 		cake_mq_publish(q, now);
 		KUNIT_EXPECT_EQ_MSG(test, q->mq_saturated, cases[c].saturated, "case %d", c);
@@ -1059,6 +1071,7 @@ static void cake_test_mq_converge(struct kunit *test, struct cake_test_mq *mq,
 		q->mq_idle = 0;
 		q->mq_packets = 0;
 		q->mq_held_at = 0;
+		q->mq_drained_at = 0;
 		q->mq_weight = 0;
 		q->mq_saturated = false;
 		if (i < n && demand[i]) {
@@ -1165,6 +1178,7 @@ static void cake_test_mq_senders(struct cake_test_mq *mq, int n, u64 rate, u32 p
 		q->mq_idle = 0;
 		q->mq_packets = 0;
 		q->mq_held_at = 0;
+		q->mq_drained_at = 0;
 		q->mq_weight = 0;
 		q->mq_saturated = false;
 		q->time_next_packet = 0;
@@ -1214,6 +1228,7 @@ static void cake_test_mq_senders(struct cake_test_mq *mq, int n, u64 rate, u32 p
 			}
 			if (!backlog[i]) {
 				mq->sch[i]->q.qlen = 0;
+				q->mq_drained_at = now;
 			} else if (q->time_next_packet > now) {
 				q->mq_held_at = now;
 				r->held++;
@@ -1275,6 +1290,272 @@ static void cake_test_mq_share_within_rate(struct kunit *test)
 	}
 }
 
+/* Sub-cake 1's traffic after it wanted more: @pkts packets of 1514 bytes
+ * every @every ticks, all at once (a sender paced by its timer, the
+ * packets handed over a NAPI poll at a time), its flows sparse ones
+ * (counted as such, no bulk weight) when @sparse. Sub-cake 0's bulk weight
+ * is @weight (0: a host's only flow).
+ */
+struct cake_test_bursts {
+	u32 pkts, every, weight;
+	bool sparse;
+	/* a third sub-cake with a 1514-byte packet every this many ticks, its
+	 * own and never wanting more (0: none)
+	 */
+	u32 trickle;
+};
+
+/* Two sub-cakes sharing 100 MB/s that both wanted more, at half of it each,
+ * for 50 ms: sub-cake 0 held back throughout, sub-cake 1 with only @c's
+ * bursts; with @c's trickle, a third that never wanted more. What each sent
+ * in the last 25 ms in @sent, and whether each wanted more at the end in
+ * @sat.
+ */
+static void cake_test_mq_bursts(struct kunit *test, const struct cake_test_bursts *c,
+				u64 *sent, bool *sat)
+{
+	const u64 rate = 100000000, sync = 200 * NSEC_PER_USEC;
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	u64 now = 10 * NSEC_PER_MSEC, backlog[3] = {};
+	const u64 from = now + 25 * NSEC_PER_MSEC, end = now + 50 * NSEC_PER_MSEC;
+	const int n = c->trickle ? 3 : 2;
+	struct cake_sched_data *q;
+	u32 t;
+	int i;
+
+	cake_test_mq_alloc_tins(test, mq);
+	mq->dev->real_num_tx_queues = n;
+	bitmap_zero(mq->cfg->used_qs, CAKE_TEST_TXQS);
+	mq->cfg->rate_bps = rate;
+	sent[0] = sent[1] = sent[2] = 0;
+	for (i = 0; i < n; i++) {
+		q = cake_test_mq_q(mq, i);
+		mq->sch[i]->q.qlen = 0;
+		q->tin_cnt = 1;
+		q->tins[0].mq_weight = i ? 0 : c->weight;
+		q->mq_bytes = q->mq_sparse_bytes = 0;
+		q->mq_idle = 0;
+		q->mq_packets = 0;
+		q->mq_weight = q->tins[0].mq_weight;
+		q->mq_drained_at = 0;
+		q->synced_rate = rate / 2;
+		q->mq_usage = rate / 2;
+		q->mq_sparse = i == 1 && c->sparse ? rate / 2 : 0;
+		q->mq_saturated = i < 2;
+		q->mq_held_at = i < 2 ? now : 0;
+		if (i == 2)
+			q->mq_usage = div_u64(1514ULL * NSEC_PER_SEC, c->trickle * CAKE_TEST_TICK);
+		q->last_checked_active = now;
+		q->last_active = now;
+		q->time_next_packet = now;
+	}
+	/* sub-cake 0 is never out of packets; 1 starts with none */
+	cake_test_mq_enqueue(mq, 0);
+
+	for (t = 0; now < end; t++) {
+		now += CAKE_TEST_TICK;
+		/* a burst for sub-cake 1, as cake_enqueue() takes it: an empty
+		 * queue's shaper starts from now
+		 */
+		for (i = 1; i < n; i++) {
+			if (t % (i == 1 ? c->every : c->trickle))
+				continue;
+			q = cake_test_mq_q(mq, i);
+			if (!backlog[i]) {
+				cake_test_mq_enqueue(mq, i);
+				q->time_next_packet = max_t(u64, q->time_next_packet, now);
+			}
+			backlog[i] += i == 1 ? c->pkts : 1;
+		}
+		for (i = 0; i < n; i++) {
+			q = cake_test_mq_q(mq, i);
+			if (i && !backlog[i])
+				continue;
+			if (now - q->last_checked_active >= sync) {
+				struct cake_mq_peers p;
+				u64 share;
+
+				cake_mq_publish(q, now);
+				cake_test_mq_peers(mq, i, now, &p);
+				share = cake_mq_share(rate, q->mq_weight, q->mq_sparse, &p);
+				if (cake_mq_share_moved(share, q->synced_rate, rate)) {
+					q->time_next_packet = cake_mq_rescale_wait(q->time_next_packet, now,
+										   q->synced_rate, share);
+					q->synced_rate = share;
+				}
+				q->last_checked_active = now;
+			}
+			/* sub-cake 0's flows never run out: no credit for a pause */
+			if (i == 0)
+				q->time_next_packet = max_t(u64, q->time_next_packet, now - CAKE_TEST_TICK);
+			while ((i == 0 || backlog[i]) && q->time_next_packet <= now) {
+				q->time_next_packet += div64_u64(1514ULL * NSEC_PER_SEC, q->synced_rate);
+				q->mq_bytes += 1514;
+				if (i == 1 && c->sparse)
+					q->mq_sparse_bytes += 1514;
+				q->mq_packets++;
+				q->last_active = now;
+				if (now > from)
+					sent[i] += 1514;
+				if (i)
+					backlog[i]--;
+			}
+			if (i && !backlog[i]) {
+				mq->sch[i]->q.qlen = 0;
+				q->mq_drained_at = now;
+			} else if (q->time_next_packet > now) {
+				q->mq_held_at = now;
+			}
+		}
+	}
+	for (i = 0; i < n; i++)
+		sat[i] = cake_test_mq_q(mq, i)->mq_saturated;
+}
+
+/* A sub-cake that wanted more is left with a stream well under its share,
+ * in bursts: the second packet of each waits for the first at its share,
+ * but its queue runs empty in between. It drops out, and the other, held
+ * back throughout, takes all of the rate but the stream's. Counted as still
+ * wanting more, it kept its bid's half for itself (a sub-cake with only
+ * sparse flows bids as one host's only flow, as much as another's four),
+ * the other was held to the rest, and up to half the rate went unused.
+ */
+static void cake_test_mq_bursts_drop_out(struct kunit *test)
+{
+	static const struct cake_test_bursts cases[] = {
+		/* 3 MB/s, two packets every 1 ms */
+		{ 2, 20, 0, false },
+		/* a quarter of its share, three packets every 350 us */
+		{ 3, 7, 0, false },
+		/* sparse flows only, against one host's four bulk flows */
+		{ 2, 20, 4 * (65535 / 4), true },
+		/* a quarter of its share in bursts, and a third sub-cake near
+		 * idle at 1 Mbit/s (an RSS ring the table gives nothing, CPU 0's)
+		 */
+		{ 3, 7, 0, false, 240 },
+	};
+	const u64 rate = 100000000, span = 25 * NSEC_PER_MSEC;
+	int c;
+
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		u64 stream = div_u64(cases[c].pkts * 1514ULL * NSEC_PER_SEC,
+				     cases[c].every * CAKE_TEST_TICK);
+		u64 trickle = cases[c].trickle ?
+			div_u64(1514ULL * NSEC_PER_SEC, cases[c].trickle * CAKE_TEST_TICK) : 0;
+		u64 want = div_u64((rate - stream - trickle) * span, NSEC_PER_SEC), sent[3];
+		bool sat[3];
+
+		cake_test_mq_bursts(test, &cases[c], sent, sat);
+		KUNIT_EXPECT_FALSE_MSG(test, sat[1], "case %d", c);
+		KUNIT_EXPECT_TRUE_MSG(test, sat[0], "case %d", c);
+		if (cases[c].trickle) {
+			KUNIT_EXPECT_FALSE_MSG(test, sat[2], "case %d", c);
+			/* every packet of the trickle through, the sum still within the rate */
+			KUNIT_EXPECT_GE_MSG(test, sent[2] + 1514, div_u64(trickle * span, NSEC_PER_SEC), "case %d", c);
+			sent[1] += sent[2];
+		}
+		/* the stream all got through; the rest of the rate went to
+		 * sub-cake 0, to within 2%, and no more than the rate between them
+		 */
+		KUNIT_EXPECT_GE_MSG(test, sent[1] + cases[c].pkts * 1514,
+				    div_u64(stream * span, NSEC_PER_SEC), "case %d", c);
+		KUNIT_EXPECT_GE_MSG(test, sent[0] * 100, want * 98,
+				    "case %d: sent %llu, the rest of the rate %llu", c, sent[0], want);
+		KUNIT_EXPECT_LE_MSG(test, (sent[0] + sent[1]) * 1000,
+				    div_u64(rate * span, NSEC_PER_SEC) * 1005 + 1000 * 1514, "case %d", c);
+	}
+}
+
+/* At 2 Mbit/s two sub-cakes both want more, a 1514-byte packet each every
+ * 12 ms at their half of the rate; then one's flows end. It goes on
+ * counting as active, and as wanting more, until it's idle: four of its
+ * packet intervals after its last packet (cake_mq_idle_after(), 48 ms
+ * here). The other is held to half the rate that long and then takes all
+ * of it: at most four of the stopped one's packets' worth of the rate goes
+ * unused, however long its idle time.
+ */
+static void cake_test_mq_stopped_holds_little(struct kunit *test)
+{
+	const u64 rate = 250000, sync = 200 * NSEC_PER_USEC;
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	u64 now = 10 * NSEC_PER_MSEC, sent = 0, idle = 0, lost;
+	const u64 stop = now + 300 * NSEC_PER_MSEC, end = stop + 200 * NSEC_PER_MSEC;
+	struct cake_sched_data *q;
+	u32 t;
+	int i;
+
+	cake_test_mq_alloc_tins(test, mq);
+	mq->dev->real_num_tx_queues = 2;
+	bitmap_zero(mq->cfg->used_qs, CAKE_TEST_TXQS);
+	mq->cfg->rate_bps = rate;
+	for (i = 0; i < 2; i++) {
+		q = cake_test_mq_q(mq, i);
+		mq->sch[i]->q.qlen = 0;
+		q->tin_cnt = 1;
+		q->tins[0].mq_weight = 0;
+		q->mq_bytes = q->mq_sparse_bytes = q->mq_sparse = 0;
+		q->mq_idle = 0;
+		q->mq_packets = 0;
+		q->mq_weight = 0;
+		q->mq_drained_at = 0;
+		q->synced_rate = rate / 2;
+		q->mq_usage = rate / 2;
+		q->mq_saturated = true;
+		q->mq_held_at = now;
+		q->last_checked_active = now;
+		q->last_active = now;
+		q->time_next_packet = now;
+		cake_test_mq_enqueue(mq, i);
+	}
+
+	for (t = 0; now < end; t++) {
+		now += CAKE_TEST_TICK;
+		for (i = 0; i < 2; i++) {
+			q = cake_test_mq_q(mq, i);
+			/* sub-cake 1's flows end: its last packet has gone */
+			if (i == 1 && now >= stop) {
+				if (mq->sch[1]->q.qlen) {
+					mq->sch[1]->q.qlen = 0;
+					q->mq_drained_at = now;
+					idle = q->mq_idle;
+				}
+				continue;
+			}
+			if (now - q->last_checked_active >= sync) {
+				struct cake_mq_peers p;
+				u64 share;
+
+				cake_mq_publish(q, now);
+				cake_test_mq_peers(mq, i, now, &p);
+				share = cake_mq_share(rate, q->mq_weight, q->mq_sparse, &p);
+				if (cake_mq_share_moved(share, q->synced_rate, rate)) {
+					q->time_next_packet = cake_mq_rescale_wait(q->time_next_packet, now,
+										   q->synced_rate, share);
+					q->synced_rate = share;
+				}
+				q->last_checked_active = now;
+			}
+			q->time_next_packet = max_t(u64, q->time_next_packet, now - CAKE_TEST_TICK);
+			while (q->time_next_packet <= now) {
+				q->time_next_packet += div64_u64(1514ULL * NSEC_PER_SEC, q->synced_rate);
+				q->mq_bytes += 1514;
+				q->mq_packets++;
+				q->last_active = now;
+				if (i == 0 && now >= stop)
+					sent += 1514;
+			}
+			q->mq_held_at = now;
+		}
+	}
+
+	lost = div_u64(rate * (end - stop), NSEC_PER_SEC) - min(sent, div_u64(rate * (end - stop), NSEC_PER_SEC));
+	kunit_info(test, "idle after %llu ms, %llu bytes of the rate unused", div_u64(idle, NSEC_PER_MSEC), lost);
+	/* the slow case: a long time to count as idle */
+	KUNIT_EXPECT_GE(test, idle, 40 * NSEC_PER_MSEC);
+	KUNIT_EXPECT_EQ(test, cake_test_mq_q(mq, 0)->synced_rate, rate);
+	KUNIT_EXPECT_LE(test, lost, 6 * 1514);
+}
+
 /* The cases in the plan: uneven demand, sub-queues idle, weights by host */
 static void cake_test_mq_share_converges(struct kunit *test)
 {
@@ -4536,12 +4817,13 @@ static void cake_test_mq_published_line(struct kunit *test)
 	KUNIT_EXPECT_LT(test, offsetof(struct cake_sched_data, mq_saturated), at + SMP_CACHE_BYTES);
 	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_bytes), at + SMP_CACHE_BYTES);
 	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_held_at), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_drained_at), at + SMP_CACHE_BYTES);
 }
 
