From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MilkFlint <milkflint@localhost>
Date: Mon, 19 Oct 2026 22:04:40 +0100
Subject: [PATCH] net/sched: sch_cake: hash the hosts only when a flow queue is
 allocated

With host isolation (triple-isolate, dual-srchost, dual-dsthost) and
per-flow queues, cake_hash() dissected every packet and ran SipHash three
times: the flow hash and the two host hashes. The host hashes are only
used when a queue is allocated to a flow, on its first packet after being
idle or on a collision; every later packet is found by the flow hash
alone, and threw them away.

Work them out from the packet when a queue is allocated instead
(cake_host_hashes(): the same dissection and conntrack lookup). Host-only
modes build the flow hash from the host hashes, so still hash them first.

Classification then costs less per packet, for downloads and for the
ACKs of uploads alike; the allocations that hash hosts are rare.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 net/sched/sch_cake.c | 110 ++++++++++++++++++++++++++++---------------
 1 file changed, 73 insertions(+), 37 deletions(-)

diff --git a/net/sched/sch_cake.c b/net/sched/sch_cake.c
index 8e57313..73fc285 100644
--- a/net/sched/sch_cake.c
+++ b/net/sched/sch_cake.c
@@ -697,6 +697,62 @@ static u16 cake_get_flow_quantum(struct cake_tin_data *q,
 		get_random_u16()) >> 16;
 }
 
+static void cake_keys_host_hashes(const struct flow_keys *keys,
+				  u32 *srchost_hash, u32 *dsthost_hash)
+{
+	struct flow_keys host_keys;
+
+	/* flow_hash_from_keys() sorts the addresses by value, so we have
+	 * to preserve their order in a separate data structure to treat
+	 * src and dst host addresses as independently selectable.
+	 */
+	host_keys = *keys;
+	host_keys.ports.ports     = 0;
+	host_keys.basic.ip_proto  = 0;
+	host_keys.keyid.keyid     = 0;
+	host_keys.tags.flow_label = 0;
+
+	switch (host_keys.control.addr_type) {
+	case FLOW_DISSECTOR_KEY_IPV4_ADDRS:
+		host_keys.addrs.v4addrs.src = 0;
+		*dsthost_hash = flow_hash_from_keys(&host_keys);
+		host_keys.addrs.v4addrs.src = keys->addrs.v4addrs.src;
+		host_keys.addrs.v4addrs.dst = 0;
+		*srchost_hash = flow_hash_from_keys(&host_keys);
+		break;
+
+	case FLOW_DISSECTOR_KEY_IPV6_ADDRS:
+		memset(&host_keys.addrs.v6addrs.src, 0,
+		       sizeof(host_keys.addrs.v6addrs.src));
+		*dsthost_hash = flow_hash_from_keys(&host_keys);
+		host_keys.addrs.v6addrs.src = keys->addrs.v6addrs.src;
+		memset(&host_keys.addrs.v6addrs.dst, 0,
+		       sizeof(host_keys.addrs.v6addrs.dst));
+		*srchost_hash = flow_hash_from_keys(&host_keys);
+		break;
+
+	default:
+		*dsthost_hash = 0;
+		*srchost_hash = 0;
+	}
+}
+
+/* The host hashes from the packet itself, for a flow queue being allocated:
+ * the same keys cake_hash() would have dissected (and looked up in conntrack).
+ */
+static void cake_host_hashes(const struct sk_buff *skb, int flow_mode,
+			     u32 *srchost_hash, u32 *dsthost_hash)
+{
+	struct flow_keys keys;
+
+	skb_flow_dissect_flow_keys(skb, &keys,
+				   FLOW_DISSECTOR_F_STOP_AT_FLOW_LABEL);
+	if (flow_mode & CAKE_FLOW_NAT_FLAG)
+		cake_update_flowkeys(&keys, skb);
+
+	cake_keys_host_hashes(&keys, srchost_hash, dsthost_hash);
+}
+
 static u32 cake_hash(struct cake_tin_data *q, const struct sk_buff *skb,
 		     int flow_mode, u16 flow_override, u16 host_override)
 {
@@ -705,8 +761,15 @@ static u32 cake_hash(struct cake_tin_data *q, const struct sk_buff *skb,
 	bool nat_enabled = !!(flow_mode & CAKE_FLOW_NAT_FLAG);
 	u32 flow_hash = 0, srchost_hash = 0, dsthost_hash = 0;
 	u16 reduced_hash, srchost_idx, dsthost_idx;
-	struct flow_keys keys, host_keys;
 	bool use_skbhash = skb->l4_hash;
+	struct flow_keys keys;
+	/* With per-flow queues the queue is found by the flow hash alone: the
+	 * host hashes (two more SipHash runs) are only needed when a queue is
+	 * allocated to a flow, so they wait until then. Host-only modes build
+	 * the flow hash from them, so need them now.
+	 */
+	bool hosts_now = hash_hosts && !(flow_mode & CAKE_FLOW_FLOWS);
+	bool hosts_later = hash_hosts && (flow_mode & CAKE_FLOW_FLOWS);
 
 	if (unlikely(flow_mode == CAKE_FLOW_NONE))
 		return 0;
@@ -715,7 +778,7 @@ static u32 cake_hash(struct cake_tin_data *q, const struct sk_buff *skb,
 	 * disabled, we can skip packet dissection entirely. If nat mode is
 	 * enabled there's another check below after doing the conntrack lookup.
 	 */
-	if ((!hash_flows || (use_skbhash && !nat_enabled)) && !hash_hosts)
+	if ((!hash_flows || (use_skbhash && !nat_enabled)) && !hosts_now)
 		goto skip_hash;
 
 	skb_flow_dissect_flow_keys(skb, &keys,
@@ -728,44 +791,13 @@ static u32 cake_hash(struct cake_tin_data *q, const struct sk_buff *skb,
 	/* If we can still use the SKB hash and don't need the host hash, we can
 	 * skip the rest of the hashing procedure
 	 */
-	if (use_skbhash && !hash_hosts)
+	if (use_skbhash && !hosts_now)
 		goto skip_hash;
 
-	/* flow_hash_from_keys() sorts the addresses by value, so we have
-	 * to preserve their order in a separate data structure to treat
-	 * src and dst host addresses as independently selectable.
-	 */
-	host_keys = keys;
-	host_keys.ports.ports     = 0;
-	host_keys.basic.ip_proto  = 0;
-	host_keys.keyid.keyid     = 0;
-	host_keys.tags.flow_label = 0;
+	if (hosts_now)
+		cake_keys_host_hashes(&keys, &srchost_hash, &dsthost_hash);
 
-	switch (host_keys.control.addr_type) {
-	case FLOW_DISSECTOR_KEY_IPV4_ADDRS:
-		host_keys.addrs.v4addrs.src = 0;
-		dsthost_hash = flow_hash_from_keys(&host_keys);
-		host_keys.addrs.v4addrs.src = keys.addrs.v4addrs.src;
-		host_keys.addrs.v4addrs.dst = 0;
-		srchost_hash = flow_hash_from_keys(&host_keys);
-		break;
-
-	case FLOW_DISSECTOR_KEY_IPV6_ADDRS:
-		memset(&host_keys.addrs.v6addrs.src, 0,
-		       sizeof(host_keys.addrs.v6addrs.src));
-		dsthost_hash = flow_hash_from_keys(&host_keys);
-		host_keys.addrs.v6addrs.src = keys.addrs.v6addrs.src;
-		memset(&host_keys.addrs.v6addrs.dst, 0,
-		       sizeof(host_keys.addrs.v6addrs.dst));
-		srchost_hash = flow_hash_from_keys(&host_keys);
-		break;
-
-	default:
-		dsthost_hash = 0;
-		srchost_hash = 0;
-	}
-
-	/* This *must* be after the above switch, since as a
+	/* This *must* be after cake_keys_host_hashes(), since as a
 	 * side-effect it sorts the src and dst addresses.
 	 */
 	if (hash_flows && !use_skbhash)
@@ -851,6 +883,10 @@ found:
 		reduced_hash = outer_hash + k;
 		q->tags[reduced_hash] = flow_hash;
 
+		if (hosts_later && (allocate_src || allocate_dst))
+			cake_host_hashes(skb, flow_mode, &srchost_hash,
+					 &dsthost_hash);
+
 		if (allocate_src) {
 			srchost_idx = srchost_hash % CAKE_QUEUES;
 			inner_hash = srchost_idx % CAKE_SET_WAYS;
