+	 * the ones before them.
+	 */
+	struct cake_sched_config initial_config;
+	struct cake_heap_entry overflow_heap[CAKE_QUEUES * CAKE_MAX_TINS];
+	/* dscp_restore in besteffort: each queue's last lookup */
+	struct cake_dscp_memo dscp_memo[CAKE_QUEUES];
 };
 
+static_assert(sizeof(struct cake_flow) <= 80);
+#ifdef CONFIG_SMP
+static_assert(offsetof(struct cake_sched_data, last_active) % SMP_CACHE_BYTES == 0);
+static_assert(offsetof(struct cake_sched_data, mq_bytes) % SMP_CACHE_BYTES == 0);
+static_assert(offsetof(struct cake_sched_data, mq_bytes) -
+	      offsetof(struct cake_sched_data, last_active) >= SMP_CACHE_BYTES);
+#endif
+
 enum {
 	CAKE_FLAG_OVERHEAD	   = BIT(0),
 	CAKE_FLAG_AUTORATE_INGRESS = BIT(1),
@@ -284,6 +383,7 @@ enum {
 struct cobalt_skb_cb {
 	ktime_t enqueue_time;
 	u32     adjusted_len;
+	bool	pure_ack;	/* counted in its flow's pure_acks */
 };
 
 static u64 us_to_ns(u64 us)
@@ -308,7 +408,8 @@ static void cobalt_set_enqueue_time(struct sk_buff *skb,
 	get_cobalt_cb(skb)->enqueue_time = now;
 }
 
-static u16 quantum_div[CAKE_QUEUES + 1] = {0};
+/* 65535 / n, filled in once at module init (cake_module_init()) */
+static u16 quantum_div[CAKE_QUEUES + 1] __read_mostly;
 
 /* Diffserv lookup tables */
 
@@ -427,6 +528,101 @@ static void cobalt_vars_init(struct cobalt_vars *vars)
 	memset(vars, 0, sizeof(*vars));
 }
 
+/* COBALT marks ECN-capable packets instead of dropping them. Some senders
+ * (BBR-like ones) answer the marks with CWR yet keep their rate, and their
+ * queue then sits far above target while the flow's count climbs into the
+ * thousands; dropped instead, they slow down. A flow whose packets are
+ * ECT(0), whose count has reached ecn_fail_count and that is still over
+ * twice the target at COBALT_ECN_STRIKES signals in a row, has its ECT(0)
+ * packets dropped from then on, from the drop rate a count of
+ * ecn_fail_count gives, until its count decays to 0 and it is marked again.
+ * Signalled without a break, a flow reaches a count of n in about
+ * 2 * interval * sqrt(n): 8 takes about 0.6 s at the default rtt, plus the
+ * strikes, and a flow that slows down for its marks has had over a dozen by
+ * then and left the queue, ECN or not. A sender that ignores them grows its
+ * queue all that while, and again on each new connection: at a count of 256,
+ * for three seconds. ECT(1) (L4S) is dropped this way only under the L4S
+ * ramp below, and from a longer queue. A GSO packet is dropped whole,
+ * whatever its size, as one from a flow without ECN is: the fastest flows
+ * arrive in the largest GRO packets. 0: always mark, as upstream.
+ */
+#define CAKE_ECN_FAIL_COUNT	8
+static unsigned int ecn_fail_count __read_mostly = CAKE_ECN_FAIL_COUNT;
+module_param(ecn_fail_count, uint, 0644);
+MODULE_PARM_DESC(ecn_fail_count, "COBALT count at which a flow that ignores ECN marks is dropped instead (0: always mark)");
+
+#define COBALT_ECN_STRIKES	8
+
+/* L4S senders (ECT(1)) cut their rate a little for each CE mark, in proportion
+ * to the share of their packets marked. COBALT's marks come only after a whole
+ * interval over target, and then at 1/sqrt(count): far too few for such a
+ * sender, which holds a queue of several targets. CAKE gives each flow its own
+ * queue, so its ECT(1) packets can be marked by their own wait at once, with no
+ * effect on any other flow: never up to l4s_ramp percent of the target, always
+ * from twice that, by a linear ramp between them. It leaves COBALT's state alone.
+ *
+ * It starts at the target and not at the millisecond or so usual for L4S, as
+ * packets reach a router in bursts (a Wi-Fi client's aggregates, a sender's
+ * window) and the end of a burst waits some milliseconds however empty the
+ * queue was: a shallower ramp marks those, and the sender slows down with no
+ * queue to show for it.
+ *
+ * Part of a packet's wait isn't a queue its sender can do anything about: the
+ * ramp starts no lower than twice the time the packet itself takes at its
+ * flow's fair share of the rate (its size at the rate, times the bulk flows),
+ * and a flow's last packet isn't marked. Otherwise a slow link, a GSO batch or
+ * many flows would mark every packet, however little the flow sent.
+ *
+ * A sender that ignores even this is dropped by COBALT once its queue is
+ * twice the ramp's end for a full-size packet (see ecn_fail_count). 0: no ramp
+ * and no such drops: COBALT only marks ECT(1), as upstream.
+ */
+#define CAKE_L4S_RAMP	100
+static unsigned int l4s_ramp __read_mostly = CAKE_L4S_RAMP;
+module_param(l4s_ramp, uint, 0644);
+MODULE_PARM_DESC(l4s_ramp, "Where marking ECT(1) packets CE starts, in percent of CAKE's target (0: no L4S ramp)");
+
+/* where the ramp starts for a packet that takes @own at its flow's share */
+static u64 cake_l4s_start(u64 target, u32 ramp, u64 own)
+{
+	return max_t(u64, div_u64(target * ramp, 100), 2 * own);
+}
+
+static u8 cobalt_ecn(struct sk_buff *skb)
+{
+	switch (skb_protocol(skb, true)) {
+	case cpu_to_be16(ETH_P_IP):
+		if (skb_network_header(skb) + sizeof(struct iphdr) <= skb_tail_pointer(skb))
+			return ipv4_get_dsfield(ip_hdr(skb)) & INET_ECN_MASK;
+		break;
+	case cpu_to_be16(ETH_P_IPV6):
+		if (skb_network_header(skb) + sizeof(struct ipv6hdr) <= skb_tail_pointer(skb))
+			return ipv6_get_dsfield(ipv6_hdr(skb)) & INET_ECN_MASK;
+		break;
+	}
+	return INET_ECN_NOT_ECT;
+}
+
+/* count and its 1/sqrt, set outright rather than stepped to */
+static void cobalt_set_count(struct cobalt_vars *vars, u32 count)
+{
+	vars->count = count;
+	if (count < REC_INV_SQRT_CACHE) {
+		vars->rec_inv_sqrt = inv_sqrt_cache[count];
+		return;
+	}
+	vars->rec_inv_sqrt = div64_u64(1ULL << 32, int_sqrt(count) + 1);
+	cobalt_newton_step(vars);
+	cobalt_newton_step(vars);
+}
+
+/* the flow is marked again once its count has decayed to 0 */
+static void cobalt_ecn_reset(struct cobalt_vars *vars)
+{
+	vars->ecn_strikes = 0;
+	vars->ecn_ignored = false;
+}
+
 /* CoDel control_law is t + interval/sqrt(count)
  * We maintain in rec_inv_sqrt the reciprocal value of sqrt(count) to avoid
  * both sqrt() and divide operation.
@@ -439,6 +635,68 @@ static ktime_t cobalt_control(ktime_t t,
 						rec_inv_sqrt));
 }
 
+/* The time COBALT's count takes to step down from @from to @to (0 < @to <
+ * @from) as cobalt_should_drop() steps it, interval / sqrt(c) for each c
+ * from @from - 1 down to @to: 2 * interval * (sqrt(from) - sqrt(to)), plus
+ * half a step at @to's end and less half a step at @from's. The Newton
+ * step's rounding makes a step at c longer by about c / 2^34 of itself,
+ * reciprocal_scale()'s rounding about half a nanosecond shorter. @r_from
+ * and @r_to are the square roots * 65536.
+ */
+static u64 cobalt_decay_time(u64 interval, u32 from, u32 to, u64 r_from, u64 r_to)
+{
+	u64 t = mul_u64_u64_div_u64(interval, 2 * (r_from - r_to), 1 << 16);
+
+	t += div64_u64(interval << 15, r_to) - div64_u64(interval << 15, r_from);
+	t += mul_u64_u64_div_u64(interval, (u64)from * r_from - (u64)to * r_to,
+				 3ULL << 49);
+	return t - min_t(u64, t, (from - to) / 2);
+}
+
+/* COBALT's count steps down once for each interval / sqrt(count) a flow
+ * was away (cobalt_should_drop()): one back after a long pause with a large
+ * count would take as many steps in one dequeue as it has counts to lose,
+ * however many that is. Past a few dozen, the count jumps instead to where
+ * the steps would take it in @elapsed (now - drop_next), by the time they
+ * take (cobalt_decay_time()), two steps short and with a quarter of a step
+ * to spare so as never to go further, and the steps go on from there: at
+ * most about 66 of them. A pause longer than the whole decay jumps to 66.
+ *
+ * Where the steps get to is found by halving: the lowest count from 64 up
+ * whose steps down from @count fit in @elapsed. However large the count, it
+ * takes at most 32 halvings, and the count it finds always fits. Worked out
+ * with Newton's method from 2 * interval * (sqrt(count) - sqrt(to)), as it
+ * was, it stopped short of its target from a count of about 15 million on,
+ * past which the steps' rounding takes longer than that leaves out: it
+ * either went on short of it, millions of steps on, or never jumped and left
+ * them all. @interval as cobalt_control() takes it.
