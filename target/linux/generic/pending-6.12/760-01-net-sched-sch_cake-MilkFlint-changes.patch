+	/* cake_mq: the bulk rotation's flows, each 65535 / its host load */
+	u32	mq_weight;
 	u16	flow_quantum;
+	/* what a bulk flow's host gets back per pass: cake_set_bulk_quantum() */
+	u16	bulk_quantum;
 
 	struct cobalt_params cparams;
 	u32	drop_overlimit;
@@ -166,8 +209,14 @@ struct cake_tin_data {
 	u32	max_skblen;
 
 	struct list_head new_flows;
-	struct list_head old_flows;
+	/* empty flows whose AQM state is still decaying, visited one a dequeue */
 	struct list_head decaying_flows;
