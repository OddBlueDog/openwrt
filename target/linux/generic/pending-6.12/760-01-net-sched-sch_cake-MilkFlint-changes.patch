+/* The resting flows whose time is up leave the flowchain, two at most each
+ * time: they're in about the order their times are up, and one that's a
+ * little out of order waits for the one ahead of it
+ */
+static void cake_expire_resting(struct cake_tin_data *b, ktime_t now)
+{
+	struct cake_flow *flow;
+	int i;
+
+	for (i = 0; i < 2 && !list_empty(&b->resting_flows); i++) {
+		flow = list_first_entry(&b->resting_flows, struct cake_flow,
+					flowchain);
+		if (ktime_before(now, flow->cvars.drop_next))
+			return;
+		list_del_init(&flow->flowchain);
+		flow->set = CAKE_SET_NONE;
+		b->decaying_flow_count--;
+	}
+}
