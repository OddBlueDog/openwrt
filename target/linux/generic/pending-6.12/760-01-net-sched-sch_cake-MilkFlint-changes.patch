+ * CAKE_DSCP_KEEP_TICKS (about 100 ms) for a slower flow, instead of one a
+ * packet. A DSCP the other end changes reaches the flow's packets that
+ * much later; a lookup that finds no connection isn't kept.
+ */
+#define CAKE_DSCP_KEEP		32
+#define CAKE_DSCP_KEEP_SHIFT	20
+#define CAKE_DSCP_KEEP_TICKS	96
