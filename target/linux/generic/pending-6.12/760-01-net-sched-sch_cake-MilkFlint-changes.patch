+		return next;
+	/* Cap before scaling so the 128-by-64 quotient never exceeds 64 bits */
+	if (old > share && (u64)left > mul_u64_u64_div_u64(NSEC_PER_SEC, share, old))
+		return ktime_add_ns(now, NSEC_PER_SEC);
+	return ktime_add_ns(now, min_t(u64, mul_u64_u64_div_u64(left, old, share),
+				       NSEC_PER_SEC));
