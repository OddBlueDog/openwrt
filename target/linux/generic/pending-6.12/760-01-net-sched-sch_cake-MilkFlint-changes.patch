+/* cake_mq: retire a tin's bulk rotation, every flow in it empty, as the
+ * next dequeue would find each one
+ */
+static void cake_mq_retire_tin(struct cake_sched_data *q,
+			       struct cake_tin_data *b, ktime_t now)
+{
+	struct cake_flow *flow;
+
+	while ((flow = cake_bulk_head(b))) {
+		if (flow->head)
+			break;
+		cake_flow_emptied(q, b, flow, now);
+	}
+}
