+ * far ahead, and one sent at a larger share must not keep its short wait
+ * (that would let a share that moves up and down send at the higher one).
+ * A second at most: the sub-cake wakes within CAKE_MQ_TAU anyway
+ * (cake_mq_wake_by()) and works it out again.
+ */
+static ktime_t cake_mq_rescale_wait(ktime_t next, ktime_t now, u64 old, u64 share)
+{
+	s64 left = ktime_to_ns(ktime_sub(next, now));
