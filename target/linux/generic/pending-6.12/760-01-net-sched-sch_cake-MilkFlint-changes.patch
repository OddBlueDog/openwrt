 	u32		fwmark_mask;
-	u16		fwmark_shft;
 	s16		rate_overhead;
 	u16		rate_mpu;
 	u16		rate_flags;
@@ -221,9 +275,6 @@ struct cake_sched_data {
 	struct tcf_block *block;
