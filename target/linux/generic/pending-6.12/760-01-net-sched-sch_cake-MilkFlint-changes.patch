+/* How far down a tin's new flows cake_sparse_ahead() looks */
+#define CAKE_AHEAD_LOOK 8
+
+/* sparse_ahead_us: the flow whose packet goes now, with the shaper due to
+ * let one go in @left ns. From the highest tin (in priority order, tin_order),
+ * the new flow it would serve next: past those on their way out of the new
+ * flows, out of packets or of deficit, which its next look at them would let
+ * go (a few at most). Only if its packet came in through a device's ingress.
+ * Selects it for cake_dequeue_one().
+ */
+static struct cake_flow *cake_sparse_ahead(struct cake_sched_data *q, u64 left)
+{
+	u32 ahead = READ_ONCE(sparse_ahead_us);
+	int i;
+
+	if (likely(!ahead) || left > (u64)ahead * NSEC_PER_USEC)
+		return NULL;
+	for (i = q->tin_cnt - 1; i >= 0; i--) {
+		int tin = q->tin_order ? q->tin_order[i] : i;
+		struct cake_tin_data *b = &q->tins[tin];
+		struct cake_flow *flow;
+		int n = 0;
+
+		list_for_each_entry(flow, &b->new_flows, flowchain) {
+			if (++n > CAKE_AHEAD_LOOK)
+				break;
+			if (!flow->head || flow->deficit <= 0)
+				continue;
+			if (!cake_redirected_from_ingress(flow->head))
+				break;
+			q->cur_tin = tin;
+			q->cur_flow = flow - b->flows;
+			return flow;
+		}
+	}
+	return NULL;
+}
