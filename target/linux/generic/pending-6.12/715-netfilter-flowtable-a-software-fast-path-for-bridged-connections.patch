+/* An address that moves to another port ends the flows towards it, one
+ * that's learnt again on the same port doesn't; one that goes from the
+ * flow's egress port ends them, from another port doesn't; either
+ * direction's destination counts; another namespace's fdb doesn't;
+ * overflowing the batch ends every flow
+ */
+static void nf_flow_bridge_test_fdb_changes(struct kunit *test)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	struct nf_flow_bridge_fdb_batch *all;
+	struct flow_offload *flow;
+
+	KUNIT_EXPECT_TRUE(test, nf_flow_bridge_test_fdb(test, nf_flow_bridge_test_b, 2, false, &init_net));
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_test_fdb(test, nf_flow_bridge_test_b, 1, false, &init_net));
+	KUNIT_EXPECT_TRUE(test, nf_flow_bridge_test_fdb(test, nf_flow_bridge_test_b, 1, true, &init_net));
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_test_fdb(test, nf_flow_bridge_test_b, 2, true, &init_net));
+	KUNIT_EXPECT_TRUE(test, nf_flow_bridge_test_fdb(test, nf_flow_bridge_test_a, 2, false, &init_net));
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_test_fdb(test, nf_flow_bridge_test_r, 2, false, &init_net));
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_test_fdb(test, nf_flow_bridge_test_b, 2, false,
+							 (struct net *)&ctx->table));
+
+	all = kunit_kzalloc(test, sizeof(*all), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, all);
+	all->overflow = true;
+	flow = nf_flow_bridge_test_flow(test, (struct nf_flow_bridge_test_pkt){ .sport = 42000 });
+	nf_flow_bridge_fdb_flow(&ctx->ft.data, flow, all);
+	KUNIT_EXPECT_TRUE(test, nf_flow_bridge_test_torn_down(flow));
+}
