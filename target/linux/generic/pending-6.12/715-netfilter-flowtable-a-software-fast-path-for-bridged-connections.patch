+
+	KUNIT_ASSERT_EQ(test, nf_flow_bridge_tuple(skb, ctx->dev[0], &tuple, &thoff), 0);
+	KUNIT_EXPECT_EQ(test, tuple.src_v4.s_addr, NF_FLOW_BRIDGE_TEST_IP_A);
+	KUNIT_EXPECT_EQ(test, tuple.dst_v4.s_addr, NF_FLOW_BRIDGE_TEST_IP_B);
+	KUNIT_EXPECT_EQ(test, tuple.src_port, htons(40000));
