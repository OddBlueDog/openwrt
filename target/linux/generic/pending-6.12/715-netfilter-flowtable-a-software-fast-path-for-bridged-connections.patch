+/* The connection as the bridge forwarded a packet of it from port 0 (A) to
+ * port 1 (B), offloaded
+ */
+static struct flow_offload *nf_flow_bridge_test_flow(struct kunit *test,
+						     struct nf_flow_bridge_test_pkt pkt)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	struct flow_offload *flow;
+	struct sk_buff *skb;
+
+	pkt.src = nf_flow_bridge_test_a;
+	pkt.dst = nf_flow_bridge_test_b;
+	skb = nf_flow_bridge_test_skb(test, ctx->dev[0], &pkt);
+	flow = nf_flow_bridge_test_flow_alloc(nf_flow_bridge_test_ct(test, &pkt), skb,
+					      ctx->dev[0], ctx->dev[1], IP_CT_DIR_ORIGINAL);
+	if (!flow)
+		KUNIT_FAIL_AND_ABORT(test, "the test flow wasn't made");
+	if (flow_offload_add(&ctx->ft.data, flow) < 0) {
+		flow_offload_free(flow);
+		KUNIT_FAIL_AND_ABORT(test, "the test flow wasn't added");
+	}
+	return flow;
+}
