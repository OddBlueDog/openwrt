+/* A flow table of this type refuses hardware offload; without it, it has
+ * its hook and gives it back
+ */
+static void nf_flow_bridge_test_table(struct kunit *test)
+{
+	struct nft_flowtable *ft = kunit_kzalloc(test, sizeof(*ft), GFP_KERNEL);
+	struct nft_table *table = kunit_kzalloc(test, sizeof(*table), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, ft);
+	KUNIT_ASSERT_NOT_NULL(test, table);
+	ft->table = table;
+	ft->data.type = &flowtable_bridge;
