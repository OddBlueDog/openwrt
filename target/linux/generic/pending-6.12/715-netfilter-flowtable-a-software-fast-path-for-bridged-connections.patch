+/* A new flow takes the ports and addresses of the forwarded packet in its
+ * direction and the other way round in the other, sends both directions
+ * as they come, and is a bridge flow
+ */
+static void nf_flow_bridge_test_flow_fills(struct kunit *test)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	struct flow_offload *flow = nf_flow_bridge_test_flow(test,
+				(struct nf_flow_bridge_test_pkt){});
+	struct flow_offload_tuple *t = &flow->tuplehash[FLOW_OFFLOAD_DIR_ORIGINAL].tuple;
+	struct flow_offload_tuple *r = &flow->tuplehash[FLOW_OFFLOAD_DIR_REPLY].tuple;
+
+	KUNIT_EXPECT_EQ(test, flow->type, NF_FLOW_OFFLOAD_BRIDGE);
+
+	KUNIT_EXPECT_EQ(test, t->iifidx, ctx->dev[0]->ifindex);
+	KUNIT_EXPECT_EQ(test, t->out.ifidx, ctx->dev[1]->ifindex);
+	KUNIT_EXPECT_TRUE(test, ether_addr_equal(t->out.h_source, nf_flow_bridge_test_a));
+	KUNIT_EXPECT_TRUE(test, ether_addr_equal(t->out.h_dest, nf_flow_bridge_test_b));
+	KUNIT_EXPECT_EQ(test, (int)t->xmit_type, FLOW_OFFLOAD_XMIT_DIRECT);
+	KUNIT_EXPECT_EQ(test, t->mtu, ETH_DATA_LEN);
+	KUNIT_EXPECT_EQ(test, (int)t->encap_num, 0);
+	KUNIT_EXPECT_LE(test, nf_flowtable_time_stamp - t->out.br_checked, 1);
+
+	KUNIT_EXPECT_EQ(test, r->iifidx, ctx->dev[1]->ifindex);
+	KUNIT_EXPECT_EQ(test, r->out.ifidx, ctx->dev[0]->ifindex);
+	KUNIT_EXPECT_TRUE(test, ether_addr_equal(r->out.h_source, nf_flow_bridge_test_b));
+	KUNIT_EXPECT_TRUE(test, ether_addr_equal(r->out.h_dest, nf_flow_bridge_test_a));
+	KUNIT_EXPECT_EQ(test, (int)r->xmit_type, FLOW_OFFLOAD_XMIT_DIRECT);
+	KUNIT_EXPECT_EQ(test, (int)r->encap_num, 0);
+}
