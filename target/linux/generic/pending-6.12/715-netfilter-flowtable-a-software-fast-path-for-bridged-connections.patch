+static void nf_flow_bridge_test_not_ip(struct sk_buff *skb, struct nf_conn *ct)
+{
+	skb->protocol = htons(ETH_P_PPP_SES);
+}
+
+/* No flow from what the fast path couldn't do as the bridge does: NAT,
+ * GRE, a hairpin, a tagged or non-IP frame, VLAN filtering, ports that
+ * don't forward or are locked, two bridges, a device that isn't a port, a
+ * multicast or broadcast destination, a frame the fdb doesn't send there
+ * (flooded) or from a source it has elsewhere
+ */
+static void nf_flow_bridge_test_flow_rejects(struct kunit *test)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	struct net_device *a = ctx->dev[0], *b = ctx->dev[1];
+	struct nf_flow_bridge_test_pkt pkt = {};
+
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, nf_flow_bridge_test_snat);
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, nf_flow_bridge_test_dnat);
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, a, NULL);
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, nf_flow_bridge_test_tag);
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, nf_flow_bridge_test_not_ip);
+
+	pkt.l4proto = IPPROTO_GRE;
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	pkt.l4proto = 0;
+
+	__set_bit(BROPT_VLAN_ENABLED, &ctx->br->options);
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	__clear_bit(BROPT_VLAN_ENABLED, &ctx->br->options);
+
+	ctx->port[0]->state = BR_STATE_LEARNING;
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	ctx->port[0]->state = BR_STATE_FORWARDING;
+	ctx->port[1]->state = BR_STATE_BLOCKING;
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	ctx->port[1]->state = BR_STATE_FORWARDING;
+
+	ctx->port[0]->flags = BR_PORT_LOCKED;
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	ctx->port[0]->flags = 0;
+	ctx->port[1]->flags = BR_PORT_MAB;
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	ctx->port[1]->flags = 0;
+
+	ctx->port[1]->br = ctx->other_br;
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	ctx->port[1]->br = ctx->br;
+
+	b->priv_flags &= ~IFF_BRIDGE_PORT;
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	b->priv_flags |= IFF_BRIDGE_PORT;
+
+	pkt.dst = nf_flow_bridge_test_mcast;
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	pkt.dst = (const u8 *)"\xff\xff\xff\xff\xff\xff";
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	pkt.dst = NULL;
+
+	/* the copy a flooded frame sends to port 1, B being behind port 2 */
+	ctx->fdb_b = ctx->port[2];
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	ctx->fdb_b = NULL;
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	ctx->fdb_b = ctx->port[1];
+
+	ctx->fdb_a = ctx->port[2];
+	nf_flow_bridge_test_expect_no_flow(test, pkt, a, b, NULL);
+	ctx->fdb_a = ctx->port[0];
+}
