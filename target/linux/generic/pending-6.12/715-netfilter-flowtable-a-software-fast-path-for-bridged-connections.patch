--- /dev/null
+++ b/net/bridge/netfilter/nf_flow_table_bridge.c
@@ -0,0 +1,669 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* The bridge's flow table: a software fast path for the connections a
+ * bridge forwards from one of its ports to another.
+ *
+ * nft_flow_offload adds a connection to it from a bridge forward chain
+ * ("flow add @ft", with bridge conntrack). Its frames are then taken at the
+ * bridge's prerouting hook, as soon as the bridge has received them on a
+ * port, and sent on as they came to the port the bridge sent the
+ * connection's frames to: a bridge doesn't rewrite a frame, so neither does
+ * the fast path (no TTL or hop limit change, no new MAC header). What they
+ * skip is the rest of the bridge's way (learning, the fdb lookup, its
+ * forward and postrouting hooks) and conntrack.
+ *
+ * Only what the fast path does exactly what the bridge would is taken:
+ * untagged IPv4 and IPv6 TCP and UDP, without IPv4 options, fragments or
+ * IPv6 extension headers, on a bridge that doesn't filter VLANs, between
+ * two of its ports that forward (STP), aren't locked (802.1X, MAB) and
+ * aren't isolated from each other, to an address the fdb has on the egress
+ * port. A frame takes it only with the ingress port and both MAC addresses
+ * of its flow: one connection can cross a bridge more than once (a router
+ * behind it routing between two subnets that are both on the bridge), and
+ * each crossing has frames of its own, which go the bridge's way. The port
+ * and the bridge are checked again on every frame, so one that stops
+ * forwarding, leaves the bridge or starts filtering VLANs stops the fast
+ * path at once.
+ *
+ * When the fdb moves an address to another port (a client roamed to another
+ * access point) or drops it, the flows towards it go at once: the bridge
+ * tells switchdev of every fdb change, with or without hardware under the
+ * ports. About once a second each direction of a flow also sends a frame
+ * the bridge's own way. The bridge then keeps learning both addresses, so
+ * their fdb entries don't age out under a busy flow, and nft_flow_offload
+ * shows that frame to nf_flow_bridge_flow_check(): a flow the bridge no
+ * longer sends to the same port is torn down there too. A connection whose
+ * flow went makes a new one with its next frames.
+ *
+ * The fast path hooks the bridge's prerouting, so a flow table of this type
+ * covers every bridge of its network namespace and needs no devices; the
+ * rules choose what goes into it. There's no hardware offload: a flow table
+ * of this type with "flags offload" is refused.
+ */
+#include <linux/etherdevice.h>
+#include <linux/if_vlan.h>
+#include <linux/init.h>
+#include <linux/ip.h>
+#include <linux/ipv6.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/netfilter.h>
+#include <linux/netfilter_bridge.h>
+#include <linux/rhashtable.h>
+#include <linux/tcp.h>
+#include <linux/udp.h>
+#include <kunit/static_stub.h>
+#include <net/ip.h>
+#include <net/netfilter/nf_conntrack_acct.h>
+#include <net/netfilter/nf_flow_table.h>
+#include <net/netfilter/nf_tables.h>
+#include <net/switchdev.h>
+
+#include "../br_private.h"
+
+/* Before conntrack (-200), after "raw" chains (-300) */
+#define NF_FLOW_BRIDGE_PRIORITY	(NF_BR_PRI_FILTER_BRIDGED - 1)
+
+/* The prerouting hook of each flow table of this type */
+struct nf_flow_bridge {
+	struct list_head	list;
+	struct nf_flowtable	*flowtable;
+	struct nf_hook_ops	ops;
+};
+
+static LIST_HEAD(nf_flow_bridge_list);
+static DEFINE_MUTEX(nf_flow_bridge_mutex);
+
+/* The key of the flow an untagged IPv4 or IPv6 TCP or UDP packet belongs
+ * to, as it arrived on @in (skb->data at its network header), and where its
+ * transport header starts. Unlike the routed fast path's, any TTL or hop
+ * limit: a bridge doesn't look at them.
+ */
+static int nf_flow_bridge_tuple(struct sk_buff *skb, const struct net_device *in,
+				struct flow_offload_tuple *tuple,
+				unsigned int *thoff)
+{
+	struct flow_ports *ports;
+	unsigned int hdrsize;
+	u8 l4proto;
+
+	if (skb_network_offset(skb))
+		return -1;
+
+	switch (skb->protocol) {
+	case htons(ETH_P_IP): {
+		const struct iphdr *iph;
+
+		if (!pskb_may_pull(skb, sizeof(*iph)))
+			return -1;
+
+		iph = ip_hdr(skb);
+		if (iph->ihl != 5 || ip_is_fragment(iph))
+			return -1;
+
+		l4proto = iph->protocol;
+		*thoff = sizeof(*iph);
+		break;
+	}
+	case htons(ETH_P_IPV6):
+		if (!pskb_may_pull(skb, sizeof(struct ipv6hdr)))
+			return -1;
+
+		l4proto = ipv6_hdr(skb)->nexthdr;
+		*thoff = sizeof(struct ipv6hdr);
+		break;
+	default:
+		return -1;
+	}
+
+	switch (l4proto) {
+	case IPPROTO_TCP:
+		hdrsize = sizeof(struct tcphdr);
+		break;
+	case IPPROTO_UDP:
+		hdrsize = sizeof(struct udphdr);
+		break;
+	default:
+		return -1;
+	}
+
+	if (!pskb_may_pull(skb, *thoff + hdrsize))
+		return -1;
+
+	if (skb->protocol == htons(ETH_P_IP)) {
+		const struct iphdr *iph = ip_hdr(skb);
+
+		tuple->src_v4.s_addr	= iph->saddr;
+		tuple->dst_v4.s_addr	= iph->daddr;
+		tuple->l3proto		= AF_INET;
+	} else {
+		const struct ipv6hdr *ip6h = ipv6_hdr(skb);
+
+		tuple->src_v6		= ip6h->saddr;
+		tuple->dst_v6		= ip6h->daddr;
+		tuple->l3proto		= AF_INET6;
+	}
+
+	ports = (struct flow_ports *)(skb_network_header(skb) + *thoff);
+	tuple->src_port		= ports->source;
+	tuple->dst_port		= ports->dest;
+	tuple->l4proto		= l4proto;
+	tuple->iifidx		= in->ifindex;
+
+	return 0;
+}
+
+/* @dev's bridge port, or NULL if it isn't one (any more) */
+static struct net_bridge_port *nf_flow_bridge_port(const struct net_device *dev)
+{
+	return netif_is_bridge_port(dev) ? br_port_get_rcu(dev) : NULL;
+}
+
+/* Frames may take the fast path from @p: it forwards (STP), isn't locked
+ * (802.1X, MAB: the bridge checks the source of each frame), and its bridge
+ * doesn't filter VLANs (a frame's VLAN is then the ports' business, which
+ * the fast path doesn't follow).
+ */
+static bool nf_flow_bridge_port_ok(const struct net_bridge_port *p)
+{
+	return p && p->state == BR_STATE_FORWARDING &&
+	       !(p->flags & (BR_PORT_LOCKED | BR_PORT_MAB)) &&
+	       !br_opt_get(p->br, BROPT_VLAN_ENABLED);
+}
+
+/* ... and the bridge sends them from @p on @q: another port of the same
+ * bridge that forwards, not isolated from @p
+ */
+static bool nf_flow_bridge_ports_ok(const struct net_bridge_port *p,
+				    const struct net_bridge_port *q)
+{
+	return q && q != p && q->br == p->br &&
+	       q->state == BR_STATE_FORWARDING &&
+	       !(p->flags & q->flags & BR_ISOLATED);
+}
+
+/* The port the fdb of @br (no VLAN filtering) has @addr on */
+static struct net_bridge_port *nf_flow_bridge_fdb_port(struct net_bridge *br,
+							const unsigned char *addr)
+{
+	struct net_bridge_fdb_entry *f;
+
+	KUNIT_STATIC_STUB_REDIRECT(nf_flow_bridge_fdb_port, br, addr);
+
+	f = br_fdb_find_rcu(br, addr, 0);
+	return f ? READ_ONCE(f->dst) : NULL;
+}
+
+static struct net_device *nf_flow_bridge_dev(struct net *net, int ifindex)
+{
+	KUNIT_STATIC_STUB_REDIRECT(nf_flow_bridge_dev, net, ifindex);
+
+	return dev_get_by_index_rcu(net, ifindex);
+}
+
+/* nf_tables stops a dormant table's hooks; this one is the bridge's */
+static bool nf_flow_bridge_dormant(const struct nf_flowtable *flowtable)
+{
+	const struct nft_flowtable *ft =
+		container_of(flowtable, struct nft_flowtable, data);
+
+	return ft->table->flags & NFT_TABLE_F_DORMANT;
+}
+
+/* A TCP FIN or RST: the connection is closing, the rest goes the slow way */
+static bool nf_flow_bridge_closing(const struct sk_buff *skb, u8 l4proto,
+				   unsigned int thoff)
+{
+	const struct tcphdr *tcph;
+
+	if (l4proto != IPPROTO_TCP)
+		return false;
+
+	tcph = (const struct tcphdr *)(skb_network_header(skb) + thoff);
+	return tcph->fin || tcph->rst;
+}
+
+/* What the bridge would send on @dev: no bigger than its MTU, or GSO, and
+ * not LRO (__br_forward() drops it, with a warning)
+ */
+static bool nf_flow_bridge_fits(const struct sk_buff *skb,
+				const struct net_device *dev)
+{
+	const struct skb_shared_info *shinfo = skb_shinfo(skb);
+
+	if (unlikely(shinfo->gso_size && !shinfo->gso_type))
+		return false;
+
+	return skb->len <= dev->mtu || skb_is_gso(skb);
+}
+
+static void nf_flow_bridge_queue(struct sk_buff *skb)
+{
+	KUNIT_STATIC_STUB_REDIRECT(nf_flow_bridge_queue, skb);
+
+	dev_queue_xmit(skb);
+}
+
+/* The frame as it came, on @dev, as the bridge sends one it forwards */
+static void nf_flow_bridge_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	skb_push(skb, ETH_HLEN);
+	skb->dev = dev;
+	skb_forward_csum(skb);
+	skb_clear_tstamp(skb);
+#ifdef CONFIG_NET_SWITCHDEV
+	skb->offload_fwd_mark = 0;
+#endif
+	nf_flow_bridge_queue(skb);
+}
+
+static unsigned int nf_flow_bridge_hook(void *priv, struct sk_buff *skb,
+					const struct nf_hook_state *state)
+{
+	struct flow_offload_tuple_rhash *tuplehash;
+	struct nf_flowtable *flowtable = priv;
+	struct flow_offload_tuple tuple = {};
+	struct net_bridge_port *p, *q;
+	enum flow_offload_tuple_dir dir;
+	struct flow_offload_tuple *t;
+	struct flow_offload *flow;
+	struct net_device *outdev;
+	const struct ethhdr *eth;
+	unsigned int thoff;
+	u32 now;
+
+	if (skb_vlan_tag_present(skb) ||
+	    nf_flow_bridge_tuple(skb, state->in, &tuple, &thoff) < 0)
+		return NF_ACCEPT;
+
+	p = nf_flow_bridge_port(state->in);
+	if (!nf_flow_bridge_port_ok(p))
+		return NF_ACCEPT;
+
+	tuplehash = flow_offload_lookup(flowtable, &tuple);
+	if (!tuplehash || nf_flow_bridge_dormant(flowtable))
+		return NF_ACCEPT;
+
+	dir = tuplehash->tuple.dir;
+	flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
+	t = &tuplehash->tuple;
+
+	/* the same connection crossing the bridge another way */
+	eth = eth_hdr(skb);
+	if (!ether_addr_equal(eth->h_dest, t->out.h_dest) ||
+	    !ether_addr_equal(eth->h_source, t->out.h_source))
+		return NF_ACCEPT;
+
+	outdev = nf_flow_bridge_dev(state->net, t->out.ifidx);
+	q = outdev ? nf_flow_bridge_port(outdev) : NULL;
+	if (!nf_flow_bridge_ports_ok(p, q) ||
+	    nf_flow_bridge_closing(skb, t->l4proto, thoff)) {
+		flow_offload_teardown(flow);
+		return NF_ACCEPT;
+	}
+
+	flow_offload_refresh(flowtable, flow, false);
+
+	/* about once a second, the bridge's way (see the top) */
+	now = nf_flowtable_time_stamp;
+	if (now - READ_ONCE(t->out.br_checked) >= HZ) {
+		WRITE_ONCE(t->out.br_checked, now);
+		return NF_ACCEPT;
+	}
+
+	if (unlikely(!nf_flow_bridge_fits(skb, outdev)))
+		return NF_ACCEPT;
+
+	if (flowtable->flags & NF_FLOWTABLE_COUNTER)
+		nf_ct_acct_update(flow->ct, dir, skb->len);
+
+	nf_flow_bridge_xmit(skb, outdev);
+
+	return NF_STOLEN;
+}
+
+/* A new flow, from the connection's packet in the bridge's forward hook
+ * (from the port it came on to the one the bridge sends it on, as it will
+ * leave): the fast path takes the rest of its direction from that ingress
+ * port with these addresses to that egress port, and the other direction
+ * the other way round. NULL, before anything is allocated, for a packet
+ * whose connection can't have one.
+ */
+static struct flow_offload *nf_flow_bridge_flow_alloc(struct nf_conn *ct,
+						      const struct nft_pktinfo *pkt,
+						      enum ip_conntrack_dir dir)
+{
+	const struct net_device *in = nft_in(pkt), *out = nft_out(pkt);
+	u8 l4proto = nf_ct_protonum(ct);
+	const struct sk_buff *skb = pkt->skb;
+	struct flow_offload_tuple *t, *r;
+	struct net_bridge_port *p, *q;
+	struct flow_offload *flow;
+	const struct ethhdr *eth;
+	u32 now;
+
+	if ((l4proto != IPPROTO_TCP && l4proto != IPPROTO_UDP) ||
+	    ct->status & IPS_NAT_MASK)
+		return NULL;
+
+	if (!in || !out || skb_vlan_tag_present(skb) ||
+	    (skb->protocol != htons(ETH_P_IP) &&
+	     skb->protocol != htons(ETH_P_IPV6)))
+		return NULL;
+
+	p = nf_flow_bridge_port(in);
+	q = nf_flow_bridge_port(out);
+	if (!nf_flow_bridge_port_ok(p) || !nf_flow_bridge_port_ok(q) ||
+	    !nf_flow_bridge_ports_ok(p, q))
+		return NULL;
+
+	/* a unicast frame the fdb sends there, not a flooded copy */
+	eth = eth_hdr(skb);
+	if (!is_valid_ether_addr(eth->h_source) ||
+	    !is_valid_ether_addr(eth->h_dest) ||
+	    nf_flow_bridge_fdb_port(p->br, eth->h_dest) != q ||
+	    nf_flow_bridge_fdb_port(p->br, eth->h_source) != p)
+		return NULL;
+
+	flow = flow_offload_alloc(ct);
+	if (!flow)
+		return NULL;
+
+	t = &flow->tuplehash[dir].tuple;
+	r = &flow->tuplehash[!dir].tuple;
+	now = nf_flowtable_time_stamp;
+
+	t->iifidx = in->ifindex;
+	t->mtu = out->mtu;
+	t->xmit_type = FLOW_OFFLOAD_XMIT_DIRECT;
+	t->out.ifidx = out->ifindex;
+	t->out.br_checked = now;
+	ether_addr_copy(t->out.h_source, eth->h_source);
+	ether_addr_copy(t->out.h_dest, eth->h_dest);
+
+	r->iifidx = out->ifindex;
+	r->mtu = in->mtu;
+	r->xmit_type = FLOW_OFFLOAD_XMIT_DIRECT;
+	r->out.ifidx = in->ifindex;
+	r->out.br_checked = now;
+	ether_addr_copy(r->out.h_source, eth->h_dest);
+	ether_addr_copy(r->out.h_dest, eth->h_source);
+
+	flow->type = NF_FLOW_OFFLOAD_BRIDGE;
+
+	return flow;
+}
+
+/* A packet of a connection that already has a flow, in the bridge's forward
+ * hook: the fast path's frame of a second, or one it left to the bridge.
+ * If the bridge now sends this direction's frames to another port, the
+ * flow goes.
+ */
+static void nf_flow_bridge_flow_check(struct nf_flowtable *flowtable,
+				      const struct nft_pktinfo *pkt)
+{
+	const struct net_device *in = nft_in(pkt), *out = nft_out(pkt);
+	struct flow_offload_tuple_rhash *tuplehash;
+	struct flow_offload_tuple tuple = {};
+	const struct flow_offload_tuple *t;
+	enum flow_offload_tuple_dir dir;
+	struct sk_buff *skb = pkt->skb;
+	const struct ethhdr *eth;
+	unsigned int thoff;
+
+	if (!in || !out || skb_vlan_tag_present(skb) ||
+	    nf_flow_bridge_tuple(skb, in, &tuple, &thoff) < 0)
+		return;
+
+	tuplehash = flow_offload_lookup(flowtable, &tuple);
+	if (!tuplehash)
+		return;
+
+	t = &tuplehash->tuple;
+	dir = t->dir;
+	eth = eth_hdr(skb);
+	if (ether_addr_equal(eth->h_dest, t->out.h_dest) &&
+	    ether_addr_equal(eth->h_source, t->out.h_source) &&
+	    t->out.ifidx != out->ifindex)
+		flow_offload_teardown(container_of(tuplehash, struct flow_offload,
+						   tuplehash[dir]));
+}
+
+/* Where the fdb now has an address: on a port it moved to, or no longer on
+ * the port it went from. The bridge tells switchdev of each (learnt, moved,
+ * aged out or deleted, with or without hardware under the port), and the
+ * flows towards that address the change concerns go at once, without
+ * waiting for their next frame through the bridge.
+ */
+struct nf_flow_bridge_fdb {
+	u8		addr[ETH_ALEN];
+	int		ifindex;
+	bool		gone;
+	possible_net_t	net;
+};
+
+#define NF_FLOW_BRIDGE_FDB_MAX	32
+
+/* changes waiting for the work; past the limit, every flow goes */
+struct nf_flow_bridge_fdb_batch {
+	unsigned int			n;
+	bool				overflow;
+	struct nf_flow_bridge_fdb	changes[NF_FLOW_BRIDGE_FDB_MAX];
+};
+
+static atomic_t nf_flow_bridge_tables = ATOMIC_INIT(0);
+static DEFINE_SPINLOCK(nf_flow_bridge_fdb_lock);
+static struct nf_flow_bridge_fdb_batch nf_flow_bridge_fdb_pending;
+static struct work_struct nf_flow_bridge_fdb_work;
+
+static void nf_flow_bridge_fdb_flow(struct nf_flowtable *flowtable,
+				    struct flow_offload *flow, void *data)
+{
+	const struct nf_flow_bridge_fdb_batch *batch = data;
+	const struct net *net = read_pnet(&flowtable->net);
+	int dir;
+	u32 i;
+
+	if (batch->overflow) {
+		flow_offload_teardown(flow);
+		return;
+	}
+
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		const struct flow_offload_tuple *t = &flow->tuplehash[dir].tuple;
+
+		for (i = 0; i < batch->n; i++) {
+			const struct nf_flow_bridge_fdb *c = &batch->changes[i];
+
+			if (!net_eq(read_pnet(&c->net), net) ||
+			    !ether_addr_equal(t->out.h_dest, c->addr))
+				continue;
+			if (c->gone ? t->out.ifidx == c->ifindex :
+				      t->out.ifidx != c->ifindex) {
+				flow_offload_teardown(flow);
+				return;
+			}
+		}
+	}
+}
+
+static void nf_flow_bridge_fdb_run(struct work_struct *work)
+{
+	struct nf_flow_bridge_fdb_batch *batch;
+	struct nf_flow_bridge *fb;
+
+	batch = kmalloc(sizeof(*batch), GFP_KERNEL);
+	spin_lock_bh(&nf_flow_bridge_fdb_lock);
+	if (batch)
+		*batch = nf_flow_bridge_fdb_pending;
+	nf_flow_bridge_fdb_pending.n = 0;
+	nf_flow_bridge_fdb_pending.overflow = false;
+	spin_unlock_bh(&nf_flow_bridge_fdb_lock);
+	if (!batch)
+		return;
+
+	mutex_lock(&nf_flow_bridge_mutex);
+	list_for_each_entry(fb, &nf_flow_bridge_list, list)
+		nf_flow_table_iterate(fb->flowtable, nf_flow_bridge_fdb_flow, batch);
+	mutex_unlock(&nf_flow_bridge_mutex);
+	kfree(batch);
+}
+
+static int nf_flow_bridge_fdb_event(struct notifier_block *nb,
+				    unsigned long event, void *ptr)
+{
+	struct net_device *dev = switchdev_notifier_info_to_dev(ptr);
+	const struct switchdev_notifier_fdb_info *info;
+	struct nf_flow_bridge_fdb *c;
+
+	if ((event != SWITCHDEV_FDB_ADD_TO_DEVICE &&
+	     event != SWITCHDEV_FDB_DEL_TO_DEVICE) ||
+	    !atomic_read(&nf_flow_bridge_tables))
+		return NOTIFY_DONE;
+
+	/* VLAN filtering bridges have no flows; a local address isn't forwarded */
+	info = container_of(ptr, struct switchdev_notifier_fdb_info, info);
+	if (info->vid || info->is_local || !netif_is_bridge_port(dev))
+		return NOTIFY_DONE;
+
+	spin_lock_bh(&nf_flow_bridge_fdb_lock);
+	if (nf_flow_bridge_fdb_pending.n < NF_FLOW_BRIDGE_FDB_MAX) {
+		c = &nf_flow_bridge_fdb_pending.changes[nf_flow_bridge_fdb_pending.n++];
+		ether_addr_copy(c->addr, info->addr);
+		c->ifindex = dev->ifindex;
+		c->gone = event == SWITCHDEV_FDB_DEL_TO_DEVICE;
+		write_pnet(&c->net, dev_net(dev));
+	} else {
+		nf_flow_bridge_fdb_pending.overflow = true;
+	}
+	spin_unlock_bh(&nf_flow_bridge_fdb_lock);
+	schedule_work(&nf_flow_bridge_fdb_work);
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block nf_flow_bridge_fdb_nb = {
+	.notifier_call = nf_flow_bridge_fdb_event,
+};
+
+/* A device listed in the flow table: nothing to do there */
+static unsigned int nf_flow_bridge_dev_hook(void *priv, struct sk_buff *skb,
+					    const struct nf_hook_state *state)
+{
+	return NF_ACCEPT;
+}
+
+static int nf_flow_bridge_setup(struct nf_flowtable *flowtable,
+				struct net_device *dev,
+				enum flow_block_command cmd)
+{
+	return 0;
+}
+
+static int nf_flow_bridge_init(struct nf_flowtable *flowtable)
+{
+	struct nf_flow_bridge *fb;
+	int err;
+
+	if (nf_flowtable_hw_offload(flowtable))
+		return -EOPNOTSUPP;
+
+	fb = kzalloc(sizeof(*fb), GFP_KERNEL_ACCOUNT);
+	if (!fb)
+		return -ENOMEM;
+
+	err = nf_flow_table_init(flowtable);
+	if (err < 0)
+		goto err_free;
+
+	fb->flowtable = flowtable;
+	fb->ops.hook = nf_flow_bridge_hook;
+	fb->ops.priv = flowtable;
+	fb->ops.pf = NFPROTO_BRIDGE;
+	fb->ops.hooknum = NF_BR_PRE_ROUTING;
+	fb->ops.priority = NF_FLOW_BRIDGE_PRIORITY;
+
+	err = nf_register_net_hook(read_pnet(&flowtable->net), &fb->ops);
+	if (err < 0)
+		goto err_table;
+
+	mutex_lock(&nf_flow_bridge_mutex);
+	list_add(&fb->list, &nf_flow_bridge_list);
+	mutex_unlock(&nf_flow_bridge_mutex);
+	atomic_inc(&nf_flow_bridge_tables);
+
+	return 0;
+
+err_table:
+	nf_flow_table_free(flowtable);
+err_free:
+	kfree(fb);
+	return err;
+}
+
+static void nf_flow_bridge_free(struct nf_flowtable *flowtable)
+{
+	struct nf_flow_bridge *fb, *found = NULL;
+
+	mutex_lock(&nf_flow_bridge_mutex);
+	list_for_each_entry(fb, &nf_flow_bridge_list, list) {
+		if (fb->flowtable == flowtable) {
+			list_del(&fb->list);
+			found = fb;
+			break;
+		}
+	}
+	mutex_unlock(&nf_flow_bridge_mutex);
+
+	/* no packet is in the hook after this, then the flows go */
+	if (found) {
+		atomic_dec(&nf_flow_bridge_tables);
+		nf_unregister_net_hook(read_pnet(&flowtable->net), &found->ops);
+		kfree(found);
+	}
+
+	nf_flow_table_free(flowtable);
+}
+
+static struct nf_flowtable_type flowtable_bridge = {
+	.family		= NFPROTO_BRIDGE,
+	.init		= nf_flow_bridge_init,
+	.setup		= nf_flow_bridge_setup,
+	.free		= nf_flow_bridge_free,
+	.flow_alloc	= nf_flow_bridge_flow_alloc,
+	.flow_check	= nf_flow_bridge_flow_check,
+	.hook		= nf_flow_bridge_dev_hook,
+	.owner		= THIS_MODULE,
+};
+
+static int __init nf_flow_bridge_module_init(void)
+{
+	int err;
+
+	INIT_WORK(&nf_flow_bridge_fdb_work, nf_flow_bridge_fdb_run);
+	err = register_switchdev_notifier(&nf_flow_bridge_fdb_nb);
+	if (err < 0)
+		return err;
+
+	nft_register_flowtable_type(&flowtable_bridge);
+
+	return 0;
+}
+
+static void __exit nf_flow_bridge_module_exit(void)
+{
+	nft_unregister_flowtable_type(&flowtable_bridge);
+	unregister_switchdev_notifier(&nf_flow_bridge_fdb_nb);
+	cancel_work_sync(&nf_flow_bridge_fdb_work);
+}
+
+module_init(nf_flow_bridge_module_init);
+module_exit(nf_flow_bridge_module_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_ALIAS_NF_FLOWTABLE(AF_BRIDGE);
+MODULE_DESCRIPTION("Netfilter flow table bridge module");
+
