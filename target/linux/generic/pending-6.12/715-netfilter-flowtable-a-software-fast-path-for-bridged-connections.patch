+/* expects no flow from the packet A -> B forwarded from @in to @out */
+static void nf_flow_bridge_test_expect_no_flow(struct kunit *test,
+					       struct nf_flow_bridge_test_pkt pkt,
+					       struct net_device *in,
+					       struct net_device *out,
+					       void (*change)(struct sk_buff *skb,
+							      struct nf_conn *ct))
+{
+	struct flow_offload *flow;
+	struct sk_buff *skb;
+	struct nf_conn *ct;
+
+	pkt.src = pkt.src ?: nf_flow_bridge_test_a;
+	pkt.dst = pkt.dst ?: nf_flow_bridge_test_b;
+	ct = nf_flow_bridge_test_ct(test, &pkt);
+	skb = nf_flow_bridge_test_skb(test, in, &pkt);
+	if (change)
+		change(skb, ct);
+	flow = nf_flow_bridge_test_flow_alloc(ct, skb, in, out, IP_CT_DIR_ORIGINAL);
+	KUNIT_EXPECT_NULL(test, flow);
+	if (flow)
+		flow_offload_free(flow);
+	/* nothing was allocated: only the test's own reference */
+	KUNIT_EXPECT_EQ(test, refcount_read(&ct->ct_general.use), 1);
+}
