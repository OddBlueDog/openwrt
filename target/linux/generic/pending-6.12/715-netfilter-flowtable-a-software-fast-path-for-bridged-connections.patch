+/* The bridge's switchdev fdb events queue a change: a port's learnt
+ * address, added or gone; not a VLAN's, a local one or a device's that
+ * isn't a port; and nothing while no flow table of this type exists
+ */
+static void nf_flow_bridge_test_fdb_event(struct kunit *test)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	struct switchdev_notifier_fdb_info info = {
+		.info.dev = ctx->dev[2],
+		.addr = nf_flow_bridge_test_b,
+	};
+	struct nf_flow_bridge_fdb c;
+	unsigned int n;
+
+	atomic_inc(&nf_flow_bridge_tables);
+	cancel_work_sync(&nf_flow_bridge_fdb_work);
+	spin_lock_bh(&nf_flow_bridge_fdb_lock);
+	nf_flow_bridge_fdb_pending.n = 0;
+	spin_unlock_bh(&nf_flow_bridge_fdb_lock);
+
+	nf_flow_bridge_fdb_event(NULL, SWITCHDEV_FDB_ADD_TO_DEVICE, &info.info);
+	nf_flow_bridge_fdb_event(NULL, SWITCHDEV_FDB_DEL_TO_DEVICE, &info.info);
+	info.vid = 5;
+	nf_flow_bridge_fdb_event(NULL, SWITCHDEV_FDB_ADD_TO_DEVICE, &info.info);
+	info.vid = 0;
+	info.is_local = true;
+	nf_flow_bridge_fdb_event(NULL, SWITCHDEV_FDB_ADD_TO_DEVICE, &info.info);
+	info.is_local = false;
+	nf_flow_bridge_fdb_event(NULL, SWITCHDEV_PORT_ATTR_SET, &info.info);
+	ctx->dev[2]->priv_flags &= ~IFF_BRIDGE_PORT;
+	nf_flow_bridge_fdb_event(NULL, SWITCHDEV_FDB_ADD_TO_DEVICE, &info.info);
+	ctx->dev[2]->priv_flags |= IFF_BRIDGE_PORT;
+	atomic_dec(&nf_flow_bridge_tables);
+	nf_flow_bridge_fdb_event(NULL, SWITCHDEV_FDB_ADD_TO_DEVICE, &info.info);
+
+	cancel_work_sync(&nf_flow_bridge_fdb_work);
+	spin_lock_bh(&nf_flow_bridge_fdb_lock);
+	n = nf_flow_bridge_fdb_pending.n;
+	c = nf_flow_bridge_fdb_pending.changes[1];
+	nf_flow_bridge_fdb_pending.n = 0;
+	spin_unlock_bh(&nf_flow_bridge_fdb_lock);
+
+	KUNIT_EXPECT_EQ(test, n, 2);
+	KUNIT_EXPECT_TRUE(test, ether_addr_equal(c.addr, nf_flow_bridge_test_b));
+	KUNIT_EXPECT_EQ(test, c.ifindex, ctx->dev[2]->ifindex);
+	KUNIT_EXPECT_TRUE(test, c.gone);
+	KUNIT_EXPECT_TRUE(test, net_eq(read_pnet(&c.net), &init_net));
+}
