+static void nf_flow_bridge_test_expect_sent(struct kunit *test, struct sk_buff *skb,
+					    struct net_device *out, const u8 *src,
+					    const u8 *dst)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	const struct ethhdr *eth;
+
+	KUNIT_ASSERT_PTR_EQ(test, ctx->sent, skb);
+	KUNIT_EXPECT_PTR_EQ(test, skb->dev, out);
+	/* the whole frame, MAC header first, with its own addresses */
+	KUNIT_EXPECT_PTR_EQ(test, skb->data, skb_mac_header(skb));
+	eth = (const struct ethhdr *)skb->data;
+	KUNIT_EXPECT_TRUE(test, ether_addr_equal(eth->h_source, src));
+	KUNIT_EXPECT_TRUE(test, ether_addr_equal(eth->h_dest, dst));
+}
+
+/* A frame of the flow goes to the egress port as it came: the same MAC
+ * header, TTL and IP checksum, a CHECKSUM_COMPLETE dropped as the bridge
+ * drops it, no switchdev forwarding mark
+ */
+static void nf_flow_bridge_test_hook_forwards(struct kunit *test)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	struct flow_offload *flow = nf_flow_bridge_test_flow(test,
+				(struct nf_flow_bridge_test_pkt){});
+	struct nf_flow_bridge_test_pkt pkt = {
+		.src = nf_flow_bridge_test_a, .dst = nf_flow_bridge_test_b,
+	};
+	struct sk_buff *skb = nf_flow_bridge_test_skb(test, ctx->dev[0], &pkt);
+	__sum16 check = ip_hdr(skb)->check;
+
+	skb->ip_summed = CHECKSUM_COMPLETE;
+#ifdef CONFIG_NET_SWITCHDEV
+	skb->offload_fwd_mark = 1;
+#endif
