+
+	ft->data.flags = NF_FLOWTABLE_HW_OFFLOAD;
+	KUNIT_EXPECT_EQ(test, nf_flow_bridge_init(&ft->data), -EOPNOTSUPP);
+
+	ft->data.flags = NF_FLOWTABLE_COUNTER;
