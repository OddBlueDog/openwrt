+/* fdb changes for the flow A (port 0) -> B (port 1), one at a time */
+static bool nf_flow_bridge_test_fdb(struct kunit *test, const u8 *addr, int port,
+				    bool gone, struct net *net)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	struct nf_flow_bridge_fdb_batch *batch = kunit_kzalloc(test, sizeof(*batch), GFP_KERNEL);
+	struct flow_offload *flow;
+	static u16 sport = 41000;
+
+	KUNIT_ASSERT_NOT_NULL(test, batch);
+	flow = nf_flow_bridge_test_flow(test, (struct nf_flow_bridge_test_pkt){ .sport = sport++ });
+	batch->n = 1;
+	ether_addr_copy(batch->changes[0].addr, addr);
+	batch->changes[0].ifindex = ctx->dev[port]->ifindex;
+	batch->changes[0].gone = gone;
+	write_pnet(&batch->changes[0].net, net);
+	nf_flow_bridge_fdb_flow(&ctx->ft.data, flow, batch);
+	return nf_flow_bridge_test_torn_down(flow);
+}
