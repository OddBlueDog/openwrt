+/* What the fast path leaves to the bridge: IPv4 options and fragments,
+ * protocols other than TCP and UDP, IPv6 extension headers, a packet too
+ * short for its headers, anything not IP, and skb->data not at the network
+ * header
+ */
+static void nf_flow_bridge_test_tuple_rejects(struct kunit *test)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	struct nf_flow_bridge_test_pkt pkt = {
+		.src = nf_flow_bridge_test_a, .dst = nf_flow_bridge_test_b,
+	};
+	struct nf_flow_bridge_test_pkt pkt6 = pkt;
+	struct flow_offload_tuple tuple = {};
+	struct net_device *in = ctx->dev[0];
+	struct sk_buff *skb;
+	unsigned int thoff;
+
+	skb = nf_flow_bridge_test_skb(test, in, &pkt);
+	ip_hdr(skb)->ihl = 6;
+	KUNIT_EXPECT_LT(test, nf_flow_bridge_tuple(skb, in, &tuple, &thoff), 0);
+
+	skb = nf_flow_bridge_test_skb(test, in, &pkt);
+	ip_hdr(skb)->frag_off = htons(IP_MF);
+	KUNIT_EXPECT_LT(test, nf_flow_bridge_tuple(skb, in, &tuple, &thoff), 0);
+
+	skb = nf_flow_bridge_test_skb(test, in, &pkt);
+	ip_hdr(skb)->frag_off = htons(8);
+	KUNIT_EXPECT_LT(test, nf_flow_bridge_tuple(skb, in, &tuple, &thoff), 0);
+
+	skb = nf_flow_bridge_test_skb(test, in, &pkt);
+	ip_hdr(skb)->protocol = IPPROTO_ICMP;
+	KUNIT_EXPECT_LT(test, nf_flow_bridge_tuple(skb, in, &tuple, &thoff), 0);
+
+	pkt6.ipv6 = true;
+	skb = nf_flow_bridge_test_skb(test, in, &pkt6);
+	ipv6_hdr(skb)->nexthdr = NEXTHDR_HOP;
+	KUNIT_EXPECT_LT(test, nf_flow_bridge_tuple(skb, in, &tuple, &thoff), 0);
+
+	skb = nf_flow_bridge_test_skb(test, in, &pkt);
+	skb_trim(skb, sizeof(struct iphdr) + 4);
+	KUNIT_EXPECT_LT(test, nf_flow_bridge_tuple(skb, in, &tuple, &thoff), 0);
+
+	skb = nf_flow_bridge_test_skb(test, in, &pkt);
+	skb->protocol = htons(ETH_P_ARP);
+	KUNIT_EXPECT_LT(test, nf_flow_bridge_tuple(skb, in, &tuple, &thoff), 0);
+
+	skb = nf_flow_bridge_test_skb(test, in, &pkt);
+	skb_push(skb, 2);
+	KUNIT_EXPECT_LT(test, nf_flow_bridge_tuple(skb, in, &tuple, &thoff), 0);
+}
