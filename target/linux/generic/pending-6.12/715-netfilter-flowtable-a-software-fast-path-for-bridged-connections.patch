+/* A port frames may come from: forwarding, not locked, no VLAN filtering */
+static void nf_flow_bridge_test_port_ok(struct kunit *test)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	static const u8 not_forwarding[] = {
+		BR_STATE_DISABLED, BR_STATE_LISTENING, BR_STATE_LEARNING,
+		BR_STATE_BLOCKING,
+	};
+	struct net_bridge_port *p = ctx->port[0];
+	int i;
+
+	KUNIT_EXPECT_TRUE(test, nf_flow_bridge_port_ok(p));
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_port_ok(NULL));
+
+	for (i = 0; i < ARRAY_SIZE(not_forwarding); i++) {
+		p->state = not_forwarding[i];
+		KUNIT_EXPECT_FALSE(test, nf_flow_bridge_port_ok(p));
+	}
+	p->state = BR_STATE_FORWARDING;
+
+	p->flags = BR_PORT_LOCKED;
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_port_ok(p));
+	p->flags = BR_PORT_MAB;
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_port_ok(p));
+	p->flags = BR_ISOLATED | BR_LEARNING | BR_FLOOD;
+	KUNIT_EXPECT_TRUE(test, nf_flow_bridge_port_ok(p));
+	p->flags = 0;
+
+	__set_bit(BROPT_VLAN_ENABLED, &ctx->br->options);
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_port_ok(p));
+}
+
+/* ... and one the bridge sends them on from there */
+static void nf_flow_bridge_test_ports_ok(struct kunit *test)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	struct net_bridge_port *p = ctx->port[0], *q = ctx->port[1];
+
+	KUNIT_EXPECT_TRUE(test, nf_flow_bridge_ports_ok(p, q));
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_ports_ok(p, NULL));
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_ports_ok(p, p));
+
+	q->state = BR_STATE_BLOCKING;
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_ports_ok(p, q));
+	q->state = BR_STATE_FORWARDING;
+
+	q->br = ctx->other_br;
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_ports_ok(p, q));
+	q->br = ctx->br;
+
+	/* isolated ports reach the others, not each other */
+	q->flags = BR_ISOLATED;
+	KUNIT_EXPECT_TRUE(test, nf_flow_bridge_ports_ok(p, q));
+	p->flags = BR_ISOLATED;
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_ports_ok(p, q));
+}
