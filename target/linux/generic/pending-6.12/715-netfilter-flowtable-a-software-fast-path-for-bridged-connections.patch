+/* About once a second a direction's frame goes the bridge's way, then the
+ * fast path's again; the other direction keeps its own second
+ */
+static void nf_flow_bridge_test_hook_bridge_check(struct kunit *test)
+{
+	struct nf_flow_bridge_test *ctx = test->priv;
+	struct flow_offload *flow = nf_flow_bridge_test_flow(test,
+				(struct nf_flow_bridge_test_pkt){});
+	struct flow_offload_tuple *t = &flow->tuplehash[FLOW_OFFLOAD_DIR_ORIGINAL].tuple;
+	struct flow_offload_tuple *r = &flow->tuplehash[FLOW_OFFLOAD_DIR_REPLY].tuple;
+	struct nf_flow_bridge_test_pkt pkt = {
+		.src = nf_flow_bridge_test_a, .dst = nf_flow_bridge_test_b,
+	};
+	u32 reply_checked = r->out.br_checked;
+	struct sk_buff *skb;
+
+	t->out.br_checked = nf_flowtable_time_stamp - HZ;
+	skb = nf_flow_bridge_test_skb(test, ctx->dev[0], &pkt);
+	KUNIT_EXPECT_EQ(test, nf_flow_bridge_test_hook(skb, ctx->dev[0]), NF_ACCEPT);
+	KUNIT_EXPECT_LE(test, nf_flowtable_time_stamp - t->out.br_checked, 1);
+	KUNIT_EXPECT_EQ(test, r->out.br_checked, reply_checked);
+	KUNIT_EXPECT_FALSE(test, nf_flow_bridge_test_torn_down(flow));
+
+	skb = nf_flow_bridge_test_skb(test, ctx->dev[0], &pkt);
+	KUNIT_EXPECT_EQ(test, nf_flow_bridge_test_hook(skb, ctx->dev[0]), NF_STOLEN);
+	KUNIT_EXPECT_EQ(test, ctx->sends, 1);
+}
