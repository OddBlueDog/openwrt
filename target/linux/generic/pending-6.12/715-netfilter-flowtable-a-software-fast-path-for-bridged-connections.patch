+	mutex_lock(&nf_flow_bridge_mutex);
+	KUNIT_EXPECT_FALSE(test, list_empty(&nf_flow_bridge_list));
+	mutex_unlock(&nf_flow_bridge_mutex);
+	nf_flow_bridge_free(&ft->data);
+	mutex_lock(&nf_flow_bridge_mutex);
+	KUNIT_EXPECT_TRUE(test, list_empty(&nf_flow_bridge_list));
+	mutex_unlock(&nf_flow_bridge_mutex);
+}
