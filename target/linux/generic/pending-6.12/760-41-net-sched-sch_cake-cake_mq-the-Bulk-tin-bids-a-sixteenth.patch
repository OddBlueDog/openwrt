From: MilkFlint <milkflint@localhost>
Date: Mon, 23 Nov 2026 14:00:00 +0000
Subject: [PATCH] net/sched: sch_cake: cake_mq: the Bulk tin bids a sixteenth

In diffserv3 and diffserv4 tin 1 is the Bulk tin (LE, CS1): its threshold
and its quantum are a sixteenth of the others', and in one CAKE it gets a
sixteenth of the rate while the other tins want more. cake_mq's
sub-cakes share the rate by their bids, the sum of their tins' bulk
weights, every tin alike: a sub-cake of Bulk flows alone bid as much as
one of Best Effort's and took half the rate, or more with more hosts.

The Bulk tin's weight now counts a sixteenth in the bid, so a saturated
Bulk sub-cake gets a sixteenth next to a saturated Best Effort (or Video,
or Voice) one, half next to another Bulk one, and all of the rate alone,
as one CAKE gives them; a sub-cake with Best Effort and Bulk isn't held to
Bulk's part. A sub-cake with no bulk flow bids as one host's only flow, as
before, unless all it sent since its last resync, and holds, is the Bulk
tin's: then a sixteenth of that. The tins a sub-cake sent from are noted
per packet on its own cache line and start again each resync. Nothing
changes without a Bulk tin (besteffort, diffserv8, precedence).

The Bulk tin's sparse flows are still served first, as every tin's are: in
one CAKE the Bulk tin goes ahead below its threshold, and a sparse flow is
far below it.

KUnit: the bid in each tin mode (the Bulk tin at a sixteenth, a sixteenth
of one host's for Bulk alone, unchanged without the tin, what was sent
starting again); two sub-cakes' shares: Best Effort or Video against Bulk
94/6, Bulk against Bulk half each, Best Effort and Bulk against Best Effort
52/48, Bulk alone once Best Effort's flows end, besteffort and diffserv8
half each, always within the rate; a diffserv4 sub-cake's dequeue notes a
Bulk packet's tin and bids a sixteenth for its sparse flow alone.

---
--- a/net/sched/sch_cake.c
+++ b/net/sched/sch_cake.c
@@ -324,10 +324,13 @@ struct cake_sched_data {
 	u64		mq_idle;	/* ns without a packet until we count as idle */
 	u32		mq_weight;
 	bool		mq_saturated;
-	/* charged to the shaper since our last resync, a packet at a time */
+	/* charged to the shaper since our last resync, a packet at a time, and
+	 * the tins it came from
+	 */
 	u64		mq_bytes ____cacheline_aligned_in_smp;
 	u64		mq_sparse_bytes;
 	u32		mq_packets;
+	u8		mq_seen_tins;
 	/* when the shaper last held packets back, and when a packet sent
 	 * last left our queue empty
 	 */
@@ -2190,6 +2193,7 @@ static int cake_advance_shaper(struct cake_sched_data *q,
 		if (q->config->is_shared) {
 			q->mq_bytes += len;
 			q->mq_packets++;
+			q->mq_seen_tins |= BIT(b - q->tins);
 		}
 	}
 	return len;
@@ -2547,9 +2551,10 @@ static void cake_mq_mark_used(struct Qdisc *sch, struct cake_sched_data *q)
  *   ("used"), and the others share out the rest. So a share one can't use
  *   goes to those that can, within a few milliseconds.
  * - The saturated ones, and this one, split what's left by their bulk
- *   weights (cake_mq_set_weight()), after each one's sparse flows, which
- *   are served first as in one CAKE. The flows then get what one CAKE
- *   would give them.
+ *   weights (cake_mq_set_weight(); a Bulk tin's at a sixteenth,
+ *   cake_mq_tins_weight()), after each one's sparse flows, which are
+ *   served first as in one CAKE. The flows then get what one CAKE would
+ *   give them.
  * - A sub-cake with no bulk flow bids as one host's only flow, so it can
  *   grow into a share; what it doesn't use stays with the others.
  *
@@ -2629,6 +2634,47 @@ static u64 cake_mq_idle_after(u64 idle, u64 bytes, u32 packets, u64 usage)
 	return clamp_t(u64, idle, CAKE_MQ_TAU, CAKE_MQ_TAU_MAX);
 }
 
+/* Whether @q's tin 1 is the Bulk tin (LE, CS1) of diffserv3 or diffserv4:
+ * a sixteenth of the rate as its threshold, and of the quantum
+ */
+static bool cake_has_bulk_tin(const struct cake_sched_data *q)
+{
+	return q->tin_order == bulk_order;
+}
+
+/* The weight @q bids with at a resync (cake_mq_share()): its tins' bulk
+ * weights, the Bulk tin's at a sixteenth. In one CAKE the Bulk tin gets a
+ * sixteenth of the rate, by its threshold and its quantum, while the other
+ * tins want more; across cake_mq's sub-cakes it's their bids that share the
+ * rate, and a sub-cake of Bulk flows alone bid as much as one of Best
+ * Effort's, so it took half the rate, or more with more hosts. With its
+ * hosts at a sixteenth, a saturated Bulk sub-cake gets a sixteenth next to a
+ * saturated Best Effort one, half next to another Bulk one, and all of the
+ * rate alone (the share's split is between those that want more). 0, as
+ * one host's only flow (cake_mq_bid()), unless what it sent since its last
+ * resync, and holds, is the Bulk tin's alone: then a sixteenth of that.
+ */
+static u32 cake_mq_tins_weight(const struct cake_sched_data *q)
+{
+	bool bulk = cake_has_bulk_tin(q);
+	u8 tins = q->mq_seen_tins;
+	u32 weight = 0;
+	u16 tin;
+
+	for (tin = 0; tin < q->tin_cnt; tin++) {
+		u32 w = q->tins[tin].mq_weight;
+
+		if (w && bulk && tin == 1)
+			w = max(w >> 4, 1U);
+		weight += w;
+		if (q->tins[tin].tin_backlog)
+			tins |= BIT(tin);
+	}
+	if (!weight && bulk && tins == BIT(1))
+		weight = CAKE_MQ_UNIT >> 4;
+	return weight;
+}
+
 /* At a resync: what @q used since the last one and its bulk weight, for
  * the other sub-cakes to read, and whether it wants more than its share:
  * it used 31/32 of it, or 7/8 with its shaper holding packets back lately.
@@ -2658,11 +2704,9 @@ static void cake_mq_publish(struct cake_sched_data *q, u64 now)
 	u64 dt = now - q->last_checked_active;
 	u64 tau = q->mq_idle ?: CAKE_MQ_TAU;
 	u64 usage, sparse, idle;
-	u32 weight = 0;
-	u16 tin;
+	u32 weight;
 
-	for (tin = 0; tin < q->tin_cnt; tin++)
-		weight += q->tins[tin].mq_weight;
+	weight = cake_mq_tins_weight(q);
 	usage = cake_mq_ewma(q->mq_usage, q->mq_bytes, dt, tau);
 	sparse = cake_mq_ewma(q->mq_sparse, q->mq_sparse_bytes, dt, tau);
 	idle = cake_mq_idle_after(q->mq_idle, q->mq_bytes, q->mq_packets, usage);
@@ -2671,6 +2715,7 @@ static void cake_mq_publish(struct cake_sched_data *q, u64 now)
 	q->mq_bytes = 0;
 	q->mq_sparse_bytes = 0;
 	q->mq_packets = 0;
+	q->mq_seen_tins = 0;
 
 	WRITE_ONCE(q->mq_usage, usage);
 	WRITE_ONCE(q->mq_sparse, min(sparse, usage));
@@ -3581,6 +3626,7 @@ static void cake_reset(struct Qdisc *sch)
 		if (q->config->is_shared)
 			cake_mq_retire_tin(q, &q->tins[c], ktime_get());
 	}
+	q->mq_seen_tins = 0;
 }
 
 static const struct nla_policy cake_policy[TCA_CAKE_MAX + 1] = {
--- a/net/sched/sch_cake_test.c
+++ b/net/sched/sch_cake_test.c
@@ -4471,6 +4471,224 @@ static void cake_test_mq_change_live(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, tables[3], 0);
 }
 
+/* --- the Bulk tin across cake_mq's sub-cakes ------------------------------- */
+
+/* The weight a sub-cake bids with: its tins' bulk weights, diffserv3's and
+ * diffserv4's Bulk tin (1) at a sixteenth; with none, a sixteenth of one
+ * host's when all it sent since its last resync, and holds, is Bulk's. Not
+ * in the tin modes without that tin. What it sent starts again each resync.
+ */
+static void cake_test_mq_bulk_weight(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	const u64 now = CAKE_TEST_NOW;
+	static const struct {
+		const u8 *order;
+		u16 tin_cnt;
+		u32 weight[4];
+		u8 seen;
+		bool backlog1;	/* packets queued in tin 1 */
+		u32 want;
+	} cases[] = {
+		{ bulk_order, 4, { 65535, 65535 }, 0, false, 65535 + 4095 },
+		{ bulk_order, 4, { 0, 65535 }, 0, false, 4095 },
+		{ bulk_order, 4, { 0, 3 }, 0, false, 1 },
+		{ bulk_order, 4, { 0, 0, 65535, 65535 }, 0, false, 2 * 65535 },
+		{ bulk_order, 3, { 0, 2 * 65535 }, 0, false, 8191 },
+		/* no bulk flow: Bulk's alone bids a sixteenth of one host's */
+		{ bulk_order, 4, { 0 }, BIT(1), false, 4095 },
+		{ bulk_order, 4, { 0 }, 0, true, 4095 },
+		{ bulk_order, 4, { 0 }, BIT(0) | BIT(1), false, 0 },
+		{ bulk_order, 4, { 0 }, BIT(1) | BIT(3), false, 0 },
+		{ bulk_order, 4, { 0 }, 0, false, 0 },
+		/* besteffort, diffserv8, precedence: as before */
+		{ normal_order, 8, { 0, 65535 }, 0, false, 65535 },
+		{ normal_order, 8, { 0 }, BIT(1), false, 0 },
+		{ normal_order, 1, { 65535 }, BIT(0), false, 65535 },
+	};
+	int c, t;
+
+	q->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(*q->tins));
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		q->tin_order = cases[c].order;
+		q->tin_cnt = cases[c].tin_cnt;
+		for (t = 0; t < CAKE_MAX_TINS; t++) {
+			q->tins[t].mq_weight = t < 4 ? cases[c].weight[t] : 0;
+			q->tins[t].tin_backlog = t == 1 && cases[c].backlog1 ? 1514 : 0;
+		}
+		q->mq_seen_tins = cases[c].seen;
+		q->last_checked_active = now - 200 * NSEC_PER_USEC;
+		q->synced_rate = CAKE_TEST_RATE;
+		cake_mq_publish(q, now);
+		KUNIT_EXPECT_EQ_MSG(test, q->mq_weight, cases[c].want, "case %d", c);
+		KUNIT_EXPECT_EQ_MSG(test, q->mq_seen_tins, 0, "case %d", c);
+	}
+}
+
+/* Two sub-cakes, each with bulk weights in some of its tins (one host
+ * each: 65535), as diffserv4, diffserv3 or besteffort/diffserv8 lay out
+ * their tins
+ */
+struct cake_test_tins_case {
+	const u8 *order;
+	u16 tin_cnt;
+	u32 weight[2][4];
+	/* sub-cake 0's flows end after this many 200 us steps (0: never) */
+	int stop;
+	/* what each gets once settled, per 1000 of the rate */
+	u32 want[2];
+};
+
+/* @c's two sub-cakes wanting all they can get for 30 ms, resyncing every
+ * 200 us as cake_dequeue() does: what each sent in the last 10 ms, as
+ * bytes/s, in @sent
+ */
+static void cake_test_mq_tins_run(struct cake_test_mq *mq, const struct cake_test_tins_case *c,
+				  u64 rate, u64 *sent)
+{
+	const u64 step = 200 * NSEC_PER_USEC;
+	u64 now = 10 * NSEC_PER_MSEC;
+	int t, k, i, tin;
+
+	mq->dev->real_num_tx_queues = 2;
+	bitmap_zero(mq->cfg->used_qs, CAKE_TEST_TXQS);
+	mq->cfg->rate_bps = rate;
+	for (i = 0; i < 2; i++) {
+		struct cake_sched_data *q = cake_test_mq_q(mq, i);
+
+		mq->sch[i]->q.qlen = 0;
+		q->tin_cnt = c->tin_cnt;
+		q->tin_order = c->order;
+		for (tin = 0; tin < CAKE_MAX_TINS; tin++) {
+			q->tins[tin].mq_weight = tin < 4 ? c->weight[i][tin] : 0;
+			q->tins[tin].tin_backlog = 0;
+		}
+		q->synced_rate = rate;
+		q->last_checked_active = now - step;
+		q->last_active = 0;
+		q->mq_usage = q->mq_sparse = q->mq_bytes = q->mq_sparse_bytes = 0;
+		q->mq_idle = 0;
+		q->mq_packets = 0;
+		q->mq_held_at = 0;
+		q->mq_drained_at = 0;
+		q->mq_seen_tins = 0;
+		q->mq_weight = 0;
+		q->mq_saturated = false;
+		sent[i] = 0;
+		cake_test_mq_enqueue(mq, i);
+	}
+
+	for (t = 0; t < 150; t++) {
+		now += step;
+		for (k = 0; k < 2; k++) {
+			struct cake_sched_data *q;
+			struct cake_mq_peers p;
+			u64 share;
+
+			i = (k + t) % 2;
+			q = cake_test_mq_q(mq, i);
+			if (i == 0 && c->stop && t >= c->stop) {
+				if (mq->sch[0]->q.qlen) {
+					mq->sch[0]->q.qlen = 0;
+					q->mq_drained_at = now;
+				}
+				continue;
+			}
+			/* asking for more than it may send: its shaper holds packets */
+			q->mq_held_at = now - step / 2;
+			if (t >= 100)
+				sent[i] += q->synced_rate;
+			q->mq_bytes = div64_u64(q->synced_rate * step, NSEC_PER_SEC);
+			q->mq_packets = 10;
+			q->last_active = now;
+			cake_mq_publish(q, now);
+			cake_test_mq_peers(mq, i, now, &p);
+			share = cake_mq_share(rate, q->mq_weight, q->mq_sparse, &p);
+			if (cake_mq_share_moved(share, q->synced_rate, rate))
+				q->synced_rate = share;
+			q->last_checked_active = now;
+		}
+	}
+	for (i = 0; i < 2; i++)
+		sent[i] = div_u64(sent[i], 50);
+}
+
+/* Bulk (CS1, LE) yields across cake_mq's sub-cakes as in one CAKE: a
+ * sixteenth of the rate next to Best Effort, half next to another Bulk
+ * host, all of it once Best Effort's flows end. A sub-cake with Best
+ * Effort and Bulk isn't held to Bulk's part. Without a Bulk tin
+ * (besteffort, diffserv8) two hosts get half each, as before. The shares
+ * add up to the rate.
+ */
+static void cake_test_mq_bulk_yields(struct kunit *test)
+{
+	static const struct cake_test_tins_case cases[] = {
+		/* diffserv4: a Best Effort host against a Bulk one */
+		{ bulk_order, 4, { { 65535 }, { 0, 65535 } }, 0, { 941, 59 } },
+		/* diffserv3 */
+		{ bulk_order, 3, { { 65535 }, { 0, 65535 } }, 0, { 941, 59 } },
+		/* Bulk against Bulk */
+		{ bulk_order, 4, { { 0, 65535 }, { 0, 65535 } }, 0, { 500, 500 } },
+		/* Best Effort and Bulk against Best Effort */
+		{ bulk_order, 4, { { 65535, 65535 }, { 65535 } }, 0, { 515, 485 } },
+		/* Video against Bulk: Bulk yields to every other tin */
+		{ bulk_order, 4, { { 0, 0, 65535 }, { 0, 65535 } }, 0, { 941, 59 } },
+		/* Best Effort's flows end: Bulk takes the rate */
+		{ bulk_order, 4, { { 65535 }, { 0, 65535 } }, 50, { 0, 1000 } },
+		/* besteffort and diffserv8: half each, as before */
+		{ normal_order, 1, { { 65535 }, { 65535 } }, 0, { 500, 500 } },
+		{ normal_order, 8, { { 65535 }, { 0, 65535 } }, 0, { 500, 500 } },
+	};
+	const u64 rate = CAKE_TEST_RATE;
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	int c, i;
+
+	for (i = 0; i < 2; i++)
+		cake_test_mq_q(mq, i)->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(struct cake_tin_data));
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		u64 sent[2];
+
+		cake_test_mq_tins_run(mq, &cases[c], rate, sent);
+		for (i = 0; i < 2; i++)
+			KUNIT_EXPECT_LE_MSG(test, abs_diff(sent[i], div_u64(rate * cases[c].want[i], 1000)),
+					    rate / 50, "case %d, sub-cake %d: %llu of %llu", c, i, sent[i], rate);
+		KUNIT_EXPECT_LE_MSG(test, sent[0] + sent[1], rate + rate / 100, "case %d", c);
+		KUNIT_EXPECT_GE_MSG(test, sent[0] + sent[1], rate - rate / 50, "case %d", c);
+	}
+}
+
+/* A diffserv4 sub-cake's dequeue notes the tin a packet came from, and a
+ * Bulk packet's sparse flow alone makes it bid a sixteenth of one host's
+ */
+static void cake_test_mq_bulk_seen(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct Qdisc *root = cake_test_mq_root(test, mq, 1, 12500000, CAKE_DIFFSERV_DIFFSERV4);
+	struct cake_sched_data *q = cake_test_mq_q(mq, 0);
+	struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_UDP, 5, 41000, 0);
+	u8 seen;
+	bool ok;
+
+	KUNIT_ASSERT_NOT_NULL(test, root);
+	kunit_remove_action(test, cake_test_free_skb, skb);
+	/* the Bulk tin: diffserv4's first by priority (bulk_order) */
+	skb->priority = TC_H_MAKE(mq->sch[0]->handle, 1);
+	rcu_read_lock();
+	rcu_read_lock_bh();
+	ok = cake_test_enqueue(mq->sch[0], skb) == NET_XMIT_SUCCESS;
+	ok &= cake_test_out(mq->sch[0], skb);
+	seen = q->mq_seen_tins;
+	rcu_read_unlock_bh();
+	rcu_read_unlock();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_EQ(test, seen, BIT(1));
+	q->last_checked_active = ktime_get_ns() - 200 * NSEC_PER_USEC;
+	cake_mq_publish(q, ktime_get_ns());
+	KUNIT_EXPECT_EQ(test, q->mq_weight, CAKE_MQ_UNIT >> 4);
+	KUNIT_EXPECT_EQ(test, q->mq_seen_tins, 0);
+}
+
 /* With its failsafe due, the shaper lets the next packet go at once, as
  * the hard shaper at the top of cake_dequeue() decides. In ingress mode a
  * drop moves the shaper on but not the failsafe: a burst that overflows
@@ -5443,6 +5661,7 @@ static void cake_test_mq_published_line(struct kunit *test)
 	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_bytes), at + SMP_CACHE_BYTES);
 	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_held_at), at + SMP_CACHE_BYTES);
 	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_drained_at), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_seen_tins), at + SMP_CACHE_BYTES);
 }
 
 /* When a sub-cake last sent is written as its queue empties, whatever was
@@ -6107,6 +6326,9 @@ static struct kunit_case cake_test_cases[] = {
 	KUNIT_CASE(cake_test_mq_share_within_rate),
 	KUNIT_CASE(cake_test_mq_bursts_drop_out),
 	KUNIT_CASE(cake_test_mq_stopped_holds_little),
+	KUNIT_CASE(cake_test_mq_bulk_weight),
+	KUNIT_CASE(cake_test_mq_bulk_yields),
+	KUNIT_CASE(cake_test_mq_bulk_seen),
 	KUNIT_CASE(cake_test_mq_host_load_shared),
 	KUNIT_CASE(cake_test_mq_host_queues),
 	KUNIT_CASE(cake_test_mq_host_retag),
