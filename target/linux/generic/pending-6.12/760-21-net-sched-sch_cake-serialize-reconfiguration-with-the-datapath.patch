Link: https://lore.kernel.org/netdev/87ld7t3kl3.fsf@all.your.base.are.belong.to.us/
Reviewed-by: Victor Nogueira <victor@mojatatu.com>
Signed-off-by: Jamal Hadi Salim <jhs@mojatatu.com>
Acked-by: Toke Høiland-Jørgensen <toke@toke.dk>
Link: https://patch.msgid.link/QDISC-5RTM.v3.r0.20261020053711-1@mojatatu.com
Signed-off-by: Jakub Kicinski <kuba@kernel.org>
[MilkFlint: on 760-08's cake_mq, whose resync reads the rate once
 for its share and the share's bounds; cake_reconfigure() also takes
 synced_rate from the rate it read. The overhead statistics stay plain
 writes, as upstream's data-race annotations aren't here.]
---
--- a/net/sched/sch_cake.c
+++ b/net/sched/sch_cake.c
@@ -2568,7 +2568,8 @@ static s32 cake_enqueue(struct sk_buff *skb, struct Qdisc *sch,
 			if (ktime_after(now,
 					ktime_add_ms(q->last_reconfig_time,
 						     250))) {
-				q->config->rate_bps = (q->avg_peak_bandwidth * 15) >> 4;
+				WRITE_ONCE(q->config->rate_bps,
+					   (q->avg_peak_bandwidth * 15) >> 4);
 				q->last_reconfig_time = now;
 				cake_reconfigure(sch);
 			}
@@ -2835,16 +2836,15 @@ static struct sk_buff *cake_dequeue(struct Qdisc *sch)
 
 	if (q->config->is_shared && q->rate_ns &&
 	    now - q->last_checked_active >= q->config->sync_time) {
+		u64 rate = READ_ONCE(q->config->rate_bps);
 		struct cake_mq_peers peers;
 		u64 new_rate;
 
 		cake_mq_publish(q, now);
 		cake_mq_read_peers(sch, q, now, &peers);
-		new_rate = cake_mq_share(q->config->rate_bps, q->mq_weight,
-					 q->mq_sparse, &peers);
+		new_rate = cake_mq_share(rate, q->mq_weight, q->mq_sparse, &peers);
 
-		if (cake_mq_share_moved(new_rate, q->synced_rate,
-					q->config->rate_bps)) {
+		if (cake_mq_share_moved(new_rate, q->synced_rate, rate)) {
 			q->time_next_packet =
 				cake_mq_rescale_wait(q->time_next_packet, now,
 						     q->synced_rate, new_rate);
@@ -3434,14 +3434,15 @@ static void cake_reconfigure(struct Qdisc *sch)
 {
 	struct cake_sched_data *qd = qdisc_priv(sch);
 	struct cake_sched_config *q = qd->config;
+	u64 rate_bps = READ_ONCE(q->rate_bps);
 
-	cake_configure_rates(sch, qd->config->rate_bps, false);
-	qd->synced_rate = qd->config->rate_bps;
+	cake_configure_rates(sch, rate_bps, false);
+	qd->synced_rate = rate_bps;
 
 	if (q->buffer_config_limit) {
 		qd->buffer_limit = q->buffer_config_limit;
-	} else if (q->rate_bps) {
-		u64 t = q->rate_bps * q->interval;
+	} else if (rate_bps) {
+		u64 t = rate_bps * q->interval;
 
 		do_div(t, USEC_PER_SEC / 4);
 		qd->buffer_limit = max_t(u32, t, 4U << 20);
@@ -3593,9 +3594,16 @@ static int cake_change(struct Qdisc *sch, struct nlattr *opt,
 		return -EOPNOTSUPP;
 	}
 
+	/* Once the qdisc is live, commit and reconfigure under the lock that
+	 * serializes the datapath, so a concurrent 'tc qdisc change' and the
+	 * autorate update cannot lose the configured rate.
+	 */
+	if (qd->tins)
+		sch_tree_lock(sch);
+
 	ret = cake_config_change(q, opt, extack, &overhead_changed);
 	if (ret)
-		return ret;
+		goto unlock;
 
 	if (overhead_changed) {
 		qd->max_netlen = 0;
@@ -3604,13 +3612,13 @@ static int cake_change(struct Qdisc *sch, struct nlattr *opt,
 		qd->min_adjlen = ~0;
 	}
 
-	if (qd->tins) {
-		sch_tree_lock(sch);
+	if (qd->tins)
 		cake_reconfigure(sch);
+unlock:
+	if (qd->tins)
 		sch_tree_unlock(sch);
-	}
 
-	return 0;
+	return ret;
 }
 
 static void cake_destroy(struct Qdisc *sch)
