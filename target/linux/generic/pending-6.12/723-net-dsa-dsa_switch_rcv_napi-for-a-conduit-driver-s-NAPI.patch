From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OddBlueDog <3959851+OddBlueDog@users.noreply.github.com>
Date: Sat, 28 Nov 2026 11:11:00 +0000
Subject: [PATCH] net: dsa: dsa_switch_rcv_napi(), a conduit's frames to the
 user port's GRO from the conduit driver's NAPI

A frame a DSA conduit receives takes two NAPI passes: the conduit
driver's, whose GRO can't take it (ETH_P_XDSA), and its receive path on
the conduit up to dsa_switch_rcv(), then the user port's gro_cells,
another NAPI, which runs in a NET_RX softirq wherever the conduit's NAPI
let BH go (the user port isn't threaded, whatever the conduit's NAPI
is), with GRO on the port at last.

dsa_switch_rcv() is split at gro_cells_receive(): __dsa_switch_rcv()
takes the tag off and finds the user port as before.
dsa_switch_rcv_napi() runs it for a frame straight from a conduit
driver's NAPI poll, checks the port is up as gro_cells_receive() does,
and returns the frame on its port for the driver's own
napi_gro_receive(). The driver makes sure nothing on the conduit itself
would have seen the frame on its receive path there (taps, an
rx_handler, tc or netfilter ingress, generic XDP, protocol handlers
bound to it). dsa_switch_rcv() is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/net/dsa.h |  1 +
 net/dsa/tag.c     | 65 ++++++++++++++++++++++++++++++++++++++++-------
 2 files changed, 57 insertions(+), 9 deletions(-)

diff --git a/include/net/dsa.h b/include/net/dsa.h
index 55b9725..260341a 100644
--- a/include/net/dsa.h
+++ b/include/net/dsa.h
@@ -1393,6 +1393,7 @@ static inline int dsa_switch_resume(struct dsa_switch *ds)
 
 #if IS_ENABLED(CONFIG_NET_DSA)
 bool dsa_user_dev_check(const struct net_device *dev);
+struct sk_buff *dsa_switch_rcv_napi(struct sk_buff *skb);
 #else
 static inline bool dsa_user_dev_check(const struct net_device *dev)
 {
diff --git a/net/dsa/tag.c b/net/dsa/tag.c
index 79ad105..5408c29 100644
--- a/net/dsa/tag.c
+++ b/net/dsa/tag.c
@@ -51,8 +51,12 @@ static bool dsa_skb_defer_rx_timestamp(struct dsa_user_priv *p,
 	return ds->ops->port_rxtstamp(ds, p->dp->index, skb, type);
 }
 
-static int dsa_switch_rcv(struct sk_buff *skb, struct net_device *dev,
-			  struct packet_type *pt, struct net_device *unused)
+/* A frame the conduit @dev received, its tag taken off and its user port
+ * found, ready for that port's GRO. NULL: consumed (dropped, handed to an
+ * upper device, or held for its RX timestamp).
+ */
+static struct sk_buff *__dsa_switch_rcv(struct sk_buff *skb,
+					struct net_device *dev)
 {
 	struct metadata_dst *md_dst = skb_metadata_dst(skb);
 	struct dsa_port *cpu_dp = dev->dsa_ptr;
@@ -61,12 +65,12 @@ static int dsa_switch_rcv(struct sk_buff *skb, struct net_device *dev,
 
 	if (unlikely(!cpu_dp)) {
 		kfree_skb(skb);
-		return 0;
+		return NULL;
 	}
 
 	skb = skb_unshare(skb, GFP_ATOMIC);
 	if (!skb)
-		return 0;
+		return NULL;
 
 	if (md_dst && md_dst->type == METADATA_HW_PORT_MUX) {
 		unsigned int port = md_dst->u.port_info.port_id;
@@ -86,7 +90,7 @@ static int dsa_switch_rcv(struct sk_buff *skb, struct net_device *dev,
 
 	if (!nskb) {
 		kfree_skb(skb);
-		return 0;
+		return NULL;
 	}
 
 	skb = nskb;
@@ -100,7 +104,7 @@ static int dsa_switch_rcv(struct sk_buff *skb, struct net_device *dev,
 		 * specific actions.
 		 */
 		netif_rx(skb);
-		return 0;
+		return NULL;
 	}
 
 	p = netdev_priv(skb->dev);
@@ -110,7 +114,7 @@ static int dsa_switch_rcv(struct sk_buff *skb, struct net_device *dev,
 		nskb = dsa_software_vlan_untag(skb);
 		if (!nskb) {
 			kfree_skb(skb);
-			return 0;
+			return NULL;
 		}
 		skb = nskb;
 	}
@@ -118,13 +122,56 @@ static int dsa_switch_rcv(struct sk_buff *skb, struct net_device *dev,
 	dev_sw_netstats_rx_add(skb->dev, skb->len + ETH_HLEN);
 
 	if (dsa_skb_defer_rx_timestamp(p, skb))
-		return 0;
+		return NULL;
+
+	return skb;
+}
 
-	gro_cells_receive(&p->gcells, skb);
+static int dsa_switch_rcv(struct sk_buff *skb, struct net_device *dev,
+			  struct packet_type *pt, struct net_device *unused)
+{
+	struct dsa_user_priv *p;
 
+	skb = __dsa_switch_rcv(skb, dev);
+	if (skb) {
+		p = netdev_priv(skb->dev);
+		gro_cells_receive(&p->gcells, skb);
+	}
 	return 0;
 }
 
+/**
+ * dsa_switch_rcv_napi - a conduit's received frame onto its user port
+ * @skb: a frame its driver received on a DSA conduit, from the driver's own
+ *	NAPI poll: eth_type_trans() done (ETH_P_XDSA), not yet handed on
+ *
+ * What the receive path does for the frame on the conduit and then on the
+ * user port up to that port's GRO (dsa_switch_rcv() and gro_cells), for a
+ * conduit driver to hand the frame to napi_gro_receive() itself: one NAPI
+ * pass rather than the conduit's and then the user port's gro_cells' (an
+ * unthreaded NET_RX softirq). The caller makes sure nothing on the conduit
+ * would see the tagged frame on its way through the receive path there
+ * (taps, an rx_handler, tc or netfilter ingress, generic XDP, protocol
+ * handlers bound to it), and records the RX queue first.
+ *
+ * Return: the frame, on its user port (skb->dev), or NULL: consumed.
+ */
+struct sk_buff *dsa_switch_rcv_napi(struct sk_buff *skb)
+{
+	skb = __dsa_switch_rcv(skb, skb->dev);
+	if (!skb)
+		return NULL;
+
+	/* as gro_cells_receive() */
+	if (unlikely(!(skb->dev->flags & IFF_UP))) {
+		dev_core_stats_rx_dropped_inc(skb->dev);
+		kfree_skb(skb);
+		return NULL;
+	}
+	return skb;
+}
+EXPORT_SYMBOL_GPL(dsa_switch_rcv_napi);
+
 struct packet_type dsa_pack_type __read_mostly = {
 	.type	= cpu_to_be16(ETH_P_XDSA),
 	.func	= dsa_switch_rcv,
