From: MilkFlint <milkflint@localhost>
Date: Thu, 19 Nov 2026 16:30:00 +0000
Subject: [PATCH] net/sched: sch_cake: COBALT's count decays in a bounded number of steps

cobalt_should_drop() steps a flow's count down once for each
interval / sqrt(count) the flow was away, one step at a time. A flow back
after a long pause with a large count took as many steps in one dequeue
as it had counts to lose, however many that was, under the qdisc lock.

With more than a few dozen steps due and a count above 64, the count now
jumps to where the steps would take it. From C down to k they take
2 * interval * (sqrt(C) - sqrt(k)), plus half a step at k's end and less
half a step at C's (Euler-Maclaurin), with the rounding of the steps'
own arithmetic: the Newton step makes a step at count c longer by about
c / 2^34 of itself, and reciprocal_scale() about half a nanosecond
shorter. Square roots in fixed point. The jump stops two steps short, with
a quarter of a step to spare, so as never to take the count further than
the steps would, and the steps finish from there: about 64 at most. A
pause long enough for the whole decay sets the count to 0 at once, and
clears the flow's ECN state as the steps do. Small counts and short
pauses keep the steps, the same as before.

KUnit: against the steps, for counts from 65 to ten million and pauses up
to longer than a whole decay: the count within 2 (or 0.1%) of theirs and
never below, drop_next within two steps, at most about 64 steps after a
jump, the ECN state cleared with a whole decay; small counts and short
pauses as before.

---
--- a/net/sched/sch_cake.c
+++ b/net/sched/sch_cake.c
@@ -593,6 +593,74 @@ static ktime_t cobalt_control(ktime_t t,
 						rec_inv_sqrt));
 }
 
+/* The time COBALT's count takes to step down from @from to @to (0 < @to <
+ * @from) as cobalt_should_drop() steps it, interval / sqrt(c) for each c
+ * from @from - 1 down to @to: 2 * interval * (sqrt(from) - sqrt(to)), plus
+ * half a step at @to's end and less half a step at @from's. The Newton
+ * step's rounding makes a step at c longer by about c / 2^34 of itself,
+ * reciprocal_scale()'s rounding about half a nanosecond shorter. @r_from
+ * and @r_to are the square roots * 65536.
+ */
+static u64 cobalt_decay_time(u64 interval, u32 from, u32 to, u64 r_from, u64 r_to)
+{
+	u64 t = mul_u64_u64_div_u64(interval, 2 * (r_from - r_to), 1 << 16);
+
+	t += div64_u64(interval << 15, r_to) - div64_u64(interval << 15, r_from);
+	t += mul_u64_u64_div_u64(interval, (u64)from * r_from - (u64)to * r_to,
+				 3ULL << 49);
+	return t - min_t(u64, t, (from - to) / 2);
+}
+
+/* COBALT's count steps down once for each interval / sqrt(count) a flow
+ * was away (cobalt_should_drop()): one back after a long pause with a large
+ * count would take as many steps in one dequeue as it has counts to lose,
+ * however many that is. Past a few dozen, the count jumps instead to where
+ * the steps would take it in @elapsed (now - drop_next), by the time they
+ * take (cobalt_decay_time()), two steps short and with a quarter of a step
+ * to spare so as never to go further, and the steps go on from there: at
+ * most about 64 of them. @interval as cobalt_control() takes it.
+ */
+static void cobalt_decay_jump(struct cobalt_vars *vars, u32 interval, u64 elapsed)
+{
+	u64 r_from = int_sqrt64((u64)vars->count << 32), r_to, back, t;
+	u32 count = vars->count, to = 0;
+	int i;
+
+	if (!interval)
+		return;
+	/* all the way to 0 takes less than interval * (2 * sqrt(count) + 1) */
+	if (elapsed >= mul_u64_u64_div_u64(interval, 2 * r_from + (3 << 16), 1 << 16)) {
+		cobalt_set_count(vars, 0);
+		return;
+	}
+	/* 2 * interval * (sqrt(count) - sqrt(to)) is @elapsed; the steps take
+	 * a little longer, so they stop short of it: up from there until they
+	 * would get to it
+	 */
+	back = mul_u64_u64_div_u64(elapsed, 1 << 15, interval);
+	if (back < r_from)
+		to = ((r_from - back) * (r_from - back)) >> 32;
+	to = max(to, 64U);
+	for (i = 0; i < 3; i++) {
+		if (to + 2 >= count)
+			return;
+		r_to = int_sqrt64((u64)to << 32);
+		t = cobalt_decay_time(interval, count, to, r_from, r_to);
+		if (t > elapsed) {
+			to += mul_u64_u64_div_u64(t - elapsed, r_to, (u64)interval << 16) + 1;
+			continue;
+		}
+		to += 2;
+		r_to = int_sqrt64((u64)to << 32);
+		vars->drop_next = ktime_add_ns(vars->drop_next,
+					       cobalt_decay_time(interval, count, to,
+								 r_from, r_to) +
+					       div64_u64((u64)interval << 14, r_to));
+		cobalt_set_count(vars, to);
+		return;
+	}
+}
+
 /* Call this when a packet had to be dropped due to queue overflow.  Returns
  * true if the BLUE state was quiescent before but active after this call.
  */
@@ -743,6 +811,13 @@ static bool cobalt_should_drop(struct cobalt_vars *vars,
 						 vars->rec_inv_sqrt);
 		schedule = ktime_sub(now, vars->drop_next);
 	} else {
+		if (next_due && vars->count > 64 &&
+		    ktime_to_ns(schedule) > 32ULL * reciprocal_scale(p->interval,
+								     vars->rec_inv_sqrt)) {
+			cobalt_decay_jump(vars, p->interval, ktime_to_ns(schedule));
+			schedule = ktime_sub(now, vars->drop_next);
+			next_due = vars->count && ktime_to_ns(schedule) >= 0;
+		}
 		while (next_due) {
 			vars->count--;
 			cobalt_invsqrt(vars);
--- a/net/sched/sch_cake_test.c
+++ b/net/sched/sch_cake_test.c
@@ -4013,6 +4013,157 @@ static void cake_test_mq_drained_rests(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, weight, 0);
 }
 
+/* COBALT's decay as it was: a step down for each interval / sqrt(count)
+ * the flow was away, however many (cobalt_should_drop() without the jump)
+ */
+static void cake_test_decay_ref(struct cobalt_vars *v, u64 interval, ktime_t now)
+{
+	bool next_due = v->count && ktime_to_ns(ktime_sub(now, v->drop_next)) >= 0;
+
+	while (next_due) {
+		v->count--;
+		cobalt_invsqrt(v);
+		v->drop_next = cobalt_control(v->drop_next, interval, v->rec_inv_sqrt);
+		next_due = v->count && ktime_to_ns(ktime_sub(now, v->drop_next)) >= 0;
+	}
+	if (!v->count)
+		cobalt_ecn_reset(v);
+}
+
+/* Random counts from @lo to @hi (spread evenly on a log scale) and pauses
+ * of up to 1.2 times what a full decay takes, a third of them short ones:
+ * through cobalt_should_drop() with a packet under target, the count ends
+ * within 2 (or 0.1%) of the old loop's and never below it, drop_next within
+ * two steps of it, and from the jump on the steps number at most 70. A
+ * decay all the way down clears the flow's ECN state as the loop does.
+ */
+static void cake_test_decay_jump_range(struct kunit *test, u32 lo, u32 hi, int samples, u64 seed)
+{
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_TCP, 2, 40000, 0);
+	struct cobalt_params p = {
+		.interval = 100 * NSEC_PER_MSEC,
+		.target = 5 * NSEC_PER_MSEC,
+		.mtu_time = 12 * NSEC_PER_USEC,
+	};
+	u32 bad_count = 0, bad_next = 0, bad_steps = 0, bad_ecn = 0, jumps = 0;
+	u32 max_steps = 0, max_off = 0;
+	struct rnd_state rnd;
+	int i;
+
+	prandom_seed_state(&rnd, seed);
+	for (i = 0; i < samples; i++) {
+		u64 span = (u64)ilog2(hi) - ilog2(lo) + 1, full, gap;
+		u32 count, r = prandom_u32_state(&rnd);
+		struct cobalt_vars v = {}, ref, jmp;
+		ktime_t now;
+
+		/* log scale: a power of two in range, then a fraction of it */
+		count = clamp_t(u32, (1U << (ilog2(lo) + r % span)) +
+				     prandom_u32_state(&rnd) % (1U << (ilog2(lo) + r % span)),
+				lo, hi);
+		cobalt_set_count(&v, count);
+		v.ecn_ignored = true;
+		v.ecn_strikes = 3;
+		full = 2 * p.interval * int_sqrt(count);
+		gap = div_u64(full * (prandom_u32_state(&rnd) % 1200), 1000);
+		if (i % 3 == 0)
+			gap /= 20;
+		now = ns_to_ktime(gap);
+		ref = v;
+		jmp = v;
+
+		cake_test_decay_ref(&ref, p.interval, now);
+		cobalt_set_enqueue_time(skb, now);
+		cobalt_should_drop(&v, &p, now, skb, 0, 0);
+
+		/* the steps from the jump on */
+		if (jmp.count > 64 && gap > 32ULL * reciprocal_scale(p.interval, jmp.rec_inv_sqrt)) {
+			u32 from;
+
+			cobalt_decay_jump(&jmp, p.interval, gap);
+			from = jmp.count;
+			jumps += from != count;
+			cake_test_decay_ref(&jmp, p.interval, now);
+			max_steps = max(max_steps, from - jmp.count);
+			bad_steps += from - jmp.count > 70;
+		}
+
+		max_off = max(max_off, v.count - min(v.count, ref.count));
+		if (v.count < ref.count ||
+		    v.count - ref.count > max_t(u32, 2, ref.count / 1000)) {
+			bad_count++;
+			kunit_info(test, "count %u, %llu ns away: %u, the loop %u", count, gap,
+				   v.count, ref.count);
+		}
+		if (ref.count) {
+			u64 step = div_u64(p.interval, int_sqrt(ref.count));
+
+			bad_next += abs_diff(ktime_to_ns(v.drop_next), ktime_to_ns(ref.drop_next)) >
+				    2 * step;
+		} else {
+			bad_ecn += v.ecn_ignored || v.ecn_strikes;
+		}
+	}
+	kunit_info(test, "counts %u to %u: %d pauses, %u jumps, at most %u steps after one, %u counts above the loop's at most",
+		   lo, hi, samples, jumps, max_steps, max_off);
+	KUNIT_EXPECT_EQ(test, bad_count, 0);
+	KUNIT_EXPECT_EQ(test, bad_next, 0);
+	KUNIT_EXPECT_EQ(test, bad_steps, 0);
+	KUNIT_EXPECT_EQ(test, bad_ecn, 0);
+	KUNIT_EXPECT_GT(test, jumps, samples / 3);
+}
+
+static void cake_test_decay_jump(struct kunit *test)
+{
+	cake_test_decay_jump_range(test, 65, 100000, 100, 7628);
+}
+
+/* the same into the millions, where the old loop takes a while */
+static void cake_test_decay_jump_large(struct kunit *test)
+{
+	cake_test_decay_jump_range(test, 100000, 10000000, 3, 7629);
+}
+
+/* Small counts, and pauses of fewer than 32 steps, take the steps one at a
+ * time, as before: the same count, 1/sqrt and drop_next as the old loop's
+ */
+static void cake_test_decay_small(struct kunit *test)
+{
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_TCP, 2, 40000, 0);
+	struct cobalt_params p = {
+		.interval = 100 * NSEC_PER_MSEC,
+		.target = 5 * NSEC_PER_MSEC,
+		.mtu_time = 12 * NSEC_PER_USEC,
+	};
+	u32 count, gap, bad = 0;
+
+	/* up to 2.5 intervals away: under 32 steps from a count of 128 */
+	for (count = 1; count <= 128; count++) {
+		for (gap = 1; gap <= 25; gap += 3) {
+			struct cobalt_vars v = {}, ref;
+			ktime_t now = ns_to_ktime(div_u64(p.interval * gap, 10));
+
+			cobalt_set_count(&v, count);
+			ref = v;
+			cake_test_decay_ref(&ref, p.interval, now);
+			cobalt_set_enqueue_time(skb, now);
+			cobalt_should_drop(&v, &p, now, skb, 0, 0);
+			bad += v.count != ref.count || v.rec_inv_sqrt != ref.rec_inv_sqrt ||
+			       (ref.count && v.drop_next != ref.drop_next);
+		}
+	}
+	KUNIT_EXPECT_EQ(test, bad, 0);
+
+	/* an interval that cobalt_control()'s u32 makes 0: no jump */
+	{
+		struct cobalt_vars v = {};
+
+		cobalt_set_count(&v, 5000);
+		cobalt_decay_jump(&v, 0, NSEC_PER_SEC);
+		KUNIT_EXPECT_EQ(test, v.count, 5000);
+	}
+}
+
 static int cake_test_init(struct kunit *test)
 {
 	int i;
@@ -4077,6 +4228,9 @@ static struct kunit_case cake_test_cases[] = {
 	KUNIT_CASE(cake_test_ecn_off),
 	KUNIT_CASE(cake_test_ecn_gso_dropped),
 	KUNIT_CASE(cake_test_ecn_decays_back),
+	KUNIT_CASE(cake_test_decay_small),
+	KUNIT_CASE(cake_test_decay_jump),
+	KUNIT_CASE_SLOW(cake_test_decay_jump_large),
 	KUNIT_CASE(cake_test_mq_marks_its_queue),
 	KUNIT_CASE(cake_test_mq_count_back_from_idle),
 	KUNIT_CASE(cake_test_mq_count_real_queues),
