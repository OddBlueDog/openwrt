From: MilkFlint <milkflint@localhost>
Date: Thu, 19 Nov 2026 16:10:00 +0000
Subject: [PATCH] net/sched: sch_cake: flows at rest wait off the dequeue's path

A flow that runs out of packets stays in the flowchain for an interval
after its last packet even with no AQM state left: cobalt_should_drop()
sets drop_next then, and cake_flow_emptied() keeps the flow until it.
That is worth keeping, as the flow keeps its queue and host slots for
its next packet. But it waited with the decaying flows, and
cake_dequeue() visits the first of those before each packet it sends:
it found the flow empty, moved it to the tail and started again from the
shaper's check and the choice of tin. On a queue with any traffic there
is always such a flow, so nearly every packet took that detour.

Such flows now wait on a list of their own, the resting flows, in the
order they came to rest, and cake_dequeue() doesn't visit them: once it
has chosen a tin, it lets go of up to two at the head of the list whose
time is up. A flow with AQM state left still waits with the decaying
flows and decays a step at each dequeue, as before, so COBALT's timing
is the same. A packet for a resting flow takes it back to the new flows
with its queue and hosts as they were. Both lists count as the decaying
flows in the stats.

A flow taken from the decaying flows now goes straight to
cake_flow_emptied(), whatever its deficit: a flow on either list holds no
packets. One out of deficit went round the bulk rotation empty first, and
under cake_mq counted in its sub-queue's bid meanwhile: cake_mq_drained()
leaves that way any sparse flow whose packet was larger than its quantum.

KUnit: a flow at rest leaves at its time and not before; a packet for it
finds its queue and hosts with a direct hit; a flow with AQM state left
decays a step a dequeue, out of deficit or not, never through the bulk
rotation; under cake_mq a drained sparse flow rests, out of the bulk
rotation and the bid.

---
--- a/net/sched/sch_cake.c
+++ b/net/sched/sch_cake.c
@@ -190,7 +190,10 @@ struct cake_tin_data {
 	u32	max_skblen;
 
 	struct list_head new_flows;
+	/* empty flows whose AQM state is still decaying, visited one a dequeue */
 	struct list_head decaying_flows;
+	/* empty flows at rest, kept until their timeout: cake_flow_emptied() */
+	struct list_head resting_flows;
 	/* the bulk rotation, a slot for each pass to come: cake_bulk_park() */
 	struct list_head old_wheel[CAKE_WHEEL_SLOTS];
 	u32	wheel_mask;	/* the slots that may hold flows */
@@ -1028,6 +1031,7 @@ static void cake_init_flowchains(struct cake_tin_data *b)
 
 	INIT_LIST_HEAD(&b->new_flows);
 	INIT_LIST_HEAD(&b->decaying_flows);
+	INIT_LIST_HEAD(&b->resting_flows);
 	for (i = 0; i < CAKE_WHEEL_SLOTS; i++)
 		INIT_LIST_HEAD(&b->old_wheel[i]);
 	b->wheel_mask = 0;
@@ -2851,6 +2855,14 @@ static void cake_clear_tin(struct Qdisc *sch, u16 tin)
 
 /* A flow found with no packets leaves its rotation: to the decaying flows
  * while its AQM state is still active, or out of the flowchain.
+ *
+ * A flow with no AQM state left still waits one interval after its last
+ * packet (cobalt_should_drop() sets drop_next then), keeping its queue and
+ * host slots for its next packet. It waits with the resting flows, which
+ * cake_dequeue() doesn't visit: it only lets them go once their time is up
+ * (cake_expire_resting()). Visited with the decaying flows, as before,
+ * each would have cost every dequeue a detour, and on any busy queue
+ * there's always one.
  */
 static void cake_flow_emptied(struct cake_sched_data *q,
 			      struct cake_tin_data *b,
@@ -2868,7 +2880,8 @@ static void cake_flow_emptied(struct cake_sched_data *q,
 		 * decayed to rest
 		 */
 		list_move_tail(&flow->flowchain,
-			       &b->decaying_flows);
+			       flow->cvars.p_drop || flow->cvars.count ?
+			       &b->decaying_flows : &b->resting_flows);
 		if (flow->set == CAKE_SET_BULK) {
 			b->bulk_flow_count--;
 
@@ -2900,6 +2913,26 @@ static void cake_flow_emptied(struct cake_sched_data *q,
 	}
 }
 
+/* The resting flows whose time is up leave the flowchain, two at most each
+ * time: they're in about the order their times are up, and one that's a
+ * little out of order waits for the one ahead of it
+ */
+static void cake_expire_resting(struct cake_tin_data *b, ktime_t now)
+{
+	struct cake_flow *flow;
+	int i;
+
+	for (i = 0; i < 2 && !list_empty(&b->resting_flows); i++) {
+		flow = list_first_entry(&b->resting_flows, struct cake_flow,
+					flowchain);
+		if (ktime_before(now, flow->cvars.drop_next))
+			return;
+		list_del_init(&flow->flowchain);
+		flow->set = CAKE_SET_NONE;
+		b->decaying_flow_count--;
+	}
+}
+
 /* cake_mq: retire a tin's bulk rotation, every flow in it empty, as the
  * next dequeue would find each one
  */
@@ -3116,6 +3149,8 @@ begin:
 			return NULL;
 	}
 
+	cake_expire_resting(b, now);
+
 retry:
 	/* service this class */
 	head = &b->decaying_flows;
@@ -3132,15 +3167,19 @@ retry:
 	}
 	flow = list_first_entry(head, struct cake_flow, flowchain);
 found:
-	q->cur_flow = flow - b->flows;
 	first_flow = false;
+	if (head == &b->decaying_flows) {
+		/* it has no packets: its AQM state decays a step, and it goes
+		 * nowhere near the bulk rotation, whatever its deficit
+		 */
+		cake_flow_emptied(q, b, flow, now);
+		goto begin;
+	}
+	q->cur_flow = flow - b->flows;
 
 	/* flow isolation (DRR++) */
 	if (flow->deficit <= 0) {
-		/* Keep all flows with deficits out of the sparse and decaying
-		 * rotations.  No non-empty flow can go into the decaying
-		 * rotation, so they can't get deficits
-		 */
+		/* Keep all flows with deficits out of the sparse rotation */
 		if (flow->set == CAKE_SET_SPARSE) {
 			if (flow->head) {
 				b->sparse_flow_count--;
--- a/net/sched/sch_cake_test.c
+++ b/net/sched/sch_cake_test.c
@@ -3810,6 +3810,204 @@ static void cake_test_wheel_live(struct kunit *test)
 				    f, flow[f], host[1]);
 }
 
+/* @n packets from host @host, each @len to CAKE, made before bottom halves
+ * go off; whoever they go to owns them
+ */
+static void cake_test_pkts(struct kunit *test, struct sk_buff **skb, int n, u8 host, u32 len)
+{
+	int i;
+
+	for (i = 0; i < n; i++) {
+		skb[i] = cake_test_skb(test, false, IPPROTO_UDP, host, 41000, 0);
+		kunit_remove_action(test, cake_test_free_skb, skb[i]);
+		qdisc_skb_cb(skb[i])->pkt_len = len;
+	}
+}
+
+/* @skb into @sch as it is (its length to CAKE already set) */
+static bool cake_test_in(struct Qdisc *sch, struct sk_buff *skb)
+{
+	struct sk_buff *to_free = NULL;
+	int ret = cake_enqueue(skb, sch, &to_free);
+
+	kfree_skb_list(to_free);
+	return ret == NET_XMIT_SUCCESS && !to_free;
+}
+
+/* the next packet out of @sch is @skb: freed */
+static bool cake_test_out(struct Qdisc *sch, struct sk_buff *skb)
+{
+	struct sk_buff *out = cake_dequeue(sch);
+
+	kfree_skb(out);
+	return out && out == skb;
+}
+
+/* A flow with no AQM state that runs out of packets rests until its
+ * timeout, not visited meanwhile, and then leaves the flowchain; a packet
+ * for it before then finds its queue and hosts as they were, without
+ * working out its hash again
+ */
+static void cake_test_resting_flow(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 0, CAKE_DIFFSERV_BESTEFFORT);
+	struct cake_tin_data *b = &q->tins[0];
+	struct Qdisc *sch = mq->sch[0];
+	bool ok = true, rests[3], back, gone;
+	struct sk_buff *x[2], *y[4];
+	u16 src, dst, decaying[4];
+	struct cake_flow *fx;
+	u32 directs;
+
+	cake_test_pkts(test, x, 2, 5, 100);
+	cake_test_pkts(test, y, 4, 6, 100);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	rcu_read_lock_bh();
+	ok &= cake_test_in(sch, x[0]);
+	fx = list_first_entry(&b->new_flows, struct cake_flow, flowchain);
+	ok &= cake_test_out(sch, x[0]);
+	/* the next dequeue finds it empty */
+	ok &= cake_test_in(sch, y[0]) && cake_test_out(sch, y[0]);
+	rests[0] = fx->set == CAKE_SET_DECAYING && b->resting_flows.next == &fx->flowchain &&
+		   list_empty(&b->decaying_flows);
+	decaying[0] = b->decaying_flow_count;
+
+	/* a packet before its time is up: the same queue and hosts, found at once */
+	src = fx->srchost;
+	dst = fx->dsthost;
+	directs = b->way_directs;
+	ok &= cake_test_in(sch, x[1]);
+	back = fx->set == CAKE_SET_SPARSE && b->new_flows.prev == &fx->flowchain &&
+	       fx->srchost == src && fx->dsthost == dst && b->way_directs == directs + 1 &&
+	       list_empty(&b->resting_flows);
+	decaying[1] = b->decaying_flow_count;
+	ok &= cake_test_out(sch, x[1]);
+	ok &= cake_test_in(sch, y[1]) && cake_test_out(sch, y[1]);
+	rests[1] = b->resting_flows.next == &fx->flowchain;
+
+	/* not before its time */
+	fx->cvars.drop_next = ktime_add_ms(ktime_get(), 1000);
+	ok &= cake_test_in(sch, y[2]) && cake_test_out(sch, y[2]);
+	rests[2] = b->resting_flows.next == &fx->flowchain;
+	decaying[2] = b->decaying_flow_count;
+
+	/* then out */
+	fx->cvars.drop_next = ktime_sub_ns(ktime_get(), 1);
+	ok &= cake_test_in(sch, y[3]) && cake_test_out(sch, y[3]);
+	gone = fx->set == CAKE_SET_NONE && list_empty(&fx->flowchain) &&
+	       list_empty(&b->resting_flows);
+	decaying[3] = b->decaying_flow_count;
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_TRUE(test, rests[0]);
+	KUNIT_EXPECT_EQ(test, decaying[0], 1);
+	KUNIT_EXPECT_TRUE(test, back);
+	KUNIT_EXPECT_EQ(test, decaying[1], 0);
+	KUNIT_EXPECT_TRUE(test, rests[1]);
+	KUNIT_EXPECT_TRUE(test, rests[2]);
+	KUNIT_EXPECT_EQ(test, decaying[2], 1);
+	KUNIT_EXPECT_TRUE(test, gone);
+	KUNIT_EXPECT_EQ(test, decaying[3], 0);
+}
+
+/* A flow that runs out of packets with AQM state left decays a step at
+ * each dequeue, as before, and goes nowhere near the bulk rotation, even
+ * out of deficit
+ */
+static void cake_test_decaying_steps(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 0, CAKE_DIFFSERV_BESTEFFORT);
+	struct cake_tin_data *b = &q->tins[0];
+	struct Qdisc *sch = mq->sch[0];
+	struct sk_buff *z, *y[3];
+	bool ok = true, decaying[2], wheel = false;
+	struct cake_flow *fz;
+	u32 count[3];
+	int i;
+
+	cake_test_pkts(test, &z, 1, 7, 100);
+	cake_test_pkts(test, y, 3, 6, 100);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	rcu_read_lock_bh();
+	ok &= cake_test_in(sch, z);
+	fz = list_first_entry(&b->new_flows, struct cake_flow, flowchain);
+	ok &= cake_test_out(sch, z);
+	/* a count of 3, its steps long overdue */
+	cobalt_set_count(&fz->cvars, 3);
+	fz->cvars.drop_next = ktime_sub_ms(ktime_get(), 10000);
+	for (i = 0; i < 3; i++)
+		ok &= cake_test_in(sch, y[i]);
+	for (i = 0; i < 3; i++) {
+		ok &= cake_test_out(sch, y[i]);
+		count[i] = fz->cvars.count;
+		if (i < 2)
+			decaying[i] = fz->set == CAKE_SET_DECAYING &&
+				      b->decaying_flows.next == &fz->flowchain;
+		/* out of deficit while it decays */
+		fz->deficit = -5000 << CAKE_DEFICIT_SHIFT;
+		wheel |= cake_bulk_any(b);
+	}
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_EQ(test, count[0], 2);
+	KUNIT_EXPECT_EQ(test, count[1], 1);
+	KUNIT_EXPECT_EQ(test, count[2], 0);
+	KUNIT_EXPECT_TRUE(test, decaying[0]);
+	KUNIT_EXPECT_TRUE(test, decaying[1]);
+	KUNIT_EXPECT_FALSE(test, wheel);
+	KUNIT_EXPECT_EQ(test, fz->set, CAKE_SET_NONE);
+	KUNIT_EXPECT_EQ(test, b->decaying_flow_count, 0);
+}
+
+/* cake_mq: a sparse flow whose packet was larger than its quantum, let go
+ * as its sub-cake drains, rests; the dequeues after that don't send it
+ * round the bulk rotation empty, counted in the sub-cake's bid
+ */
+static void cake_test_mq_drained_rests(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_mq_live(test, mq, 1);
+	struct cake_tin_data *b = &q->tins[0];
+	struct Qdisc *sch = mq->sch[1];
+	bool ok = true, rests[2], wheel = false;
+	struct sk_buff *s, *y[3];
+	u32 weight = 0;
+	struct cake_flow *fs;
+	int i;
+
+	cake_test_pkts(test, &s, 1, 5, 4000);
+	cake_test_pkts(test, y, 3, 6, 100);
+
+	rcu_read_lock_bh();
+	ok &= cake_test_in(sch, s);
+	fs = list_first_entry(&b->new_flows, struct cake_flow, flowchain);
+	ok &= cake_test_out(sch, s);
+	ok &= !cake_dequeue(sch);
+	rests[0] = fs->set == CAKE_SET_DECAYING && b->resting_flows.next == &fs->flowchain &&
+		   fs->deficit < 0;
+	for (i = 0; i < 3; i++)
+		ok &= cake_test_in(sch, y[i]);
+	for (i = 0; i < 3; i++) {
+		ok &= cake_test_out(sch, y[i]);
+		wheel |= cake_bulk_any(b);
+		weight |= b->mq_weight;
+	}
+	rests[1] = b->resting_flows.next == &fs->flowchain;
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_TRUE(test, rests[0]);
+	KUNIT_EXPECT_TRUE(test, rests[1]);
+	KUNIT_EXPECT_FALSE(test, wheel);
+	KUNIT_EXPECT_EQ(test, weight, 0);
+}
+
 static int cake_test_init(struct kunit *test)
 {
 	int i;
@@ -3898,6 +4096,9 @@ static struct kunit_case cake_test_cases[] = {
 	KUNIT_CASE(cake_test_mq_drained),
 	KUNIT_CASE(cake_test_mq_drained_sparse),
 	KUNIT_CASE(cake_test_empty_no_watchdog),
+	KUNIT_CASE(cake_test_resting_flow),
+	KUNIT_CASE(cake_test_decaying_steps),
+	KUNIT_CASE(cake_test_mq_drained_rests),
 	KUNIT_CASE(cake_test_mq_host_table_matches),
 	KUNIT_CASE(cake_test_autorate_throttled),
 	KUNIT_CASE(cake_test_change_refused),
