From: MilkFlint <milkflint@localhost>
Date: Thu, 19 Nov 2026 17:25:00 +0000
Subject: [PATCH] net/sched: sch_cake: dscp_restore keeps a flow's DSCP for its next packets

With dscp_restore, every packet a washing CAKE got from a device's
ingress looked its connection up in conntrack for the DSCP to give it: its
tuple parsed, a hash table searched and a reference taken and dropped,
most of the time spent classifying a download's packet.

In besteffort the tin doesn't depend on the DSCP, so the queue is now
found first, and when it's a flow's own (a per-flow mode, no filter chose
it) what the connection gave is kept in a memo for the queue: the flow's
next 31 packets, within about 100 ms, take it without a lookup. The memo
holds the queue's tag, so a queue that has gone to another flow looks up
again, and a lookup that finds no connection isn't kept. A DSCP the LAN
host changes reaches the flow's packets up to 31 packets or about 100 ms
later. Diffserv modes, host-only modes and queues a filter chose look up
for every packet, as before.

The memo is 12 bytes a queue, 12 KB a CAKE; the qdisc's allocation stays
in the same kmalloc size.

KUnit: a flow's packets keep its DSCP for 31 packets and about 100 ms,
then look it up again; another flow has its own; a packet given it is
written as before (a CE mark kept, the IPv4 checksum right); a queue gone
to another flow, or after a lookup that found nothing, looks up; diffserv4
and the host-only modes look up for every packet; the memo is used only
where a lookup would be made.

---
--- a/net/sched/sch_cake.c
+++ b/net/sched/sch_cake.c
@@ -163,6 +163,17 @@ struct cake_heap_entry {
 	u16 t:3, b:10;
 };
 
+/* What a queue's packets took from conntrack for dscp_restore, kept for its
+ * next CAKE_DSCP_KEEP - 1 packets while it's under CAKE_DSCP_KEEP_TICKS old:
+ * cake_restore_memo()
+ */
+struct cake_dscp_memo {
+	u32	tag;	/* the queue's flow when it was looked up */
+	u32	at;	/* when, in units of 2^CAKE_DSCP_KEEP_SHIFT ns */
+	u8	dscp;
+	u8	left;	/* packets that may still take it */
+};
+
 struct cake_tin_data {
 	struct cake_flow flows[CAKE_QUEUES];
 	u32	backlogs[CAKE_QUEUES];
@@ -329,6 +340,8 @@ struct cake_sched_data {
 	 */
 	struct cake_sched_config initial_config;
 	struct cake_heap_entry overflow_heap[CAKE_QUEUES * CAKE_MAX_TINS];
+	/* dscp_restore in besteffort: each queue's last lookup */
+	struct cake_dscp_memo dscp_memo[CAKE_QUEUES];
 };
 
 enum {
@@ -2358,6 +2371,61 @@ static u8 cake_wash_diffserv(struct sk_buff *skb)
 	return to;
 }
 
+/* In besteffort the tin doesn't depend on the DSCP, so the queue can be
+ * found first, and when it's a flow's own (a per-flow mode, no filter
+ * chose it) what its connection gave is kept for the flow's next packets:
+ * one conntrack lookup in CAKE_DSCP_KEEP packets, or one each
+ * CAKE_DSCP_KEEP_TICKS (about 100 ms) for a slower flow, instead of one a
+ * packet. A DSCP the other end changes reaches the flow's packets that
+ * much later; a lookup that finds no connection isn't kept.
+ */
+#define CAKE_DSCP_KEEP		32
+#define CAKE_DSCP_KEEP_SHIFT	20
+#define CAKE_DSCP_KEEP_TICKS	96
+
+static bool cake_dscp_memo_on(const struct cake_sched_config *q,
+			      const struct sk_buff *skb, int flow_mode,
+			      u16 flow_override)
+{
+	__be16 proto;
+
+	if (q->tin_mode != CAKE_DIFFSERV_BESTEFFORT ||
+	    !(q->rate_flags & CAKE_FLAG_WASH) || flow_override ||
+	    !(flow_mode & CAKE_FLOW_FLOWS) || !READ_ONCE(dscp_restore) ||
+	    !cake_redirected_from_ingress(skb))
+		return false;
+
+	proto = skb_protocol(skb, true);
+	return proto == htons(ETH_P_IP) || proto == htons(ETH_P_IPV6);
+}
+
+/* cake_wash_diffserv() for queue @idx of tin @b, through its memo */
+static void cake_restore_memo(struct cake_sched_data *q, struct cake_tin_data *b,
+			      u32 idx, struct sk_buff *skb, ktime_t now)
+{
+	struct cake_dscp_memo *m = &q->dscp_memo[idx];
+	u32 at = (u64)now >> CAKE_DSCP_KEEP_SHIFT;
+	u8 to = 0;
+
+	if (m->left && m->tag == b->tags[idx] &&
+	    at - m->at < CAKE_DSCP_KEEP_TICKS) {
+		m->left--;
+		cake_handle_diffserv(skb, true, m->dscp);
+		return;
+	}
+
+	m->left = 0;
+	if (nf_ct_get_peer_dscp(skb, &to)) {
+		m->tag = b->tags[idx];
+		m->at = at;
+		m->dscp = to;
+		m->left = CAKE_DSCP_KEEP - 1;
+	} else {
+		to = 0;
+	}
+	cake_handle_diffserv(skb, true, to);
+}
+
 static struct cake_tin_data *cake_select_tin(struct Qdisc *sch,
 					     struct sk_buff *skb)
 {
@@ -2400,7 +2468,8 @@ static struct cake_tin_data *cake_select_tin(struct Qdisc *sch,
 }
 
 static u32 cake_classify(struct Qdisc *sch, struct cake_tin_data **t,
-			 struct sk_buff *skb, int flow_mode, int *qerr)
+			 struct sk_buff *skb, int flow_mode, int *qerr,
+			 ktime_t now)
 {
 	struct cake_sched_data *q = qdisc_priv(sch);
 	struct tcf_proto *filter;
@@ -2433,6 +2502,14 @@ static u32 cake_classify(struct Qdisc *sch, struct cake_tin_data **t,
 			host = TC_H_MAJ(res.classid) >> 16;
 	}
 hash:
+	if (cake_dscp_memo_on(q->config, skb, flow_mode, flow)) {
+		u32 idx;
+
+		*t = &q->tins[0];
+		idx = cake_hash(*t, skb, flow_mode, flow, host);
+		cake_restore_memo(q, *t, idx, skb, now);
+		return idx + 1;
+	}
 	*t = cake_select_tin(sch, skb);
 	return cake_hash(*t, skb, flow_mode, flow, host) + 1;
 }
@@ -2736,7 +2813,7 @@ static s32 cake_enqueue(struct sk_buff *skb, struct Qdisc *sch,
 	bool same_flow = false;
 
 	/* choose flow to insert into */
-	idx = cake_classify(sch, &b, skb, q->config->flow_mode, &ret);
+	idx = cake_classify(sch, &b, skb, q->config->flow_mode, &ret, now);
 	if (idx == 0) {
 		if (ret & __NET_XMIT_BYPASS)
 			qdisc_qstats_drop(sch);
--- a/net/sched/sch_cake_test.c
+++ b/net/sched/sch_cake_test.c
@@ -2029,21 +2029,29 @@ static void cake_test_dscp_restore_set(struct kunit *test, bool on)
 }
 
 /* A download from the internet, through ifb from wan's ingress: its entry's
- * reply direction, the LAN host having sent with @sent
+ * reply direction, LAN host @host's connection, the host having sent with
+ * @sent; with no entry (none in conntrack) if @sent is negative
  */
-static struct sk_buff *cake_test_download(struct kunit *test, u8 sent)
+static struct sk_buff *cake_test_download_host(struct kunit *test, u8 host, int sent)
 {
-	struct sk_buff *skb = cake_test_nat_skb(test, 2, 61002, true, 0);
+	struct sk_buff *skb = cake_test_nat_skb(test, host, 61000 + host, sent >= 0, 0);
 	enum ip_conntrack_info ctinfo;
 	struct nf_conn *ct = nf_ct_get(skb, &ctinfo);
 
-	ct->dscp[IP_CT_DIR_ORIGINAL] = sent;
-	nf_ct_set(skb, ct, IP_CT_ESTABLISHED_REPLY);
+	if (ct) {
+		ct->dscp[IP_CT_DIR_ORIGINAL] = sent;
+		nf_ct_set(skb, ct, IP_CT_ESTABLISHED_REPLY);
+	}
 	skb->redirected = 1;
 	skb->from_ingress = 1;
 	return skb;
 }
 
+static struct sk_buff *cake_test_download(struct kunit *test, u8 sent)
+{
+	return cake_test_download_host(test, 2, sent);
+}
+
 /* The restored DSCP goes on the packet and picks the tin, over whatever the
  * internet set, and a CE mark survives it.
  */
@@ -4837,6 +4845,183 @@ static void cake_test_sparse_ahead_mq(struct kunit *test)
 }
 #endif
 
+#if IS_ENABLED(CONFIG_NF_CONNTRACK) && defined(CONFIG_NET_REDIRECT)
+/* --- dscp_restore's memo --------------------------------------------------- */
+
+/* Sub-cake @i of @mq as a download's CAKE that washes, in @tin_mode with
+ * @flow_mode, dscp_restore on
+ */
+static struct cake_sched_data *cake_test_memo_cake(struct kunit *test, struct cake_test_mq *mq,
+						   int i, u8 tin_mode, int flow_mode)
+{
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, i, 12500000, tin_mode);
+
+	q->config->rate_flags |= CAKE_FLAG_WASH;
+	q->config->flow_mode = flow_mode;
+	cake_test_dscp_restore_set(test, true);
+	return q;
+}
+
+/* The DSCP @skb leaves sub-cake @i's cake_classify() with at @now, having
+ * come with DS field @dsfield; its tin in @tin
+ */
+static u8 cake_test_memo_dscp(struct cake_test_mq *mq, int i, struct sk_buff *skb,
+			      u8 dsfield, ktime_t now, u32 *tin)
+{
+	struct cake_sched_data *q = cake_test_mq_q(mq, i);
+	struct cake_tin_data *b = NULL;
+	int ret;
+
+	cake_test_set_dsfield(skb, dsfield);
+	rcu_read_lock_bh();
+	cake_classify(mq->sch[i], &b, skb, q->config->flow_mode, &ret, now);
+	rcu_read_unlock_bh();
+	if (tin)
+		*tin = b ? b - q->tins : U32_MAX;
+	return cake_test_dsfield(skb) >> 2;
+}
+
+/* In besteffort a flow's next 31 packets, within about 100 ms, take what its
+ * connection gave, without a lookup; another flow has its own, and a packet
+ * that takes it is written as cake_wash_diffserv() writes one.
+ */
+static void cake_test_dscp_memo(struct kunit *test)
+{
+	ktime_t now = ktime_get(), later = ktime_add_ms(now, 105);
+	struct cake_test_mq *mq;
+	struct sk_buff *skb;
+	u8 got[CAKE_DSCP_KEEP];
+	int i;
+
+	if (!rcu_access_pointer(nf_ct_hook))
+		kunit_skip(test, "nf_conntrack isn't loaded");
+	mq = cake_test_mq_alloc(test);
+	cake_test_memo_cake(test, mq, 0, CAKE_DIFFSERV_BESTEFFORT,
+			    CAKE_FLOW_TRIPLE | CAKE_FLOW_NAT_FLAG);
+
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, cake_test_download(test, 46), 0,
+						  now, NULL), 46);
+	/* the host sends with AF41 now: the flow's next 31 packets keep EF */
+	for (i = 1; i < CAKE_DSCP_KEEP; i++)
+		got[i] = cake_test_memo_dscp(mq, 0, cake_test_download(test, 34), 0, now, NULL);
+	for (i = 1; i < CAKE_DSCP_KEEP; i++)
+		KUNIT_EXPECT_EQ_MSG(test, got[i], 46, "packet %d", i);
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, cake_test_download(test, 34), 0,
+						  now, NULL), 34);
+
+	/* kept under about 100 ms, looked up again after */
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, cake_test_download(test, 10), 0,
+						  ktime_add_ms(now, 95), NULL), 34);
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, cake_test_download(test, 10), 0,
+						  later, NULL), 10);
+
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, cake_test_download_host(test, 3, 26), 0,
+						  later, NULL), 26);
+
+	skb = cake_test_download(test, 0);
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, skb, 48 << 2 | INET_ECN_CE, later, NULL), 10);
+	KUNIT_EXPECT_EQ(test, cake_test_dsfield(skb), 10 << 2 | INET_ECN_CE);
+	KUNIT_EXPECT_EQ(test, ip_fast_csum(ip_hdr(skb), ip_hdr(skb)->ihl), 0);
+}
+
+/* The memo is its queue's flow's: a queue that's gone to another flow looks
+ * its connection up, and a lookup that found none isn't kept.
+ */
+static void cake_test_dscp_memo_tag(struct kunit *test)
+{
+	static const u32 tag[] = { 0x1234, 0x1234, 0x5678, 0x9abc, 0x9abc };
+	static const int sent[] = { 46, 34, 34, -1, 46 };
+	static const u8 want[] = { 46, 46, 34, 0, 46 };
+	ktime_t now = ktime_get();
+	struct sk_buff *skb[ARRAY_SIZE(sent)];
+	u8 got[ARRAY_SIZE(sent)];
+	struct cake_sched_data *q;
+	struct cake_tin_data *b;
+	int i;
+
+	if (!rcu_access_pointer(nf_ct_hook))
+		kunit_skip(test, "nf_conntrack isn't loaded");
+	q = cake_test_memo_cake(test, cake_test_mq_alloc(test), 0, CAKE_DIFFSERV_BESTEFFORT,
+				CAKE_FLOW_TRIPLE);
+	b = &q->tins[0];
+	for (i = 0; i < ARRAY_SIZE(sent); i++) {
+		skb[i] = cake_test_download_host(test, 2, sent[i]);
+		cake_test_set_dsfield(skb[i], 48 << 2);
+	}
+
+	rcu_read_lock_bh();
+	for (i = 0; i < ARRAY_SIZE(sent); i++) {
+		b->tags[7] = tag[i];
+		cake_restore_memo(q, b, 7, skb[i], now);
+		got[i] = cake_test_dsfield(skb[i]) >> 2;
+	}
+	rcu_read_unlock_bh();
+
+	for (i = 0; i < ARRAY_SIZE(sent); i++)
+		KUNIT_EXPECT_EQ_MSG(test, got[i], want[i], "packet %d", i);
+}
+
+/* Where the tin goes by the DSCP, or a queue isn't one flow's, every packet
+ * looks its connection up, as before; and the memo is used only where
+ * cake_wash_diffserv() would look one up.
+ */
+static void cake_test_dscp_memo_off(struct kunit *test)
+{
+	static const struct {
+		u8 tin_mode;
+		int flow_mode;
+	} c[] = {
+		{ CAKE_DIFFSERV_DIFFSERV4, CAKE_FLOW_TRIPLE | CAKE_FLOW_NAT_FLAG },
+		{ CAKE_DIFFSERV_BESTEFFORT, CAKE_FLOW_DST_IP },
+		{ CAKE_DIFFSERV_BESTEFFORT, CAKE_FLOW_HOSTS | CAKE_FLOW_NAT_FLAG },
+	};
+	ktime_t now = ktime_get();
+	struct cake_sched_data *q = NULL;
+	struct cake_test_mq *mq;
+	struct sk_buff *skb;
+	u32 tin[2];
+	int i;
+
+	if (!rcu_access_pointer(nf_ct_hook))
+		kunit_skip(test, "nf_conntrack isn't loaded");
+	mq = cake_test_mq_alloc(test);
+	for (i = 0; i < ARRAY_SIZE(c); i++) {
+		q = cake_test_memo_cake(test, mq, i, c[i].tin_mode, c[i].flow_mode);
+		KUNIT_EXPECT_EQ_MSG(test, cake_test_memo_dscp(mq, i, cake_test_download(test, 46),
+							      0, now, &tin[0]), 46, "case %d", i);
+		KUNIT_EXPECT_EQ_MSG(test, cake_test_memo_dscp(mq, i, cake_test_download(test, 34),
+							      0, now, &tin[1]), 34, "case %d", i);
+		if (c[i].tin_mode == CAKE_DIFFSERV_DIFFSERV4) {
+			KUNIT_EXPECT_EQ(test, tin[0], q->tin_index[46]);
+			KUNIT_EXPECT_EQ(test, tin[1], q->tin_index[34]);
+			KUNIT_EXPECT_NE(test, tin[0], tin[1]);
+		}
+	}
+
+	q = cake_test_memo_cake(test, mq, ARRAY_SIZE(c), CAKE_DIFFSERV_BESTEFFORT,
+				CAKE_FLOW_TRIPLE);
+	skb = cake_test_download(test, 46);
+	KUNIT_EXPECT_TRUE(test, cake_dscp_memo_on(q->config, skb, CAKE_FLOW_TRIPLE, 0));
+	/* a filter chose the queue */
+	KUNIT_EXPECT_FALSE(test, cake_dscp_memo_on(q->config, skb, CAKE_FLOW_TRIPLE, 5));
+	/* a packet on its way out, or ifb has handed it back */
+	skb->from_ingress = 0;
+	KUNIT_EXPECT_FALSE(test, cake_dscp_memo_on(q->config, skb, CAKE_FLOW_TRIPLE, 0));
+	skb->from_ingress = 1;
+	/* ARP */
+	skb->protocol = htons(ETH_P_ARP);
+	KUNIT_EXPECT_FALSE(test, cake_dscp_memo_on(q->config, skb, CAKE_FLOW_TRIPLE, 0));
+	skb->protocol = htons(ETH_P_IP);
+	/* dscp_restore off */
+	dscp_restore = false;
+	KUNIT_EXPECT_FALSE(test, cake_dscp_memo_on(q->config, skb, CAKE_FLOW_TRIPLE, 0));
+	dscp_restore = true;
+	/* no wash */
+	q->config->rate_flags &= ~CAKE_FLAG_WASH;
+	KUNIT_EXPECT_FALSE(test, cake_dscp_memo_on(q->config, skb, CAKE_FLOW_TRIPLE, 0));
+}
+#endif
+
 static int cake_test_init(struct kunit *test)
 {
 	int i;
@@ -4867,6 +5052,9 @@ static struct kunit_case cake_test_cases[] = {
 	KUNIT_CASE(cake_test_wash_restores_original_dir),
 	KUNIT_CASE(cake_test_wash_plain),
 	KUNIT_CASE(cake_test_wash_arp),
+	KUNIT_CASE(cake_test_dscp_memo),
+	KUNIT_CASE(cake_test_dscp_memo_tag),
+	KUNIT_CASE(cake_test_dscp_memo_off),
 #endif
 	KUNIT_CASE(cake_test_hash_matches_eager),
 	KUNIT_CASE(cake_test_hash_reallocates_idle_flow),
