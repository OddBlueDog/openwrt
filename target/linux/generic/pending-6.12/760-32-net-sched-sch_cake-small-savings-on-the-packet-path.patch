+/* A tin's time per byte, as the shift loop worked it out */
+static void cake_test_set_rate(struct kunit *test)
+{
+	struct cake_tin_data *b = cake_test_alloc(test, sizeof(*b));
+	struct rnd_state rnd;
+	u32 bad = 0;
+	int i;
+
+	prandom_seed_state(&rnd, 7630);
+	for (i = 0; i < 2000; i++) {
+		u64 rate, ref_ns;
+		u8 ref_shft = 34;
+
+		if (i < 64 * 3)
+			rate = (1ULL << (i / 3)) + (i % 3) - 1;	/* powers of 2 and either side */
+		else
+			rate = (((u64)prandom_u32_state(&rnd) << 32) | prandom_u32_state(&rnd)) >>
+			       (prandom_u32_state(&rnd) % 64);
+		if (!rate)
+			continue;
+		ref_ns = div64_u64((u64)NSEC_PER_SEC << 34, max(64ULL, rate));
+		while (ref_ns >> 34) {
+			ref_ns >>= 1;
+			ref_shft--;
+		}
+		cake_set_rate(b, rate, 0, 0, 0);
+		bad += b->tin_rate_ns != ref_ns || b->tin_rate_shft != ref_shft;
+	}
+	KUNIT_EXPECT_EQ(test, bad, 0);
+}
+
+/* cake_mq's share as it was worked out, with the floor's division always */
+static u64 cake_test_mq_share_ref(u64 rate, u32 weight, u64 sparse,
+				  const struct cake_mq_peers *p)
+{
+	u64 bid = cake_mq_bid(weight);
+	u64 used = p->unsat_usage + p->sat_sparse + sparse;
+	u64 all_sparse = p->sparse + sparse;
+	u64 share = sparse, floor = sparse;
+
+	if (p->count <= 1 || !rate)
+		return rate;
+	if (used < rate)
+		share += mul_u64_u64_div_u64(rate - used, bid, bid + p->sat_bids);
+	if (all_sparse < rate)
+		floor += mul_u64_u64_div_u64(rate - all_sparse, bid, bid + p->bids);
+	return clamp(max(share, floor), 1ULL, rate);
+}
+
+/* The same share without the floor's division where it can't be above the
+ * share, for peers as cake_mq_read_peers() reads them: each peer's sparse
+ * bytes no more than all it used, its bid in the bids, saturated or not
+ */
+static void cake_test_mq_share_exact(struct kunit *test)
+{
+	struct rnd_state rnd;
+	u32 bad = 0, skipped = 0;
+	int i, n;
+
+	prandom_seed_state(&rnd, 7631);
+	for (i = 0; i < 10000; i++) {
+		u64 rate = 1 + prandom_u32_state(&rnd) % 156250000;
+		u32 weight = prandom_u32_state(&rnd) % 4 ? prandom_u32_state(&rnd) % (8 * 65535) : 0;
+		u64 sparse = prandom_u32_state(&rnd) % 2 ? prandom_u32_state(&rnd) % (rate / 4 + 1) : 0;
+		struct cake_mq_peers p = { .count = 1 };
+		int peers = prandom_u32_state(&rnd) % 8;
+
+		for (n = 0; n < peers; n++) {
+			u64 bid = cake_mq_bid(prandom_u32_state(&rnd) % 3 ?
+					      prandom_u32_state(&rnd) % (8 * 65535) : 0);
+			u64 usage = prandom_u32_state(&rnd) % (rate / 2 + 1);
+			u64 s = prandom_u32_state(&rnd) % 2 ? prandom_u32_state(&rnd) % (usage + 1) : 0;
+
+			p.count++;
+			p.bids += bid;
+			p.sparse += s;
+			if (prandom_u32_state(&rnd) % 2) {
+				p.sat_bids += bid;
+				p.sat_sparse += s;
+			} else {
+				p.unsat_usage += usage;
+			}
+		}
+		skipped += p.unsat_usage + p.sat_sparse <= p.sparse;
+		bad += cake_mq_share(rate, weight, sparse, &p) !=
+		       cake_test_mq_share_ref(rate, weight, sparse, &p);
+	}
+	KUNIT_EXPECT_EQ(test, bad, 0);
+	KUNIT_EXPECT_GT(test, skipped, 1000);
+}
+
+/* autorate-ingress keeps no account of the traffic while it's off, and
+ * starts its estimate afresh when it's turned on
+ */
+static void cake_test_autorate_starts_afresh(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 12500000,
