+/* ACK filter fast-skip for GSO and >160 B packets when pure_acks < thresh,
+ * while still honoring an interleaved data packet whose ECE/CWR flips after
+ * an eligible pure ACK.
+ */
+static void cake_test_ack_filter_fast_skip_and_ece(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	struct cake_flow *flow = cake_test_ack_flow(test, q, CAKE_ACK_AGGRESSIVE);
+	struct sk_buff *data_big, *gso, *a1, *data_ece, *a2, *a3, *dropped;
+
+	/* >160 B data packet and GSO packet with 0 queued pure ACKs */
+	data_big = cake_test_tcp_skb(test, &(struct cake_test_tcp){
+		.flags = TCP_FLAG_ACK, .ack = 100, .data = 1400,
+	});
+	flow_queue_add(flow, data_big);
+	KUNIT_EXPECT_NULL(test, cake_ack_filter(q, flow));
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 0);
+
+	gso = cake_test_tcp_skb(test, &(struct cake_test_tcp){
+		.flags = TCP_FLAG_ACK, .ack = 100, .data = 10,
+	});
+	skb_shinfo(gso)->gso_size = 1400;
+	flow_queue_add(flow, gso);
+	KUNIT_EXPECT_NULL(test, cake_ack_filter(q, flow));
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 0);
+
+	/* Pure ACK #1, then data packet with ECE set, then pure ACK #2:
+	 * data_ece's ECE change must cancel dropping a1.
+	 */
+	a1 = cake_test_tcp_skb(test, &(struct cake_test_tcp){
+		.flags = TCP_FLAG_ACK, .ack = 100,
+	});
+	flow_queue_add(flow, a1);
+	KUNIT_EXPECT_NULL(test, cake_ack_filter(q, flow));
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 1);
+
+	data_ece = cake_test_tcp_skb(test, &(struct cake_test_tcp){
+		.flags = TCP_FLAG_ACK | TCP_FLAG_ECE, .ack = 100, .data = 100,
+	});
+	flow_queue_add(flow, data_ece);
+	KUNIT_EXPECT_NULL(test, cake_ack_filter(q, flow));
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 1);
+
+	a2 = cake_test_tcp_skb(test, &(struct cake_test_tcp){
+		.flags = TCP_FLAG_ACK, .ack = 200,
+	});
+	flow_queue_add(flow, a2);
+	KUNIT_EXPECT_NULL(test, cake_ack_filter(q, flow));
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 2);
+
+	/* Consecutive pure ACK #3 with matching ECE drops a2 */
+	a3 = cake_test_tcp_skb(test, &(struct cake_test_tcp){
+		.flags = TCP_FLAG_ACK, .ack = 300,
+	});
+	flow_queue_add(flow, a3);
+	dropped = cake_ack_filter(q, flow);
+	KUNIT_EXPECT_PTR_EQ(test, dropped, a2);
+	if (dropped)
+		kfree_skb(dropped);
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 2);
+}
