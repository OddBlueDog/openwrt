+/* cake_reset() zeroes published cake_mq fields, local counters, and dscp_memo */
+static void cake_test_reset_clears_mq_and_memo(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct Qdisc *root = cake_test_mq_root(test, mq, 1, 12500000,
+					       CAKE_DIFFSERV_BESTEFFORT);
+	struct cake_sched_data *q = cake_test_mq_q(mq, 0);
+
+	KUNIT_ASSERT_NOT_NULL(test, root);
+	q->mq_usage = 500000;
+	q->mq_sparse = 100000;
+	q->mq_weight = CAKE_MQ_UNIT;
+	q->mq_saturated = true;
+	q->mq_bytes = 4096;
+	q->mq_sparse_bytes = 512;
+	q->mq_packets = 3;
+	q->dscp_memo[7].tag = 0x12345678;
+	q->dscp_memo[7].dscp = 46;
+	q->dscp_memo[7].left = 10;
+
+	rcu_read_lock_bh();
+	cake_reset(mq->sch[0]);
+	rcu_read_unlock_bh();
