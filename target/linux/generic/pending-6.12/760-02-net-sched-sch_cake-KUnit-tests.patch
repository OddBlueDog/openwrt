+/* A sub-cake that has just sent a packet counts as active for the others
+ * (cake_mq_read_peers()) for its idle time; reset, it's idle at once, so
+ * they no longer leave it a part of the rate. Before, it counted for up to
+ * its idle time (100 ms at most) after the reset.
+ */
+static void cake_test_reset_leaves_peers(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_UDP, 5, 46000, 0);
+	struct cake_mq_peers before, after;
+	bool through;
+
+	cake_test_mq_root(test, mq, 2, 12500000, CAKE_DIFFSERV_BESTEFFORT);
+	rcu_read_lock_bh();
+	through = cake_test_through(mq->sch[1], skb);
+	rcu_read_unlock_bh();
+	cake_test_mq_peers(mq, 0, ktime_to_ns(ktime_get()), &before);
+	rcu_read_lock_bh();
+	cake_reset(mq->sch[1]);
+	rcu_read_unlock_bh();
+	cake_test_mq_peers(mq, 0, ktime_to_ns(ktime_get()), &after);
+
+	KUNIT_ASSERT_TRUE(test, through);
+	KUNIT_EXPECT_EQ(test, before.count, 2U);
+	KUNIT_EXPECT_EQ(test, after.count, 1U);
+	KUNIT_EXPECT_EQ(test, after.bids, 0ULL);
+}
