+/* Once its queue is gone and its count has decayed to 0, a switched flow
+ * is marked again
+ */
+static void cake_test_ecn_decays_back(struct kunit *test)
+{
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_TCP, 2, 40000, 0);
+	struct cake_test_ecn e;
+	u32 fail = READ_ONCE(ecn_fail_count), i;
+
+	cake_test_ecn_init(&e);
+	cake_test_ecn_run(&e, skb, INET_ECN_ECT_0, 20 * NSEC_PER_MSEC, fail + COBALT_ECN_STRIKES);
+	KUNIT_ASSERT_TRUE(test, e.v.ecn_ignored);
+	for (i = 0; i < 100000 && e.v.count; i++) {
+		e.now = max(ktime_add_ns(e.now, 1), e.v.drop_next);
+		cobalt_queue_empty(&e.v, &e.p, e.now);
+	}
+	KUNIT_EXPECT_EQ(test, e.v.count, 0);
+	KUNIT_EXPECT_FALSE(test, e.v.ecn_ignored);
+	KUNIT_EXPECT_EQ(test, e.v.ecn_strikes, 0);
+	e.drops = 0;
+	/* marked again, until the count and the strikes get there once more */
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_0, 20 * NSEC_PER_MSEC,
+						fail + COBALT_ECN_STRIKES - 2), 0);
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_0, 20 * NSEC_PER_MSEC, 1), 1);
+}
+
+/* Sub-cake @i of @mq's device as a cake of its own, as cake_init() leaves
+ * one: its own config at @rate bytes/s in @tin_mode, every tin and flow set
+ * up, its lock and watchdogs ready (the watchdogs cancelled with the test)
+ */
+static struct cake_sched_data *cake_test_cake_live(struct kunit *test, struct cake_test_mq *mq,
+						   int i, u64 rate, u8 tin_mode)
+{
+	struct Qdisc *sch = mq->sch[i];
+	struct cake_sched_data *q = qdisc_priv(sch);
+	int t, j;
+
+	cake_config_init(&q->initial_config, false);
+	q->config = &q->initial_config;
+	q->config->rate_bps = rate;
+	q->config->tin_mode = tin_mode;
+	spin_lock_init(qdisc_lock(sch));
+	sch->limit = 10240;
+	q->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(*q->tins));
+	for (t = 0; t < CAKE_MAX_TINS; t++) {
+		struct cake_tin_data *b = &q->tins[t];
+
+		cake_init_flowchains(b);
+		for (j = 0; j < CAKE_QUEUES; j++) {
+			INIT_LIST_HEAD(&b->flows[j].flowchain);
+			cobalt_vars_init(&b->flows[j].cvars);
+		}
+	}
+	qdisc_watchdog_init(&q->watchdog, sch);
+	qdisc_watchdog_init(&q->mq_watchdog, sch);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_cancel_watchdogs, q));
+	cake_reconfigure(sch);
+	q->min_netlen = ~0;
+	q->min_adjlen = ~0;
+	return q;
+}
+
+/* autorate-ingress puts its estimate of the line's capacity into the rate
+ * at most every 250 ms. It makes one after each gap in the traffic, and
+ * checked when it last put one in but never noted it, so every estimate
+ * went in, each a whole reconfiguration in cake_enqueue() (upstream
+ * 7cbfb180945c).
+ */
+static void cake_test_autorate_throttled(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 12500000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	const u64 marker = 1;	/* a rate no estimate gives */
+	struct sk_buff *skb[5];
+	bool through[5];
+	u64 rate[5];
+	int i;
+
+	for (i = 0; i < 5; i++)
+		skb[i] = cake_test_skb(test, false, IPPROTO_UDP, 5, 41000, 0);
+	q->config->rate_flags |= CAKE_FLAG_AUTORATE_INGRESS;
+	rcu_read_lock_bh();
+	for (i = 0; i < 5; i++) {
+		ktime_t now = ktime_get();
+
+		/* the last estimate 300 ms ago before the first packet and the
+		 * last one; the three in between come within 250 ms of the first
+		 */
+		if (i == 0 || i == 4)
+			q->last_reconfig_time = ktime_sub_ms(now, 300);
+		/* a gap longer than the average between packets: an estimate,
+		 * here 1 Gbit/s
+		 */
+		q->avg_packet_interval = 0;
+		q->last_packet_time = ktime_sub_us(now, 100);
+		q->avg_window_begin = ktime_sub_ms(now, 1);
+		q->avg_window_bytes = 125000;
+		q->time_next_packet = 0;
+		q->failsafe_next_packet = 0;
+		q->config->rate_bps = marker;
+		through[i] = cake_test_through(mq->sch[0], skb[i]);
+		rate[i] = q->config->rate_bps;
+	}
+	rcu_read_unlock_bh();
+
+	for (i = 0; i < 5; i++) {
+		KUNIT_EXPECT_TRUE_MSG(test, through[i], "packet %d", i);
+		if (i == 0 || i == 4)
+			KUNIT_EXPECT_NE_MSG(test, rate[i], marker, "packet %d: no estimate taken", i);
+		else
+			KUNIT_EXPECT_EQ_MSG(test, rate[i], marker,
+					    "packet %d: an estimate within 250 ms of the last", i);
+	}
+}
+
+#define CAKE_TEST_UNSET	U32_MAX
+
+/* tc's options for cake_change(): TCA_OPTIONS with the rate, given as a
+ * u64, or as a u32 when @bad (the policy refuses that), and the diffserv
+ * mode unless CAKE_TEST_UNSET
+ */
+static struct nlattr *cake_test_opts(struct kunit *test, u64 rate, u32 diffserv, bool bad)
+{
+	struct sk_buff *msg = nlmsg_new(NLMSG_DEFAULT_SIZE, GFP_KERNEL);
+	struct nlattr *opts;
+
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_free_skb, msg));
+	opts = nla_nest_start_noflag(msg, TCA_OPTIONS);
+	KUNIT_ASSERT_NOT_NULL(test, opts);
+	if (bad)
+		KUNIT_ASSERT_EQ(test, 0, nla_put_u32(msg, TCA_CAKE_BASE_RATE64, rate));
+	else
+		KUNIT_ASSERT_EQ(test, 0, nla_put_u64_64bit(msg, TCA_CAKE_BASE_RATE64, rate,
+							   TCA_CAKE_PAD));
+	if (diffserv != CAKE_TEST_UNSET)
+		KUNIT_ASSERT_EQ(test, 0, nla_put_u32(msg, TCA_CAKE_DIFFSERV_MODE, diffserv));
+	nla_nest_end(msg, opts);
+	return opts;
+}
+
+/* A change refused by its options changes nothing and leaves the qdisc's
+ * lock free; one accepted puts the rate in force, the tins' with it
+ */
+static void cake_test_change_refused(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 12500000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	struct Qdisc *sch = mq->sch[0];
+	int ret;
+
+	rtnl_lock();
+	ret = cake_change(sch, cake_test_opts(test, 25000000, CAKE_TEST_UNSET, true), NULL);
+	rtnl_unlock();
+	KUNIT_EXPECT_LT(test, ret, 0);
+	KUNIT_EXPECT_FALSE(test, spin_is_locked(qdisc_lock(sch)));
+	KUNIT_EXPECT_EQ(test, q->config->rate_bps, 12500000);
+	KUNIT_EXPECT_EQ(test, q->tins[0].tin_rate_bps, 12500000);
+
+	rtnl_lock();
+	ret = cake_change(sch, cake_test_opts(test, 25000000, CAKE_TEST_UNSET, false), NULL);
+	rtnl_unlock();
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	KUNIT_EXPECT_FALSE(test, spin_is_locked(qdisc_lock(sch)));
+	KUNIT_EXPECT_EQ(test, q->config->rate_bps, 25000000);
+	KUNIT_EXPECT_EQ(test, q->tins[0].tin_rate_bps, 25000000);
+}
+
+struct cake_test_change_ctx {
+	struct Qdisc *sch;
+	struct nlattr *opts;
+	struct completion done;
+	int ret;
+};
+
+/* tc qdisc change, as rtnetlink calls it */
+static int cake_test_change_thread(void *data)
+{
+	struct cake_test_change_ctx *c = data;
+
+	rtnl_lock();
+	c->ret = cake_change(c->sch, c->opts, NULL);
+	rtnl_unlock();
+	complete(&c->done);
+	return 0;
+}
+
+/* 'tc qdisc change' against autorate-ingress, which writes the rate from
+ * cake_enqueue(), under the qdisc's lock. The change wrote its rate before
+ * it took that lock, so an estimate stored in between was what it then put
+ * in force, the rate it was given lost (upstream d23a16d907dc). Here the
+ * change runs on another CPU while this one holds the lock and stores an
+ * estimate, as the datapath does: the change must wait for the lock before
+ * it writes anything, and its rate is the one in force at the end.
+ */
+static void cake_test_change_vs_autorate(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 12500000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	struct cake_test_change_ctx *c = cake_test_alloc(test, sizeof(*c));
+	struct task_struct *task;
+	u64 during;
+
+	if (num_online_cpus() < 2)
+		kunit_skip(test, "needs a second CPU for the change");
+
+	q->config->rate_flags |= CAKE_FLAG_AUTORATE_INGRESS;
+	c->sch = mq->sch[0];
+	c->opts = cake_test_opts(test, 25000000, CAKE_TEST_UNSET, false);
+	init_completion(&c->done);
+	task = kthread_create(cake_test_change_thread, c, "cake_test_change");
+	KUNIT_ASSERT_FALSE(test, IS_ERR(task));
+
+	spin_lock_bh(qdisc_lock(mq->sch[0]));
+	wake_up_process(task);
+	/* long enough for the change to reach the lock on another CPU */
+	mdelay(50);
+	during = READ_ONCE(q->config->rate_bps);
+	/* an estimate going in, as cake_enqueue() puts one */
+	WRITE_ONCE(q->config->rate_bps, 5000000);
+	q->last_reconfig_time = ktime_get();
+	cake_reconfigure(mq->sch[0]);
+	spin_unlock_bh(qdisc_lock(mq->sch[0]));
+	wait_for_completion(&c->done);
+
+	KUNIT_EXPECT_EQ(test, c->ret, 0);
+	KUNIT_EXPECT_EQ_MSG(test, during, 12500000, "the change wrote the rate outside the lock");
+	KUNIT_EXPECT_EQ(test, q->config->rate_bps, 25000000);
+	KUNIT_EXPECT_EQ(test, q->tins[0].tin_rate_bps, 25000000);
+}
+
+/* A classful parent's class over a CAKE (HTB's, say): what the qdisc
+ * core needs of one to take a leaf's drops off its counts
+ */
+static const struct Qdisc_class_ops cake_test_parent_class_ops = {};
+static struct Qdisc_ops cake_test_parent_ops = {
+	.id	= "cake_test_parent",
+	.cl_ops	= &cake_test_parent_class_ops,
+};
+
+static void cake_test_noop_root(void *dev)
+{
+	rcu_assign_pointer(((struct net_device *)dev)->qdisc, &noop_qdisc);
+}
+
+/* @skb into @sch, which owns it from here */
+static int cake_test_enqueue(struct Qdisc *sch, struct sk_buff *skb)
+{
+	struct sk_buff *to_free = NULL;
+	int ret;
+
+	qdisc_skb_cb(skb)->pkt_len = skb->len;
+	ret = cake_enqueue(skb, sch, &to_free);
+	if (to_free)
+		kfree_skb_list(to_free);
+	return ret;
+}
+
+static void cake_test_reset(void *sch)
+{
+	cake_reset(sch);
+}
+
+/* CAKE under a classful parent: a change to fewer tins drops the packets
+ * queued in the others, and they come off the parent's counts too, as
+ * every other drop does (upstream d7010be1ba23). Here diffserv8 with two
+ * packets in each of four tins, changed to besteffort: tin 0's two stay.
+ */
+static void cake_test_clear_tin_parent(struct kunit *test)
+{
+	static const u8 tins[] = { 0, 2, 5, 7 };
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 12500000,
+							CAKE_DIFFSERV_DIFFSERV8);
+	struct Qdisc *parent = cake_test_alloc(test, sizeof(*parent));
+	struct Qdisc *sch = mq->sch[0];
+	struct sk_buff *skb[8];
+	u32 tin0_backlog = 0;
+	int i, ret[8];
+
+	parent->handle = TC_H_MAKE(1 << 16, 0);
+	parent->parent = TC_H_ROOT;
+	parent->ops = &cake_test_parent_ops;
+	parent->dev_queue = netdev_get_tx_queue(mq->dev, 0);
+	rcu_assign_pointer(mq->dev->qdisc, parent);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_noop_root, mq->dev));
+	sch->handle = TC_H_MAKE(2 << 16, 0);
+	sch->parent = TC_H_MAKE(1 << 16, 1);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	for (i = 0; i < 8; i++) {
+		skb[i] = cake_test_skb(test, false, IPPROTO_UDP, 5, 41000 + i, 0);
+		/* steered to a tin by priority, as a tc filter can */
+		skb[i]->priority = TC_H_MAKE(sch->handle, tins[i / 2] + 1);
+		if (!tins[i / 2])
+			tin0_backlog += skb[i]->len;
+		kunit_remove_action(test, cake_test_free_skb, skb[i]);
+	}
+	rcu_read_lock_bh();
+	for (i = 0; i < 8; i++)
+		ret[i] = cake_test_enqueue(sch, skb[i]);
+	rcu_read_unlock_bh();
+	for (i = 0; i < 8; i++)
+		KUNIT_ASSERT_EQ(test, ret[i], NET_XMIT_SUCCESS);
+	for (i = 0; i < 4; i++)
+		KUNIT_ASSERT_EQ(test, q->tins[tins[i]].tin_backlog, tin0_backlog);
+	/* what the parent counted as its class's packets went in */
+	parent->q.qlen = sch->q.qlen;
+	parent->qstats.backlog = sch->qstats.backlog;
+
+	rtnl_lock();
+	KUNIT_EXPECT_EQ(test, 0, cake_change(sch, cake_test_opts(test, 12500000,
+								   CAKE_DIFFSERV_BESTEFFORT, false),
+					     NULL));
+	rtnl_unlock();
+
+	KUNIT_EXPECT_EQ(test, q->tin_cnt, 1);
+	KUNIT_EXPECT_EQ(test, sch->q.qlen, 2);
+	KUNIT_EXPECT_EQ(test, sch->qstats.backlog, tin0_backlog);
+	KUNIT_EXPECT_EQ(test, parent->q.qlen, sch->q.qlen);
+	KUNIT_EXPECT_EQ(test, parent->qstats.backlog, sch->qstats.backlog);
+	KUNIT_EXPECT_EQ(test, parent->qstats.drops, 6);
+}
+
+/* A TCP GSO packet of @segs segments of @mss bytes as CAKE gets it: through
+ * a VXLAN tunnel (Ethernet, IPv4, UDP, VXLAN, inner Ethernet, IPv4, TCP)
+ * when @tunnel, or plain (Ethernet, IPv4, TCP)
+ */
+static struct sk_buff *cake_test_gso_skb(struct kunit *test, bool tunnel, u16 mss, u16 segs)
+{
+	const unsigned int outer = ETH_HLEN + sizeof(struct iphdr) + sizeof(struct udphdr) + 8;
+	unsigned int inner = tunnel ? outer : 0;
+	struct sk_buff *skb = alloc_skb(inner + ETH_HLEN + 40 + mss * segs, GFP_KERNEL);
+	struct tcphdr *th;
+	struct iphdr *ip;
+
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_free_skb, skb));
+	skb_put_zero(skb, inner + ETH_HLEN + 40 + mss * segs);
+	skb_reset_mac_header(skb);
+	skb_set_network_header(skb, ETH_HLEN);
+	if (tunnel) {
+		ip = (struct iphdr *)(skb->data + ETH_HLEN);
+		ip->version = 4;
+		ip->ihl = 5;
+		ip->protocol = IPPROTO_UDP;
+		skb_set_transport_header(skb, ETH_HLEN + sizeof(*ip));
+		skb->encapsulation = 1;
+		skb_set_inner_mac_header(skb, inner);
+		skb_set_inner_network_header(skb, inner + ETH_HLEN);
+		skb_set_inner_transport_header(skb, inner + ETH_HLEN + sizeof(*ip));
+	} else {
+		skb_set_transport_header(skb, ETH_HLEN + sizeof(*ip));
+	}
+	ip = (struct iphdr *)(skb->data + inner + ETH_HLEN);
+	ip->version = 4;
+	ip->ihl = 5;
+	ip->protocol = IPPROTO_TCP;
+	th = (struct tcphdr *)(skb->data + inner + ETH_HLEN + sizeof(*ip));
+	th->doff = sizeof(*th) / 4;
+	skb_shinfo(skb)->gso_size = mss;
+	skb_shinfo(skb)->gso_segs = segs;
+	skb_shinfo(skb)->gso_type = SKB_GSO_TCPV4 | (tunnel ? SKB_GSO_UDP_TUNNEL : 0);
+	qdisc_skb_cb(skb)->pkt_len = skb->len;
+	return skb;
+}
+
+/* A GSO packet counts every header of each segment: for a tunnelled one,
+ * those inside the tunnel too, up to the inner TCP header (upstream
+ * a41851bea7bf). CAKE then charges what the segments carry on the wire;
+ * it counted only the outer headers, and read the UDP header there as a
+ * TCP one.
+ */
+static void cake_test_overhead_tunnel(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	const unsigned int outer = ETH_HLEN + sizeof(struct iphdr) + sizeof(struct udphdr) + 8;
+	const unsigned int mss = 1400, segs = 4;
+	/* each segment as it leaves: all its headers, then its share of data */
+	const unsigned int plain_seg = ETH_HLEN + 40 + mss;
+	struct sk_buff *skb;
+
+	q->config = cake_test_alloc(test, sizeof(*q->config));
+	q->min_netlen = ~0;
+	q->min_adjlen = ~0;
+
+	/* raw: CAKE counts what it sees from the MAC header on */
+	skb = cake_test_gso_skb(test, false, mss, segs);
+	KUNIT_EXPECT_EQ(test, cake_overhead(q, skb), segs * plain_seg);
+	skb = cake_test_gso_skb(test, true, mss, segs);
+	KUNIT_EXPECT_EQ(test, cake_overhead(q, skb), segs * (outer + plain_seg));
+
+	/* with overhead compensation: from the network header, plus 38 */
+	q->config->rate_flags = CAKE_FLAG_OVERHEAD;
+	q->config->rate_overhead = 38;
+	KUNIT_EXPECT_EQ(test, cake_overhead(q, skb),
+			segs * (outer + plain_seg - ETH_HLEN + 38));
+}
+
+/* The ACK filter's tests: one connection's packets (192.168.1.5:41000 to
+ * 1.1.1.1:443) in one CAKE flow queue, with another connection's (port
+ * 41001) sharing it as a hash collision would
+ */
+struct cake_test_tcp {
+	__be32	flags;		/* TCP_FLAG_* */
+	u32	ack;
+	u16	data;		/* payload bytes */
+	u32	tsval;		/* a timestamp option when non-zero */
+	u32	sack;		/* a SACK block of one segment from here when non-zero */
+	u32	sacks[3][2];	/* or up to three SACK blocks, start and end */
+	u8	ip_opts;	/* IPv4 option bytes, a multiple of 4 */
+	bool	v6;
+	bool	sixin4;		/* IPv6 in IPv4 (protocol 41), ip_opts on the outer */
+	bool	other;		/* the other connection's */
+};
+
+/* the SACK blocks @t gives, one for .sack */
+static unsigned int cake_test_sack_blocks(const struct cake_test_tcp *t)
+{
+	unsigned int n = 0;
+
+	if (t->sack)
+		return 1;
+	while (n < ARRAY_SIZE(t->sacks) && t->sacks[n][1])
+		n++;
+	return n;
+}
+
+static struct sk_buff *cake_test_tcp_skb(struct kunit *test, const struct cake_test_tcp *t)
+{
+	const unsigned int v4 = sizeof(struct iphdr) + t->ip_opts;
+	const unsigned int l3 = t->sixin4 ? v4 + sizeof(struct ipv6hdr) :
+				t->v6 ? sizeof(struct ipv6hdr) : v4;
+	unsigned int blocks = cake_test_sack_blocks(t);
+	unsigned int opts = (t->tsval ? 12 : 0) + (blocks ? 4 + 8 * blocks : 0);
+	unsigned int len = ETH_HLEN + l3 + sizeof(struct tcphdr) + opts + t->data;
+	struct sk_buff *skb = alloc_skb(len, GFP_KERNEL);
+	struct tcphdr *th;
+	u8 *o;
+
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	skb->dev = init_net.loopback_dev;
+	skb_put_zero(skb, len);
+	skb_reset_mac_header(skb);
+	skb_set_network_header(skb, ETH_HLEN);
+	skb_set_transport_header(skb, ETH_HLEN + l3);
+	if (t->v6 || t->sixin4) {
+		struct ipv6hdr *ip6 = (void *)(skb_network_header(skb) + (t->sixin4 ? v4 : 0));
+
+		skb->protocol = htons(ETH_P_IPV6);
+		if (t->sixin4) {
+			struct iphdr *ip = ip_hdr(skb);
+
+			skb->protocol = htons(ETH_P_IP);
+			ip->version = 4;
+			ip->ihl = v4 / 4;
+			ip->protocol = IPPROTO_IPV6;
+			ip->tot_len = htons(len - ETH_HLEN);
+			ip->saddr = htonl(0xc0a80105);
+			ip->daddr = htonl(0x01010101);
+		}
+		ip6->version = 6;
+		ip6->nexthdr = IPPROTO_TCP;
+		ip6->payload_len = htons(len - ETH_HLEN - l3);
+		ip6->saddr.s6_addr32[0] = htonl(0x20010db8);
+		ip6->saddr.s6_addr[15] = 5;
+		ip6->daddr.s6_addr32[0] = htonl(0x20010db8);
+		ip6->daddr.s6_addr[15] = 1;
+	} else {
+		struct iphdr *ip = ip_hdr(skb);
+
+		skb->protocol = htons(ETH_P_IP);
+		ip->version = 4;
+		ip->ihl = v4 / 4;
+		ip->protocol = IPPROTO_TCP;
+		ip->tot_len = htons(len - ETH_HLEN);
+		ip->saddr = htonl(0xc0a80105);
+		ip->daddr = htonl(0x01010101);
+	}
+	th = tcp_hdr(skb);
+	th->source = htons(t->other ? 41001 : 41000);
+	th->dest = htons(443);
+	th->ack_seq = htonl(t->ack);
+	th->doff = (sizeof(*th) + opts) / 4;
+	tcp_flag_word(th) |= t->flags;
+	o = (u8 *)(th + 1);
+	if (t->tsval) {
+		*o++ = TCPOPT_NOP;
+		*o++ = TCPOPT_NOP;
+		*o++ = TCPOPT_TIMESTAMP;
+		*o++ = TCPOLEN_TIMESTAMP;
+		put_unaligned_be32(t->tsval, o);
+		put_unaligned_be32(t->tsval, o + 4);
+		o += 8;
+	}
+	if (blocks) {
+		unsigned int i;
+
+		*o++ = TCPOPT_NOP;
+		*o++ = TCPOPT_NOP;
+		*o++ = TCPOPT_SACK;
+		*o++ = TCPOLEN_SACK_BASE + blocks * TCPOLEN_SACK_PERBLOCK;
+		for (i = 0; i < blocks; i++, o += 8) {
+			put_unaligned_be32(t->sack ?: t->sacks[i][0], o);
+			put_unaligned_be32(t->sack ? t->sack + 1400 : t->sacks[i][1], o + 4);
+		}
+	}
+	qdisc_skb_cb(skb)->pkt_len = skb->len;
+	return skb;
+}
+
+/* the flow's queued packets counted as pure ACKs, read off the packets */
+static u32 cake_test_flagged(const struct cake_flow *flow)
+{
+	const struct sk_buff *skb;
+	u32 n = 0;
+
+	for (skb = flow->head; skb; skb = skb->next)
+		n += get_cobalt_cb(skb)->pure_ack;
+	return n;
+}
+
+static void cake_test_drain_flow(void *flow)
+{
+	struct sk_buff *skb;
+
+	while ((skb = dequeue_head(flow)))
+		kfree_skb(skb);
+}
+
+/* A flow queue and a CAKE config for the ACK filter, in @mode */
+static struct cake_flow *cake_test_ack_flow(struct kunit *test, struct cake_sched_data *q,
+					    u8 mode)
+{
+	struct cake_flow *flow = cake_test_alloc(test, sizeof(*flow));
+
+	q->config = cake_test_alloc(test, sizeof(*q->config));
+	q->config->ack_filter = mode;
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_drain_flow, flow));
+	return flow;
+}
+
+/* @t at @flow's tail, through the ACK filter as cake_enqueue() runs it: what
+ * the filter dropped, freed, or NULL
+ */
+static bool cake_test_ack_in(struct kunit *test, struct cake_sched_data *q,
+			     struct cake_flow *flow, const struct cake_test_tcp *t)
+{
+	struct sk_buff *ack;
+
+	flow_queue_add(flow, cake_test_tcp_skb(test, t));
+	ack = cake_ack_filter(q, flow);
+	kfree_skb(ack);
+	return ack;
+}
+
+/* upstream's filter on @flow's queue, the headers of its tail read */
+static struct sk_buff *cake_test_ack_scan(struct cake_sched_data *q, struct cake_flow *flow)
+{
+	unsigned char _tcph[64];
+	struct ipv6hdr _iph;
+	const struct tcphdr *tcph = cake_get_tcphdr(flow->tail, _tcph, sizeof(_tcph));
+	const struct iphdr *iph = cake_get_iphdr(flow->tail, &_iph);
+
+	return tcph && iph ? __cake_ack_filter(q, flow, iph, tcph) : NULL;
+}
+
+/* An upload's data packets all carry the ACK flag: none counts, so none
+ * starts a read of the queue; pure ACKs count as they come and go, and the
+ * filter drops the same ones as upstream's
+ */
+static void cake_test_ack_filter_counts(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	struct cake_flow *flow = cake_test_ack_flow(test, q, CAKE_ACK_FILTER);
+	struct cake_test_tcp t = { .flags = TCP_FLAG_ACK };
+	int i;
+
+	for (i = 0; i < 20; i++) {
+		t.data = 1400;
+		t.ack = 1000;
+		KUNIT_EXPECT_FALSE(test, cake_test_ack_in(test, q, flow, &t));
+	}
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 0);
+
+	/* a download's ACKs on the same connection, each acknowledging more:
+	 * from the third, the oldest of the two before it goes
+	 */
+	t.data = 0;
+	for (i = 1; i <= 5; i++) {
+		t.ack = 1000 + i * 2800;
+		KUNIT_EXPECT_EQ_MSG(test, cake_test_ack_in(test, q, flow, &t), i >= 3, "ACK %d", i);
+		KUNIT_EXPECT_EQ(test, flow->pure_acks, min(i, 2));
+		KUNIT_EXPECT_EQ(test, flow->pure_acks, cake_test_flagged(flow));
+	}
+	/* SYN, FIN and RST aren't pure ACKs; data with the ACK isn't either */
+	t.flags = TCP_FLAG_ACK | TCP_FLAG_FIN;
+	cake_test_ack_in(test, q, flow, &t);
+	t.flags = TCP_FLAG_ACK;
+	t.data = 1;
+	cake_test_ack_in(test, q, flow, &t);
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 2);
+
+	/* sent: each leaves the count as it leaves the queue */
+	for (i = 0; i < 20; i++)
+		kfree_skb(dequeue_head(flow));
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 2);
+	kfree_skb(dequeue_head(flow));
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 1);
+	cake_test_drain_flow(flow);
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 0);
+}
+
+/* More pure ACKs than the count holds, none of which the filter may drop
+ * (each acknowledges less than the one before): it stops at U8_MAX and
+ * comes back to 0 as they leave, never below
+ */
+static void cake_test_ack_filter_saturates(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	struct cake_flow *flow = cake_test_ack_flow(test, q, CAKE_ACK_FILTER);
+	struct cake_test_tcp t = { .flags = TCP_FLAG_ACK };
+	int i;
+
+	for (i = 0; i < 300; i++) {
+		t.ack = 1000000 - i;
+		KUNIT_ASSERT_FALSE(test, cake_test_ack_in(test, q, flow, &t));
+	}
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, U8_MAX);
+	KUNIT_EXPECT_EQ(test, cake_test_flagged(flow), U8_MAX);
+	for (i = 0; i < 300; i++) {
+		kfree_skb(dequeue_head(flow));
+		KUNIT_ASSERT_EQ(test, flow->pure_acks, cake_test_flagged(flow));
+	}
+	KUNIT_EXPECT_EQ(test, flow->pure_acks, 0);
+}
+
+/* At random, in both modes: phases of an upload's data with a few ACKs,
+ * and of a download's ACKs, which do and don't make the ones before them
+ * redundant (more acknowledged, the same, less; SACK; timestamps; ECE),
+ * with FINs, the other connection's packets, IPv6, and packets leaving from
+ * the head. The count is always what's queued, and whenever the filter
+ * skips its read of the queue, upstream's, run on the same queue, finds
+ * nothing to drop either.
+ */
+static void cake_test_ack_filter_matches(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	struct cake_flow *flow = cake_test_ack_flow(test, q, CAKE_ACK_FILTER);
+	u32 ack = 100000, drops = 0, skips = 0, qlen = 0;
+	struct rnd_state rnd;
+	int round;
+
+	prandom_seed_state(&rnd, 7626);
+	for (round = 0; round < 8000; round++) {
+		bool upload = (round / 250) % 2;
+		u32 r = prandom_u32_state(&rnd), n;
+		struct cake_test_tcp t = {
+			.flags = TCP_FLAG_ACK,
+			.v6 = (round / 2000) % 2,
+			.other = r % 11 == 0,
+		};
+		struct sk_buff *dropped;
+		bool skipped;
+
+		if (round == 4000)
+			q->config->ack_filter = CAKE_ACK_AGGRESSIVE;
+		if (upload && (r >> 4) % 10)
+			t.data = 1400;
+		else switch ((r >> 8) % 10) {
+		case 0:
+			t.data = 1 + (r >> 12) % 1400;
+			break;
+		case 1:
+			t.flags |= TCP_FLAG_FIN;
+			break;
+		case 2:
+			t.flags |= TCP_FLAG_ECE;
+			break;
+		case 3:
+			t.sack = ack + 1400 * (1 + (r >> 12) % 4);
+			break;
+		case 4:
+			t.tsval = 1000 + round - (r >> 12) % 3;
+			break;
+		default:
+			break;
+		}
+		/* mostly more acknowledged, sometimes the same or less */
+		switch ((r >> 16) % 8) {
+		case 0:
+			ack -= 1400;
+			break;
+		case 1:
+			break;
+		default:
+			ack += 1400;
+		}
+		t.ack = ack;
+
+		flow_queue_add(flow, cake_test_tcp_skb(test, &t));
+		qlen++;
+		/* the conservative filter needs two, the aggressive one */
+		skipped = flow->pure_acks <
+			  (q->config->ack_filter == CAKE_ACK_AGGRESSIVE ? 1 : 2);
+		dropped = cake_ack_filter(q, flow);
+		if (dropped) {
+			drops++;
+			qlen--;
+			kfree_skb(dropped);
+		} else if (skipped && qlen > 1) {
+			skips++;
+			dropped = cake_test_ack_scan(q, flow);
+			KUNIT_ASSERT_NULL_MSG(test, dropped, "round %d: skipped a read that drops", round);
+		}
+		KUNIT_ASSERT_EQ_MSG(test, flow->pure_acks, cake_test_flagged(flow), "round %d", round);
+		/* sent from the head: none to two a round, at most 64 queued */
+		for (n = (r >> 20) % 3; qlen && (n || qlen > 64); n -= !!n, qlen--)
+			kfree_skb(dequeue_head(flow));
+		KUNIT_ASSERT_EQ_MSG(test, flow->pure_acks, cake_test_flagged(flow), "round %d", round);
+	}
+	KUNIT_EXPECT_GT(test, drops, 200);
+	KUNIT_EXPECT_GT(test, skips, 200);
+}
+
+/* Through cake_enqueue() and cake_dequeue(), and a reset with ACKs queued:
+ * each flow's count back to 0
+ */
+static void cake_test_ack_filter_live(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 0, CAKE_DIFFSERV_BESTEFFORT);
+	struct cake_test_tcp t = { .flags = TCP_FLAG_ACK };
+	struct Qdisc *sch = mq->sch[0];
+	struct sk_buff *skb[40];
+	u32 sent = 0, left;
+	int i, pass;
+
+	q->config->ack_filter = CAKE_ACK_FILTER;
+	for (pass = 0; pass < 2; pass++) {
+		for (i = 0; i < 40; i++) {
+			t.ack += 1400;
+			t.other = i % 3 == 0;
+			t.data = i % 5 == 0 ? 1400 : 0;
+			skb[i] = cake_test_tcp_skb(test, &t);
+		}
+		rcu_read_lock_bh();
+		for (i = 0; i < 40; i++)
+			cake_test_enqueue(sch, skb[i]);
+		left = sch->q.qlen;
+		/* the first pass sent, the second reset with its packets queued */
+		if (!pass) {
+			struct sk_buff *out;
+
+			while ((out = cake_dequeue(sch))) {
+				sent++;
+				kfree_skb(out);
+			}
+		} else {
+			cake_reset(sch);
+		}
+		rcu_read_unlock_bh();
+		KUNIT_EXPECT_LT(test, left, 40);
+		KUNIT_EXPECT_EQ(test, sch->q.qlen, 0);
+		for (i = 0; i < CAKE_QUEUES; i++)
+			KUNIT_ASSERT_EQ_MSG(test, q->tins[0].flows[i].pure_acks, 0, "flow %d", i);
+	}
+	KUNIT_EXPECT_GT(test, sent, 0);
+}
+
+/* The wheel's own workings: a flow waits the passes it needs, at most
+ * CAKE_WHEEL_SLOTS - 1, with their shares; the pass served moves on to
+ * the next slot with flows, round the end; flows of a pass keep their
+ * order; a slot found empty loses its bit
+ */
+static void cake_test_wheel_slots(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	struct cake_tin_data *b = cake_test_alloc(test, sizeof(*b));
+	struct cake_flow *f = b->flows;
+	const s32 unit = 1 << CAKE_DEFICIT_SHIFT;
+	int i;
+
+	q->config = cake_test_alloc(test, sizeof(*q->config));
+	q->config->flow_mode = CAKE_FLOW_DUAL_SRC;
+	cake_init_flowchains(b);
+	b->bulk_quantum = 1000;
+	for (i = 0; i < 8; i++)
+		INIT_LIST_HEAD(&f[i].flowchain);
+	KUNIT_EXPECT_NULL(test, cake_bulk_head(b));
+
+	/* 2,500 bytes short: three passes' worth; none short: the next pass */
+	f[0].deficit = -2500 * unit;
+	cake_bulk_park(q, b, &f[0]);
+	KUNIT_EXPECT_EQ(test, f[0].deficit, 500 * unit);
+	f[1].deficit = 0;
+	cake_bulk_park(q, b, &f[1]);
+	KUNIT_EXPECT_EQ(test, f[1].deficit, 1000 * unit);
+	/* far short: the furthest slot, still short */
+	f[2].deficit = -100000 * unit;
+	cake_bulk_park(q, b, &f[2]);
+	KUNIT_EXPECT_EQ(test, f[2].deficit, -69000 * unit);
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, BIT(1) | BIT(3) | BIT(31));
+	/* three more for the next pass, in their order */
+	for (i = 3; i < 6; i++) {
+		f[i].deficit = -10 * unit;
+		cake_bulk_park(q, b, &f[i]);
+	}
+
+	KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[1]);
+	KUNIT_EXPECT_EQ(test, b->cur_slot, 1);
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, BIT(1) | BIT(3) | BIT(31));
+	for (i = 1; i < 6; i += i == 1 ? 2 : 1) {
+		KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[i]);
+		list_del_init(&f[i].flowchain);
+	}
+	KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[0]);
+	KUNIT_EXPECT_EQ(test, b->cur_slot, 3);
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, BIT(3) | BIT(31));
+	list_del_init(&f[0].flowchain);
+	KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[2]);
+	KUNIT_EXPECT_EQ(test, b->cur_slot, 31);
+
+	/* round the end: 31 on from slot 31 is slot 30 */
+	cake_bulk_park(q, b, &f[2]);
+	KUNIT_EXPECT_EQ(test, f[2].deficit, -38000 * unit);
+	f[6].deficit = 0;
+	cake_bulk_park(q, b, &f[6]);
+	KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[6]);
+	KUNIT_EXPECT_EQ(test, b->cur_slot, 0);
+	list_del_init(&f[6].flowchain);
+	KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[2]);
+	KUNIT_EXPECT_EQ(test, b->cur_slot, 30);
+
+	/* taken out from elsewhere: its bit stays until the slot is served */
+	list_del_init(&f[2].flowchain);
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, BIT(30));
+	KUNIT_EXPECT_FALSE(test, cake_bulk_any(b));
+	KUNIT_EXPECT_NULL(test, cake_bulk_head(b));
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, 0);
+
+	/* a host's share of the quantum per pass: 1000 / 3 */
+	b->hosts[4].srchost_bulk_flow_count = 3;
+	f[7].srchost = 4;
+	f[7].deficit = -1000 * unit;
+	cake_bulk_park(q, b, &f[7]);
+	KUNIT_EXPECT_EQ(test, f[7].deficit,
+			4 * (s32)((1000 * quantum_div[3]) >> (16 - CAKE_DEFICIT_SHIFT)) - 1000 * unit);
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, BIT(30 + 4 - 32));
+}
+
+/* Upstream's bulk rotation, for the wheel to be measured against: one list,
+ * each flow given its host's share of the bulk quantum each time it comes
+ * round, until its deficit is positive, as cake_dequeue() did. The share
+ * as the wheel works it out (@dither false), or as upstream did, in whole
+ * bytes, dithered. Every flow always has packets until it stops; one that
+ * has stopped leaves when it's found empty, and its host's count goes down
+ * then.
+ */
+#define CAKE_TEST_RR_FLOWS	128
+
+struct cake_test_rr {
+	s64	deficit[CAKE_TEST_RR_FLOWS];	/* as the wheel's, CAKE_DEFICIT_SHIFT */
+	u8	host[CAKE_TEST_RR_FLOWS];
+	bool	stopped[CAKE_TEST_RR_FLOWS];
+	u16	ring[CAKE_TEST_RR_FLOWS];	/* the list, from ring[first] */
+	u16	first, n;
+	u16	hosts[2];			/* each host's bulk flows */
+	bool	dither;
+	u64	bytes[CAKE_TEST_RR_FLOWS];
+	u64	visits;
+};
+
+/* one packet of @len from the rotation: its flow, or -1 if none is left */
+static int cake_test_rr_send(struct cake_test_rr *rr, u16 quantum, u32 len)
+{
+	while (rr->n) {
+		u16 f = rr->ring[rr->first];
+		u16 load = max_t(u16, rr->hosts[rr->host[f]], 1);
+
+		if (rr->deficit[f] <= 0) {
+			if (!rr->dither)
+				rr->deficit[f] += cake_host_share(quantum, load);
+			else if (load == 1)
+				rr->deficit[f] += (s64)quantum << CAKE_DEFICIT_SHIFT;
+			else
+				rr->deficit[f] += (s64)((quantum * quantum_div[load] +
+							 get_random_u16()) >> 16) << CAKE_DEFICIT_SHIFT;
+			rr->visits++;
+			/* to the tail */
+			rr->ring[(rr->first + rr->n) % CAKE_TEST_RR_FLOWS] = f;
+			rr->first = (rr->first + 1) % CAKE_TEST_RR_FLOWS;
+			continue;
+		}
+		if (rr->stopped[f]) {
+			rr->hosts[rr->host[f]]--;
+			rr->first = (rr->first + 1) % CAKE_TEST_RR_FLOWS;
+			rr->n--;
+			continue;
+		}
+		rr->deficit[f] -= (s64)len << CAKE_DEFICIT_SHIFT;
+		rr->bytes[f] += len;
+		return f;
+	}
+	return -1;
+}
+
+struct cake_test_wheel_case {
+	u16	flows[2];	/* bulk flows from host 0 and host 1 */
+	u32	len;		/* their packets' length */
+	u16	quantum;	/* the tin's bulk quantum */
+	u16	stop_to;	/* host 1's flows halfway through, if non-zero */
+};
+
+/* The same flows through the wheel (cake_bulk_head(), cake_bulk_park() and
+ * cake_flow_emptied() on a tin, in cake_dequeue()'s order) and through
+ * upstream's rotation, with quanta as at 800 Mbit/s without split-gso and
+ * at the MTU with it.
+ *
+ * Against the rotation with the same shares: at every point, each flow's
+ * bytes are within what it sends in one pass (one packet, or more where
+ * its share is more than a packet): the flows of a pass go in the order
+ * they joined it, upstream's in the order of the list. Where a host's
+ * flows stop, a flow of the host parked before it knew may go on with the
+ * smaller share for up to CAKE_WHEEL_SLOTS - 1 passes, and the other
+ * host's flow gets what it doesn't: as far apart again, at the new share.
+ * Once settled, the flows send at the same rates.
+ *
+ * Against upstream's dithered shares (where a host has a few flows), each
+ * flow's bytes at the end are within 1% (and two packets) of upstream's,
+ * and the lag above where a host's flows stopped.
+ *
+ * Kept short: sch_cake's suite runs each time the module loads.
+ *
+ * And at most two visits per packet sent, or one per CAKE_WHEEL_SLOTS - 1
+ * passes where a packet takes more than that many.
+ */
+static void cake_test_wheel_vs_list(struct kunit *test)
+{
+	static const struct cake_test_wheel_case cases[] = {
+		{ { 1, 16 }, 65536, 24414 }, { { 1, 16 }, 16384, 24414 },
+		{ { 1, 16 }, 1514, 1514 },
+		{ { 16, 0 }, 65536, 24414 }, { { 16, 0 }, 1514, 1514 },
+		{ { 100, 0 }, 65536, 24414 }, { { 100, 0 }, 16384, 24414 },
+		{ { 100, 0 }, 1514, 1514 },
+		{ { 1, 16 }, 65536, 24414, 1 }, { { 1, 16 }, 16384, 24414, 1 },
+		{ { 1, 16 }, 1514, 1514, 1 },
+	};
+	int c;
+
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		const struct cake_test_wheel_case *wc = &cases[c];
+		struct cake_test_rr *rr = cake_test_alloc(test, 2 * sizeof(*rr));
+		struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+		struct cake_tin_data *b = cake_test_alloc(test, sizeof(*b));
+		u64 *bytes = cake_test_alloc(test, 3 * CAKE_TEST_RR_FLOWS * sizeof(u64));
+		u64 *late = bytes + CAKE_TEST_RR_FLOWS, *late_rr = late + CAKE_TEST_RR_FLOWS;
+		u16 n = wc->flows[0] + wc->flows[1];
+		/* enough for each flow to send a few packets */
+		const u32 packets = n > 20 ? 300 : 800;
+		const int refs = n > 20 ? 1 : 2;
+		u64 visits = 0, worst = 0, worst_dither = 0, max_visits, apart[2], lag;
+		u32 sent, need, over = 0, settled = 0, off = 0;
+		int i, h, r;
+
+		q->config = cake_test_alloc(test, sizeof(*q->config));
+		q->config->flow_mode = CAKE_FLOW_DUAL_SRC;
+		cake_init_flowchains(b);
+		b->bulk_quantum = wc->quantum;
+		for (i = 0; i < n; i++) {
+			struct cake_flow *flow = &b->flows[i];
+
+			h = i >= wc->flows[0];
+			for (r = 0; r < 2; r++) {
+				rr[r].host[i] = h;
+				rr[r].ring[i] = i;
+			}
+			flow->srchost = h;
+			flow->set = CAKE_SET_BULK;
+			flow->mq_host_cnt = CAKE_MQ_CNT_SRC;
+			list_add_tail(&flow->flowchain, &b->old_wheel[0]);
+		}
+		b->wheel_mask = BIT(0);
+		for (r = 0; r < 2; r++) {
+			rr[r].n = n;
+			rr[r].dither = r;
+			for (h = 0; h < 2; h++)
+				rr[r].hosts[h] = wc->flows[h];
+		}
+		for (h = 0; h < 2; h++)
+			b->hosts[h].srchost_bulk_flow_count = wc->flows[h];
+		b->bulk_flow_count = n;
+		/* what a flow of each host may send in a pass, at its largest share */
+		for (h = 0; h < 2; h++) {
+			u16 least = h && wc->stop_to ? wc->stop_to : wc->flows[h];
+			u32 share = cake_host_share(wc->quantum, least) >> CAKE_DEFICIT_SHIFT;
+
+			apart[h] = (u64)wc->len * max_t(u32, 1, DIV_ROUND_UP(share, wc->len));
+		}
+		lag = (u64)(CAKE_WHEEL_SLOTS - 1) *
+		      (cake_host_share(wc->quantum, wc->stop_to ?: 1) >> CAKE_DEFICIT_SHIFT);
+
+		for (sent = 0; sent < packets; sent++) {
+			struct cake_flow *flow;
+			int f, k, at[2];
+
+			if (wc->stop_to && sent == packets / 2)
+				for (i = wc->flows[0] + wc->stop_to; i < n; i++)
+					rr[0].stopped[i] = rr[1].stopped[i] = true;
+			f = cake_test_rr_send(&rr[0], wc->quantum, wc->len);
+			KUNIT_ASSERT_GE(test, f, 0);
+			if (refs > 1)
+				KUNIT_ASSERT_GE(test, cake_test_rr_send(&rr[1], wc->quantum, wc->len), 0);
+
+			while (1) {
+				flow = cake_bulk_head(b);
+				KUNIT_ASSERT_NOT_NULL(test, flow);
+				i = flow - b->flows;
+				if (flow->deficit <= 0) {
+					cake_bulk_park(q, b, flow);
+					visits++;
+					continue;
+				}
+				if (rr[0].stopped[i]) {
+					cake_flow_emptied(q, b, flow, 0);
+					continue;
+				}
+				break;
+			}
+			flow->deficit -= (s32)(wc->len << CAKE_DEFICIT_SHIFT);
+			bytes[i] += wc->len;
+
+			/* only the flows that just sent are any further apart */
+			at[0] = i;
+			at[1] = f;
+			for (k = 0; k < 2; k++) {
+				u64 d = abs_diff(bytes[at[k]], rr[0].bytes[at[k]]);
+
+				h = rr[0].host[at[k]];
+				worst = max(worst, d);
+				over += d > apart[h] + (wc->stop_to && sent >= packets / 2 ? lag : 0);
+			}
+			if (sent == packets * 3 / 4)
+				for (i = 0; i < n; i++) {
+					late[i] = bytes[i];
+					late_rr[i] = rr[0].bytes[i];
+				}
+		}
+		for (i = 0; i < n; i++) {
+			u64 d = abs_diff(bytes[i], rr[1].bytes[i]);
+
+			if (refs > 1) {
+				worst_dither = max(worst_dither, d);
+				off += d > max_t(u64, rr[1].bytes[i] / 100, 2 * wc->len) +
+				       (wc->stop_to ? lag : 0);
+			}
+			settled += abs_diff(bytes[i] - late[i], rr[0].bytes[i] - late_rr[i]) >
+				   2 * apart[rr[0].host[i]];
+		}
+		/* the passes a packet takes, at the smallest share */
+		need = DIV_ROUND_UP(wc->len,
+				    cake_host_share(wc->quantum, max(wc->flows[0], wc->flows[1])) >>
+				    CAKE_DEFICIT_SHIFT);
+		max_visits = (u64)packets * max_t(u32, 2, DIV_ROUND_UP(need + 1, CAKE_WHEEL_SLOTS - 1));
+		kunit_info(test, "%u+%u flows, %u B packets, quantum %u%s: %llu visits for %u packets (list: %llu); %llu B apart at most, %llu B from dithered shares",
+			   wc->flows[0], wc->flows[1], wc->len, wc->quantum,
+			   wc->stop_to ? ", host 1 down to one" : "", visits, packets, rr[0].visits,
+			   worst, worst_dither);
+		KUNIT_EXPECT_EQ_MSG(test, over, 0, "case %d: flows further apart than a pass", c);
+		KUNIT_EXPECT_EQ_MSG(test, settled, 0, "case %d: flows at other rates once settled", c);
+		KUNIT_EXPECT_EQ_MSG(test, off, 0, "case %d: flows off upstream's shares", c);
+		KUNIT_EXPECT_LE_MSG(test, visits, max_visits, "case %d", c);
+		/* a host with flows left has them back, in both */
+		KUNIT_EXPECT_EQ(test, b->hosts[1].srchost_bulk_flow_count, rr[0].hosts[1]);
+	}
+}
+
+/* Through cake_enqueue() and cake_dequeue(): a host with one flow and one
+ * with eight, 16 KB packets, with the bulk quantum of 800 Mbit/s (the
+ * shaper off, so nothing waits for it). Once every flow has turned bulk
+ * and the host loads have settled, the hosts send alike, to within a
+ * pass, and the eight flows alike.
+ */
+static void cake_test_wheel_live(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 100000000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	struct cake_tin_data *b = &q->tins[0];
+	struct Qdisc *sch = mq->sch[0];
+	u32 host[2] = {}, flow[8] = {}, bad = 0, i, f, n = 0;
+	int ret = NET_XMIT_SUCCESS;
+	struct sk_buff **skb;
+	u8 one, two;
+
+	q->config->flow_mode = CAKE_FLOW_DUAL_SRC;
+	q->config->rate_flags &= ~CAKE_FLAG_SPLIT_GSO;
+	cake_reconfigure(sch);
+	KUNIT_ASSERT_EQ(test, b->bulk_quantum, 100000000 >> 12);
+	q->rate_ns = 0;
+	/* nothing COBALT would act on */
+	b->cparams.target = 10ULL * NSEC_PER_SEC;
+	b->cparams.interval = 100ULL * NSEC_PER_SEC;
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	/* enough for all that's sent: half of it from the first host's one flow */
+	cake_test_two_hosts(test, &one, &two);
+	skb = cake_test_alloc(test, 400 * sizeof(*skb));
+	for (f = 0; f < 9; f++) {
+		for (i = 0; i < (f ? 25 : 200); i++, n++) {
+			skb[n] = cake_test_skb(test, false, IPPROTO_TCP, f ? two : one, 41000 + f, 0);
+			kunit_remove_action(test, cake_test_free_skb, skb[n]);
+			qdisc_skb_cb(skb[n])->pkt_len = 16384;
+		}
+	}
+	rcu_read_lock_bh();
+	for (i = 0; i < n; i++) {
+		struct sk_buff *to_free = NULL;
+
+		ret |= cake_enqueue(skb[i], sch, &to_free);
+		bad += !!to_free;
+	}
+	for (i = 0; i < 9 + 40 + 240; i++) {
+		struct sk_buff *skb = cake_dequeue(sch);
+
+		if (!skb) {
+			bad++;
+			break;
+		}
+		f = ntohs(tcp_hdr(skb)->source) - 41000;
+		kfree_skb(skb);
+		/* each flow's first packet goes as a new flow; then the host
+		 * loads settle
+		 */
+		if (i < 9 + 40)
+			continue;
+		host[!!f]++;
+		if (f)
+			flow[f - 1]++;
+	}
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_EQ(test, ret, NET_XMIT_SUCCESS);
+	KUNIT_EXPECT_EQ(test, bad, 0);
+	/* host 5's flow sends up to two packets a pass */
+	KUNIT_EXPECT_LE_MSG(test, abs((int)host[0] - (int)host[1]), 3, "%u against %u",
+			    host[0], host[1]);
+	for (f = 0; f < 8; f++)
+		KUNIT_EXPECT_LE_MSG(test, abs((int)flow[f] - (int)host[1] / 8), 1, "flow %u: %u of %u",
+				    f, flow[f], host[1]);
+}
+
+/* @n packets from host @host, each @len to CAKE, made before bottom halves
+ * go off; whoever they go to owns them
+ */
+static void cake_test_pkts(struct kunit *test, struct sk_buff **skb, int n, u8 host, u32 len)
+{
+	int i;
+
+	for (i = 0; i < n; i++) {
+		skb[i] = cake_test_skb(test, false, IPPROTO_UDP, host, 41000, 0);
+		kunit_remove_action(test, cake_test_free_skb, skb[i]);
+		qdisc_skb_cb(skb[i])->pkt_len = len;
+	}
+}
+
+/* @skb into @sch as it is (its length to CAKE already set) */
+static bool cake_test_in(struct Qdisc *sch, struct sk_buff *skb)
+{
+	struct sk_buff *to_free = NULL;
+	int ret = cake_enqueue(skb, sch, &to_free);
+
+	kfree_skb_list(to_free);
+	return ret == NET_XMIT_SUCCESS && !to_free;
+}
+
+/* the next packet out of @sch is @skb: freed */
+static bool cake_test_out(struct Qdisc *sch, struct sk_buff *skb)
+{
+	struct sk_buff *out = cake_dequeue(sch);
+
+	kfree_skb(out);
+	return out && out == skb;
+}
+
+/* The flow in @b whose queue starts with @skb */
+static struct cake_flow *cake_test_flow_of(struct cake_tin_data *b, struct sk_buff *skb)
+{
+	int i;
+
+	for (i = 0; i < CAKE_QUEUES; i++)
+		if (b->flows[i].head == skb)
+			return &b->flows[i];
+	return NULL;
+}
+
+/* cake_mq on @mq's device as cake_mq_init() leaves it, its first @n
+ * sub-cakes live: the root's config, shared by every sub-cake, at @rate in
+ * @tin_mode with triple-isolate; its host tables; each live sub-cake's tins
+ * and flows set up, its lock and watchdogs ready, its handle 2: on, and
+ * emptied and its watchdogs cancelled with the test
+ */
+static struct Qdisc *cake_test_mq_root(struct kunit *test, struct cake_test_mq *mq, int n,
+				       u64 rate, u8 tin_mode)
+{
+	struct Qdisc *root = cake_test_alloc(test, sizeof(*root) + sizeof(struct cake_mq_sched));
+	struct cake_mq_sched *priv = qdisc_priv(root);
+	struct cake_sched_config *cfg = &priv->cake_config;
+	int i, t, j;
+
+	root->dev_queue = netdev_get_tx_queue(mq->dev, 0);
+	cake_config_init(cfg, true);
+	cfg->rate_bps = rate;
+	cfg->tin_mode = tin_mode;
+	cfg->used_qs = mq->cfg->used_qs;
+	cfg->mq_hosts = cake_test_alloc(test, 2 * CAKE_MAX_TINS * CAKE_QUEUES * sizeof(atomic_t));
+	mq->cfg = cfg;
+	for (i = 0; i < CAKE_TEST_TXQS; i++) {
+		struct Qdisc *sch = mq->sch[i];
+		struct cake_sched_data *q = qdisc_priv(sch);
+
+		q->config = cfg;
+		if (i >= n)
+			continue;
+		spin_lock_init(qdisc_lock(sch));
+		sch->limit = 10240;
+		sch->handle = TC_H_MAKE((i + 2) << 16, 0);
+		q->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(*q->tins));
+		for (t = 0; t < CAKE_MAX_TINS; t++) {
+			struct cake_tin_data *b = &q->tins[t];
+
+			cake_init_flowchains(b);
+			for (j = 0; j < CAKE_QUEUES; j++) {
+				INIT_LIST_HEAD(&b->flows[j].flowchain);
+				cobalt_vars_init(&b->flows[j].cvars);
+			}
+		}
+		qdisc_watchdog_init(&q->watchdog, sch);
+		qdisc_watchdog_init(&q->mq_watchdog, sch);
+		KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_cancel_watchdogs, q));
+		cake_config_replace(sch, cfg);
+		q->min_netlen = ~0;
+		q->min_adjlen = ~0;
+		KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+	}
+	return root;
+}
+
+/* Each tin's host table holds what @mq's first @n sub-cakes count in that
+ * tin under its tags: how many differ
+ */
+static u32 cake_test_mq_tables_off(struct cake_test_mq *mq, int n)
+{
+	int (*sums)[CAKE_QUEUES] = kcalloc(2, sizeof(*sums), GFP_KERNEL);
+	u32 off = 0;
+	int t, i, k;
+
+	if (!sums)
+		return U32_MAX;
+	for (t = 0; t < CAKE_MAX_TINS; t++) {
+		memset(sums, 0, 2 * sizeof(*sums));
+		for (i = 0; i < n; i++) {
+			struct cake_tin_data *b = &cake_test_mq_q(mq, i)->tins[t];
+
+			for (k = 0; k < CAKE_QUEUES; k++) {
+				sums[0][b->hosts[k].srchost_tag % CAKE_QUEUES] +=
+					b->hosts[k].srchost_bulk_flow_count;
+				sums[1][b->hosts[k].dsthost_tag % CAKE_QUEUES] +=
+					b->hosts[k].dsthost_bulk_flow_count;
+			}
+		}
+		for (k = 0; k < CAKE_QUEUES; k++) {
+			off += atomic_read(&mq->cfg->mq_hosts[2 * t * CAKE_QUEUES + k]) != sums[0][k];
+			off += atomic_read(&mq->cfg->mq_hosts[(2 * t + 1) * CAKE_QUEUES + k]) != sums[1][k];
+		}
+	}
+	kfree(sums);
+	return off;
+}
+
+/* Packets queued in @b, flow by flow */
+static u32 cake_test_tin_packets(struct cake_tin_data *b)
+{
+	u32 n = 0;
+	int k;
+
+	for (k = 0; k < CAKE_QUEUES; k++) {
+		struct sk_buff *skb;
+
+		for (skb = b->flows[k].head; skb; skb = skb->next)
+			n++;
+	}
+	return n;
+}
+
+/* Options for a change to @rate in @diffserv, with @overhead and @mpu */
+static struct nlattr *cake_test_opts_overhead(struct kunit *test, u64 rate, u32 diffserv,
+					      s32 overhead, u32 mpu)
+{
+	struct sk_buff *msg = nlmsg_new(NLMSG_DEFAULT_SIZE, GFP_KERNEL);
+	struct nlattr *opts;
+
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_free_skb, msg));
+	opts = nla_nest_start_noflag(msg, TCA_OPTIONS);
+	KUNIT_ASSERT_NOT_NULL(test, opts);
+	KUNIT_ASSERT_EQ(test, 0, nla_put_u64_64bit(msg, TCA_CAKE_BASE_RATE64, rate, TCA_CAKE_PAD));
+	KUNIT_ASSERT_EQ(test, 0, nla_put_u32(msg, TCA_CAKE_DIFFSERV_MODE, diffserv));
+	KUNIT_ASSERT_EQ(test, 0, nla_put_s32(msg, TCA_CAKE_OVERHEAD, overhead));
+	KUNIT_ASSERT_EQ(test, 0, nla_put_u32(msg, TCA_CAKE_MPU, mpu));
+	nla_nest_end(msg, opts);
+	return opts;
+}
+
+/* cake_mq_change() with packets queued in four sub-cakes, all four tins of
+ * diffserv4 in each, flows gone bulk and counted by host. To besteffort:
+ * every sub-cake drops the other tins' packets, its counts and backlog
+ * then tin 0's alone; their bulk flows leave the host tables, which still
+ * hold what the sub-cakes count; the overflow heap, built over four tins
+ * by a drop, is built again over one at the next. Back to diffserv4 with
+ * overhead 18 and mpu 64: each sub-cake's packet sizes seen start afresh,
+ * and a new packet is charged with them. Everything then sent: nothing
+ * counted queued anywhere, and the host tables empty once the rotations
+ * retire.
+ */
+static void cake_test_mq_change_live(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct Qdisc *root = cake_test_mq_root(test, mq, 4, 0, CAKE_DIFFSERV_DIFFSERV4);
+	struct cake_sched_data *q0 = cake_test_mq_q(mq, 0);
+	struct sk_buff *skb[4][4][2][4], *extra[2], *late;
+	u32 heap[2], timeout[2], tables[4], adj, want_adj;
+	u32 qlen[4], tin0[4], left[4], other[4];
+	int ret[3], s, t, h, i;
+	bool ok = true;
+
+	for (s = 0; s < 4; s++)
+		for (t = 0; t < 4; t++)
+			for (h = 0; h < 2; h++)
+				for (i = 0; i < 4; i++) {
+					struct sk_buff *x = cake_test_skb(test, false, IPPROTO_TCP,
+									  10 + 2 * s + h, 40000 + t, 0);
+
+					kunit_remove_action(test, cake_test_free_skb, x);
+					x->priority = TC_H_MAKE(mq->sch[s]->handle, t + 1);
+					/* full-sized to CAKE: a flow's quantum lasts one */
+					qdisc_skb_cb(x)->pkt_len = 1514;
+					skb[s][t][h][i] = x;
+				}
+	for (i = 0; i < 2; i++) {
+		extra[i] = cake_test_skb(test, false, IPPROTO_TCP, 10, 40000, 0);
+		kunit_remove_action(test, cake_test_free_skb, extra[i]);
+		qdisc_skb_cb(extra[i])->pkt_len = 1514;
+	}
+	late = cake_test_skb(test, false, IPPROTO_TCP, 12, 40002, 0);
+	kunit_remove_action(test, cake_test_free_skb, late);
+	late->priority = TC_H_MAKE(mq->sch[1]->handle, 3);
+
+	/* three packets for each of two hosts' flows in each tin; half sent,
+	 * their flows bulk; then a fourth for each, so every tin has some
+	 */
+	rcu_read_lock_bh();
+	for (s = 0; s < 4; s++) {
+		for (t = 0; t < 4; t++)
+			for (h = 0; h < 2; h++)
+				for (i = 0; i < 3; i++)
+					ok &= cake_test_in(mq->sch[s], skb[s][t][h][i]);
+		for (i = 0; i < 12; i++) {
+			struct sk_buff *out = cake_dequeue(mq->sch[s]);
+
+			ok &= out != NULL;
+			kfree_skb(out);
+		}
+		for (t = 0; t < 4; t++)
+			for (h = 0; h < 2; h++)
+				ok &= cake_test_in(mq->sch[s], skb[s][t][h][3]);
+	}
+	/* sub-cake 0's buffer full: a drop builds its heap */
+	extra[0]->priority = TC_H_MAKE(mq->sch[0]->handle, 2);
+	q0->buffer_limit = q0->buffer_used;
+	cake_test_in(mq->sch[0], extra[0]);
+	q0->buffer_limit = ~0;
+	heap[0] = q0->overflow_heap_len;
+	timeout[0] = q0->overflow_timeout;
+	rcu_read_unlock_bh();
+	tables[0] = cake_test_mq_tables_off(mq, 4);
+	KUNIT_ASSERT_TRUE(test, ok);
+	KUNIT_EXPECT_EQ(test, heap[0], 4 * CAKE_QUEUES);
+	/* the host tables have something to hold */
+	for (s = 0, i = 0; s < 4; s++)
+		for (t = 0; t < 4; t++)
+			i += cake_test_mq_q(mq, s)->tins[t].bulk_flow_count;
+	KUNIT_EXPECT_GT(test, i, 0);
+	KUNIT_EXPECT_GT(test, timeout[0], 0);
+
+	rtnl_lock();
+	ret[0] = cake_mq_change(root, cake_test_opts(test, 0, CAKE_DIFFSERV_BESTEFFORT, false), NULL);
+	rtnl_unlock();
+
+	for (s = 0; s < 4; s++) {
+		struct cake_sched_data *q = cake_test_mq_q(mq, s);
+
+		qlen[s] = mq->sch[s]->q.qlen;
+		tin0[s] = cake_test_tin_packets(&q->tins[0]);
+		other[s] = 0;
+		for (t = 1; t < CAKE_MAX_TINS; t++)
+			other[s] += q->tins[t].tin_backlog + cake_test_tin_packets(&q->tins[t]);
+		KUNIT_EXPECT_EQ_MSG(test, q->tin_cnt, 1, "sub-cake %d", s);
+		KUNIT_EXPECT_EQ_MSG(test, qlen[s], tin0[s], "sub-cake %d", s);
+		KUNIT_EXPECT_EQ_MSG(test, mq->sch[s]->qstats.backlog, q->tins[0].tin_backlog, "sub-cake %d", s);
+		KUNIT_EXPECT_EQ_MSG(test, other[s], 0, "sub-cake %d", s);
+		KUNIT_EXPECT_GE_MSG(test, qlen[s], 2, "sub-cake %d", s);
+	}
+	timeout[1] = q0->overflow_timeout;
+	tables[1] = cake_test_mq_tables_off(mq, 4);
+
+	/* the next drop builds the heap over the one tin */
+	rcu_read_lock_bh();
+	q0->buffer_limit = q0->buffer_used;
+	cake_test_in(mq->sch[0], extra[1]);
+	q0->buffer_limit = ~0;
+	heap[1] = q0->overflow_heap_len;
+	rcu_read_unlock_bh();
+
+	rtnl_lock();
+	ret[1] = cake_mq_change(root, cake_test_opts_overhead(test, 0, CAKE_DIFFSERV_DIFFSERV4, 18, 64),
+				NULL);
+	rtnl_unlock();
+	for (s = 0; s < 4; s++) {
+		struct cake_sched_data *q = cake_test_mq_q(mq, s);
+
+		KUNIT_EXPECT_EQ(test, q->tin_cnt, 4);
+		KUNIT_EXPECT_EQ(test, q->max_netlen, 0);
+		KUNIT_EXPECT_EQ(test, q->min_netlen, U16_MAX);
+	}
+	want_adj = max_t(s32, late->len - skb_network_offset(late) + 18, 64);
+	rcu_read_lock_bh();
+	ret[2] = cake_test_enqueue(mq->sch[1], late);
+	adj = get_cobalt_cb(late)->adjusted_len;
+	/* everything out */
+	for (s = 0; s < 4; s++) {
+		struct sk_buff *out;
+
+		while ((out = cake_dequeue(mq->sch[s])))
+			kfree_skb(out);
+		for (t = 0; t < CAKE_MAX_TINS; t++)
+			cake_mq_retire_tin(cake_test_mq_q(mq, s), &cake_test_mq_q(mq, s)->tins[t],
+					   ktime_get());
+	}
+	rcu_read_unlock_bh();
+	tables[2] = cake_test_mq_tables_off(mq, 4);
+	tables[3] = 0;
+	for (s = 0; s < 4; s++) {
+		struct cake_sched_data *q = cake_test_mq_q(mq, s);
+
+		left[s] = mq->sch[s]->q.qlen + mq->sch[s]->qstats.backlog + q->buffer_used;
+		for (t = 0; t < CAKE_MAX_TINS; t++)
+			left[s] += q->tins[t].tin_backlog + q->tins[t].bulk_flow_count;
+		KUNIT_EXPECT_EQ_MSG(test, left[s], 0, "sub-cake %d", s);
+	}
+	for (i = 0; i < 2 * CAKE_MAX_TINS * CAKE_QUEUES; i++)
+		if (atomic_read(&mq->cfg->mq_hosts[i]))
+			tables[3] = i + 1;
+
+	KUNIT_EXPECT_EQ(test, ret[0], 0);
+	KUNIT_EXPECT_EQ(test, ret[1], 0);
+	KUNIT_EXPECT_EQ(test, ret[2], NET_XMIT_SUCCESS);
+	KUNIT_EXPECT_EQ(test, tables[0], 0);
+	KUNIT_EXPECT_EQ(test, timeout[1], 0);
+	KUNIT_EXPECT_EQ(test, tables[1], 0);
+	KUNIT_EXPECT_EQ(test, heap[1], CAKE_QUEUES);
+	KUNIT_EXPECT_EQ(test, mq->cfg->rate_overhead, 18);
+	KUNIT_EXPECT_EQ(test, mq->cfg->rate_mpu, 64);
+	KUNIT_EXPECT_TRUE(test, mq->cfg->rate_flags & CAKE_FLAG_OVERHEAD);
+	KUNIT_EXPECT_EQ(test, adj, want_adj);
+	KUNIT_EXPECT_EQ(test, tables[2], 0);
+	KUNIT_EXPECT_EQ(test, tables[3], 0);
+}
+
+/* cake_mq_change() on a shaped cake_mq whose four sub-cakes each send at a
+ * quarter of the rate, the shaper of each holding its next packet 10 ms
+ * off: with the rate as it was (another option changed), down a tenth, and
+ * doubled. Each sub-cake goes on at its share, scaled to the new rate, its
+ * waits with it, rather than at the whole rate; and at its next resync in
+ * cake_dequeue(), which finds the same share, its waits stay as they were,
+ * not four times as long.
+ */
+static void cake_test_mq_change_shaped(struct kunit *test)
+{
+	static const u64 rate = 12500000;
+	static const u32 num[] = { 1, 9, 2 }, den[] = { 1, 10, 1 };
+	const u64 wait = 10 * NSEC_PER_MSEC;
+	u64 tin_rate[3], left[3], tin_left[3], synced[3];
+	struct sk_buff *out[3];
+	int c, s, ret[3];
+
+	for (c = 0; c < 3; c++) {
+		struct cake_test_mq *mq = cake_test_mq_alloc(test);
+		struct Qdisc *root = cake_test_mq_root(test, mq, 4, rate, CAKE_DIFFSERV_BESTEFFORT);
+		u64 new_rate = div_u64(rate * num[c], den[c]);
+		struct cake_sched_data *q0 = cake_test_mq_q(mq, 0);
+		struct sk_buff *skb[4][2];
+		ktime_t now;
+
+		for (s = 0; s < 4; s++)
+			cake_test_pkts(test, skb[s], 2, 10 + s, 1514);
+		rcu_read_lock_bh();
+		now = ktime_get();
+		for (s = 0; s < 4; s++) {
+			struct cake_sched_data *q = cake_test_mq_q(mq, s);
+
+			cake_test_in(mq->sch[s], skb[s][0]);
+			cake_test_in(mq->sch[s], skb[s][1]);
+			/* as a resync leaves it: a quarter of the rate each, all of
+			 * them wanting more, the same bid; a packet out 10 ms off
+			 */
+			cake_configure_rates(mq->sch[s], rate / 4, true);
+			q->synced_rate = rate / 4;
+			q->last_checked_active = ktime_to_ns(now);
+			WRITE_ONCE(q->last_active, ktime_to_ns(now));
+			WRITE_ONCE(q->mq_usage, rate / 4);
+			WRITE_ONCE(q->mq_saturated, true);
+			q->time_next_packet = ktime_add_ns(now, wait);
+			q->failsafe_next_packet = ktime_add_ns(now, wait);
+			q->tins[0].time_next_packet = ktime_add_ns(now, wait);
+		}
+		rcu_read_unlock_bh();
+
+		rtnl_lock();
+		ret[c] = cake_mq_change(root, cake_test_opts(test, new_rate,
+							     CAKE_DIFFSERV_BESTEFFORT, false), NULL);
+		rtnl_unlock();
+		tin_rate[c] = q0->tins[0].tin_rate_bps;
+
+		/* sub-cake 0's next resync, the others as they were */
+		rcu_read_lock_bh();
+		q0->last_checked_active = ktime_to_ns(ktime_get()) - 2 * mq->cfg->sync_time;
+		for (s = 1; s < 4; s++)
+			WRITE_ONCE(cake_test_mq_q(mq, s)->last_active, ktime_to_ns(ktime_get()));
+		out[c] = cake_dequeue(mq->sch[0]);
+		synced[c] = q0->synced_rate;
+		left[c] = ktime_to_ns(ktime_sub(q0->time_next_packet, now));
+		tin_left[c] = ktime_to_ns(ktime_sub(q0->tins[0].time_next_packet, now));
+		rcu_read_unlock_bh();
+
+		KUNIT_EXPECT_EQ_MSG(test, ret[c], 0, "case %d", c);
+		KUNIT_EXPECT_NULL_MSG(test, out[c], "case %d: sent while held", c);
+		kfree_skb(out[c]);
+		/* sent at its share from the change on */
+		KUNIT_EXPECT_EQ_MSG(test, tin_rate[c], div_u64(new_rate, 4), "case %d", c);
+		KUNIT_EXPECT_EQ_MSG(test, synced[c], div_u64(new_rate, 4), "case %d", c);
+		/* the wait as long as the share's change makes it, give or
+		 * take the time the test took
+		 */
+		KUNIT_EXPECT_LE_MSG(test, left[c], div_u64(wait * den[c], num[c]) + NSEC_PER_MSEC,
+				    "case %d", c);
+		KUNIT_EXPECT_GE_MSG(test, left[c], div_u64(wait * den[c], num[c]) - NSEC_PER_MSEC,
+				    "case %d", c);
+		KUNIT_EXPECT_LE_MSG(test, tin_left[c],
+				    div_u64(wait * den[c], num[c]) + NSEC_PER_MSEC, "case %d", c);
+	}
+}
+
+/* cake_mq on a slow link: a sub-cake at an eighth of 4 Mbit/s, its one
+ * ECT(1) flow's full-size packets 24 ms each at that share, so the L4S
+ * ramp starts at 48 ms. COBALT takes such a flow as ignoring its marks
+ * only from four times the ramp's start, at the same rate: 60 ms, inside
+ * the ramp, is marked and never dropped. Worked out at the whole rate's
+ * 3 ms a packet, as it was, COBALT took the flow as ignoring its marks from
+ * 24 ms, before the ramp had begun, and dropped its packets.
+ */
+static void cake_test_l4s_mq_share(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_UDP, 2, 40000, 0);
+	struct cake_sched_data *q = cake_test_mq_q(mq, 0);
+	u32 fail = READ_ONCE(ecn_fail_count);
+	struct cake_test_ecn e;
+	struct cake_tin_data *b;
+
+	cake_test_mq_root(test, mq, 1, 500000, CAKE_DIFFSERV_BESTEFFORT);
+	cake_configure_rates(mq->sch[0], 500000 / 8, true);
+	b = &q->tins[0];
+	b->bulk_flow_count = 1;
+	KUNIT_EXPECT_EQ(test, cake_test_l4s_marks(test, b, skb, INET_ECN_ECT_1, 1514, 45000,
+						  false, 100), 0);
+	KUNIT_EXPECT_EQ(test, cake_test_l4s_marks(test, b, skb, INET_ECN_ECT_1, 1514, 100000,
+						  false, 100), 100);
+
+	cake_test_ecn_init(&e);
+	e.p = b->cparams;
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_1, 60 * NSEC_PER_MSEC,
+						4 * fail + 4 * COBALT_ECN_STRIKES), 0);
+	KUNIT_EXPECT_FALSE(test, e.v.ecn_ignored);
+}
+
+/* tc's options for a change of the fwmark mask alone */
+static struct nlattr *cake_test_opts_fwmark(struct kunit *test, u32 mask)
+{
+	struct sk_buff *msg = nlmsg_new(NLMSG_DEFAULT_SIZE, GFP_KERNEL);
+	struct nlattr *opts;
+
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_free_skb, msg));
+	opts = nla_nest_start_noflag(msg, TCA_OPTIONS);
+	KUNIT_ASSERT_NOT_NULL(test, opts);
+	KUNIT_ASSERT_EQ(test, 0, nla_put_u32(msg, TCA_CAKE_FWMARK, mask));
+	nla_nest_end(msg, opts);
+	return opts;
+}
+
+/* The fwmark picks the tin by the bits under its mask, shifted down, as
+ * the mask changes: 0xf0 takes a mark of 0x2c as 2 (the second tin), 0x0c
+ * as 3, and none leaves the packet to its DSCP (Best Effort here). The
+ * shift comes from the mask as the packet reads it, not from a second
+ * field a change writes after it.
+ */
+static void cake_test_fwmark_change(struct kunit *test)
+{
+	static const u32 masks[] = { 0xf0, 0x0c, 0 };
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 12500000,
+							CAKE_DIFFSERV_DIFFSERV4);
+	struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_UDP, 5, 41000, 0);
+	struct cake_tin_data *want[3], *got[3];
+	int i, ret[3];
+
+	want[0] = &q->tins[q->tin_order[1]];
+	want[1] = &q->tins[q->tin_order[2]];
+	want[2] = &q->tins[q->tin_index[0]];
+	skb->mark = 0x2c;
+	for (i = 0; i < 3; i++) {
+		rtnl_lock();
+		ret[i] = cake_change(mq->sch[0], cake_test_opts_fwmark(test, masks[i]), NULL);
+		rtnl_unlock();
+		got[i] = cake_select_tin(mq->sch[0], skb, ktime_get());
+	}
+	for (i = 0; i < 3; i++) {
+		KUNIT_EXPECT_EQ_MSG(test, ret[i], 0, "mask %#x", masks[i]);
+		KUNIT_EXPECT_PTR_EQ_MSG(test, got[i], want[i], "mask %#x", masks[i]);
+	}
+}
+
+/* --- the Bulk tin across cake_mq's sub-cakes ------------------------------- */
+
+/* The weight a sub-cake bids with: its tins' bulk weights, diffserv3's and
+ * diffserv4's Bulk tin (1) at a sixteenth; with none, a sixteenth of one
+ * host's when all it sent since its last resync, and holds, is Bulk's. Not
+ * in the tin modes without that tin. What it sent starts again each resync.
+ */
+static void cake_test_mq_bulk_weight(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	const u64 now = CAKE_TEST_NOW;
+	static const struct {
+		const u8 *order;
+		u16 tin_cnt;
+		u32 weight[4];
+		u8 seen;
+		bool backlog1;	/* packets queued in tin 1 */
+		u32 want;
+	} cases[] = {
+		{ bulk_order, 4, { 65535, 65535 }, 0, false, 65535 + 4095 },
+		{ bulk_order, 4, { 0, 65535 }, 0, false, 4095 },
+		{ bulk_order, 4, { 0, 3 }, 0, false, 1 },
+		{ bulk_order, 4, { 0, 0, 65535, 65535 }, 0, false, 2 * 65535 },
+		{ bulk_order, 3, { 0, 2 * 65535 }, 0, false, 8191 },
+		/* no bulk flow: Bulk's alone bids a sixteenth of one host's */
+		{ bulk_order, 4, { 0 }, BIT(1), false, 4095 },
+		{ bulk_order, 4, { 0 }, 0, true, 4095 },
+		{ bulk_order, 4, { 0 }, BIT(0) | BIT(1), false, 0 },
+		{ bulk_order, 4, { 0 }, BIT(1) | BIT(3), false, 0 },
+		{ bulk_order, 4, { 0 }, 0, false, 0 },
+		/* besteffort, diffserv8, precedence: as before */
+		{ normal_order, 8, { 0, 65535 }, 0, false, 65535 },
+		{ normal_order, 8, { 0 }, BIT(1), false, 0 },
+		{ normal_order, 1, { 65535 }, BIT(0), false, 65535 },
+	};
+	int c, t;
+
+	q->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(*q->tins));
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		q->tin_order = cases[c].order;
+		q->tin_cnt = cases[c].tin_cnt;
+		for (t = 0; t < CAKE_MAX_TINS; t++) {
+			q->tins[t].mq_weight = t < 4 ? cases[c].weight[t] : 0;
+			q->tins[t].tin_backlog = t == 1 && cases[c].backlog1 ? 1514 : 0;
+		}
+		q->mq_seen_tins = cases[c].seen;
+		q->last_checked_active = now - 200 * NSEC_PER_USEC;
+		q->synced_rate = CAKE_TEST_RATE;
+		cake_mq_publish(q, now);
+		KUNIT_EXPECT_EQ_MSG(test, q->mq_weight, cases[c].want, "case %d", c);
+		KUNIT_EXPECT_EQ_MSG(test, q->mq_seen_tins, 0, "case %d", c);
+	}
+}
+
+/* Two sub-cakes, each with bulk weights in some of its tins (one host
+ * each: 65535), as diffserv4, diffserv3 or besteffort/diffserv8 lay out
+ * their tins
+ */
+struct cake_test_tins_case {
+	const u8 *order;
+	u16 tin_cnt;
+	u32 weight[2][4];
+	/* sub-cake 0's flows end after this many 200 us steps (0: never) */
+	int stop;
+	/* what each gets once settled, per 1000 of the rate */
+	u32 want[2];
+};
+
+/* @c's two sub-cakes wanting all they can get for 30 ms, resyncing every
+ * 200 us as cake_dequeue() does: what each sent in the last 10 ms, as
+ * bytes/s, in @sent
+ */
+static void cake_test_mq_tins_run(struct cake_test_mq *mq, const struct cake_test_tins_case *c,
+				  u64 rate, u64 *sent)
+{
+	const u64 step = 200 * NSEC_PER_USEC;
+	u64 now = 10 * NSEC_PER_MSEC;
+	int t, k, i, tin;
+
+	mq->dev->real_num_tx_queues = 2;
+	bitmap_zero(mq->cfg->used_qs, CAKE_TEST_TXQS);
+	mq->cfg->rate_bps = rate;
+	for (i = 0; i < 2; i++) {
+		struct cake_sched_data *q = cake_test_mq_q(mq, i);
+
+		mq->sch[i]->q.qlen = 0;
+		q->tin_cnt = c->tin_cnt;
+		q->tin_order = c->order;
+		for (tin = 0; tin < CAKE_MAX_TINS; tin++) {
+			q->tins[tin].mq_weight = tin < 4 ? c->weight[i][tin] : 0;
+			q->tins[tin].tin_backlog = 0;
+		}
+		q->synced_rate = rate;
+		q->last_checked_active = now - step;
+		q->last_active = 0;
+		q->mq_usage = q->mq_sparse = q->mq_bytes = q->mq_sparse_bytes = 0;
+		q->mq_idle = 0;
+		q->mq_packets = 0;
+		q->mq_held_at = 0;
+		q->mq_drained_at = 0;
+		q->mq_seen_tins = 0;
+		q->mq_weight = 0;
+		q->mq_saturated = false;
+		sent[i] = 0;
+		cake_test_mq_enqueue(mq, i);
+	}
+
+	for (t = 0; t < 150; t++) {
+		now += step;
+		for (k = 0; k < 2; k++) {
+			struct cake_sched_data *q;
+			struct cake_mq_peers p;
+			u64 share;
+
+			i = (k + t) % 2;
+			q = cake_test_mq_q(mq, i);
+			if (i == 0 && c->stop && t >= c->stop) {
+				if (mq->sch[0]->q.qlen) {
+					mq->sch[0]->q.qlen = 0;
+					q->mq_drained_at = now;
+				}
+				continue;
+			}
+			/* asking for more than it may send: its shaper holds packets */
+			q->mq_held_at = now - step / 2;
+			if (t >= 100)
+				sent[i] += q->synced_rate;
+			q->mq_bytes = div64_u64(q->synced_rate * step, NSEC_PER_SEC);
+			q->mq_packets = 10;
+			q->last_active = now;
+			cake_mq_publish(q, now);
+			cake_test_mq_peers(mq, i, now, &p);
+			share = cake_mq_share(rate, q->mq_weight, q->mq_sparse, &p);
+			if (cake_mq_share_moved(share, q->synced_rate, rate))
+				q->synced_rate = share;
+			q->last_checked_active = now;
+		}
+	}
+	for (i = 0; i < 2; i++)
+		sent[i] = div_u64(sent[i], 50);
+}
+
+/* Bulk (CS1, LE) yields across cake_mq's sub-cakes as in one CAKE: a
+ * sixteenth of the rate next to Best Effort, half next to another Bulk
+ * host, all of it once Best Effort's flows end. A sub-cake with Best
+ * Effort and Bulk isn't held to Bulk's part. Without a Bulk tin
+ * (besteffort, diffserv8) two hosts get half each, as before. The shares
+ * add up to the rate.
+ */
+static void cake_test_mq_bulk_yields(struct kunit *test)
+{
+	static const struct cake_test_tins_case cases[] = {
+		/* diffserv4: a Best Effort host against a Bulk one */
+		{ bulk_order, 4, { { 65535 }, { 0, 65535 } }, 0, { 941, 59 } },
+		/* diffserv3 */
+		{ bulk_order, 3, { { 65535 }, { 0, 65535 } }, 0, { 941, 59 } },
+		/* Bulk against Bulk */
+		{ bulk_order, 4, { { 0, 65535 }, { 0, 65535 } }, 0, { 500, 500 } },
+		/* Best Effort and Bulk against Best Effort */
+		{ bulk_order, 4, { { 65535, 65535 }, { 65535 } }, 0, { 515, 485 } },
+		/* Video against Bulk: Bulk yields to every other tin */
+		{ bulk_order, 4, { { 0, 0, 65535 }, { 0, 65535 } }, 0, { 941, 59 } },
+		/* Best Effort's flows end: Bulk takes the rate */
+		{ bulk_order, 4, { { 65535 }, { 0, 65535 } }, 50, { 0, 1000 } },
+		/* besteffort and diffserv8: half each, as before */
+		{ normal_order, 1, { { 65535 }, { 65535 } }, 0, { 500, 500 } },
+		{ normal_order, 8, { { 65535 }, { 0, 65535 } }, 0, { 500, 500 } },
+	};
+	const u64 rate = CAKE_TEST_RATE;
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	int c, i;
+
+	for (i = 0; i < 2; i++)
+		cake_test_mq_q(mq, i)->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(struct cake_tin_data));
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		u64 sent[2];
+
+		cake_test_mq_tins_run(mq, &cases[c], rate, sent);
+		for (i = 0; i < 2; i++)
+			KUNIT_EXPECT_LE_MSG(test, abs_diff(sent[i], div_u64(rate * cases[c].want[i], 1000)),
+					    rate / 50, "case %d, sub-cake %d: %llu of %llu", c, i, sent[i], rate);
+		KUNIT_EXPECT_LE_MSG(test, sent[0] + sent[1], rate + rate / 100, "case %d", c);
+		KUNIT_EXPECT_GE_MSG(test, sent[0] + sent[1], rate - rate / 50, "case %d", c);
+	}
+}
+
+/* A diffserv4 sub-cake's dequeue notes the tin a packet came from, and a
+ * Bulk packet's sparse flow alone makes it bid a sixteenth of one host's
+ */
+static void cake_test_mq_bulk_seen(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct Qdisc *root = cake_test_mq_root(test, mq, 1, 12500000, CAKE_DIFFSERV_DIFFSERV4);
+	struct cake_sched_data *q = cake_test_mq_q(mq, 0);
+	struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_UDP, 5, 41000, 0);
+	u8 seen;
+	bool ok;
+
+	KUNIT_ASSERT_NOT_NULL(test, root);
+	kunit_remove_action(test, cake_test_free_skb, skb);
+	/* the Bulk tin: diffserv4's first by priority (bulk_order) */
+	skb->priority = TC_H_MAKE(mq->sch[0]->handle, 1);
+	rcu_read_lock_bh();
+	ok = cake_test_enqueue(mq->sch[0], skb) == NET_XMIT_SUCCESS;
+	ok &= cake_test_out(mq->sch[0], skb);
+	seen = q->mq_seen_tins;
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_EQ(test, seen, BIT(1));
+	q->last_checked_active = ktime_get_ns() - 200 * NSEC_PER_USEC;
+	cake_mq_publish(q, ktime_get_ns());
+	KUNIT_EXPECT_EQ(test, q->mq_weight, CAKE_MQ_UNIT >> 4);
+	KUNIT_EXPECT_EQ(test, q->mq_seen_tins, 0);
+}
+
+/* With its failsafe due, the shaper lets the next packet go at once, as
+ * the hard shaper at the top of cake_dequeue() decides. In ingress mode a
+ * drop moves the shaper on but not the failsafe: a burst that overflows
+ * the buffer leaves the shaper far ahead and the failsafe behind. The
+ * watchdog set after each packet left, for the earlier of the two, was then
+ * already past and went off at once, for every packet until the failsafe
+ * caught up. Held back by both, the watchdog is set as before.
+ *
+ * 10 Mbit/s: a 1514-byte packet moves the shaper 1.2 ms, the failsafe
+ * 1.8 ms. Forty packets into a buffer that holds three: 37 dropped, the
+ * shaper ~45 ms ahead; 3 ms later the failsafe is due, even after the next
+ * packet's 1.8 ms. Then both due as a packet goes: the shaper's 1.2 ms is
+ * the margin for the clock read before cake_dequeue() and its own; a VM
+ * stalled longer in between skips rather than fails.
+ */
+static void cake_test_failsafe_due_no_watchdog(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 1250000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	struct hrtimer *timer = &q->watchdog.timer;
+	struct Qdisc *sch = mq->sch[0];
+	u64 dur = (1514 * q->rate_ns) >> q->rate_shft, t[3], set[2], next[2], fs[2];
+	struct sk_buff *skb[40], *out;
+	u32 qlen, drops;
+	bool queued, sent;
+	int i;
+
+	q->config->rate_flags |= CAKE_FLAG_INGRESS;
+	cake_test_pkts(test, skb, 40, 5, 1514);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	rcu_read_lock_bh();
+	for (i = 0; i < 40; i++) {
+		struct sk_buff *to_free = NULL;
+
+		cake_enqueue(skb[i], sch, &to_free);
+		kfree_skb_list(to_free);
+		/* room for the first three */
+		if (i == 2)
+			q->buffer_limit = q->buffer_used;
+	}
+	qlen = sch->q.qlen;
+	drops = sch->qstats.drops;
+	mdelay(3);
+	qdisc_watchdog_cancel(&q->watchdog);
+	hrtimer_set_expires(timer, 0);
+	t[0] = ktime_get_ns();
+	next[0] = ktime_to_ns(q->time_next_packet);
+	fs[0] = ktime_to_ns(q->failsafe_next_packet);
+	out = cake_dequeue(sch);
+	sent = out != NULL;
+	kfree_skb(out);
+	set[0] = hrtimer_get_softexpires_tv64(timer);
+
+	/* both due as the next packet goes, both ahead once it has */
+	qdisc_watchdog_cancel(&q->watchdog);
+	t[1] = ktime_get_ns();
+	q->time_next_packet = ns_to_ktime(t[1]);
+	q->failsafe_next_packet = ns_to_ktime(t[1]);
+	out = cake_dequeue(sch);
+	t[2] = ktime_get_ns();
+	sent &= out != NULL;
+	kfree_skb(out);
+	set[1] = hrtimer_get_softexpires_tv64(timer);
+	next[1] = t[1] + dur;
+	fs[1] = t[1];
+	queued = hrtimer_is_queued(timer);
+	rcu_read_unlock_bh();
+
+	if (t[2] - t[1] >= dur)
+		kunit_skip(test, "the VM stalled %llu us around the dequeue, past the shaper's %llu us",
+			   div_u64(t[2] - t[1], NSEC_PER_USEC), div_u64(dur, NSEC_PER_USEC));
+
+	KUNIT_EXPECT_EQ(test, qlen, 3);
+	KUNIT_EXPECT_EQ(test, drops, 37);
+	/* the drops left the shaper ahead and the failsafe behind */
+	KUNIT_EXPECT_GT(test, next[0], t[0]);
+	KUNIT_EXPECT_LT(test, fs[0] + dur + dur / 2, t[0]);
+	KUNIT_EXPECT_TRUE(test, sent);
+	KUNIT_EXPECT_EQ_MSG(test, set[0], 0, "set %lld ns before the dequeue",
+			    (s64)(t[0] - set[0]));
+	KUNIT_EXPECT_TRUE(test, queued);
+	KUNIT_EXPECT_EQ(test, set[1], next[1]);
+	KUNIT_EXPECT_LT(test, fs[1], set[1]);
+}
+
+/* A flow with no AQM state that runs out of packets rests until its
+ * timeout, not visited meanwhile, and then leaves the flowchain; a packet
+ * for it before then finds its queue and hosts as they were, without
+ * working out its hash again
+ */
+static void cake_test_resting_flow(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 0, CAKE_DIFFSERV_BESTEFFORT);
+	struct cake_tin_data *b = &q->tins[0];
+	struct Qdisc *sch = mq->sch[0];
+	bool ok = true, rests[3], back, gone;
+	struct sk_buff *x[2], *y[4];
+	u16 src, dst, decaying[4];
+	struct cake_flow *fx;
+	u32 directs;
+
+	cake_test_pkts(test, x, 2, 5, 100);
+	cake_test_pkts(test, y, 4, 6, 100);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	rcu_read_lock_bh();
+	ok &= cake_test_in(sch, x[0]);
+	fx = list_first_entry(&b->new_flows, struct cake_flow, flowchain);
+	ok &= cake_test_out(sch, x[0]);
+	/* the next dequeue finds it empty */
+	ok &= cake_test_in(sch, y[0]) && cake_test_out(sch, y[0]);
+	rests[0] = fx->set == CAKE_SET_DECAYING && b->resting_flows.next == &fx->flowchain &&
+		   list_empty(&b->decaying_flows);
+	decaying[0] = b->decaying_flow_count;
+
+	/* a packet before its time is up: the same queue and hosts, found at once */
+	src = fx->srchost;
+	dst = fx->dsthost;
+	directs = b->way_directs;
+	ok &= cake_test_in(sch, x[1]);
+	back = fx->set == CAKE_SET_SPARSE && b->new_flows.prev == &fx->flowchain &&
+	       fx->srchost == src && fx->dsthost == dst && b->way_directs == directs + 1 &&
+	       list_empty(&b->resting_flows);
+	decaying[1] = b->decaying_flow_count;
+	ok &= cake_test_out(sch, x[1]);
+	ok &= cake_test_in(sch, y[1]) && cake_test_out(sch, y[1]);
+	rests[1] = b->resting_flows.next == &fx->flowchain;
+
+	/* not before its time */
+	fx->cvars.drop_next = ktime_add_ms(ktime_get(), 1000);
+	ok &= cake_test_in(sch, y[2]) && cake_test_out(sch, y[2]);
+	rests[2] = b->resting_flows.next == &fx->flowchain;
+	decaying[2] = b->decaying_flow_count;
+
+	/* then out */
+	fx->cvars.drop_next = ktime_sub_ns(ktime_get(), 1);
+	ok &= cake_test_in(sch, y[3]) && cake_test_out(sch, y[3]);
+	gone = fx->set == CAKE_SET_NONE && list_empty(&fx->flowchain) &&
+	       list_empty(&b->resting_flows);
+	decaying[3] = b->decaying_flow_count;
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_TRUE(test, rests[0]);
+	KUNIT_EXPECT_EQ(test, decaying[0], 1);
+	KUNIT_EXPECT_TRUE(test, back);
+	KUNIT_EXPECT_EQ(test, decaying[1], 0);
+	KUNIT_EXPECT_TRUE(test, rests[1]);
+	KUNIT_EXPECT_TRUE(test, rests[2]);
+	KUNIT_EXPECT_EQ(test, decaying[2], 1);
+	KUNIT_EXPECT_TRUE(test, gone);
+	KUNIT_EXPECT_EQ(test, decaying[3], 0);
+}
+
+/* A flow that runs out of packets with AQM state left decays a step at
+ * each dequeue, as before, and goes nowhere near the bulk rotation, even
+ * out of deficit
+ */
+static void cake_test_decaying_steps(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 0, CAKE_DIFFSERV_BESTEFFORT);
+	struct cake_tin_data *b = &q->tins[0];
+	struct Qdisc *sch = mq->sch[0];
+	struct sk_buff *z, *y[3];
+	bool ok = true, decaying[2], wheel = false;
+	struct cake_flow *fz;
+	u32 count[3];
+	int i;
+
+	cake_test_pkts(test, &z, 1, 7, 100);
+	cake_test_pkts(test, y, 3, 6, 100);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	rcu_read_lock_bh();
+	ok &= cake_test_in(sch, z);
+	fz = list_first_entry(&b->new_flows, struct cake_flow, flowchain);
+	ok &= cake_test_out(sch, z);
+	/* a count of 3, its steps long overdue */
+	cobalt_set_count(&fz->cvars, 3);
+	fz->cvars.drop_next = ktime_sub_ms(ktime_get(), 10000);
+	for (i = 0; i < 3; i++)
+		ok &= cake_test_in(sch, y[i]);
+	for (i = 0; i < 3; i++) {
+		ok &= cake_test_out(sch, y[i]);
+		count[i] = fz->cvars.count;
+		if (i < 2)
+			decaying[i] = fz->set == CAKE_SET_DECAYING &&
+				      b->decaying_flows.next == &fz->flowchain;
+		/* out of deficit while it decays */
+		fz->deficit = -5000 << CAKE_DEFICIT_SHIFT;
+		wheel |= cake_bulk_any(b);
+	}
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_EQ(test, count[0], 2);
+	KUNIT_EXPECT_EQ(test, count[1], 1);
+	KUNIT_EXPECT_EQ(test, count[2], 0);
+	KUNIT_EXPECT_TRUE(test, decaying[0]);
+	KUNIT_EXPECT_TRUE(test, decaying[1]);
+	KUNIT_EXPECT_FALSE(test, wheel);
+	KUNIT_EXPECT_EQ(test, (int)fz->set, CAKE_SET_NONE);
+	KUNIT_EXPECT_EQ(test, b->decaying_flow_count, 0);
+}
