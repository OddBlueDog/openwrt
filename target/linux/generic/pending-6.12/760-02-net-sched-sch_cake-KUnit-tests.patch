+/* cobalt_decay_jump() never wraps its target count near U32_MAX */
+static void cake_test_decay_jump_near_u32_max(struct kunit *test)
+{
+	struct cobalt_vars v;
+
+	cobalt_vars_init(&v);
+	cobalt_set_count(&v, U32_MAX);
+	v.drop_next = 0;
+	cobalt_decay_jump(&v, 100 * NSEC_PER_MSEC, 1);
+	KUNIT_EXPECT_LE(test, v.count, U32_MAX);
+	KUNIT_EXPECT_GE(test, v.count, U32_MAX - 64);
+
+	cobalt_vars_init(&v);
+	cobalt_set_count(&v, U32_MAX);
+	v.drop_next = 0;
+	cobalt_decay_jump(&v, 100 * NSEC_PER_MSEC, 2500);
+	KUNIT_EXPECT_LE(test, v.count, U32_MAX);
+	KUNIT_EXPECT_GE(test, v.count, U32_MAX - 64);
+
+	cobalt_vars_init(&v);
+	cobalt_set_count(&v, U32_MAX - 1);
+	v.drop_next = 0;
+	cobalt_decay_jump(&v, 100 * NSEC_PER_MSEC, 5000);
+	KUNIT_EXPECT_LE(test, v.count, U32_MAX - 1);
+	KUNIT_EXPECT_GE(test, v.count, U32_MAX - 128);
+}
+
+/* The jump over the whole of its domain: counts from 15 million (where
+ * Newton's method used to stop short) to U32_MAX, intervals from 1 ms to
+ * 4 s, pauses from a sixty-fourth of the whole decay to more than all of
+ * it. However large the count, the steps left after the jump number at most
+ * 70; the old jump left millions, or a few hundred. And a pause of
+ * interval * (2 * sqrt(count) + 3) from 30 million, which the old jump took
+ * as long enough to go all the way to 0, leaves a count the steps alone
+ * don't take below.
+ */
+static void cake_test_decay_jump_huge(struct kunit *test)
+{
+	static const u32 counts[] = { 15000000, 16000000, 20000000, 30000000, 100000000,
+				      1000000000, U32_MAX - 1, U32_MAX };
+	static const u32 intervals[] = { NSEC_PER_MSEC, 100 * NSEC_PER_MSEC, 4000000000U };
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_TCP, 2, 40000, 0);
+	struct cobalt_params p = {
+		.interval = 100 * NSEC_PER_MSEC,
+		.target = 5 * NSEC_PER_MSEC,
+		.mtu_time = 12 * NSEC_PER_USEC,
+	};
+	struct cobalt_vars v = {}, ref;
+	u32 bad = 0, most = 0, c, i, f;
+	u64 r, gap;
+
+	for (c = 0; c < ARRAY_SIZE(counts); c++) {
+		for (i = 0; i < ARRAY_SIZE(intervals); i++) {
+			r = int_sqrt64((u64)counts[c] << 32);
+			for (f = 1; f <= 72; f++) {
+				u32 steps = 0;
+
+				gap = div_u64(mul_u64_u64_div_u64(intervals[i], 2 * r + (3 << 16),
+								  1 << 16) * f, 64);
+				memset(&v, 0, sizeof(v));
+				cobalt_set_count(&v, counts[c]);
+				cobalt_decay_jump(&v, intervals[i], gap);
+				/* the steps from there, as cobalt_should_drop() takes
+				 * them, or enough to tell
+				 */
+				while (v.count && (s64)(gap - ktime_to_ns(v.drop_next)) >= 0 &&
+				       steps <= 1000) {
+					v.count--;
+					cobalt_invsqrt(&v);
+					v.drop_next = cobalt_control(v.drop_next, intervals[i],
+								     v.rec_inv_sqrt);
+					steps++;
+				}
+				most = max(most, steps);
+				if (steps > 70) {
+					if (bad++ < 8)
+						kunit_info(test, "count %u, interval %u, %u/64 of the decay: %s%u steps",
+							   counts[c], intervals[i], f,
+							   steps > 1000 ? "over " : "", steps);
+				}
+			}
+		}
+	}
+	kunit_info(test, "at most %u steps after the jump", most);
+	KUNIT_EXPECT_EQ(test, bad, 0);
+
+	/* the old shortcut's pause, through cobalt_should_drop() */
+	memset(&v, 0, sizeof(v));
+	cobalt_set_count(&v, 30000000);
+	ref = v;
+	r = int_sqrt64(30000000ULL << 32);
+	gap = mul_u64_u64_div_u64(p.interval, 2 * r + (3 << 16), 1 << 16);
+	cake_test_decay_ref(&ref, p.interval, ns_to_ktime(gap));
+	cobalt_set_enqueue_time(skb, ns_to_ktime(gap));
+	cobalt_should_drop(&v, &p, ns_to_ktime(gap), skb, 0, 0);
+	KUNIT_EXPECT_GT(test, ref.count, 0);
+	KUNIT_EXPECT_GE(test, v.count, ref.count);
+	KUNIT_EXPECT_LE(test, v.count, ref.count + 2);
+}
