+/* An empty CAKE_SET_SPARSE_WAIT flow parked in the bulk wheel does not add
+ * bulk weight to its sub-cake; it receives weight once promoted to bulk.
+ */
+static void cake_test_mq_sparse_wait_no_weight(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct Qdisc *root = cake_test_mq_root(test, mq, 2, 12500000,
+					       CAKE_DIFFSERV_BESTEFFORT);
+	struct Qdisc *sch = mq->sch[0];
+	struct cake_sched_data *q = cake_test_mq_q(mq, 0);
+	struct cake_tin_data *b = &q->tins[0];
+	struct sk_buff *bulk[3], *sp[2], *out;
+	struct cake_flow *sflow = NULL;
+	u32 w_bulk, w_with_wait, w_promoted, w_empty;
+	u8 sp_set = 0;
+	bool ok = true;
+	int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, root);
+	mq->cfg->flow_mode = CAKE_FLOW_FLOWS;
+	for (i = 0; i < 3; i++) {
+		bulk[i] = cake_test_skb(test, false, IPPROTO_TCP, 10, 44000, 0);
+		kunit_remove_action(test, cake_test_free_skb, bulk[i]);
+		qdisc_skb_cb(bulk[i])->pkt_len = 1514;
+	}
+	for (i = 0; i < 2; i++) {
+		sp[i] = cake_test_skb(test, false, IPPROTO_UDP, 11, 45000, 0);
+		kunit_remove_action(test, cake_test_free_skb, sp[i]);
+		qdisc_skb_cb(sp[i])->pkt_len = 4000;
+	}
+
+	rcu_read_lock_bh();
+	for (i = 0; i < 3; i++)
+		ok &= cake_test_in(sch, bulk[i]);
+	for (i = 0; i < 2; i++) {
+		q->time_next_packet = ktime_sub_ns(ktime_get(), NSEC_PER_MSEC);
+		out = cake_dequeue(sch);
+		ok &= out != NULL;
+		if (out)
+			kfree_skb(out);
+	}
+	w_bulk = b->mq_weight;
+
+	ok &= cake_test_in(sch, sp[0]);
+	sflow = cake_test_flow_of(b, sp[0]);
+	q->time_next_packet = ktime_sub_ns(ktime_get(), NSEC_PER_MSEC);
+	out = cake_dequeue(sch);
+	ok &= out == sp[0];
+	if (out)
+		kfree_skb(out);
+	q->time_next_packet = ktime_sub_ns(ktime_get(), NSEC_PER_MSEC);
+	out = cake_dequeue(sch);
+	ok &= out != NULL;
+	if (out)
+		kfree_skb(out);
+	sp_set = sflow ? sflow->set : 0;
+	w_with_wait = b->mq_weight;
+
+	ok &= cake_test_in(sch, sp[1]);
+	w_promoted = b->mq_weight;
+	cake_reset(sch);
+	w_empty = b->mq_weight;
+	rcu_read_unlock_bh();
+
+	KUNIT_ASSERT_TRUE(test, ok);
+	KUNIT_EXPECT_EQ(test, sp_set, CAKE_SET_SPARSE_WAIT);
+	KUNIT_EXPECT_EQ(test, w_bulk, CAKE_MQ_UNIT);
+	KUNIT_EXPECT_EQ(test, w_with_wait, w_bulk);
+	KUNIT_EXPECT_EQ(test, w_promoted, 2 * CAKE_MQ_UNIT);
+	KUNIT_EXPECT_EQ(test, w_empty, 0U);
+}
