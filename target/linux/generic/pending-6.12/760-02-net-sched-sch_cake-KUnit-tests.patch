+/* A download from the internet, through ifb from wan's ingress: its entry's
+ * reply direction, LAN host @host's connection, the host having sent with
+ * @sent; with no entry (none in conntrack) if @sent is negative
+ */
+static struct sk_buff *cake_test_download_host(struct kunit *test, u8 host, int sent)
+{
+	struct sk_buff *skb = cake_test_nat_skb(test, host, 61000 + host, sent >= 0, 0);
+	enum ip_conntrack_info ctinfo;
+	struct nf_conn *ct = nf_ct_get(skb, &ctinfo);
+
+	if (ct) {
+		ct->dscp[IP_CT_DIR_ORIGINAL] = sent;
+		nf_ct_set(skb, ct, IP_CT_ESTABLISHED_REPLY);
+	}
+	skb->redirected = 1;
+	skb->from_ingress = 1;
+	return skb;
+}
+
+static struct sk_buff *cake_test_download(struct kunit *test, u8 sent)
+{
+	return cake_test_download_host(test, 2, sent);
+}
