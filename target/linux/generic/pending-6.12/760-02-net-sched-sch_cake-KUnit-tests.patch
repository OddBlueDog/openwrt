+/* Live flow_mode change on cake_mq must neither leak nor underflow mq_hosts
+ * when flows promoted under the old flow_mode later empty.
+ */
+static void cake_test_mq_live_flow_mode_hosts(struct kunit *test)
+{
+	struct cake_test_hosts *h = cake_test_hosts_alloc(test);
+	struct cake_tin_data *b0 = &h->q[0]->tins[0];
+	struct cake_flow *f1, *f2;
+	ktime_t now = ktime_get();
+	int i;
+
+	f1 = cake_test_hosts_bulk(test, h, 0, 10, 40001);
+	/* Switch triple-isolate -> flows while f1 is bulk, then empty f1 */
+	h->cfg.flow_mode = CAKE_FLOW_FLOWS;
+	cake_flow_emptied(h->q[0], b0, f1, now);
+	for (i = 0; i < CAKE_QUEUES; i++) {
+		KUNIT_EXPECT_EQ(test, atomic_read(&b0->mq_srcload[i]), 0);
+		KUNIT_EXPECT_EQ(test, atomic_read(&b0->mq_dstload[i]), 0);
