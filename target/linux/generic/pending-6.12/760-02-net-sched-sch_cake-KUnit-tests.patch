+/* Verify every cross-tin, cross-flow, overflow-heap, and shared mq_hosts
+ * invariant across all @n_sub sub-cakes: what's queued against every count
+ * of it (packets, bytes, memory, flows by set, bulk weight), the overflow
+ * heap's order, the wheel's mask over its slots with flows, and the host
+ * tables. Returns 0 when everything holds.
+ */
+static u32 cake_test_verify_invariants(struct cake_test_mq *mq, int n_sub,
+				       int (*host_sums)[CAKE_QUEUES])
+{
+	u32 errs = 0;
+	int s, t, k;
+
+	for (s = 0; s < n_sub; s++) {
+		struct Qdisc *sch = mq->sch[s];
+		struct cake_sched_data *q = cake_test_mq_q(mq, s);
+		u32 total_pkts = 0, total_backlog = 0, truesize = 0;
+
+		for (t = 0; t < CAKE_MAX_TINS; t++) {
+			struct cake_tin_data *b = &q->tins[t];
+			u32 tin_backlog = 0, weight_sum = 0;
+			u16 bulk_cnt = 0, sparse_cnt = 0, decaying_cnt = 0;
+
+			for (k = 0; k < CAKE_QUEUES; k++) {
+				struct cake_flow *f = &b->flows[k];
+				struct sk_buff *skb;
+				u32 flow_backlog = 0;
+				u32 pure_acks = 0;
+
+				for (skb = f->head; skb; skb = skb->next) {
+					total_pkts++;
+					truesize += skb->truesize;
+					flow_backlog += qdisc_pkt_len(skb);
+					if (get_cobalt_cb(skb)->pure_ack)
+						pure_acks++;
+				}
+				if (flow_backlog != b->backlogs[k])
+					errs++;
+				if (f->head && !f->set)
+					errs++;
+				if (!f->head && f->pure_acks)
+					errs++;
+				if (f->pure_acks < U8_MAX && pure_acks != f->pure_acks)
+					errs++;
+				if (f->set == CAKE_SET_BULK)
+					bulk_cnt++;
+				else if (f->set == CAKE_SET_SPARSE ||
+					 f->set == CAKE_SET_SPARSE_WAIT)
+					sparse_cnt++;
+				else if (f->set == CAKE_SET_DECAYING)
+					decaying_cnt++;
+				tin_backlog += flow_backlog;
+				if (f->set != CAKE_SET_BULK && f->mq_weight)
+					errs++;
+				weight_sum += f->mq_weight;
+			}
+			if (decaying_cnt != b->decaying_flow_count)
+				errs++;
+			/* a slot with flows has its bit: the mask may have more */
+			for (k = 0; k < CAKE_WHEEL_SLOTS; k++)
+				if (!list_empty(&b->old_wheel[k]) && !(b->wheel_mask & BIT(k)))
+					errs++;
+			if (tin_backlog != b->tin_backlog)
+				errs++;
+			if (bulk_cnt != b->bulk_flow_count)
+				errs++;
+			if (sparse_cnt != b->sparse_flow_count)
+				errs++;
+			if (weight_sum != b->mq_weight)
+				errs++;
+			total_backlog += tin_backlog;
+		}
+		if (total_pkts != sch->q.qlen)
+			errs++;
+		if (total_backlog != sch->qstats.backlog)
+			errs++;
+		if (truesize != q->buffer_used)
+			errs++;
+		if (q->overflow_timeout && !cake_test_heap_whole(q))
+			errs++;
+	}
+
+	for (t = 0; t < CAKE_MAX_TINS; t++) {
+		memset(host_sums, 0, 2 * sizeof(*host_sums));
+		for (s = 0; s < n_sub; s++) {
+			struct cake_tin_data *b = &cake_test_mq_q(mq, s)->tins[t];
+
+			for (k = 0; k < CAKE_QUEUES; k++) {
+				struct cake_flow *f = &b->flows[k];
+
+				if (f->mq_host_cnt & CAKE_MQ_CNT_SRC)
+					host_sums[0][b->hosts[f->srchost].srchost_tag % CAKE_QUEUES]++;
+				else if (f->mq_host_cnt & CAKE_MQ_CNT_HOST)
+					host_sums[0][b->tags[k] % CAKE_QUEUES]++;
+				if (f->mq_host_cnt & CAKE_MQ_CNT_DST)
+					host_sums[1][b->hosts[f->dsthost].dsthost_tag % CAKE_QUEUES]++;
+			}
+		}
+		for (k = 0; k < CAKE_QUEUES; k++) {
+			int src = atomic_read(&mq->cfg->mq_hosts[2 * t * CAKE_QUEUES + k]);
+			int dst = atomic_read(&mq->cfg->mq_hosts[(2 * t + 1) * CAKE_QUEUES + k]);
+
+			if (src < 0 || dst < 0 ||
+			    src != host_sums[0][k] || dst != host_sums[1][k])
+				errs++;
+		}
+	}
+	return errs;
+}
+
+/* Seeded property-based fuzzer: exercises randomized IPv4/IPv6 TCP/UDP traffic,
+ * pure ACKs with one to three SACK blocks for the ACK filter (a later ACK
+ * can be shorter than the one it drops), DSCP/ECN combinations, tight
+ * buffer limits (overflow heap), live cake_mq_change() mode flips at
+ * shaped and unlimited rates, and cake_reset(), asserting universal
+ * accounting and shared mq_hosts invariants every 64 steps and after each
+ * change.
+ */
+static void cake_test_property_fuzz_invariants(struct kunit *test)
+{
+	static const u32 diffserv_modes[] = {
+		CAKE_DIFFSERV_BESTEFFORT, CAKE_DIFFSERV_DIFFSERV3,
+		CAKE_DIFFSERV_DIFFSERV4, CAKE_DIFFSERV_DIFFSERV8,
+	};
+	static const u32 flow_modes[] = {
+		CAKE_FLOW_TRIPLE, CAKE_FLOW_FLOWS, CAKE_FLOW_SRC_IP,
+		CAKE_FLOW_DST_IP, CAKE_FLOW_DUAL_SRC, CAKE_FLOW_DUAL_DST,
+	};
+	static const u32 ack_modes[] = {
+		CAKE_ACK_NONE, CAKE_ACK_FILTER, CAKE_ACK_AGGRESSIVE,
+	};
+	static const u64 rates[] = { 0, 1250000, 12500000, 125000000 };
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct Qdisc *root = cake_test_mq_root(test, mq, 4, 12500000,
+					       CAKE_DIFFSERV_DIFFSERV4);
+	int (*host_sums)[CAKE_QUEUES];
+	struct rnd_state rnd;
+	u32 errs = 0, enq = 0, deq = 0, changes = 0, drops = 0;
+	int step, s, t, k;
+
+	host_sums = cake_test_alloc(test, 2 * sizeof(*host_sums));
+	prandom_seed_state(&rnd, 0xca4ef00dULL);
+
+	for (step = 0; step < 1600; step++) {
+		u32 r = prandom_u32_state(&rnd) % 100;
+
+		if (step % 64 == 63)
+			errs += cake_test_verify_invariants(mq, 4, host_sums);
+
+		if (r < 54) {
+			bool v6 = prandom_u32_state(&rnd) & 1;
+			u8 proto = (prandom_u32_state(&rnd) % 3) ? IPPROTO_TCP : IPPROTO_UDP;
+			u8 host = 1 + prandom_u32_state(&rnd) % 24;
+			u16 sport = 40000 + prandom_u32_state(&rnd) % 32;
+			u32 l4h = (prandom_u32_state(&rnd) & 1) ?
+				  (prandom_u32_state(&rnd) | 1) : 0;
+			u8 dsfield = ((prandom_u32_state(&rnd) % 64) << 2) |
+				     (prandom_u32_state(&rnd) & INET_ECN_MASK);
+			u32 pktlen = 64 + prandom_u32_state(&rnd) % 1440;
+			struct sk_buff *skb, *to_free = NULL;
+			struct cake_sched_data *q;
+
+			s = prandom_u32_state(&rnd) % 4;
+			q = cake_test_mq_q(mq, s);
+			if (proto == IPPROTO_TCP && (prandom_u32_state(&rnd) % 5) == 0) {
+				/* a pure ACK of one of two connections, with one
+				 * to three SACK blocks: a later one with fewer
+				 * covers those with more, and is shorter
+				 */
+				struct cake_test_tcp a = {
+					.flags = TCP_FLAG_ACK, .ack = 1000 + step / 8,
+					.tsval = 1 + step, .v6 = v6,
+					.other = prandom_u32_state(&rnd) & 1,
+				};
+				u32 n = 1 + prandom_u32_state(&rnd) % 3, b;
+
+				for (b = 0; b < n; b++) {
+					a.sacks[b][0] = 2000 + 3000 * b;
+					a.sacks[b][1] = n == 1 ? 9000 :
+							a.sacks[b][0] + 1000;
+				}
+				skb = cake_test_tcp_skb(test, &a);
+				pktlen = skb->len;
+				/* each connection on a sub-cake of its own */
+				s = a.other;
+				q = cake_test_mq_q(mq, s);
+			} else {
+				skb = cake_test_skb(test, v6, proto, host, sport, l4h);
+				kunit_remove_action(test, cake_test_free_skb, skb);
+				if (proto == IPPROTO_TCP && (prandom_u32_state(&rnd) % 4) == 0) {
+					tcp_hdr(skb)->ack = 1;
+					tcp_hdr(skb)->ack_seq = htonl(1000 + step * 10);
+				}
+			}
+			cake_test_set_dsfield(skb, dsfield);
+			qdisc_skb_cb(skb)->pkt_len = pktlen;
+
+			rcu_read_lock_bh();
+			if ((step % 23) == 0 && q->buffer_used > 2048)
+				q->buffer_limit = q->buffer_used;
+			else
+				q->buffer_limit = 256 * 1024;
+			cake_enqueue(skb, mq->sch[s], &to_free);
+			kfree_skb_list(to_free);
+			enq++;
+			rcu_read_unlock_bh();
+		} else if (r < 92) {
+			struct cake_sched_data *q;
+			struct sk_buff *out;
+
+			s = prandom_u32_state(&rnd) % 4;
+			q = cake_test_mq_q(mq, s);
+			rcu_read_lock_bh();
+			if ((prandom_u32_state(&rnd) % 3) != 0)
+				q->time_next_packet = ktime_sub_ns(ktime_get(), NSEC_PER_MSEC);
+			out = cake_dequeue(mq->sch[s]);
+			if (out) {
+				kfree_skb(out);
+				deq++;
+			}
+			rcu_read_unlock_bh();
+		} else if (r < 96) {
+			u32 dm = diffserv_modes[prandom_u32_state(&rnd) % ARRAY_SIZE(diffserv_modes)];
+			u32 fm = flow_modes[prandom_u32_state(&rnd) % ARRAY_SIZE(flow_modes)];
+			u32 am = ack_modes[prandom_u32_state(&rnd) % ARRAY_SIZE(ack_modes)];
+			u64 rt = rates[prandom_u32_state(&rnd) % ARRAY_SIZE(rates)];
+			struct nlattr *opts = cake_test_fuzz_opts(test, rt, dm, fm,
+								  prandom_u32_state(&rnd) & 1,
+								  prandom_u32_state(&rnd) & 1,
+								  am);
+
+			rtnl_lock();
+			KUNIT_EXPECT_EQ(test, 0, cake_mq_change(root, opts, NULL));
+			rtnl_unlock();
+			changes++;
+			errs += cake_test_verify_invariants(mq, 4, host_sums);
+		} else if (r < 98) {
+			struct sk_buff *to_free = NULL;
+
+			s = prandom_u32_state(&rnd) % 4;
+			rcu_read_lock_bh();
+			if (mq->sch[s]->q.qlen) {
+				cake_drop(mq->sch[s], &to_free, ktime_get());
+				kfree_skb_list(to_free);
+				drops++;
+			}
+			rcu_read_unlock_bh();
+		} else {
+			s = prandom_u32_state(&rnd) % 4;
+			rcu_read_lock_bh();
+			cake_reset(mq->sch[s]);
+			rcu_read_unlock_bh();
+			errs += cake_test_verify_invariants(mq, 4, host_sums);
+		}
+
+		if ((step & 15) == 15)
+			errs += cake_test_verify_invariants(mq, 4, host_sums);
+	}
+
+	/* Reset every sub-queue and retire drained sparse flows; verify complete zeroing */
+	for (s = 0; s < 4; s++) {
+		struct Qdisc *sch = mq->sch[s];
+		struct cake_sched_data *q = cake_test_mq_q(mq, s);
+
+		rcu_read_lock_bh();
+		cake_reset(sch);
+		cake_mq_drained(q, ktime_get());
+		rcu_read_unlock_bh();
+		KUNIT_EXPECT_EQ(test, sch->q.qlen, 0U);
+		KUNIT_EXPECT_EQ(test, sch->qstats.backlog, 0U);
+		KUNIT_EXPECT_EQ(test, q->buffer_used, 0U);
+		for (t = 0; t < CAKE_MAX_TINS; t++) {
+			struct cake_tin_data *b = &q->tins[t];
+
+			KUNIT_EXPECT_EQ(test, b->tin_backlog, 0U);
+			KUNIT_EXPECT_EQ(test, b->bulk_flow_count, 0);
+			KUNIT_EXPECT_EQ(test, b->mq_weight, 0U);
+			KUNIT_EXPECT_EQ(test, b->wheel_mask, 0U);
+			if (t < q->tin_cnt) {
+				KUNIT_EXPECT_EQ(test, b->sparse_flow_count, 0);
+				KUNIT_EXPECT_TRUE(test, list_empty(&b->new_flows));
+			}
+		}
+	}
+	errs += cake_test_verify_invariants(mq, 4, host_sums);
+	for (t = 0; t < CAKE_MAX_TINS; t++) {
+		for (k = 0; k < CAKE_QUEUES; k++) {
+			KUNIT_EXPECT_EQ(test, atomic_read(&mq->cfg->mq_hosts[2 * t * CAKE_QUEUES + k]), 0);
+			KUNIT_EXPECT_EQ(test, atomic_read(&mq->cfg->mq_hosts[(2 * t + 1) * CAKE_QUEUES + k]), 0);
+		}
+	}
+	for (s = 0, k = 0; s < 4; s++)
+		for (t = 0; t < CAKE_MAX_TINS; t++)
+			k += cake_test_mq_q(mq, s)->tins[t].ack_drops;
+	KUNIT_EXPECT_EQ(test, errs, 0U);
+	KUNIT_EXPECT_GT(test, enq, 500U);
+	KUNIT_EXPECT_GT(test, deq, 100U);
+	KUNIT_EXPECT_GT(test, changes, 20U);
+	KUNIT_EXPECT_GT(test, drops, 0U);
+	/* the SACK ACKs went through the filter, some dropped */
+	KUNIT_EXPECT_GT(test, k, 0);
+	kunit_info(test, "%u in, %u out, %u changes, %u drops, %d ACKs filtered",
+		   enq, deq, changes, drops, k);
+}
