+/* autorate-ingress keeps no account of the traffic while it's off, and
+ * starts its estimate afresh when it's turned on
+ */
+static void cake_test_autorate_starts_afresh(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 12500000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	struct Qdisc *sch = mq->sch[0];
+	struct sk_buff *skb[3];
+	ktime_t before;
+	u64 window[2];
+	bool ok = true;
+	struct nlattr *on;
+	struct sk_buff *msg = nlmsg_new(NLMSG_DEFAULT_SIZE, GFP_KERNEL);
+	int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_free_skb, msg));
+	on = nla_nest_start_noflag(msg, TCA_OPTIONS);
+	KUNIT_ASSERT_NOT_NULL(test, on);
+	KUNIT_ASSERT_EQ(test, 0, nla_put_u32(msg, TCA_CAKE_AUTORATE, 1));
+	nla_nest_end(msg, on);
+	cake_test_pkts(test, skb, 3, 5, 1000);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	q->avg_window_bytes = 777;
+	q->last_packet_time = 0;
+	rcu_read_lock_bh();
+	for (i = 0; i < 2; i++)
+		ok &= cake_test_in(sch, skb[i]);
+	rcu_read_unlock_bh();
+	window[0] = q->avg_window_bytes;
+	KUNIT_EXPECT_EQ(test, q->last_packet_time, 0);
+
+	before = ktime_get();
+	rtnl_lock();
+	KUNIT_EXPECT_EQ(test, 0, cake_change(sch, on, NULL));
+	rtnl_unlock();
+	KUNIT_EXPECT_EQ(test, q->avg_window_bytes, 0);
+	KUNIT_EXPECT_GE(test, q->avg_window_begin, before);
+	KUNIT_EXPECT_EQ(test, q->last_packet_time, q->avg_window_begin);
+	rcu_read_lock_bh();
+	ok &= cake_test_in(sch, skb[2]);
+	window[1] = q->avg_window_bytes;
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	/* untouched while off; counted once on */
+	KUNIT_EXPECT_EQ(test, window[0], 777);
+	KUNIT_EXPECT_TRUE(test, window[1] == 1000 || window[1] == 0);
+	KUNIT_EXPECT_GE(test, q->last_packet_time, before);
+}
+
+/* The overflow heap holds each queue of the tins in use once, its index
+ * right, none longer than its parent
+ */
+static bool cake_test_heap_whole(struct cake_sched_data *q)
+{
+	u32 n = q->overflow_heap_len, k;
+
+	if (n != q->tin_cnt * CAKE_QUEUES)
+		return false;
+	for (k = 0; k < n; k++) {
+		struct cake_heap_entry e = q->overflow_heap[k];
+
+		if (e.t >= q->tin_cnt || q->tins[e.t].overflow_idx[e.b] != k)
+			return false;
+		if (k && cake_heap_get_backlog(q, k) > cake_heap_get_backlog(q, (k - 1) / 2))
+			return false;
+	}
+	return true;
+}
+
+/* The longest queue of the tins in use */
+static u32 cake_test_longest(struct cake_sched_data *q)
+{
+	u32 most = 0;
+	int t, j;
+
+	for (t = 0; t < q->tin_cnt; t++)
+		for (j = 0; j < CAKE_QUEUES; j++)
+			most = max(most, q->tins[t].backlogs[j]);
+	return most;
+}
+
+/* Each drop at the memory limit takes from a longest queue: with packets in
+ * and out of 1, 3, 4 and 8 tins at random and drops between them, all in
+ * one spell, so the heap the first drop builds is kept up to date from
+ * then on. A queue shortened at the top of the heap has to sift down past
+ * every queue that's now longer, not just its children.
+ *
+ * The heap holds only the tins in use, and stays whole while the spell
+ * lasts; a change to another tin count in the middle of a spell has the
+ * next drop build it again, over the new tins.
+ */
+static void cake_test_overflow_heap(struct kunit *test)
+{
+	static const u8 modes[] = { CAKE_DIFFSERV_BESTEFFORT, CAKE_DIFFSERV_DIFFSERV3,
+				    CAKE_DIFFSERV_DIFFSERV4, CAKE_DIFFSERV_DIFFSERV8,
+				    CAKE_DIFFSERV_BESTEFFORT };
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 0, modes[0]);
+	struct Qdisc *sch = mq->sch[0];
+	const int n = 2500;
+	struct sk_buff **skb = cake_test_alloc(test, n * sizeof(*skb));
+	u32 victims = 0, wrong = 0, broken = 0, built[ARRAY_SIZE(modes)] = {};
+	bool reset[ARRAY_SIZE(modes)] = {};
+	struct rnd_state rnd;
+	int i, m, next = 0;
+
+	prandom_seed_state(&rnd, 7632);
+	for (i = 0; i < n; i++) {
+		skb[i] = cake_test_skb(test, false, IPPROTO_UDP, 2 + prandom_u32_state(&rnd) % 30,
+				       40000 + prandom_u32_state(&rnd) % 16, 0);
+		qdisc_skb_cb(skb[i])->pkt_len = 64 + prandom_u32_state(&rnd) % 1450;
+		/* a tin each, of those there are */
+		skb[i]->priority = 1 + prandom_u32_state(&rnd) % 8;
+	}
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	for (m = 0; m < ARRAY_SIZE(modes); m++) {
+		int op;
+
+		if (m) {
+			u16 tins = q->tin_cnt;
+
+			/* in the middle of a spell */
+			KUNIT_EXPECT_NE(test, q->overflow_timeout, 0);
+			rtnl_lock();
+			KUNIT_EXPECT_EQ(test, 0, cake_change(sch, cake_test_opts(test, 0, modes[m],
+										   false), NULL));
+			rtnl_unlock();
+			reset[m] = !q->overflow_timeout && q->tin_cnt != tins;
+		}
+		/* short: the suite runs each time the module loads */
+		for (op = 0; op < 120 && next < n; op++) {
+			u32 r = prandom_u32_state(&rnd) % 10, id, most, len;
+			struct sk_buff *to_free = NULL;
+
+			rcu_read_lock_bh();
+			if (r < 7 || !sch->q.qlen) {
+				/* CAKE has it now */
+				kunit_remove_action(test, cake_test_free_skb, skb[next]);
+				cake_test_in(sch, skb[next++]);
+			} else if (r < 9) {
+				kfree_skb(cake_dequeue(sch));
+			} else {
+				most = cake_test_longest(q);
+				id = cake_drop(sch, &to_free, ktime_get());
+				len = to_free ? qdisc_pkt_len(to_free) : 0;
+				kfree_skb_list(to_free);
+				victims++;
+				wrong += q->tins[id >> 16].backlogs[id & 0xffff] + len != most;
+				built[m] += q->overflow_heap_len == q->tin_cnt * CAKE_QUEUES;
+			}
+			if (q->overflow_timeout && ((r >= 9 && victims % 4 == 0) || op % 60 == 0))
+				broken += !cake_test_heap_whole(q);
+			rcu_read_unlock_bh();
+		}
+	}
+	KUNIT_EXPECT_EQ(test, wrong, 0);
+	KUNIT_EXPECT_EQ(test, broken, 0);
+	KUNIT_EXPECT_GT(test, victims, 25);
+	for (m = 0; m < ARRAY_SIZE(modes); m++)
+		KUNIT_EXPECT_GT_MSG(test, built[m], 0, "mode %d", m);
+	/* 1 to 3 to 4 to 8 tins and back to 1: built again each time */
+	for (m = 1; m < ARRAY_SIZE(modes); m++)
+		KUNIT_EXPECT_TRUE_MSG(test, reset[m], "mode %d", m);
+}
+
+/* The ACK the filter drops can be longer than the one it keeps: a receiver
+ * whose missing segment arrives coalesces its two SACK blocks into one, and
+ * that ACK covers the two queued with both blocks (86 bytes each, the new
+ * one 78). Through cake_enqueue(), with autorate-ingress and a spell of
+ * overflow drops on: the capacity estimate counts each packet that came in
+ * once, whether the window had bytes in it or had just started afresh (it
+ * took 4 GiB for the shorter ACK, or wrapped below 0), and the queue,
+ * shorter now, sifts down the overflow heap past the next longest one.
+ */
+static void cake_test_ack_filter_shorter_ack(struct kunit *test)
+{
+	struct cake_test_tcp two = { .flags = TCP_FLAG_ACK, .ack = 1000, .tsval = 7,
+				     .sacks = { { 2000, 3000 }, { 4000, 5000 } } };
+	struct cake_test_tcp one = { .flags = TCP_FLAG_ACK, .ack = 1000, .tsval = 7,
+				     .sacks = { { 2000, 5000 } } };
+	static const u64 start[] = { 5000, 0 };
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 12500000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	struct Qdisc *sch = mq->sch[0];
+	u64 window[2];
+	u32 len[3], drops[2], spell[2];
+	bool whole[2];
+	int c, i;
+
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+	q->config->ack_filter = CAKE_ACK_FILTER;
+	q->config->rate_flags |= CAKE_FLAG_AUTORATE_INGRESS;
+	for (c = 0; c < 2; c++) {
+		struct sk_buff *ack[3], *other, *first, *dropped;
+
+		for (i = 0; i < 3; i++) {
+			ack[i] = cake_test_tcp_skb(test, i < 2 ? &two : &one);
+			len[i] = ack[i]->len;
+		}
+		/* another flow's queue, a little shorter than the two ACKs and
+		 * longer than what's left of them after the drop
+		 */
+		other = cake_test_skb(test, false, IPPROTO_UDP, 9, 50000, 0);
+		kunit_remove_action(test, cake_test_free_skb, other);
+		qdisc_skb_cb(other)->pkt_len = 168;
+		first = cake_test_skb(test, false, IPPROTO_UDP, 9, 50001, 0);
+		kunit_remove_action(test, cake_test_free_skb, first);
+		qdisc_skb_cb(first)->pkt_len = 1000;
+
+		rcu_read_lock_bh();
+		cake_reset(sch);
+		/* a drop starts a spell, and builds the heap */
+		q->overflow_timeout = 0;
+		cake_test_in(sch, first);
+		dropped = NULL;
+		cake_drop(sch, &dropped, ktime_get());
+		kfree_skb_list(dropped);
+		cake_test_in(sch, other);
+		/* the window well inside its average gap: it doesn't close */
+		q->avg_packet_interval = NSEC_PER_SEC;
+		q->last_packet_time = ktime_get();
+		for (i = 0; i < 3; i++) {
+			if (i == 2)
+				q->avg_window_bytes = start[c];
+			cake_test_enqueue(sch, ack[i]);
+		}
+		window[c] = q->avg_window_bytes;
+		drops[c] = q->tins[0].ack_drops;
+		spell[c] = q->overflow_timeout;
+		whole[c] = cake_test_heap_whole(q);
+		q->tins[0].ack_drops = 0;
+		rcu_read_unlock_bh();
+	}
+	KUNIT_ASSERT_EQ(test, len[0], 86);
+	KUNIT_ASSERT_EQ(test, len[2], 78);
+	for (c = 0; c < 2; c++) {
+		KUNIT_EXPECT_EQ_MSG(test, drops[c], 1, "case %d", c);
+		KUNIT_EXPECT_EQ_MSG(test, window[c], start[c] + len[2], "case %d", c);
+		KUNIT_EXPECT_NE_MSG(test, spell[c], 0, "case %d: no spell", c);
+		KUNIT_EXPECT_TRUE_MSG(test, whole[c], "case %d: heap out of order", c);
+	}
+}
+
+/* cake_mq: what the other sub-cakes read sits on a cache line of its own,
+ * and what's written for every packet starts on the next
+ */
+static void cake_test_mq_published_line(struct kunit *test)
+{
+	size_t at = offsetof(struct cake_sched_data, last_active);
+
+	KUNIT_EXPECT_EQ(test, at % SMP_CACHE_BYTES, 0);
+	KUNIT_EXPECT_LT(test, offsetof(struct cake_sched_data, mq_usage), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_LT(test, offsetof(struct cake_sched_data, mq_sparse), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_LT(test, offsetof(struct cake_sched_data, mq_idle), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_LT(test, offsetof(struct cake_sched_data, mq_weight), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_LT(test, offsetof(struct cake_sched_data, mq_saturated), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_bytes), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_held_at), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_drained_at), at + SMP_CACHE_BYTES);
+	KUNIT_EXPECT_GE(test, offsetof(struct cake_sched_data, mq_seen_tins), at + SMP_CACHE_BYTES);
+}
+
+/* When a sub-cake last sent is written as its queue empties, whatever was
+ * there; while packets are left, only once half a sync_time has passed
+ * since it was last written (or it never was); and at a resync after
+ * packets were sent. When its queue last ran empty, only as it empties.
+ */
+static void cake_test_mq_last_active(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_mq_live(test, mq, 1);
+	struct Qdisc *sch = mq->sch[1];
+	const u64 later = ktime_get_ns() + NSEC_PER_SEC;
+	u64 seen[5], drained[3], before, now;
+	struct sk_buff *skb[5];
+	bool ok = true;
+	int i;
+
+	mq->cfg->sync_time = 200 * NSEC_PER_USEC;
+	cake_test_pkts(test, skb, 5, 5, 100);
+	before = ktime_get_ns();
+	rcu_read_lock_bh();
+	for (i = 0; i < 3; i++)
+		ok &= cake_test_in(sch, skb[i]);
+	/* never written: written */
+	ok &= cake_test_out(sch, skb[0]);
+	seen[0] = q->last_active;
+	drained[0] = q->mq_drained_at;
+	/* written just now (a time ahead of this one): left alone */
+	q->last_active = later;
+	ok &= cake_test_out(sch, skb[1]);
+	seen[1] = q->last_active;
+	drained[1] = q->mq_drained_at;
+	/* the queue empties: written, the exact time */
+	ok &= cake_test_out(sch, skb[2]);
+	seen[2] = q->last_active;
+	drained[2] = q->mq_drained_at;
+	/* long ago: written */
+	ok &= cake_test_in(sch, skb[3]) && cake_test_in(sch, skb[4]);
+	q->last_active = 1;
+	ok &= cake_test_out(sch, skb[3]);
+	seen[3] = q->last_active;
+	ok &= cake_test_out(sch, skb[4]);
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_GE(test, seen[0], before);
+	KUNIT_EXPECT_EQ(test, seen[1], later);
+	KUNIT_EXPECT_GE(test, seen[2], seen[0]);
+	KUNIT_EXPECT_LT(test, seen[2], later);
+	KUNIT_EXPECT_GE(test, seen[3], seen[2]);
+	KUNIT_EXPECT_EQ(test, drained[0], 0);
+	KUNIT_EXPECT_EQ(test, drained[1], 0);
+	KUNIT_EXPECT_EQ(test, drained[2], seen[2]);
+
+	/* a resync after packets were sent, and one after none */
+	now = ktime_get_ns();
+	q->last_checked_active = now - mq->cfg->sync_time;
+	q->mq_packets = 3;
+	q->mq_bytes = 300;
+	cake_mq_publish(q, now);
+	seen[4] = q->last_active;
+	KUNIT_EXPECT_EQ(test, seen[4], now);
+	q->last_checked_active = now;
+	cake_mq_publish(q, now + mq->cfg->sync_time);
+	KUNIT_EXPECT_EQ(test, q->last_active, now);
+}
