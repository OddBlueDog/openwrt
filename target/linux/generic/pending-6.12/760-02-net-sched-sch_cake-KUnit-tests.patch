+/* If a packet is stranded in a tin >= tin_cnt, cake_drop() widens the overflow
+ * heap to CAKE_MAX_TINS once and drops it, and cake_enqueue()'s drop loop ends.
+ */
+static void cake_test_drop_stranded_tin(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 12500000,
+							CAKE_DIFFSERV_DIFFSERV4);
+	struct Qdisc *sch = mq->sch[0];
+	struct sk_buff *skb[3], *to_free = NULL;
+	u32 qlen_after, used_after, tin2_backlog;
+	int i, tries = 0;
+	bool ok = true;
+
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+	for (i = 0; i < 3; i++) {
+		skb[i] = cake_test_skb(test, false, IPPROTO_UDP, 5 + i, 42000 + i, 0);
+		qdisc_skb_cb(skb[i])->pkt_len = 1514;
+	}
+	skb[0]->priority = TC_H_MAKE(sch->handle, 3);	/* tin 2 */
+	skb[1]->priority = TC_H_MAKE(sch->handle, 3);	/* tin 2 */
+	skb[2]->priority = TC_H_MAKE(sch->handle, 1);	/* tin 0 */
+
+	kunit_remove_action(test, cake_test_free_skb, skb[0]);
+	rcu_read_lock_bh();
+	ok &= cake_test_in(sch, skb[0]);
+	q->tin_cnt = 1;
+	q->overflow_timeout = 0;
+	q->buffer_limit = q->buffer_used - 1;
+	while (q->buffer_used > q->buffer_limit && tries < 4) {
+		cake_drop(sch, &to_free, ktime_get());
+		tries++;
+	}
+	kfree_skb_list(to_free);
+	to_free = NULL;
+	qlen_after = sch->q.qlen;
+	used_after = q->buffer_used;
+	rcu_read_unlock_bh();
+
+	KUNIT_ASSERT_TRUE(test, ok);
+	KUNIT_ASSERT_EQ(test, qlen_after, 0U);
+	KUNIT_EXPECT_EQ(test, used_after, 0U);
+
+	/* Also exercise cake_enqueue()'s drop loop with a stranded packet */
+	kunit_remove_action(test, cake_test_free_skb, skb[1]);
+	kunit_remove_action(test, cake_test_free_skb, skb[2]);
+	rcu_read_lock_bh();
+	q->tin_cnt = 4;
+	q->buffer_limit = ~0;
+	ok &= cake_test_in(sch, skb[1]);
+	q->tin_cnt = 1;
+	q->tin_mode = CAKE_DIFFSERV_BESTEFFORT;
+	q->overflow_timeout = 0;
+	q->buffer_limit = 1;
+	cake_enqueue(skb[2], sch, &to_free);
+	kfree_skb_list(to_free);
+	tin2_backlog = q->tins[2].tin_backlog;
+	qlen_after = sch->q.qlen;
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_EQ(test, tin2_backlog, 0U);
+	KUNIT_EXPECT_EQ(test, qlen_after, 0U);
+}
