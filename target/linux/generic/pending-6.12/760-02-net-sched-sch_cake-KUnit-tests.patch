+/* cake_clear_tin() still drains flows when a tin's u32 tin_backlog wraps to 0 */
+static void cake_test_clear_tin_wrapped_backlog(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 12500000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	struct Qdisc *sch = mq->sch[0];
+	struct sk_buff *skb[4];
+	u32 backlog_before, qlen_before, qlen_after;
+	int i, left = 0;
+	bool ok = true;
+
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+	for (i = 0; i < 4; i++) {
+		skb[i] = cake_test_skb(test, false, IPPROTO_UDP, 5 + i, 43000 + i, 0);
+		kunit_remove_action(test, cake_test_free_skb, skb[i]);
+		qdisc_skb_cb(skb[i])->pkt_len = 1U << 30;
+	}
+
+	rcu_read_lock_bh();
+	for (i = 0; i < 4; i++)
+		ok &= cake_test_in(sch, skb[i]);
+	backlog_before = q->tins[0].tin_backlog;
+	qlen_before = sch->q.qlen;
+	cake_reset(sch);
+	qlen_after = sch->q.qlen;
+	for (i = 0; i < CAKE_QUEUES; i++) {
+		if (q->tins[0].flows[i].head)
+			left++;
+	}
+	rcu_read_unlock_bh();
+
+	KUNIT_ASSERT_TRUE(test, ok);
+	KUNIT_EXPECT_EQ(test, backlog_before, 0U);
+	KUNIT_EXPECT_EQ(test, qlen_before, 4U);
+	KUNIT_EXPECT_EQ(test, qlen_after, 0U);
+	KUNIT_EXPECT_EQ(test, left, 0);
+}
