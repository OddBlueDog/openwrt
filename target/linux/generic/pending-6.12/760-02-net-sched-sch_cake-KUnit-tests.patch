+/* cake_mq_idle_after() fast path and cake_mq_ewma() zero fast path match exact math */
+static void cake_test_mq_idle_after_fastpath(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, cake_mq_ewma(0, 0, NSEC_PER_MSEC, CAKE_MQ_TAU), 0ULL);
+	KUNIT_EXPECT_EQ(test, cake_mq_ewma(0, 0, 5 * NSEC_PER_MSEC, CAKE_MQ_TAU), 0ULL);
+	/* Fast path: 1500 B/pkt at 10 MB/s -> 4 * 150 us = 600 us <= 2 ms */
+	KUNIT_EXPECT_EQ(test, cake_mq_idle_after(0, 15000, 10, 10000000), CAKE_MQ_TAU);
+	/* Boundary: 1500 B/pkt at 3 MB/s -> 4 * 500 us = 2 ms exact */
+	KUNIT_EXPECT_EQ(test, cake_mq_idle_after(0, 15000, 10, 3000000), CAKE_MQ_TAU);
+	/* Slow path: 1500 B/pkt at 1 MB/s -> 4 * 1.5 ms = 6 ms */
+	KUNIT_EXPECT_EQ(test, cake_mq_idle_after(0, 15000, 10, 1000000), 6 * NSEC_PER_MSEC);
+	/* Very slow -> clamped to CAKE_MQ_TAU_MAX (100 ms) */
+	KUNIT_EXPECT_EQ(test, cake_mq_idle_after(0, 15000, 10, 10000), CAKE_MQ_TAU_MAX);
+}
