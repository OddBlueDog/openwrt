+#ifdef CONFIG_NET_REDIRECT
+/* In ingress mode with sparse_ahead_us on, an ahead packet dropped by COBALT
+ * returns to begin: (and stops once the hold exceeds sparse_ahead_us), while
+ * a drop on a bulk flow takes retry: and delivers the next packet even when
+ * the drop moves time_next_packet past now with failsafe_next_packet ahead.
+ */
+static void cake_test_sparse_ahead_drop_retry(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 125000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	struct cake_tin_data *b = &q->tins[0];
+	struct cake_flow *sflow, *bflow;
+	struct Qdisc *sch = mq->sch[0];
+	struct sk_buff *bulk[3], *s[2], *out[2] = {};
+	u32 drops[3] = {};
+	bool ok = true;
+	ktime_t now;
+	int i;
+
+	/* 125 KB/s: flow_quantum is 300 B, so 250 B moves the shaper 2 ms
+	 * while leaving sparse deficit > 0; ahead window is 2.5 ms.
+	 */
+	cake_test_ahead_set(test, 2500);
+	q->config->rate_flags |= CAKE_FLAG_INGRESS;
+	cake_test_dl_pkts(test, bulk, 3, 5, 1514, true);
+	cake_test_dl_pkts(test, s, 2, 6, 250, true);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	rcu_read_lock_bh();
+	for (i = 0; i < 3; i++)
+		ok &= cake_test_in(sch, bulk[i]);
+	ok &= cake_test_out(sch, bulk[0]);
+	for (i = 0; i < 2; i++)
+		ok &= cake_test_in(sch, s[i]);
+	sflow = cake_test_flow_of(b, s[0]);
+	bflow = cake_test_flow_of(b, bulk[1]);
+	ok &= sflow && bflow;
+	if (ok) {
+		/* Ahead drop: hold is 1.5 ms (inside 2.5 ms), drop pushes both
+		 * time_next_packet (3.5 ms) and failsafe (15 ms) past 2.5 ms,
+		 * so going back to begin: stops and returns NULL.
+		 */
+		now = ktime_get();
+		q->time_next_packet = ktime_add_ns(now, 1500 * NSEC_PER_USEC);
+		q->failsafe_next_packet = ktime_add_ns(now, 15 * NSEC_PER_MSEC);
+		sflow->cvars.p_drop = U32_MAX;
+		drops[0] = sch->qstats.drops;
+		out[0] = cake_dequeue(sch);
+		drops[1] = sch->qstats.drops;
+
+		/* Drain the remaining sparse packet so bulk is served next */
+		sflow->cvars.p_drop = 0;
+		now = ktime_get();
+		q->time_next_packet = now;
+		q->failsafe_next_packet = now;
+		ok &= cake_test_out(sch, s[1]);
+
+		/* Bulk drop with time_next_packet due and failsafe 50 ms ahead:
+		 * dropping bulk[1] pushes time_next_packet 12 ms past now, so
+		 * retry: delivers bulk[2] whereas begin: would hold and return NULL.
+		 */
+		bflow->cvars.p_drop = U32_MAX;
+		now = ktime_get();
+		q->time_next_packet = now;
+		q->failsafe_next_packet = ktime_add_ns(now, 50 * NSEC_PER_MSEC);
+		out[1] = cake_dequeue(sch);
+		drops[2] = sch->qstats.drops;
+	}
+	rcu_read_unlock_bh();
+
+	KUNIT_ASSERT_TRUE(test, ok);
+	KUNIT_EXPECT_PTR_EQ(test, out[0], NULL);
+	KUNIT_EXPECT_EQ(test, drops[1], drops[0] + 1);
+	KUNIT_EXPECT_PTR_EQ(test, out[1], bulk[2]);
+	KUNIT_EXPECT_EQ(test, drops[2], drops[1] + 1);
+	if (out[0])
+		kfree_skb(out[0]);
+	if (out[1])
+		kfree_skb(out[1]);
+}
+#endif
