+/* A cake_mq sub-cake's flow floods its buffer: each overflow drop tells
+ * BLUE it doesn't respond, and p_drop goes up 1/256, once in each target
+ * (5 ms) at most; the tin counts it unresponsive. Back under the rate, its
+ * queue runs empty after each packet, and every packet gets through: BLUE
+ * spares a flow's last. Each time the flow is found empty more than target
+ * after the last step, p_drop steps down 1/4096 (not sooner), back to 0
+ * after 32 steps from 2/256, when it counts as responsive again and, its
+ * AQM state at rest, leaves the flowchain. A burst then gets through whole.
+ * The time between steps is stood in for by moving BLUE's timer back.
+ */
+/* A cake_test_mq_live() sub-cake's packets go with the test: only its
+ * tin 0 is set up, which cake_reset() would go past
+ */
+static void cake_test_clear_tin0(void *sch)
+{
+	rcu_read_lock_bh();
+	cake_clear_tin(sch, 0);
+	rcu_read_unlock_bh();
+}
+
+static void cake_test_mq_blue_recovers(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_mq_live(test, mq, 1);
+	struct cake_tin_data *b = &q->tins[0];
+	struct Qdisc *sch = mq->sch[1];
+	struct sk_buff *flood[20], *one[2], *burst[4];
+	u32 drops[2], p[3], unresp[2], steps = 0, early, got = 0, through = 0;
+	struct cake_flow *flow = NULL;
+	bool ok = true, rests;
+	ktime_t at;
+	int i, r;
+
+	cake_test_pkts(test, flood, 20, 5, 1514);
+	cake_test_pkts(test, one, 2, 5, 1514);
+	cake_test_pkts(test, burst, 4, 5, 1514);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_clear_tin0, sch));
+
+	rcu_read_lock_bh();
+	/* two floods into a buffer of three packets, more than target apart */
+	for (r = 0; r < 2; r++) {
+		for (i = 0; i < 10; i++) {
+			struct sk_buff *to_free = NULL;
+
+			cake_enqueue(flood[10 * r + i], sch, &to_free);
+			kfree_skb_list(to_free);
+			if (!flow)
+				flow = cake_test_flow_of(b, flood[0]);
+			if (r == 0 && i == 2)
+				q->buffer_limit = q->buffer_used;
+		}
+		if (flow && r == 0) {
+			p[0] = flow->cvars.p_drop;
+			flow->cvars.blue_timer = ktime_sub_ns(flow->cvars.blue_timer,
+							      b->cparams.target + 1);
+		}
+	}
+	drops[0] = sch->qstats.drops;
+	unresp[0] = b->unresponsive_flow_count;
+	ok &= flow != NULL;
+	/* what's left goes (BLUE may take one but the last); found empty */
+	while (sch->q.qlen) {
+		struct sk_buff *out = cake_dequeue(sch);
+
+		ok &= out != NULL;
+		got += out != NULL;
+		kfree_skb(out);
+	}
+	cake_dequeue(sch);
+	if (ok) {
+		p[1] = flow->cvars.p_drop;
+		/* empty again within target of the last step: no step */
+		at = ktime_get();
+		flow->cvars.blue_timer = ktime_sub_ns(at, b->cparams.target / 2);
+		cake_flow_emptied(q, b, flow, at);
+		early = flow->cvars.p_drop;
+		while (flow->cvars.p_drop && steps < 100) {
+			u32 was = flow->cvars.p_drop;
+
+			at = ktime_get();
+			flow->cvars.blue_timer = ktime_sub_ns(at, b->cparams.target + 1);
+			cake_flow_emptied(q, b, flow, at);
+			ok &= flow->cvars.p_drop == was - min(was, b->cparams.p_dec);
+			steps++;
+			/* half way: a packet at a time all gets through (found
+			 * empty well within target of the step: no step)
+			 */
+			if (steps == 16) {
+				flow->cvars.blue_timer = ktime_get();
+				for (i = 0; i < 2; i++) {
+					ok &= cake_test_in(sch, one[i]);
+					through += cake_test_out(sch, one[i]);
+					cake_dequeue(sch);
+				}
+			}
+		}
+		p[2] = flow->cvars.p_drop;
+		unresp[1] = b->unresponsive_flow_count;
+		/* the count and drop_next at rest too: it leaves the flowchain */
+		if (flow->set != CAKE_SET_NONE)
+			cake_flow_emptied(q, b, flow, ktime_add_ns(at, NSEC_PER_SEC));
+		rests = flow->set == CAKE_SET_NONE && list_empty(&flow->flowchain) &&
+			!b->decaying_flow_count && !b->sparse_flow_count && !b->bulk_flow_count;
+		drops[1] = sch->qstats.drops;
+		q->buffer_limit = ~0;
+		for (i = 0; i < 4; i++)
+			ok &= cake_test_in(sch, burst[i]);
+		for (i = 0; i < 4; i++)
+			through += cake_test_out(sch, burst[i]);
+	}
+	rcu_read_unlock_bh();
+
+	KUNIT_ASSERT_TRUE(test, ok);
+	KUNIT_EXPECT_EQ(test, drops[0], 17);
+	KUNIT_EXPECT_EQ(test, p[0], b->cparams.p_inc);
+	KUNIT_EXPECT_EQ(test, unresp[0], 1);
+	KUNIT_EXPECT_GE(test, got, 1);
+	KUNIT_EXPECT_EQ(test, p[1], 2 * b->cparams.p_inc);
+	KUNIT_EXPECT_EQ(test, early, p[1]);
+	KUNIT_EXPECT_EQ(test, steps, 2 * b->cparams.p_inc / b->cparams.p_dec);
+	KUNIT_EXPECT_EQ(test, p[2], 0);
+	KUNIT_EXPECT_EQ(test, unresp[1], 0);
+	KUNIT_EXPECT_TRUE(test, rests);
+	KUNIT_EXPECT_EQ(test, through, 6);
+	KUNIT_EXPECT_EQ(test, sch->qstats.drops, drops[1]);
+}
+
+/* COBALT's decay as it was: a step down for each interval / sqrt(count)
+ * the flow was away, however many (cobalt_should_drop() without the jump)
+ */
+static void cake_test_decay_ref(struct cobalt_vars *v, u64 interval, ktime_t now)
+{
+	bool next_due = v->count && ktime_to_ns(ktime_sub(now, v->drop_next)) >= 0;
+
+	while (next_due) {
+		v->count--;
+		cobalt_invsqrt(v);
+		v->drop_next = cobalt_control(v->drop_next, interval, v->rec_inv_sqrt);
+		next_due = v->count && ktime_to_ns(ktime_sub(now, v->drop_next)) >= 0;
+	}
+	if (!v->count)
+		cobalt_ecn_reset(v);
+}
+
+/* Random counts from @lo to @hi (spread evenly on a log scale) and pauses
+ * of up to 1.2 times what a full decay takes, a third of them short ones:
+ * through cobalt_should_drop() with a packet under target, the count ends
+ * within 2 (or 0.1%) of the old loop's and never below it, drop_next within
+ * two steps of it, and from the jump on the steps number at most 70. A
+ * decay all the way down clears the flow's ECN state as the loop does.
+ */
+static void cake_test_decay_jump_range(struct kunit *test, u32 lo, u32 hi, int samples, u64 seed)
+{
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_TCP, 2, 40000, 0);
+	struct cobalt_params p = {
+		.interval = 100 * NSEC_PER_MSEC,
+		.target = 5 * NSEC_PER_MSEC,
+		.mtu_time = 12 * NSEC_PER_USEC,
+	};
+	u32 bad_count = 0, bad_next = 0, bad_steps = 0, bad_ecn = 0, jumps = 0;
+	u32 max_steps = 0, max_off = 0;
+	struct rnd_state rnd;
+	int i;
+
+	prandom_seed_state(&rnd, seed);
+	for (i = 0; i < samples; i++) {
+		u64 span = (u64)ilog2(hi) - ilog2(lo) + 1, full, gap;
+		u32 count, r = prandom_u32_state(&rnd);
+		struct cobalt_vars v = {}, ref, jmp;
+		ktime_t now;
+
+		/* log scale: a power of two in range, then a fraction of it */
+		count = clamp_t(u32, (1U << (ilog2(lo) + r % span)) +
+				     prandom_u32_state(&rnd) % (1U << (ilog2(lo) + r % span)),
+				lo, hi);
+		cobalt_set_count(&v, count);
+		v.ecn_ignored = true;
+		v.ecn_strikes = 3;
+		full = 2 * p.interval * int_sqrt(count);
+		gap = div_u64(full * (prandom_u32_state(&rnd) % 1200), 1000);
+		if (i % 3 == 0)
+			gap /= 20;
+		now = ns_to_ktime(gap);
+		ref = v;
+		jmp = v;
+
+		cake_test_decay_ref(&ref, p.interval, now);
+		cobalt_set_enqueue_time(skb, now);
+		cobalt_should_drop(&v, &p, now, skb, 0, 0);
+
+		/* the steps from the jump on */
+		if (jmp.count > 64 && gap > 32ULL * reciprocal_scale(p.interval, jmp.rec_inv_sqrt)) {
+			u32 from;
+
+			cobalt_decay_jump(&jmp, p.interval, gap);
+			from = jmp.count;
+			jumps += from != count;
+			cake_test_decay_ref(&jmp, p.interval, now);
+			max_steps = max(max_steps, from - jmp.count);
+			bad_steps += from - jmp.count > 70;
+		}
+
+		max_off = max(max_off, v.count - min(v.count, ref.count));
+		if (v.count < ref.count ||
+		    v.count - ref.count > max_t(u32, 2, ref.count / 1000)) {
+			bad_count++;
+			kunit_info(test, "count %u, %llu ns away: %u, the loop %u", count, gap,
+				   v.count, ref.count);
+		}
+		if (ref.count) {
+			u64 step = div_u64(p.interval, int_sqrt(ref.count));
+
+			bad_next += abs_diff(ktime_to_ns(v.drop_next), ktime_to_ns(ref.drop_next)) >
+				    2 * step;
+		} else {
+			bad_ecn += v.ecn_ignored || v.ecn_strikes;
+		}
+	}
+	kunit_info(test, "counts %u to %u: %d pauses, %u jumps, at most %u steps after one, %u counts above the loop's at most",
+		   lo, hi, samples, jumps, max_steps, max_off);
+	KUNIT_EXPECT_EQ(test, bad_count, 0);
+	KUNIT_EXPECT_EQ(test, bad_next, 0);
+	KUNIT_EXPECT_EQ(test, bad_steps, 0);
+	KUNIT_EXPECT_EQ(test, bad_ecn, 0);
+	KUNIT_EXPECT_GT(test, jumps, samples / 3);
+}
+
+static void cake_test_decay_jump(struct kunit *test)
+{
+	cake_test_decay_jump_range(test, 65, 100000, 100, 7628);
+}
+
+/* the same into the millions, where the old loop takes a while */
+static void cake_test_decay_jump_large(struct kunit *test)
+{
+	cake_test_decay_jump_range(test, 100000, 10000000, 3, 7629);
+}
+
+/* Small counts, and pauses of fewer than 32 steps, take the steps one at a
+ * time, as before: the same count, 1/sqrt and drop_next as the old loop's
+ */
+static void cake_test_decay_small(struct kunit *test)
+{
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_TCP, 2, 40000, 0);
+	struct cobalt_params p = {
+		.interval = 100 * NSEC_PER_MSEC,
+		.target = 5 * NSEC_PER_MSEC,
+		.mtu_time = 12 * NSEC_PER_USEC,
+	};
+	u32 count, gap, bad = 0;
+
+	/* up to 2.5 intervals away: under 32 steps from a count of 128 */
+	for (count = 1; count <= 128; count++) {
+		for (gap = 1; gap <= 25; gap += 3) {
+			struct cobalt_vars v = {}, ref;
+			ktime_t now = ns_to_ktime(div_u64(p.interval * gap, 10));
+
+			cobalt_set_count(&v, count);
+			ref = v;
+			cake_test_decay_ref(&ref, p.interval, now);
+			cobalt_set_enqueue_time(skb, now);
+			cobalt_should_drop(&v, &p, now, skb, 0, 0);
+			bad += v.count != ref.count || v.rec_inv_sqrt != ref.rec_inv_sqrt ||
+			       (ref.count && v.drop_next != ref.drop_next);
+		}
+	}
+	KUNIT_EXPECT_EQ(test, bad, 0);
+
+	/* an interval that cobalt_control()'s u32 makes 0: no jump */
+	{
+		struct cobalt_vars v = {};
+
+		cobalt_set_count(&v, 5000);
+		cobalt_decay_jump(&v, 0, NSEC_PER_SEC);
+		KUNIT_EXPECT_EQ(test, v.count, 5000);
+	}
+}
+
+/* When the steps take a count of @count all the way down at @interval:
+ * the last step's time, from a drop_next of 0
+ */
+static u64 cake_test_decay_full(u32 count, u64 interval)
+{
+	struct cobalt_vars v = {};
+
+	cobalt_set_count(&v, count);
+	while (v.count > 1) {
+		v.count--;
+		cobalt_invsqrt(&v);
+		v.drop_next = cobalt_control(v.drop_next, interval, v.rec_inv_sqrt);
+	}
+	return ktime_to_ns(v.drop_next);
+}
+
+/* COBALT's count after a pause, at the edges: counts of 65 (the least the
+ * jump takes), 1000 and 100000; pauses 1 ns short of what the steps take
+ * all the way down, exactly that, 1 ns over, half of it, and just over the
+ * 32 steps' worth the jump starts at; an interval of 100 ms, the largest a
+ * u32 holds (4.3 s: cobalt_control() takes it as one, as a long rtt has
+ * it) and one past that, which it takes as 5 us. The count never wraps,
+ * never ends below the steps' (so not at 0 while the steps would be at 1)
+ * or more than 2 (0.1%) above them, and the jump alone never moves
+ * drop_next past the pause's end. Near the full time the steps' count is
+ * known (1, or 0): the loop isn't run for 100000.
+ */
+static void cake_test_decay_edges(struct kunit *test)
+{
+	static const u32 counts[] = { 65, 1000, 100000 };
+	static const u64 intervals[] = { 100 * NSEC_PER_MSEC, U32_MAX, (1ULL << 32) + 5000 };
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_TCP, 2, 40000, 0);
+	u32 bad = 0, checked = 0;
+	int i, j, k;
+
+	for (i = 0; i < ARRAY_SIZE(intervals); i++) {
+		struct cobalt_params p = {
+			.interval = intervals[i],
+			.target = 5 * NSEC_PER_MSEC,
+			.mtu_time = 12 * NSEC_PER_USEC,
+		};
+
+		for (j = 0; j < ARRAY_SIZE(counts); j++) {
+			u64 full = cake_test_decay_full(counts[j], p.interval), gaps[5];
+			struct cobalt_vars v = {};
+
+			cobalt_set_count(&v, counts[j]);
+			gaps[0] = full - 1;
+			gaps[1] = full;
+			gaps[2] = full + 1;
+			gaps[3] = full / 2;
+			gaps[4] = 33ULL * reciprocal_scale(p.interval, v.rec_inv_sqrt) + 1;
+			for (k = 0; k < ARRAY_SIZE(gaps); k++) {
+				struct cobalt_vars a = {}, r, jmp;
+				ktime_t now = ns_to_ktime(gaps[k]);
+				bool ok;
+
+				/* half the full time: the loop is too long for 100000 */
+				if (k == 3 && counts[j] > 1000)
+					continue;
+				cobalt_set_count(&a, counts[j]);
+				r = a;
+				jmp = a;
+				if (k <= 2)
+					r.count = gaps[k] >= full ? 0 : 1;
+				else
+					cake_test_decay_ref(&r, p.interval, now);
+				cobalt_set_enqueue_time(skb, now);
+				cobalt_should_drop(&a, &p, now, skb, 0, 0);
+				cobalt_decay_jump(&jmp, p.interval, gaps[k]);
+
+				ok = a.count <= counts[j] && a.count >= r.count &&
+				     a.count - r.count <= max_t(u32, 2, r.count / 1000) &&
+				     jmp.count <= counts[j] &&
+				     (!jmp.count || ktime_to_ns(jmp.drop_next) <= gaps[k]);
+				checked++;
+				if (!ok) {
+					bad++;
+					kunit_info(test, "interval %llu, count %u, %llu ns away: %u (the steps %u), the jump %u at %lld",
+						   p.interval, counts[j], gaps[k], a.count, r.count,
+						   jmp.count, ktime_to_ns(jmp.drop_next));
+				}
+			}
+		}
+	}
+	KUNIT_EXPECT_EQ(test, bad, 0);
+	KUNIT_EXPECT_EQ(test, checked, 42);
+}
+
+/* A tin with nothing queued is cleared without a look at its queues, and
+ * left as a look at each would leave it; one with packets is emptied
+ */
+static void cake_test_clear_tin_empty(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 12500000,
+							CAKE_DIFFSERV_DIFFSERV8);
+	struct Qdisc *sch = mq->sch[0];
+	struct sk_buff *skb[2];
+	u32 qlen[2];
+	int i, ret = 0;
+
+	cake_test_pkts(test, skb, 2, 5, 100);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+	for (i = 0; i < 2; i++)
+		skb[i]->priority = TC_H_MAKE(sch->handle, 1);	/* tin 0 */
+	rcu_read_lock_bh();
+	for (i = 0; i < 2; i++)
+		ret |= !cake_test_in(sch, skb[i]);
+	cake_clear_tin(sch, 3);
+	qlen[0] = sch->q.qlen;
+	cake_clear_tin(sch, 0);
+	qlen[1] = sch->q.qlen;
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, qlen[0], 2);
+	KUNIT_EXPECT_EQ(test, qlen[1], 0);
+	KUNIT_EXPECT_EQ(test, q->tins[0].tin_backlog, 0);
+	KUNIT_EXPECT_EQ(test, q->cur_tin, 0);
+	KUNIT_EXPECT_EQ(test, q->cur_flow, CAKE_QUEUES);
+}
