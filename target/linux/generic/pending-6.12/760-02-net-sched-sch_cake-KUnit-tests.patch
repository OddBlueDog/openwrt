+/* On a shared cake_mq sub-cake held 10 ms ahead, cake_enqueue()'s watchdog is
+ * capped to CAKE_MQ_TAU via cake_mq_wake_by().
+ */
+static void cake_test_enqueue_watchdog_mq_cap(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct Qdisc *root = cake_test_mq_root(test, mq, 2, 12500000,
+					       CAKE_DIFFSERV_BESTEFFORT);
+	struct Qdisc *sch = mq->sch[0];
+	struct cake_sched_data *q = cake_test_mq_q(mq, 0);
+	struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_UDP, 5, 46000, 0);
+	ktime_t now, exp;
+	bool queued, ok;
+
+	KUNIT_ASSERT_NOT_NULL(test, root);
+	kunit_remove_action(test, cake_test_free_skb, skb);
+	WRITE_ONCE(wake_slack_us, 0);
+
+	rcu_read_lock_bh();
+	now = ktime_get();
+	q->time_next_packet = ktime_add_ns(now, 10 * NSEC_PER_MSEC);
+	q->failsafe_next_packet = ktime_add_ns(now, 10 * NSEC_PER_MSEC);
+	ok = cake_test_in(sch, skb);
+	queued = hrtimer_is_queued(&q->watchdog.timer);
+	exp = hrtimer_get_softexpires(&q->watchdog.timer);
+	rcu_read_unlock_bh();
+
+	KUNIT_ASSERT_TRUE(test, ok);
+	KUNIT_ASSERT_TRUE(test, queued);
+	KUNIT_EXPECT_LE(test, ktime_to_ns(ktime_sub(exp, now)),
+			(s64)(CAKE_MQ_TAU + NSEC_PER_MSEC));
+}
