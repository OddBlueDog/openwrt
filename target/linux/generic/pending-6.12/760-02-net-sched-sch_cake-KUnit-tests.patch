diff --git a/net/sched/sch_cake_test.c b/net/sched/sch_cake_test.c
new file mode 100644
index 0000000..c4fbb3b
--- /dev/null
+++ b/net/sched/sch_cake_test.c
@@ -0,0 +1,7888 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/* KUnit tests for sch_cake's flow hashing, DRR quanta, COBALT's drops for
+ * flows that ignore ECN marks, the L4S ramp, and cake_mq's count of active sub-cakes,
+ * share of the rate and host loads. Built into
+ * sch_cake.ko (#included at the end of sch_cake.c) when
+ * CONFIG_NET_SCH_CAKE_KUNIT_TEST is set; the suite runs when it loads.
+ */
+#include <kunit/test.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/etherdevice.h>
+#include <linux/ipv6.h>
+#include <linux/kthread.h>
+#include <linux/prandom.h>
+#include <net/net_namespace.h>
+#include <net/rtnetlink.h>
+
+static void cake_test_kvfree(void *p)
+{
+	kvfree(p);
+}
+
+static void *cake_test_alloc(struct kunit *test, size_t size)
+{
+	void *p = kvzalloc(size, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, p);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_kvfree, p));
+	return p;
+}
+
+static void cake_test_free_skb(void *skb)
+{
+	kfree_skb(skb);
+}
+
+/* An Ethernet frame as CAKE sees it from ingress: data at the MAC header.
+ * @v6: IPv6 rather than IPv4; @host and @sport pick the source,
+ * @l4_hash: the hash RPS would have set, or none.
+ */
+static struct sk_buff *cake_test_skb(struct kunit *test, bool v6, u8 proto,
+				     u8 host, u16 sport, u32 l4_hash)
+{
+	struct sk_buff *skb = alloc_skb(256, GFP_KERNEL);
+	struct ethhdr *eth;
+	int l3;
+
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_free_skb, skb));
+	skb->dev = init_net.loopback_dev;
+
+	eth = skb_put_zero(skb, ETH_HLEN);
+	skb_reset_mac_header(skb);
+	skb_set_network_header(skb, ETH_HLEN);
+	if (v6) {
+		struct ipv6hdr *ip6 = skb_put_zero(skb, sizeof(*ip6));
+
+		eth->h_proto = htons(ETH_P_IPV6);
+		ip6->version = 6;
+		ip6->nexthdr = proto;
+		ip6->hop_limit = 64;
+		ip6->saddr.s6_addr32[0] = htonl(0x20010db8);
+		ip6->saddr.s6_addr[15] = host;
+		ip6->daddr.s6_addr32[0] = htonl(0x20010db8);
+		ip6->daddr.s6_addr32[1] = htonl(1);
+		ip6->daddr.s6_addr[15] = 1;
+		l3 = sizeof(*ip6);
+	} else {
+		struct iphdr *ip = skb_put_zero(skb, sizeof(*ip));
+
+		eth->h_proto = htons(ETH_P_IP);
+		ip->version = 4;
+		ip->ihl = 5;
+		ip->ttl = 64;
+		ip->protocol = proto;
+		ip->saddr = htonl(0xc0a80100 | host);	/* 192.168.1.host */
+		ip->daddr = htonl(0x01010101);		/* 1.1.1.1 */
+		l3 = sizeof(*ip);
+	}
+	skb->protocol = eth->h_proto;
+	skb_set_transport_header(skb, ETH_HLEN + l3);
+
+	if (proto == IPPROTO_TCP) {
+		struct tcphdr *th = skb_put_zero(skb, sizeof(*th));
+
+		th->source = htons(sport);
+		th->dest = htons(443);
+		th->doff = sizeof(*th) / 4;
+	} else if (proto == IPPROTO_UDP) {
+		struct udphdr *uh = skb_put_zero(skb, sizeof(*uh));
+
+		uh->source = htons(sport);
+		uh->dest = htons(53);
+		uh->len = htons(sizeof(*uh));
+	}
+	if (v6)
+		ipv6_hdr(skb)->payload_len = htons(skb->len - ETH_HLEN - l3);
+	else
+		ip_hdr(skb)->tot_len = htons(skb->len - ETH_HLEN);
+
+	if (l4_hash)
+		skb_set_hash(skb, l4_hash, PKT_HASH_TYPE_L4);
+	return skb;
+}
+
+/* What cake_hash() computed for every packet before the host hashes waited
+ * for a queue allocation: the flow tag and both host tags, eagerly.
+ */
+static void cake_test_ref_hashes(const struct sk_buff *skb, int flow_mode,
+				 u32 *flow_hash, u32 *srchost_hash,
+				 u32 *dsthost_hash)
+{
+	struct flow_keys keys, host_keys;
+
+	skb_flow_dissect_flow_keys(skb, &keys,
+				   FLOW_DISSECTOR_F_STOP_AT_FLOW_LABEL);
+	host_keys = keys;
+	host_keys.ports.ports = 0;
+	host_keys.basic.ip_proto = 0;
+	host_keys.keyid.keyid = 0;
+	host_keys.tags.flow_label = 0;
+
+	switch (host_keys.control.addr_type) {
+	case FLOW_DISSECTOR_KEY_IPV4_ADDRS:
+		host_keys.addrs.v4addrs.src = 0;
+		*dsthost_hash = flow_hash_from_keys(&host_keys);
+		host_keys.addrs.v4addrs.src = keys.addrs.v4addrs.src;
+		host_keys.addrs.v4addrs.dst = 0;
+		*srchost_hash = flow_hash_from_keys(&host_keys);
+		break;
+	case FLOW_DISSECTOR_KEY_IPV6_ADDRS:
+		memset(&host_keys.addrs.v6addrs.src, 0,
+		       sizeof(host_keys.addrs.v6addrs.src));
+		*dsthost_hash = flow_hash_from_keys(&host_keys);
+		host_keys.addrs.v6addrs.src = keys.addrs.v6addrs.src;
+		memset(&host_keys.addrs.v6addrs.dst, 0,
+		       sizeof(host_keys.addrs.v6addrs.dst));
+		*srchost_hash = flow_hash_from_keys(&host_keys);
+		break;
+	default:
+		*dsthost_hash = 0;
+		*srchost_hash = 0;
+	}
+
+	if (flow_mode & CAKE_FLOW_FLOWS) {
+		*flow_hash = skb->l4_hash ? skb->hash : flow_hash_from_keys(&keys);
+	} else {
+		*flow_hash = 0;
+		if (flow_mode & CAKE_FLOW_SRC_IP)
+			*flow_hash ^= *srchost_hash;
+		if (flow_mode & CAKE_FLOW_DST_IP)
+			*flow_hash ^= *dsthost_hash;
+	}
+}
+
+/* The queue, its tag and its host tags are those of the eager algorithm */
+static void cake_test_check_flow(struct kunit *test, struct cake_tin_data *q,
+				 const struct sk_buff *skb, int flow_mode,
+				 u32 idx)
+{
+	u32 flow_hash, srchost_hash, dsthost_hash;
+
+	cake_test_ref_hashes(skb, flow_mode, &flow_hash, &srchost_hash,
+			     &dsthost_hash);
+	KUNIT_ASSERT_LT(test, idx, CAKE_QUEUES);
+	KUNIT_EXPECT_EQ(test, q->tags[idx], flow_hash);
+	if (cake_dsrc(flow_mode))
+		KUNIT_EXPECT_EQ(test, q->hosts[q->flows[idx].srchost].srchost_tag,
+				srchost_hash);
+	if (cake_ddst(flow_mode))
+		KUNIT_EXPECT_EQ(test, q->hosts[q->flows[idx].dsthost].dsthost_tag,
+				dsthost_hash);
+}
+
+static const int cake_test_modes[] = {
+	CAKE_FLOW_SRC_IP, CAKE_FLOW_DST_IP, CAKE_FLOW_HOSTS, CAKE_FLOW_FLOWS,
+	CAKE_FLOW_DUAL_SRC, CAKE_FLOW_DUAL_DST, CAKE_FLOW_TRIPLE,
+	/* nat: no conntrack here, so the keys stay the packet's; with an L4
+	 * hash, the flow tag is the hash
+	 */
+	CAKE_FLOW_FLOWS | CAKE_FLOW_NAT_FLAG,
+	CAKE_FLOW_DUAL_DST | CAKE_FLOW_NAT_FLAG,
+	CAKE_FLOW_TRIPLE | CAKE_FLOW_NAT_FLAG,
+};
+
+/* First packet (queue allocated), next packets (direct hit), for 3 hosts x
+ * 4 ports, TCP and UDP, IPv4 and IPv6, with and without an RPS hash.
+ */
+static void cake_test_hash_matches_eager(struct kunit *test)
+{
+	int m, v6, proto, host, port, l4;
+
+	for (m = 0; m < ARRAY_SIZE(cake_test_modes); m++) {
+		int flow_mode = cake_test_modes[m];
+		struct cake_tin_data *q = cake_test_alloc(test, sizeof(*q));
+
+		for (v6 = 0; v6 < 2; v6++)
+		for (proto = 0; proto < 2; proto++)
+		for (l4 = 0; l4 < 2; l4++)
+		for (host = 2; host < 5; host++)
+		for (port = 0; port < 4; port++) {
+			u8 p = proto ? IPPROTO_UDP : IPPROTO_TCP;
+			u16 sport = 40000 + port;
+			u32 rps = l4 ? jhash_3words(host, sport, v6 * 2 + proto, 0) | 1 : 0;
+			struct sk_buff *skb = cake_test_skb(test, v6, p, host,
+							    sport, rps);
+			u32 idx = cake_hash(q, skb, flow_mode, 0, 0);
+			u16 src, dst;
+
+			cake_test_check_flow(test, q, skb, flow_mode, idx);
+			/* what cake_enqueue() does with a new flow */
+			q->flows[idx].set = CAKE_SET_SPARSE;
+			src = q->flows[idx].srchost;
+			dst = q->flows[idx].dsthost;
+
+			KUNIT_EXPECT_EQ(test, cake_hash(q, skb, flow_mode, 0, 0), idx);
+			KUNIT_EXPECT_EQ(test, q->flows[idx].srchost, src);
+			KUNIT_EXPECT_EQ(test, q->flows[idx].dsthost, dst);
+		}
+	}
+}
+
+/* A flow whose queue went idle (set cleared, tag kept) gets it back, and
+ * its host tags are worked out again from the packet.
+ */
+static void cake_test_hash_reallocates_idle_flow(struct kunit *test)
+{
+	struct cake_tin_data *q = cake_test_alloc(test, sizeof(*q));
+	int host;
+
+	for (host = 2; host < 12; host++) {
+		struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_TCP,
+						    host, 50000, 0);
+		u32 idx = cake_hash(q, skb, CAKE_FLOW_TRIPLE, 0, 0);
+
+		/* idle: the queue is free but keeps its tag; forget the hosts */
+		q->hosts[q->flows[idx].srchost].srchost_tag = 0;
+		q->hosts[q->flows[idx].dsthost].dsthost_tag = 0;
+		q->flows[idx].srchost = 0;
+		q->flows[idx].dsthost = 0;
+
+		KUNIT_EXPECT_EQ(test, cake_hash(q, skb, CAKE_FLOW_TRIPLE, 0, 0), idx);
+		cake_test_check_flow(test, q, skb, CAKE_FLOW_TRIPLE, idx);
+	}
+}
+
+/* A tc filter's flow override: no flow hash from the packet, but the host
+ * tags still come from it when the queue is allocated.
+ */
+static void cake_test_hash_flow_override(struct kunit *test)
+{
+	struct cake_tin_data *q = cake_test_alloc(test, sizeof(*q));
+	struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_TCP, 7, 40000, 0);
+	u32 flow_hash, srchost_hash, dsthost_hash;
+	u32 idx = cake_hash(q, skb, CAKE_FLOW_TRIPLE, 42, 0);
+
+	cake_test_ref_hashes(skb, CAKE_FLOW_TRIPLE, &flow_hash, &srchost_hash,
+			     &dsthost_hash);
+	KUNIT_EXPECT_EQ(test, idx, 41);
+	KUNIT_EXPECT_EQ(test, q->tags[idx], 41);
+	KUNIT_EXPECT_EQ(test, q->hosts[q->flows[idx].srchost].srchost_tag,
+			srchost_hash);
+	KUNIT_EXPECT_EQ(test, q->hosts[q->flows[idx].dsthost].dsthost_tag,
+			dsthost_hash);
+}
+
+/* Point a flow at a host with @n bulk flows, in both directions */
+static struct cake_flow *cake_test_host_load(struct cake_tin_data *q, u16 n)
+{
+	struct cake_flow *flow = &q->flows[3];
+
+	flow->srchost = 5;
+	flow->dsthost = 9;
+	q->hosts[5].srchost_bulk_flow_count = n;
+	q->hosts[9].dsthost_bulk_flow_count = n;
+	return flow;
+}
+
+static void cake_test_quantum_one_flow_exact(struct kunit *test)
+{
+	struct cake_tin_data *q = cake_test_alloc(test, sizeof(*q));
+	struct cake_flow *flow;
+	u16 n;
+
+	q->flow_quantum = 1514;
+	for (n = 0; n <= 1; n++) {
+		flow = cake_test_host_load(q, n);
+		KUNIT_EXPECT_EQ(test, cake_get_flow_quantum(q, flow, CAKE_FLOW_TRIPLE),
+				1514 << CAKE_DEFICIT_SHIFT);
+	}
+}
+
+/* A packet's charge to its flow's deficit: its length, up to 128 KB, and
+ * room left in the deficit after the largest
+ */
+static void cake_test_deficit_charge(struct kunit *test)
+{
+	struct cake_flow flow = {};
+
+	KUNIT_EXPECT_EQ(test, cake_deficit_charge(1514), 1514 << CAKE_DEFICIT_SHIFT);
+	KUNIT_EXPECT_EQ(test, cake_deficit_charge(75000), 75000 << CAKE_DEFICIT_SHIFT);
+	KUNIT_EXPECT_EQ(test, cake_deficit_charge(512 * 1024), cake_deficit_charge(128 * 1024 - 1));
+	/* the most a flow can have (a whole quantum) less the most it's charged */
+	flow.deficit = 65535 << CAKE_DEFICIT_SHIFT;
+	flow.deficit -= cake_deficit_charge(U32_MAX);
+	flow.deficit -= cake_deficit_charge(U32_MAX);
+	KUNIT_EXPECT_LT(test, flow.deficit, 0);
+	KUNIT_EXPECT_GT(test, (s64)flow.deficit, (s64)S32_MIN);
+}
+
+/* More bulk flows: the quantum over n, its fraction kept */
+static void cake_test_quantum_shared(struct kunit *test)
+{
+	struct cake_tin_data *q = cake_test_alloc(test, sizeof(*q));
+	u16 n;
+
+	q->flow_quantum = 1514;
+	for (n = 2; n <= CAKE_QUEUES; n++) {
+		struct cake_flow *flow = cake_test_host_load(q, n);
+		u32 exact = div_u64((u64)1514 << CAKE_DEFICIT_SHIFT, n);
+		u32 v = cake_get_flow_quantum(q, flow, CAKE_FLOW_TRIPLE);
+
+		/* 1514 / n to within a 16th of a byte (the u16 table's rounding) */
+		KUNIT_ASSERT_LE(test, v, exact);
+		KUNIT_ASSERT_LE(test, exact - v, 1 << (CAKE_DEFICIT_SHIFT - 4));
+	}
+}
+
+static u32 cake_test_bulk(struct kunit *test, u64 rate_bps, u16 flags, u16 n)
+{
+	struct cake_sched_data *qd = cake_test_alloc(test, sizeof(*qd));
+	struct cake_sched_config *cfg = cake_test_alloc(test, sizeof(*cfg));
+	struct cake_tin_data *b = cake_test_alloc(test, sizeof(*b));
+	struct cake_flow *flow = cake_test_host_load(b, n);
+
+	qd->config = cfg;
+	cfg->flow_mode = CAKE_FLOW_TRIPLE;
+	cfg->rate_flags = flags;
+	cfg->rate_bps = rate_bps;
+	b->flow_quantum = 1514;
+	b->tin_rate_bps = rate_bps;
+	cake_set_bulk_quantum(cfg, b, rate_bps);
+	/* what cake_bulk_park() gives the flow for each pass, in bytes */
+	return cake_host_share(b->bulk_quantum, cake_host_load(b, flow, cfg->flow_mode)) >>
+	       CAKE_DEFICIT_SHIFT;
+}
+
+static void cake_test_bulk_quantum(struct kunit *test)
+{
+	/* split-gso: MTU-sized packets, MTU-sized quantum, as before */
+	KUNIT_EXPECT_EQ(test, cake_test_bulk(test, 100000000, CAKE_FLAG_SPLIT_GSO, 1), 1514);
+	/* no-split-gso at 800 Mbit/s (100 MB/s): 244 us worth */
+	KUNIT_EXPECT_EQ(test, cake_test_bulk(test, 100000000, 0, 1), 100000000 >> 12);
+	/* slow links keep the MTU quantum; fast ones stop at the u16 limit */
+	KUNIT_EXPECT_EQ(test, cake_test_bulk(test, 1000000, 0, 1), 1514);
+	KUNIT_EXPECT_EQ(test, cake_test_bulk(test, 2000000000, 0, 1), U16_MAX);
+	/* unlimited (no rate): the MTU quantum */
+	KUNIT_EXPECT_EQ(test, cake_test_bulk(test, 0, 0, 1), 1514);
+	/* shared out between a host's bulk flows like the MTU quantum */
+	KUNIT_EXPECT_EQ(test, cake_test_bulk(test, 100000000, 0, 12),
+			(24414 * quantum_div[12]) >> 16);
+}
+
+/* cake_mq: a sub-cake's tin runs at its share, but its bulk quantum is sized
+ * from the whole rate, so a host's flows spread over the sub-cakes get what
+ * they would get per pass in one CAKE
+ */
+static void cake_test_bulk_quantum_mq(struct kunit *test)
+{
+	struct cake_sched_config *cfg = cake_test_alloc(test, sizeof(*cfg));
+	struct cake_tin_data *b = cake_test_alloc(test, sizeof(*b));
+	u64 rate = 100000000, share = rate / 3;	/* 800 Mbit/s, a third each */
+
+	cfg->rate_bps = rate;
+	b->flow_quantum = 1514;
+	b->tin_rate_bps = share;
+
+	/* plain cake at the share's rate: its own */
+	cake_set_bulk_quantum(cfg, b, share);
+	KUNIT_EXPECT_EQ(test, b->bulk_quantum, share >> 12);
+
+	/* a sub-cake at a third of the rate: the whole rate's */
+	cfg->is_shared = 1;
+	cake_set_bulk_quantum(cfg, b, share);
+	KUNIT_EXPECT_EQ(test, b->bulk_quantum, rate >> 12);
+
+	/* the whole rate (one busy sub-cake): the same */
+	b->tin_rate_bps = rate;
+	cake_set_bulk_quantum(cfg, b, rate);
+	KUNIT_EXPECT_EQ(test, b->bulk_quantum, rate >> 12);
+
+	/* unlimited: the MTU quantum */
+	cfg->rate_bps = 0;
+	b->tin_rate_bps = 0;
+	cake_set_bulk_quantum(cfg, b, 0);
+	KUNIT_EXPECT_EQ(test, b->bulk_quantum, 1514);
+
+	/* split-gso keeps the MTU-sized quantum */
+	cfg->rate_bps = rate;
+	cfg->rate_flags = CAKE_FLAG_SPLIT_GSO;
+	b->tin_rate_bps = share;
+	cake_set_bulk_quantum(cfg, b, share);
+	KUNIT_EXPECT_EQ(test, b->bulk_quantum, 1514);
+}
+
+/* cake_mq on a device with 16 tx queues, not registered. Each queue's
+ * sub-cake is a Qdisc with only what the count reads: its queue length and
+ * when it last sent a packet.
+ */
+#define CAKE_TEST_TXQS	16
+
+struct cake_test_mq {
+	struct net_device *dev;
+	struct Qdisc *sch[CAKE_TEST_TXQS];
+	struct cake_sched_config *cfg;
+};
+
+static void cake_test_free_netdev(void *dev)
+{
+	free_netdev(dev);
+}
+
+static struct cake_test_mq *cake_test_mq_alloc(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_alloc(test, sizeof(*mq));
+	int i;
+
+	mq->dev = alloc_netdev_mqs(0, "caketest", NET_NAME_UNKNOWN, ether_setup,
+				   CAKE_TEST_TXQS, 1);
+	KUNIT_ASSERT_NOT_NULL(test, mq->dev);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_free_netdev,
+							   mq->dev));
+
+	mq->cfg = cake_test_alloc(test, sizeof(*mq->cfg));
+	mq->cfg->is_shared = 1;
+	mq->cfg->used_qs = cake_test_alloc(test, BITS_TO_LONGS(CAKE_TEST_TXQS) *
+						 sizeof(unsigned long));
+
+	for (i = 0; i < CAKE_TEST_TXQS; i++) {
+		struct netdev_queue *txq = netdev_get_tx_queue(mq->dev, i);
+		struct Qdisc *sch = cake_test_alloc(test, sizeof(*sch) +
+							  sizeof(struct cake_sched_data));
+		struct cake_sched_data *q = qdisc_priv(sch);
+
+		sch->dev_queue = txq;
+		q->config = mq->cfg;
+		rcu_assign_pointer(txq->qdisc_sleeping, sch);
+		/* as on a device that's down: a shaper's watchdog that goes off
+		 * while a test runs schedules nothing
+		 */
+		rcu_assign_pointer(txq->qdisc, &noop_qdisc);
+		mq->sch[i] = sch;
+	}
+	return mq;
+}
+
+static struct cake_sched_data *cake_test_mq_q(struct cake_test_mq *mq, int i)
+{
+	return qdisc_priv(mq->sch[i]);
+}
+
+/* A packet to sub-cake @i's empty queue, as cake_enqueue() marks it */
+static void cake_test_mq_enqueue(struct cake_test_mq *mq, int i)
+{
+	if (!mq->sch[i]->q.qlen)
+		cake_mq_mark_used(mq->sch[i], cake_test_mq_q(mq, i));
+	mq->sch[i]->q.qlen++;
+}
+
+/* some time after the start, for the counts */
+#define CAKE_TEST_NOW	(100 * NSEC_PER_MSEC)
+
+static void cake_test_mq_peers(struct cake_test_mq *mq, int self, u64 now,
+			       struct cake_mq_peers *p)
+{
+	rcu_read_lock_bh();
+	cake_mq_read_peers(mq->sch[self], cake_test_mq_q(mq, self), now, p);
+	rcu_read_unlock_bh();
+}
+
+static u32 cake_test_mq_count(struct cake_test_mq *mq, int self, u64 now)
+{
+	struct cake_mq_peers p;
+
+	cake_test_mq_peers(mq, self, now, &p);
+	return p.count;
+}
+
+/* The count without used_qs: every real tx queue read */
+static u32 cake_test_mq_count_all(struct cake_test_mq *mq, int self, u64 now)
+{
+	u32 n = 1;
+	int i;
+
+	for (i = 0; i < mq->dev->real_num_tx_queues; i++) {
+		struct cake_sched_data *q = cake_test_mq_q(mq, i);
+
+		if (i != self && (mq->sch[i]->q.qlen ||
+				  (s64)(now - q->last_active) < (s64)(q->mq_idle ?: CAKE_MQ_TAU)))
+			n++;
+	}
+	return n;
+}
+
+/* Each sub-cake marks its own tx queue, once */
+static void cake_test_mq_marks_its_queue(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+
+	cake_test_mq_enqueue(mq, 1);
+	cake_test_mq_enqueue(mq, 1);
+	KUNIT_EXPECT_TRUE(test, test_bit(1, mq->cfg->used_qs));
+	KUNIT_EXPECT_EQ(test, bitmap_weight(mq->cfg->used_qs, CAKE_TEST_TXQS), 1);
+
+	cake_test_mq_enqueue(mq, 0);
+	cake_test_mq_enqueue(mq, CAKE_TEST_TXQS - 1);
+	KUNIT_EXPECT_TRUE(test, test_bit(0, mq->cfg->used_qs));
+	KUNIT_EXPECT_TRUE(test, test_bit(CAKE_TEST_TXQS - 1, mq->cfg->used_qs));
+	KUNIT_EXPECT_EQ(test, bitmap_weight(mq->cfg->used_qs, CAKE_TEST_TXQS), 3);
+}
+
+/* Sub-cake 1 is busy, as eth1's upload is; sub-cake 4 comes and goes */
+static void cake_test_mq_count_back_from_idle(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *other = cake_test_mq_q(mq, 4);
+	const u64 now = CAKE_TEST_NOW, us = NSEC_PER_USEC;
+
+	/* alone, its own queue counted once */
+	cake_test_mq_enqueue(mq, 1);
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 1, now), 1);
+
+	/* 4 has a packet queued */
+	cake_test_mq_enqueue(mq, 4);
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 1, now), 2);
+
+	/* 4 sent it, and has none queued between its packets */
+	mq->sch[4]->q.qlen = 0;
+	other->last_active = now;
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 1, now + 200 * us), 2);
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 1, now + CAKE_MQ_TAU - 1), 2);
+
+	/* nothing for CAKE_MQ_TAU: 4 is idle, still marked but not counted */
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 1, now + CAKE_MQ_TAU), 1);
+	KUNIT_EXPECT_TRUE(test, test_bit(4, mq->cfg->used_qs));
+
+	/* back from idle: counted again, queued or just sent */
+	cake_test_mq_enqueue(mq, 4);
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 1, now + 5000 * us), 2);
+	mq->sch[4]->q.qlen = 0;
+	other->last_active = now + 5000 * us;
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 1, now + 6000 * us), 2);
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 1, now + 5000 * us + CAKE_MQ_TAU), 1);
+
+	/* a send stamped on another CPU just after this one read the clock */
+	other->last_active = now + 9000 * us;
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 1, now + 9000 * us - 1), 2);
+
+	/* a slow sender, idle only after four of its packet intervals */
+	other->mq_idle = 10 * NSEC_PER_MSEC;
+	other->last_active = now + 20000 * us;
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 1, now + 29000 * us), 2);
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 1, now + 30000 * us), 1);
+}
+
+/* Only the real tx queues count, as the device changes how many it has */
+static void cake_test_mq_count_real_queues(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	int i;
+
+	for (i = 10; i < CAKE_TEST_TXQS; i++)
+		cake_test_mq_enqueue(mq, i);
+
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 0, CAKE_TEST_NOW), 7);
+	/* what netif_set_real_num_tx_queues() changes */
+	mq->dev->real_num_tx_queues = 8;
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 0, CAKE_TEST_NOW), 1);
+	mq->dev->real_num_tx_queues = 11;
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 0, CAKE_TEST_NOW), 2);
+	mq->dev->real_num_tx_queues = CAKE_TEST_TXQS;
+	KUNIT_EXPECT_EQ(test, cake_test_mq_count(mq, 0, CAKE_TEST_NOW), 7);
+}
+
+/* Any mix of never used, idle, queued and just-sent sub-cakes, and of real
+ * tx queues: the count is the one that read every queue.
+ */
+static void cake_test_mq_count_matches_all(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct rnd_state rnd;
+	int round, i;
+
+	prandom_seed_state(&rnd, 760);
+	for (round = 0; round < 2000; round++) {
+		int self = prandom_u32_state(&rnd) % CAKE_TEST_TXQS;
+		u64 now = CAKE_TEST_NOW + prandom_u32_state(&rnd) % CAKE_TEST_NOW;
+
+		bitmap_zero(mq->cfg->used_qs, CAKE_TEST_TXQS);
+		mq->dev->real_num_tx_queues = 1 + prandom_u32_state(&rnd) % CAKE_TEST_TXQS;
+		for (i = 0; i < CAKE_TEST_TXQS; i++) {
+			struct cake_sched_data *q = cake_test_mq_q(mq, i);
+
+			mq->sch[i]->q.qlen = 0;
+			q->last_active = 0;
+			q->mq_idle = prandom_u32_state(&rnd) % 2 ?
+				     prandom_u32_state(&rnd) % (8 * CAKE_MQ_TAU) : 0;
+			switch (prandom_u32_state(&rnd) % 5) {
+			case 0:	/* never had a packet */
+				break;
+			case 1:	/* idle */
+				cake_test_mq_enqueue(mq, i);
+				mq->sch[i]->q.qlen = 0;
+				q->last_active = now - CAKE_MQ_TAU -
+						 prandom_u32_state(&rnd) % CAKE_TEST_NOW;
+				break;
+			case 2:	/* packets queued */
+				cake_test_mq_enqueue(mq, i);
+				break;
+			case 3:	/* sent within CAKE_MQ_TAU */
+				cake_test_mq_enqueue(mq, i);
+				mq->sch[i]->q.qlen = 0;
+				q->last_active = now - prandom_u32_state(&rnd) % CAKE_MQ_TAU;
+				break;
+			case 4:	/* sent, stamped on another CPU after @now */
+				cake_test_mq_enqueue(mq, i);
+				mq->sch[i]->q.qlen = 0;
+				q->last_active = now + 1 + prandom_u32_state(&rnd) % 1000;
+				break;
+			}
+		}
+		KUNIT_ASSERT_EQ(test, cake_test_mq_count(mq, self, now),
+				cake_test_mq_count_all(mq, self, now));
+	}
+}
+
+/* cake_mq's share of the rate */
+
+#define CAKE_TEST_RATE	100000000ULL	/* 800 Mbit/s, in bytes/s */
+#define CAKE_TEST_UNIT	((u32)CAKE_MQ_UNIT)
+
+/* Alone, a sub-cake has the whole rate; unlimited stays unlimited */
+static void cake_test_mq_share_alone(struct kunit *test)
+{
+	struct cake_mq_peers p = { .count = 1 };
+
+	KUNIT_EXPECT_EQ(test, cake_mq_share(CAKE_TEST_RATE, 3 * CAKE_TEST_UNIT, 5000, &p),
+			CAKE_TEST_RATE);
+	p.count = 3;
+	p.bids = 2 * CAKE_TEST_UNIT;
+	p.sat_bids = 2 * CAKE_TEST_UNIT;
+	KUNIT_EXPECT_EQ(test, cake_mq_share(0, CAKE_TEST_UNIT, 0, &p), 0);
+}
+
+/* All saturated: the rate split by weight, all of it */
+static void cake_test_mq_share_by_weight(struct kunit *test)
+{
+	static const u32 cases[][4] = {
+		/* one flow against seven, one host (triple-isolate, one server) */
+		{ 65535 / 8, 7 * (65535 / 8) },
+		/* two LAN hosts, one flow against four (dual-dsthost) */
+		{ 65535, 4 * (65535 / 4) },
+		/* eight flows against two: the 80/20 imbalance */
+		{ 8 * 65535, 2 * 65535 },
+		/* even */
+		{ 65535, 65535, 65535, 65535 },
+	};
+	int c, i, j;
+
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		u64 total = 0, sum = 0;
+		int n = 0;
+
+		for (i = 0; i < 4 && cases[c][i]; i++, n++)
+			total += cases[c][i];
+		for (i = 0; i < n; i++) {
+			struct cake_mq_peers p = { .count = n };
+			u64 share, want;
+
+			for (j = 0; j < n; j++) {
+				if (j == i)
+					continue;
+				p.bids += cases[c][j];
+				p.sat_bids += cases[c][j];
+			}
+			share = cake_mq_share(CAKE_TEST_RATE, cases[c][i], 0, &p);
+			want = div64_u64(CAKE_TEST_RATE * cases[c][i], total);
+			KUNIT_EXPECT_LE(test, share, want);
+			KUNIT_EXPECT_GE(test, share + 1, want);
+			sum += share;
+		}
+		KUNIT_EXPECT_LE(test, sum, CAKE_TEST_RATE);
+		KUNIT_EXPECT_GE(test, sum + n, CAKE_TEST_RATE);
+	}
+}
+
+/* What an unsaturated sub-cake doesn't use goes to the others */
+static void cake_test_mq_share_lends(struct kunit *test)
+{
+	const u64 rate = CAKE_TEST_RATE;
+	struct cake_mq_peers p;
+	u64 used;
+
+	/* the 80/20 imbalance, a flood each: the other one uses 20%, this one
+	 * gets the 80% it brings, not half
+	 */
+	p = (struct cake_mq_peers){ .count = 2, .bids = CAKE_TEST_UNIT,
+				    .unsat_usage = rate / 5 };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT, 0, &p), rate - rate / 5);
+	/* ... and the 20% one is offered half, room to grow */
+	p = (struct cake_mq_peers){ .count = 2, .bids = CAKE_TEST_UNIT,
+				    .sat_bids = CAKE_TEST_UNIT };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT, 0, &p), rate / 2);
+
+	/* three unsaturated others: all the rest, whatever this one's weight */
+	used = rate / 10 + rate / 20 + rate / 4;
+	p = (struct cake_mq_peers){ .count = 4, .bids = 3 * CAKE_TEST_UNIT,
+				    .unsat_usage = used };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT / 8, 0, &p), rate - used);
+
+	/* only sparse flows here (no bulk weight), 8 bulk flows saturated
+	 * elsewhere: offered what a ninth flow would get, on top of its own
+	 */
+	p = (struct cake_mq_peers){ .count = 2, .bids = 8 * CAKE_TEST_UNIT,
+				    .sat_bids = 8 * CAKE_TEST_UNIT };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, 0, rate / 100, &p),
+			rate / 100 + div64_u64(rate - rate / 100, 9));
+}
+
+/* Sparse flows first, as in one CAKE: here a stream at 10% next to 4 bulk
+ * flows, and 4 bulk flows in another sub-cake. One CAKE gives the stream
+ * its 10% and each bulk flow 11.25%.
+ */
+static void cake_test_mq_share_sparse(struct kunit *test)
+{
+	const u64 rate = CAKE_TEST_RATE, sparse = rate / 10;
+	struct cake_mq_peers pa = { .count = 2, .bids = 4 * CAKE_TEST_UNIT,
+				    .sat_bids = 4 * CAKE_TEST_UNIT };
+	struct cake_mq_peers pb = { .count = 2, .bids = 4 * CAKE_TEST_UNIT,
+				    .sat_bids = 4 * CAKE_TEST_UNIT, .sat_sparse = sparse,
+				    .sparse = sparse };
+	u64 a = cake_mq_share(rate, 4 * CAKE_TEST_UNIT, sparse, &pa);
+	u64 b = cake_mq_share(rate, 4 * CAKE_TEST_UNIT, 0, &pb);
+
+	KUNIT_EXPECT_EQ(test, a, sparse + (rate - sparse) / 2);
+	KUNIT_EXPECT_EQ(test, b, (rate - sparse) / 2);
+	KUNIT_EXPECT_EQ(test, a + b, rate);
+}
+
+/* An average that hasn't caught up: never below what every sub-cake
+ * wanting more would leave this one
+ */
+static void cake_test_mq_share_floor(struct kunit *test)
+{
+	const u64 rate = CAKE_TEST_RATE;
+	struct cake_mq_peers p;
+
+	/* two others still average 60% each */
+	p = (struct cake_mq_peers){ .count = 3, .bids = 2 * CAKE_TEST_UNIT,
+				    .unsat_usage = 2 * (rate * 3 / 5) };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT, 0, &p), rate / 3);
+	/* one of them, a stream at 10%, all sparse: the floor leaves it out */
+	p = (struct cake_mq_peers){ .count = 3, .bids = 2 * CAKE_TEST_UNIT,
+				    .unsat_usage = rate / 10 + rate * 19 / 20,
+				    .sparse = rate / 10 };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT, 0, &p),
+			(rate - rate / 10) / 3);
+	/* and this one's own sparse flows come first */
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT, rate / 20, &p),
+			rate / 20 + (rate - rate / 10 - rate / 20) / 3);
+}
+
+/* Any rate, weights and usage: a share from 1 to the rate, at least the
+ * split by bids, and no bulk weight bids as one flow
+ */
+static void cake_test_mq_share_limits(struct kunit *test)
+{
+	struct rnd_state rnd;
+	int round;
+
+	prandom_seed_state(&rnd, 7608);
+	for (round = 0; round < 5000; round++) {
+		u64 rate = (((u64)prandom_u32_state(&rnd) << 32) |
+			    prandom_u32_state(&rnd)) >> (4 + prandom_u32_state(&rnd) % 60);
+		u32 weight = prandom_u32_state(&rnd) % (8 * 1024 * 65536);
+		u64 sparse = rate ? prandom_u32_state(&rnd) % (rate + 1) : 0;
+		struct cake_mq_peers p = {
+			.count = 2 + prandom_u32_state(&rnd) % 15,
+			.sat_bids = prandom_u32_state(&rnd) % (16 * 1024 * 65536),
+			.unsat_usage = rate ? (u64)prandom_u32_state(&rnd) * 2 * (rate >> 32) +
+					      prandom_u32_state(&rnd) % (rate + 1) : 0,
+			.sat_sparse = rate ? prandom_u32_state(&rnd) % (rate + 1) : 0,
+		};
+		u64 share, floor = sparse;
+
+		p.bids = p.sat_bids + prandom_u32_state(&rnd) % (8 * 65536);
+		p.sparse = p.sat_sparse + (rate ? prandom_u32_state(&rnd) % (rate + 1) : 0);
+		share = cake_mq_share(rate, weight, sparse, &p);
+		if (!rate) {
+			KUNIT_ASSERT_EQ(test, share, 0);
+			continue;
+		}
+		if (p.sparse + sparse < rate)
+			floor += mul_u64_u64_div_u64(rate - p.sparse - sparse,
+						     cake_mq_bid(weight),
+						     cake_mq_bid(weight) + p.bids);
+		KUNIT_ASSERT_GE(test, share, 1);
+		KUNIT_ASSERT_LE(test, share, rate);
+		KUNIT_ASSERT_GE(test, share, min(floor, rate));
+		if (!weight)
+			KUNIT_ASSERT_EQ(test, share,
+					cake_mq_share(rate, CAKE_MQ_UNIT, sparse, &p));
+	}
+}
+
+/* The usage averages: they settle on a steady rate, start again after a
+ * gap, and don't overflow at 10 Gbit/s over their longest time scale
+ */
+static void cake_test_mq_ewma(struct kunit *test)
+{
+	const u64 us = NSEC_PER_USEC;
+	u64 avg = 0, prev;
+	int i;
+
+	/* 100 MB/s, 20 KB per 200 us: within 1% after 10 time constants */
+	for (i = 0; i < 100; i++)
+		avg = cake_mq_ewma(avg, 20000, 200 * us, CAKE_MQ_TAU);
+	KUNIT_EXPECT_LE(test, abs((s64)avg - 100000000), 1000000);
+	/* falls with nothing sent, never below 0 */
+	for (i = 0; i < 200; i++) {
+		prev = avg;
+		avg = cake_mq_ewma(avg, 0, 200 * us, CAKE_MQ_TAU);
+		KUNIT_ASSERT_LE(test, avg, prev);
+	}
+	KUNIT_EXPECT_LE(test, avg, 1000);
+	/* a gap of a time constant or more: the last window alone */
+	KUNIT_EXPECT_EQ(test, cake_mq_ewma(12345678, 1000, CAKE_MQ_TAU, CAKE_MQ_TAU), 500000);
+	KUNIT_EXPECT_EQ(test, cake_mq_ewma(12345678, 0, 10 * NSEC_PER_SEC, CAKE_MQ_TAU), 0);
+	/* 2 Mbit/s, a packet every 6 ms, resyncs every 2 ms in between: a
+	 * steady average over 24 ms, within 10%
+	 */
+	avg = 250000;
+	for (i = 0; i < 300; i++) {
+		avg = cake_mq_ewma(avg, i % 3 ? 0 : 1514, 2000 * us, 24000 * us);
+		if (i >= 30)
+			KUNIT_ASSERT_LE(test, abs((s64)avg - 252333), 25233);
+	}
+	/* 10 Gbit/s over the longest time scale */
+	avg = 0;
+	for (i = 0; i < 1000; i++)
+		avg = cake_mq_ewma(avg, 2500000, 2000 * us, CAKE_MQ_TAU_MAX);
+	KUNIT_EXPECT_LE(test, abs((s64)avg - 1250000000), 12500000);
+}
+
+/* Wanting more than its share: using all of it, or most of it with packets
+ * held back by the shaper; and once wanting more, for as long as the shaper
+ * holds packets back from one resync to the next and the queue never runs
+ * empty in between, whatever its average
+ */
+static void cake_test_mq_saturated(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	const u64 dt = 200 * NSEC_PER_USEC, now = CAKE_TEST_NOW, share = CAKE_TEST_RATE;
+	/* when the shaper last held packets back: not lately, within the time
+	 * scale but before the last resync, since the last resync
+	 */
+	enum { NOT_HELD, HELD_BEFORE, HELD_SINCE };
+	static const struct {
+		u32 used;	/* per 1000 of the share */
+		u8 held;
+		bool was;	/* wanted more at the last resync */
+		bool saturated;
+		bool drained;	/* its queue ran empty since the last resync */
+	} cases[] = {
+		{ 990, NOT_HELD, false, true },		/* all of it */
+		{ 900, HELD_SINCE, false, true },	/* TCP held back by its share */
+		{ 900, NOT_HELD, false, false },	/* a stream just below it */
+		{ 800, HELD_SINCE, false, false },	/* well below, a burst waited */
+		{ 500, NOT_HELD, false, false },
+		/* TCP held back by a share that just grew: its average lags */
+		{ 700, HELD_SINCE, true, true },
+		{ 300, HELD_SINCE, true, true },
+		/* ... and once its flows slow down, nothing held since */
+		{ 900, HELD_BEFORE, true, true },
+		{ 800, HELD_BEFORE, true, false },
+		{ 700, NOT_HELD, true, false },
+		/* its bursts wait, but it runs out of packets in between: it
+		 * has less to send than its share
+		 */
+		{ 300, HELD_SINCE, true, false, true },
+		{ 700, HELD_SINCE, true, false, true },
+		/* ... which doesn't matter while it uses most of its share */
+		{ 900, HELD_SINCE, true, true, true },
+		{ 990, NOT_HELD, true, true, true },
+	};
+	int c;
+
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		static const u64 held_at[] = {
+			[NOT_HELD] = 0,
+			[HELD_BEFORE] = CAKE_TEST_NOW - 3 * 100 * NSEC_PER_USEC,
+			[HELD_SINCE] = CAKE_TEST_NOW - 100 * NSEC_PER_USEC,
+		};
+		u64 usage = share * cases[c].used / 1000;
+
+		q->synced_rate = share;
+		q->mq_usage = usage;
+		q->mq_bytes = div64_u64(usage * dt, NSEC_PER_SEC);
+		q->mq_idle = CAKE_MQ_TAU;
+		q->last_checked_active = now - dt;
+		q->mq_held_at = held_at[cases[c].held];
+		/* emptied after the last resync, or long before it */
+		q->mq_drained_at = cases[c].drained ? now - 50 * NSEC_PER_USEC : 0;
+		q->mq_saturated = cases[c].was;
+		cake_mq_publish(q, now);
+		KUNIT_EXPECT_EQ_MSG(test, q->mq_saturated, cases[c].saturated, "case %d", c);
+	}
+}
+
+/* How long a sub-cake counts as active after its last packet */
+static void cake_test_mq_idle_after(struct kunit *test)
+{
+	const u64 usage = 5000000 / 8;	/* 5 Mbit/s */
+
+	/* full-sized packets 2.4 ms apart: idle after four of them */
+	KUNIT_EXPECT_EQ(test, cake_mq_idle_after(0, 3 * 1514, 3, usage),
+			div64_u64(4ULL * 1514 * NSEC_PER_SEC, usage));
+	/* fast: at least CAKE_MQ_TAU */
+	KUNIT_EXPECT_EQ(test, cake_mq_idle_after(0, 100 * 1514, 100, CAKE_TEST_RATE),
+			CAKE_MQ_TAU);
+	/* a ping a second: at most 100 ms */
+	KUNIT_EXPECT_EQ(test, cake_mq_idle_after(0, 98, 1, 98), CAKE_MQ_TAU_MAX);
+	/* nothing sent since the last resync: as it was */
+	KUNIT_EXPECT_EQ(test, cake_mq_idle_after(7 * NSEC_PER_MSEC, 0, 0, usage),
+			7 * NSEC_PER_MSEC);
+	KUNIT_EXPECT_EQ(test, cake_mq_idle_after(0, 0, 0, 0), CAKE_MQ_TAU);
+}
+
+/* A share that grows shortens the shaper's wait at once, and a waiting
+ * sub-cake wakes within CAKE_MQ_TAU to work its share out again
+ */
+static void cake_test_mq_rescale_wait(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	struct cake_sched_config *cfg = cake_test_alloc(test, sizeof(*cfg));
+	const ktime_t now = 1000 * NSEC_PER_MSEC, ms = NSEC_PER_MSEC;
+
+	/* 10 ms left at a share that then doubles: 5 ms */
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(now + 10 * ms, now, 1000, 2000), now + 5 * ms);
+	/* one that halves: 20 ms, as the share now says */
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(now + 10 * ms, now, 2000, 1000), now + 20 * ms);
+	/* up and down again: back where it was */
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(cake_mq_rescale_wait(now + 10 * ms, now, 1000, 3000),
+						   now, 3000, 1000), now + 10 * ms - 1);
+	/* nothing left to wait: unchanged; nor beyond a second */
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(now - 1, now, 1000, 2000), now - 1);
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(now + 10 * ms, now, CAKE_TEST_RATE, 1),
+			now + NSEC_PER_SEC);
+	/* a packet sent at a near-zero share pushed the next one 10 s ahead */
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(now + 10 * NSEC_PER_SEC, now, 10,
+						   CAKE_TEST_RATE), now + 1000);
+
+	q->config = cfg;
+	cfg->is_shared = 1;
+	KUNIT_EXPECT_EQ(test, cake_mq_wake_by(q, now + 50 * ms, now), now + CAKE_MQ_TAU);
+	KUNIT_EXPECT_EQ(test, cake_mq_wake_by(q, now + ms, now), now + ms);
+	/* plain cake waits for its shaper */
+	cfg->is_shared = 0;
+	KUNIT_EXPECT_EQ(test, cake_mq_wake_by(q, now + 50 * ms, now), now + 50 * ms);
+}
+
+/* A new share rescales each tin's schedule with the shaper's: here
+ * diffserv4's four tins, the share tripled. A tin that sent while the share
+ * was a third of it would otherwise wait three times too long to count as
+ * within its threshold again, losing its priority meanwhile, and one past
+ * its schedule keeps it; the tins not in use are left alone.
+ */
+static void cake_test_mq_rescale_tins(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	const ktime_t now = 1000 * NSEC_PER_MSEC, ms = NSEC_PER_MSEC;
+	static const s64 left[CAKE_MAX_TINS] = { 9, 0, -2, 30, 6, 6, 6, 6 };
+	int t;
+
+	q->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(*q->tins));
+	q->tin_cnt = 4;
+	q->time_next_packet = now + 12 * ms;
+	q->failsafe_next_packet = now + 18 * ms;
+	for (t = 0; t < CAKE_MAX_TINS; t++)
+		q->tins[t].time_next_packet = now + left[t] * ms;
+
+	cake_mq_rescale_waits(q, now, 1000, 3000);
+
+	KUNIT_EXPECT_EQ(test, q->time_next_packet, now + 4 * ms);
+	KUNIT_EXPECT_EQ(test, q->failsafe_next_packet, now + 6 * ms);
+	KUNIT_EXPECT_EQ(test, q->tins[0].time_next_packet, now + 3 * ms);
+	KUNIT_EXPECT_EQ(test, q->tins[1].time_next_packet, now);
+	KUNIT_EXPECT_EQ(test, q->tins[2].time_next_packet, now - 2 * ms);
+	KUNIT_EXPECT_EQ(test, q->tins[3].time_next_packet, now + 10 * ms);
+	for (t = 4; t < CAKE_MAX_TINS; t++)
+		KUNIT_EXPECT_EQ(test, q->tins[t].time_next_packet, now + 6 * ms);
+
+	/* and back down: as they were */
+	cake_mq_rescale_waits(q, now, 3000, 1000);
+	KUNIT_EXPECT_EQ(test, q->tins[0].time_next_packet, now + 9 * ms);
+	KUNIT_EXPECT_EQ(test, q->tins[3].time_next_packet, now + 30 * ms);
+}
+
+/* Sub-cakes with uneven demands (bytes/s; 0: idle; U64_MAX: all it can
+ * get) and bulk weights, each resyncing every 200 us as cake_dequeue()
+ * does and sending at the lower of its demand and its share. What one
+ * CAKE's DRR would give them is weighted max-min: each gets what it asks
+ * for up to a level set by its weight, and the rate is all used if
+ * they ask for that much.
+ */
+static void cake_test_mq_fair_levels(const u64 *demand, const u32 *weight,
+				     int n, u64 rate, u64 *want)
+{
+	bool fixed[CAKE_TEST_TXQS] = {};
+	u64 left = rate;
+	bool again = true;
+	int i;
+
+	while (again) {
+		u64 w = 0;
+
+		again = false;
+		for (i = 0; i < n; i++)
+			if (!fixed[i] && demand[i])
+				w += cake_mq_bid(weight[i]);
+		for (i = 0; i < n; i++) {
+			if (fixed[i] || !demand[i])
+				continue;
+			want[i] = mul_u64_u64_div_u64(left, cake_mq_bid(weight[i]), w);
+			if (demand[i] <= want[i]) {
+				want[i] = demand[i];
+				fixed[i] = true;
+				left -= demand[i];
+				again = true;
+				break;
+			}
+		}
+	}
+	for (i = 0; i < n; i++)
+		if (!demand[i])
+			want[i] = 0;
+}
+
+static void cake_test_mq_converge(struct kunit *test, struct cake_test_mq *mq,
+				  const u64 *demand, const u32 *weight, int n,
+				  u64 rate)
+{
+	const u64 step = 200 * NSEC_PER_USEC;
+	u64 sent[CAKE_TEST_TXQS] = {}, want[CAKE_TEST_TXQS], got = 0, asked = 0;
+	u64 now = 10 * NSEC_PER_MSEC;
+	int t, k, i;
+
+	mq->dev->real_num_tx_queues = CAKE_TEST_TXQS;
+	bitmap_zero(mq->cfg->used_qs, CAKE_TEST_TXQS);
+	mq->cfg->rate_bps = rate;
+	for (i = 0; i < CAKE_TEST_TXQS; i++) {
+		struct cake_sched_data *q = cake_test_mq_q(mq, i);
+
+		mq->sch[i]->q.qlen = 0;
+		q->tin_cnt = 1;
+		q->tins[0].mq_weight = i < n ? weight[i] : 0;
+		q->synced_rate = rate;
+		q->last_checked_active = now - step;
+		q->last_active = 0;
+		q->mq_usage = q->mq_sparse = q->mq_bytes = q->mq_sparse_bytes = 0;
+		q->mq_idle = 0;
+		q->mq_packets = 0;
+		q->mq_held_at = 0;
+		q->mq_drained_at = 0;
+		q->mq_weight = 0;
+		q->mq_saturated = false;
+		if (i < n && demand[i]) {
+			cake_test_mq_enqueue(mq, i);
+			mq->sch[i]->q.qlen = 1;
+		}
+	}
+
+	for (t = 0; t < 150; t++) {
+		now += step;
+		for (k = 0; k < n; k++) {
+			/* not always in the same order */
+			int i = (k + t) % n;
+			struct cake_sched_data *q = cake_test_mq_q(mq, i);
+			struct cake_mq_peers p;
+			u64 rate_i, share;
+
+			if (!demand[i])
+				continue;
+			rate_i = min(demand[i], q->synced_rate);
+			/* asking for more than it may send: its shaper holds packets */
+			if (demand[i] > q->synced_rate)
+				q->mq_held_at = now - step / 2;
+			if (t >= 100)
+				sent[i] += rate_i;
+			q->mq_bytes = div64_u64(rate_i * step, NSEC_PER_SEC);
+			q->last_active = now;
+			cake_mq_publish(q, now);
+			cake_test_mq_peers(mq, i, now, &p);
+			share = cake_mq_share(rate, q->mq_weight, q->mq_sparse, &p);
+			if (cake_mq_share_moved(share, q->synced_rate, rate))
+				q->synced_rate = share;
+			q->last_checked_active = now;
+		}
+	}
+
+	cake_test_mq_fair_levels(demand, weight, n, rate, want);
+	for (i = 0; i < n; i++) {
+		sent[i] /= 50;
+		got += sent[i];
+		asked += min(demand[i], rate);
+		/* each within 3% of the rate of its fair level */
+		KUNIT_EXPECT_LE_MSG(test, abs((s64)sent[i] - (s64)want[i]), rate / 50,
+				    "sub-cake %d of %d: %llu, fair %llu (demand %llu, weight %u)",
+				    i, n, sent[i], want[i], demand[i], weight[i]);
+	}
+	/* all of the rate in use, when it's asked for */
+	KUNIT_EXPECT_LE(test, got, rate + rate / 100);
+	KUNIT_EXPECT_GE(test, got, min(asked, rate) - min(asked, rate) * 3 / 100);
+}
+
+static void cake_test_mq_alloc_tins(struct kunit *test, struct cake_test_mq *mq)
+{
+	int i;
+
+	for (i = 0; i < CAKE_TEST_TXQS; i++)
+		cake_test_mq_q(mq, i)->tins =
+			cake_test_alloc(test, sizeof(struct cake_tin_data));
+}
+
+/* What cake_test_mq_senders() saw: bytes sent, and the ticks in which a
+ * sub-cake's shaper held packets back, with those in which it counted as
+ * wanting more
+ */
+struct cake_test_mq_run {
+	u64 sent;
+	u64 held;
+	u64 held_saturated;
+};
+
+#define CAKE_TEST_TICK	(50 * NSEC_PER_USEC)
+
+/* @n sub-cakes sharing @rate (bytes/s) for @ms, each fed by a sender like
+ * TCP's: its rate grows steadily, and once its packets have waited 5 ms in
+ * the sub-cake it slows to 7/10 of it, at most once a 20 ms round trip.
+ * Every 50 us each one with packets sends what its shaper lets through, in
+ * packets of up to @pkt bytes, resyncing every 200 us first, as
+ * cake_dequeue() does.
+ */
+static void cake_test_mq_senders(struct cake_test_mq *mq, int n, u64 rate, u32 pkt, u32 ms,
+				 struct cake_test_mq_run *r)
+{
+	const u64 fair = div_u64(rate, n), sync = 200 * NSEC_PER_USEC;
+	u64 demand[CAKE_TEST_TXQS], backlog[CAKE_TEST_TXQS], arrived[CAKE_TEST_TXQS];
+	u64 slowed[CAKE_TEST_TXQS], now = 10 * NSEC_PER_MSEC;
+	const u64 end = now + ms * NSEC_PER_MSEC;
+	u32 t;
+	int i, k;
+
+	memset(r, 0, sizeof(*r));
+	mq->dev->real_num_tx_queues = CAKE_TEST_TXQS;
+	bitmap_zero(mq->cfg->used_qs, CAKE_TEST_TXQS);
+	mq->cfg->rate_bps = rate;
+	for (i = 0; i < CAKE_TEST_TXQS; i++) {
+		struct cake_sched_data *q = cake_test_mq_q(mq, i);
+
+		mq->sch[i]->q.qlen = 0;
+		q->tin_cnt = 1;
+		q->tins[0].mq_weight = 0;
+		q->synced_rate = rate;
+		q->last_checked_active = 0;
+		q->last_active = 0;
+		q->mq_usage = q->mq_sparse = q->mq_bytes = q->mq_sparse_bytes = 0;
+		q->mq_idle = 0;
+		q->mq_packets = 0;
+		q->mq_held_at = 0;
+		q->mq_drained_at = 0;
+		q->mq_weight = 0;
+		q->mq_saturated = false;
+		q->time_next_packet = 0;
+		/* not quite even, so they don't move in step */
+		demand[i] = fair + div_u64(fair * i, 4 * n);
+		backlog[i] = arrived[i] = slowed[i] = 0;
+	}
+
+	for (t = 0; now < end; t++) {
+		now += CAKE_TEST_TICK;
+		for (k = 0; k < n; k++) {
+			struct cake_sched_data *q = cake_test_mq_q(mq, (k + t) % n);
+
+			i = (k + t) % n;
+			arrived[i] += demand[i] * CAKE_TEST_TICK;
+			backlog[i] += div64_u64(arrived[i], NSEC_PER_SEC);
+			arrived[i] %= NSEC_PER_SEC;
+			if (!backlog[i])
+				continue;
+			if (!mq->sch[i]->q.qlen)
+				cake_test_mq_enqueue(mq, i);
+			if (now - q->last_checked_active >= sync) {
+				struct cake_mq_peers p;
+				u64 share;
+
+				cake_mq_publish(q, now);
+				cake_test_mq_peers(mq, i, now, &p);
+				share = cake_mq_share(rate, q->mq_weight, q->mq_sparse, &p);
+				if (cake_mq_share_moved(share, q->synced_rate, rate)) {
+					q->time_next_packet = cake_mq_rescale_wait(q->time_next_packet, now,
+										   q->synced_rate, share);
+					q->synced_rate = share;
+				}
+				q->last_checked_active = now;
+			}
+			/* no credit for the time it had nothing to send */
+			q->time_next_packet = max_t(u64, q->time_next_packet, now - CAKE_TEST_TICK);
+			while (backlog[i] && q->time_next_packet <= now) {
+				u32 len = min_t(u64, backlog[i], pkt);
+
+				backlog[i] -= len;
+				q->time_next_packet += div64_u64((u64)len * NSEC_PER_SEC, q->synced_rate);
+				q->mq_bytes += len;
+				q->mq_packets++;
+				q->last_active = now;
+				r->sent += len;
+			}
+			if (!backlog[i]) {
+				mq->sch[i]->q.qlen = 0;
+				q->mq_drained_at = now;
+			} else if (q->time_next_packet > now) {
+				q->mq_held_at = now;
+				r->held++;
+				r->held_saturated += q->mq_saturated;
+			}
+		}
+		for (i = 0; i < n; i++) {
+			struct cake_sched_data *q = cake_test_mq_q(mq, i);
+			u64 wait = div64_u64(backlog[i] * NSEC_PER_SEC, q->synced_rate);
+
+			if (wait > 5 * NSEC_PER_MSEC && now - slowed[i] > 20 * NSEC_PER_MSEC) {
+				demand[i] = div_u64(demand[i] * 7, 10);
+				slowed[i] = now;
+			} else {
+				demand[i] += div64_u64(fair * CAKE_TEST_TICK, 60 * NSEC_PER_MSEC);
+			}
+		}
+	}
+}
+
+/* TCP flows on several sub-cakes, each slowing down now and then and
+ * growing back, as they do when they're the bottleneck's: together they
+ * send no more than the rate, and fill it. Each sub-cake's shaper holds its
+ * packets back nearly all the time, and it must count as wanting more for
+ * all of that time. It counted as not wanting more, for a few percent of
+ * it, whenever its share grew faster than its average of what it used, and
+ * then the others took the part it was about to use: the sub-cakes went
+ * over the rate together.
+ */
+static void cake_test_mq_share_within_rate(struct kunit *test)
+{
+	static const struct {
+		int n;
+		u64 rate;	/* bytes/s */
+		u32 pkt;
+	} cases[] = {
+		{ 3, 100000000, 17000 },	/* a download in GRO packets */
+		{ 4, 100000000, 17000 },
+		{ 8, 5000000, 1514 },		/* an upload over eight tx queues */
+		{ 8, 1875000, 1514 },
+	};
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_test_mq_run r;
+	int c;
+
+	cake_test_mq_alloc_tins(test, mq);
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		u64 allowed = cases[c].rate;	/* a second */
+
+		cake_test_mq_senders(mq, cases[c].n, cases[c].rate, cases[c].pkt, 1000, &r);
+		KUNIT_EXPECT_LE_MSG(test, r.sent * 1000, allowed * 1005,
+				    "case %d: %llu bytes, %llu allowed", c, r.sent, allowed);
+		KUNIT_EXPECT_GE_MSG(test, r.sent * 100, allowed * 98,
+				    "case %d: %llu bytes, %llu allowed", c, r.sent, allowed);
+		KUNIT_EXPECT_GT(test, r.held, 0);
+		KUNIT_EXPECT_GE_MSG(test, r.held_saturated * 1000, r.held * 999,
+				    "case %d: held back in %llu ticks, wanting more in %llu",
+				    c, r.held, r.held_saturated);
+	}
+}
+
+/* Sub-cake 1's traffic after it wanted more: @pkts packets of 1514 bytes
+ * every @every ticks, all at once (a sender paced by its timer, the
+ * packets handed over a NAPI poll at a time), its flows sparse ones
+ * (counted as such, no bulk weight) when @sparse. Sub-cake 0's bulk weight
+ * is @weight (0: a host's only flow).
+ */
+struct cake_test_bursts {
+	u32 pkts, every, weight;
+	bool sparse;
+	/* a third sub-cake with a 1514-byte packet every this many ticks, its
+	 * own and never wanting more (0: none)
+	 */
+	u32 trickle;
+};
+
+/* Two sub-cakes sharing 100 MB/s that both wanted more, at half of it each,
+ * for 50 ms: sub-cake 0 held back throughout, sub-cake 1 with only @c's
+ * bursts; with @c's trickle, a third that never wanted more. What each sent
+ * in the last 25 ms in @sent, and whether each wanted more at the end in
+ * @sat.
+ */
+static void cake_test_mq_bursts(struct kunit *test, const struct cake_test_bursts *c,
+				u64 *sent, bool *sat)
+{
+	const u64 rate = 100000000, sync = 200 * NSEC_PER_USEC;
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	u64 now = 10 * NSEC_PER_MSEC, backlog[3] = {};
+	const u64 from = now + 25 * NSEC_PER_MSEC, end = now + 50 * NSEC_PER_MSEC;
+	const int n = c->trickle ? 3 : 2;
+	struct cake_sched_data *q;
+	u32 t;
+	int i;
+
+	cake_test_mq_alloc_tins(test, mq);
+	mq->dev->real_num_tx_queues = n;
+	bitmap_zero(mq->cfg->used_qs, CAKE_TEST_TXQS);
+	mq->cfg->rate_bps = rate;
+	sent[0] = sent[1] = sent[2] = 0;
+	for (i = 0; i < n; i++) {
+		q = cake_test_mq_q(mq, i);
+		mq->sch[i]->q.qlen = 0;
+		q->tin_cnt = 1;
+		q->tins[0].mq_weight = i ? 0 : c->weight;
+		q->mq_bytes = q->mq_sparse_bytes = 0;
+		q->mq_idle = 0;
+		q->mq_packets = 0;
+		q->mq_weight = q->tins[0].mq_weight;
+		q->mq_drained_at = 0;
+		q->synced_rate = rate / 2;
+		q->mq_usage = rate / 2;
+		q->mq_sparse = i == 1 && c->sparse ? rate / 2 : 0;
+		q->mq_saturated = i < 2;
+		q->mq_held_at = i < 2 ? now : 0;
+		if (i == 2)
+			q->mq_usage = div_u64(1514ULL * NSEC_PER_SEC, c->trickle * CAKE_TEST_TICK);
+		q->last_checked_active = now;
+		q->last_active = now;
+		q->time_next_packet = now;
+	}
+	/* sub-cake 0 is never out of packets; 1 starts with none */
+	cake_test_mq_enqueue(mq, 0);
+
+	for (t = 0; now < end; t++) {
+		now += CAKE_TEST_TICK;
+		/* a burst for sub-cake 1, as cake_enqueue() takes it: an empty
+		 * queue's shaper starts from now
+		 */
+		for (i = 1; i < n; i++) {
+			if (t % (i == 1 ? c->every : c->trickle))
+				continue;
+			q = cake_test_mq_q(mq, i);
+			if (!backlog[i]) {
+				cake_test_mq_enqueue(mq, i);
+				q->time_next_packet = max_t(u64, q->time_next_packet, now);
+			}
+			backlog[i] += i == 1 ? c->pkts : 1;
+		}
+		for (i = 0; i < n; i++) {
+			q = cake_test_mq_q(mq, i);
+			if (i && !backlog[i])
+				continue;
+			if (now - q->last_checked_active >= sync) {
+				struct cake_mq_peers p;
+				u64 share;
+
+				cake_mq_publish(q, now);
+				cake_test_mq_peers(mq, i, now, &p);
+				share = cake_mq_share(rate, q->mq_weight, q->mq_sparse, &p);
+				if (cake_mq_share_moved(share, q->synced_rate, rate)) {
+					q->time_next_packet = cake_mq_rescale_wait(q->time_next_packet, now,
+										   q->synced_rate, share);
+					q->synced_rate = share;
+				}
+				q->last_checked_active = now;
+			}
+			/* sub-cake 0's flows never run out: no credit for a pause */
+			if (i == 0)
+				q->time_next_packet = max_t(u64, q->time_next_packet, now - CAKE_TEST_TICK);
+			while ((i == 0 || backlog[i]) && q->time_next_packet <= now) {
+				q->time_next_packet += div64_u64(1514ULL * NSEC_PER_SEC, q->synced_rate);
+				q->mq_bytes += 1514;
+				if (i == 1 && c->sparse)
+					q->mq_sparse_bytes += 1514;
+				q->mq_packets++;
+				q->last_active = now;
+				if (now > from)
+					sent[i] += 1514;
+				if (i)
+					backlog[i]--;
+			}
+			if (i && !backlog[i]) {
+				mq->sch[i]->q.qlen = 0;
+				q->mq_drained_at = now;
+			} else if (q->time_next_packet > now) {
+				q->mq_held_at = now;
+			}
+		}
+	}
+	for (i = 0; i < n; i++)
+		sat[i] = cake_test_mq_q(mq, i)->mq_saturated;
+}
+
+/* A sub-cake that wanted more is left with a stream well under its share,
+ * in bursts: the second packet of each waits for the first at its share,
+ * but its queue runs empty in between. It drops out, and the other, held
+ * back throughout, takes all of the rate but the stream's. Counted as still
+ * wanting more, it kept its bid's half for itself (a sub-cake with only
+ * sparse flows bids as one host's only flow, as much as another's four),
+ * the other was held to the rest, and up to half the rate went unused.
+ */
+static void cake_test_mq_bursts_drop_out(struct kunit *test)
+{
+	static const struct cake_test_bursts cases[] = {
+		/* 3 MB/s, two packets every 1 ms */
+		{ 2, 20, 0, false },
+		/* a quarter of its share, three packets every 350 us */
+		{ 3, 7, 0, false },
+		/* sparse flows only, against one host's four bulk flows */
+		{ 2, 20, 4 * (65535 / 4), true },
+		/* a quarter of its share in bursts, and a third sub-cake near
+		 * idle at 1 Mbit/s (an RSS ring the table gives nothing, CPU 0's)
+		 */
+		{ 3, 7, 0, false, 240 },
+	};
+	const u64 rate = 100000000, span = 25 * NSEC_PER_MSEC;
+	int c;
+
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		u64 stream = div_u64(cases[c].pkts * 1514ULL * NSEC_PER_SEC,
+				     cases[c].every * CAKE_TEST_TICK);
+		u64 trickle = cases[c].trickle ?
+			div_u64(1514ULL * NSEC_PER_SEC, cases[c].trickle * CAKE_TEST_TICK) : 0;
+		u64 want = div_u64((rate - stream - trickle) * span, NSEC_PER_SEC), sent[3];
+		bool sat[3];
+
+		cake_test_mq_bursts(test, &cases[c], sent, sat);
+		KUNIT_EXPECT_FALSE_MSG(test, sat[1], "case %d", c);
+		KUNIT_EXPECT_TRUE_MSG(test, sat[0], "case %d", c);
+		if (cases[c].trickle) {
+			KUNIT_EXPECT_FALSE_MSG(test, sat[2], "case %d", c);
+			/* every packet of the trickle through, the sum still within the rate */
+			KUNIT_EXPECT_GE_MSG(test, sent[2] + 1514, div_u64(trickle * span, NSEC_PER_SEC), "case %d", c);
+			sent[1] += sent[2];
+		}
+		/* the stream all got through; the rest of the rate went to
+		 * sub-cake 0, to within 2%, and no more than the rate between them
+		 */
+		KUNIT_EXPECT_GE_MSG(test, sent[1] + cases[c].pkts * 1514,
+				    div_u64(stream * span, NSEC_PER_SEC), "case %d", c);
+		KUNIT_EXPECT_GE_MSG(test, sent[0] * 100, want * 98,
+				    "case %d: sent %llu, the rest of the rate %llu", c, sent[0], want);
+		KUNIT_EXPECT_LE_MSG(test, (sent[0] + sent[1]) * 1000,
+				    div_u64(rate * span, NSEC_PER_SEC) * 1005 + 1000 * 1514, "case %d", c);
+	}
+}
+
+/* At 2 Mbit/s two sub-cakes both want more, a 1514-byte packet each every
+ * 12 ms at their half of the rate; then one's flows end. It goes on
+ * counting as active, and as wanting more, until it's idle: four of its
+ * packet intervals after its last packet (cake_mq_idle_after(), 48 ms
+ * here). The other is held to half the rate that long and then takes all
+ * of it: at most four of the stopped one's packets' worth of the rate goes
+ * unused, however long its idle time.
+ */
+static void cake_test_mq_stopped_holds_little(struct kunit *test)
+{
+	const u64 rate = 250000, sync = 200 * NSEC_PER_USEC;
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	u64 now = 10 * NSEC_PER_MSEC, sent = 0, idle = 0, lost;
+	const u64 stop = now + 300 * NSEC_PER_MSEC, end = stop + 200 * NSEC_PER_MSEC;
+	struct cake_sched_data *q;
+	u32 t;
+	int i;
+
+	cake_test_mq_alloc_tins(test, mq);
+	mq->dev->real_num_tx_queues = 2;
+	bitmap_zero(mq->cfg->used_qs, CAKE_TEST_TXQS);
+	mq->cfg->rate_bps = rate;
+	for (i = 0; i < 2; i++) {
+		q = cake_test_mq_q(mq, i);
+		mq->sch[i]->q.qlen = 0;
+		q->tin_cnt = 1;
+		q->tins[0].mq_weight = 0;
+		q->mq_bytes = q->mq_sparse_bytes = q->mq_sparse = 0;
+		q->mq_idle = 0;
+		q->mq_packets = 0;
+		q->mq_weight = 0;
+		q->mq_drained_at = 0;
+		q->synced_rate = rate / 2;
+		q->mq_usage = rate / 2;
+		q->mq_saturated = true;
+		q->mq_held_at = now;
+		q->last_checked_active = now;
+		q->last_active = now;
+		q->time_next_packet = now;
+		cake_test_mq_enqueue(mq, i);
+	}
+
+	for (t = 0; now < end; t++) {
+		now += CAKE_TEST_TICK;
+		for (i = 0; i < 2; i++) {
+			q = cake_test_mq_q(mq, i);
+			/* sub-cake 1's flows end: its last packet has gone */
+			if (i == 1 && now >= stop) {
+				if (mq->sch[1]->q.qlen) {
+					mq->sch[1]->q.qlen = 0;
+					q->mq_drained_at = now;
+					idle = q->mq_idle;
+				}
+				continue;
+			}
+			if (now - q->last_checked_active >= sync) {
+				struct cake_mq_peers p;
+				u64 share;
+
+				cake_mq_publish(q, now);
+				cake_test_mq_peers(mq, i, now, &p);
+				share = cake_mq_share(rate, q->mq_weight, q->mq_sparse, &p);
+				if (cake_mq_share_moved(share, q->synced_rate, rate)) {
+					q->time_next_packet = cake_mq_rescale_wait(q->time_next_packet, now,
+										   q->synced_rate, share);
+					q->synced_rate = share;
+				}
+				q->last_checked_active = now;
+			}
+			q->time_next_packet = max_t(u64, q->time_next_packet, now - CAKE_TEST_TICK);
+			while (q->time_next_packet <= now) {
+				q->time_next_packet += div64_u64(1514ULL * NSEC_PER_SEC, q->synced_rate);
+				q->mq_bytes += 1514;
+				q->mq_packets++;
+				q->last_active = now;
+				if (i == 0 && now >= stop)
+					sent += 1514;
+			}
+			q->mq_held_at = now;
+		}
+	}
+
+	lost = div_u64(rate * (end - stop), NSEC_PER_SEC) - min(sent, div_u64(rate * (end - stop), NSEC_PER_SEC));
+	kunit_info(test, "idle after %llu ms, %llu bytes of the rate unused", div_u64(idle, NSEC_PER_MSEC), lost);
+	/* the slow case: a long time to count as idle */
+	KUNIT_EXPECT_GE(test, idle, 40 * NSEC_PER_MSEC);
+	KUNIT_EXPECT_EQ(test, cake_test_mq_q(mq, 0)->synced_rate, rate);
+	KUNIT_EXPECT_LE(test, lost, 6 * 1514);
+}
+
+/* The cases in the plan: uneven demand, sub-queues idle, weights by host */
+static void cake_test_mq_share_converges(struct kunit *test)
+{
+	const u64 r = CAKE_TEST_RATE;
+	const u32 u = CAKE_TEST_UNIT;
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	static const struct {
+		u64 demand[4];
+		u32 weight[4];
+	} cases[] = {
+		/* 1 bulk flow against 7, one server (triple-isolate) */
+		{ { U64_MAX, U64_MAX }, { 65535 / 8, 7 * (65535 / 8) } },
+		/* bulk flows next to a 10% video stream on another queue */
+		{ { U64_MAX, CAKE_TEST_RATE / 10 }, { 8 * 65535, 0 } },
+		/* two hosts on different queues, 1 flow against 4 */
+		{ { U64_MAX, U64_MAX }, { 65535, 4 * (65535 / 4) } },
+		/* the paper's 80/20 floods */
+		{ { CAKE_TEST_RATE * 4 / 5, CAKE_TEST_RATE / 5 }, { 65535, 65535 } },
+		/* a TCP flow held back by its own window, two saturated */
+		{ { U64_MAX, CAKE_TEST_RATE / 4, U64_MAX }, { 65535, 65535, 2 * 65535 } },
+		/* two idle sub-cakes in between */
+		{ { U64_MAX, 0, U64_MAX, 0 }, { 65535, 65535, 3 * 65535, 65535 } },
+		/* nobody asks for the rate */
+		{ { CAKE_TEST_RATE / 5, CAKE_TEST_RATE / 10, CAKE_TEST_RATE / 4 }, { 65535, 65535, 65535 } },
+	};
+	struct rnd_state rnd;
+	int c, round;
+
+	cake_test_mq_alloc_tins(test, mq);
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		int n = 0;
+
+		while (n < 4 && (cases[c].demand[n] || cases[c].weight[n]))
+			n++;
+		cake_test_mq_converge(test, mq, cases[c].demand, cases[c].weight, n, r);
+	}
+
+	/* and at random: up to 16 sub-cakes, idle, held back or saturated */
+	prandom_seed_state(&rnd, 7609);
+	for (round = 0; round < 200; round++) {
+		u64 demand[CAKE_TEST_TXQS];
+		u32 weight[CAKE_TEST_TXQS];
+		int n = 2 + prandom_u32_state(&rnd) % (CAKE_TEST_TXQS - 1), i;
+
+		for (i = 0; i < n; i++) {
+			switch (prandom_u32_state(&rnd) % 3) {
+			case 0:
+				demand[i] = 0;
+				break;
+			case 1:
+				demand[i] = r / 100 + prandom_u32_state(&rnd) % (r / 2);
+				break;
+			default:
+				demand[i] = U64_MAX;
+			}
+			weight[i] = prandom_u32_state(&rnd) % 4 ? (1 + prandom_u32_state(&rnd) % 8) *
+				    (u / (1 + prandom_u32_state(&rnd) % 8)) : 0;
+		}
+		cake_test_mq_converge(test, mq, demand, weight, n, r);
+	}
+}
+
+/* cake_mq's host loads: four sub-cakes' tin 0, one host table between them */
+/* Two LAN hosts for a test of host fairness: 5, and the first from 6 on
+ * whose source hash falls in another slot of the host table (and another
+ * cake_mq host bucket) than 5's. The hash key is random each boot: about
+ * one boot in a thousand, 5 and 6 meet. Then the second takes the first's
+ * slot while neither has a bulk flow yet (as upstream CAKE does), and
+ * they're counted as one host, which isn't what these tests are about.
+ */
+static void cake_test_two_hosts(struct kunit *test, u8 *first, u8 *second)
+{
+	u32 src[2], dst;
+	u8 h;
+
+	cake_host_hashes(cake_test_skb(test, false, IPPROTO_TCP, 5, 40000, 0), 0, &src[0], &dst);
+	for (h = 6; h < 250; h++) {
+		cake_host_hashes(cake_test_skb(test, false, IPPROTO_TCP, h, 40000, 0), 0, &src[1], &dst);
+		if (src[0] % CAKE_QUEUES != src[1] % CAKE_QUEUES)
+			break;
+	}
+	*first = 5;
+	*second = h;
+}
+
+struct cake_test_hosts {
+	struct cake_sched_config cfg;
+	struct cake_sched_data *q[4];
+	atomic_t *hosts;
+};
+
+static struct cake_test_hosts *cake_test_hosts_alloc(struct kunit *test)
+{
+	struct cake_test_hosts *h = cake_test_alloc(test, sizeof(*h));
+	int i;
+
+	h->cfg.is_shared = 1;
+	h->cfg.flow_mode = CAKE_FLOW_TRIPLE;
+	h->hosts = cake_test_alloc(test, 2 * CAKE_MAX_TINS * CAKE_QUEUES * sizeof(atomic_t));
+	h->cfg.mq_hosts = h->hosts;
+	for (i = 0; i < 4; i++) {
+		struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+		struct cake_tin_data *b;
+
+		q->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(*q->tins));
+		q->tin_cnt = 1;
+		q->config = &h->cfg;
+		b = &q->tins[0];
+		cake_init_flowchains(b);
+		cake_mq_set_host_tables(q, h->hosts);
+		h->q[i] = q;
+	}
+	return h;
+}
+
+/* A packet from LAN host @host, port @sport, to 1.1.1.1 into tin @b, its
+ * flow then going bulk with a refill, as cake_dequeue() does
+ */
+static struct cake_flow *cake_test_bulk_flow(struct kunit *test,
+					     struct cake_tin_data *b, int mode,
+					     u8 host, u16 sport)
+{
+	struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_TCP, host, sport, 0);
+	struct cake_flow *flow = &b->flows[cake_hash(b, skb, mode, 0, 0)];
+
+	if (flow->set == CAKE_SET_BULK)
+		return flow;
+	/* the next pass's slot, as cake_bulk_queue() puts it there */
+	list_add_tail(&flow->flowchain, &b->old_wheel[(b->cur_slot + 1) % CAKE_WHEEL_SLOTS]);
+	b->wheel_mask |= BIT((b->cur_slot + 1) % CAKE_WHEEL_SLOTS);
+	flow->set = CAKE_SET_BULK;
+	b->bulk_flow_count++;
+	cake_inc_srchost_bulk_flow_count(b, flow, mode);
+	cake_inc_dsthost_bulk_flow_count(b, flow, mode);
+	cake_mq_set_weight(b, flow, quantum_div[cake_host_load(b, flow, mode)]);
+	return flow;
+}
+
+static struct cake_flow *cake_test_hosts_bulk(struct kunit *test,
+					      struct cake_test_hosts *h, int s,
+					      u8 host, u16 sport)
+{
+	return cake_test_bulk_flow(test, &h->q[s]->tins[0], h->cfg.flow_mode,
+				   host, sport);
+}
+
+/* Every bucket holds what the sub-cakes count under its tags */
+static void cake_test_hosts_check(struct kunit *test, struct cake_test_hosts *h)
+{
+	int (*sums)[CAKE_QUEUES] = kcalloc(2, sizeof(*sums), GFP_KERNEL);
+	int s, k;
+
+	KUNIT_ASSERT_NOT_NULL(test, sums);
+
+	for (s = 0; s < 4; s++) {
+		struct cake_tin_data *b = &h->q[s]->tins[0];
+		u32 weight = 0;
+
+		for (k = 0; k < CAKE_QUEUES; k++) {
+			sums[0][b->hosts[k].srchost_tag % CAKE_QUEUES] +=
+				b->hosts[k].srchost_bulk_flow_count;
+			sums[1][b->hosts[k].dsthost_tag % CAKE_QUEUES] +=
+				b->hosts[k].dsthost_bulk_flow_count;
+			weight += b->flows[k].mq_weight;
+		}
+		KUNIT_EXPECT_EQ(test, b->mq_weight, weight);
+	}
+	for (k = 0; k < CAKE_QUEUES; k++) {
+		KUNIT_EXPECT_EQ(test, atomic_read(&h->hosts[k]), sums[0][k]);
+		KUNIT_EXPECT_EQ(test, atomic_read(&h->hosts[CAKE_QUEUES + k]), sums[1][k]);
+	}
+	kfree(sums);
+}
+
+/* A host's flows in two sub-cakes are shared out as one host's */
+static void cake_test_mq_host_load_shared(struct kunit *test)
+{
+	struct cake_test_hosts *h = cake_test_hosts_alloc(test);
+	struct cake_flow *a[2], *b[3], *other;
+	u8 one, two;
+	int i;
+
+	cake_test_two_hosts(test, &one, &two);
+	for (i = 0; i < 2; i++)
+		a[i] = cake_test_hosts_bulk(test, h, 0, one, 40000 + i);
+	for (i = 0; i < 3; i++)
+		b[i] = cake_test_hosts_bulk(test, h, 1, one, 41000 + i);
+	cake_test_hosts_check(test, h);
+
+	/* host 5 has 2 bulk flows here and 3 there: 5 in all, as one CAKE sees */
+	KUNIT_EXPECT_EQ(test, h->q[0]->tins[0].hosts[a[0]->srchost].srchost_bulk_flow_count, 2);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], a[0], CAKE_FLOW_TRIPLE), 5);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[1]->tins[0], b[0], CAKE_FLOW_DUAL_SRC), 5);
+	/* plain cake, no host table: its own count */
+	h->q[0]->tins[0].mq_srcload = NULL;
+	h->q[0]->tins[0].mq_dstload = NULL;
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], a[0], CAKE_FLOW_TRIPLE), 2);
+	cake_mq_set_host_tables(h->q[0], h->hosts);
+
+	/* refills weigh each flow 1/5 of a host */
+	cake_mq_set_weight(&h->q[0]->tins[0], a[1], quantum_div[5]);
+	KUNIT_EXPECT_EQ(test, a[1]->mq_weight, 65535 / 5);
+
+	/* another LAN host's flow next to them: alone at its end, but the
+	 * server's sixth flow (triple-isolate); its own host's only one by
+	 * source alone (dual-srchost)
+	 */
+	other = cake_test_hosts_bulk(test, h, 0, two, 40000);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], other, CAKE_FLOW_TRIPLE), 6);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], other, CAKE_FLOW_DUAL_SRC), 1);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], other, CAKE_FLOW_DUAL_DST), 6);
+
+	/* two of host 5's flows there go: 3 left for the ones here */
+	cake_flow_emptied(h->q[1], &h->q[1]->tins[0], b[0], 0);
+	cake_flow_emptied(h->q[1], &h->q[1]->tins[0], b[1], 0);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], a[0], CAKE_FLOW_DUAL_SRC), 3);
+	KUNIT_EXPECT_EQ(test, b[0]->mq_weight, 0);
+	cake_test_hosts_check(test, h);
+}
+
+/* The host-only modes: a host with a queue in two sub-cakes gets one host's
+ * share between them
+ */
+static void cake_test_mq_host_queues(struct kunit *test)
+{
+	struct cake_test_hosts *h = cake_test_hosts_alloc(test);
+	struct cake_tin_data *b0 = &h->q[0]->tins[0], *b1 = &h->q[1]->tins[0];
+	const int mode = CAKE_FLOW_SRC_IP;
+	struct cake_flow *a, *b, *c;
+	u8 one, two;
+	int i;
+
+	cake_test_two_hosts(test, &one, &two);
+	h->cfg.flow_mode = mode;
+	a = cake_test_hosts_bulk(test, h, 0, one, 40000);
+	b = cake_test_hosts_bulk(test, h, 1, one, 41000);
+	c = cake_test_hosts_bulk(test, h, 0, two, 40000);
+	KUNIT_EXPECT_EQ(test, cake_host_load(b0, a, mode), 2);
+	KUNIT_EXPECT_EQ(test, cake_host_load(b1, b, mode), 2);
+	KUNIT_EXPECT_EQ(test, cake_host_load(b0, c, mode), 1);
+	/* at their next refills, half a host each against a whole one */
+	cake_mq_set_weight(b0, a, quantum_div[cake_host_load(b0, a, mode)]);
+	KUNIT_EXPECT_EQ(test, b0->mq_weight, 65535 / 2 + 65535);
+	b0->flow_quantum = 1514;
+	KUNIT_EXPECT_EQ(test, cake_get_flow_quantum(b0, c, mode), 1514 << CAKE_DEFICIT_SHIFT);
+	KUNIT_EXPECT_EQ(test, cake_get_flow_quantum(b0, a, mode),
+			(1514 * quantum_div[2]) >> (16 - CAKE_DEFICIT_SHIFT));
+
+	/* host 5's queue in sub-cake 1 goes: the one here has it all again */
+	cake_flow_emptied(h->q[1], b1, b, 0);
+	KUNIT_EXPECT_EQ(test, cake_host_load(b0, a, mode), 1);
+	/* plain cake: a queue is a host's, whatever */
+	b0->mq_srcload = NULL;
+	KUNIT_EXPECT_EQ(test, cake_host_load(b0, a, mode), 1);
+	cake_mq_set_host_tables(h->q[0], h->hosts);
+
+	cake_mq_retire_tin(h->q[0], b0, 0);
+	for (i = 0; i < 2 * CAKE_QUEUES; i++)
+		KUNIT_ASSERT_EQ(test, atomic_read(&h->hosts[i]), 0);
+	KUNIT_EXPECT_EQ(test, b0->mq_weight, 0);
+}
+
+/* A host slot taken over by another tag with flows still counted */
+static void cake_test_mq_host_retag(struct kunit *test)
+{
+	atomic_t *load = cake_test_alloc(test, CAKE_QUEUES * sizeof(atomic_t));
+
+	atomic_set(&load[17], 3);
+	cake_mq_host_retag(load, 17 + 5 * CAKE_QUEUES, 600, 3);
+	KUNIT_EXPECT_EQ(test, atomic_read(&load[17]), 0);
+	KUNIT_EXPECT_EQ(test, atomic_read(&load[600]), 3);
+	/* nothing counted, the same tag, or no table: nothing moves */
+	cake_mq_host_retag(load, 600, 17, 0);
+	cake_mq_host_retag(load, 600, 600, 3);
+	cake_mq_host_retag(NULL, 600, 17, 3);
+	KUNIT_EXPECT_EQ(test, atomic_read(&load[600]), 3);
+	KUNIT_EXPECT_EQ(test, atomic_read(&load[17]), 0);
+}
+
+/* A sub-cake out of packets retires its bulk rotation: its flows leave the
+ * host loads and its weight, the other sub-cakes' stay
+ */
+static void cake_test_mq_retire_on_idle(struct kunit *test)
+{
+	struct cake_test_hosts *h = cake_test_hosts_alloc(test);
+	struct cake_tin_data *b = &h->q[2]->tins[0];
+	struct cake_flow *keep;
+	int i;
+
+	keep = cake_test_hosts_bulk(test, h, 0, 5, 40000);
+	for (i = 0; i < 6; i++)
+		cake_test_hosts_bulk(test, h, 2, 5 + i % 2, 42000 + i);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], keep, CAKE_FLOW_DUAL_SRC), 4);
+	KUNIT_EXPECT_NE(test, b->mq_weight, 0);
+
+	cake_mq_retire_tin(h->q[2], b, 0);
+	KUNIT_EXPECT_FALSE(test, cake_bulk_any(b));
+	KUNIT_EXPECT_EQ(test, b->bulk_flow_count, 0);
+	KUNIT_EXPECT_EQ(test, b->mq_weight, 0);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], keep, CAKE_FLOW_DUAL_SRC), 1);
+	KUNIT_EXPECT_NE(test, h->q[0]->tins[0].mq_weight, 0);
+	cake_test_hosts_check(test, h);
+}
+
+/* A sub-cake out of packets keeps its bulk rotation while it sent within
+ * its idle time, its idle watchdog set for up to as long again after that
+ * runs out. While the packets keep coming, a watchdog that still falls in
+ * that range is left alone; one that would go off too soon or too late is
+ * set again. Idle, the sub-cake retires the rotation.
+ */
+static void cake_test_mq_drained(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_mq_q(mq, 2);
+	struct hrtimer *timer = &q->mq_watchdog.timer;
+	/* the real clock: the watchdog is a real timer, cancelled before it fires */
+	u64 now = ktime_get_ns() + NSEC_PER_SEC, ms = NSEC_PER_MSEC;
+	struct cake_tin_data *b;
+	int i;
+
+	mq->cfg->flow_mode = CAKE_FLOW_TRIPLE;
+	mq->cfg->mq_hosts = cake_test_alloc(test, 2 * CAKE_MAX_TINS * CAKE_QUEUES *
+						  sizeof(atomic_t));
+	q->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(*q->tins));
+	q->tin_cnt = 1;
+	b = &q->tins[0];
+	cake_init_flowchains(b);
+	cake_mq_set_host_tables(q, mq->cfg->mq_hosts);
+	qdisc_watchdog_init(&q->watchdog, mq->sch[2]);
+	qdisc_watchdog_init(&q->mq_watchdog, mq->sch[2]);
+	for (i = 0; i < 3; i++)
+		cake_test_bulk_flow(test, b, CAKE_FLOW_TRIPLE, 5, 40000 + i);
+
+	/* between bursts: kept, and the idle watchdog will look again; the
+	 * shaper's is the shaper's
+	 */
+	q->mq_idle = 8 * ms;
+	q->last_active = now;
+	cake_mq_drained(q, now + ms);
+	KUNIT_EXPECT_EQ(test, b->bulk_flow_count, 3);
+	KUNIT_EXPECT_TRUE(test, hrtimer_is_queued(timer));
+	KUNIT_EXPECT_EQ(test, hrtimer_get_expires_tv64(timer), now + 16 * ms);
+	KUNIT_EXPECT_FALSE(test, hrtimer_is_queued(&q->watchdog.timer));
+
+	/* more packets, idle later: the watchdog still falls in time */
+	q->last_active = now + 4 * ms;
+	cake_mq_drained(q, now + 5 * ms);
+	KUNIT_EXPECT_EQ(test, hrtimer_get_expires_tv64(timer), now + 16 * ms);
+	q->last_active = now + 8 * ms;
+	cake_mq_drained(q, now + 8 * ms);
+	KUNIT_EXPECT_EQ(test, hrtimer_get_expires_tv64(timer), now + 16 * ms);
+
+	/* it would go off before the sub-cake is idle: set again */
+	q->last_active = now + 9 * ms;
+	cake_mq_drained(q, now + 9 * ms);
+	KUNIT_EXPECT_EQ(test, hrtimer_get_expires_tv64(timer), now + 25 * ms);
+
+	/* faster packets, a shorter idle time: it would go off too late */
+	q->mq_idle = 2 * ms;
+	q->last_active = now + 10 * ms;
+	cake_mq_drained(q, now + 10 * ms);
+	KUNIT_EXPECT_EQ(test, hrtimer_get_expires_tv64(timer), now + 14 * ms);
+	KUNIT_EXPECT_EQ(test, b->bulk_flow_count, 3);
+	qdisc_watchdog_cancel(&q->mq_watchdog);
+
+	/* idle: retired */
+	cake_mq_drained(q, now + 12 * ms);
+	KUNIT_EXPECT_FALSE(test, cake_bulk_any(b));
+	KUNIT_EXPECT_EQ(test, b->bulk_flow_count, 0);
+	KUNIT_EXPECT_EQ(test, b->mq_weight, 0);
+	for (i = 0; i < 2 * CAKE_QUEUES; i++)
+		KUNIT_ASSERT_EQ(test, atomic_read(&mq->cfg->mq_hosts[i]), 0);
+	KUNIT_EXPECT_FALSE(test, hrtimer_is_queued(timer));
+}
+
+/* A packet from LAN host @host, port @sport, into tin @b as a new flow,
+ * already dequeued: in the sparse rotation, empty, its quantum less @len
+ */
+static struct cake_flow *cake_test_sparse_flow(struct kunit *test,
+					       struct cake_tin_data *b, int mode,
+					       u8 host, u16 sport, int len)
+{
+	struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_UDP, host, sport, 0);
+	struct cake_flow *flow = &b->flows[cake_hash(b, skb, mode, 0, 0)];
+
+	list_add_tail(&flow->flowchain, &b->new_flows);
+	flow->set = CAKE_SET_SPARSE;
+	b->sparse_flow_count++;
+	flow->deficit = 1514 - len;
+	return flow;
+}
+
+/* A sub-cake out of packets lets its new flows go, as the next dequeue
+ * would in one CAKE with other traffic queued: a sparse flow alone on its
+ * sub-cake comes back fresh with its next packet instead of spending its
+ * quantum into the bulk rotation, where its host would count one more
+ * bulk flow in every sub-cake. One whose AQM isn't at rest yet waits with
+ * the decaying flows. The bulk rotation is kept, as between bursts.
+ */
+static void cake_test_mq_drained_sparse(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_mq_q(mq, 1);
+	/* the real clock: the watchdog is a real timer, cancelled before it fires */
+	u64 now = ktime_get_ns() + NSEC_PER_SEC;
+	struct cake_flow *bulk, *sparse, *active;
+	struct cake_tin_data *b;
+	int i;
+
+	mq->cfg->flow_mode = CAKE_FLOW_DUAL_SRC;
+	mq->cfg->mq_hosts = cake_test_alloc(test, 2 * CAKE_MAX_TINS * CAKE_QUEUES *
+						  sizeof(atomic_t));
+	q->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(*q->tins));
+	q->tin_cnt = 1;
+	b = &q->tins[0];
+	cake_init_flowchains(b);
+	cake_mq_set_host_tables(q, mq->cfg->mq_hosts);
+	qdisc_watchdog_init(&q->mq_watchdog, mq->sch[1]);
+
+	bulk = cake_test_bulk_flow(test, b, CAKE_FLOW_DUAL_SRC, 5, 40000);
+	sparse = cake_test_sparse_flow(test, b, CAKE_FLOW_DUAL_SRC, 5, 41000, 100);
+	active = cake_test_sparse_flow(test, b, CAKE_FLOW_DUAL_SRC, 6, 41000, 100);
+	active->cvars.count = 1;
+	active->cvars.drop_next = ns_to_ktime(now + NSEC_PER_SEC);
+
+	q->last_active = now;
+	cake_mq_drained(q, now);
+	KUNIT_EXPECT_TRUE(test, list_empty(&b->new_flows));
+	KUNIT_EXPECT_EQ(test, (int)sparse->set, CAKE_SET_NONE);
+	KUNIT_EXPECT_TRUE(test, list_empty(&sparse->flowchain));
+	KUNIT_EXPECT_EQ(test, (int)active->set, CAKE_SET_DECAYING);
+	KUNIT_EXPECT_EQ(test, b->sparse_flow_count, 0);
+	KUNIT_EXPECT_EQ(test, b->decaying_flow_count, 1);
+	/* the bulk flow stays, and its host counts it alone */
+	KUNIT_EXPECT_EQ(test, b->bulk_flow_count, 1);
+	KUNIT_EXPECT_EQ(test, cake_host_load(b, bulk, CAKE_FLOW_DUAL_SRC), 1);
+	KUNIT_EXPECT_TRUE(test, hrtimer_is_queued(&q->mq_watchdog.timer));
+	qdisc_watchdog_cancel(&q->mq_watchdog);
+
+	/* nothing new: nothing changes */
+	cake_mq_drained(q, now);
+	KUNIT_EXPECT_EQ(test, b->bulk_flow_count, 1);
+	KUNIT_EXPECT_EQ(test, b->decaying_flow_count, 1);
+	qdisc_watchdog_cancel(&q->mq_watchdog);
+	for (i = 0; i < CAKE_QUEUES; i++)
+		KUNIT_ASSERT_LE(test, atomic_read(&mq->cfg->mq_hosts[i]), 1);
+}
+
+static void cake_test_cancel_watchdogs(void *data)
+{
+	struct cake_sched_data *q = data;
+
+	qdisc_watchdog_cancel(&q->watchdog);
+	qdisc_watchdog_cancel(&q->mq_watchdog);
+}
+
+/* Sub-cake @i of @mq, ready for cake_enqueue() and cake_dequeue(): one
+ * tin, a queue per flow, no shaper, its watchdogs cancelled with the test
+ */
+static struct cake_sched_data *cake_test_mq_live(struct kunit *test,
+						 struct cake_test_mq *mq, int i)
+{
+	struct cake_sched_data *q = cake_test_mq_q(mq, i);
+	struct cake_tin_data *b;
+
+	mq->cfg->flow_mode = CAKE_FLOW_FLOWS;
+	mq->cfg->tin_mode = CAKE_DIFFSERV_BESTEFFORT;
+	q->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(*q->tins));
+	q->tin_cnt = 1;
+	q->tin_mode = CAKE_DIFFSERV_BESTEFFORT;
+	q->buffer_limit = ~0;
+	b = &q->tins[0];
+	cake_init_flowchains(b);
+	cake_set_rate(b, 0, 1514, 5 * NSEC_PER_MSEC, 100 * NSEC_PER_MSEC);
+	cake_set_bulk_quantum(mq->cfg, b, 0);
+	b->tin_quantum = 65535;
+	qdisc_watchdog_init(&q->watchdog, mq->sch[i]);
+	qdisc_watchdog_init(&q->mq_watchdog, mq->sch[i]);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_cancel_watchdogs, q));
+	return q;
+}
+
+/* @skb through @sch: in, and out again as the only packet queued. Called
+ * with bottom halves off, where a KUnit check can't report a failure: says
+ * whether it went through.
+ */
+static bool cake_test_through(struct Qdisc *sch, struct sk_buff *skb)
+{
+	struct sk_buff *to_free = NULL;
+
+	qdisc_skb_cb(skb)->pkt_len = skb->len;
+	return cake_enqueue(skb, sch, &to_free) == NET_XMIT_SUCCESS &&
+	       cake_dequeue(sch) == skb && !to_free && !sch->q.qlen;
+}
+
+/* A queue that runs empty sets no watchdog for its decaying flows: woken
+ * with nothing queued, cake_dequeue() returns before it looks at a flow, so
+ * the wakeup did nothing but cost a timer for every packet of a quiet link
+ */
+static void cake_test_empty_no_watchdog(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_mq_live(test, mq, 1);
+	struct sk_buff *one = cake_test_skb(test, false, IPPROTO_UDP, 5, 41000, 0);
+	struct sk_buff *two = cake_test_skb(test, false, IPPROTO_UDP, 6, 41000, 0);
+	struct cake_tin_data *b = &q->tins[0];
+	struct Qdisc *sch = mq->sch[1];
+	bool through[2], empty[2], shaper[2], idle;
+	u32 decaying[3];
+
+	/* as the stack calls a qdisc; the checks wait until it's over */
+	rcu_read_lock_bh();
+	through[0] = cake_test_through(sch, one);
+	/* out of packets: its flow waits with the decaying ones */
+	empty[0] = !cake_dequeue(sch);
+	decaying[0] = b->decaying_flow_count;
+	/* another flow's packet leaves the queue empty with that one decaying */
+	through[1] = cake_test_through(sch, two);
+	decaying[1] = b->decaying_flow_count;
+	shaper[0] = hrtimer_is_queued(&q->watchdog.timer);
+	empty[1] = !cake_dequeue(sch);
+	decaying[2] = b->decaying_flow_count;
+	shaper[1] = hrtimer_is_queued(&q->watchdog.timer);
+	idle = hrtimer_is_queued(&q->mq_watchdog.timer);
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, through[0]);
+	KUNIT_EXPECT_TRUE(test, empty[0]);
+	KUNIT_EXPECT_EQ(test, decaying[0], 1);
+	KUNIT_EXPECT_TRUE(test, through[1]);
+	KUNIT_EXPECT_EQ(test, decaying[1], 1);
+	KUNIT_EXPECT_FALSE(test, shaper[0]);
+	KUNIT_EXPECT_TRUE(test, empty[1]);
+	KUNIT_EXPECT_EQ(test, decaying[2], 2);
+	KUNIT_EXPECT_FALSE(test, shaper[1]);
+	/* no bulk flow to retire: no idle watchdog either */
+	KUNIT_EXPECT_FALSE(test, idle);
+}
+
+/* Any mix of flows going bulk and empty in four sub-cakes, hosts spread
+ * over them: the table always holds what they count, and each tin's
+ * weight is its flows'
+ */
+static void cake_test_mq_host_table_matches(struct kunit *test)
+{
+	struct cake_test_hosts *h = cake_test_hosts_alloc(test);
+	struct rnd_state rnd;
+	int round;
+
+	prandom_seed_state(&rnd, 7610);
+	for (round = 0; round < 3000; round++) {
+		int s = prandom_u32_state(&rnd) % 4;
+		struct cake_tin_data *b = &h->q[s]->tins[0];
+		struct cake_flow *flow = cake_bulk_head(b);
+
+		if (prandom_u32_state(&rnd) % 3 || !flow)
+			cake_test_hosts_bulk(test, h, s, 2 + prandom_u32_state(&rnd) % 20,
+					     40000 + prandom_u32_state(&rnd) % 64);
+		else
+			cake_flow_emptied(h->q[s], b, flow, 0);
+		if (round % 100 == 0)
+			cake_test_hosts_check(test, h);
+	}
+	cake_test_hosts_check(test, h);
+	for (round = 0; round < 4; round++)
+		cake_mq_retire_tin(h->q[round], &h->q[round]->tins[0], 0);
+	cake_test_hosts_check(test, h);
+	for (round = 0; round < 2 * CAKE_QUEUES; round++)
+		KUNIT_ASSERT_EQ(test, atomic_read(&h->hosts[round]), 0);
+}
