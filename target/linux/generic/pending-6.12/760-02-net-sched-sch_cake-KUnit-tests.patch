+/* cake_mq_read_peers() checks last_active/mq_idle before q.qlen: a fresh peer
+ * with qlen == 0 counts as active, an idle peer with qlen == 0 is skipped, and
+ * a peer with stale last_active but qlen > 0 still counts as active.
+ */
+static void cake_test_mq_read_peers_order(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q1 = cake_test_mq_q(mq, 1);
+	struct cake_sched_data *q2 = cake_test_mq_q(mq, 2);
+	struct cake_mq_peers p;
+	u64 now = 100 * NSEC_PER_MSEC;
+
+	cake_test_mq_enqueue(mq, 0);
+	cake_test_mq_enqueue(mq, 1);
+	cake_test_mq_enqueue(mq, 2);
+	q1->mq_idle = CAKE_MQ_TAU;
+	q2->mq_idle = CAKE_MQ_TAU;
+
+	/* q1 fresh (qlen 0), q2 stale (qlen 0) -> only self + q1 count */
+	q1->last_active = now - NSEC_PER_MSEC;
+	mq->sch[1]->q.qlen = 0;
+	q2->last_active = now - 5 * NSEC_PER_MSEC;
+	mq->sch[2]->q.qlen = 0;
+	cake_test_mq_peers(mq, 0, now, &p);
+	KUNIT_EXPECT_EQ(test, p.count, 2U);
+
+	/* q2 stale but has a packet queued -> counted */
+	mq->sch[2]->q.qlen = 1;
+	cake_test_mq_peers(mq, 0, now, &p);
+	KUNIT_EXPECT_EQ(test, p.count, 3U);
+	mq->sch[2]->q.qlen = 0;
+}
