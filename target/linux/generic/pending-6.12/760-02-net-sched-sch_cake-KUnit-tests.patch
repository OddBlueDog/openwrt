+/* cake_mq: a sparse flow whose packet was larger than its quantum, let go
+ * as its sub-cake drains, rests; the dequeues after that don't send it
+ * round the bulk rotation empty, counted in the sub-cake's bid
+ */
+static void cake_test_mq_drained_rests(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_mq_live(test, mq, 1);
+	struct cake_tin_data *b = &q->tins[0];
+	struct Qdisc *sch = mq->sch[1];
+	bool ok = true, rests[2], wheel = false;
+	struct sk_buff *s, *y[3];
+	u32 weight = 0;
+	struct cake_flow *fs;
+	int i;
+
+	cake_test_pkts(test, &s, 1, 5, 4000);
+	cake_test_pkts(test, y, 3, 6, 100);
+
+	rcu_read_lock_bh();
+	ok &= cake_test_in(sch, s);
+	fs = list_first_entry(&b->new_flows, struct cake_flow, flowchain);
+	ok &= cake_test_out(sch, s);
+	ok &= !cake_dequeue(sch);
+	rests[0] = fs->set == CAKE_SET_DECAYING && b->resting_flows.next == &fs->flowchain &&
+		   fs->deficit < 0;
+	for (i = 0; i < 3; i++)
+		ok &= cake_test_in(sch, y[i]);
+	for (i = 0; i < 3; i++) {
+		ok &= cake_test_out(sch, y[i]);
+		wheel |= cake_bulk_any(b);
+		weight |= b->mq_weight;
+	}
+	rests[1] = b->resting_flows.next == &fs->flowchain;
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_TRUE(test, rests[0]);
+	KUNIT_EXPECT_TRUE(test, rests[1]);
+	KUNIT_EXPECT_FALSE(test, wheel);
+	KUNIT_EXPECT_EQ(test, weight, 0);
+}
