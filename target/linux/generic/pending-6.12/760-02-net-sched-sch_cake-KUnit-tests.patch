+/* sparse_ahead_us acts only on what came in through a device's ingress */
+#ifdef CONFIG_NET_REDIRECT
+static void cake_test_ahead_back(void *old)
+{
+	WRITE_ONCE(sparse_ahead_us, (unsigned long)old);
+}
+
+/* sparse_ahead_us at @us for the test, as it was after it */
+static void cake_test_ahead_set(struct kunit *test, unsigned int us)
+{
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_ahead_back,
+							   (void *)(unsigned long)READ_ONCE(sparse_ahead_us)));
+	WRITE_ONCE(sparse_ahead_us, us);
+}
+
+/* @n packets as cake_test_pkts() makes them, in through a device's
+ * ingress (an ifb) when @ingress
+ */
+static void cake_test_dl_pkts(struct kunit *test, struct sk_buff **skb, int n, u8 host,
+			      u32 len, bool ingress)
+{
+	int i;
+
+	cake_test_pkts(test, skb, n, host, len);
+	for (i = 0; i < n; i++) {
+		skb[i]->redirected = ingress;
+		skb[i]->from_ingress = ingress;
+	}
+}
+
+/* At 1 Mbit/s, so that an MTU-sized packet holds the shaper 12 ms: while it
+ * holds a download's bulk flow back, a new flow's packet goes at once with
+ * sparse_ahead_us set (20 ms here), and waits with it 0. A bulk packet
+ * waits either way, as does an upload's packet (not in through an ifb).
+ * The packet that goes is charged to the shaper as any packet is.
+ */
+static void cake_test_sparse_ahead(struct kunit *test)
+{
+	int on;
+
+	for (on = 0; on < 2; on++) {
+		struct cake_test_mq *mq = cake_test_mq_alloc(test);
+		struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 125000,
+								CAKE_DIFFSERV_BESTEFFORT);
+		struct Qdisc *sch = mq->sch[0];
+		struct sk_buff *bulk[3], *s, *e;
+		bool ok = true, held[3], early, charged;
+		u64 tn, dur = (100 * q->rate_ns) >> q->rate_shft;
+		int i;
+
+		cake_test_ahead_set(test, on ? 20000 : 0);
+		cake_test_dl_pkts(test, bulk, 3, 5, 1514, true);
+		cake_test_dl_pkts(test, &s, 1, 6, 100, true);
+		cake_test_dl_pkts(test, &e, 1, 7, 100, false);
+		KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+		rcu_read_lock_bh();
+		for (i = 0; i < 3; i++)
+			ok &= cake_test_in(sch, bulk[i]);
+		ok &= cake_test_out(sch, bulk[0]);
+		/* the bulk flow waits */
+		held[0] = !cake_dequeue(sch);
+		ok &= cake_test_in(sch, s);
+		tn = ktime_to_ns(q->time_next_packet);
+		early = cake_test_out(sch, s);
+		charged = ktime_to_ns(q->time_next_packet) == tn + dur;
+		/* an upload's packet waits */
+		ok &= cake_test_in(sch, e);
+		held[1] = !cake_dequeue(sch);
+		/* the bulk packets and the upload's still queued */
+		held[2] = sch->q.qlen == (early ? 3 : 4);
+		rcu_read_unlock_bh();
+
+		KUNIT_EXPECT_TRUE(test, ok);
+		KUNIT_EXPECT_TRUE_MSG(test, held[0], "on %d", on);
+		KUNIT_EXPECT_TRUE_MSG(test, held[1], "on %d", on);
+		KUNIT_EXPECT_TRUE_MSG(test, held[2], "on %d", on);
+		KUNIT_EXPECT_EQ_MSG(test, early, (bool)on, "on %d", on);
+		if (on)
+			KUNIT_EXPECT_TRUE(test, charged);
+	}
+}
+
+/* A train of new flows' packets, each 4 ms at the rate, while the shaper
+ * holds for 12 ms with 20 ms allowed: they go early only until the shaper
+ * is 20 ms ahead, and then wait like the rest
+ */
+static void cake_test_sparse_ahead_train(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 125000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	struct Qdisc *sch = mq->sch[0];
+	u64 dur = (500 * q->rate_ns) >> q->rate_shft, left0 = 0, left = 0;
+	struct sk_buff *bulk[2], *s[6];
+	u32 early = 0;
+	bool ok = true;
+	int i;
+
+	cake_test_ahead_set(test, 20000);
+	cake_test_dl_pkts(test, bulk, 2, 5, 1514, true);
+	for (i = 0; i < 6; i++)
+		cake_test_dl_pkts(test, &s[i], 1, 10 + i, 500, true);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	rcu_read_lock_bh();
+	for (i = 0; i < 2; i++)
+		ok &= cake_test_in(sch, bulk[i]);
+	ok &= cake_test_out(sch, bulk[0]);
+	for (i = 0; i < 6; i++)
+		ok &= cake_test_in(sch, s[i]);
+	left0 = ktime_to_ns(q->time_next_packet) - ktime_get_ns();
+	for (i = 0; i < 6; i++) {
+		struct sk_buff *out = cake_dequeue(sch);
+
+		if (!out)
+			break;
+		ok &= out == s[i];
+		kfree_skb(out);
+		early++;
+	}
+	left = ktime_to_ns(q->time_next_packet) - ktime_get_ns();
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	kunit_info(test, "shaper %llu us ahead, %u went early, then %llu us ahead",
+		   div_u64(left0, 1000), early, div_u64(left, 1000));
+	KUNIT_EXPECT_GE(test, early, 1);
+	KUNIT_EXPECT_LT(test, early, 6);
+	/* never more than the allowance and a packet ahead */
+	KUNIT_EXPECT_LE(test, left, 20 * NSEC_PER_MSEC + dur);
+	/* and stopped only when the next would have gone past it */
+	KUNIT_EXPECT_GT(test, left, 20 * NSEC_PER_MSEC - dur);
+}
+
+/* 10 ms at 50 Mbit/s of a download's bulk flow, a new flow's small packet
+ * every 1 ms, sparse_ahead_us 0 then 1000: as many bytes go either way, to
+ * within what the allowance and a packet let through early, and what each
+ * run's longest pause between dequeues held back at its end. Short: the
+ * suite runs each time the module loads.
+ */
+static void cake_test_sparse_ahead_rate(struct kunit *test)
+{
+	const u64 rate = 6250000;	/* bytes/s */
+	u64 sent[2] = {}, gap[2] = {};
+	int on;
+
+	for (on = 0; on < 2; on++) {
+		struct cake_test_mq *mq = cake_test_mq_alloc(test);
+		struct Qdisc *sch = mq->sch[0];
+		u64 start, next_sparse, end, last;
+		int host = 0;
+
+		cake_test_cake_live(test, mq, 0, rate, CAKE_DIFFSERV_BESTEFFORT);
+		cake_test_ahead_set(test, on ? 1000 : 0);
+		KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+		start = ktime_get_ns();
+		next_sparse = start;
+		end = start + 10 * NSEC_PER_MSEC;
+		last = start;
+		while (ktime_get_ns() < end) {
+			struct sk_buff *in[2], *out;
+			int n = 0;
+			u64 now;
+
+			/* the bulk flow never runs out; a sparse packet every 1 ms */
+			if (sch->q.qlen < 4)
+				cake_test_dl_pkts(test, &in[n++], 1, 5, 1514, true);
+			if (ktime_get_ns() >= next_sparse) {
+				cake_test_dl_pkts(test, &in[n++], 1, 20 + host++ % 40, 200, true);
+				next_sparse += NSEC_PER_MSEC;
+			}
+			rcu_read_lock_bh();
+			while (n)
+				cake_test_in(sch, in[--n]);
+			out = cake_dequeue(sch);
+			if (out)
+				sent[on] += qdisc_pkt_len(out);
+			kfree_skb(out);
+			rcu_read_unlock_bh();
+			now = ktime_get_ns();
+			gap[on] = max(gap[on], now - last);
+			last = now;
+			udelay(10);
+		}
+		kunit_info(test, "sparse_ahead_us %d: %llu bytes in 10 ms, longest pause %llu us",
+			   on ? 1000 : 0, sent[on], div_u64(gap[on], 1000));
+	}
+	/* 1 ms at the rate, a packet either way at the end, and the pauses */
+	KUNIT_EXPECT_LE(test, abs_diff(sent[0], sent[1]),
+			div_u64(rate, 1000) + 2 * 1514 +
+			div_u64(rate * (gap[0] + gap[1]), NSEC_PER_SEC));
+}
+
+/* cake_mq: a sub-cake whose packet goes ahead of its shaper still counts as
+ * held back, and the packet counts as sent, and as a sparse flow's
+ */
+static void cake_test_sparse_ahead_mq(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_mq_live(test, mq, 1);
+	struct Qdisc *sch = mq->sch[1];
+	struct sk_buff *bulk[2], *s;
+	u64 before, held_at, bytes, sparse;
+	bool ok = true, early;
+	int i;
+
+	cake_test_ahead_set(test, 20000);
+	mq->cfg->rate_bps = 125000;
+	mq->cfg->sync_time = 200 * NSEC_PER_USEC;
+	cake_configure_rates(sch, 125000, true);
+	q->synced_rate = 125000;
+	cake_test_dl_pkts(test, bulk, 2, 5, 1514, true);
+	cake_test_dl_pkts(test, &s, 1, 6, 100, true);
+
+	before = ktime_get_ns();
+	/* as __dev_queue_xmit() runs a qdisc: the resync reads the other
+	 * sub-cakes under rcu_read_lock_bh()
+	 */
+	rcu_read_lock_bh();
+	for (i = 0; i < 2; i++)
+		ok &= cake_test_in(sch, bulk[i]);
+	ok &= cake_test_out(sch, bulk[0]);
+	ok &= cake_test_in(sch, s);
+	q->mq_bytes = 0;
+	q->mq_sparse_bytes = 0;
+	q->mq_held_at = 0;
+	early = cake_test_out(sch, s);
+	held_at = q->mq_held_at;
+	bytes = q->mq_bytes;
+	sparse = q->mq_sparse_bytes;
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	KUNIT_EXPECT_TRUE(test, early);
+	KUNIT_EXPECT_GE(test, held_at, before);
+	KUNIT_EXPECT_EQ(test, bytes, 100);
+	KUNIT_EXPECT_EQ(test, sparse, 100);
+	/* the bulk packet left, as the test ends */
+	rcu_read_lock_bh();
+	cake_clear_tin(sch, 0);
+	rcu_read_unlock_bh();
+}
+
+/* sparse_ahead_us in ingress mode, COBALT dropping the packet that was to
+ * go ahead (BLUE at its highest drops all of a flow's packets but its
+ * last): the drop is charged to the shaper, which then holds all the more,
+ * so the dequeue looks ahead again and the flow's next packet goes, the
+ * bulk flow still held. It can't go on to the bulk flows with its look
+ * ahead left over from the drop: the time it holds to and the failsafe
+ * haven't moved. Then, the shaper due, a bulk packet COBALT drops is
+ * followed by the flow's next one, as ever.
+ */
+static void cake_test_sparse_ahead_drop(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 125000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	u64 dur = (100 * q->rate_ns) >> q->rate_shft, tn[2];
+	struct cake_tin_data *b = &q->tins[0];
+	struct cake_flow *sflow, *bflow;
+	struct Qdisc *sch = mq->sch[0];
+	struct sk_buff *bulk[3], *s[2], *out[2];
+	u32 drops[3], qlen[2];
+	bool ok = true;
+	ktime_t now;
+	int i;
+
+	cake_test_ahead_set(test, 20000);
+	q->config->rate_flags |= CAKE_FLAG_INGRESS;
+	cake_test_dl_pkts(test, bulk, 3, 5, 1514, true);
+	cake_test_dl_pkts(test, s, 2, 6, 100, true);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	rcu_read_lock_bh();
+	for (i = 0; i < 3; i++)
+		ok &= cake_test_in(sch, bulk[i]);
+	/* the shaper holds the next 12 ms */
+	ok &= cake_test_out(sch, bulk[0]);
+	for (i = 0; i < 2; i++)
+		ok &= cake_test_in(sch, s[i]);
+	sflow = cake_test_flow_of(b, s[0]);
+	bflow = cake_test_flow_of(b, bulk[1]);
+	ok &= sflow && bflow;
+	if (ok) {
+		sflow->cvars.p_drop = U32_MAX;
+		drops[0] = sch->qstats.drops;
+		tn[0] = ktime_to_ns(q->time_next_packet);
+		out[0] = cake_dequeue(sch);
+		tn[1] = ktime_to_ns(q->time_next_packet);
+		drops[1] = sch->qstats.drops;
+		qlen[0] = sch->q.qlen;
+		/* the shaper due: the bulk flow's next packet dropped, its last sent */
+		bflow->cvars.p_drop = U32_MAX;
+		now = ktime_get();
+		q->time_next_packet = now;
+		q->failsafe_next_packet = now;
+		out[1] = cake_dequeue(sch);
+		drops[2] = sch->qstats.drops;
+		qlen[1] = sch->q.qlen;
+	}
+	rcu_read_unlock_bh();
+
+	KUNIT_ASSERT_TRUE(test, ok);
+	KUNIT_EXPECT_PTR_EQ(test, out[0], s[1]);
+	KUNIT_EXPECT_EQ(test, drops[1], drops[0] + 1);
+	KUNIT_EXPECT_EQ(test, qlen[0], 2);
+	/* both of its packets charged: the one dropped, the one sent */
+	KUNIT_EXPECT_EQ(test, tn[1], tn[0] + 2 * dur);
+	KUNIT_EXPECT_PTR_EQ(test, out[1], bulk[2]);
+	KUNIT_EXPECT_EQ(test, drops[2], drops[1] + 1);
+	KUNIT_EXPECT_EQ(test, qlen[1], 0);
+	kfree_skb(out[0]);
+	kfree_skb(out[1]);
+}
+#endif
