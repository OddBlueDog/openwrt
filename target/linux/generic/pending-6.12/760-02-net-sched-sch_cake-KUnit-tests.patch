+/* cake_mq_rescale_wait() caps before scaling so large ratios return now + 1 s
+ * without overflowing the 64-bit quotient.
+ */
+static void cake_test_mq_rescale_wait_overflow(struct kunit *test)
+{
+	const ktime_t now = 10 * NSEC_PER_SEC;
+
+	KUNIT_EXPECT_EQ(test,
+			cake_mq_rescale_wait(now + 1000 * NSEC_PER_SEC, now,
+					     1ULL << 62, 1),
+			now + NSEC_PER_SEC);
+	KUNIT_EXPECT_EQ(test,
+			cake_mq_rescale_wait(now + 100 * NSEC_PER_MSEC, now,
+					     1ULL << 62, 1ULL << 61),
+			now + 200 * NSEC_PER_MSEC);
+	KUNIT_EXPECT_EQ(test,
+			cake_mq_rescale_wait(now + 600 * NSEC_PER_MSEC, now,
+					     1ULL << 62, 1ULL << 61),
+			now + NSEC_PER_SEC);
+	KUNIT_EXPECT_EQ(test,
+			cake_mq_rescale_wait(now + 50 * NSEC_PER_MSEC, now, 0, 1000),
+			now);
+	KUNIT_EXPECT_EQ(test,
+			cake_mq_rescale_wait(now + 666666666, now, 3, 2),
+			now + 999999999);
+	KUNIT_EXPECT_EQ(test,
+			cake_mq_rescale_wait(now + 666666667, now, 3, 2),
+			now + NSEC_PER_SEC);
+}
