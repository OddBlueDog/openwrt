+/* The watchdog wakes no earlier than the shaper's next packet and at most
+ * the slack after it: an hrtimer set for that range
+ */
+static void cake_test_wake_slack(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_mq_q(mq, 0);
+	u64 at = ktime_get_ns() + 10 * NSEC_PER_SEC;
+
+	qdisc_watchdog_init(&q->watchdog, mq->sch[0]);
+	WRITE_ONCE(wake_slack_us, 100);
+	cake_watchdog(q, at);
+	KUNIT_EXPECT_TRUE(test, hrtimer_is_queued(&q->watchdog.timer));
+	KUNIT_EXPECT_EQ(test, hrtimer_get_softexpires_tv64(&q->watchdog.timer), at);
+	KUNIT_EXPECT_EQ(test, hrtimer_get_expires_tv64(&q->watchdog.timer), at + 100 * NSEC_PER_USEC);
+
+	/* a later hold wanting it within the range leaves it be */
+	cake_watchdog(q, at - 50 * NSEC_PER_USEC);
+	KUNIT_EXPECT_EQ(test, hrtimer_get_softexpires_tv64(&q->watchdog.timer), at);
+
+	/* on time: no slack */
+	WRITE_ONCE(wake_slack_us, 0);
+	cake_watchdog(q, at - NSEC_PER_MSEC);
+	KUNIT_EXPECT_EQ(test, hrtimer_get_softexpires_tv64(&q->watchdog.timer), at - NSEC_PER_MSEC);
+	KUNIT_EXPECT_EQ(test, hrtimer_get_expires_tv64(&q->watchdog.timer), at - NSEC_PER_MSEC);
+	qdisc_watchdog_cancel(&q->watchdog);
+}
+
+struct cake_test_shaped {
+	u32 wakeups;
+	u64 span;	/* first send to the last */
+	s64 early;	/* the most a packet went ahead of its schedule */
+	s64 late;	/* ... and behind it */
+};
+
+/* A backlogged shaper as qdisc runs drive it: each run sends what's due,
+ * and the watchdog, woken @slack after the next packet is due (the latest
+ * the hrtimer may fire), starts the next run. @n packets of @len bytes at
+ * @rate bytes/s.
+ */
+static struct cake_test_shaped cake_test_shape(struct kunit *test, u64 rate,
+					       u32 len, u32 n, u64 slack)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	struct cake_tin_data *b = cake_test_alloc(test, sizeof(*b));
+	struct sk_buff *skb = alloc_skb(0, GFP_KERNEL);
+	struct cake_test_shaped r = {};
+	ktime_t now = CAKE_TEST_NOW, last = now;
+	u32 sent = 0;
+
+	KUNIT_ASSERT_NOT_NULL(test, skb);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_free_skb, skb));
+	get_cobalt_cb(skb)->adjusted_len = len;
+	q->config = cake_test_alloc(test, sizeof(*q->config));
+	cake_set_rate(b, rate, 1514, 5 * NSEC_PER_MSEC, 100 * NSEC_PER_MSEC);
+	q->rate_ns = b->tin_rate_ns;
+	q->rate_shft = b->tin_rate_shft;
+	q->time_next_packet = now;
+	q->failsafe_next_packet = now;
+
+	while (sent < n) {
+		r.wakeups++;
+		/* cake_dequeue()'s hard shaper */
+		while (sent < n && !(ktime_after(q->time_next_packet, now) &&
+				     ktime_after(q->failsafe_next_packet, now))) {
+			s64 ahead = ktime_to_ns(q->time_next_packet) - ktime_to_ns(now);
+
+			r.early = max(r.early, ahead);
+			r.late = max(r.late, -ahead);
+			cake_advance_shaper(q, b, skb, now, false);
+			last = now;
+			sent++;
+		}
+		now = ktime_add_ns(min(q->time_next_packet, q->failsafe_next_packet), slack);
+	}
+	r.span = ktime_to_ns(last) - CAKE_TEST_NOW;
+	return r;
+}
+
+/* Woken late, a run sends every packet that came due: at 500 Mbit/s a
+ * 1514-byte packet takes ~24 us, so 100 us of slack sends five a wakeup.
+ * No packet leaves early or more than the slack late, so the rate holds and
+ * none is lost. Slack shorter than a packet's time (cake_mq's share of 800
+ * Mbit/s, GRO packets of 9000 bytes: 270 us) saves nothing.
+ */
+static void cake_test_wake_slack_batches(struct kunit *test)
+{
+	u64 rate = 62500000, pkt = div64_u64(1514ULL * NSEC_PER_SEC, rate);
+	u64 slack = 100 * NSEC_PER_USEC;
+	u32 n = 3000;
+	struct cake_test_shaped r;
+
+	r = cake_test_shape(test, rate, 1514, n, 0);
+	KUNIT_EXPECT_EQ(test, r.wakeups, n);
+	KUNIT_EXPECT_EQ(test, r.early, 0);
+	KUNIT_EXPECT_EQ(test, r.late, 0);
+
+	r = cake_test_shape(test, rate, 1514, n, slack);
+	KUNIT_EXPECT_GE(test, r.wakeups, n / 5);
+	KUNIT_EXPECT_LE(test, r.wakeups, n / 5 + 1);
+	KUNIT_EXPECT_EQ(test, r.early, 0);
+	KUNIT_EXPECT_LE(test, r.late, slack);
+	KUNIT_EXPECT_GE(test, r.span, (n - 1) * (pkt - 1));
+	KUNIT_EXPECT_LE(test, r.span, (n - 1) * (pkt + 1) + slack);
+
+	r = cake_test_shape(test, 100000000 / 3, 9000, n, slack);
+	KUNIT_EXPECT_EQ(test, r.wakeups, n);
+}
+
+/* The module's parameters as it was loaded with them, put back after each
+ * test: each test starts from the defaults, whatever the module was loaded
+ * with, and one that stops at a failed assertion leaves nothing changed.
+ */
+static struct {
+	unsigned int ecn_fail_count, l4s_ramp, sparse_ahead_us, wake_slack_us;
+	bool dscp_restore;
+} cake_test_params;
+
+/* COBALT's signals for one flow, each when it comes due: the flow's
+ * packets wait @sojourn and carry the ECN codepoint @ecn.
+ */
+struct cake_test_ecn {
+	struct cobalt_vars v;
+	struct cobalt_params p;
+	ktime_t now;
+	u32 marks, drops;
+	u32 bulk_flows;
+};
+
+static void cake_test_ecn_init(struct cake_test_ecn *e)
+{
+	memset(e, 0, sizeof(*e));
+	e->p.target = 2500 * NSEC_PER_USEC;	/* rtt 50ms */
+	e->p.interval = 50 * NSEC_PER_MSEC;
+	e->p.mtu_time = 12 * NSEC_PER_USEC;	/* 1514 bytes at ~1 Gbit/s */
+	e->p.share_mtu_time = e->p.mtu_time;
+	e->now = CAKE_TEST_NOW;
+	e->bulk_flows = 1;
+}
+
+static void cake_test_ecn_set(struct sk_buff *skb, u8 ecn)
+{
+	if (skb->protocol == htons(ETH_P_IPV6))
+		ipv6_change_dsfield(ipv6_hdr(skb), (u8)~INET_ECN_MASK, ecn);
+	else
+		ipv4_change_dsfield(ip_hdr(skb), (u8)~INET_ECN_MASK, ecn);
+}
+
+/* @n signals; returns how many were drops */
+static u32 cake_test_ecn_run(struct cake_test_ecn *e, struct sk_buff *skb,
+			     u8 ecn, u64 sojourn, u32 n)
+{
+	u32 drops = 0, signals = 0, calls = 0;
+
+	while (signals < n && calls++ < 4 * n + 4) {
+		bool drop;
+
+		cake_test_ecn_set(skb, ecn);
+		/* the next signal is due at drop_next; the first sets it */
+		e->now = e->v.count ? max(ktime_add_ns(e->now, 1), e->v.drop_next) :
+				      ktime_add_ns(e->now, NSEC_PER_MSEC);
+		cobalt_set_enqueue_time(skb, ktime_sub_ns(e->now, sojourn));
+		drop = cobalt_should_drop(&e->v, &e->p, e->now, skb, 1, e->bulk_flows);
+		if (drop || e->v.ecn_marked)
+			signals++;
+		drops += drop;
+		e->drops += drop;
+		e->marks += e->v.ecn_marked;
+	}
+	return drops;
+}
+
+/* An ECT(0) flow far over target (20 ms) is marked, not dropped, until its
+ * count reaches ecn_fail_count (@fail, set) and it has stayed over twice the
+ * target for COBALT_ECN_STRIKES more signals; from then on its packets are
+ * dropped, from the drop rate a count of ecn_fail_count gives (1/sqrt exact).
+ */
+static void cake_test_ecn_switch_at(struct kunit *test, u32 fail)
+{
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_TCP, 2, 40000, 0);
+	struct cake_test_ecn e;
+	u32 drops, want;
+
+	cake_test_ecn_init(&e);
+	drops = cake_test_ecn_run(&e, skb, INET_ECN_ECT_0, 20 * NSEC_PER_MSEC,
+				  fail + COBALT_ECN_STRIKES - 2);
+	KUNIT_EXPECT_EQ(test, drops, 0);
+	KUNIT_EXPECT_FALSE(test, e.v.ecn_ignored);
+	KUNIT_EXPECT_EQ(test, e.marks, fail + COBALT_ECN_STRIKES - 2);
+
+	drops = cake_test_ecn_run(&e, skb, INET_ECN_ECT_0, 20 * NSEC_PER_MSEC, 1);
+	KUNIT_EXPECT_EQ(test, drops, 1);
+	KUNIT_EXPECT_TRUE(test, e.v.ecn_ignored);
+	KUNIT_EXPECT_FALSE(test, e.v.ecn_marked);
+	/* restarted at ecn_fail_count, plus this signal */
+	KUNIT_EXPECT_EQ(test, e.v.count, fail + 1);
+	/* 2^32 / sqrt(count), within 0.2%: from the cache under
+	 * REC_INV_SQRT_CACHE, else one Newton iteration from count's, as in
+	 * COBALT, off by about 3 / (8 * count^2)
+	 */
+	want = int_sqrt64(div64_u64(U64_MAX, fail + 1));
+	KUNIT_EXPECT_LE(test, abs((s64)e.v.rec_inv_sqrt - (s64)want), (s64)(want >> 9));
+
+	/* and stays dropped */
+	drops = cake_test_ecn_run(&e, skb, INET_ECN_ECT_0, 20 * NSEC_PER_MSEC, 100);
+	KUNIT_EXPECT_EQ(test, drops, 100);
+	/* the packet left as it came: ECT(0), not CE */
+	KUNIT_EXPECT_EQ(test, ipv6_get_dsfield(ipv6_hdr(skb)) & INET_ECN_MASK, INET_ECN_ECT_0);
+}
+
+/* At the module's count, and at 256: a restart past the 1/sqrt cache, which
+ * cobalt_set_count() works out by Newton iterations
+ */
+static void cake_test_ecn_ignored_switches(struct kunit *test)
+{
+	u32 fail = READ_ONCE(ecn_fail_count);
+
+	cake_test_ecn_switch_at(test, fail);
+	WRITE_ONCE(ecn_fail_count, 256);
+	cake_test_ecn_switch_at(test, 256);
+	WRITE_ONCE(ecn_fail_count, fail);
+}
+
+/* The same over IPv4 */
+static void cake_test_ecn_ignored_ipv4(struct kunit *test)
+{
+	struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_TCP, 2, 40000, 0);
+	struct cake_test_ecn e;
+	u32 fail = READ_ONCE(ecn_fail_count);
+
+	ip_send_check(ip_hdr(skb));
+	cake_test_ecn_init(&e);
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_0, 20 * NSEC_PER_MSEC,
+						fail + COBALT_ECN_STRIKES - 2), 0);
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_0, 20 * NSEC_PER_MSEC, 50), 50);
+	KUNIT_EXPECT_TRUE(test, e.v.ecn_ignored);
+	KUNIT_EXPECT_EQ(test, ip_fast_csum((u8 *)ip_hdr(skb), ip_hdr(skb)->ihl), 0);
+}
+
+/* ECT(1) (L4S) is always marked, however long the flow ignores it */
+static void cake_test_ecn_l4s_marked(struct kunit *test)
+{
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_TCP, 2, 40000, 0);
+	u32 ramp = READ_ONCE(l4s_ramp);
+	struct cake_test_ecn e;
+
+	WRITE_ONCE(l4s_ramp, 0);
+	cake_test_ecn_init(&e);
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_1, 200 * NSEC_PER_MSEC,
+						4 * READ_ONCE(ecn_fail_count)), 0);
+	KUNIT_EXPECT_FALSE(test, e.v.ecn_ignored);
+	KUNIT_EXPECT_EQ(test, e.marks, 4 * READ_ONCE(ecn_fail_count));
+	WRITE_ONCE(l4s_ramp, ramp);
+}
+
+/* Under the ramp, ECT(1) that stays over twice the ramp's end (here 2.5 to 5 ms,
+ * so 10 ms) is dropped as ECT(0) would be, and a queue up to it is only marked
+ */
+static void cake_test_ecn_l4s_ignored(struct kunit *test)
+{
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_UDP, 2, 40000, 0);
+	u32 fail = READ_ONCE(ecn_fail_count);
+	struct cake_test_ecn e;
+
+	cake_test_ecn_init(&e);
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_1, 10 * NSEC_PER_MSEC,
+						4 * fail + 4 * COBALT_ECN_STRIKES), 0);
+	KUNIT_EXPECT_FALSE(test, e.v.ecn_ignored);
+
+	cake_test_ecn_init(&e);
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_1, 11 * NSEC_PER_MSEC,
+						fail + COBALT_ECN_STRIKES - 2), 0);
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_1, 11 * NSEC_PER_MSEC, 50), 50);
+	KUNIT_EXPECT_TRUE(test, e.v.ecn_ignored);
+	/* dropped as it came, not marked */
+	KUNIT_EXPECT_EQ(test, ipv6_get_dsfield(ipv6_hdr(skb)) & INET_ECN_MASK, INET_ECN_ECT_1);
+}
+
+/* That bar moves with the ramp, and with the bulk flows: 300 of them at 12 us a
+ * packet start the ramp at 7.2 ms, so a wait of 20 ms is still no sign of
+ * ignored marks, nor is one of 15 ms when the ramp starts at twice the target
+ */
+static void cake_test_ecn_l4s_ignored_moves(struct kunit *test)
+{
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_UDP, 2, 40000, 0);
+	u32 fail = READ_ONCE(ecn_fail_count), ramp = READ_ONCE(l4s_ramp);
+	struct cake_test_ecn e;
+
+	cake_test_ecn_init(&e);
+	e.bulk_flows = 300;
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_1, 20 * NSEC_PER_MSEC,
+						4 * fail + 4 * COBALT_ECN_STRIKES), 0);
+	cake_test_ecn_init(&e);
+	e.bulk_flows = 300;
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_1, 29 * NSEC_PER_MSEC,
+						fail + COBALT_ECN_STRIKES - 2), 0);
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_1, 29 * NSEC_PER_MSEC, 1), 1);
+
+	WRITE_ONCE(l4s_ramp, 200);
+	cake_test_ecn_init(&e);
+	KUNIT_EXPECT_EQ(test, cake_test_ecn_run(&e, skb, INET_ECN_ECT_1, 15 * NSEC_PER_MSEC,
+						4 * fail + 4 * COBALT_ECN_STRIKES), 0);
+	WRITE_ONCE(l4s_ramp, ramp);
+}
+
+/* How often of @n tries the ramp marks a packet of @len adjusted bytes and the
+ * ECN codepoint @ecn that waited @sojourn_us, each try's packet reset first;
+ * each mark must leave CE.
+ */
+static u32 cake_test_l4s_marks(struct kunit *test, struct cake_tin_data *b, struct sk_buff *skb,
+			       u8 ecn, u32 len, u64 sojourn_us, bool last, u32 n)
+{
+	ktime_t now = CAKE_TEST_NOW;
+	u32 i, marks = 0;
+
+	get_cobalt_cb(skb)->adjusted_len = len;
+	cobalt_set_enqueue_time(skb, ktime_sub_ns(now, sojourn_us * NSEC_PER_USEC));
+	for (i = 0; i < n; i++) {
+		bool marked;
+
+		cake_test_ecn_set(skb, ecn);
+		marked = cake_l4s_mark(b, skb, now, last);
+		KUNIT_EXPECT_EQ(test, cobalt_ecn(skb), marked ? INET_ECN_CE : ecn);
+		marks += marked;
+	}
+	return marks;
+}
+
+static struct cake_tin_data *cake_test_l4s_tin(struct kunit *test, u64 mbit, u16 bulk, u64 target_ms)
+{
+	struct cake_tin_data *b = kunit_kzalloc(test, sizeof(*b), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	cake_set_rate(b, mbit * 1000000 / 8, 1514, target_ms * NSEC_PER_MSEC, 20 * target_ms * NSEC_PER_MSEC);
+	b->bulk_flow_count = bulk;
+	return b;
+}
+
+/* A slow link and many bulk flows put the ramp's start past U32_MAX ns
+ * (4.3 s): 400 flows at 1 Mbit/s start it at 9.7 s for a full-size packet.
+ * Half way up the ramp, about half the packets are marked, as at any other
+ * start: not all of them, as when the random number's range stopped at
+ * U32_MAX and what was over the start didn't.
+ */
+static void cake_test_l4s_ramp_long(struct kunit *test)
+{
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_UDP, 2, 40000, 0);
+	struct cake_tin_data *b = cake_test_l4s_tin(test, 1, 400, 5);
+	u32 marks;
+
+	KUNIT_EXPECT_EQ(test, cake_test_l4s_marks(test, b, skb, INET_ECN_ECT_1, 1514, 9600000,
+						  false, 100), 0);
+	marks = cake_test_l4s_marks(test, b, skb, INET_ECN_ECT_1, 1514, 14534400, false, 1000);
+	KUNIT_EXPECT_GT(test, marks, 400);
+	KUNIT_EXPECT_LT(test, marks, 600);
+	KUNIT_EXPECT_EQ(test, cake_test_l4s_marks(test, b, skb, INET_ECN_ECT_1, 1514, 19500000,
+						  false, 100), 100);
+}
+
+/* On a fast link with one flow: nothing to the target (5 ms), everything from
+ * twice it, and in proportion between them, IPv6 and IPv4 (a mark keeps its
+ * checksum)
+ */
+static void cake_test_l4s_ramp(struct kunit *test)
+{
+	struct sk_buff *skb = cake_test_skb(test, true, IPPROTO_TCP, 2, 40000, 0);
+	struct sk_buff *skb4 = cake_test_skb(test, false, IPPROTO_TCP, 2, 40000, 0);
+	struct cake_tin_data *b = cake_test_l4s_tin(test, 850, 1, 5);
+	u32 marks;
+
+	KUNIT_ASSERT_EQ(test, READ_ONCE(l4s_ramp), 100);
+	KUNIT_EXPECT_EQ(test, cake_test_l4s_marks(test, b, skb, INET_ECN_ECT_1, 1514, 4500, false, 1000), 0);
+	KUNIT_EXPECT_EQ(test, cake_test_l4s_marks(test, b, skb, INET_ECN_ECT_1, 1514, 5000, false, 1000), 0);
+	KUNIT_EXPECT_EQ(test, cake_test_l4s_marks(test, b, skb, INET_ECN_ECT_1, 1514, 10000, false, 1000), 1000);
+	KUNIT_EXPECT_EQ(test, cake_test_l4s_marks(test, b, skb, INET_ECN_ECT_1, 1514, 50000, false, 1000), 1000);
+	/* 1000 tries at p: within six standard deviations (false once in 10^8 runs) */
+	marks = cake_test_l4s_marks(test, b, skb, INET_ECN_ECT_1, 1514, 7500, false, 1000);
+	KUNIT_EXPECT_GE(test, marks, 500 - 95);
+	KUNIT_EXPECT_LE(test, marks, 500 + 95);
+	marks = cake_test_l4s_marks(test, b, skb, INET_ECN_ECT_1, 1514, 6250, false, 1000);
+	KUNIT_EXPECT_GE(test, marks, 250 - 82);
+	KUNIT_EXPECT_LE(test, marks, 250 + 82);
+
+	ip_send_check(ip_hdr(skb4));
+	KUNIT_EXPECT_EQ(test, cake_test_l4s_marks(test, b, skb4, INET_ECN_ECT_1, 1514, 20000, false, 1), 1);
+	KUNIT_EXPECT_EQ(test, ip_fast_csum((u8 *)ip_hdr(skb4), ip_hdr(skb4)->ihl), 0);
+}
