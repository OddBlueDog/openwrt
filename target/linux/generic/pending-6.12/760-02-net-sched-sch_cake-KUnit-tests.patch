+/* The fast skip lets every packet with no more than the most headers
+ * cake_get_tcphdr() reads through to be parsed: 6in4 with options on the
+ * outer IPv4 header, and a TCP header full of options (timestamps and
+ * three SACK blocks), 124 and 160 bytes. Such a pure ACK is counted with
+ * none queued yet, and the next, aggressive, makes it redundant.
+ */
+static void cake_test_ack_filter_6in4_options(struct kunit *test)
+{
+	static const u8 opts[] = { 4, 40 };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(opts); i++) {
+		struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+		struct cake_flow *flow = cake_test_ack_flow(test, q, CAKE_ACK_AGGRESSIVE);
+		struct cake_test_tcp t = {
+			.flags = TCP_FLAG_ACK, .ack = 1000, .tsval = 7, .sixin4 = true,
+			.sacks = { { 2000, 3000 }, { 4000, 5000 }, { 6000, 7000 } },
+			.ip_opts = opts[i],
+		};
+		struct sk_buff *skb = cake_test_tcp_skb(test, &t);
+
+		KUNIT_ASSERT_EQ(test, skb->len - ETH_HLEN, 120 + opts[i]);
+		flow_queue_add(flow, skb);
+		KUNIT_EXPECT_NULL(test, cake_ack_filter(q, flow));
+		KUNIT_EXPECT_EQ_MSG(test, flow->pure_acks, 1, "%u option bytes", opts[i]);
+		KUNIT_EXPECT_TRUE(test, get_cobalt_cb(skb)->pure_ack);
+		t.ack = 2000;
+		KUNIT_EXPECT_TRUE_MSG(test, cake_test_ack_in(test, q, flow, &t), "%u option bytes",
+				      opts[i]);
+		KUNIT_EXPECT_EQ(test, flow->pure_acks, 1);
+	}
+}
