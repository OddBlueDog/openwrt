+	/* Promote f2 under flows (no host counts), switch -> srchost, empty f2 */
+	f2 = cake_test_hosts_bulk(test, h, 0, 11, 40002);
+	h->cfg.flow_mode = CAKE_FLOW_SRC_IP;
+	cake_flow_emptied(h->q[0], b0, f2, now);
+	for (i = 0; i < CAKE_QUEUES; i++) {
+		KUNIT_EXPECT_EQ(test, atomic_read(&b0->mq_srcload[i]), 0);
+		KUNIT_EXPECT_EQ(test, atomic_read(&b0->mq_dstload[i]), 0);
+	}
