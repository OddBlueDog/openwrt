+#if IS_ENABLED(CONFIG_NF_CONNTRACK) && defined(CONFIG_NET_REDIRECT)
+/* --- dscp_restore's memo --------------------------------------------------- */
+
+/* Sub-cake @i of @mq as a download's CAKE that washes, in @tin_mode with
+ * @flow_mode, dscp_restore on
+ */
+static struct cake_sched_data *cake_test_memo_cake(struct kunit *test, struct cake_test_mq *mq,
+						   int i, u8 tin_mode, int flow_mode)
+{
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, i, 12500000, tin_mode);
+
+	q->config->rate_flags |= CAKE_FLAG_WASH;
+	q->config->flow_mode = flow_mode;
+	cake_test_dscp_restore_set(test, true);
+	return q;
+}
+
+/* The DSCP @skb leaves sub-cake @i's cake_classify() with at @now, having
+ * come with DS field @dsfield; its tin in @tin
+ */
+static u8 cake_test_memo_dscp(struct cake_test_mq *mq, int i, struct sk_buff *skb,
+			      u8 dsfield, ktime_t now, u32 *tin)
+{
+	struct cake_sched_data *q = cake_test_mq_q(mq, i);
+	struct cake_tin_data *b = NULL;
+	int ret;
+
+	cake_test_set_dsfield(skb, dsfield);
+	rcu_read_lock_bh();
+	cake_classify(mq->sch[i], &b, skb, q->config->flow_mode, &ret, now);
+	rcu_read_unlock_bh();
+	if (tin)
+		*tin = b ? b - q->tins : U32_MAX;
+	return cake_test_dsfield(skb) >> 2;
+}
+
+/* In besteffort a flow's next 31 packets, within about 100 ms, take what its
+ * connection gave, without a lookup; another flow has its own, and a packet
+ * that takes it is written as cake_wash_diffserv() writes one.
+ */
+static void cake_test_dscp_memo(struct kunit *test)
+{
+	ktime_t now = ktime_get(), later = ktime_add_ms(now, 105);
+	struct cake_test_mq *mq;
+	struct sk_buff *skb;
+	u8 got[CAKE_DSCP_KEEP];
+	int i;
+
+	if (!rcu_access_pointer(nf_ct_hook))
+		kunit_skip(test, "nf_conntrack isn't loaded");
+	mq = cake_test_mq_alloc(test);
+	cake_test_memo_cake(test, mq, 0, CAKE_DIFFSERV_BESTEFFORT,
+			    CAKE_FLOW_TRIPLE | CAKE_FLOW_NAT_FLAG);
+
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, cake_test_download(test, 46), 0,
+						  now, NULL), 46);
+	/* the host sends with AF41 now: the flow's next 31 packets keep EF */
+	for (i = 1; i < CAKE_DSCP_KEEP; i++)
+		got[i] = cake_test_memo_dscp(mq, 0, cake_test_download(test, 34), 0, now, NULL);
+	for (i = 1; i < CAKE_DSCP_KEEP; i++)
+		KUNIT_EXPECT_EQ_MSG(test, got[i], 46, "packet %d", i);
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, cake_test_download(test, 34), 0,
+						  now, NULL), 34);
+
+	/* kept under about 100 ms, looked up again after */
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, cake_test_download(test, 10), 0,
+						  ktime_add_ms(now, 95), NULL), 34);
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, cake_test_download(test, 10), 0,
+						  later, NULL), 10);
+
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, cake_test_download_host(test, 3, 26), 0,
+						  later, NULL), 26);
+
+	skb = cake_test_download(test, 0);
+	KUNIT_EXPECT_EQ(test, cake_test_memo_dscp(mq, 0, skb, 48 << 2 | INET_ECN_CE, later, NULL), 10);
+	KUNIT_EXPECT_EQ(test, cake_test_dsfield(skb), 10 << 2 | INET_ECN_CE);
+	KUNIT_EXPECT_EQ(test, ip_fast_csum(ip_hdr(skb), ip_hdr(skb)->ihl), 0);
+}
+
+/* The memo is its queue's flow's: a queue that's gone to another flow looks
+ * its connection up, and a lookup that found none isn't kept.
+ */
+static void cake_test_dscp_memo_tag(struct kunit *test)
+{
+	static const u32 tag[] = { 0x1234, 0x1234, 0x5678, 0x9abc, 0x9abc };
+	static const int sent[] = { 46, 34, 34, -1, 46 };
+	static const u8 want[] = { 46, 46, 34, 0, 46 };
+	ktime_t now = ktime_get();
+	struct sk_buff *skb[ARRAY_SIZE(sent)];
+	u8 got[ARRAY_SIZE(sent)];
+	struct cake_sched_data *q;
+	struct cake_tin_data *b;
+	int i;
+
+	if (!rcu_access_pointer(nf_ct_hook))
+		kunit_skip(test, "nf_conntrack isn't loaded");
+	q = cake_test_memo_cake(test, cake_test_mq_alloc(test), 0, CAKE_DIFFSERV_BESTEFFORT,
+				CAKE_FLOW_TRIPLE);
+	b = &q->tins[0];
+	for (i = 0; i < ARRAY_SIZE(sent); i++) {
+		skb[i] = cake_test_download_host(test, 2, sent[i]);
+		cake_test_set_dsfield(skb[i], 48 << 2);
+	}
+
+	rcu_read_lock_bh();
+	for (i = 0; i < ARRAY_SIZE(sent); i++) {
+		b->tags[7] = tag[i];
+		cake_restore_memo(q, b, 7, skb[i], now);
+		got[i] = cake_test_dsfield(skb[i]) >> 2;
+	}
+	rcu_read_unlock_bh();
+
+	for (i = 0; i < ARRAY_SIZE(sent); i++)
+		KUNIT_EXPECT_EQ_MSG(test, got[i], want[i], "packet %d", i);
+}
