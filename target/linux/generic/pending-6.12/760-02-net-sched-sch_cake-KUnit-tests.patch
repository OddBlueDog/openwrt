+static struct nlattr *cake_test_fuzz_opts(struct kunit *test, u64 rate,
+					  u32 diffserv, u32 flow_mode,
+					  u32 wash, u32 split_gso,
+					  u32 ack_filter)
+{
+	struct sk_buff *msg = nlmsg_new(NLMSG_DEFAULT_SIZE, GFP_KERNEL);
+	struct nlattr *opts;
+
+	KUNIT_ASSERT_NOT_NULL(test, msg);
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_free_skb, msg));
+	opts = nla_nest_start_noflag(msg, TCA_OPTIONS);
+	KUNIT_ASSERT_NOT_NULL(test, opts);
+	KUNIT_ASSERT_EQ(test, 0, nla_put_u64_64bit(msg, TCA_CAKE_BASE_RATE64, rate, TCA_CAKE_PAD));
+	KUNIT_ASSERT_EQ(test, 0, nla_put_u32(msg, TCA_CAKE_DIFFSERV_MODE, diffserv));
+	KUNIT_ASSERT_EQ(test, 0, nla_put_u32(msg, TCA_CAKE_FLOW_MODE, flow_mode));
+	KUNIT_ASSERT_EQ(test, 0, nla_put_u32(msg, TCA_CAKE_WASH, wash));
+	KUNIT_ASSERT_EQ(test, 0, nla_put_u32(msg, TCA_CAKE_SPLIT_GSO, split_gso));
+	KUNIT_ASSERT_EQ(test, 0, nla_put_u32(msg, TCA_CAKE_ACK_FILTER, ack_filter));
+	nla_nest_end(msg, opts);
+	return opts;
+}
