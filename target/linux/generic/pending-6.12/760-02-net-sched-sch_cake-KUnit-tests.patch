+	cake_test_dl_pkts(test, &cs1, 1, 6, 100, true);
+	cake_test_dl_pkts(test, &be_dl, 1, 8, 100, true);
+	cake_test_set_dsfield(cs1, 8 << 2); /* CS1 -> tin 1 (Bulk) */
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
