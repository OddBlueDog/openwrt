+/* A GSO packet is charged a segment size at a time: one sum for all of them
+ * when the last is as full as the others, as the sum of each would be, and
+ * the packet size records the same
+ */
+static void cake_test_overhead_segments(struct kunit *test)
+{
+	static const u8 framing[] = { CAKE_ATM_NONE, CAKE_ATM_ATM, CAKE_ATM_PTM };
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	struct cake_sched_data *ref = cake_test_alloc(test, sizeof(*ref));
+	const unsigned int mss = 1400, hdr = ETH_HLEN + 40;
+	int f, segs, cut;
+
+	q->config = cake_test_alloc(test, sizeof(*q->config));
+	ref->config = q->config;
+	q->config->rate_flags = CAKE_FLAG_OVERHEAD;
+	q->config->rate_overhead = 22;
+	q->min_netlen = ref->min_netlen = ~0;
+	q->min_adjlen = ref->min_adjlen = ~0;
+	for (f = 0; f < ARRAY_SIZE(framing); f++) {
+		q->config->atm_mode = framing[f];
+		for (segs = 1; segs <= 5; segs++) {
+			for (cut = 0; cut <= 300; cut += 300) {
+				struct sk_buff *skb = cake_test_gso_skb(test, false, mss, segs);
+				u32 full = hdr + mss, last = full - cut, want;
+
+				if (cut)
+					__skb_trim(skb, skb->len - cut);
+				qdisc_skb_cb(skb)->pkt_len = skb->len;
+				want = cake_calc_overhead(ref, full, ETH_HLEN) * (segs - 1) +
+				       cake_calc_overhead(ref, last, ETH_HLEN);
+				KUNIT_EXPECT_EQ_MSG(test, cake_overhead(q, skb), want,
+						    "framing %d, %d segments, %d short", f, segs, cut);
+			}
+		}
+	}
+	KUNIT_EXPECT_EQ(test, q->max_netlen, ref->max_netlen);
+	KUNIT_EXPECT_EQ(test, q->min_netlen, ref->min_netlen);
+	KUNIT_EXPECT_EQ(test, q->max_adjlen, ref->max_adjlen);
+	KUNIT_EXPECT_EQ(test, q->min_adjlen, ref->min_adjlen);
+}
