+static int cake_test_init(struct kunit *test)
+{
+	int i;
+
+	cake_test_params.ecn_fail_count = READ_ONCE(ecn_fail_count);
+	cake_test_params.l4s_ramp = READ_ONCE(l4s_ramp);
+	cake_test_params.sparse_ahead_us = READ_ONCE(sparse_ahead_us);
+	cake_test_params.wake_slack_us = READ_ONCE(wake_slack_us);
+	cake_test_params.dscp_restore = READ_ONCE(dscp_restore);
+	WRITE_ONCE(ecn_fail_count, CAKE_ECN_FAIL_COUNT);
+	WRITE_ONCE(l4s_ramp, CAKE_L4S_RAMP);
+	WRITE_ONCE(sparse_ahead_us, 0);
+	WRITE_ONCE(wake_slack_us, CAKE_WAKE_SLACK_US);
+	WRITE_ONCE(dscp_restore, false);
+
+	/* as cake_module_init() fills it in, if the suite runs before it */
+	if (!quantum_div[1]) {
+		quantum_div[0] = ~0;
+		for (i = 1; i <= CAKE_QUEUES; i++)
+			quantum_div[i] = 65535 / i;
+	}
+	return 0;
+}
