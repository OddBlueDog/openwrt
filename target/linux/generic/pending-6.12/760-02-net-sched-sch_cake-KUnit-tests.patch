+		{ CAKE_DIFFSERV_DIFFSERV4, CAKE_FLOW_TRIPLE | CAKE_FLOW_NAT_FLAG },
+		{ CAKE_DIFFSERV_BESTEFFORT, CAKE_FLOW_DST_IP },
+		{ CAKE_DIFFSERV_BESTEFFORT, CAKE_FLOW_HOSTS | CAKE_FLOW_NAT_FLAG },
+	};
+	ktime_t now = ktime_get();
+	struct cake_sched_data *q = NULL;
+	struct cake_test_mq *mq;
+	struct sk_buff *skb;
+	u32 tin[2];
+	int i;
+
+	if (!rcu_access_pointer(nf_ct_hook))
+		kunit_skip(test, "nf_conntrack isn't loaded");
+	mq = cake_test_mq_alloc(test);
+	for (i = 0; i < ARRAY_SIZE(c); i++) {
+		q = cake_test_memo_cake(test, mq, i, c[i].tin_mode, c[i].flow_mode);
+		KUNIT_EXPECT_EQ_MSG(test, cake_test_memo_dscp(mq, i, cake_test_download(test, 46),
+							      0, now, &tin[0]), 46, "case %d", i);
+		KUNIT_EXPECT_EQ_MSG(test, cake_test_memo_dscp(mq, i, cake_test_download(test, 34),
+							      0, now, &tin[1]), 34, "case %d", i);
+		if (c[i].tin_mode == CAKE_DIFFSERV_DIFFSERV4) {
+			KUNIT_EXPECT_EQ(test, tin[0], q->tin_index[46]);
+			KUNIT_EXPECT_EQ(test, tin[1], q->tin_index[34]);
+			KUNIT_EXPECT_NE(test, tin[0], tin[1]);
+		}
+	}
+
+	q = cake_test_memo_cake(test, mq, ARRAY_SIZE(c), CAKE_DIFFSERV_BESTEFFORT,
+				CAKE_FLOW_TRIPLE);
+	skb = cake_test_download(test, 46);
+	KUNIT_EXPECT_TRUE(test, cake_dscp_memo_on(q, skb, CAKE_FLOW_TRIPLE, 0));
+	/* shared tin_mode changed before child reconfigure: follows child */
+	WRITE_ONCE(q->config->tin_mode, CAKE_DIFFSERV_DIFFSERV4);
+	KUNIT_EXPECT_TRUE(test, cake_dscp_memo_on(q, skb, CAKE_FLOW_TRIPLE, 0));
+	q->tin_mode = CAKE_DIFFSERV_DIFFSERV4;
+	WRITE_ONCE(q->config->tin_mode, CAKE_DIFFSERV_BESTEFFORT);
+	KUNIT_EXPECT_FALSE(test, cake_dscp_memo_on(q, skb, CAKE_FLOW_TRIPLE, 0));
+	q->tin_mode = CAKE_DIFFSERV_BESTEFFORT;
+	/* a filter chose the queue */
+	KUNIT_EXPECT_FALSE(test, cake_dscp_memo_on(q, skb, CAKE_FLOW_TRIPLE, 5));
+	/* a packet on its way out, or ifb has handed it back */
+	skb->from_ingress = 0;
+	KUNIT_EXPECT_FALSE(test, cake_dscp_memo_on(q, skb, CAKE_FLOW_TRIPLE, 0));
+	skb->from_ingress = 1;
+	/* ARP */
+	skb->protocol = htons(ETH_P_ARP);
+	KUNIT_EXPECT_FALSE(test, cake_dscp_memo_on(q, skb, CAKE_FLOW_TRIPLE, 0));
+	skb->protocol = htons(ETH_P_IP);
+	/* dscp_restore off */
+	dscp_restore = false;
+	KUNIT_EXPECT_FALSE(test, cake_dscp_memo_on(q, skb, CAKE_FLOW_TRIPLE, 0));
+	dscp_restore = true;
+	/* no wash */
+	q->config->rate_flags &= ~CAKE_FLAG_WASH;
+	KUNIT_EXPECT_FALSE(test, cake_dscp_memo_on(q, skb, CAKE_FLOW_TRIPLE, 0));
+}
