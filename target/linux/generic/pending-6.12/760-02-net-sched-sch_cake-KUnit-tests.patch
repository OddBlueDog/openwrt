+/* A cake_mq resync adjusts only rates and keeps the child's current tin layout
+ * until its own locked cake_reconfigure() applies a new shared tin_mode.
+ */
+static void cake_test_mq_resync_keeps_tin_layout(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct Qdisc *root = cake_test_mq_root(test, mq, 2, 12500000,
+					       CAKE_DIFFSERV_DIFFSERV4);
+	struct cake_sched_data *q0 = cake_test_mq_q(mq, 0);
+	struct cake_sched_data *q1 = cake_test_mq_q(mq, 1);
+	struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_UDP, 5, 41000, 0);
+	struct sk_buff *out = NULL;
+	u16 cnt_after_shrink, cnt_after_grow;
+	u64 target_t1;
+	bool ok = true;
+
+	KUNIT_ASSERT_NOT_NULL(test, root);
+	kunit_remove_action(test, cake_test_free_skb, skb);
+	skb->priority = TC_H_MAKE(mq->sch[0]->handle, 3);	/* tin 2 */
+	qdisc_skb_cb(skb)->pkt_len = 1514;
+
+	rcu_read_lock_bh();
+	ok &= cake_test_in(mq->sch[0], skb);
+	cake_mq_mark_used(mq->sch[1], q1);
+	mq->sch[1]->q.qlen = 1;
+	q1->last_active = ktime_get_ns();
+	q1->mq_saturated = true;
+	q1->mq_weight = CAKE_MQ_UNIT;
+	WRITE_ONCE(mq->cfg->tin_mode, CAKE_DIFFSERV_BESTEFFORT);
+	q0->last_checked_active = ktime_get_ns() - NSEC_PER_MSEC;
+	out = cake_dequeue(mq->sch[0]);
+	cnt_after_shrink = q0->tin_cnt;
+	mq->sch[1]->q.qlen = 0;
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_TRUE(test, ok);
+	if (out)
+		kfree_skb(out);
+	KUNIT_EXPECT_EQ(test, cnt_after_shrink, 4);
+
+	/* Growing tin_mode before reconfigure leaves tin_cnt at 1 */
+	mq = cake_test_mq_alloc(test);
+	root = cake_test_mq_root(test, mq, 2, 12500000, CAKE_DIFFSERV_BESTEFFORT);
+	KUNIT_ASSERT_NOT_NULL(test, root);
+	q0 = cake_test_mq_q(mq, 0);
+	q1 = cake_test_mq_q(mq, 1);
+
+	rcu_read_lock_bh();
+	cake_mq_mark_used(mq->sch[1], q1);
+	mq->sch[1]->q.qlen = 1;
+	q1->last_active = ktime_get_ns();
+	q1->mq_saturated = true;
+	q1->mq_weight = CAKE_MQ_UNIT;
+	WRITE_ONCE(mq->cfg->tin_mode, CAKE_DIFFSERV_DIFFSERV8);
+	q0->last_checked_active = ktime_get_ns() - NSEC_PER_MSEC;
+	cake_dequeue(mq->sch[0]);
+	cnt_after_grow = q0->tin_cnt;
+	target_t1 = q0->tins[1].cparams.target;
+	mq->sch[1]->q.qlen = 0;
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_EQ(test, cnt_after_grow, 1);
+	if (cnt_after_grow > 1)
+		KUNIT_EXPECT_NE(test, target_t1, 0ULL);
+}
