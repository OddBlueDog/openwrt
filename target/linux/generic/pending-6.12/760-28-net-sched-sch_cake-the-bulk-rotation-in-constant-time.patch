+/* The bulk rotation. A flow out of deficit used to go to the tail of one
+ * list, to get its host's share of the bulk quantum back each time it came
+ * round again, until its deficit was positive: a packet of length L from a
+ * host with n bulk flows took about n * L / quantum visits, each reading
+ * the host loads and moving the flow, all within one dequeue. Instead the
+ * rotation is a wheel of slots, one for each pass to come: a flow out of
+ * deficit gets at once the shares of the passes it needs, up to
+ * CAKE_WHEEL_SLOTS - 1, and waits in the slot of the pass it would next
+ * have sent in. The flows of a pass are served in the order they joined
+ * it, as on the list; a flow keeps its place at the head of its slot while
+ * it has deficit left. The host load is read once, when the flow is put in
+ * its slot, so a change in it reaches the flow up to that many passes late.
+ */
+static void cake_init_flowchains(struct cake_tin_data *b)
+{
+	int i;
+
+	INIT_LIST_HEAD(&b->new_flows);
+	INIT_LIST_HEAD(&b->decaying_flows);
+	for (i = 0; i < CAKE_WHEEL_SLOTS; i++)
+		INIT_LIST_HEAD(&b->old_wheel[i]);
+	b->wheel_mask = 0;
+	b->cur_slot = 0;
+}
+
+/* @flow into the slot @skip passes on from the one being served */
+static void cake_bulk_queue(struct cake_tin_data *b, struct cake_flow *flow,
+			    u32 skip)
+{
+	u8 slot = (b->cur_slot + skip) % CAKE_WHEEL_SLOTS;
+
+	list_move_tail(&flow->flowchain, &b->old_wheel[slot]);
+	b->wheel_mask |= BIT(slot);
+}
+
+/* @flow, out of deficit, into the bulk rotation */
+static void cake_bulk_park(struct cake_sched_data *q, struct cake_tin_data *b,
+			   struct cake_flow *flow)
+{
+	u16 load = cake_host_load(b, flow, q->config->flow_mode);
+	u32 refill = cake_host_share(b->bulk_quantum, load) ?: 1;
+	u32 skip = min_t(u32, (u32)-flow->deficit / refill + 1,
+			 CAKE_WHEEL_SLOTS - 1);
+
+	flow->deficit += (s32)(skip * refill);
+	if (q->config->is_shared)
+		cake_mq_set_weight(b, flow, quantum_div[load]);
+	cake_bulk_queue(b, flow, skip);
+}
+
+/* The flow the bulk rotation serves next: the head of the slot being
+ * served, or once that's empty, of the next slot with flows, whose pass
+ * then begins. NULL if there's none. A slot's bit is cleared when it's
+ * found empty.
+ */
+static struct cake_flow *cake_bulk_head(struct cake_tin_data *b)
+{
+	struct list_head *head = &b->old_wheel[b->cur_slot];
+
+	while (list_empty(head)) {
+		u32 mask = b->wheel_mask & ~BIT(b->cur_slot);
+
+		b->wheel_mask = mask;
+		if (!mask)
+			return NULL;
+		b->cur_slot = (b->cur_slot + __ffs(ror32(mask, b->cur_slot))) %
+			      CAKE_WHEEL_SLOTS;
+		head = &b->old_wheel[b->cur_slot];
+	}
+	return list_first_entry(head, struct cake_flow, flowchain);
+}
+
+/* Whether any flow is left in the bulk rotation: its lists, as the mask may
+ * still have the bits of slots emptied since
+ */
+static bool cake_bulk_any(const struct cake_tin_data *b)
+{
+	unsigned long mask = b->wheel_mask;
+	unsigned int slot;
+
+	for_each_set_bit(slot, &mask, CAKE_WHEEL_SLOTS)
+		if (!list_empty(&b->old_wheel[slot]))
+			return true;
+	return false;
+}
