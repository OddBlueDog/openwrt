+/* The wheel's own workings: a flow waits the passes it needs, at most
+ * CAKE_WHEEL_SLOTS - 1, with their shares; the pass served moves on to
+ * the next slot with flows, round the end; flows of a pass keep their
+ * order; a slot found empty loses its bit
+ */
+static void cake_test_wheel_slots(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	struct cake_tin_data *b = cake_test_alloc(test, sizeof(*b));
+	struct cake_flow *f = b->flows;
+	const s32 unit = 1 << CAKE_DEFICIT_SHIFT;
+	int i;
+
+	q->config = cake_test_alloc(test, sizeof(*q->config));
+	q->config->flow_mode = CAKE_FLOW_DUAL_SRC;
+	cake_init_flowchains(b);
+	b->bulk_quantum = 1000;
+	for (i = 0; i < 8; i++)
+		INIT_LIST_HEAD(&f[i].flowchain);
+	KUNIT_EXPECT_NULL(test, cake_bulk_head(b));
+
+	/* 2,500 bytes short: three passes' worth; none short: the next pass */
+	f[0].deficit = -2500 * unit;
+	cake_bulk_park(q, b, &f[0]);
+	KUNIT_EXPECT_EQ(test, f[0].deficit, 500 * unit);
+	f[1].deficit = 0;
+	cake_bulk_park(q, b, &f[1]);
+	KUNIT_EXPECT_EQ(test, f[1].deficit, 1000 * unit);
+	/* far short: the furthest slot, still short */
+	f[2].deficit = -100000 * unit;
+	cake_bulk_park(q, b, &f[2]);
+	KUNIT_EXPECT_EQ(test, f[2].deficit, -69000 * unit);
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, BIT(1) | BIT(3) | BIT(31));
+	/* three more for the next pass, in their order */
+	for (i = 3; i < 6; i++) {
+		f[i].deficit = -10 * unit;
+		cake_bulk_park(q, b, &f[i]);
+	}
+
+	KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[1]);
+	KUNIT_EXPECT_EQ(test, b->cur_slot, 1);
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, BIT(1) | BIT(3) | BIT(31));
+	for (i = 1; i < 6; i += i == 1 ? 2 : 1) {
+		KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[i]);
+		list_del_init(&f[i].flowchain);
+	}
+	KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[0]);
+	KUNIT_EXPECT_EQ(test, b->cur_slot, 3);
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, BIT(3) | BIT(31));
+	list_del_init(&f[0].flowchain);
+	KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[2]);
+	KUNIT_EXPECT_EQ(test, b->cur_slot, 31);
+
+	/* round the end: 31 on from slot 31 is slot 30 */
+	cake_bulk_park(q, b, &f[2]);
+	KUNIT_EXPECT_EQ(test, f[2].deficit, -38000 * unit);
+	f[6].deficit = 0;
+	cake_bulk_park(q, b, &f[6]);
+	KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[6]);
+	KUNIT_EXPECT_EQ(test, b->cur_slot, 0);
+	list_del_init(&f[6].flowchain);
+	KUNIT_EXPECT_PTR_EQ(test, cake_bulk_head(b), &f[2]);
+	KUNIT_EXPECT_EQ(test, b->cur_slot, 30);
+
+	/* taken out from elsewhere: its bit stays until the slot is served */
+	list_del_init(&f[2].flowchain);
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, BIT(30));
+	KUNIT_EXPECT_FALSE(test, cake_bulk_any(b));
+	KUNIT_EXPECT_NULL(test, cake_bulk_head(b));
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, 0);
+
+	/* a host's share of the quantum per pass: 1000 / 3 */
+	b->hosts[4].srchost_bulk_flow_count = 3;
+	f[7].srchost = 4;
+	f[7].deficit = -1000 * unit;
+	cake_bulk_park(q, b, &f[7]);
+	KUNIT_EXPECT_EQ(test, f[7].deficit,
+			4 * (s32)((1000 * quantum_div[3]) >> (16 - CAKE_DEFICIT_SHIFT)) - 1000 * unit);
+	KUNIT_EXPECT_EQ(test, b->wheel_mask, BIT(30 + 4 - 32));
+}
+
+/* Upstream's bulk rotation, for the wheel to be measured against: one list,
+ * each flow given its host's share of the bulk quantum each time it comes
+ * round, until its deficit is positive, as cake_dequeue() did. The share
+ * as the wheel works it out (@dither false), or as upstream did, in whole
+ * bytes, dithered. Every flow always has packets until it stops; one that
+ * has stopped leaves when it's found empty, and its host's count goes down
+ * then.
+ */
+#define CAKE_TEST_RR_FLOWS	128
+
+struct cake_test_rr {
+	s64	deficit[CAKE_TEST_RR_FLOWS];	/* as the wheel's, CAKE_DEFICIT_SHIFT */
+	u8	host[CAKE_TEST_RR_FLOWS];
+	bool	stopped[CAKE_TEST_RR_FLOWS];
+	u16	ring[CAKE_TEST_RR_FLOWS];	/* the list, from ring[first] */
+	u16	first, n;
+	u16	hosts[2];			/* each host's bulk flows */
+	bool	dither;
+	u64	bytes[CAKE_TEST_RR_FLOWS];
+	u64	visits;
+};
+
+/* one packet of @len from the rotation: its flow, or -1 if none is left */
+static int cake_test_rr_send(struct cake_test_rr *rr, u16 quantum, u32 len)
+{
+	while (rr->n) {
+		u16 f = rr->ring[rr->first];
+		u16 load = max_t(u16, rr->hosts[rr->host[f]], 1);
+
+		if (rr->deficit[f] <= 0) {
+			if (!rr->dither)
+				rr->deficit[f] += cake_host_share(quantum, load);
+			else if (load == 1)
+				rr->deficit[f] += (s64)quantum << CAKE_DEFICIT_SHIFT;
+			else
+				rr->deficit[f] += (s64)((quantum * quantum_div[load] +
+							 get_random_u16()) >> 16) << CAKE_DEFICIT_SHIFT;
+			rr->visits++;
+			/* to the tail */
+			rr->ring[(rr->first + rr->n) % CAKE_TEST_RR_FLOWS] = f;
+			rr->first = (rr->first + 1) % CAKE_TEST_RR_FLOWS;
+			continue;
+		}
+		if (rr->stopped[f]) {
+			rr->hosts[rr->host[f]]--;
+			rr->first = (rr->first + 1) % CAKE_TEST_RR_FLOWS;
+			rr->n--;
+			continue;
+		}
+		rr->deficit[f] -= (s64)len << CAKE_DEFICIT_SHIFT;
+		rr->bytes[f] += len;
+		return f;
+	}
+	return -1;
+}
+
+struct cake_test_wheel_case {
+	u16	flows[2];	/* bulk flows from host 0 and host 1 */
+	u32	len;		/* their packets' length */
+	u16	quantum;	/* the tin's bulk quantum */
+	u16	stop_to;	/* host 1's flows halfway through, if non-zero */
+};
+
+/* The same flows through the wheel (cake_bulk_head(), cake_bulk_park() and
+ * cake_flow_emptied() on a tin, in cake_dequeue()'s order) and through
+ * upstream's rotation, with quanta as at 800 Mbit/s without split-gso and
+ * at the MTU with it.
+ *
+ * Against the rotation with the same shares: at every point, each flow's
+ * bytes are within what it sends in one pass (one packet, or more where
+ * its share is more than a packet): the flows of a pass go in the order
+ * they joined it, upstream's in the order of the list. Where a host's
+ * flows stop, a flow of the host parked before it knew may go on with the
+ * smaller share for up to CAKE_WHEEL_SLOTS - 1 passes, and the other
+ * host's flow gets what it doesn't: as far apart again, at the new share.
+ * Once settled, the flows send at the same rates.
+ *
+ * Against upstream's dithered shares (where a host has a few flows), each
+ * flow's bytes at the end are within 1% (and two packets) of upstream's,
+ * and the lag above where a host's flows stopped.
+ *
+ * Kept short: sch_cake's suite runs each time the module loads.
+ *
+ * And at most two visits per packet sent, or one per CAKE_WHEEL_SLOTS - 1
+ * passes where a packet takes more than that many.
+ */
+static void cake_test_wheel_vs_list(struct kunit *test)
+{
+	static const struct cake_test_wheel_case cases[] = {
+		{ { 1, 16 }, 65536, 24414 }, { { 1, 16 }, 16384, 24414 },
+		{ { 1, 16 }, 1514, 1514 },
+		{ { 16, 0 }, 65536, 24414 }, { { 16, 0 }, 1514, 1514 },
+		{ { 100, 0 }, 65536, 24414 }, { { 100, 0 }, 16384, 24414 },
+		{ { 100, 0 }, 1514, 1514 },
+		{ { 1, 16 }, 65536, 24414, 1 }, { { 1, 16 }, 16384, 24414, 1 },
+		{ { 1, 16 }, 1514, 1514, 1 },
+	};
+	int c;
+
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		const struct cake_test_wheel_case *wc = &cases[c];
+		struct cake_test_rr *rr = cake_test_alloc(test, 2 * sizeof(*rr));
+		struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+		struct cake_tin_data *b = cake_test_alloc(test, sizeof(*b));
+		u64 *bytes = cake_test_alloc(test, 3 * CAKE_TEST_RR_FLOWS * sizeof(u64));
+		u64 *late = bytes + CAKE_TEST_RR_FLOWS, *late_rr = late + CAKE_TEST_RR_FLOWS;
+		u16 n = wc->flows[0] + wc->flows[1];
+		/* enough for each flow to send a few packets */
+		const u32 packets = n > 20 ? 300 : 800;
+		const int refs = n > 20 ? 1 : 2;
+		u64 visits = 0, worst = 0, worst_dither = 0, max_visits, apart[2], lag;
+		u32 sent, need, over = 0, settled = 0, off = 0;
+		int i, h, r;
+
+		q->config = cake_test_alloc(test, sizeof(*q->config));
+		q->config->flow_mode = CAKE_FLOW_DUAL_SRC;
+		cake_init_flowchains(b);
+		b->bulk_quantum = wc->quantum;
+		for (i = 0; i < n; i++) {
+			struct cake_flow *flow = &b->flows[i];
+
+			h = i >= wc->flows[0];
+			for (r = 0; r < 2; r++) {
+				rr[r].host[i] = h;
+				rr[r].ring[i] = i;
+			}
+			flow->srchost = h;
+			flow->set = CAKE_SET_BULK;
+			list_add_tail(&flow->flowchain, &b->old_wheel[0]);
+		}
+		b->wheel_mask = BIT(0);
+		for (r = 0; r < 2; r++) {
+			rr[r].n = n;
+			rr[r].dither = r;
+			for (h = 0; h < 2; h++)
+				rr[r].hosts[h] = wc->flows[h];
+		}
+		for (h = 0; h < 2; h++)
+			b->hosts[h].srchost_bulk_flow_count = wc->flows[h];
+		b->bulk_flow_count = n;
+		/* what a flow of each host may send in a pass, at its largest share */
+		for (h = 0; h < 2; h++) {
+			u16 least = h && wc->stop_to ? wc->stop_to : wc->flows[h];
+			u32 share = cake_host_share(wc->quantum, least) >> CAKE_DEFICIT_SHIFT;
+
+			apart[h] = (u64)wc->len * max_t(u32, 1, DIV_ROUND_UP(share, wc->len));
+		}
+		lag = (u64)(CAKE_WHEEL_SLOTS - 1) *
+		      (cake_host_share(wc->quantum, wc->stop_to ?: 1) >> CAKE_DEFICIT_SHIFT);
+
+		for (sent = 0; sent < packets; sent++) {
+			struct cake_flow *flow;
+			int f, k, at[2];
+
+			if (wc->stop_to && sent == packets / 2)
+				for (i = wc->flows[0] + wc->stop_to; i < n; i++)
+					rr[0].stopped[i] = rr[1].stopped[i] = true;
+			f = cake_test_rr_send(&rr[0], wc->quantum, wc->len);
+			KUNIT_ASSERT_GE(test, f, 0);
+			if (refs > 1)
+				KUNIT_ASSERT_GE(test, cake_test_rr_send(&rr[1], wc->quantum, wc->len), 0);
+
+			while (1) {
+				flow = cake_bulk_head(b);
+				KUNIT_ASSERT_NOT_NULL(test, flow);
+				i = flow - b->flows;
+				if (flow->deficit <= 0) {
+					cake_bulk_park(q, b, flow);
+					visits++;
+					continue;
+				}
+				if (rr[0].stopped[i]) {
+					cake_flow_emptied(q, b, flow, 0);
+					continue;
+				}
+				break;
+			}
+			flow->deficit -= (s32)(wc->len << CAKE_DEFICIT_SHIFT);
+			bytes[i] += wc->len;
+
+			/* only the flows that just sent are any further apart */
+			at[0] = i;
+			at[1] = f;
+			for (k = 0; k < 2; k++) {
+				u64 d = abs_diff(bytes[at[k]], rr[0].bytes[at[k]]);
+
+				h = rr[0].host[at[k]];
+				worst = max(worst, d);
+				over += d > apart[h] + (wc->stop_to && sent >= packets / 2 ? lag : 0);
+			}
+			if (sent == packets * 3 / 4)
+				for (i = 0; i < n; i++) {
+					late[i] = bytes[i];
+					late_rr[i] = rr[0].bytes[i];
+				}
+		}
+		for (i = 0; i < n; i++) {
+			u64 d = abs_diff(bytes[i], rr[1].bytes[i]);
+
+			if (refs > 1) {
+				worst_dither = max(worst_dither, d);
+				off += d > max_t(u64, rr[1].bytes[i] / 100, 2 * wc->len) +
+				       (wc->stop_to ? lag : 0);
+			}
+			settled += abs_diff(bytes[i] - late[i], rr[0].bytes[i] - late_rr[i]) >
+				   2 * apart[rr[0].host[i]];
+		}
+		/* the passes a packet takes, at the smallest share */
+		need = DIV_ROUND_UP(wc->len,
+				    cake_host_share(wc->quantum, max(wc->flows[0], wc->flows[1])) >>
+				    CAKE_DEFICIT_SHIFT);
+		max_visits = (u64)packets * max_t(u32, 2, DIV_ROUND_UP(need + 1, CAKE_WHEEL_SLOTS - 1));
+		kunit_info(test, "%u+%u flows, %u B packets, quantum %u%s: %llu visits for %u packets (list: %llu); %llu B apart at most, %llu B from dithered shares",
+			   wc->flows[0], wc->flows[1], wc->len, wc->quantum,
+			   wc->stop_to ? ", host 1 down to one" : "", visits, packets, rr[0].visits,
+			   worst, worst_dither);
+		KUNIT_EXPECT_EQ_MSG(test, over, 0, "case %d: flows further apart than a pass", c);
+		KUNIT_EXPECT_EQ_MSG(test, settled, 0, "case %d: flows at other rates once settled", c);
+		KUNIT_EXPECT_EQ_MSG(test, off, 0, "case %d: flows off upstream's shares", c);
+		KUNIT_EXPECT_LE_MSG(test, visits, max_visits, "case %d", c);
+		/* a host with flows left has them back, in both */
+		KUNIT_EXPECT_EQ(test, b->hosts[1].srchost_bulk_flow_count, rr[0].hosts[1]);
+	}
+}
+
+/* Through cake_enqueue() and cake_dequeue(): a host with one flow and one
+ * with eight, 16 KB packets, with the bulk quantum of 800 Mbit/s (the
+ * shaper off, so nothing waits for it). Once every flow has turned bulk
+ * and the host loads have settled, the hosts send alike, to within a
+ * pass, and the eight flows alike.
+ */
+static void cake_test_wheel_live(struct kunit *test)
+{
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	struct cake_sched_data *q = cake_test_cake_live(test, mq, 0, 100000000,
+							CAKE_DIFFSERV_BESTEFFORT);
+	struct cake_tin_data *b = &q->tins[0];
+	struct Qdisc *sch = mq->sch[0];
+	u32 host[2] = {}, flow[8] = {}, bad = 0, i, f, n = 0;
+	int ret = NET_XMIT_SUCCESS;
+	struct sk_buff **skb;
+
+	q->config->flow_mode = CAKE_FLOW_DUAL_SRC;
+	q->config->rate_flags &= ~CAKE_FLAG_SPLIT_GSO;
+	cake_reconfigure(sch);
+	KUNIT_ASSERT_EQ(test, b->bulk_quantum, 100000000 >> 12);
+	q->rate_ns = 0;
+	/* nothing COBALT would act on */
+	b->cparams.target = 10ULL * NSEC_PER_SEC;
+	b->cparams.interval = 100ULL * NSEC_PER_SEC;
+	KUNIT_ASSERT_EQ(test, 0, kunit_add_action_or_reset(test, cake_test_reset, sch));
+
+	/* enough for all that's sent: half of it from host 5's one flow */
+	skb = cake_test_alloc(test, 400 * sizeof(*skb));
+	for (f = 0; f < 9; f++) {
+		for (i = 0; i < (f ? 25 : 200); i++, n++) {
+			skb[n] = cake_test_skb(test, false, IPPROTO_TCP, f ? 6 : 5, 41000 + f, 0);
+			kunit_remove_action(test, cake_test_free_skb, skb[n]);
+			qdisc_skb_cb(skb[n])->pkt_len = 16384;
+		}
+	}
+	rcu_read_lock_bh();
+	for (i = 0; i < n; i++) {
+		struct sk_buff *to_free = NULL;
+
+		ret |= cake_enqueue(skb[i], sch, &to_free);
+		bad += !!to_free;
+	}
+	for (i = 0; i < 9 + 40 + 240; i++) {
+		struct sk_buff *skb = cake_dequeue(sch);
+
+		if (!skb) {
+			bad++;
+			break;
+		}
+		f = ntohs(tcp_hdr(skb)->source) - 41000;
+		kfree_skb(skb);
+		/* each flow's first packet goes as a new flow; then the host
+		 * loads settle
+		 */
+		if (i < 9 + 40)
+			continue;
+		host[!!f]++;
+		if (f)
+			flow[f - 1]++;
+	}
+	rcu_read_unlock_bh();
+
+	KUNIT_EXPECT_EQ(test, ret, NET_XMIT_SUCCESS);
+	KUNIT_EXPECT_EQ(test, bad, 0);
+	/* host 5's flow sends up to two packets a pass */
+	KUNIT_EXPECT_LE_MSG(test, abs((int)host[0] - (int)host[1]), 3, "%u against %u",
+			    host[0], host[1]);
+	for (f = 0; f < 8; f++)
+		KUNIT_EXPECT_LE_MSG(test, abs((int)flow[f] - (int)host[1] / 8), 1, "flow %u: %u of %u",
+				    f, flow[f], host[1]);
+}
