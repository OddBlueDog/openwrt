+static void cake_test_mq_alloc_tins(struct kunit *test, struct cake_test_mq *mq)
+{
+	int i;
+
+	for (i = 0; i < CAKE_TEST_TXQS; i++)
+		cake_test_mq_q(mq, i)->tins =
+			cake_test_alloc(test, sizeof(struct cake_tin_data));
+}
