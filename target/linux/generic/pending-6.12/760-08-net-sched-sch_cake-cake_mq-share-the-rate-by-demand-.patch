+/* A host slot taken over by another tag with flows still counted */
+static void cake_test_mq_host_retag(struct kunit *test)
+{
+	atomic_t *load = cake_test_alloc(test, CAKE_QUEUES * sizeof(atomic_t));
+
+	atomic_set(&load[17], 3);
+	cake_mq_host_retag(load, 17 + 5 * CAKE_QUEUES, 600, 3);
+	KUNIT_EXPECT_EQ(test, atomic_read(&load[17]), 0);
+	KUNIT_EXPECT_EQ(test, atomic_read(&load[600]), 3);
+	/* nothing counted, the same tag, or no table: nothing moves */
+	cake_mq_host_retag(load, 600, 17, 0);
+	cake_mq_host_retag(load, 600, 600, 3);
+	cake_mq_host_retag(NULL, 600, 17, 3);
+	KUNIT_EXPECT_EQ(test, atomic_read(&load[600]), 3);
+	KUNIT_EXPECT_EQ(test, atomic_read(&load[17]), 0);
+}
