+/* The cases in the plan: uneven demand, sub-queues idle, weights by host */
+static void cake_test_mq_share_converges(struct kunit *test)
+{
+	const u64 r = CAKE_TEST_RATE;
+	const u32 u = CAKE_TEST_UNIT;
+	struct cake_test_mq *mq = cake_test_mq_alloc(test);
+	static const struct {
+		u64 demand[4];
+		u32 weight[4];
+	} cases[] = {
+		/* 1 bulk flow against 7, one server (triple-isolate) */
+		{ { U64_MAX, U64_MAX }, { 65535 / 8, 7 * (65535 / 8) } },
+		/* bulk flows next to a 10% video stream on another queue */
+		{ { U64_MAX, CAKE_TEST_RATE / 10 }, { 8 * 65535, 0 } },
+		/* two hosts on different queues, 1 flow against 4 */
+		{ { U64_MAX, U64_MAX }, { 65535, 4 * (65535 / 4) } },
+		/* the paper's 80/20 floods */
+		{ { CAKE_TEST_RATE * 4 / 5, CAKE_TEST_RATE / 5 }, { 65535, 65535 } },
+		/* a TCP flow held back by its own window, two saturated */
+		{ { U64_MAX, CAKE_TEST_RATE / 4, U64_MAX }, { 65535, 65535, 2 * 65535 } },
+		/* two idle sub-cakes in between */
+		{ { U64_MAX, 0, U64_MAX, 0 }, { 65535, 65535, 3 * 65535, 65535 } },
+		/* nobody asks for the rate */
+		{ { CAKE_TEST_RATE / 5, CAKE_TEST_RATE / 10, CAKE_TEST_RATE / 4 }, { 65535, 65535, 65535 } },
+	};
+	struct rnd_state rnd;
+	int c, round;
+
+	cake_test_mq_alloc_tins(test, mq);
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		int n = 0;
+
+		while (n < 4 && (cases[c].demand[n] || cases[c].weight[n]))
+			n++;
+		cake_test_mq_converge(test, mq, cases[c].demand, cases[c].weight, n, r);
+	}
+
+	/* and at random: up to 16 sub-cakes, idle, held back or saturated */
+	prandom_seed_state(&rnd, 7609);
+	for (round = 0; round < 200; round++) {
+		u64 demand[CAKE_TEST_TXQS];
+		u32 weight[CAKE_TEST_TXQS];
+		int n = 2 + prandom_u32_state(&rnd) % (CAKE_TEST_TXQS - 1), i;
+
+		for (i = 0; i < n; i++) {
+			switch (prandom_u32_state(&rnd) % 3) {
+			case 0:
+				demand[i] = 0;
+				break;
+			case 1:
+				demand[i] = r / 100 + prandom_u32_state(&rnd) % (r / 2);
+				break;
+			default:
+				demand[i] = U64_MAX;
+			}
+			weight[i] = prandom_u32_state(&rnd) % 4 ? (1 + prandom_u32_state(&rnd) % 8) *
+				    (u / (1 + prandom_u32_state(&rnd) % 8)) : 0;
+		}
+		cake_test_mq_converge(test, mq, demand, weight, n, r);
+	}
+}
