 	 * their parent's) and the 16 KB heap only used when the buffer limit
@@ -648,55 +676,152 @@ static bool cake_ddst(int flow_mode)
 	return (flow_mode & CAKE_FLOW_DUAL_DST) == CAKE_FLOW_DUAL_DST;
 }
 
+/* cake_mq's sub-cakes each count their own hosts' bulk flows, as plain cake
+ * does, but a host's flows can be spread over several of them: its share
+ * has to come from all of them. Each local count is mirrored, change for
+ * change, in the cake_mq's table for its tin, at the bucket of its host
+ * tag; the bucket holds every sub-cake's flows of that host. Hosts whose
+ * tags meet in a bucket are counted together, sharing one host's share
+ * while both have bulk flows. Atomic: the sub-cakes don't share a lock.
+ */
+static atomic_t *cake_mq_host_bucket(atomic_t *load, u32 tag)
+{
+	return &load[tag % CAKE_QUEUES];
+}
+
+/* A host slot taken over by another host's tag with flows still counted:
+ * they move to the new tag's bucket, as they did locally.
+ */
+static void cake_mq_host_retag(atomic_t *load, u32 old_tag, u32 new_tag,
+			       u16 count)
+{
+	if (!load || !count || old_tag == new_tag)
+		return;
+	atomic_sub(count, cake_mq_host_bucket(load, old_tag));
+	atomic_add(count, cake_mq_host_bucket(load, new_tag));
+}
+
+/* In the host-only modes (srchost, dsthost, hosts) each queue is a host's,
+ * or a pair's, and its tag is the host's: a host spread over sub-cakes has
+ * a queue in each. The source table then counts each tag's bulk queues
+ * over all of them, so they share one host's share.
+ */
+static bool cake_mq_host_queues(const struct cake_tin_data *q, int flow_mode)
+{
+	return q->mq_srcload && !(flow_mode & CAKE_FLOW_FLOWS) &&
+	       (flow_mode & CAKE_FLOW_HOSTS);
+}
+
+static atomic_t *cake_mq_queue_bucket(struct cake_tin_data *q,
+				      struct cake_flow *flow)
+{
+	return cake_mq_host_bucket(q->mq_srcload, q->tags[flow - q->flows]);
+}
+
 static void cake_dec_srchost_bulk_flow_count(struct cake_tin_data *q,
 					     struct cake_flow *flow,
 					     int flow_mode)
 {
-	if (likely(cake_dsrc(flow_mode) &&
-		   q->hosts[flow->srchost].srchost_bulk_flow_count))
-		q->hosts[flow->srchost].srchost_bulk_flow_count--;
+	struct cake_host *h = &q->hosts[flow->srchost];
+
+	if (likely(cake_dsrc(flow_mode) && h->srchost_bulk_flow_count)) {
+		h->srchost_bulk_flow_count--;
+		if (q->mq_srcload)
+			atomic_dec(cake_mq_host_bucket(q->mq_srcload,
+						       h->srchost_tag));
+	} else if (cake_mq_host_queues(q, flow_mode)) {
+		atomic_dec(cake_mq_queue_bucket(q, flow));
+	}
 }
 
 static void cake_inc_srchost_bulk_flow_count(struct cake_tin_data *q,
 					     struct cake_flow *flow,
 					     int flow_mode)
 {
+	struct cake_host *h = &q->hosts[flow->srchost];
+
 	if (likely(cake_dsrc(flow_mode) &&
-		   q->hosts[flow->srchost].srchost_bulk_flow_count < CAKE_QUEUES))
-		q->hosts[flow->srchost].srchost_bulk_flow_count++;
+		   h->srchost_bulk_flow_count < CAKE_QUEUES)) {
+		h->srchost_bulk_flow_count++;
+		if (q->mq_srcload)
+			atomic_inc(cake_mq_host_bucket(q->mq_srcload,
+						       h->srchost_tag));
+	} else if (cake_mq_host_queues(q, flow_mode)) {
+		atomic_inc(cake_mq_queue_bucket(q, flow));
+	}
 }
 
 static void cake_dec_dsthost_bulk_flow_count(struct cake_tin_data *q,
 					     struct cake_flow *flow,
 					     int flow_mode)
 {
-	if (likely(cake_ddst(flow_mode) &&
-		   q->hosts[flow->dsthost].dsthost_bulk_flow_count))
-		q->hosts[flow->dsthost].dsthost_bulk_flow_count--;
+	struct cake_host *h = &q->hosts[flow->dsthost];
+
+	if (likely(cake_ddst(flow_mode) && h->dsthost_bulk_flow_count)) {
+		h->dsthost_bulk_flow_count--;
+		if (q->mq_dstload)
+			atomic_dec(cake_mq_host_bucket(q->mq_dstload,
+						       h->dsthost_tag));
+	}
 }
 
 static void cake_inc_dsthost_bulk_flow_count(struct cake_tin_data *q,
 					     struct cake_flow *flow,
 					     int flow_mode)
 {
+	struct cake_host *h = &q->hosts[flow->dsthost];
+
 	if (likely(cake_ddst(flow_mode) &&
-		   q->hosts[flow->dsthost].dsthost_bulk_flow_count < CAKE_QUEUES))
-		q->hosts[flow->dsthost].dsthost_bulk_flow_count++;
+		   h->dsthost_bulk_flow_count < CAKE_QUEUES)) {
+		h->dsthost_bulk_flow_count++;
+		if (q->mq_dstload)
+			atomic_inc(cake_mq_host_bucket(q->mq_dstload,
+						       h->dsthost_tag));
+	}
 }
 
-/* A flow's part of @quantum: shared out between its host's bulk flows */
-static u16 cake_host_share(struct cake_tin_data *q, struct cake_flow *flow,
-			   int flow_mode, u32 quantum)
+/* A host's bulk flows: in this CAKE, or with cake_mq in all its sub-cakes */
+static u16 cake_host_count(atomic_t *load, u32 tag, u16 local)
+{
+	if (!load)
+		return local;
+	return clamp(atomic_read(cake_mq_host_bucket(load, tag)), 1, CAKE_QUEUES);
+}
+
+/* The number of bulk flows a flow's quantum is shared out between: its
+ * source host's, its destination host's, or the larger, by flow mode
+ */
+static u16 cake_host_load(struct cake_tin_data *q, struct cake_flow *flow,
+			  int flow_mode)
 {
 	u16 host_load = 1;
 
-	if (cake_dsrc(flow_mode))
+	if (cake_mq_host_queues(q, flow_mode))
+		return cake_host_count(q->mq_srcload, q->tags[flow - q->flows], 1);
+
+	if (cake_dsrc(flow_mode)) {
+		struct cake_host *h = &q->hosts[flow->srchost];
+
 		host_load = max(host_load,
-				q->hosts[flow->srchost].srchost_bulk_flow_count);
+				cake_host_count(q->mq_srcload, h->srchost_tag,
+						h->srchost_bulk_flow_count));
+	}
+
+	if (cake_ddst(flow_mode)) {
+		struct cake_host *h = &q->hosts[flow->dsthost];
 
-	if (cake_ddst(flow_mode))
 		host_load = max(host_load,
-				q->hosts[flow->dsthost].dsthost_bulk_flow_count);
+				cake_host_count(q->mq_dstload, h->dsthost_tag,
+						h->dsthost_bulk_flow_count));
+	}
+	return host_load;
+}
+
+/* A flow's part of @quantum: shared out between its host's bulk flows */
+static u16 cake_host_share(struct cake_tin_data *q, struct cake_flow *flow,
+			   int flow_mode, u32 quantum)
+{
+	u16 host_load = cake_host_load(q, flow, flow_mode);
 
 	/* quantum_div[1] stands for 65536, which doesn't fit in a u16: a host
 	 * with one bulk flow gives it the whole quantum, no dither needed.
@@ -738,6 +863,21 @@ static u16 cake_get_bulk_quantum(struct cake_sched_data *qd,
 	return cake_host_share(b, flow, qd->config->flow_mode, quantum);
 }
 
+/* cake_mq: what a flow in the bulk rotation adds to its sub-cake's bid for
+ * the rate. It's the flow's part of a DRR pass, 65535 / its host load, so
+ * the sub-cakes' weights compare as plain cake shares the rate out: per
+ * flow, and with host isolation per host, whichever sub-cakes the flows
+ * are in. Set at each refill of the flow's deficit, cleared when it leaves
+ * the rotation.
+ */
+static void cake_mq_set_weight(struct cake_tin_data *b, struct cake_flow *flow,
+			       u16 weight)
+{
+	b->mq_weight += weight;
+	b->mq_weight -= flow->mq_weight;
+	flow->mq_weight = weight;
+}
+
 static void cake_keys_host_hashes(const struct flow_keys *keys,
 				  u32 *srchost_hash, u32 *dsthost_hash)
 {
@@ -918,6 +1058,11 @@ skip_hash:
 		if (q->flows[outer_hash + k].set == CAKE_SET_BULK) {
 			cake_dec_srchost_bulk_flow_count(q, &q->flows[outer_hash + k], flow_mode);
 			cake_dec_dsthost_bulk_flow_count(q, &q->flows[outer_hash + k], flow_mode);
+			/* a host-only queue's count goes with its tag */
+			if (cake_mq_host_queues(q, flow_mode)) {
+				q->tags[outer_hash + k] = flow_hash;
+				cake_inc_srchost_bulk_flow_count(q, &q->flows[outer_hash + k], flow_mode);
+			}
 		}
 found:
 		/* reserve queue for future packets in same flow */
@@ -943,6 +1088,10 @@ found:
 				if (!q->hosts[outer_hash + k].srchost_bulk_flow_count)
 					break;
 			}
+			cake_mq_host_retag(q->mq_srcload,
+					   q->hosts[outer_hash + k].srchost_tag,
+					   srchost_hash,
+					   q->hosts[outer_hash + k].srchost_bulk_flow_count);
 			q->hosts[outer_hash + k].srchost_tag = srchost_hash;
 found_src:
 			srchost_idx = outer_hash + k;
@@ -967,6 +1116,10 @@ found_src:
 				if (!q->hosts[outer_hash + k].dsthost_bulk_flow_count)
 					break;
 			}
+			cake_mq_host_retag(q->mq_dstload,
+					   q->hosts[outer_hash + k].dsthost_tag,
+					   dsthost_hash,
+					   q->hosts[outer_hash + k].dsthost_bulk_flow_count);
 			q->hosts[outer_hash + k].dsthost_tag = dsthost_hash;
 found_dst:
 			dsthost_idx = outer_hash + k;
@@ -1626,6 +1779,10 @@ static int cake_advance_shaper(struct cake_sched_data *q,
 			q->failsafe_next_packet = \
 				ktime_add_ns(q->failsafe_next_packet,
 					     failsafe_dur);
+		if (q->config->is_shared) {
+			q->mq_bytes += len;
+			q->mq_packets++;
+		}
 	}
 	return len;
 }
@@ -1841,19 +1998,147 @@ static void cake_mq_mark_used(struct Qdisc *sch, struct cake_sched_data *q)
 		set_bit(ntx, used);
 }
 
+/* cake_mq's share of the rate. At each resync, a busy sub-cake reads the
+ * other active ones and takes
+ *
+ *	share = sparse + (rate - used) * bid / (bid + the saturated's bids)
+ *
+ * - An unsaturated sub-cake, one that used less than its share lately
+ *   (averaged over cake_mq_idle_after()), keeps what it uses: that's taken off the rate
+ *   ("used"), and the others share out the rest. So a share one can't use
+ *   goes to those that can, within a few milliseconds.
+ * - The saturated ones, and this one, split what's left by their bulk
+ *   weights (cake_mq_set_weight()), after each one's sparse flows, which
+ *   are served first as in one CAKE. The flows then get what one CAKE
+ *   would give them.
+ * - A sub-cake with no bulk flow bids as one host's only flow, so it can
+ *   grow into a share; what it doesn't use stays with the others.
+ *
+ * Each sub-cake takes its own share; together they add up to the rate,
+ * give or take how far the averages lag. A share is never above the rate,
+ * and never below what it would be if every sub-cake wanted more: its
+ * sparse flows and its bid's part of what everyone's sparse flows leave.
+ * That's the least one CAKE would give the same flows, and holds a share
+ * up while another sub-cake's average catches up with it slowing down.
+ * Everything is read lockless, as the queue lengths are.
+ */
+#define CAKE_MQ_UNIT	65535			/* a host's only bulk flow */
+#define CAKE_MQ_TAU	(2 * NSEC_PER_MSEC)	/* the shortest time scale */
+
+struct cake_mq_peers {
+	u64	unsat_usage;	/* bytes/s the unsaturated use */
+	u64	sat_sparse;	/* bytes/s of the saturated's sparse flows */
+	u64	sparse;		/* everyone's, for the floor */
+	u64	sat_bids;
+	u64	bids;		/* everyone's, for the floor */
+	u32	count;		/* active sub-cakes, ours included */
+};
+
+static u64 cake_mq_bid(u32 weight)
+{
+	return weight ?: CAKE_MQ_UNIT;
+}
+
+static u64 cake_mq_share(u64 rate, u32 weight, u64 sparse,
+			 const struct cake_mq_peers *p)
+{
+	u64 bid = cake_mq_bid(weight);
+	u64 used = p->unsat_usage + p->sat_sparse + sparse;
+	u64 all_sparse = p->sparse + sparse;
+	u64 share = sparse, floor = sparse;
+
+	if (p->count <= 1 || !rate)
+		return rate;
+	if (used < rate)
+		share += mul_u64_u64_div_u64(rate - used, bid, bid + p->sat_bids);
+	if (all_sparse < rate)
+		floor += mul_u64_u64_div_u64(rate - all_sparse, bid, bid + p->bids);
+	return clamp(max(share, floor), 1ULL, rate);
+}
+
+/* @bytes over the last @dt ns, as bytes/s, folded into @avg: an average
+ * over @tau ns, which a gap that long starts again.
+ */
+static u64 cake_mq_ewma(u64 avg, u64 bytes, u64 dt, u64 tau)
+{
+	s64 delta;
+
+	if (dt >= tau)
+		return mul_u64_u64_div_u64(bytes, NSEC_PER_SEC, dt);
+	/* avg += (bytes / dt - avg) * dt / tau */
+	delta = (s64)(bytes * NSEC_PER_SEC) - (s64)(avg * dt);
+	return avg + div64_s64(delta, tau);
+}
+
+/* A sub-cake's time scale: four of its packet intervals, from 2 ms to
+ * 100 ms. A flow of 2 Mbit/s sends a full-sized packet every 6 ms: its use
+ * of the rate is averaged over that long (a rate needs a few packets to
+ * be seen), and it counts as idle only after that long without one.
+ * Counting it after it stops holds back at most four packets' worth.
+ */
+#define CAKE_MQ_TAU_MAX	(100 * NSEC_PER_MSEC)
+
+static u64 cake_mq_idle_after(u64 idle, u64 bytes, u32 packets, u64 usage)
+{
+	if (!packets || !usage)
+		return idle ?: CAKE_MQ_TAU;
+	idle = mul_u64_u64_div_u64(4 * div_u64(bytes, packets), NSEC_PER_SEC, usage);
+	return clamp_t(u64, idle, CAKE_MQ_TAU, CAKE_MQ_TAU_MAX);
+}
+
+/* At a resync: what @q used since the last one and its bulk weight, for
+ * the other sub-cakes to read, and whether it wants more than its share:
+ * it used 31/32 of it, or 7/8 with its shaper holding packets back lately.
+ * A TCP flow held back by its share averages 85-95% of it; a stream below
+ * its share never waits.
+ */
+static void cake_mq_publish(struct cake_sched_data *q, u64 now)
+{
+	u64 dt = now - q->last_checked_active;
+	u64 tau = q->mq_idle ?: CAKE_MQ_TAU;
+	u64 usage, sparse, idle;
+	u32 weight = 0;
+	u16 tin;
+
+	for (tin = 0; tin < q->tin_cnt; tin++)
+		weight += q->tins[tin].mq_weight;
+	usage = cake_mq_ewma(q->mq_usage, q->mq_bytes, dt, tau);
+	sparse = cake_mq_ewma(q->mq_sparse, q->mq_sparse_bytes, dt, tau);
+	idle = cake_mq_idle_after(q->mq_idle, q->mq_bytes, q->mq_packets, usage);
+	q->mq_bytes = 0;
+	q->mq_sparse_bytes = 0;
+	q->mq_packets = 0;
+
+	WRITE_ONCE(q->mq_usage, usage);
+	WRITE_ONCE(q->mq_sparse, min(sparse, usage));
+	WRITE_ONCE(q->mq_idle, idle);
+	WRITE_ONCE(q->mq_weight, weight);
+	WRITE_ONCE(q->mq_saturated,
+		   usage >= q->synced_rate - (q->synced_rate >> 5) ||
+		   (now - q->mq_held_at < tau &&
+		    usage >= q->synced_rate - (q->synced_rate >> 3)));
+}
+
 /* The sub-cakes sharing the rate with @q, @q included: those on the
- * device's real tx queues with packets queued, or sent since @q last counted.
+ * device's real tx queues with packets queued, or not yet idle
