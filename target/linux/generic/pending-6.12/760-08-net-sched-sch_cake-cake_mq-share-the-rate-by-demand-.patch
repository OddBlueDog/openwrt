+/* Sub-cakes with uneven demands (bytes/s; 0: idle; U64_MAX: all it can
+ * get) and bulk weights, each resyncing every 200 us as cake_dequeue()
+ * does and sending at the lower of its demand and its share. What one
+ * CAKE's DRR would give them is weighted max-min: each gets what it asks
+ * for up to a level set by its weight, and the rate is all used if
+ * they ask for that much.
+ */
+static void cake_test_mq_fair_levels(const u64 *demand, const u32 *weight,
+				     int n, u64 rate, u64 *want)
+{
+	bool fixed[CAKE_TEST_TXQS] = {};
+	u64 left = rate;
+	bool again = true;
+	int i;
+
+	while (again) {
+		u64 w = 0;
+
+		again = false;
+		for (i = 0; i < n; i++)
+			if (!fixed[i] && demand[i])
+				w += cake_mq_bid(weight[i]);
+		for (i = 0; i < n; i++) {
+			if (fixed[i] || !demand[i])
+				continue;
+			want[i] = mul_u64_u64_div_u64(left, cake_mq_bid(weight[i]), w);
+			if (demand[i] <= want[i]) {
+				want[i] = demand[i];
+				fixed[i] = true;
+				left -= demand[i];
+				again = true;
+				break;
+			}
+		}
+	}
+	for (i = 0; i < n; i++)
+		if (!demand[i])
+			want[i] = 0;
+}
+
+static void cake_test_mq_converge(struct kunit *test, struct cake_test_mq *mq,
+				  const u64 *demand, const u32 *weight, int n,
+				  u64 rate)
+{
+	const u64 step = 200 * NSEC_PER_USEC;
+	u64 sent[CAKE_TEST_TXQS] = {}, want[CAKE_TEST_TXQS], got = 0, asked = 0;
+	u64 now = 10 * NSEC_PER_MSEC;
+	int t, k, i;
+
+	mq->dev->real_num_tx_queues = CAKE_TEST_TXQS;
+	bitmap_zero(mq->cfg->used_qs, CAKE_TEST_TXQS);
+	mq->cfg->rate_bps = rate;
+	for (i = 0; i < CAKE_TEST_TXQS; i++) {
+		struct cake_sched_data *q = cake_test_mq_q(mq, i);
+
+		mq->sch[i]->q.qlen = 0;
+		q->tin_cnt = 1;
+		q->tins[0].mq_weight = i < n ? weight[i] : 0;
+		q->synced_rate = rate;
+		q->last_checked_active = now - step;
+		q->last_active = 0;
+		q->mq_usage = q->mq_sparse = q->mq_bytes = q->mq_sparse_bytes = 0;
+		q->mq_idle = 0;
+		q->mq_packets = 0;
+		q->mq_held_at = 0;
+		q->mq_weight = 0;
+		q->mq_saturated = false;
+		if (i < n && demand[i]) {
+			cake_test_mq_enqueue(mq, i);
+			mq->sch[i]->q.qlen = 1;
+		}
+	}
+
+	for (t = 0; t < 150; t++) {
+		now += step;
+		for (k = 0; k < n; k++) {
+			/* not always in the same order */
+			int i = (k + t) % n;
+			struct cake_sched_data *q = cake_test_mq_q(mq, i);
+			struct cake_mq_peers p;
+			u64 rate_i, share;
+
+			if (!demand[i])
+				continue;
+			rate_i = min(demand[i], q->synced_rate);
+			/* asking for more than it may send: its shaper holds packets */
+			if (demand[i] > q->synced_rate)
+				q->mq_held_at = now - step / 2;
+			if (t >= 100)
+				sent[i] += rate_i;
+			q->mq_bytes = div64_u64(rate_i * step, NSEC_PER_SEC);
+			q->last_active = now;
+			cake_mq_publish(q, now);
+			cake_test_mq_peers(mq, i, now, &p);
+			share = cake_mq_share(rate, q->mq_weight, q->mq_sparse, &p);
+			if (cake_mq_share_moved(share, q->synced_rate, rate))
+				q->synced_rate = share;
+			q->last_checked_active = now;
+		}
+	}
+
+	cake_test_mq_fair_levels(demand, weight, n, rate, want);
+	for (i = 0; i < n; i++) {
+		sent[i] /= 50;
+		got += sent[i];
+		asked += min(demand[i], rate);
+		/* each within 3% of the rate of its fair level */
+		KUNIT_EXPECT_LE_MSG(test, abs((s64)sent[i] - (s64)want[i]), rate / 50,
+				    "sub-cake %d of %d: %llu, fair %llu (demand %llu, weight %u)",
+				    i, n, sent[i], want[i], demand[i], weight[i]);
+	}
+	/* all of the rate in use, when it's asked for */
+	KUNIT_EXPECT_LE(test, got, rate + rate / 100);
+	KUNIT_EXPECT_GE(test, got, min(asked, rate) - min(asked, rate) * 3 / 100);
+}
