+/* cake_mq's host loads: four sub-cakes' tin 0, one host table between them */
+struct cake_test_hosts {
+	struct cake_sched_config cfg;
+	struct cake_sched_data *q[4];
+	atomic_t *hosts;
+};
+
+static struct cake_test_hosts *cake_test_hosts_alloc(struct kunit *test)
+{
+	struct cake_test_hosts *h = cake_test_alloc(test, sizeof(*h));
+	int i;
+
+	h->cfg.is_shared = 1;
+	h->cfg.flow_mode = CAKE_FLOW_TRIPLE;
+	h->hosts = cake_test_alloc(test, 2 * CAKE_MAX_TINS * CAKE_QUEUES * sizeof(atomic_t));
+	h->cfg.mq_hosts = h->hosts;
+	for (i = 0; i < 4; i++) {
+		struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+		struct cake_tin_data *b;
+
+		q->tins = cake_test_alloc(test, CAKE_MAX_TINS * sizeof(*q->tins));
+		q->tin_cnt = 1;
+		q->config = &h->cfg;
+		b = &q->tins[0];
+		INIT_LIST_HEAD(&b->new_flows);
+		INIT_LIST_HEAD(&b->old_flows);
+		INIT_LIST_HEAD(&b->decaying_flows);
+		cake_mq_set_host_tables(q, h->hosts);
+		h->q[i] = q;
+	}
+	return h;
+}
+
+/* A packet from LAN host @host, port @sport, to 1.1.1.1 into tin @b, its
+ * flow then going bulk with a refill, as cake_dequeue() does
+ */
+static struct cake_flow *cake_test_bulk_flow(struct kunit *test,
+					     struct cake_tin_data *b, int mode,
+					     u8 host, u16 sport)
+{
+	struct sk_buff *skb = cake_test_skb(test, false, IPPROTO_TCP, host, sport, 0);
+	struct cake_flow *flow = &b->flows[cake_hash(b, skb, mode, 0, 0)];
+
+	if (flow->set == CAKE_SET_BULK)
+		return flow;
+	list_add_tail(&flow->flowchain, &b->old_flows);
+	flow->set = CAKE_SET_BULK;
+	b->bulk_flow_count++;
+	cake_inc_srchost_bulk_flow_count(b, flow, mode);
+	cake_inc_dsthost_bulk_flow_count(b, flow, mode);
+	cake_mq_set_weight(b, flow, quantum_div[cake_host_load(b, flow, mode)]);
+	return flow;
+}
+
+static struct cake_flow *cake_test_hosts_bulk(struct kunit *test,
+					      struct cake_test_hosts *h, int s,
+					      u8 host, u16 sport)
+{
+	return cake_test_bulk_flow(test, &h->q[s]->tins[0], h->cfg.flow_mode,
+				   host, sport);
+}
+
+/* Every bucket holds what the sub-cakes count under its tags */
+static void cake_test_hosts_check(struct kunit *test, struct cake_test_hosts *h)
+{
+	int (*sums)[CAKE_QUEUES] = kcalloc(2, sizeof(*sums), GFP_KERNEL);
+	int s, k;
+
+	KUNIT_ASSERT_NOT_NULL(test, sums);
+
+	for (s = 0; s < 4; s++) {
+		struct cake_tin_data *b = &h->q[s]->tins[0];
+		u32 weight = 0;
+
+		for (k = 0; k < CAKE_QUEUES; k++) {
+			sums[0][b->hosts[k].srchost_tag % CAKE_QUEUES] +=
+				b->hosts[k].srchost_bulk_flow_count;
+			sums[1][b->hosts[k].dsthost_tag % CAKE_QUEUES] +=
+				b->hosts[k].dsthost_bulk_flow_count;
+			weight += b->flows[k].mq_weight;
+		}
+		KUNIT_EXPECT_EQ(test, b->mq_weight, weight);
+	}
+	for (k = 0; k < CAKE_QUEUES; k++) {
+		KUNIT_EXPECT_EQ(test, atomic_read(&h->hosts[k]), sums[0][k]);
+		KUNIT_EXPECT_EQ(test, atomic_read(&h->hosts[CAKE_QUEUES + k]), sums[1][k]);
+	}
+	kfree(sums);
+}
+
+/* A host's flows in two sub-cakes are shared out as one host's */
+static void cake_test_mq_host_load_shared(struct kunit *test)
+{
+	struct cake_test_hosts *h = cake_test_hosts_alloc(test);
+	struct cake_flow *a[2], *b[3], *other;
+	int i;
+
+	for (i = 0; i < 2; i++)
+		a[i] = cake_test_hosts_bulk(test, h, 0, 5, 40000 + i);
+	for (i = 0; i < 3; i++)
+		b[i] = cake_test_hosts_bulk(test, h, 1, 5, 41000 + i);
+	cake_test_hosts_check(test, h);
+
+	/* host 5 has 2 bulk flows here and 3 there: 5 in all, as one CAKE sees */
+	KUNIT_EXPECT_EQ(test, h->q[0]->tins[0].hosts[a[0]->srchost].srchost_bulk_flow_count, 2);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], a[0], CAKE_FLOW_TRIPLE), 5);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[1]->tins[0], b[0], CAKE_FLOW_DUAL_SRC), 5);
+	/* plain cake, no host table: its own count */
+	h->q[0]->tins[0].mq_srcload = NULL;
+	h->q[0]->tins[0].mq_dstload = NULL;
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], a[0], CAKE_FLOW_TRIPLE), 2);
+	cake_mq_set_host_tables(h->q[0], h->hosts);
+
+	/* refills weigh each flow 1/5 of a host */
+	cake_mq_set_weight(&h->q[0]->tins[0], a[1], quantum_div[5]);
+	KUNIT_EXPECT_EQ(test, a[1]->mq_weight, 65535 / 5);
+
+	/* another LAN host's flow next to them: alone at its end, but the
+	 * server's sixth flow (triple-isolate); its own host's only one by
+	 * source alone (dual-srchost)
+	 */
+	other = cake_test_hosts_bulk(test, h, 0, 6, 40000);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], other, CAKE_FLOW_TRIPLE), 6);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], other, CAKE_FLOW_DUAL_SRC), 1);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], other, CAKE_FLOW_DUAL_DST), 6);
+
+	/* two of host 5's flows there go: 3 left for the ones here */
+	cake_flow_emptied(h->q[1], &h->q[1]->tins[0], b[0], 0);
+	cake_flow_emptied(h->q[1], &h->q[1]->tins[0], b[1], 0);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], a[0], CAKE_FLOW_DUAL_SRC), 3);
+	KUNIT_EXPECT_EQ(test, b[0]->mq_weight, 0);
+	cake_test_hosts_check(test, h);
+}
+
+/* The host-only modes: a host with a queue in two sub-cakes gets one host's
+ * share between them
+ */
+static void cake_test_mq_host_queues(struct kunit *test)
+{
+	struct cake_test_hosts *h = cake_test_hosts_alloc(test);
+	struct cake_tin_data *b0 = &h->q[0]->tins[0], *b1 = &h->q[1]->tins[0];
+	const int mode = CAKE_FLOW_SRC_IP;
+	struct cake_flow *a, *b, *c;
+	int i;
+
+	h->cfg.flow_mode = mode;
+	a = cake_test_hosts_bulk(test, h, 0, 5, 40000);
+	b = cake_test_hosts_bulk(test, h, 1, 5, 41000);
+	c = cake_test_hosts_bulk(test, h, 0, 6, 40000);
+	KUNIT_EXPECT_EQ(test, cake_host_load(b0, a, mode), 2);
+	KUNIT_EXPECT_EQ(test, cake_host_load(b1, b, mode), 2);
+	KUNIT_EXPECT_EQ(test, cake_host_load(b0, c, mode), 1);
+	/* at their next refills, half a host each against a whole one */
+	cake_mq_set_weight(b0, a, quantum_div[cake_host_load(b0, a, mode)]);
+	KUNIT_EXPECT_EQ(test, b0->mq_weight, 65535 / 2 + 65535);
+	b0->flow_quantum = 1514;
+	KUNIT_EXPECT_EQ(test, cake_get_flow_quantum(b0, c, mode), 1514);
+	KUNIT_EXPECT_LE(test, abs(cake_get_flow_quantum(b0, a, mode) - 1514 / 2), 1);
+
+	/* host 5's queue in sub-cake 1 goes: the one here has it all again */
+	cake_flow_emptied(h->q[1], b1, b, 0);
+	KUNIT_EXPECT_EQ(test, cake_host_load(b0, a, mode), 1);
+	/* plain cake: a queue is a host's, whatever */
+	b0->mq_srcload = NULL;
+	KUNIT_EXPECT_EQ(test, cake_host_load(b0, a, mode), 1);
+	cake_mq_set_host_tables(h->q[0], h->hosts);
+
+	cake_mq_retire_tin(h->q[0], b0, 0);
+	for (i = 0; i < 2 * CAKE_QUEUES; i++)
+		KUNIT_ASSERT_EQ(test, atomic_read(&h->hosts[i]), 0);
+	KUNIT_EXPECT_EQ(test, b0->mq_weight, 0);
+}
