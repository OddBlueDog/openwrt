+/* A share that grows shortens the shaper's wait at once, and a waiting
+ * sub-cake wakes within CAKE_MQ_TAU to work its share out again
+ */
+static void cake_test_mq_rescale_wait(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	struct cake_sched_config *cfg = cake_test_alloc(test, sizeof(*cfg));
+	const ktime_t now = 1000 * NSEC_PER_MSEC, ms = NSEC_PER_MSEC;
+
+	/* 10 ms left at a share that then doubles: 5 ms */
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(now + 10 * ms, now, 1000, 2000), now + 5 * ms);
+	/* one that halves: 20 ms, as the share now says */
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(now + 10 * ms, now, 2000, 1000), now + 20 * ms);
+	/* up and down again: back where it was */
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(cake_mq_rescale_wait(now + 10 * ms, now, 1000, 3000),
+						   now, 3000, 1000), now + 10 * ms - 1);
+	/* nothing left to wait: unchanged; nor beyond a second */
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(now - 1, now, 1000, 2000), now - 1);
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(now + 10 * ms, now, CAKE_TEST_RATE, 1),
+			now + NSEC_PER_SEC);
+	/* a packet sent at a near-zero share pushed the next one 10 s ahead */
+	KUNIT_EXPECT_EQ(test, cake_mq_rescale_wait(now + 10 * NSEC_PER_SEC, now, 10,
+						   CAKE_TEST_RATE), now + 1000);
+
+	q->config = cfg;
+	cfg->is_shared = 1;
+	KUNIT_EXPECT_EQ(test, cake_mq_wake_by(q, now + 50 * ms, now), now + CAKE_MQ_TAU);
+	KUNIT_EXPECT_EQ(test, cake_mq_wake_by(q, now + ms, now), now + ms);
+	/* plain cake waits for its shaper */
+	cfg->is_shared = 0;
+	KUNIT_EXPECT_EQ(test, cake_mq_wake_by(q, now + 50 * ms, now), now + 50 * ms);
+}
