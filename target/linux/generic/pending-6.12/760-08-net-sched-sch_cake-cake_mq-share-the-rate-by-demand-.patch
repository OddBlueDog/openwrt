+/* A sub-cake out of packets retires its bulk rotation: its flows leave the
+ * host loads and its weight, the other sub-cakes' stay
+ */
+static void cake_test_mq_retire_on_idle(struct kunit *test)
+{
+	struct cake_test_hosts *h = cake_test_hosts_alloc(test);
+	struct cake_tin_data *b = &h->q[2]->tins[0];
+	struct cake_flow *keep;
+	int i;
+
+	keep = cake_test_hosts_bulk(test, h, 0, 5, 40000);
+	for (i = 0; i < 6; i++)
+		cake_test_hosts_bulk(test, h, 2, 5 + i % 2, 42000 + i);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], keep, CAKE_FLOW_DUAL_SRC), 4);
+	KUNIT_EXPECT_NE(test, b->mq_weight, 0);
+
+	cake_mq_retire_tin(h->q[2], b, 0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&b->old_flows));
+	KUNIT_EXPECT_EQ(test, b->bulk_flow_count, 0);
+	KUNIT_EXPECT_EQ(test, b->mq_weight, 0);
+	KUNIT_EXPECT_EQ(test, cake_host_load(&h->q[0]->tins[0], keep, CAKE_FLOW_DUAL_SRC), 1);
+	KUNIT_EXPECT_NE(test, h->q[0]->tins[0].mq_weight, 0);
+	cake_test_hosts_check(test, h);
+}
