+/* cake_mq's share of the rate */
+
+#define CAKE_TEST_RATE	100000000ULL	/* 800 Mbit/s, in bytes/s */
+#define CAKE_TEST_UNIT	((u32)CAKE_MQ_UNIT)
+
+/* Alone, a sub-cake has the whole rate; unlimited stays unlimited */
+static void cake_test_mq_share_alone(struct kunit *test)
+{
+	struct cake_mq_peers p = { .count = 1 };
+
+	KUNIT_EXPECT_EQ(test, cake_mq_share(CAKE_TEST_RATE, 3 * CAKE_TEST_UNIT, 5000, &p),
+			CAKE_TEST_RATE);
+	p.count = 3;
+	p.bids = 2 * CAKE_TEST_UNIT;
+	p.sat_bids = 2 * CAKE_TEST_UNIT;
+	KUNIT_EXPECT_EQ(test, cake_mq_share(0, CAKE_TEST_UNIT, 0, &p), 0);
+}
+
+/* All saturated: the rate split by weight, all of it */
+static void cake_test_mq_share_by_weight(struct kunit *test)
+{
+	static const u32 cases[][4] = {
+		/* one flow against seven, one host (triple-isolate, one server) */
+		{ 65535 / 8, 7 * (65535 / 8) },
+		/* two LAN hosts, one flow against four (dual-dsthost) */
+		{ 65535, 4 * (65535 / 4) },
+		/* eight flows against two: the 80/20 imbalance */
+		{ 8 * 65535, 2 * 65535 },
+		/* even */
+		{ 65535, 65535, 65535, 65535 },
+	};
+	int c, i, j;
+
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		u64 total = 0, sum = 0;
+		int n = 0;
+
+		for (i = 0; i < 4 && cases[c][i]; i++, n++)
+			total += cases[c][i];
+		for (i = 0; i < n; i++) {
+			struct cake_mq_peers p = { .count = n };
+			u64 share, want;
+
+			for (j = 0; j < n; j++) {
+				if (j == i)
+					continue;
+				p.bids += cases[c][j];
+				p.sat_bids += cases[c][j];
 			}
+			share = cake_mq_share(CAKE_TEST_RATE, cases[c][i], 0, &p);
+			want = div64_u64(CAKE_TEST_RATE * cases[c][i], total);
+			KUNIT_EXPECT_LE(test, share, want);
+			KUNIT_EXPECT_GE(test, share + 1, want);
+			sum += share;
+		}
+		KUNIT_EXPECT_LE(test, sum, CAKE_TEST_RATE);
+		KUNIT_EXPECT_GE(test, sum + n, CAKE_TEST_RATE);
+	}
+}
+
+/* What an unsaturated sub-cake doesn't use goes to the others */
+static void cake_test_mq_share_lends(struct kunit *test)
+{
+	const u64 rate = CAKE_TEST_RATE;
+	struct cake_mq_peers p;
+	u64 used;
+
+	/* the 80/20 imbalance, a flood each: the other one uses 20%, this one
+	 * gets the 80% it brings, not half
+	 */
+	p = (struct cake_mq_peers){ .count = 2, .bids = CAKE_TEST_UNIT,
+				    .unsat_usage = rate / 5 };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT, 0, &p), rate - rate / 5);
+	/* ... and the 20% one is offered half, room to grow */
+	p = (struct cake_mq_peers){ .count = 2, .bids = CAKE_TEST_UNIT,
+				    .sat_bids = CAKE_TEST_UNIT };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT, 0, &p), rate / 2);
+
+	/* three unsaturated others: all the rest, whatever this one's weight */
+	used = rate / 10 + rate / 20 + rate / 4;
+	p = (struct cake_mq_peers){ .count = 4, .bids = 3 * CAKE_TEST_UNIT,
+				    .unsat_usage = used };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT / 8, 0, &p), rate - used);
+
+	/* only sparse flows here (no bulk weight), 8 bulk flows saturated
+	 * elsewhere: offered what a ninth flow would get, on top of its own
+	 */
+	p = (struct cake_mq_peers){ .count = 2, .bids = 8 * CAKE_TEST_UNIT,
+				    .sat_bids = 8 * CAKE_TEST_UNIT };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, 0, rate / 100, &p),
+			rate / 100 + div64_u64(rate - rate / 100, 9));
+}
+
+/* Sparse flows first, as in one CAKE: here a stream at 10% next to 4 bulk
+ * flows, and 4 bulk flows in another sub-cake. One CAKE gives the stream
+ * its 10% and each bulk flow 11.25%.
+ */
+static void cake_test_mq_share_sparse(struct kunit *test)
+{
+	const u64 rate = CAKE_TEST_RATE, sparse = rate / 10;
+	struct cake_mq_peers pa = { .count = 2, .bids = 4 * CAKE_TEST_UNIT,
+				    .sat_bids = 4 * CAKE_TEST_UNIT };
+	struct cake_mq_peers pb = { .count = 2, .bids = 4 * CAKE_TEST_UNIT,
+				    .sat_bids = 4 * CAKE_TEST_UNIT, .sat_sparse = sparse,
+				    .sparse = sparse };
+	u64 a = cake_mq_share(rate, 4 * CAKE_TEST_UNIT, sparse, &pa);
+	u64 b = cake_mq_share(rate, 4 * CAKE_TEST_UNIT, 0, &pb);
+
+	KUNIT_EXPECT_EQ(test, a, sparse + (rate - sparse) / 2);
+	KUNIT_EXPECT_EQ(test, b, (rate - sparse) / 2);
+	KUNIT_EXPECT_EQ(test, a + b, rate);
+}
+
+/* An average that hasn't caught up: never below what every sub-cake
+ * wanting more would leave this one
+ */
+static void cake_test_mq_share_floor(struct kunit *test)
+{
+	const u64 rate = CAKE_TEST_RATE;
+	struct cake_mq_peers p;
+
+	/* two others still average 60% each */
+	p = (struct cake_mq_peers){ .count = 3, .bids = 2 * CAKE_TEST_UNIT,
+				    .unsat_usage = 2 * (rate * 3 / 5) };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT, 0, &p), rate / 3);
+	/* one of them, a stream at 10%, all sparse: the floor leaves it out */
+	p = (struct cake_mq_peers){ .count = 3, .bids = 2 * CAKE_TEST_UNIT,
+				    .unsat_usage = rate / 10 + rate * 19 / 20,
+				    .sparse = rate / 10 };
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT, 0, &p),
+			(rate - rate / 10) / 3);
+	/* and this one's own sparse flows come first */
+	KUNIT_EXPECT_EQ(test, cake_mq_share(rate, CAKE_TEST_UNIT, rate / 20, &p),
+			rate / 20 + (rate - rate / 10 - rate / 20) / 3);
+}
+
+/* Any rate, weights and usage: a share from 1 to the rate, at least the
+ * split by bids, and no bulk weight bids as one flow
+ */
+static void cake_test_mq_share_limits(struct kunit *test)
+{
+	struct rnd_state rnd;
+	int round;
+
+	prandom_seed_state(&rnd, 7608);
+	for (round = 0; round < 5000; round++) {
+		u64 rate = (((u64)prandom_u32_state(&rnd) << 32) |
+			    prandom_u32_state(&rnd)) >> (4 + prandom_u32_state(&rnd) % 60);
+		u32 weight = prandom_u32_state(&rnd) % (8 * 1024 * 65536);
+		u64 sparse = rate ? prandom_u32_state(&rnd) % (rate + 1) : 0;
+		struct cake_mq_peers p = {
+			.count = 2 + prandom_u32_state(&rnd) % 15,
+			.sat_bids = prandom_u32_state(&rnd) % (16 * 1024 * 65536),
+			.unsat_usage = rate ? (u64)prandom_u32_state(&rnd) * 2 * (rate >> 32) +
+					      prandom_u32_state(&rnd) % (rate + 1) : 0,
+			.sat_sparse = rate ? prandom_u32_state(&rnd) % (rate + 1) : 0,
+		};
+		u64 share, floor = sparse;
+
+		p.bids = p.sat_bids + prandom_u32_state(&rnd) % (8 * 65536);
+		p.sparse = p.sat_sparse + (rate ? prandom_u32_state(&rnd) % (rate + 1) : 0);
+		share = cake_mq_share(rate, weight, sparse, &p);
+		if (!rate) {
+			KUNIT_ASSERT_EQ(test, share, 0);
+			continue;
+		}
+		if (p.sparse + sparse < rate)
+			floor += mul_u64_u64_div_u64(rate - p.sparse - sparse,
+						     cake_mq_bid(weight),
+						     cake_mq_bid(weight) + p.bids);
+		KUNIT_ASSERT_GE(test, share, 1);
+		KUNIT_ASSERT_LE(test, share, rate);
+		KUNIT_ASSERT_GE(test, share, min(floor, rate));
+		if (!weight)
+			KUNIT_ASSERT_EQ(test, share,
+					cake_mq_share(rate, CAKE_MQ_UNIT, sparse, &p));
+	}
+}
+
+/* The usage averages: they settle on a steady rate, start again after a
+ * gap, and don't overflow at 10 Gbit/s over their longest time scale
+ */
+static void cake_test_mq_ewma(struct kunit *test)
+{
+	const u64 us = NSEC_PER_USEC;
+	u64 avg = 0, prev;
+	int i;
+
+	/* 100 MB/s, 20 KB per 200 us: within 1% after 10 time constants */
+	for (i = 0; i < 100; i++)
+		avg = cake_mq_ewma(avg, 20000, 200 * us, CAKE_MQ_TAU);
+	KUNIT_EXPECT_LE(test, abs((s64)avg - 100000000), 1000000);
+	/* falls with nothing sent, never below 0 */
+	for (i = 0; i < 200; i++) {
+		prev = avg;
+		avg = cake_mq_ewma(avg, 0, 200 * us, CAKE_MQ_TAU);
+		KUNIT_ASSERT_LE(test, avg, prev);
+	}
+	KUNIT_EXPECT_LE(test, avg, 1000);
+	/* a gap of a time constant or more: the last window alone */
+	KUNIT_EXPECT_EQ(test, cake_mq_ewma(12345678, 1000, CAKE_MQ_TAU, CAKE_MQ_TAU), 500000);
+	KUNIT_EXPECT_EQ(test, cake_mq_ewma(12345678, 0, 10 * NSEC_PER_SEC, CAKE_MQ_TAU), 0);
+	/* 2 Mbit/s, a packet every 6 ms, resyncs every 2 ms in between: a
+	 * steady average over 24 ms, within 10%
+	 */
+	avg = 250000;
+	for (i = 0; i < 300; i++) {
+		avg = cake_mq_ewma(avg, i % 3 ? 0 : 1514, 2000 * us, 24000 * us);
+		if (i >= 30)
+			KUNIT_ASSERT_LE(test, abs((s64)avg - 252333), 25233);
+	}
+	/* 10 Gbit/s over the longest time scale */
+	avg = 0;
+	for (i = 0; i < 1000; i++)
+		avg = cake_mq_ewma(avg, 2500000, 2000 * us, CAKE_MQ_TAU_MAX);
+	KUNIT_EXPECT_LE(test, abs((s64)avg - 1250000000), 12500000);
+}
+
+/* Wanting more than its share: using all of it, or most of it with packets
+ * held back by the shaper
+ */
+static void cake_test_mq_saturated(struct kunit *test)
+{
+	struct cake_sched_data *q = cake_test_alloc(test, sizeof(*q));
+	const u64 dt = 200 * NSEC_PER_USEC, now = CAKE_TEST_NOW, share = CAKE_TEST_RATE;
+	static const struct {
+		u32 used;	/* per 1000 of the share */
+		bool held;
+		bool saturated;
+	} cases[] = {
+		{ 990, false, true },	/* all of it */
+		{ 900, true, true },	/* TCP held back by its share */
+		{ 900, false, false },	/* a stream just below it */
+		{ 800, true, false },	/* well below, a burst waited */
+		{ 500, false, false },
+	};
+	int c;
+
+	for (c = 0; c < ARRAY_SIZE(cases); c++) {
+		u64 usage = share * cases[c].used / 1000;
+
+		q->synced_rate = share;
+		q->mq_usage = usage;
+		q->mq_bytes = div64_u64(usage * dt, NSEC_PER_SEC);
+		q->mq_idle = CAKE_MQ_TAU;
+		q->last_checked_active = now - dt;
+		q->mq_held_at = cases[c].held ? now - dt / 2 : 0;
+		cake_mq_publish(q, now);
+		KUNIT_EXPECT_EQ_MSG(test, q->mq_saturated, cases[c].saturated, "case %d", c);
+	}
+}
