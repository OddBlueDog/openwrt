Reviewed-by: Victor Nogueira <victor@mojatatu.com>
Acked-by: Toke Høiland-Jørgensen <toke@toke.dk>
Signed-off-by: Jamal Hadi Salim <jhs@mojatatu.com>
Link: https://patch.msgid.link/QDISC-5RTM.v3.r0.20261020053711-2@mojatatu.com
Signed-off-by: Jakub Kicinski <kuba@kernel.org>
[MilkFlint: the loop it wraps also retires cake_mq's tins (760-07).]
---
--- a/net/sched/sch_cake.c
+++ b/net/sched/sch_cake.c
@@ -3418,12 +3418,19 @@ static void cake_configure_rates(struct Qdisc *sch, u64 rate, bool rate_adjust)
 		cake_set_bulk_quantum(q, &qd->tins[c], rate);
 
 	if (!rate_adjust) {
+		u32 backlog = sch->qstats.backlog, qlen = sch->q.qlen;
+
 		for (c = qd->tin_cnt; c < CAKE_MAX_TINS; c++) {
 			cake_clear_tin(sch, c);
 			if (q->is_shared)
 				cake_mq_retire_tin(qd, &qd->tins[c], ktime_get());
 			qd->tins[c].cparams.mtu_time = qd->tins[ft].cparams.mtu_time;
 		}
+
+		backlog -= sch->qstats.backlog;
+		qlen -= sch->q.qlen;
+		if (qlen)
+			qdisc_tree_reduce_backlog(sch, qlen, backlog);
 	}
 
 	qd->rate_ns   = qd->tins[ft].tin_rate_ns;
