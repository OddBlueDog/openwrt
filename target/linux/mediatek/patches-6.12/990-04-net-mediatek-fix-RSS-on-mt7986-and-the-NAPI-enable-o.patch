From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Frank Wunderlich <frank-w@public-files.de>
Date: Thu, 22 Oct 2026 16:49:01 +0000
Subject: [PATCH 4/5] net: mediatek: fix RSS on mt7986, and the NAPI enable
 order

pesa1234 999-9901 (Frank Wunderlich: CDMP STAG for every NETSYS version)
and 999-9910 (pesa1234: register the netdevs only once every NAPI
exists), from next-r4.12.0.rss.mtk 69334c2, with OpenWrt 702s threaded
NAPI kept.

Since 6.12.113 the kernel itself allocates the dummy device and adds the
NAPIs before it registers the netdevs (6f0c2c4f5e71 "net: ethernet:
mtk_eth_soc: allocate dummy netdev sooner"), and frees them on its error
path after cancelling the reset worker. What is left of 999-9910 is
mtk_napi_del(), so that path and mtk_remove() delete the RSS rings'
NAPIs too.
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c | 42 +++++++++++++++++++++++-----------------
 1 file changed, 24 insertions(+), 18 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -4690,12 +4690,12 @@ static int mtk_hw_init(struct mtk_eth *e
 	 */
 	val = mtk_r32(eth, MTK_CDMQ_IG_CTRL);
 	mtk_w32(eth, val | MTK_CDMQ_STAG_EN, MTK_CDMQ_IG_CTRL);
-	if (mtk_is_netsys_v1(eth)) {
-		val = mtk_r32(eth, MTK_CDMP_IG_CTRL);
-		mtk_w32(eth, val | MTK_CDMP_STAG_EN, MTK_CDMP_IG_CTRL);
 
+	val = mtk_r32(eth, MTK_CDMP_IG_CTRL);
+	mtk_w32(eth, val | MTK_CDMP_STAG_EN, MTK_CDMP_IG_CTRL);
+
+	if (mtk_is_netsys_v1(eth))
 		mtk_w32(eth, 1, MTK_CDMP_EG_CTRL);
-	}
 
 	/* set interrupt delays based on current Net DIM sample */
 	mtk_dim_rx(&eth->rx_dim.work);
@@ -4973,6 +4973,22 @@ static void mtk_pending_work(struct work
 	rtnl_unlock();
 }
 
+static void mtk_napi_del(struct mtk_eth *eth)
+{
+	int i;
+
+	if (!eth->dummy_dev)
+		return;
+
+	netif_napi_del(&eth->tx_napi);
+	netif_napi_del(&eth->rx_napi[0].napi);
+
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_RSS)) {
+		for (i = 1; i < MTK_RX_RSS_NUM; i++)
+			netif_napi_del(&eth->rx_napi[MTK_RSS_RING(i)].napi);
+	}
+}
+
 static int mtk_free_dev(struct mtk_eth *eth)
 {
 	int i;
@@ -6067,6 +6083,8 @@ static int mtk_probe(struct platform_dev
 		dev_err(eth->dev, "failed to allocate dummy device\n");
 		goto err_unreg_netdev;
 	}
+	eth->dummy_dev->threaded = 1;
+	strcpy(eth->dummy_dev->name, "mtk_eth");
 	netif_napi_add(eth->dummy_dev, &eth->tx_napi, mtk_napi_tx);
 	netif_napi_add(eth->dummy_dev, &eth->rx_napi[0].napi, mtk_napi_rx);
 
@@ -6105,13 +6123,7 @@ err_deinit_ppe:
 	 */
 	cancel_work_sync(&eth->pending_work);
 	if (eth->dummy_dev) {
-		netif_napi_del(&eth->tx_napi);
-		netif_napi_del(&eth->rx_napi[0].napi);
-
-		if (MTK_HAS_CAPS(eth->soc->caps, MTK_RSS)) {
-			for (i = 1; i < MTK_RX_RSS_NUM; i++)
-				netif_napi_del(&eth->rx_napi[MTK_RSS_RING(i)].napi);
-		}
+		mtk_napi_del(eth);
 		free_netdev(eth->dummy_dev);
 	}
 	mtk_ppe_deinit(eth);
@@ -6151,13 +6163,7 @@ static void mtk_remove(struct platform_d
 	mtk_wed_exit();
 	mtk_hw_deinit(eth);
 
-	netif_napi_del(&eth->tx_napi);
-	netif_napi_del(&eth->rx_napi[0].napi);
-
-	if (MTK_HAS_CAPS(eth->soc->caps, MTK_RSS)) {
-		for (i = 1; i < MTK_RX_RSS_NUM; i++)
-			netif_napi_del(&eth->rx_napi[MTK_RSS_RING(i)].napi);
-	}
+	mtk_napi_del(eth);
 	mtk_cleanup(eth);
 	free_netdev(eth->dummy_dev);
 	mtk_mdio_cleanup(eth);
